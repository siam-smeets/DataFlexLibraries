22336>>>>>>>>>>>>>>>    //
22336>>>>>>>>>>>>>>>    // Stores the passed web properties array and sets up the object to work with
22336>>>>>>>>>>>>>>>    // this data.
22336>>>>>>>>>>>>>>>    //
22336>>>>>>>>>>>>>>>    // Params:
22336>>>>>>>>>>>>>>>    //      aSyncProps   - Is the set of web properties from the client
22336>>>>>>>>>>>>>>>    //
22336>>>>>>>>>>>>>>>    Procedure InitializeSyncProps tWebSyncProps[] aSyncProps
22338>>>>>>>>>>>>>>>        Integer iObj iProp iSize iCapacity iGrowthFactor iStoreIndex
22338>>>>>>>>>>>>>>>        Handle hoObject hoControlLocator
22338>>>>>>>>>>>>>>>        Handle[] aChildObjects
22339>>>>>>>>>>>>>>>        
22339>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22340>>>>>>>>>>>>>>>        Get phoWebControlLocator to hoControlLocator
22341>>>>>>>>>>>>>>>        
22341>>>>>>>>>>>>>>>        // Set up the array size management properties....
22341>>>>>>>>>>>>>>>        Move (SizeOfArray(aSyncProps)) to iSize
22342>>>>>>>>>>>>>>>        Move 100                       to iGrowthFactor    // This is the initial growth factor of the arrays. It doubles each time the array is resized.
22343>>>>>>>>>>>>>>>        Move (iSize max iGrowthFactor) to iCapacity
22344>>>>>>>>>>>>>>>        
22344>>>>>>>>>>>>>>>        Set piSize to iSize
22345>>>>>>>>>>>>>>>        Set piGrowthFactor to iGrowthFactor
22346>>>>>>>>>>>>>>>        Set piCapacity to iCapacity
22347>>>>>>>>>>>>>>>        
22347>>>>>>>>>>>>>>>        // Preallocate space for sync properties (plus some growth)....
22347>>>>>>>>>>>>>>>        Move (ResizeArray(aSyncProps, iCapacity)) to aSyncProps
22348>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncObjectHandles[iStoreIndex], iCapacity)) to gaSyncObjectHandles[iStoreIndex]     // We do not clear the array first. That is because we will just overwrite the old values.
22349>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps[iStoreIndex], 0)) to gaSyncChangedProps[iStoreIndex]               // This global array must be cleared first! We cannot guarantee that the old values will be fully overwritten.
22350>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps[iStoreIndex], iCapacity)) to gaSyncChangedProps[iStoreIndex]       // now size it to the correct value
22351>>>>>>>>>>>>>>>        
22351>>>>>>>>>>>>>>>        // Iterate each member and find the object reference.....
22351>>>>>>>>>>>>>>>        For iObj from 0 to (iSize - 1)
22357>>>>>>>>>>>>>>>>
22357>>>>>>>>>>>>>>>            Get FindWebObject of hoControlLocator aSyncProps[iObj].sO to hoObject
22358>>>>>>>>>>>>>>>            
22358>>>>>>>>>>>>>>>            If (hoObject = C_WebUnresolvedObject) Begin
22360>>>>>>>>>>>>>>>                If (pbErrorObjNotFound(Self)) Begin
22362>>>>>>>>>>>>>>>                    Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, aSyncProps[iObj].sO))
22363>>>>>>>>>>>>>>>>
22363>>>>>>>>>>>>>>>                End
22363>>>>>>>>>>>>>>>>
22363>>>>>>>>>>>>>>>            End
22363>>>>>>>>>>>>>>>>
22363>>>>>>>>>>>>>>>            Else Begin
22364>>>>>>>>>>>>>>>//                Set piSyncObjectIndex of hoObject to iObj    // Cache the object's index in the object itself
22364>>>>>>>>>>>>>>>            End
22364>>>>>>>>>>>>>>>>
22364>>>>>>>>>>>>>>>            
22364>>>>>>>>>>>>>>>            // Populate the shadow structs....
22364>>>>>>>>>>>>>>>            Move hoObject to gaSyncObjectHandles[iStoreIndex][iObj]
22365>>>>>>>>>>>>>>>            Move False to gaSyncChangedProps[iStoreIndex][iObj].bContainsChanges
22366>>>>>>>>>>>>>>>        Loop
22367>>>>>>>>>>>>>>>>
22367>>>>>>>>>>>>>>>
22367>>>>>>>>>>>>>>>        // Store the web property data....
22367>>>>>>>>>>>>>>>        Move aSyncProps to gaSyncProps[iStoreIndex]
22368>>>>>>>>>>>>>>>    End_Procedure
22369>>>>>>>>>>>>>>>    
22369>>>>>>>>>>>>>>>    
22369>>>>>>>>>>>>>>>    //
22369>>>>>>>>>>>>>>>    // Sets the addressed web property to the passed value. (see also GetScalarSyncProp)
22369>>>>>>>>>>>>>>>    //
22369>>>>>>>>>>>>>>>    // Params:
22369>>>>>>>>>>>>>>>    //      hoObject   - Is handle to the object which owns the property.
22369>>>>>>>>>>>>>>>    //      hmGetter   - Is a handle to the property's getter message.
22369>>>>>>>>>>>>>>>    //      sPropName  - Is the (case sensitive) property name.
22369>>>>>>>>>>>>>>>    //      sPropValue - Is the property value.
22369>>>>>>>>>>>>>>>    //
22369>>>>>>>>>>>>>>>    // Use the WebSet command instead of sending this message.
22369>>>>>>>>>>>>>>>    //
22369>>>>>>>>>>>>>>>    Procedure SetSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Variant vPropValue
22371>>>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSyncPropIndex iStoreIndex
22371>>>>>>>>>>>>>>>        Integer icObject iIndex iCount iSize
22371>>>>>>>>>>>>>>>        Boolean bFoundSyncProp bSaveProp bIsAjaxWebObject
22371>>>>>>>>>>>>>>>        String sUC_PropName sObject sPropValue
22371>>>>>>>>>>>>>>>        tWebValueTree tVT
22371>>>>>>>>>>>>>>>        tWebValueTree tVT
22371>>>>>>>>>>>>>>>        Variant vTest
22371>>>>>>>>>>>>>>>        
22371>>>>>>>>>>>>>>>        // Test if we are active....
22371>>>>>>>>>>>>>>>        Get Object_Label of hoObject to sObject
22372>>>>>>>>>>>>>>>
22372>>>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
22374>>>>>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppSynPropsNotReady, sObject, "WebSet " + pubProp.sName))
22375>>>>>>>>>>>>>>>>
22375>>>>>>>>>>>>>>>            Procedure_Return
22376>>>>>>>>>>>>>>>        End
22376>>>>>>>>>>>>>>>>
22376>>>>>>>>>>>>>>>
22376>>>>>>>>>>>>>>>
22376>>>>>>>>>>>>>>>        // Try to find the the sync prop in the published props array...
22376>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22377>>>>>>>>>>>>>>>        
22377>>>>>>>>>>>>>>>        //  Determine if advanced (struct / array) property
22377>>>>>>>>>>>>>>>        If (pubProp.eType = cArgArray or pubProp.eType = cArgStruct) Begin
22379>>>>>>>>>>>>>>>            //  Find advanced sync prop in the cache
22379>>>>>>>>>>>>>>>            Get FindAdvPropCache hoObject pubProp.sName to iProp
22380>>>>>>>>>>>>>>>            //  If not found then add it to the cache
22380>>>>>>>>>>>>>>>            If (iProp = -1) Begin
22382>>>>>>>>>>>>>>>                // Add the property....
22382>>>>>>>>>>>>>>>                Get AddToAdvPropCache hoObject pubProp.sName to iProp
22383>>>>>>>>>>>>>>>            End
22383>>>>>>>>>>>>>>>>
22383>>>>>>>>>>>>>>>            
22383>>>>>>>>>>>>>>>            //  Store the value and mark as changed
22383>>>>>>>>>>>>>>>            Move vPropValue to gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV
22384>>>>>>>>>>>>>>>            Move True       to gaAdvSyncProps[iStoreIndex][iProp].bDeserialized
22385>>>>>>>>>>>>>>>            Move True       to gaAdvSyncProps[iStoreIndex][iProp].bChanged
22386>>>>>>>>>>>>>>>        End
22386>>>>>>>>>>>>>>>>
22386>>>>>>>>>>>>>>>        Else Begin
22387>>>>>>>>>>>>>>>            // get the sync props index for the passed object handle...
22387>>>>>>>>>>>>>>>            Move (Uppercase(pubProp.sName)) to sUC_PropName
22388>>>>>>>>>>>>>>>            Move False to bSaveProp
22389>>>>>>>>>>>>>>>            Get piSize to iSize
22390>>>>>>>>>>>>>>>//            Get piSyncObjectIndex of hoObject to iObjectIndex
22390>>>>>>>>>>>>>>>            Get FindObjectIndex hoObject to iObjectIndex
22391>>>>>>>>>>>>>>>            
22391>>>>>>>>>>>>>>>            If (iObjectIndex = -1 or iObjectIndex >= iSize) Begin
22393>>>>>>>>>>>>>>>                Get AddObjectToSyncProps hoObject to iObjectIndex
22394>>>>>>>>>>>>>>>            End
22394>>>>>>>>>>>>>>>>
22394>>>>>>>>>>>>>>>            
22394>>>>>>>>>>>>>>>            // Test iObjectIndex again as it might have changed (above)....
22394>>>>>>>>>>>>>>>            If (iObjectIndex <> -1) Begin
22396>>>>>>>>>>>>>>>                // Send Hook for converting the value to format for transport.
22396>>>>>>>>>>>>>>>                Get ConvertToTransport of hoObject pubProp.hmGetter vPropValue pubProp.eType  to sPropValue
22397>>>>>>>>>>>>>>>                
22397>>>>>>>>>>>>>>>                // Search for the property name....
22397>>>>>>>>>>>>>>>                Move (SizeOfArray(gaSyncProps[iStoreIndex][iObjectIndex].aP)) to icProp
22398>>>>>>>>>>>>>>>                Move False to bFoundSyncProp
22399>>>>>>>>>>>>>>>                
22399>>>>>>>>>>>>>>>                For iProp from 0 to (icProp - 1)
22405>>>>>>>>>>>>>>>>
22405>>>>>>>>>>>>>>>                    If (Uppercase(gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sN) = sUC_PropName) Begin
22407>>>>>>>>>>>>>>>                        Move iProp to iSyncPropIndex
22408>>>>>>>>>>>>>>>                        Move True to bFoundSyncProp
22409>>>>>>>>>>>>>>>                    End
22409>>>>>>>>>>>>>>>>
22409>>>>>>>>>>>>>>>                    If (bFoundSyncProp) ;                        Break
22412>>>>>>>>>>>>>>>                Loop
22413>>>>>>>>>>>>>>>>
22413>>>>>>>>>>>>>>>                
22413>>>>>>>>>>>>>>>                If (bFoundSyncProp) Begin
22415>>>>>>>>>>>>>>>                    // Case 1: Object and Property found in gaSyncProps
22415>>>>>>>>>>>>>>>                    // Update the found property....
22415>>>>>>>>>>>>>>>                    Move sPropValue to gaSyncProps[iStoreIndex][iObjectIndex].aP[iSyncPropIndex].sV
22416>>>>>>>>>>>>>>>                    Move True to bSaveProp
22417>>>>>>>>>>>>>>>                End
22417>>>>>>>>>>>>>>>>
22417>>>>>>>>>>>>>>>                Else Begin
22418>>>>>>>>>>>>>>>                    // Case 2: The Property needs to be added to sync props array
22418>>>>>>>>>>>>>>>                    // Add the property....
22418>>>>>>>>>>>>>>>                    Move pubProp.sName to gaSyncProps[iStoreIndex][iObjectIndex].aP[icProp].sN    // Use the original case of the property name
22419>>>>>>>>>>>>>>>                    Move sPropValue to gaSyncProps[iStoreIndex][iObjectIndex].aP[icProp].sV
22420>>>>>>>>>>>>>>>                    Move icProp to iSyncPropIndex
22421>>>>>>>>>>>>>>>                    Move True to bSaveProp
22422>>>>>>>>>>>>>>>                End
22422>>>>>>>>>>>>>>>>
22422>>>>>>>>>>>>>>>                
22422>>>>>>>>>>>>>>>                If (bSaveProp) Begin
22424>>>>>>>>>>>>>>>                    // Update the changed props array....
22424>>>>>>>>>>>>>>>                    Move True to gaSyncChangedProps[iStoreIndex][iObjectIndex].bContainsChanges     // Mark the object as changed
22425>>>>>>>>>>>>>>>                    Move (SearchArray(iSyncPropIndex, gaSyncChangedProps[iStoreIndex][iObjectIndex].aiIndex)) to iIndex
22426>>>>>>>>>>>>>>>                    
22426>>>>>>>>>>>>>>>                    If (iIndex = -1) Begin
22428>>>>>>>>>>>>>>>                        // Add the property name to the changed props array....
22428>>>>>>>>>>>>>>>                        Move (SizeOfArray(gaSyncChangedProps[iStoreIndex][iObjectIndex].aiIndex)) to iCount
22429>>>>>>>>>>>>>>>                        Move iSyncPropIndex to gaSyncChangedProps[iStoreIndex][iObjectIndex].aiIndex[iCount]
22430>>>>>>>>>>>>>>>                    End
22430>>>>>>>>>>>>>>>>
22430>>>>>>>>>>>>>>>                End
22430>>>>>>>>>>>>>>>>
22430>>>>>>>>>>>>>>>            End
22430>>>>>>>>>>>>>>>>
22430>>>>>>>>>>>>>>>            Else Begin
22431>>>>>>>>>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, (sObject + " (WebSet " + pubProp.sName+")") ))
22432>>>>>>>>>>>>>>>>
22432>>>>>>>>>>>>>>>            End
22432>>>>>>>>>>>>>>>>
22432>>>>>>>>>>>>>>>        End
22432>>>>>>>>>>>>>>>>
22432>>>>>>>>>>>>>>>        
22432>>>>>>>>>>>>>>>    End_Procedure

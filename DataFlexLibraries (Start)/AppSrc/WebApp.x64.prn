9579>>>>>>>>>    // Called by the runtime when an error occurs. Initiates the main error handling. Skips errors
9579>>>>>>>>>    // that are ignored and makes sure to prevent recursion by checking the error processing state.
9579>>>>>>>>>    Procedure Error_Report Integer iErrNum Integer iErrLine String sErrText
9581>>>>>>>>>        If (pbErrorProcessingState(Self)) ;            Procedure_Return
9584>>>>>>>>>            
9584>>>>>>>>>        If (not(IsTrapped(Self, iErrNum))) ;            Procedure_Return
9587>>>>>>>>>        

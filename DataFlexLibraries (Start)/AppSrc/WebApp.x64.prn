3472>>>>>>>        If iDSO ;            Set Field_Changed_State of iDSO iField to iState
3475>>>>>>>    End_Procedure
3476>>>>>>>
3476>>>>>>>    // This simulates entering a value into a field from a keyboard. Pass the
3476>>>>>>>    // Field and DD Options and the value. It is up to you to pass the proper
3476>>>>>>>    // DD options. This is normally sent by File_Field_Entry and you are
3476>>>>>>>    // advised to use that message and not this one.
3476>>>>>>>    Procedure Set Field_Entry Integer iField Integer iOpts Integer bShowErr String sValue
3478>>>>>>>        Integer iFile
3478>>>>>>>        Integer iType
3478>>>>>>>        Integer bChanged
3478>>>>>>>        Integer bInvalid
3478>>>>>>>        Integer hObj
3478>>>>>>>        String sOldVal
3478>>>>>>>        Address pData
3478>>>>>>>        Integer iLen
3478>>>>>>>
3478>>>>>>>        Get Main_File to iFile
3479>>>>>>>
3479>>>>>>>        // if No-enter or Displayonly, this shouldn't be changed. We will
3479>>>>>>>        // let NoPut through, since a user might need it for finding.
3479>>>>>>>        If (iOpts iand DD_NOENTER) ;            Procedure_Return
3482>>>>>>>
3482>>>>>>>        // Force a caplsock if required
3482>>>>>>>        If (iOpts iand DD_CAPSLOCK) ;            Move (Uppercase(sValue)) to sValue
3485>>>>>>>
3485>>>>>>>        // If date or number, force conversion so any error is detected before
3485>>>>>>>        // the buffer is updated. We don't want the record buffer to contain
3485>>>>>>>        // invalid data
3485>>>>>>>        Get_Attribute DF_FIELD_TYPE of iFile iField to iType
3488>>>>>>>
3488>>>>>>>        // Overlap fields are not supported directly in DDs. It is expected
3488>>>>>>>        // that you will use the underlying fields instead
3488>>>>>>>        If (iType = DF_OVERLAP) Begin
3490>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_OVERLAP_ERROR
3491>>>>>>>            Procedure_Return
3492>>>>>>>        End
3492>>>>>>>>
3492>>>>>>>
3492>>>>>>>        If (iType=DF_TEXT or iType=DF_BINARY) Begin // if text or binary direct to pointer
3494>>>>>>>            Move sValue to sValue // intentional code: make sure passed sValue is a really string
3495>>>>>>>            Move (SizeOfString(sValue)) to iLen // length to copy
3496>>>>>>>            Move (AddressOf(sValue)) to pData   // first byte of string
3497>>>>>>>            // will gen error if ext. field does not exist
3497>>>>>>>            Set Field_Pointer_Entry iField iOpts iLen bShowErr to pData
3498>>>>>>>            Procedure_Return
3499>>>>>>>        End
3499>>>>>>>>
3499>>>>>>>
3499>>>>>>>        Get IsDataInvalid iType sValue to bInvalid
3500>>>>>>>        If bInvalid Begin     // If an error occurred we have
3502>>>>>>>            If bShowErr ;                Send Data_set_error iField (If(iType=DF_DATE or iType=DF_DATETIME, DFERR_ENTER_VALID_DATE, DFERR_BAD_ENTRY)) ;                (" ("-sValue-")")
3505>>>>>>>            Procedure_Return  // a bad number or a bad date. Do no more!
3506>>>>>>>        End
3506>>>>>>>>
3506>>>>>>>        // update the value only if the value is changed.
3506>>>>>>>        Move (Record_Buffer(Self)) to hObj
3507>>>>>>>        Get Value of hObj iField to sOldVal
3508>>>>>>>        If (iType=DF_BCD) ;            Move (Number(sValue)<>Number(sOldVal)) to bChanged
3511>>>>>>>        Else If (iType=DF_DATE) ;            Move (Date(sValue)<>Date(sOldVal)) to bChanged
3515>>>>>>>        Else If (iType=DF_DATETIME) ;            Move (Cast(sValue,DateTime)<>Cast(sOldVal,DateTime)) to bChanged
3519>>>>>>>        Else ;            Move (sValue<>sOldVal) to bChanged
3521>>>>>>>
3521>>>>>>>        // if changed or force put, update the value.
3521>>>>>>>        If ( bChanged or (iOpts iand DD_FORCEPUT) ) ;            Set Field_Current_Value iField to sValue
3524>>>>>>>
3524>>>>>>>        // Set changed state if changed. This is an improvement on DEOs which would set changed-state for
3524>>>>>>>        // a no-put. Set Field_Changed_State will not set Changed_state if it is noput
3524>>>>>>>        If ( bChanged) Begin
3526>>>>>>>            Set Field_Changed_State iField to True
3527>>>>>>>            // if noput (but not noenter) we must tell the DDO that this should not be
3527>>>>>>>            // updated during a save.
3527>>>>>>>            If (iOpts iand DD_NOPUT) Begin
3529>>>>>>>                Set Field_NoPutValueChangedByDeo iField to True
3530>>>>>>>            End
3530>>>>>>>>
3530>>>>>>>        End
3530>>>>>>>>
3530>>>>>>>
3530>>>>>>>        // perform autofinds if needed. Note that required checking will occur as
3530>>>>>>>        // part of validation.
3530>>>>>>>        // We will only autofind if the field value is changed. This is consistent with
3530>>>>>>>        // DEOs which do not autofind on unchanged values. This provides optimizations
3530>>>>>>>        // when a parent record is already loaded.
3530>>>>>>>        If (bChanged or Field_Changed_state(Self,iField)) Begin
3532>>>>>>>            // note that autofind is 1 and _ge is 100000001 (8th bit set). So order of
3532>>>>>>>            // testing is important and make sure we test for exact bit match. Must first
3532>>>>>>>            // test _GE and the EQ (because EQ bit is part of GE)
3532>>>>>>>            If ((iOpts iand DD_AUTOFIND_GE)=DD_AUTOFIND_GE) ;                Send File_Field_AutoFind iFile iField GE
3535>>>>>>>            Else If ((iOpts iand DD_AUTOFIND)=DD_AUTOFIND) ;                Send File_Field_AutoFind iFile iField EQ
3539>>>>>>>        End
3539>>>>>>>>
3539>>>>>>>
3539>>>>>>>    End_Procedure
3540>>>>>>>
3540>>>>>>>    // This returns file-field options for a Field_Entry type of environment.
3540>>>>>>>    // It will strip autofind from main-file DDs but leave foreign field alone.
3540>>>>>>>    // This is needed for Field_entry. Otherwise adding a field value to an autofind
3540>>>>>>>    // for save or find causes an autofind to trigger first which either causes the
3540>>>>>>>    // wrong rec to save or for a double find.
3540>>>>>>>    Function File_Field_Entry_Options Integer iFile Integer iField Returns Integer
3542>>>>>>>        Integer iOpts
3542>>>>>>>        // this will get the appropriate field and foreign field opts
3542>>>>>>>        Get File_Field_Options iFile iField to iOpts
3543>>>>>>>        // If the main file (not foreign) we will strip autofind. Autofind should not
3543>>>>>>>        // be an automatic part of main file entry while it should with foreign fields.
3543>>>>>>>        If (iFile=Main_File(Self)) Begin
3545>>>>>>>            // note that autofind is 1 and _ge is 100000001 (8th bit set). So order of
3545>>>>>>>            // testing is important and make sure we test for exact bit match. Must first
3545>>>>>>>            // test _GE and the EQ (because EQ bit is part of GE)
3545>>>>>>>            If ((iOpts iand DD_AUTOFIND_GE)=DD_AUTOFIND_GE) ;                Move (iOpts - DD_AUTOFIND_GE) to iOpts
3548>>>>>>>            Else If ((iOpts iand DD_AUTOFIND)=DD_AUTOFIND)  ;                Move (iOpts - DD_AUTOFIND)    to iOpts
3552>>>>>>>        End
3552>>>>>>>>
3552>>>>>>>        Function_Return iOpts
3553>>>>>>>    End_Function
3554>>>>>>>
3554>>>>>>>    // This simulates entering a value into a field from a keyboard. The DD
3554>>>>>>>    // receiving this message determines if it is Main or Foreign (just like
3554>>>>>>>    // server). It will do an uppercase, will respect No_Enter and DisplayOnly
3554>>>>>>>    // and will do a autofind if required. It does not do a field validation.
3554>>>>>>>    Procedure Set File_Field_Entry Integer iFile Integer iField Integer bShowErr String sValue
3556>>>>>>>        Integer iOpts
3556>>>>>>>        Integer hDD
3556>>>>>>>        Get Data_Set iFile to hDD
3557>>>>>>>        If hDD Begin
3559>>>>>>>            // this will get the appropriate field and foreign field opts
3559>>>>>>>            Get File_Field_Entry_Options iFile iField to iOpts
3560>>>>>>>            Set Field_Entry of hDD iField iOpts bShowErr to sValue
3561>>>>>>>        End
3561>>>>>>>>
3561>>>>>>>    End_Procedure
3562>>>>>>>
3562>>>>>>>    // return object ID of extended field, 0 if none
3562>>>>>>>    Function Field_Object Integer iField Returns Integer
3564>>>>>>>        Integer hoFlds hoField
3564>>>>>>>        Boolean bAutoAssign
3564>>>>>>>        Get Field_Objects to hoFlds
3565>>>>>>>        If hoFlds Begin
3567>>>>>>>            Get Field_Object of hoFlds iField to hoField
3568>>>>>>>        End
3568>>>>>>>>
3568>>>>>>>        If not hoField Begin
3570>>>>>>>            Send DefineExtendedField iField // will create field_objects and Field_Object as needed
3571>>>>>>>            Get Field_Objects to hoFlds
3572>>>>>>>            Get Field_Object of hoFlds iField to hoField
3573>>>>>>>        End
3573>>>>>>>>
3573>>>>>>>        Function_Return hoField
3574>>>>>>>    End_Function
3575>>>>>>>
3575>>>>>>>    // This is the same as Field_entry except the value is passed via a
3575>>>>>>>    // pointer. If data-type is extended (text/binary) it will use and an
3575>>>>>>>    // extended field object to handle this. If date/number/string we will
3575>>>>>>>    // convert this to a string and use Field_Entry. It is the caller's
3575>>>>>>>    // responsibility to pass a valid pointer to valid data...else !@#$%^&^
3575>>>>>>>    // If an extended Field object is needed and not defined, an error is
3575>>>>>>>    // returned. If pointer is null, assume empty string passed (this is a
3575>>>>>>>    // change as of 8.3 - it used to ignore null pointers)
3575>>>>>>>    Procedure Set Field_Pointer_Entry Integer iField Integer iOpts Integer iLen Integer bShowErr Address pData
3577>>>>>>>        Integer hFld
3577>>>>>>>        String  sValue
3577>>>>>>>        Integer iFile
3577>>>>>>>        Integer iType
3577>>>>>>>
3577>>>>>>>        Get Main_file to iFile
3578>>>>>>>        Get_Attribute DF_FIELD_TYPE of iFile iField to iType
3581>>>>>>>
3581>>>>>>>        // Overlap fields are not supported directly in DDs. It is expected
3581>>>>>>>        // that you will use the underlying fields instead
3581>>>>>>>        If (iType = DF_OVERLAP) ;            Send Data_set_Error iField DFERR_PROGRAM  DD_EXTENDED_OVERLAP_ERROR
3584>>>>>>>        Else If (iType=DF_TEXT or iType=DF_BINARY) Begin
3587>>>>>>>            Get Field_Object iField to hFld // the object that handles this large text
3588>>>>>>>            If hFld ;                Set Field_pEntry of hFld iOpts iLen bShowErr to pData
3591>>>>>>>            Else ;                Send Data_set_Error iField DFERR_PROGRAM  DD_EXTENDED_FIELD_NOT_DEFINED
3593>>>>>>>        End
3593>>>>>>>>
3593>>>>>>>        Else Begin
3594>>>>>>>            // if number,date or string convert the pointer data to
3594>>>>>>>            // string data and do a normal entry with it.
3594>>>>>>>            Move (PointerToString(pData)) to sValue
3595>>>>>>>            Set Field_Entry iField iOpts bShowErr to sValue
3596>>>>>>>        End
3596>>>>>>>>
3596>>>>>>>    End_Procedure
3597>>>>>>>
3597>>>>>>>    // This is the same as File_Field_entry except the value is passed via a
3597>>>>>>>    // pointer. See Field_Pointer_Entry for more on this
3597>>>>>>>    Procedure Set File_Field_Pointer_Entry Integer iFile Integer iField Integer iLen Integer bShowErr Address pData
3599>>>>>>>        Integer iOpts
3599>>>>>>>        Integer hDD
3599>>>>>>>        Get Data_Set iFile to hDD
3600>>>>>>>        If hDD Begin
3602>>>>>>>            // this will get the appropriate field and foreign field opts
3602>>>>>>>            Get File_Field_Entry_Options iFile iField to iOpts
3603>>>>>>>            Set Field_Pointer_Entry of hDD iField iOpts iLen bShowErr to pData
3604>>>>>>>        End
3604>>>>>>>>
3604>>>>>>>    End_Procedure
3605>>>>>>>
3605>>>>>>>    // This is the same as Field_Current_Value except the value is passed via
3605>>>>>>>    // a pointer. If data-type is extended (text/binary) it will use and an
3605>>>>>>>    // extended field object to handle this. If date/number/string we will
3605>>>>>>>    // convert this to a string and use Field_Entry. It is the caller's
3605>>>>>>>    // responsibility to pass a valid pointer to valid data...else !@#$%^&^
3605>>>>>>>    // If an extended Field object is needed and not defined, an error is
3605>>>>>>>    // returned. If pointer is null, assume empty string passed (this is a
3605>>>>>>>    // change as of 8.3 - it used to ignore null pointers)
3605>>>>>>>    Procedure Set Field_Current_Pointer_Value Integer iField Integer iLen Address pData
3607>>>>>>>        Integer hFld
3607>>>>>>>        String  sValue
3607>>>>>>>        Integer iFile iType iCrnt
3607>>>>>>>        Handle iFocObj
3607>>>>>>>        Boolean bChanged
3607>>>>>>>
3607>>>>>>>        Get Main_file to iFile
3608>>>>>>>        Get_Attribute DF_FIELD_TYPE of iFile iField to iType
3611>>>>>>>
3611>>>>>>>        // Overlap fields are not supported directly in DDs. It is expected
3611>>>>>>>        // that you will use the underlying fields instead
3611>>>>>>>        If (iType = DF_OVERLAP) Begin
3613>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_OVERLAP_ERROR
3614>>>>>>>            Procedure_Return
3615>>>>>>>        End
3615>>>>>>>>
3615>>>>>>>
3615>>>>>>>        If (iType<>DF_TEXT and iType<>DF_BINARY) Begin
3617>>>>>>>            // if number,date or string convert the pointer data to
3617>>>>>>>            // string data and do a normal entry with it.
3617>>>>>>>            Move (PointerToString(pData)) to sValue  // create string from pointer data
3618>>>>>>>            Set Field_Current_Value iField to sValue
3619>>>>>>>            Procedure_Return
3620>>>>>>>        End
3620>>>>>>>>
3620>>>>>>>
3620>>>>>>>        Get Field_Object iField to hFld // the object that handles this large text
3621>>>>>>>        If not hFld Begin
3623>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_FIELD_NOT_DEFINED
3624>>>>>>>            Procedure_Return
3625>>>>>>>        End
3625>>>>>>>>
3625>>>>>>>
3625>>>>>>>        Get Is_pValueChanged of hFld iLen pData to bChanged
3626>>>>>>>        If bChanged Begin
3628>>>>>>>            Set Field_pValue of hFld iLen to pData
3629>>>>>>>            Send Field_Pointer_Value_Changed iField pData
3630>>>>>>>        End
3630>>>>>>>>
3630>>>>>>>        Else Begin
3631>>>>>>>            // If here the set value did not change the contents of the DD.
3631>>>>>>>            // However, it is possible that the current focus DEO may contain
3631>>>>>>>            // a different value than the one we are setting. In such a case
3631>>>>>>>            // we must re-synchronize the DEO. Only the one DEO can be affected
3631>>>>>>>            // because it is the current focus deo/item that can contain a value
3631>>>>>>>            // that is not yet updated in the DD. This fixes a bug where the
3631>>>>>>>            // iexit was setting a value which was different from what was in
3631>>>>>>>            // the DEO but was the same as the old DD value (iExit is called
3631>>>>>>>            // before the DD is re-synched with the DEO). This could happen
3631>>>>>>>            // also by sending this message directly with a different value in
3631>>>>>>>            // the DEO focus item.
3631>>>>>>>            Get Focus of Desktop to iFocObj
3632>>>>>>>            // similar logic to Get Field_Pointer_Current_Value. We check that the DEO
3632>>>>>>>            // is extended, that entry_refresh is not disabled and that the
3632>>>>>>>            // DEO's server is this DD.
3632>>>>>>>            If ( Extended_DEO_State(iFocObj) and (Entry_Refresh_State(iFocObj)=0)) Begin
3634>>>>>>>                // If Focus DEO has same file and field and it is not checkbox
3634>>>>>>>                // we must set its value. Set local value directly sets the value
3634>>>>>>>                // in the DEO item. If we used value we'd get recursion!
3634>>>>>>>                Get Current_item of iFocObj to iCrnt
3635>>>>>>>                If ( Data_File(iFocObj,iCrnt)=iFile and ;                    Data_Field(iFocObj,iCrnt)=iField and ;                    IsDEOOwned(Self,iFocObj) ) Begin
3637>>>>>>>                    Send File_Field_Pointer_Value_Changed to iFocObj iFile iField pData True
3638>>>>>>>                End
3638>>>>>>>>
3638>>>>>>>            End
3638>>>>>>>>
3638>>>>>>>        End
3638>>>>>>>>
3638>>>>>>>    End_Procedure
3639>>>>>>>
3639>>>>>>>    // This is never called but it needed for the compiler. Required for apps DDs that don't compile in a DEO interface
3639>>>>>>>    Procedure File_Field_Pointer_Value_Changed Integer iFile Integer iField Address pValue Integer iChangeDisabled
3641>>>>>>>    End_Procedure
3642>>>>>>>
3642>>>>>>>    Procedure Field_Pointer_Value_Changed Integer iField Address pValue
3644>>>>>>>        Integer iMax
3644>>>>>>>        Integer iCount
3644>>>>>>>        Integer iDEO
3644>>>>>>>        Integer iMain_File
3644>>>>>>>        Integer iNoChange
3644>>>>>>>        Get Change_Disabled_State to iNoChange
3645>>>>>>>        Get Main_File to iMain_File
3646>>>>>>>        Get Data_Set_User_Interface_Count to iMax
3647>>>>>>>        Decrement iMax
3648>>>>>>>        For iCount from 0 to iMax
3654>>>>>>>>
3654>>>>>>>            Get Data_Set_User_Interface iCount to iDEO
3655>>>>>>>            If (Extended_DEO_State(iDEO) ) Begin
3657>>>>>>>                Send File_Field_Pointer_Value_Changed to iDEO iMain_File iField pValue iNoChange
3658>>>>>>>            End
3658>>>>>>>>
3658>>>>>>>        Loop
3659>>>>>>>>
3659>>>>>>>    End_Procedure
3660>>>>>>>
3660>>>>>>>    // This is the same as File_Field_Current_Value except the value is passed
3660>>>>>>>    // via a pointer. See Field_current_Pointer_Value for more on this
3660>>>>>>>    Procedure Set File_Field_Current_Pointer_Value Integer iFile Integer iField Integer iLen Address pData
3662>>>>>>>        Integer hDD
3662>>>>>>>        Get Data_Set iFile to hDD
3663>>>>>>>        If hDD ;            Set Field_Current_Pointer_Value of hDD iField iLen to pData
3666>>>>>>>    End_Procedure
3667>>>>>>>
3667>>>>>>>    // This returns the data pointer to the extended field. At this point
3667>>>>>>>    // this is the data. Be careful if you change the data, be even more
3667>>>>>>>    // careful if you change the pointer (don't do it!!!!)
3667>>>>>>>    Function Field_Current_Pointer_Value Integer iField Returns Address
3669>>>>>>>        Integer hFld
3669>>>>>>>        Handle iFoc
3669>>>>>>>
3669>>>>>>>        Get Field_Object iField to hFld // the object that handles this large text
3670>>>>>>>        If not hFld Begin
3672>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_FIELD_NOT_DEFINED
3673>>>>>>>            Function_Return 0
3674>>>>>>>        End
3674>>>>>>>>
3674>>>>>>>
3674>>>>>>>
3674>>>>>>>        // This was extended to also make sure that the focus's server
3674>>>>>>>        // is this DD. This prevent the (very unlikely) case of a focus
3674>>>>>>>        // file/field being the right file/field but for a different view.
3674>>>>>>>        // 12.1: Also check operation mode, if within an operation assume that the
3674>>>>>>>        // ddos have the information they need from the deos. During a refresh we don't
3674>>>>>>>        // the data to be taken from a DEO - the DD buffer has the information you want. Note that
3674>>>>>>>        // we also changed all methods that set operation_mode to update the DD with the current
3674>>>>>>>        // DEO field, so the buffer is always correct.
3674>>>>>>>        Get Focus of Desktop to iFoc
3675>>>>>>>        If ( (OPERATION_MODE=MODE_WAITING) and ;            Extended_DEO_State(iFoc) and (Entry_Refresh_State(iFoc)=0) ) Begin
3677>>>>>>>            If ( Data_File(iFoc,0)=Main_File(Self) and Data_Field(iFoc,0)=iField and ;                IsDEOOwned(Self,iFoc) ) Begin
3679>>>>>>>                Send Update_Focus_Field
3680>>>>>>>            End
3680>>>>>>>>
3680>>>>>>>        End
3680>>>>>>>>
3680>>>>>>>
3680>>>>>>>        Function_Return (FieldPointer(hFld))
3681>>>>>>>    End_Function
3682>>>>>>>
3682>>>>>>>
3682>>>>>>>    Function Field_Current_UCAValue Integer iField Returns UChar[]
3684>>>>>>>        Integer hFld
3684>>>>>>>        Handle iFoc
3684>>>>>>>        UChar[] Data
3685>>>>>>>
3685>>>>>>>        Get Field_Object iField to hFld // the object that handles this large text
3686>>>>>>>        If not hFld Begin
3688>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_FIELD_NOT_DEFINED
3689>>>>>>>            Function_Return 0
3690>>>>>>>        End
3690>>>>>>>>
3690>>>>>>>
3690>>>>>>>
3690>>>>>>>        // This was extended to also make sure that the focus's server
3690>>>>>>>        // is this DD. This prevent the (very unlikely) case of a focus
3690>>>>>>>        // file/field being the right file/field but for a different view.
3690>>>>>>>        // 12.1: Also check operation mode, if within an operation assume that the
3690>>>>>>>        // ddos have the information they need from the deos. During a refresh we don't
3690>>>>>>>        // the data to be taken from a DEO - the DD buffer has the information you want. Note that
3690>>>>>>>        // we also changed all methods that set operation_mode to update the DD with the current
3690>>>>>>>        // DEO field, so the buffer is always correct.
3690>>>>>>>        Get Focus of Desktop to iFoc
3691>>>>>>>        If ( (OPERATION_MODE=MODE_WAITING) and ;            Extended_DEO_State(iFoc) and (Entry_Refresh_State(iFoc)=0) ) Begin
3693>>>>>>>            If ( Data_File(iFoc,0)=Main_File(Self) and Data_Field(iFoc,0)=iField and ;                IsDEOOwned(Self,iFoc) ) Begin
3695>>>>>>>                Send Update_Focus_Field
3696>>>>>>>            End
3696>>>>>>>>
3696>>>>>>>        End
3696>>>>>>>>
3696>>>>>>>        Get FieldArray of hFld to Data
3697>>>>>>>        Function_Return Data
3698>>>>>>>    End_Function
3699>>>>>>>

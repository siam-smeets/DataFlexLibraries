19193>>>>>>>>>>>>>>>>>
19193>>>>>>>>>>>>>>>>>// Base class for some client-side control (non-panel).
19193>>>>>>>>>>>>>>>>>// 
19193>>>>>>>>>>>>>>>>>// Supports:
19193>>>>>>>>>>>>>>>>>// - Column layout
19193>>>>>>>>>>>>>>>>>// - Label interface
19193>>>>>>>>>>>>>>>>>// - Focus/Blur events
19193>>>>>>>>>>>>>>>>>Class cWebBaseControl is a cWebBaseDEOServer
19194>>>>>>>>>>>>>>>>>    
19194>>>>>>>>>>>>>>>>>    Procedure Construct_Object
19196>>>>>>>>>>>>>>>>>        Forward Send Construct_Object
19198>>>>>>>>>>>>>>>>>        
19198>>>>>>>>>>>>>>>>>        // Published Properties
19198>>>>>>>>>>>>>>>>>        Property Boolean pbFillHeight False            // If True, then the control is vertically stretched to fill all available space. In GridLayout, this will cause it to fill the rows this control is occupying (by default, controls have their natural height through CSS styling)
19201>>>>>>>>>>>>>>>>>        Property Integer piHeight 0                 // Is the explicit fixed height of the control (for most controls you leave this set to 0 so the control's style settings determine the height). Ignored when pbFillHeight is True.
19204>>>>>>>>>>>>>>>>>        Property Integer piMinHeight 0              // Minimum control height (ignored unless pbFillHeight is True)ent)
19207>>>>>>>>>>>>>>>>>        
19207>>>>>>>>>>>>>>>>>        Property Boolean pbShowLabel True              // If False, then no space is assigned for the label in the column layout (see psLabel)
19210>>>>>>>>>>>>>>>>>        Property Integer peLabelAlign C_WebDefault     // Label alignment (alLeft, alCenter, alRight aligned)
19213>>>>>>>>>>>>>>>>>        Property Integer peLabelPosition lpLeft         // Label position relative to the control (lpLeft, lpRight, lpTop, lpFloat)
19216>>>>>>>>>>>>>>>>>        Property Integer piColumnIndex C_WebDefault     // Determines the horizontal column position in the parent panel object
19219>>>>>>>>>>>>>>>>>        Property Integer piColumnSpan 1                // Determines how many columns the width of the control will span (i.e. determines the width of the control, 0 will spann the full available space)
19222>>>>>>>>>>>>>>>>>        Property Integer piRowIndex C_WebDefault        // For LayoutType Grid. -1 = auto
19225>>>>>>>>>>>>>>>>>        Property Integer piRowSpan 1                    // For LayoutType Grid. Amount of rows this control will occupy.
19228>>>>>>>>>>>>>>>>>        Property Integer piLabelOffset C_WebDefault    // Label position (in pixels) relative to the control
19231>>>>>>>>>>>>>>>>>        Property String psLabel ""                     // Is the control's label (see pbShowLabel)
19234>>>>>>>>>>>>>>>>>        Property String psLabelColor ""                // CSS Inline Style - Color of label's text      
19237>>>>>>>>>>>>>>>>>        
19237>>>>>>>>>>>>>>>>>        Property String psToolTip ""                 // Tooltip that is displayed when the mouse is hovered over the control. Set by data binding from Status_Help.
19240>>>>>>>>>>>>>>>>>        
19240>>>>>>>>>>>>>>>>>        Property Boolean pbServerOnBlur False
19243>>>>>>>>>>>>>>>>>        Property String psClientOnBlur ""
19246>>>>>>>>>>>>>>>>>        
19246>>>>>>>>>>>>>>>>>        Property Boolean pbServerOnFocus False
19249>>>>>>>>>>>>>>>>>        Property String psClientOnFocus ""
19252>>>>>>>>>>>>>>>>>        
19252>>>>>>>>>>>>>>>>>    End_Procedure

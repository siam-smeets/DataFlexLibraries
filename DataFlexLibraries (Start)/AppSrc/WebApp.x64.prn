29286>>>>>>>    
29286>>>>>>>    // Generates a fatal error listing DataFlex errors that occurred.
29286>>>>>>>    Procedure ReportDataFlexErrors
29288>>>>>>>        String sMessage sError
29288>>>>>>>        Integer iErrs iIndex iError
29288>>>>>>>        
29288>>>>>>>        Move "Unexpected DataFlex Errors." to sMessage
29289>>>>>>>        
29289>>>>>>>        // handle any errors
29289>>>>>>>        Get ErrorCount to iErrs // any errors
29290>>>>>>>        
29290>>>>>>>        For iIndex from 0 to (iErrs - 1)   
29296>>>>>>>>
29296>>>>>>>            Get ErrorNumber iIndex to iError   
29297>>>>>>>            Get ErrorMessage iIndex to sError 
29298>>>>>>>            Move (sMessage + C_NewLine + String(iError) + ": " + sError) to sMessage
29299>>>>>>>        Loop
29300>>>>>>>>
29300>>>>>>>        
29300>>>>>>>        Send ReportFatalError 500 "Internal server error" 0 sMessage
29301>>>>>>>    End_Procedure
29302>>>>>>>    
29302>>>>>>>    // Handles API calls made by the JavaScript Engine. It parses the incoming JSON and performs several validations. 
29302>>>>>>>    //
29302>>>>>>>    // HTTP errors will be returned on:
29302>>>>>>>    //  - Bad request format (couldn't parse JSON)
29302>>>>>>>    //  - Invalid JSON format
29302>>>>>>>    //  - Version check fails
29302>>>>>>>    //  - Other DataFlex errors occurred
29302>>>>>>>    //
29302>>>>>>>    // When succesfull CallAction on ghoWebApp is triggered to do framework processing.
29302>>>>>>>    Procedure OnHttpPost String sPath String sContentType String sAcceptType Integer iSize
29304>>>>>>>        UChar[] ucData ucEmpty
29306>>>>>>>        Boolean bSuccess bOrigEV bLogErrors
29306>>>>>>>        String sReason
29306>>>>>>>        Integer iErrorCount
29306>>>>>>>        
29306>>>>>>>        tWebCallContext cctx
29306>>>>>>>        tWebCallContext cctx
29306>>>>>>>        
29306>>>>>>>        Delegate Get pbLogInvalidRequests to bLogErrors 
29308>>>>>>>        
29308>>>>>>>        Send ErrorQueueStart 
29309>>>>>>>        Get pbAllErrorsToEventLog to bOrigEV
29310>>>>>>>        Set pbAllErrorsToEventLog to bLogErrors
29311>>>>>>>        
29311>>>>>>>        Move 0 to cctx.iFatalErrorCode
29312>>>>>>>        Move False to cctx.bCancel
29313>>>>>>>        
29313>>>>>>>        If (Lowercase(sContentType) contains "application/json") Begin
29315>>>>>>>        
29315>>>>>>>            //  Retrieve and parse JSON request
29315>>>>>>>            Get RequestDataUChar -1 to ucData
29316>>>>>>>            If (SizeOfArray(ucData) > 0) Begin
29318>>>>>>>                Get Create (RefClass(cJsonObject)) to cctx.hoJsonRequest
29319>>>>>>>            
29319>>>>>>>                //  Parse & validate request JSON
29319>>>>>>>                Get ParseUtf8 of cctx.hoJsonRequest ucData to bSuccess
29320>>>>>>>                If (bSuccess) Begin
29322>>>>>>>                    Move ucEmpty to ucData
29323>>>>>>>                
29323>>>>>>>                    //  Assemble the response JSON
29323>>>>>>>                    Get Create (RefClass(cJsonObject)) to cctx.hoJsonResponse
29324>>>>>>>                    Send InitializeJsonType of cctx.hoJsonResponse jsonTypeObject
29325>>>>>>>                    
29325>>>>>>>                    Send ErrorQueueEnd
29326>>>>>>>                    Get ErrorCount to iErrorCount
29327>>>>>>>                    
29327>>>>>>>                    If (iErrorCount = 0) Begin
29329>>>>>>>                        //  Reset error logging before going into application code
29329>>>>>>>                        Set pbAllErrorsToEventLog to bOrigEV
29330>>>>>>>                        
29330>>>>>>>                        Send ProcessRequest of (Host(Self)) (&cctx)
29331>>>>>>>                        
29331>>>>>>>                        //  Restart error queuing and logging after application code
29331>>>>>>>                        Send ErrorQueueStart 
29332>>>>>>>                        Set pbAllErrorsToEventLog to bLogErrors
29333>>>>>>>                        
29333>>>>>>>                        
29333>>>>>>>                        If (cctx.iFatalErrorCode= 0) Begin
29335>>>>>>>                            Send AddHttpResponseHeader "Cache-Control" "no-cache"
29336>>>>>>>                            Send AddHttpResponseHeader "Content-Type" "application/json; charset=utf-8"
29337>>>>>>>                            
29337>>>>>>>                            Get StringifyUtf8 of cctx.hoJsonResponse to ucData
29338>>>>>>>                            Send OutputUChar ucData  
29339>>>>>>>                        End
29339>>>>>>>>
29339>>>>>>>                        Else Begin
29340>>>>>>>                            Send ReportFatalError cctx.iFatalErrorCode "Fatal error"  0 cctx.sFatalError
29341>>>>>>>                        End
29341>>>>>>>>
29341>>>>>>>                    
29341>>>>>>>                        Send Destroy of cctx.hoJsonResponse
29342>>>>>>>                    End
29342>>>>>>>>
29342>>>>>>>                    Else  Begin
29343>>>>>>>                        Send ReportDataFlexErrors 
29344>>>>>>>                    End
29344>>>>>>>>
29344>>>>>>>                End
29344>>>>>>>>
29344>>>>>>>                Else Begin
29345>>>>>>>                    Get psParseError of cctx.hoJsonRequest to sReason
29346>>>>>>>                    Send ReportFatalError 400 "Bad request" 0 ("Unable to parse request data: " + sReason)
29347>>>>>>>                    
29347>>>>>>>                    If (bLogErrors) Begin
29349>>>>>>>                        Error DFERR_WEBAPP_BAD_REQUEST ("Unable to parse request data: " + sReason)
29350>>>>>>>>
29350>>>>>>>                    End
29350>>>>>>>>
29350>>>>>>>                End
29350>>>>>>>>
29350>>>>>>>                
29350>>>>>>>                Send Destroy of cctx.hoJsonRequest
29351>>>>>>>            End
29351>>>>>>>>
29351>>>>>>>            Else Begin
29352>>>>>>>                Send ReportFatalError 400 "Bad request" 0 "No request body"
29353>>>>>>>                
29353>>>>>>>                If (bLogErrors) Begin
29355>>>>>>>                    Error DFERR_WEBAPP_BAD_REQUEST "No request body"
29356>>>>>>>>
29356>>>>>>>                End
29356>>>>>>>>
29356>>>>>>>            End
29356>>>>>>>>
29356>>>>>>>        End
29356>>>>>>>>
29356>>>>>>>        Else Begin
29357>>>>>>>            Send ReportFatalError 400 "Bad request" 0 "Unexpected content-type header value."
29358>>>>>>>            If (bLogErrors) Begin
29360>>>>>>>                Error DFERR_WEBAPP_BAD_REQUEST "Unexpected content-type header value."
29361>>>>>>>>
29361>>>>>>>            End
29361>>>>>>>>
29361>>>>>>>        End
29361>>>>>>>>
29361>>>>>>>        
29361>>>>>>>        //  Cleanup
29361>>>>>>>        Send ErrorQueueEnd
29362>>>>>>>        Send ClearErrors
29363>>>>>>>        Set pbAllErrorsToEventLog to bOrigEV
29364>>>>>>>        
29364>>>>>>>    End_Procedure

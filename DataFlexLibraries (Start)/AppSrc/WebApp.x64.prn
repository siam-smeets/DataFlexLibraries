10191>>>>>>>>>        
10191>>>>>>>>>        // Get the cli handles
10191>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10192>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10193>>>>>>>>>        Get psDriverId            to sDrvrId
10194>>>>>>>>>        
10194>>>>>>>>>        // FUNC_SQLCOLUMNINFO will tell the driver which hdbc and hstmt to use
10194>>>>>>>>>        // in the next FUNC_SQLCOLUMNVALUE call.
10194>>>>>>>>>        // If hdbc and hstmt have not changed since the last call we don't have to set it.
10194>>>>>>>>>        If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
10196>>>>>>>>>            // Setup function arguments
10196>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                Callback 0 ;                Passing ihdbc iCol ihstmt ;                Result iVoid
10201>>>>>>>>>            Move ihstmt to giLastSQLhstmt
10202>>>>>>>>>            Move ihdbc to giLastSQLhdbc
10203>>>>>>>>>        End
10203>>>>>>>>>>
10203>>>>>>>>>        
10203>>>>>>>>>        If (iCol >= 1 and iCol <= piColumnCount(Self)) Begin
10205>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNVALUE ;                Callback 0 ;                Passing sResult sEmpty iCol ;                Result pResultWStr
10210>>>>>>>>>            
10210>>>>>>>>>            If (pResultWStr) Begin
10212>>>>>>>>>                Move (PointerToWString(pResultWStr)) to sResult
10213>>>>>>>>>            End
10213>>>>>>>>>>
10213>>>>>>>>>            Else Begin
10214>>>>>>>>>                Move "" to sResult
10215>>>>>>>>>            End
10215>>>>>>>>>>
10215>>>>>>>>>        End
10215>>>>>>>>>>
10215>>>>>>>>>        Else Begin
10216>>>>>>>>>            Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLColumnValue"
10217>>>>>>>>>        End
10217>>>>>>>>>>
10217>>>>>>>>>        

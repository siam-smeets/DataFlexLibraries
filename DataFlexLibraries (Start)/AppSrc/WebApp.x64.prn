30490>>>>>>>    Function IsLoadWebAppCall tWebCallContext ByRef cctx Returns Boolean
30492>>>>>>>        Integer i 
30492>>>>>>>        
30492>>>>>>>        For i from 0 to (SizeOfArray(cctx.request.aActions) - 1)
30498>>>>>>>>
30498>>>>>>>            If (cctx.request.aActions[i].sTarget = "" and cctx.request.aActions[i].sAction = "LoadWebApp") Begin
30500>>>>>>>                Function_Return True
30501>>>>>>>            End
30501>>>>>>>>
30501>>>>>>>        Loop
30502>>>>>>>>
30502>>>>>>>        
30502>>>>>>>        Function_Return False
30503>>>>>>>    End_Function
30504>>>>>>>    
30504>>>>>>>    Procedure Call_PreValidateSession tWebCallContext ByRef cctx
30506>>>>>>>        Boolean bSetCookie bLoadWebApp bValidSession
30506>>>>>>>        String sSessionKey sRemoteAddress
30506>>>>>>>        Handle hoSessionManager
30506>>>>>>>        
30506>>>>>>>        Get IsLoadWebAppCall (&cctx) to bLoadWebApp
30507>>>>>>>        
30507>>>>>>>        Move bLoadWebApp to bSetCookie
30508>>>>>>>        
30508>>>>>>>        //  Read the session key
30508>>>>>>>        Get ReadSessionKey to sSessionKey
30509>>>>>>>        
30509>>>>>>>        // Get the handle here so we do not have to call the function multiple times
30509>>>>>>>        Get SessionManager to hoSessionManager
30510>>>>>>>        
30510>>>>>>>        //  Create new session if no session key is sent
30510>>>>>>>        If (Trim(sSessionKey) = "" and bLoadWebApp) Begin
30512>>>>>>>            Get ServerVariable of (ServiceDispatcher(Self)) "REMOTE_ADDR" to sRemoteAddress
30513>>>>>>>            Get CreateSession of hoSessionManager sRemoteAddress to sSessionKey
30514>>>>>>>            Move True to bSetCookie
30515>>>>>>>        End
30515>>>>>>>>
30515>>>>>>>
30515>>>>>>>        //  Validate session
30515>>>>>>>        Get ValidateSession of hoSessionManager sSessionKey bLoadWebApp to bValidSession
30516>>>>>>>        Get psSessionKey of hoSessionManager to sSessionKey //  The session key might have changed during validaiton
30517>>>>>>>        If (bValidSession) Begin
30519>>>>>>>
30519>>>>>>>            //  Write the cookie if session is created or on initial call
30519>>>>>>>            If (bSetCookie) Begin
30521>>>>>>>                Send StoreSessionKey sSessionKey
30522>>>>>>>                Move True to cctx.bNotifyChangeRights
30523>>>>>>>            End
30523>>>>>>>>
30523>>>>>>>        End
30523>>>>>>>>
30523>>>>>>>        Else Begin
30524>>>>>>>            //  Clear the vaulty session cookie
30524>>>>>>>            Send StoreSessionKey ""
30525>>>>>>>            Move False to cctx.bSuccess
30526>>>>>>>        End
30526>>>>>>>>

19052>>>>>>>>>>>>>    Procedure RequestSaveCallBack Integer eConfirmMode
19054>>>>>>>>>>>>>        Boolean bActive
19054>>>>>>>>>>>>>        
19054>>>>>>>>>>>>>        //  Security check
19054>>>>>>>>>>>>>        WebGet pbSaveCallbackActive to bActive
19055>>>>>>>>>>>>>        If (not(bActive)) Begin
19057>>>>>>>>>>>>>            Error DFERR_WEBAPP_ACCESS_DENIED
19058>>>>>>>>>>>>>>
19058>>>>>>>>>>>>>            Procedure_Return
19059>>>>>>>>>>>>>        End
19059>>>>>>>>>>>>>>
19059>>>>>>>>>>>>>        WebSet pbSaveCallbackActive to False
19060>>>>>>>>>>>>>        
19060>>>>>>>>>>>>>        // called as a callback started by Request_Save
19060>>>>>>>>>>>>>        If (eConfirmMode=cmYes) Begin
19062>>>>>>>>>>>>>            Send RequestSaveExec
19063>>>>>>>>>>>>>        End
19063>>>>>>>>>>>>>>
19063>>>>>>>>>>>>>    End_Procedure
19064>>>>>>>>>>>>>    
19064>>>>>>>>>>>>>    // What to do with a new unchanged record. The normal framework behavior has always been
19064>>>>>>>>>>>>>    // to do nothing. With drilldown, it might make the most sense to attempt a save. Currently
19064>>>>>>>>>>>>>    // when drilldown, we will return True, else false
19064>>>>>>>>>>>>>    Function AlwaysSaveNew Returns Boolean
19066>>>>>>>>>>>>>        Integer eViewStyle
19066>>>>>>>>>>>>>        Boolean bSave
19066>>>>>>>>>>>>>        Get WebViewStyle to eViewStyle
19067>>>>>>>>>>>>>        If (eViewStyle=wvsDrillDown) Begin
19069>>>>>>>>>>>>>            Get AlwaysSaveWhenNewDrillDown to bSave
19070>>>>>>>>>>>>>        End
19070>>>>>>>>>>>>>>
19070>>>>>>>>>>>>>        Function_Return bSave
19071>>>>>>>>>>>>>    End_Function
19072>>>>>>>>>>>>>    
19072>>>>>>>>>>>>>    Procedure Request_Save
19074>>>>>>>>>>>>>        Handle hoServer
19074>>>>>>>>>>>>>        Integer iRetVal
19074>>>>>>>>>>>>>        Boolean bDelegate bRequestValidateAll bShouldSave bHasRec
19074>>>>>>>>>>>>>        
19074>>>>>>>>>>>>>        Get DelegateDeoRequest to bDelegate
19075>>>>>>>>>>>>>        If bDelegate Begin
19077>>>>>>>>>>>>>            Delegate Send Request_Save
19079>>>>>>>>>>>>>            Procedure_Return
19080>>>>>>>>>>>>>        End
19080>>>>>>>>>>>>>>
19080>>>>>>>>>>>>>        
19080>>>>>>>>>>>>>        Get Server to hoServer
19081>>>>>>>>>>>>>        
19081>>>>>>>>>>>>>        If ((hoServer <> 0) and not(Read_Only_State(hoServer))) Begin
19083>>>>>>>>>>>>>            Get Should_Save of hoServer to bShouldSave
19084>>>>>>>>>>>>>            // if no changes but a new record, we may want to attempt a save anyway (for drilldown style)
19084>>>>>>>>>>>>>            If (not(bShouldSave)) Begin
19086>>>>>>>>>>>>>                Get HasRecord of hoServer to bHasRec
19087>>>>>>>>>>>>>                If not bHasRec Begin
19089>>>>>>>>>>>>>                    Get AlwaysSaveNew to bShouldSave
19090>>>>>>>>>>>>>                End
19090>>>>>>>>>>>>>>
19090>>>>>>>>>>>>>            End
19090>>>>>>>>>>>>>>
19090>>>>>>>>>>>>>            If bShouldSave Begin
19092>>>>>>>>>>>>>                // Handle save validation....
19092>>>>>>>>>>>>>                Get pbRequesteValidateAll to bRequestValidateAll
19093>>>>>>>>>>>>>                If bRequestValidateAll Begin
19095>>>>>>>>>>>>>                    Get Request_Validate_All of hoServer to iRetVal
19096>>>>>>>>>>>>>                End
19096>>>>>>>>>>>>>>
19096>>>>>>>>>>>>>                Else Begin
19097>>>>>>>>>>>>>                    Get Request_Validate of hoServer to iRetVal
19098>>>>>>>>>>>>>                End
19098>>>>>>>>>>>>>>
19098>>>>>>>>>>>>>                If (iRetVal=0) Begin
19100>>>>>>>>>>>>>                    WebSet pbSaveCallbackActive to True
19101>>>>>>>>>>>>>                    Send VerifyRequest (RefProc(RequestSaveCallBack)) (RefFunc(Verify_Save_Msg))
19102>>>>>>>>>>>>>                End
19102>>>>>>>>>>>>>>
19102>>>>>>>>>>>>>            End
19102>>>>>>>>>>>>>>
19102>>>>>>>>>>>>>            Else Begin
19103>>>>>>>>>>>>>                If (pbClearAfterSave(Self)) Begin
19105>>>>>>>>>>>>>                    Send RequestClearExec
19106>>>>>>>>>>>>>                End
19106>>>>>>>>>>>>>>
19106>>>>>>>>>>>>>                Send OnViewSaved hoServer False
19107>>>>>>>>>>>>>            End
19107>>>>>>>>>>>>>>
19107>>>>>>>>>>>>>        End
19107>>>>>>>>>>>>>>
19107>>>>>>>>>>>>>    End_Procedure
19108>>>>>>>>>>>>>    
19108>>>>>>>>>>>>>    
19108>>>>>>>>>>>>>    Procedure RequestSaveExec
19110>>>>>>>>>>>>>        Handle hoServer
19110>>>>>>>>>>>>>        Integer iRetVal
19110>>>>>>>>>>>>>        Boolean bRequestValidateAll bErr
19110>>>>>>>>>>>>>        Get Server to hoServer
19111>>>>>>>>>>>>>        // this may be a 2nd request_validate, that's ok.
19111>>>>>>>>>>>>>        Get pbRequesteValidateAll to bRequestValidateAll
19112>>>>>>>>>>>>>        If bRequestValidateAll Begin
19114>>>>>>>>>>>>>            Get Request_Validate_All of hoServer to iRetVal
19115>>>>>>>>>>>>>        End
19115>>>>>>>>>>>>>>
19115>>>>>>>>>>>>>        Else Begin
19116>>>>>>>>>>>>>            Get Request_Validate of hoServer to iRetVal
19117>>>>>>>>>>>>>        End
19117>>>>>>>>>>>>>>
19117>>>>>>>>>>>>>        If (iRetVal=0) Begin
19119>>>>>>>>>>>>>            Move False to Err
19120>>>>>>>>>>>>>            Send Request_Save to hoServer
19121>>>>>>>>>>>>>            Move Err to bErr
19122>>>>>>>>>>>>>            If (not(bErr)) Begin
19124>>>>>>>>>>>>>                // clear saved record
19124>>>>>>>>>>>>>                If (pbClearAfterSave(Self)) Begin
19126>>>>>>>>>>>>>                    Send RequestClearExec
19127>>>>>>>>>>>>>                End
19127>>>>>>>>>>>>>>
19127>>>>>>>>>>>>>                Send OnViewSaved hoServer True
19128>>>>>>>>>>>>>            End
19128>>>>>>>>>>>>>>
19128>>>>>>>>>>>>>        End
19128>>>>>>>>>>>>>>
19128>>>>>>>>>>>>>    End_Procedure
19129>>>>>>>>>>>>>    

24260>>>>>>>>>>>>>>>>>>>        Integer eFieldType
24260>>>>>>>>>>>>>>>>>>>
24260>>>>>>>>>>>>>>>>>>>        If (iFile = 0 or iField = 0) Begin
24262>>>>>>>>>>>>>>>>>>>            Function_Return False
24263>>>>>>>>>>>>>>>>>>>        End
24263>>>>>>>>>>>>>>>>>>>>

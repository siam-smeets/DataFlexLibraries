39257>>>>>    
39257>>>>>
39257>>>>>    
39257>>>>>    
39257>>>>>    
39257>>>>>    // Splits a string into an array of strings using the given delimeter.
39257>>>>>    //
39257>>>>>    // Params:
39257>>>>>    //     sString     The string to split.
39257>>>>>    //     sDel        The delimiter (like "," or "|")
39257>>>>>    // Returns:
39257>>>>>    //     Array of strings (not including the delimiters itself.
39257>>>>>    Function StrSplit String sString String sDel Returns String[]
39259>>>>>        String[] asResult
39260>>>>>        Integer iStart iEnd iDel
39260>>>>>        
39260>>>>>        If (sString <> "") Begin
39262>>>>>            
39262>>>>>            Move 1 to iStart
39263>>>>>            
39263>>>>>            If (sDel  <> "") Begin
39265>>>>>                Move (Length(sDel)) to iDel
39266>>>>>                Move (Pos(sDel, sString, iStart)) to iEnd
39267>>>>>                
39267>>>>>                While (iEnd > 0)
39271>>>>>                    Move (Mid(sString,  iEnd - iStart, iStart)) to asResult[SizeOfArray(asResult)]
39272>>>>>                    
39272>>>>>                    Move (iEnd + iDel) to iStart
39273>>>>>                    Move (Pos(sDel, sString, iStart)) to iEnd
39274>>>>>                Loop
39275>>>>>>
39275>>>>>                
39275>>>>>                Move (Right(sString,  Length(sString) - iStart + 1)) to asResult[SizeOfArray(asResult)]
39276>>>>>            End
39276>>>>>>
39276>>>>>            Else Begin
39277>>>>>                Move sString to asResult[SizeOfArray(asResult)]
39278>>>>>            End
39278>>>>>>
39278>>>>>            
39278>>>>>        End
39278>>>>>>
39278>>>>>        
39278>>>>>        
39278>>>>>        Function_Return asResult
39279>>>>>    End_Function
39280>>>>>    
39280>>>>>    // Encrypts a string into an unreadable hash that can later be decrypted using DecryptKey.
39280>>>>>    //
39280>>>>>    // Params:
39280>>>>>    //   sPlainText     String to encrypt.
39280>>>>>    // Returns:
39280>>>>>    //   Base64 encoded hash.
39280>>>>>    Function EncryptKey String sPlainText Returns String
39282>>>>>        String sEncryptPassword sBase64
39282>>>>>        UChar[] ucBinary
39283>>>>>        Address pBase64
39283>>>>>        Integer iVoid
39283>>>>>        
39283>>>>>        //  Encrypt Key
39283>>>>>        Get psEncryptPassword of (Host(Self)) to sEncryptPassword
39284>>>>>        If (sEncryptPassword = "") Begin
39286>>>>>            Error DFERR_PROGRAM "No encryption password set" 
39287>>>>>>
39287>>>>>        End
39287>>>>>>
39287>>>>>        
39287>>>>>        Get Encrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) (StringToUCharArray(sPlainText)) to ucBinary
39288>>>>>        
39288>>>>>        If (SizeOfArray(ucBinary) = 0) Begin
39290>>>>>            Error DFERR_PROGRAM "Unable to generate download key"
39291>>>>>>
39291>>>>>            Function_Return ""
39292>>>>>        End
39292>>>>>>
39292>>>>>        
39292>>>>>        //  Encode binary hash to Base64
39292>>>>>        Move (Base64Encode(AddressOf(ucBinary), SizeOfArray(ucBinary))) to pBase64
39293>>>>>        Move (PointerToString(pBase64)) to sBase64
39294>>>>>        Move (Free(pBase64)) to iVoid
39295>>>>>        
39295>>>>>        //  Replace URL sensitive characters
39295>>>>>        Move (Replaces("/", sBase64, "-")) to sBase64
39296>>>>>        Move (Replaces("+", sBase64, "_")) to sBase64
39297>>>>>        Move (Replaces("=", sBase64, "~")) to sBase64
39298>>>>>        
39298>>>>>        Function_Return sBase64
39299>>>>>    End_Function
39300>>>>>    
39300>>>>>    
39300>>>>>    // Decrypts the unreadable hash generated by EncryptKey into a readable string.
39300>>>>>    //
39300>>>>>    // Params:
39300>>>>>    //   sKey       Encrypted hash.
39300>>>>>    // Returns:
39300>>>>>    //   Readable string.
39300>>>>>    Function DecryptKey String sKey Returns String
39302>>>>>        String sEncryptPassword 
39302>>>>>        UChar[] ucBinary ucPlainKey
39304>>>>>        Boolean bIsHex
39304>>>>>        Integer iLen iVoid
39304>>>>>        Address pBinary
39304>>>>>        
39304>>>>>        If (sKey <> "") Begin
39306>>>>>            //  Replace URL sensitive characters back
39306>>>>>            Move (Replaces("-", sKey, "/")) to sKey
39307>>>>>            Move (Replaces("_", sKey, "+")) to sKey
39308>>>>>            Move (Replaces("~", sKey, "=")) to sKey
39309>>>>>            
39309>>>>>            //  Decode from Base64
39309>>>>>            Move (Base64Decode(AddressOf(sKey), &iLen)) to pBinary
39310>>>>>            
39310>>>>>            Move (ResizeArray(ucBinary, iLen, 0)) to ucBinary
39311>>>>>            Move (MemCopy(AddressOf(ucBinary), pBinary, iLen)) to iVoid
39312>>>>>            
39312>>>>>            Move (Free(pBinary)) to iVoid
39313>>>>>    
39313>>>>>            //  Encrypted binary hash to string
39313>>>>>            Get psEncryptPassword of (Host(Self)) to sEncryptPassword
39314>>>>>            Get Decrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) ucBinary to ucPlainKey
39315>>>>>        End
39315>>>>>>
39315>>>>>        
39315>>>>>        Function_Return (UCharArrayToString(ucPlainKey))
39316>>>>>    End_Function

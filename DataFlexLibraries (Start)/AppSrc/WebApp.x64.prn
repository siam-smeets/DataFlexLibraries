24268>>>>>>>>>>>>>>>>>>>
24268>>>>>>>>>>>>>>>>>>>    Function BuildFilterExpressionForDD Handle hoCurrentDD Handle hoTargetDD Integer iTargetField String sSearchValue Returns String
24270>>>>>>>>>>>>>>>>>>>        Integer iCurrentFile iTargetFile
24270>>>>>>>>>>>>>>>>>>>        String sFilter
24270>>>>>>>>>>>>>>>>>>>        Boolean bSupportsLike
24270>>>>>>>>>>>>>>>>>>>
24270>>>>>>>>>>>>>>>>>>>        If (hoCurrentDD = 0 or hoTargetDD = 0 or iTargetField = 0) Function_Return ""
24273>>>>>>>>>>>>>>>>>>>
24273>>>>>>>>>>>>>>>>>>>        Get Main_File of hoCurrentDD to iCurrentFile
24274>>>>>>>>>>>>>>>>>>>        Get Main_File of hoTargetDD to iTargetFile
24275>>>>>>>>>>>>>>>>>>>
24275>>>>>>>>>>>>>>>>>>>        If (iCurrentFile <> iTargetFile) Function_Return ""
24278>>>>>>>>>>>>>>>>>>>
24278>>>>>>>>>>>>>>>>>>>        Get FieldSupportsFilterLike iTargetFile iTargetField to bSupportsLike
24279>>>>>>>>>>>>>>>>>>>        If (not(bSupportsLike)) Function_Return ""
24282>>>>>>>>>>>>>>>>>>>
24282>>>>>>>>>>>>>>>>>>>        Get SQLStrLike of hoCurrentDD iTargetField sSearchValue to sFilter
24283>>>>>>>>>>>>>>>>>>>
24283>>>>>>>>>>>>>>>>>>>        Function_Return sFilter
24284>>>>>>>>>>>>>>>>>>>    End_Function
24285>>>>>>>>>>>>>>>>>>>
24285>>>>>>>>>>>>>>>>>>>    Function BuildFilterExpressionForField Handle hoReadingDD Integer iFile Integer iField String sSearchValue Returns String
24287>>>>>>>>>>>>>>>>>>>        String sColumnFilter
24287>>>>>>>>>>>>>>>>>>>        Handle hoColumnDD
24287>>>>>>>>>>>>>>>>>>>
24287>>>>>>>>>>>>>>>>>>>        If (hoReadingDD = 0 or sSearchValue = "" or iFile = 0 or iField = 0) Function_Return ""
24290>>>>>>>>>>>>>>>>>>>
24290>>>>>>>>>>>>>>>>>>>        Get Which_Data_Set of hoReadingDD iFile to hoColumnDD
24291>>>>>>>>>>>>>>>>>>>        If (hoColumnDD = 0) Function_Return ""
24294>>>>>>>>>>>>>>>>>>>
24294>>>>>>>>>>>>>>>>>>>        Get BuildFilterExpressionForDD hoReadingDD hoColumnDD iField sSearchValue to sColumnFilter
24295>>>>>>>>>>>>>>>>>>>        If (sColumnFilter <> "") Begin
24297>>>>>>>>>>>>>>>>>>>            Move ("(" + sColumnFilter + ")") to sColumnFilter
24298>>>>>>>>>>>>>>>>>>>        End
24298>>>>>>>>>>>>>>>>>>>>
24298>>>>>>>>>>>>>>>>>>>
24298>>>>>>>>>>>>>>>>>>>        Function_Return sColumnFilter
24299>>>>>>>>>>>>>>>>>>>    End_Function
24300>>>>>>>>>>>>>>>>>>>
24300>>>>>>>>>>>>>>>>>>>    Function BuildFilterExpressionForFields Handle hoReadingDD Integer[] iaFiles Integer[] iaFields String sSearchValue Returns String
24302>>>>>>>>>>>>>>>>>>>        Integer iCount iFile iField
24302>>>>>>>>>>>>>>>>>>>        String sFilter sColumnFilter
24302>>>>>>>>>>>>>>>>>>>
24302>>>>>>>>>>>>>>>>>>>        If (hoReadingDD = 0 or sSearchValue = "") Function_Return ""
24305>>>>>>>>>>>>>>>>>>>
24305>>>>>>>>>>>>>>>>>>>        For iCount from 0 to (SizeOfArray(iaFiles) - 1)
24311>>>>>>>>>>>>>>>>>>>>
24311>>>>>>>>>>>>>>>>>>>            Move iaFiles[iCount] to iFile
24312>>>>>>>>>>>>>>>>>>>            Move iaFields[iCount] to iField
24313>>>>>>>>>>>>>>>>>>>
24313>>>>>>>>>>>>>>>>>>>            Get BuildFilterExpressionForField hoReadingDD iFile iField sSearchValue to sColumnFilter
24314>>>>>>>>>>>>>>>>>>>            If (sColumnFilter <> "") Begin
24316>>>>>>>>>>>>>>>>>>>                If (sFilter <> "") Begin
24318>>>>>>>>>>>>>>>>>>>                    Move (sFilter + " OR ") to sFilter
24319>>>>>>>>>>>>>>>>>>>                End
24319>>>>>>>>>>>>>>>>>>>>
24319>>>>>>>>>>>>>>>>>>>                Move (sFilter + sColumnFilter) to sFilter
24320>>>>>>>>>>>>>>>>>>>            End
24320>>>>>>>>>>>>>>>>>>>>
24320>>>>>>>>>>>>>>>>>>>        Loop
24321>>>>>>>>>>>>>>>>>>>>
24321>>>>>>>>>>>>>>>>>>>
24321>>>>>>>>>>>>>>>>>>>        If (sFilter <> "") Begin
24323>>>>>>>>>>>>>>>>>>>            Move ("(" + sFilter + ")") to sFilter
24324>>>>>>>>>>>>>>>>>>>        End
24324>>>>>>>>>>>>>>>>>>>>
24324>>>>>>>>>>>>>>>>>>>
24324>>>>>>>>>>>>>>>>>>>        Function_Return sFilter
24325>>>>>>>>>>>>>>>>>>>    End_Function
24326>>>>>>>>>>>>>>>>>>>
24326>>>>>>>>>>>>>>>>>>>    Function BuildAndAppendFilterExpression Handle hoDD Integer[] iaFiles Integer[] iaFields String sSearchValue String sOrigFilter Returns String
24328>>>>>>>>>>>>>>>>>>>        String sSearchFilter sFilter
24328>>>>>>>>>>>>>>>>>>>
24328>>>>>>>>>>>>>>>>>>>        If (hoDD = 0) Function_Return sOrigFilter
24331>>>>>>>>>>>>>>>>>>>
24331>>>>>>>>>>>>>>>>>>>        Get BuildFilterExpressionForFields hoDD iaFiles iaFields sSearchValue to sSearchFilter
24332>>>>>>>>>>>>>>>>>>>        If (sSearchFilter = "") Begin
24334>>>>>>>>>>>>>>>>>>>            Function_Return sOrigFilter
24335>>>>>>>>>>>>>>>>>>>        End
24335>>>>>>>>>>>>>>>>>>>>
24335>>>>>>>>>>>>>>>>>>>
24335>>>>>>>>>>>>>>>>>>>        Move sSearchFilter to sFilter
24336>>>>>>>>>>>>>>>>>>>        If (sOrigFilter <> "") Begin
24338>>>>>>>>>>>>>>>>>>>            Get SQLStrAppend of hoDD sOrigFilter sSearchFilter to sFilter
24339>>>>>>>>>>>>>>>>>>>        End
24339>>>>>>>>>>>>>>>>>>>>
24339>>>>>>>>>>>>>>>>>>>
24339>>>>>>>>>>>>>>>>>>>        Function_Return sFilter
24340>>>>>>>>>>>>>>>>>>>    End_Function
24341>>>>>>>>>>>>>>>>>>>
24341>>>>>>>>>>>>>>>>>>>    Procedure ApplyFilterExpression Handle hoDD Integer[] iaFiles Integer[] iaFields String sSearchValue String ByRef sOrigFilter Boolean ByRef bOrigActive Boolean ByRef bApplied
24343>>>>>>>>>>>>>>>>>>>        String sFilter
24343>>>>>>>>>>>>>>>>>>>
24343>>>>>>>>>>>>>>>>>>>        Move False to bApplied
24344>>>>>>>>>>>>>>>>>>>        Move "" to sOrigFilter
24345>>>>>>>>>>>>>>>>>>>        Move False to bOrigActive
24346>>>>>>>>>>>>>>>>>>>
24346>>>>>>>>>>>>>>>>>>>        If (hoDD = 0) Begin
24348>>>>>>>>>>>>>>>>>>>            Procedure_Return
24349>>>>>>>>>>>>>>>>>>>        End

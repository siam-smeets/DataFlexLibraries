37630>>>>>>>    // Convert a clColor to a hex value
37630>>>>>>>    // Taken and adapted from Convetions lib
37630>>>>>>>    //
37630>>>>>>>    // iColor: The cl Color value
37630>>>>>>>    //
37630>>>>>>>    // Returns: HTML HEX color value as a string
37630>>>>>>>    Function GDIColorToHex Integer iColor Returns String
37632>>>>>>>        String sResult
37632>>>>>>>        Repeat
37632>>>>>>>>
37632>>>>>>>            Move (sResult + Mid ("0123456789ABCDEF", 1, ((iColor iand |CI$0F) + 1))) to sResult
37633>>>>>>>            Move (iColor / |CI$10) to iColor
37634>>>>>>>        Until (iColor = 0)
37636>>>>>>>
37636>>>>>>>        // Fill remaining
37636>>>>>>>        While (Length(sResult) < 6)
37640>>>>>>>            Move (sResult + "0") to sResult
37641>>>>>>>        Loop
37642>>>>>>>>
37642>>>>>>>
37642>>>>>>>        // Prepend hash symbol
37642>>>>>>>        Move ("#" + sResult) to sResult
37643>>>>>>>
37643>>>>>>>        Function_Return sResult
37644>>>>>>>    End_Function

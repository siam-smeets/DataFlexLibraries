33919>>>>>>>        // If you want to do something else, like hide it, you can augment this or
33919>>>>>>>        // augment OnChangeRights
33919>>>>>>>        If bHideViewWhenNoAccess Begin
33921>>>>>>>            WebGet pbRender to bEnabled
33922>>>>>>>            If (bEnabled <> bAllowAccess) Begin
33924>>>>>>>                WebSet pbRender to bAllowAccess
33925>>>>>>>            End
33925>>>>>>>>
33925>>>>>>>        End

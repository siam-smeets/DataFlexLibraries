6685>>>>>>>    // Returns:
6685>>>>>>>    //       The record id string based on piPrimaryIndex.
6685>>>>>>>    Function PrimaryRecordId Returns String
6687>>>>>>>        Integer iIndex iFile iSegments iSegment iField
6687>>>>>>>        String sVal sId
6687>>>>>>>
6687>>>>>>>        Get Main_File to iFile
6688>>>>>>>        Get piPrimaryIndex to iIndex
6689>>>>>>>
6689>>>>>>>        If (iIndex < 0) Begin
6691>>>>>>>            Get_Attribute DF_FILE_PRIMARY_INDEX of iFile to iIndex
6694>>>>>>>        End
6694>>>>>>>>
6694>>>>>>>
6694>>>>>>>        Get_Attribute DF_INDEX_NUMBER_SEGMENTS of iFile iIndex to iSegments
6697>>>>>>>        For iSegment from 1 to iSegments
6703>>>>>>>>
6703>>>>>>>            Get_Attribute DF_INDEX_SEGMENT_FIELD of iFile iIndex iSegment to iField
6706>>>>>>>
6706>>>>>>>            Get_Field_Value iFile iField to sVal
6709>>>>>>>            Move (Trim(sVal)) to sVal
6710>>>>>>>
6710>>>>>>>            //  Encode join sign for multi segment indexes
6710>>>>>>>            If (iSegments > 1) Begin
6712>>>>>>>                Move (Replaces("_", sVal, "~5F~")) to sVal
6713>>>>>>>            End
6713>>>>>>>>
6713>>>>>>>
6713>>>>>>>            If (iSegment = 1) Begin
6715>>>>>>>                Move sVal to sId
6716>>>>>>>            End
6716>>>>>>>>
6716>>>>>>>            Else Begin
6717>>>>>>>                Move (sId + "_" + sVal) to sId
6718>>>>>>>            End
6718>>>>>>>>
6718>>>>>>>
6718>>>>>>>        Loop
6719>>>>>>>>
6719>>>>>>>
6719>>>>>>>        Function_Return sId
6720>>>>>>>    End_Function
6721>>>>>>>
6721>>>>>>>
6721>>>>>>>    // Finds a record on the global buffer based on the record id.
6721>>>>>>>    //
6721>>>>>>>    // Params:
6721>>>>>>>    //       sRecordId   Record id generated by PrimaryRecordId.
6721>>>>>>>    Function FindByPrimaryRecordId String sRecordId Returns Boolean
6723>>>>>>>        Integer iIndex iFile iSegments iSegment iField
6723>>>>>>>        String[] aValues
6724>>>>>>>        String sVal
6724>>>>>>>        Boolean bTrapped
6724>>>>>>>
6724>>>>>>>        Get Main_File to iFile
6725>>>>>>>        Get piPrimaryIndex to iIndex
6726>>>>>>>
6726>>>>>>>        If (iIndex < 0) Begin
6728>>>>>>>            Get_Attribute DF_FILE_PRIMARY_INDEX of iFile to iIndex
6731>>>>>>>        End
6731>>>>>>>>
6731>>>>>>>
6731>>>>>>>        Get_Attribute DF_INDEX_NUMBER_SEGMENTS of iFile iIndex to iSegments
6734>>>>>>>
6734>>>>>>>        If (iSegments > 1) Begin
6736>>>>>>>            Move (StrSplitToArray(sRecordId, "_")) to aValues
6737>>>>>>>        End
6737>>>>>>>>
6737>>>>>>>        Else Begin
6738>>>>>>>            Move sRecordId to aValues[0]
6739>>>>>>>        End
6739>>>>>>>>
6739>>>>>>>
6739>>>>>>>        If (iSegments = SizeOfArray(aValues)) Begin
6741>>>>>>>            Clear iFile
6742>>>>>>>
6742>>>>>>>            Send Ignore_Error of Error_Object_Id 56
6743>>>>>>>            Send Ignore_Error of Error_Object_Id 11
6744>>>>>>>
6744>>>>>>>            For iSegment from 1 to iSegments
6750>>>>>>>>
6750>>>>>>>                Get_Attribute DF_INDEX_SEGMENT_FIELD of iFile iIndex iSegment to iField
6753>>>>>>>
6753>>>>>>>                Move aValues[iSegment - 1] to sVal
6754>>>>>>>                If (iSegments > 1) Begin
6756>>>>>>>                    Move (Replaces("~5F~", sVal, "_")) to sVal
6757>>>>>>>                End
6757>>>>>>>>
6757>>>>>>>
6757>>>>>>>                Set_Field_Value iFile iField to sVal
6760>>>>>>>            Loop
6761>>>>>>>>
6761>>>>>>>            Send Trap_Error of Error_Object_Id 56
6762>>>>>>>            Send Trap_Error of Error_Object_Id 11
6763>>>>>>>
6763>>>>>>>            Vfind iFile iIndex EQ
6765>>>>>>>
6765>>>>>>>            Function_Return (Found)
6766>>>>>>>        End
6766>>>>>>>>
6766>>>>>>>
6766>>>>>>>        Function_Return False
6767>>>>>>>    End_Function
6768>>>>>>>
6768>>>>>>>    // Converts a RecordId to a RowId by finding it on the global buffer.
6768>>>>>>>    //
6768>>>>>>>    // Params:
6768>>>>>>>    //       sRecordId   Record id based on piPrimaryIndex.
6768>>>>>>>    //       rRowId      (ByRef) Will be filled with the rowid.
6768>>>>>>>    // Returns:
6768>>>>>>>    //       True if the record id was valid.
6768>>>>>>>    Function RecordIdToRowId String sRecordId RowID ByRef rRowId Returns Boolean
6770>>>>>>>        Boolean bFound
6770>>>>>>>
6770>>>>>>>        Get FindByPrimaryRecordId sRecordId to bFound
6771>>>>>>>        If (bFound) Begin
6773>>>>>>>            Move (GetRowID(Main_File(Self))) to rRowId
6774>>>>>>>        End
6774>>>>>>>>
6774>>>>>>>        Else Begin
6775>>>>>>>            Move (NullRowID()) to rRowId
6776>>>>>>>        End
6776>>>>>>>>
6776>>>>>>>
6776>>>>>>>        Function_Return bFound
6777>>>>>>>    End_Function
6778>>>>>>>
6778>>>>>>>    // Converts a RowId into a record ID. Note that it performs a find on the global buffer.
6778>>>>>>>    //
6778>>>>>>>    // Params:
6778>>>>>>>    //       riRowId     RowID.
6778>>>>>>>    // Returns:
6778>>>>>>>    //       Record id based on piPrimaryIndex.
6778>>>>>>>    Function RowIdToRecordId RowID riRowId Returns String
6780>>>>>>>        Boolean bFound
6780>>>>>>>        String sRecId
6780>>>>>>>
6780>>>>>>>        If (not(IsNullRowID(riRowId))) Begin
6782>>>>>>>            Move (FindByRowID(Main_File(Self), riRowId)) to bFound
6783>>>>>>>
6783>>>>>>>            If (bFound) Begin
6785>>>>>>>                Get PrimaryRecordId to sRecId
6786>>>>>>>            End
6786>>>>>>>>
6786>>>>>>>        End
6786>>>>>>>>
6786>>>>>>>
6786>>>>>>>        Function_Return sRecId
6787>>>>>>>    End_Function
6788>>>>>>>End_Class

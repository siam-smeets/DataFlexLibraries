22443>>>>>>>>>>>>>>>        Move (SizeOfArray(gaAdvSyncProps[iStoreIndex]) - 1) to iTo
22444>>>>>>>>>>>>>>>        For iCur from 0 to iTo
22450>>>>>>>>>>>>>>>>
22450>>>>>>>>>>>>>>>            If (gaAdvSyncProps[iStoreIndex][iCur].hoObj = hoObj and Uppercase(gaAdvSyncProps[iStoreIndex][iCur].tSyncProp.sP) = sPropName) Begin
22452>>>>>>>>>>>>>>>                Function_Return iCur
22453>>>>>>>>>>>>>>>            End
22453>>>>>>>>>>>>>>>>
22453>>>>>>>>>>>>>>>        Loop
22454>>>>>>>>>>>>>>>>
22454>>>>>>>>>>>>>>>        
22454>>>>>>>>>>>>>>>        Function_Return -1
22455>>>>>>>>>>>>>>>    End_Function

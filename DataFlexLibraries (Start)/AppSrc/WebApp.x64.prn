9356>>>>>>>>>    // Redirect an exisitng connection. The existing connection
9356>>>>>>>>>    // will point to another database but all tables will stay
9356>>>>>>>>>    // open!
9356>>>>>>>>>    Function RedirectConnection String sOldConnection String sNewConnection Returns Integer
9358>>>>>>>>>        String  sDriver
9358>>>>>>>>>        String  sVoid
9358>>>>>>>>>        Integer iResult
9358>>>>>>>>>        Integer iVoid
9358>>>>>>>>>        
9358>>>>>>>>>        Get psDriverID to sDriver
9359>>>>>>>>>        If (sDriver <> "") Begin
9361>>>>>>>>>            Call_Driver 0 sDriver Function CLI_REDIRECTCONNECTION Callback 0 Passing sOldConnection sNewConnection iVoid Result iResult
9366>>>>>>>>>        End
9366>>>>>>>>>>
9366>>>>>>>>>        Function_Return iResult
9367>>>>>>>>>    End_Function
9368>>>>>>>>>    
9368>>>>>>>>>    // Redirect a connection of a connection ID
9368>>>>>>>>>    // sConnectionId must contain a valid ConnectionId ("DFCONNID=MyID")
9368>>>>>>>>>    // sConnectString must contain a valid connectstring ("SERVER=MyServer;DATABASE=MyDatabase;UID=MyName;PWD=MyPassword")
9368>>>>>>>>>    //
9368>>>>>>>>>    // RedirectIDConnectString will redirect from the old connection (Server/Database the connectionId currently points to)
9368>>>>>>>>>    // to the new connection (Server/Database specified in sConnectString)
9368>>>>>>>>>    // All opened tables will be moved from old connection to new connection. (Tables must have identical structure in both connections)
9368>>>>>>>>>    //
9368>>>>>>>>>    // If bKeepLoggedIn = false, the new connection will be logged in, the old connection will be logged out
9368>>>>>>>>>    // If bKeepLoggedIn = true, connections will remain open and re-used on next redirectIdConnection
9368>>>>>>>>>    //
9368>>>>>>>>>    // Returns:
9368>>>>>>>>>    //     0 when the redirection was successful.
9368>>>>>>>>>    //     1 if the connection ID does not exist or can not be found.
9368>>>>>>>>>    //     2 login into the new connection failed.
9368>>>>>>>>>    //
9368>>>>>>>>>    Function RedirectIdConnectString String sConnectionId String sConnectString Boolean bKeepLoggedIn Returns Integer
9370>>>>>>>>>        String  sDriver
9370>>>>>>>>>        String  sVoid
9370>>>>>>>>>        Integer iResult
9370>>>>>>>>>        
9370>>>>>>>>>        Integer iOption
9370>>>>>>>>>        
9370>>>>>>>>>        // iOption
9370>>>>>>>>>        // 0 = RedirectConnection
9370>>>>>>>>>        // 1 = RedirectIdConnectString
9370>>>>>>>>>        // 2 = RedirectIdConnectStringKeepLoggedIn
9370>>>>>>>>>        If (bKeepLoggedIn) Begin
9372>>>>>>>>>            Move 2 to iOption
9373>>>>>>>>>        End
9373>>>>>>>>>>
9373>>>>>>>>>        Else Begin
9374>>>>>>>>>            Move 1 to iOption
9375>>>>>>>>>        End
9375>>>>>>>>>>
9375>>>>>>>>>        
9375>>>>>>>>>        Get psDriverID to sDriver
9376>>>>>>>>>        If (sDriver <> "") Begin
9378>>>>>>>>>            Call_Driver 0 sDriver Function CLI_REDIRECTCONNECTION Callback 0 Passing sConnectionId sConnectString iOption Result iResult
9383>>>>>>>>>        End
9383>>>>>>>>>>
9383>>>>>>>>>        Function_Return iResult
9384>>>>>>>>>    End_Function
9385>>>>>>>>>    
9385>>>>>>>>>    

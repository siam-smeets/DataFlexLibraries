31914>>>>>>>        // message will get the design-time psValue, at all other times it will WebGet the client's
31914>>>>>>>        // synchronized psValue.
31914>>>>>>>        String sChecked sValue
31914>>>>>>>        Boolean bInitWebApp
31914>>>>>>>        
31914>>>>>>>        Get Initializing of (Host(Self)) to bInitWebApp
31915>>>>>>>        If (bInitWebApp) Begin
31917>>>>>>>            Get psChecked to sChecked 
31918>>>>>>>            Get psValue to sValue
31919>>>>>>>        End
31919>>>>>>>>
31919>>>>>>>        Else Begin
31920>>>>>>>            WebGet psChecked to sChecked 
31921>>>>>>>            WebGet psValue to sValue

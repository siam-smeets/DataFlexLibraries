22077>>>>>>>>>>>>>    // Concatenates the different parts of a view state hash into a single string. Some characters 
22077>>>>>>>>>>>>>    // will be escaped.
22077>>>>>>>>>>>>>    //
22077>>>>>>>>>>>>>    // Params:
22077>>>>>>>>>>>>>    //      sView       The view name.
22077>>>>>>>>>>>>>    //      sRecordId   The record id.
22077>>>>>>>>>>>>>    //      sCustomHash Custom hash part.
22077>>>>>>>>>>>>>    Function ConcatViewStateHash String sView String sRecordId String sCustomHash Returns String
22079>>>>>>>>>>>>>        String sResult
22079>>>>>>>>>>>>>        
22079>>>>>>>>>>>>>        Get EscapeViewStatePartial sView to sView
22080>>>>>>>>>>>>>        Move sView to sResult
22081>>>>>>>>>>>>>        
22081>>>>>>>>>>>>>        If (sRecordId <> "" or sCustomHash <> "") Begin
22083>>>>>>>>>>>>>            Get EscapeViewStatePartial sRecordId to sRecordId
22084>>>>>>>>>>>>>            Move (sResult + "-" + sRecordId) to sResult
22085>>>>>>>>>>>>>            
22085>>>>>>>>>>>>>            If (sCustomHash <> "") Begin
22087>>>>>>>>>>>>>                Get EscapeViewStatePartial sCustomHash to sCustomHash
22088>>>>>>>>>>>>>                Move (sResult + "-" + sCustomHash) to sResult
22089>>>>>>>>>>>>>            End
22089>>>>>>>>>>>>>>
22089>>>>>>>>>>>>>        End
22089>>>>>>>>>>>>>>
22089>>>>>>>>>>>>>        
22089>>>>>>>>>>>>>        Function_Return sResult
22090>>>>>>>>>>>>>    End_Function
22091>>>>>>>>>>>>>    
22091>>>>>>>>>>>>>    // Splits a drill-down style state hash into an array of separate view state hashes.
22091>>>>>>>>>>>>>    //
22091>>>>>>>>>>>>>    // Params:
22091>>>>>>>>>>>>>    //      sStateHash  Full state hash.
22091>>>>>>>>>>>>>    // Returns:
22091>>>>>>>>>>>>>    //      Array of view state hashes.
22091>>>>>>>>>>>>>    Function ParseStateHash String sStateHash Returns String[]
22093>>>>>>>>>>>>>        String[] aViewStateHashes
22094>>>>>>>>>>>>>        Integer i
22094>>>>>>>>>>>>>        
22094>>>>>>>>>>>>>        Move (StrSplitToArray(sStateHash, "/")) to aViewStateHashes
22095>>>>>>>>>>>>>        
22095>>>>>>>>>>>>>        //  Remove empty parts
22095>>>>>>>>>>>>>        For i from 0 to (SizeOfArray(aViewStateHashes) - 1)
22101>>>>>>>>>>>>>>
22101>>>>>>>>>>>>>            If (Trim(aViewStateHashes[i]) = "") Begin
22103>>>>>>>>>>>>>                Move (RemoveFromArray(aViewStateHashes, i)) to aViewStateHashes
22104>>>>>>>>>>>>>            End
22104>>>>>>>>>>>>>>
22104>>>>>>>>>>>>>        Loop
22105>>>>>>>>>>>>>>
22105>>>>>>>>>>>>>        
22105>>>>>>>>>>>>>        Function_Return aViewStateHashes
22106>>>>>>>>>>>>>    End_Function
22107>>>>>>>>>>>>>    
22107>>>>>>>>>>>>>    // Appends a view state hash to a drill-down style state hash.
22107>>>>>>>>>>>>>    //
22107>>>>>>>>>>>>>    // Params:
22107>>>>>>>>>>>>>    //      sStateHash      Existing state hash.
22107>>>>>>>>>>>>>    //      sViewStateHash  View state hash to append.
22107>>>>>>>>>>>>>    // Returns:
22107>>>>>>>>>>>>>    //      The extended state has string.
22107>>>>>>>>>>>>>    Function AppendStateHash String sStateHash String sViewStateHash Returns String
22109>>>>>>>>>>>>>        If (sStateHash <> "") Begin
22111>>>>>>>>>>>>>            Move (sStateHash + "/" + sViewStateHash) to sStateHash
22112>>>>>>>>>>>>>        End
22112>>>>>>>>>>>>>>
22112>>>>>>>>>>>>>        Else Begin
22113>>>>>>>>>>>>>            Move sViewStateHash to sStateHash
22114>>>>>>>>>>>>>        End
22114>>>>>>>>>>>>>>
22114>>>>>>>>>>>>>        
22114>>>>>>>>>>>>>        Function_Return sStateHash
22115>>>>>>>>>>>>>    End_Function
22116>>>>>>>>>>>>>    
22116>>>>>>>>>>>>>    //  Escapes disallowed characters in a view state partial with their hexadecimal values between
22116>>>>>>>>>>>>>    //  ~ characters. The / and - are escaped because they are used to concatenate the different 
22116>>>>>>>>>>>>>    // pieces.
22116>>>>>>>>>>>>>    //
22116>>>>>>>>>>>>>    // Params:
22116>>>>>>>>>>>>>    //      sHash   The partial hash to escape.
22116>>>>>>>>>>>>>    // Returns:
22116>>>>>>>>>>>>>    //      The escaped partial view state hash.
22116>>>>>>>>>>>>>    Function EscapeViewStatePartial String sHash Returns String
22118>>>>>>>>>>>>>        //  Encode characters used elsewhere in URLs
22118>>>>>>>>>>>>>        Move (Replaces("-", Replaces("/", sHash, "~2f~"), "~5f~")) to sHash
22119>>>>>>>>>>>>>        
22119>>>>>>>>>>>>>        Move (UrlEncode(sHash, True)) to sHash
22120>>>>>>>>>>>>>        
22120>>>>>>>>>>>>>        Function_Return sHash
22121>>>>>>>>>>>>>    End_Function    
22122>>>>>>>>>>>>>    
22122>>>>>>>>>>>>>    // Unescapes a view state partial that has been escaped by EscapeViewStatePartial.
22122>>>>>>>>>>>>>    //
22122>>>>>>>>>>>>>    // Params:
22122>>>>>>>>>>>>>    //      sHash   The partial hash to unescape.
22122>>>>>>>>>>>>>    // Returns:
22122>>>>>>>>>>>>>    //      The unescaped partial view state hash.
22122>>>>>>>>>>>>>    Function UnescapeViewStatePartial String sHash Returns String
22124>>>>>>>>>>>>>        Move (UrlDecode(sHash)) to sHash
22125>>>>>>>>>>>>>        
22125>>>>>>>>>>>>>        //  Decode characters used elsehwere in urls
22125>>>>>>>>>>>>>        Move (Replaces("~5f~", Replaces("~2f~", sHash, "/"), "-")) to sHash
22126>>>>>>>>>>>>>        
22126>>>>>>>>>>>>>        Function_Return sHash
22127>>>>>>>>>>>>>    End_Function 

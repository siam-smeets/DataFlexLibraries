31809>>>>>    //
31809>>>>>    // Initializes the property store for the server side web properties.
31809>>>>>    //
31809>>>>>    Procedure InitPropStores
31811>>>>>        String sRoot
31811>>>>>        Handle hoServerPropStore
31811>>>>>        
31811>>>>>        //  If the server prop store has not been created manually
31811>>>>>        If (ServerPropStore(Self) = C_WebUnresolvedObject) Begin
31813>>>>>            //  Check if WebAppServerProps exists
31813>>>>>            Declare_Datafile WebAppServerProps
31813>>>>>            Get_Attribute DF_FILE_ROOT_NAME of (RefTable(WebAppServerProps)) to sRoot
31816>>>>>            If (Trim(sRoot) <> "") Begin
31818>>>>>                Get Create (RefClass(cWebServerPropStore)) to hoServerPropStore
31819>>>>>                Set phoServerPropStore to hoServerPropStore
31820>>>>>            End
31820>>>>>>
31820>>>>>        End
31820>>>>>>
31820>>>>>    End_Procedure

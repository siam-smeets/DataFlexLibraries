1035>>>>>>>>>        If (i > 0) Begin
1037>>>>>>>>>            Move aStr[i] to sValue  //  Move to string value first to enforce proper conversion might someone pass a different type of array
1038>>>>>>>>>            Move (sResult + sDel + sValue) to sResult
1039>>>>>>>>>        End
1039>>>>>>>>>>
1039>>>>>>>>>        Else Begin
1040>>>>>>>>>            Move aStr[i] to sResult
1041>>>>>>>>>        End
1041>>>>>>>>>>
1041>>>>>>>>>    Loop

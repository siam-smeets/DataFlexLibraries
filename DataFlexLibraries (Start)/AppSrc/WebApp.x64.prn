20145>>>>>>>>>>>>>>>    
20145>>>>>>>>>>>>>>>    //  Override the ShowControlError function called by the error system to show control errors. 
20145>>>>>>>>>>>>>>>    //  Returns true to let the error system know that this control can show errors.
20145>>>>>>>>>>>>>>>    Function ShowControlError Integer iErrNum String sErrText Returns Boolean
20147>>>>>>>>>>>>>>>        Boolean bInSync bRender
20147>>>>>>>>>>>>>>>        
20147>>>>>>>>>>>>>>>        Get IsInCallActionScope to bInSync
20148>>>>>>>>>>>>>>>        If (bInSync) Begin
20150>>>>>>>>>>>>>>>            Get IsControlRendered to bRender
20151>>>>>>>>>>>>>>>            If (bRender) Begin
20153>>>>>>>>>>>>>>>                Send ShowControlError iErrNum sErrText
20154>>>>>>>>>>>>>>>                Function_Return True        
20155>>>>>>>>>>>>>>>            End
20155>>>>>>>>>>>>>>>>
20155>>>>>>>>>>>>>>>        End
20155>>>>>>>>>>>>>>>>
20155>>>>>>>>>>>>>>>        
20155>>>>>>>>>>>>>>>        Function_Return False
20156>>>>>>>>>>>>>>>    End_Function
20157>>>>>>>>>>>>>>>    
20157>>>>>>>>>>>>>>>    
20157>>>>>>>>>>>>>>>    //  Displays a control error in an error balloon around the control. The error number is used 
20157>>>>>>>>>>>>>>>    //  as identifier to hide the error. The error will be cleared by a WebSet of psValue and the 
20157>>>>>>>>>>>>>>>    //  HideControlError / HideAllControlErrors procedures and by a succesfull server-side 
20157>>>>>>>>>>>>>>>    //  validation.
20157>>>>>>>>>>>>>>>    // 
20157>>>>>>>>>>>>>>>    //  Params:
20157>>>>>>>>>>>>>>>    //      iErrNum     Error number used as identifier.
20157>>>>>>>>>>>>>>>    //      sErrText    Error description.
20157>>>>>>>>>>>>>>>    Procedure ShowControlError Integer iErrNum String sErrText
20159>>>>>>>>>>>>>>>        String[] aParams
20160>>>>>>>>>>>>>>>        
20160>>>>>>>>>>>>>>>        Move iErrNum    to aParams[0]
20161>>>>>>>>>>>>>>>        Move sErrText   to aParams[1]
20162>>>>>>>>>>>>>>>        
20162>>>>>>>>>>>>>>>        WebSet pbHasControlError to True
20163>>>>>>>>>>>>>>>        Send ClientAction "showControlError" aParams
20164>>>>>>>>>>>>>>>    End_Procedure
20165>>>>>>>>>>>>>>>        
20165>>>>>>>>>>>>>>>    
20165>>>>>>>>>>>>>>>    //  Hides an error shown using ShowControlError based on its error number.
20165>>>>>>>>>>>>>>>    // 
20165>>>>>>>>>>>>>>>    //  Params:
20165>>>>>>>>>>>>>>>    //      iErrNum     Error number used as identifier.
20165>>>>>>>>>>>>>>>    Procedure HideControlError Integer iErrNum
20167>>>>>>>>>>>>>>>        String[] aParams
20168>>>>>>>>>>>>>>>        
20168>>>>>>>>>>>>>>>        Move iErrNum    to aParams[0]
20169>>>>>>>>>>>>>>>        
20169>>>>>>>>>>>>>>>        Send ClientAction "hideControlError" aParams
20170>>>>>>>>>>>>>>>    End_Procedure
20171>>>>>>>>>>>>>>>    
20171>>>>>>>>>>>>>>>    //  Hides all active control errors on this control.
20171>>>>>>>>>>>>>>>    Procedure HideAllControlErrors
20173>>>>>>>>>>>>>>>        Boolean bHas
20173>>>>>>>>>>>>>>>        
20173>>>>>>>>>>>>>>>        WebGet pbHasControlError to bHas
20174>>>>>>>>>>>>>>>        
20174>>>>>>>>>>>>>>>        If (bHas) Begin
20176>>>>>>>>>>>>>>>            Send ClientAction "hideAllControlErrors"
20177>>>>>>>>>>>>>>>            WebSet pbHasControlError to False
20178>>>>>>>>>>>>>>>        End
20178>>>>>>>>>>>>>>>>
20178>>>>>>>>>>>>>>>    End_Procedure
20179>>>>>>>>>>>>>>>    
20179>>>>>>>>>>>>>>>    
20179>>>>>>>>>>>>>>>    //  Called to determine if filling the DEO with data is allowed.
20179>>>>>>>>>>>>>>>    //
20179>>>>>>>>>>>>>>>    //  Params:
20179>>>>>>>>>>>>>>>    //      bAllow      ByRef boolean set to false if not allowed.
20179>>>>>>>>>>>>>>>    Procedure AllowFillDEO Boolean ByRef bAllow
20181>>>>>>>>>>>>>>>        If (bAllow) Begin
20183>>>>>>>>>>>>>>>            Get IsControlAccessible False (pbNoFillIfHidden(Self)) to bAllow
20184>>>>>>>>>>>>>>>        End
20184>>>>>>>>>>>>>>>>
20184>>>>>>>>>>>>>>>    End_Procedure
20185>>>>>>>>>>>>>>>    
20185>>>>>>>>>>>>>>>    //  Called to determine if the DEO has permission to update the Data Dictionary with new value(s).
20185>>>>>>>>>>>>>>>    //
20185>>>>>>>>>>>>>>>    //  Params:
20185>>>>>>>>>>>>>>>    //      bAllow      ByRef boolean set to false if not allowed.
20185>>>>>>>>>>>>>>>    Procedure AllowUpdateDD Boolean ByRef bAllow
20187>>>>>>>>>>>>>>>        If (bAllow) Begin
20189>>>>>>>>>>>>>>>            Get IsControlAccessible True (pbNoUpdateIfHidden(Self)) to bAllow
20190>>>>>>>>>>>>>>>        End
20190>>>>>>>>>>>>>>>>
20190>>>>>>>>>>>>>>>    End_Procedure
20191>>>>>>>>>>>>>>>    
20191>>>>>>>>>>>>>>>    Procedure End_Construct_Object
20193>>>>>>>>>>>>>>>        Forward Send End_Construct_Object
20195>>>>>>>>>>>>>>>        
20195>>>>>>>>>>>>>>>        WebPublishFunction OnValidate

38341>>>>>>>    
38341>>>>>>>    //
38341>>>>>>>    //  Converts the given time to an string that can be saved in the database.
38341>>>>>>>    //
38341>>>>>>>    //  Params:
38341>>>>>>>    //      dtTime  Time to convert
38341>>>>>>>    //  Returns:
38341>>>>>>>    //      String with "HH:MM:SS" format
38341>>>>>>>    //
38341>>>>>>>    Function TimeToString DateTime dtTime Returns String
38343>>>>>>>        String sHours sMinutes sSeconds
38343>>>>>>>        
38343>>>>>>>        //  Extract parts
38343>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
38344>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
38345>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
38346>>>>>>>        
38346>>>>>>>        //  Fill out with 0
38346>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
38349>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
38352>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
38355>>>>>>>        
38355>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
38356>>>>>>>    End_Function
38357>>>>>>>    
38357>>>>>>>    //
38357>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
38357>>>>>>>    //
38357>>>>>>>    //  Params:
38357>>>>>>>    //      dtTime  Datetime variable to add time to
38357>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
38357>>>>>>>    //  Returns:
38357>>>>>>>    //      dtDateTime with the loaded time
38357>>>>>>>    //
38357>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
38359>>>>>>>        String sHours sMinutes sSeconds
38359>>>>>>>        
38359>>>>>>>        //  Extract parts
38359>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
38360>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
38361>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
38362>>>>>>>        
38362>>>>>>>        //  Set to DateTime
38362>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
38363>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
38364>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
38365>>>>>>>        
38365>>>>>>>        Function_Return dtTime
38366>>>>>>>    End_Function
38367>>>>>>>End_Class

12877>>>>>>>    // return the interface NodeValue without having to create a
12877>>>>>>>    // new object. This also disposes the hInfc interface
12877>>>>>>>    Function InfcNodeValue Handle hInfc Returns String
12879>>>>>>>        Handle hoDocument hoTempNode
12879>>>>>>>        String sValue
12879>>>>>>>        If (hinfc) Begin
12881>>>>>>>            Get DocumentObject to hoDocument
12882>>>>>>>            Get phoTempDomNode of hoDocument to hoTempNode
12883>>>>>>>            Set XMLInterface of hoTempNode to hInfc
12884>>>>>>>            Get psNodeValue of hoTempNode to sValue
12885>>>>>>>            // This disposes of hInfc which was passed in. After
12885>>>>>>>            // calling this you can no longer use it (which is good).
12885>>>>>>>            Set XMLInterface of hoTempNode to 0
12886>>>>>>>        End
12886>>>>>>>>
12886>>>>>>>        Function_Return sValue
12887>>>>>>>    End_Function
12888>>>>>>>    
12888>>>>>>>    // ChildNodeValue is used to get the "value" of an element. This is useful when the element
12888>>>>>>>    // only has a single value (similar to an attribute).
12888>>>>>>>    
12888>>>>>>>    Function ChildNodeValue String sTagName Returns String
12890>>>>>>>        Handle hoTempNode hoDocument
12890>>>>>>>        Handle hinfcTempNode
12890>>>>>>>        String sRetVal
12890>>>>>>>        Get SelectSingleNode sTagName to hinfcTempNode
12891>>>>>>>        If (hinfcTempNode <> 0) Begin
12893>>>>>>>            Get DocumentObject to hoDocument
12894>>>>>>>            Get phoTempDomNode of hoDocument to hoTempNode
12895>>>>>>>            Set XMLInterface of hoTempNode to hinfcTempNode
12896>>>>>>>            Get phFirstChild of hoTempNode to hinfcTempNode
12897>>>>>>>            Set XMLInterface of hoTempNode to 0
12898>>>>>>>            If hinfcTempNode Begin
12900>>>>>>>                Get InfcNodeValue hinfcTempNode to sRetVal
12901>>>>>>>            End
12901>>>>>>>>
12901>>>>>>>        End
12901>>>>>>>>
12901>>>>>>>        Function_Return sRetVal
12902>>>>>>>    End_Function
12903>>>>>>>    
12903>>>>>>>    // This simple function allows a parent to change the text of one of its elements.
12903>>>>>>>    // This actually occurs quite a bit, because (as stated above) lowest level
12903>>>>>>>    // elements are frequently used as properties.
12903>>>>>>>    //
12903>>>>>>>    Procedure SetChildNodeValue String sTagName String sValue
12905>>>>>>>        Handle hoTempNode
12905>>>>>>>        Handle hinfcTempNode
12905>>>>>>>        // Search for the node that matches.
12905>>>>>>>        Get SelectSingleNode sTagName to hinfcTempNode
12906>>>>>>>        // If no match is found, add a new element with the tag.
12906>>>>>>>        If (hinfcTempNode = 0) ;            Send AddElement sTagName sValue
12909>>>>>>>        Else Begin
12910>>>>>>>            Get CreateXMLObject U_BaseXMLDOMNode hinfcTempNode to hoTempNode
12911>>>>>>>            If hoTempNode Begin
12913>>>>>>>                // Set the text of the element.
12913>>>>>>>                Set psText of hoTempNode to sValue
12914>>>>>>>                Send Destroy to hoTempNode
12915>>>>>>>            End
12915>>>>>>>>
12915>>>>>>>            Else ;                Error DFERR_XML_INTERNAL_ERROR (SFormat(C_$XmlMethodFailure, "msg_SetChildNodeValue"))
12917>>>>>>>        End
12917>>>>>>>>
12917>>>>>>>    End_Procedure

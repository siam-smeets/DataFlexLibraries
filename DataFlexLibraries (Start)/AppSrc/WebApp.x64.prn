22460>>>>>>>>>>>>>>>        Move (SizeOfArray(gaAdvSyncProps[iStoreIndex]) - 1) to iTo
22461>>>>>>>>>>>>>>>        For iCur from 0 to iTo
22467>>>>>>>>>>>>>>>>
22467>>>>>>>>>>>>>>>            If (gaAdvSyncProps[iStoreIndex][iCur].hoObj = hoObj and Uppercase(gaAdvSyncProps[iStoreIndex][iCur].tSvrProp.sP) = sPropName) Begin
22469>>>>>>>>>>>>>>>                Function_Return iCur
22470>>>>>>>>>>>>>>>            End
22470>>>>>>>>>>>>>>>>
22470>>>>>>>>>>>>>>>        Loop
22471>>>>>>>>>>>>>>>>
22471>>>>>>>>>>>>>>>        

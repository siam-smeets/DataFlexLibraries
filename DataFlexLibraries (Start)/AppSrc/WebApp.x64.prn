5464>>>>>>>
5464>>>>>>>    // The Set Field_Auto_Increment method replaces the need to use the Define_Auto_Incrmement
5464>>>>>>>    // command. This models more easily and it supports multiple auto-increment fields
5464>>>>>>>    Procedure Set Field_Auto_Increment Integer iField Integer iSysFile Integer iSysField
5466>>>>>>>        Integer[] AutoIncFields
5467>>>>>>>        tDDFileField[] SysFileFields
5467>>>>>>>        tDDFileField[] SysFileFields
5468>>>>>>>        Integer iIndex
5468>>>>>>>
5468>>>>>>>        If (iField=0 or (iSysFile<>0 and iSysField=0)) Begin
5470>>>>>>>            Error DFERR_PROGRAM "Auto-increment source or destination field is 0"
5471>>>>>>>>
5471>>>>>>>            Procedure_Return
5472>>>>>>>        End
5472>>>>>>>>
5472>>>>>>>        // setting the sysfile to 0 is valid. It can be used to clear an existing sysfile
5472>>>>>>>        If (iSysFile=0) Begin
5474>>>>>>>            Move 0 to iSysField
5475>>>>>>>        End
5475>>>>>>>>
5475>>>>>>>        Get pAutoIncrementFields to AutoIncFields
5476>>>>>>>        Get pAutoIncrementSysFileFields to SysFileFields
5477>>>>>>>        // the destination field array is a list of fields that have auto-incr info. There
5477>>>>>>>        // can only be zero or one entry per field arranged in no defined order.
5477>>>>>>>        // see if field is already defined. If not add this to the end.
5477>>>>>>>        Move (SearchArray(iField,AutoIncFields)) to iIndex
5478>>>>>>>        If (iIndex=-1) Begin
5480>>>>>>>            Move (SizeOfArray(SysFileFields)) to iIndex
5481>>>>>>>        End
5481>>>>>>>>
5481>>>>>>>        Move iField    to AutoIncFields[iIndex]
5482>>>>>>>        Move iSysFile  to SysFileFields[iIndex].iFile
5483>>>>>>>        Move iSysField to SysFileFields[iIndex].iField
5484>>>>>>>        Set pAutoIncrementFields to AutoIncFields
5485>>>>>>>        Set pAutoIncrementSysFileFields to SysFileFields
5486>>>>>>>    End_Procedure
5487>>>>>>>
5487>>>>>>>    // Get auto-increment system file/field value for a field. There really should be no
5487>>>>>>>    // reason to ever need this. Field is returned byref
5487>>>>>>>    Function Field_Auto_Increment Integer iField Integer ByRef iSysField Returns Integer
5489>>>>>>>        Integer iSysFile
5489>>>>>>>        Integer[] AutoIncFields
5490>>>>>>>        tDDFileField[] SysFileFields
5490>>>>>>>        tDDFileField[] SysFileFields
5491>>>>>>>        Integer iIndex
5491>>>>>>>
5491>>>>>>>        Get pAutoIncrementFields to AutoIncFields
5492>>>>>>>        Move (SearchArray(iField,AutoIncFields)) to iIndex
5493>>>>>>>        If (iIndex>-1) Begin
5495>>>>>>>            Get pAutoIncrementSysFileFields to SysFileFields
5496>>>>>>>            Move SysFileFields[iIndex].iFile to iSysFile
5497>>>>>>>            Move SysFileFields[iIndex].iField to iSysField
5498>>>>>>>        End
5498>>>>>>>>
5498>>>>>>>        Else Begin
5499>>>>>>>            Move 0 to iSysFile
5500>>>>>>>            Move 0 to iSysField
5501>>>>>>>        End
5501>>>>>>>>
5501>>>>>>>        Function_Return iSysFile
5502>>>>>>>    End_Function
5503>>>>>>>
5503>>>>>>>
5503>>>>>>>    // Augmented to set any system files defined via the Add_System_file
5503>>>>>>>    // message. This allows us to hide this procedure for the vast majority
5503>>>>>>>    // of cases.
5503>>>>>>>    Procedure Reset_Filemodes_For_Lock
5505>>>>>>>        Boolean bNewRec
5505>>>>>>>        Integer  iItmCnt iCnt iMode iFile
5505>>>>>>>        Integer iMain iMaster iOpts
5505>>>>>>>        Handle hoDD
5505>>>>>>>
5505>>>>>>>        Forward Send Reset_Filemodes_for_lock
5507>>>>>>>
5507>>>>>>>        Get System_File_Count to iItmCnt
5508>>>>>>>        If iItmCnt Begin
5510>>>>>>>            Move (not(HasRecord(Self))) to bNewRec
5511>>>>>>>            Decrement iItmCnt
5512>>>>>>>            For iCnt from 0 to iItmCnt
5518>>>>>>>>
5518>>>>>>>                Get System_File_Number         iCnt to iFile
5519>>>>>>>                Get System_File_Lock_Mode iCnt to iMode
5520>>>>>>>                If ( (iMode=DD_Lock_on_All) or ;                    (Operation_Mode=MODE_DELETING and (iMode iand DD_Lock_on_Delete) ) or ;                    (Operation_Mode=MODE_SAVING and ( (iMode iand DD_Lock_on_Save) or ;                    ( (iMode iand DD_Lock_on_New_Save) and bNewRec) ) ) ) Begin
5522>>>>>>>                    Set_Attribute DF_FILE_MODE of iFile to DF_FILEMODE_DEFAULT
5525>>>>>>>                End
5525>>>>>>>>
5525>>>>>>>            Loop
5526>>>>>>>>
5526>>>>>>>        End
5526>>>>>>>>
5526>>>>>>>
5526>>>>>>>        // augment to support DD magnaged alias tables.
5526>>>>>>>        // If an alias, set the alias to the proper alias no locks only if
5526>>>>>>>        // the master file is actually part of this DDO structure. This allows you
5526>>>>>>>        // to use alias files without the master being present (or even open). This will work without needing
5526>>>>>>>        // to set the Master|Alias DF_FILE_ALIAS attributes. If the file is master and part of the DDO structure
5526>>>>>>>        // it will already have its No_locks attribute cleared. If not part of the DD, its not needed.
5526>>>>>>>        //
5526>>>>>>>        Get MasterForAlias to iMaster
5527>>>>>>>        If iMaster Begin
5529>>>>>>>            Get Main_File to iMain
5530>>>>>>>            Get Data_Set iMaster to hoDD // is the master in the DD structure
5531>>>>>>>            If hoDD Begin
5533>>>>>>>                Get_Attribute DF_FILE_MODE of iMain to iOpts
5536>>>>>>>                Set_Attribute DF_FILE_MODE of iMain to (iOpts ior DF_FILEMODE_NO_LOCKS)
5539>>>>>>>                // note this will be reset to what it was when the transaction ends
5539>>>>>>>            End
5539>>>>>>>>
5539>>>>>>>        End
5539>>>>>>>>
5539>>>>>>>
5539>>>>>>>    End_Procedure
5540>>>>>>>
5540>>>>>>>    // Augmented to handle auto-increment fields if defined. The value from
5540>>>>>>>    // the auto-incre sys file is incremented, saved and moved to the new
5540>>>>>>>    // record. As of 17.0 this is no longer in Creating, which is called after
5540>>>>>>>    // AutoIncrement.
5540>>>>>>>    Procedure AutoIncrement
5542>>>>>>>        Integer iSrcFile iSrcField i iAutoFields
5542>>>>>>>        Integer iDestFile iDestField
5542>>>>>>>        Number nNum
5542>>>>>>>        Integer[] AutoIncFields
5543>>>>>>>        tDDFileField[] AutoIncSysFileFields
5543>>>>>>>        tDDFileField[] AutoIncSysFileFields
5544>>>>>>>        Handle hoOwner
5544>>>>>>>
5544>>>>>>>        Forward Send AutoIncrement
5546>>>>>>>
5546>>>>>>>        // this supports the older Define_Auto_Increment logic. Only one is supported
5546>>>>>>>        // this is exists for backwards compatibility
5546>>>>>>>        Get Auto_Increment_Source_File to iSrcFile
5547>>>>>>>        If iSrcFile Begin // do we have auto increment?
5549>>>>>>>            Get Auto_Increment_Source_Field  to iSrcField
5550>>>>>>>            Get Auto_Increment_Dest_Field    to iDestField
5551>>>>>>>            If (iSrcField and iDestField) Begin  // just in case of error
5553>>>>>>>                Get Main_file to iDestFile
5554>>>>>>>                Get_Field_Value iSrcFile iSrcField to nNum
5557>>>>>>>                Move (nNum+1) to nNum
5558>>>>>>>                Set_Field_Value iSrcFile  iSrcField  to nNum
5561>>>>>>>                Set_Field_Value iDestFile iDestField to nNum
5564>>>>>>>                // if the file's DD is a parent file in the structure, this will get saved as part of normal operations
5564>>>>>>>                // if the DD is not a parent file, it is a sysfile and we must save it
5564>>>>>>>                Get Which_Data_Set iSrcFile to hoOwner
5565>>>>>>>                If not hoOwner Begin
5567>>>>>>>                    SaveRecord iSrcFile
5568>>>>>>>                End
5568>>>>>>>>
5568>>>>>>>            End
5568>>>>>>>>
5568>>>>>>>        End
5568>>>>>>>>
5568>>>>>>>        // this supports the newer set syntax which support multiple fields. It is expected that you will
5568>>>>>>>        // use one syntax of the other, not both. If you use the old syntax, you cannot use the new one
5568>>>>>>>        Else Begin
5569>>>>>>>            Get pAutoIncrementFields to AutoIncFields
5570>>>>>>>            Move (SizeOfArray(AutoIncFields)) to iAutoFields
5571>>>>>>>            If (iAutoFields>0) Begin
5573>>>>>>>                Get pAutoIncrementSysFileFields to AutoIncSysFileFields
5574>>>>>>>                Get Main_file to iDestFile
5575>>>>>>>                For i from 0 to (iAutoFields-1)
5581>>>>>>>>
5581>>>>>>>                    // it is legal to set the sysfile to 0, this means it has been cleared and is not used
5581>>>>>>>                    If (AutoIncSysFileFields[i].iFile>0) Begin
5583>>>>>>>                        // we assume both the fields are valid and that they've already been tested when added
5583>>>>>>>                        Get_Field_Value AutoIncSysFileFields[i].iFile AutoIncSysFileFields[i].iField to nNum
5586>>>>>>>                        Move (nNum+1) to nNum
5587>>>>>>>                        Set_Field_Value AutoIncSysFileFields[i].iFile AutoIncSysFileFields[i].iField to nNum
5590>>>>>>>                        Set_Field_Value iDestFile AutoIncFields[i] to nNum
5593>>>>>>>                        // if the file's DD is a parent file in the structure, this will get saved as part of normal operations
5593>>>>>>>                        // if the DD is not a parent file, it is a sysfile and we must save it
5593>>>>>>>                        Get Which_Data_Set AutoIncSysFileFields[i].iFile to hoOwner
5594>>>>>>>                        If not hoOwner Begin
5596>>>>>>>                            SaveRecord AutoIncSysFileFields[i].iFile
5597>>>>>>>                        End
5597>>>>>>>>
5597>>>>>>>                    End
5597>>>>>>>>
5597>>>>>>>                Loop
5598>>>>>>>>
5598>>>>>>>            End
5598>>>>>>>>
5598>>>>>>>        End
5598>>>>>>>>
5598>>>>>>>
5598>>>>>>>    End_Procedure
5599>>>>>>>
5599>>>>>>>    // Augmented to fix a bug in the data-set C code. When a record is saved
5599>>>>>>>    // as part of a delete operation OnNewCurrentRecord is not called. It
5599>>>>>>>    // should be. We will do this in flex code for now.
5599>>>>>>>    Procedure Save_Main_File
5601>>>>>>>        RowID riRec
5601>>>>>>>        Integer iRec iMain
5601>>>>>>>        Boolean bRecnumTable bChanged
5601>>>>>>>
5601>>>>>>>        Get Main_File to iMain
5602>>>>>>>        Get_Attribute DF_FILE_CHANGED of iMain to bChanged
5605>>>>>>>        If bChanged Begin
5607>>>>>>>            Send OnSaveRecord // OnSaveRecord sent if there is something to save
5608>>>>>>>        End
5608>>>>>>>>
5608>>>>>>>
5608>>>>>>>        Forward Send Save_Main_File
5610>>>>>>>
5610>>>>>>>        If (Operation_Mode = MODE_DELETING) Begin  // during a delete the crnt
5612>>>>>>>            Get CurrentRowId to riRec             // rec of parents do not change
5613>>>>>>>            Send OnNewCurrentRecord riRec riRec  // so old and new are the same.
5614>>>>>>>            // for backwards compatibility reasons, we also send new_current_record if appropriate
5614>>>>>>>            Get_Attribute DF_FILE_RECNUM_TABLE of iMain to bRecnumTable
5617>>>>>>>            If (bRecnumTable) Begin
5619>>>>>>>                Get_Field_Value iMain 0 to iRec
5622>>>>>>>                Send New_Current_Record iRec iRec
5623>>>>>>>            End
5623>>>>>>>>
5623>>>>>>>        End
5623>>>>>>>>
5623>>>>>>>    End_Procedure
5624>>>>>>>
5624>>>>>>>    // Augmented to not clear if a system-file. The auto-latching of views
5624>>>>>>>    // may cause a sys file DD to get cleared. This corrects this. This really
5624>>>>>>>    // belongs in Data_set (C) but we will not risk this for now.
5624>>>>>>>    Procedure Clear_Main_File
5626>>>>>>>        Integer iFile iIsSys
5626>>>>>>>        Get Main_File to iFile
5627>>>>>>>        If iFile Begin
5629>>>>>>>            Get_Attribute DF_FILE_IS_SYSTEM_FILE of iFile to iIsSys
5632>>>>>>>            If iIsSys ;                Procedure_Return
5635>>>>>>>        End
5635>>>>>>>>
5635>>>>>>>        Forward Send Clear_main_file
5637>>>>>>>    End_Procedure
5638>>>>>>>
5638>>>>>>>    // Executes a request_find on the mainfile. This is easier that having to
5638>>>>>>>    // pass file number all the time. Useful for batch operations.
5638>>>>>>>    // If Index is 0, use find_by_recnum (it handles a recnum of 0 better)
5638>>>>>>>    Procedure Find Integer iMode Integer iIndex
5640>>>>>>>        Integer iFile
5640>>>>>>>        Integer iRec
5640>>>>>>>        Get Main_file to iFile
5641>>>>>>>        If (iIndex<>0 or iMode<>EQ) ;            Send request_find iMode iFile iIndex
5644>>>>>>>        Else Begin
5645>>>>>>>            // this would never happen with row ID
5645>>>>>>>            Get_Field_Value iFile 0 to iRec // get recnum value
5648>>>>>>>            Send find_by_recnum iFile iRec
5649>>>>>>>        End
5649>>>>>>>>
5649>>>>>>>    End_Procedure
5650>>>>>>>
5650>>>>>>>    // So many people make the mistake of using requeset_clear and request_
5650>>>>>>>    // clear_all that will support these are alteratives to clear and
5650>>>>>>>    // clear_all. The preferred messages remain Clear and Clear_all.
5650>>>>>>>    // This would not work if you nested DEOs within DSOs (no-one does).
5650>>>>>>>    Procedure Request_Clear
5652>>>>>>>        Send Clear
5653>>>>>>>    End_Procedure
5654>>>>>>>
5654>>>>>>>    Procedure Request_Clear_All
5656>>>>>>>        Send Clear_All
5657>>>>>>>    End_Procedure
5658>>>>>>>
5658>>>>>>>    // we want changed_state to always go through the
5658>>>>>>>    // Record_buffer object. From there it is sent to
5658>>>>>>>    // here. So if state or RB does not match we must
5658>>>>>>>    // send to the RB object...it will delegate to here
5658>>>>>>>
5658>>>>>>>    Procedure Set Changed_State Integer bState
5660>>>>>>>        Integer hRB
5660>>>>>>>        Move (record_buffer(Self)) to hRB
5661>>>>>>>        If (hRB and changed_state(hRB)<>bState) ;            Set changed_state of hRB to bState
5664>>>>>>>        Else ;            Forward Set changed_state to bState
5667>>>>>>>    End_Procedure
5668>>>>>>>
5668>>>>>>>    // this lets us use the new attach logic
5668>>>>>>>
5668>>>>>>>    // This is a smarter attach than the normal attach command. It only attaches data from a parent
5668>>>>>>>    // if 1) the DDO parent is connected to the structure and 2) if there is a record to attach. It will
5668>>>>>>>    // not attach empty records into a child. This should make the finding (and saving) more sensible when
5668>>>>>>>    // partial DD structures are used. For example, often a report does not all of the parent DDOs - however if
5668>>>>>>>    // they are not provided, finding can get messed up because blank data is being moved into the child before a
5668>>>>>>>    // find. This has been a problem since 3.0. This should just make it go away.
5668>>>>>>>    // as of 17.0, we get the related field info through the local DSO if needed
5668>>>>>>>
5668>>>>>>>    // as if 18.1 this is only called when there is an attachable relationship. This gives us a chance to do any
5668>>>>>>>    // customizations and to cancel the attach. We've left this to the flex level so we can fine tune attaches.
5668>>>>>>>    Function ShouldFieldAttach Integer iField Handle hoRelDD Returns Boolean
5670>>>>>>>        Boolean bDoAttach bChanged
5670>>>>>>>        Integer iFile iStat iRelFile iType
5670>>>>>>>        String sValue
5670>>>>>>>
5670>>>>>>>        Get Main_File to iFile
5671>>>>>>>        Get Main_File of hoRelDD to iRelFile
5672>>>>>>>
5672>>>>>>>        // before we attach check if Find mode and relfile is new and unchanged..if so skip.
5672>>>>>>>        // If operation_mode is 0, this is probably a Find (item_find sends attach_main_file for some reason).
5672>>>>>>>        Move True to bDoAttach
5673>>>>>>>        If (Operation_mode=MODE_FINDING or OPERATION_MODE=0) Begin
5675>>>>>>>            // we can test the file status to see if we have a record or not. If we have a record, we attach
5675>>>>>>>            Get_Attribute DF_FILE_STATUS  of iRelFile to iStat
5678>>>>>>>            If (iStat=DF_FILE_INACTIVE) Begin
5680>>>>>>>                // if no record, we need to look for changes. We can't just look at the file's changed state because the DD
5680>>>>>>>                // may have set defaults, which have been moved to the buffer. We should be able to check the DD's changed state
5680>>>>>>>                // because this is not set with default values. When doing a find entry_update this should be ok. If this were
5680>>>>>>>                // a save, this would cause problems (but this is not a save). Prior to 17.0 this was not an issue with windows
5680>>>>>>>                // applications because find entry_updates were done at the DEO level (unlike web applications).
5680>>>>>>>                Get Changed_State of hoRelDD to bChanged
5681>>>>>>>                Move bChanged to bDoAttach
5682>>>>>>>
5682>>>>>>>                // special Triumph workaround for Item_Find with blank inner segment. They were counting on the item_find attach_main_file
5682>>>>>>>                // which would slip through the "no-attach on find when parent is empty optimization". This was needed to force a string segment
5682>>>>>>>                // that was "" to get filled with spaces from the parent field. The child field was set to "" because of a constrained_clear
5682>>>>>>>                // in Item_find. This workaround is as narrow as possible. If an item_find attach_main_file (operation_mode=0) and this is
5682>>>>>>>                // an empty parent (bOk was just set to False), and the field is DF_Ascii and the child value is empty (no trailing spaces)
5682>>>>>>>                // then force an attach. Since the parent should be "", we can just Set_Field_value to "", which fills the field buffer.
5682>>>>>>>                // There is no real logic as to why this is being done other than to make it work like it used to with the least
5682>>>>>>>                // amount of side-effects.
5682>>>>>>>                If (not(bDoAttach) and OPERATION_MODE=0) Begin
5684>>>>>>>                    Get_Attribute DF_FIELD_TYPE of iFile iField to iType
5687>>>>>>>                    If (iType=DF_ASCII) Begin
5689>>>>>>>                        Get_Field_Value iFile iField to sValue
5692>>>>>>>                        // if no spaces, this probably was cleared via constrained_clear in Item_Find. We should update
5692>>>>>>>                        If (Ascii(Left(sValue,1))=0) Begin
5694>>>>>>>                            Set_Field_Value iFile iField to ""
5697>>>>>>>                        End
5697>>>>>>>>
5697>>>>>>>                    End
5697>>>>>>>>
5697>>>>>>>                End
5697>>>>>>>>
5697>>>>>>>
5697>>>>>>>            End
5697>>>>>>>>
5697>>>>>>>        End
5697>>>>>>>>
5697>>>>>>>        Function_Return bDoAttach
5698>>>>>>>    End_Function
5699>>>>>>>
5699>>>>>>>    // Notify all DEOs that a mask has changed.
5699>>>>>>>    //        this message is sent by set Field_Mask
5699>>>>>>>    Procedure Field_Mask_Changed Integer iField String sMask
5701>>>>>>>        Integer i iDEOs iDEO
5701>>>>>>>        Integer iMain_File
5701>>>>>>>        Get Main_File to iMain_File
5702>>>>>>>        Get Data_Set_User_Interface_Count to iDEOs
5703>>>>>>>        Decrement iDEOs
5704>>>>>>>        For i from 0 to iDEOs
5710>>>>>>>>
5710>>>>>>>            Get Data_Set_User_Interface i to iDEO
5711>>>>>>>            If (Extended_DEO_State(iDEO)) ;                Send File_Field_Mask_Changed to iDEO ;                iMain_File iField sMask
5714>>>>>>>        Loop
5715>>>>>>>>
5715>>>>>>>    End_Procedure
5716>>>>>>>

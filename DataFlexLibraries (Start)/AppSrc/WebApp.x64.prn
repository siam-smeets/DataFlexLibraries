32887>>>>>>>    Procedure RequestClearExec
32889>>>>>>>        String sCurrentRowID
32889>>>>>>>        RowID riCurrentRowID
32889>>>>>>>        Handle hoDD
32889>>>>>>>        Integer iMainFile
32889>>>>>>>        Boolean bOldGridAction bContinue bDataAware bSuccess
32889>>>>>>>
32889>>>>>>>        WebGet psCurrentRowId to sCurrentRowID
32890>>>>>>>        Get OnClearRow sCurrentRowID to bContinue
32891>>>>>>>        
32891>>>>>>>        Get pbDataAware to bDataAware
32892>>>>>>>        If (bDataAware) Begin
32894>>>>>>>            // db-aware....
32894>>>>>>>            If (bContinue) Begin
32896>>>>>>>                //  Set to prevent the entire grid from refreshing
32896>>>>>>>                Get Server to hoDD        
32897>>>>>>>                Move (DeserializeRowID(sCurrentRowID)) to riCurrentRowID
32898>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
32899>>>>>>>                Set pbNotifyingExternalDD to True
32900>>>>>>>                
32900>>>>>>>                //  Refind the current record
32900>>>>>>>                If (IsNullRowID(riCurrentRowID)) Begin
32902>>>>>>>                    Send Clear of hoDD
32903>>>>>>>                End
32903>>>>>>>>
32903>>>>>>>                Else Begin
32904>>>>>>>                    Get Main_File of hoDD to iMainFile
32905>>>>>>>                    Get FindByRowIdEx of hoDD iMainFile riCurrentRowID to bSuccess
32906>>>>>>>                    If not bSuccess Begin
32908>>>>>>>                        Set pbNotifyingExternalDD to False
32909>>>>>>>                        Send ReportCacheError
32910>>>>>>>                    End
32910>>>>>>>>
32910>>>>>>>                End
32910>>>>>>>>
32910>>>>>>>            
32910>>>>>>>                Set pbNotifyingExternalDD to bOldGridAction
32911>>>>>>>            End
32911>>>>>>>>
32911>>>>>>>        End
32911>>>>>>>>
32911>>>>>>>        Else Begin
32912>>>>>>>            // non-db aware...
32912>>>>>>>            If (bContinue) Begin
32914>>>>>>>                Send ClearRow sCurrentRowID
32915>>>>>>>            End
32915>>>>>>>>
32915>>>>>>>        End
32915>>>>>>>>
32915>>>>>>>    End_Procedure
32916>>>>>>>
32916>>>>>>>    
32916>>>>>>>    // Clear Logic which basically means refinding the current record.
32916>>>>>>>    // returns True if the clear was successful, False if we are not sure because there is a callback or clear actually failed
32916>>>>>>>    Function ClearSelectedRow Returns Integer
32918>>>>>>>        Handle hoDD hmVerify
32918>>>>>>>        String sCurrentRowID
32918>>>>>>>        Boolean bDataAware bChanged
32918>>>>>>>        Integer iReturn
32918>>>>>>>
32918>>>>>>>        // Manual data handling?
32918>>>>>>>        Get Verify_Data_Loss_Msg to hmVerify
32919>>>>>>>        WebGet psCurrentRowId to sCurrentRowID
32920>>>>>>>        Get pbDataAware to bDataAware
32921>>>>>>>        
32921>>>>>>>        Get ShouldSaveRow to bChanged
32922>>>>>>>        
32922>>>>>>>        If (bChanged) Begin
32924>>>>>>>            If (bDataAware) Begin
32926>>>>>>>                // db-aware..
32926>>>>>>>                Get Server to hoDD
32927>>>>>>>                If (hoDD <> 0) Begin
32929>>>>>>>                    If hmVerify Begin
32931>>>>>>>                        Send VerifyRequest (RefProc(RequestClearCallBack)) (RefFunc(Verify_Data_Loss_Msg))
32932>>>>>>>                        Function_Return sroPending // this means there is a verification so we don't know yet
32933>>>>>>>                    End
32933>>>>>>>>
32933>>>>>>>                    Else Begin
32934>>>>>>>                        Send RequestClearExec
32935>>>>>>>                        If (Should_Save_Row(hoDD)) Begin
32937>>>>>>>                            Function_Return sroFail // this means it actually failed
32938>>>>>>>                        End
32938>>>>>>>>
32938>>>>>>>                    End
32938>>>>>>>>
32938>>>>>>>                End
32938>>>>>>>>
32938>>>>>>>                Function_Return sroSucceed
32939>>>>>>>            End
32939>>>>>>>>
32939>>>>>>>            Else Begin
32940>>>>>>>                // non db-aware..
32940>>>>>>>                If hmVerify Begin
32942>>>>>>>                    Send VerifyRequest (RefProc(RequestClearCallBack)) (RefFunc(Verify_Data_Loss_Msg))
32943>>>>>>>                    Function_Return sroPending // this means there is a verification so we don't know yet
32944>>>>>>>                End
32944>>>>>>>>
32944>>>>>>>                Else Begin
32945>>>>>>>                    Send RequestClearExec
32946>>>>>>>                    // Currently we always consider that a clear succeeds. This is probably as safe
32946>>>>>>>                    // assumption but might be revisited in the future.
32946>>>>>>>                    Function_Return sroSucceed
32947>>>>>>>                End
32947>>>>>>>>
32947>>>>>>>            End
32947>>>>>>>>
32947>>>>>>>        End
32947>>>>>>>>
32947>>>>>>>      
32947>>>>>>>        Function_Return sroSucceed
32948>>>>>>>    End_Function
32949>>>>>>>    
32949>>>>>>>    // Client action to remove the passed row from the cache. 
32949>>>>>>>    Procedure ClearRow String sRowID
32951>>>>>>>        String[] aParams
32952>>>>>>>        
32952>>>>>>>        Move sRowID to aParams[0]
32953>>>>>>>        Send ClientAction "clearRow" aParams    
32954>>>>>>>    End_Procedure
32955>>>>>>>
32955>>>>>>>
32955>>>>>>>    
32955>>>>>>>    Procedure RequestSaveExec
32957>>>>>>>        Handle hoServer 
32957>>>>>>>        String sCurrentRowID sOrigRowID
32957>>>>>>>        Boolean bDataAware bContinue bError bUnOrdered bAutoRegenerate
32957>>>>>>>
32957>>>>>>>        WebGet psCurrentRowId to sOrigRowID
32958>>>>>>>        Move sOrigRowID to sCurrentRowID
32959>>>>>>>        
32959>>>>>>>        Get OnSaveRow (&sCurrentRowID) to bContinue
32960>>>>>>>        WebSet psCurrentRowId to sCurrentRowID   
32961>>>>>>>        
32961>>>>>>>        // db-aware....
32961>>>>>>>        Move (not(bContinue)) to bError
32962>>>>>>>        Get pbDataAware to bDataAware
32963>>>>>>>        
32963>>>>>>>        If (bDataAware and bContinue) Begin
32965>>>>>>>            // Validate the row... 
32965>>>>>>>            Get Server to hoServer
32966>>>>>>>            Get ValidateRow to bError
32967>>>>>>>            If (bError) Begin
32969>>>>>>>                Procedure_Return
32970>>>>>>>            End    
32970>>>>>>>>
32970>>>>>>>    
32970>>>>>>>            // Perform the save....
32970>>>>>>>            Move False to  Err
32971>>>>>>>            Send Request_Save to hoServer
32972>>>>>>>            Move Err to bError
32973>>>>>>>            If not bError Begin
32975>>>>>>>                // if a successful save see if we need to refresh the list. We do i
32975>>>>>>>                // pbAutoRegenerate is True and a save has rendered it possible unordered.
32975>>>>>>>                WebGet pbUnOrdered to bUnOrdered
32976>>>>>>>                Get pbAutoRegenerate to bAutoRegenerate
32977>>>>>>>                If (bUnOrdered and bAutoRegenerate) Begin
32979>>>>>>>                    Send RefreshListFromDD
32980>>>>>>>                End
32980>>>>>>>>
32980>>>>>>>            End
32980>>>>>>>>
32980>>>>>>>        End
32980>>>>>>>>
32980>>>>>>>        
32980>>>>>>>        // Force the client to refresh the saved row (in case any values were changed).
32980>>>>>>>        If (not(bError)) Begin
32982>>>>>>>            Send UpdateRow sOrigRowID 
32983>>>>>>>        End
32983>>>>>>>>
32983>>>>>>>    End_Procedure
32984>>>>>>>        
32984>>>>>>>    // Returns sroSucceed if the save was successful. Called by Request_Save.
32984>>>>>>>    Function SaveSelectedRow Returns Integer
32986>>>>>>>        Handle hoDD hmVerify
32986>>>>>>>        RowID riCurrentRowID riTestRowID
32986>>>>>>>        String sCurrentRowID
32986>>>>>>>        Boolean bDataAware bChanged bError
32986>>>>>>>        Integer iReturn
32986>>>>>>>
32986>>>>>>>        // Manual data handling?
32986>>>>>>>        WebGet psCurrentRowId to sCurrentRowID
32987>>>>>>>        Get pbDataAware to bDataAware
32988>>>>>>>        
32988>>>>>>>        // db-aware data handling....
32988>>>>>>>        If (bDataAware) Begin
32990>>>>>>>            Get Server to hoDD
32991>>>>>>>            
32991>>>>>>>            If (hoDD <> 0) Begin
32993>>>>>>>                Move (DeserializeRowID(sCurrentRowID)) to riCurrentRowID
32994>>>>>>>                Get CurrentRowId of hoDD to riTestRowID
32995>>>>>>>                
32995>>>>>>>                If (not(IsSameRowID(riCurrentRowID, riTestRowID))) Begin
32997>>>>>>>                    Error DFERR_PROGRAM "Assert: Server DDO's current record does not match psCurrentRowId"
32998>>>>>>>>
32998>>>>>>>                    Function_Return sroFail
32999>>>>>>>                End
32999>>>>>>>>
32999>>>>>>>                
32999>>>>>>>                // Verify that we are allowed to save....
32999>>>>>>>                If (Read_Only_State(hoDD)) Begin
33001>>>>>>>                    Function_Return sroFail         // the view should not allow this to happen
33002>>>>>>>                End
33002>>>>>>>>
33002>>>>>>>            End
33002>>>>>>>>
33002>>>>>>>        End
33002>>>>>>>>
33002>>>>>>>        
33002>>>>>>>        // If there is nothing to save, do nothing....
33002>>>>>>>        Get ShouldSaveRow to bChanged
33003>>>>>>>        If (not(bChanged)) Begin
33005>>>>>>>            Function_Return sroSucceed
33006>>>>>>>        End
33006>>>>>>>>
33006>>>>>>>        
33006>>>>>>>        // Validate the row... 
33006>>>>>>>        Get ValidateRow to bError
33007>>>>>>>        If (bError) Begin
33009>>>>>>>            Function_Return sroFail
33010>>>>>>>        End   
33010>>>>>>>>
33010>>>>>>>        
33010>>>>>>>        // perform verify callback or save now...
33010>>>>>>>        Get Verify_Save_msg to hmVerify
33011>>>>>>>        If (hmVerify) Begin
33013>>>>>>>            WebSet pbSaveCallbackActive to True
33014>>>>>>>            Send VerifyRequest (RefProc(RequestSaveCallBack)) (RefFunc(Verify_Save_msg))
33015>>>>>>>            Function_Return sroPending
33016>>>>>>>        End
33016>>>>>>>>
33016>>>>>>>        Else Begin
33017>>>>>>>            Send RequestSaveExec
33018>>>>>>>            If (bDataAware and Should_Save_Row(hoDD)) Begin
33020>>>>>>>                Function_Return sroFail
33021>>>>>>>            End
33021>>>>>>>>
33021>>>>>>>        End
33021>>>>>>>>
33021>>>>>>>        
33021>>>>>>>        Function_Return sroSucceed
33022>>>>>>>    End_Function
33023>>>>>>>    
33023>>>>>>>    // Determines if the current row has changed values in which case it should be saved. For 
33023>>>>>>>    // data-aware grids the DDO is asked to determine this. For non-data-aware grids the individual
33023>>>>>>>    // changed states of columns are queried.
33023>>>>>>>    Function ShouldSaveRow Returns Boolean
33025>>>>>>>        Handle[] aColumns
33026>>>>>>>        Integer iCol
33026>>>>>>>        Boolean bChanged
33026>>>>>>>      
33026>>>>>>>        // Test for Data-Aware grid...
33026>>>>>>>        If (pbDataAware(Self)) Begin
33028>>>>>>>            Function_Return (Should_Save_Row(Server(Self)))            
33029>>>>>>>        End
33029>>>>>>>>
33029>>>>>>>        Else Begin
33030>>>>>>>            //  Determine if a value was changed
33030>>>>>>>            Get phoColumnObjects to aColumns
33031>>>>>>>            For iCol from 0 to (SizeOfArray(aColumns) - 1)
33037>>>>>>>>
33037>>>>>>>                WebGet pbChanged of aColumns[iCol] to bChanged
33038>>>>>>>                
33038>>>>>>>                If (bChanged) Begin
33040>>>>>>>                    Function_Return True
33041>>>>>>>                End
33041>>>>>>>>
33041>>>>>>>            Loop
33042>>>>>>>>
33042>>>>>>>            
33042>>>>>>>            Function_Return False
33043>>>>>>>        End
33043>>>>>>>>
33043>>>>>>>    End_Function
33044>>>>>>>
33044>>>>>>>    // Returns true if you can move off of the selected row.
33044>>>>>>>    // This gets called during a row change and returns true if the row change is allowed. You are allowed
33044>>>>>>>    // to make changes to the row such as saving or clearing before returning if the row change is allowed.
33044>>>>>>>    //
33044>>>>>>>    // The following actions are performed here:
33044>>>>>>>    // [1] - ShouldSaveRow is tested. This will test if the current row needs saving.
33044>>>>>>>    // [2] - If the row needs saving it is saved if validation passes. If not then we stop here.
33044>>>>>>>    // [3] - If we are moving to a new row then the row is cleared, loaded with default values,
33044>>>>>>>    //       and the OnNewRow event gets fired.
33044>>>>>>>    Function AllowChangeSelectedRow String sGotoRow String sToRowID Returns Boolean
33046>>>>>>>        Handle hoDD hoColumn
33046>>>>>>>        Handle hmVerify
33046>>>>>>>       
33046>>>>>>>        RowID riCurrentRowID riTestRowID
33046>>>>>>>        String sCurrentRowID
33046>>>>>>>        Boolean bAutoSave bDataAware bChanged bResult bOldGridAction
33046>>>>>>>        Integer eSelectedRowOperation iCol iTo iRowIndex
33046>>>>>>>
33046>>>>>>>        Get Server to hoDD
33047>>>>>>>        Get pbAutoSave to bAutoSave
33048>>>>>>>        Get pbDataAware to bDataAware
33049>>>>>>>        
33049>>>>>>>        //  Assertions
33049>>>>>>>        If (bDataAware) Begin
33051>>>>>>>            If (hoDD <> 0) Begin
33053>>>>>>>                WebGet psCurrentRowId to sCurrentRowID
33054>>>>>>>                Move (DeserializeRowID(sCurrentRowID)) to riCurrentRowID
33055>>>>>>>                Get CurrentRowId of hoDD to riTestRowID
33056>>>>>>>                
33056>>>>>>>                If (not(IsSameRowID(riCurrentRowID, riTestRowID))) Begin
33058>>>>>>>                    Error DFERR_PROGRAM "Assert: Server DDO's current record does not match psCurrentRowId"
33059>>>>>>>>
33059>>>>>>>                    Function_Return False
33060>>>>>>>                End
33060>>>>>>>>
33060>>>>>>>            End
33060>>>>>>>>
33060>>>>>>>            Else Begin
33061>>>>>>>                Function_Return False
33062>>>>>>>            End
33062>>>>>>>>
33062>>>>>>>        End
33062>>>>>>>>
33062>>>>>>>        
33062>>>>>>>        // Save if needed, test also if the grid is currently cleared (no rows to save)....
33062>>>>>>>        WebGet piCurrentRowIndex to iRowIndex
33063>>>>>>>        
33063>>>>>>>        If (iRowIndex = -1) Begin
33065>>>>>>>            Move False to bChanged
33066>>>>>>>        End
33066>>>>>>>>
33066>>>>>>>        Else Begin
33067>>>>>>>            Get ShouldSaveRow to bChanged
33068>>>>>>>        End
33068>>>>>>>>
33068>>>>>>>
33068>>>>>>>        If (bChanged) Begin
33070>>>>>>>            // Verify that we are allowed to save....
33070>>>>>>>            If (bDataAware and Read_Only_State(hoDD)) Begin
33072>>>>>>>                Function_Return False         // the view should not allow this to happen
33073>>>>>>>            End
33073>>>>>>>>
33073>>>>>>>            
33073>>>>>>>            // Auto-save gets precedence over data-loss/clear
33073>>>>>>>            If bAutoSave Begin
33075>>>>>>>                Get SaveSelectedRow to eSelectedRowOperation
33076>>>>>>>            End
33076>>>>>>>>
33076>>>>>>>            Else Begin
33077>>>>>>>                Get ClearSelectedRow to eSelectedRowOperation
33078>>>>>>>            End
33078>>>>>>>>
33078>>>>>>>            
33078>>>>>>>            // we only allow a row change if we are sure we succeeded in the save or clear. If a confirmation verification
33078>>>>>>>            // is required the above will return sroPending, which we will treat as a no.
33078>>>>>>>            If (not(eSelectedRowOperation=sroSucceed)) Begin
33080>>>>>>>                Function_Return False
33081>>>>>>>            End
33081>>>>>>>>
33081>>>>>>>        End
33081>>>>>>>>
33081>>>>>>>        
33081>>>>>>>        //  Handle changing to a new row
33081>>>>>>>        If (sGotoRow = "new") Begin
33083>>>>>>>            If (bDataAware) Begin
33085>>>>>>>                // data-aware: Clear the DD
33085>>>>>>>                Get Server to hoDD
33086>>>>>>>                // find the row that we are going to...
33086>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
33087>>>>>>>                Set pbNotifyingExternalDD to True
33088>>>>>>>                
33088>>>>>>>                Send Clear of hoDD
33089>>>>>>>                
33089>>>>>>>                Set pbNotifyingExternalDD to bOldGridAction
33090>>>>>>>            End
33090>>>>>>>>
33090>>>>>>>            Else Begin
33091>>>>>>>                // non-data-aware: Use the data received from the client
33091>>>>>>>                Send FillFromActionData
33092>>>>>>>            End
33092>>>>>>>>
33092>>>>>>>            
33092>>>>>>>            //  Trigger event
33092>>>>>>>            Send OnNewRow
33093>>>>>>>        End
33093>>>>>>>>
33093>>>>>>>        
33093>>>>>>>        Function_Return True
33094>>>>>>>    End_Function
33095>>>>>>>    
33095>>>>>>>    
33095>>>>>>>    // Validates the selected row. 
33095>>>>>>>    // Returns True if Error, False if Ok
33095>>>>>>>    Function ValidateRow Returns Boolean
33097>>>>>>>        Handle hoDD
33097>>>>>>>        Handle[] hoColumnObjects
33098>>>>>>>        Boolean bError bRequestValidateAll bDataAware bOk
33098>>>>>>>        Integer icColumn iCol
33098>>>>>>>        
33098>>>>>>>        Get pbRequesteValidateAll to bRequestValidateAll
33099>>>>>>>        
33099>>>>>>>        Get pbDataAware to bDataAware
33100>>>>>>>        
33100>>>>>>>        // if not data aware perform validation here
33100>>>>>>>        If (not(bDataAware)) Begin
33102>>>>>>>    
33102>>>>>>>            // Validate each column....
33102>>>>>>>            Get phoColumnObjects to hoColumnObjects
33103>>>>>>>            Move (SizeOfArray(hoColumnObjects)) to icColumn
33104>>>>>>>            
33104>>>>>>>            For iCol from 0 to (icColumn-1)
33110>>>>>>>>
33110>>>>>>>                Get OnValidate of hoColumnObjects[iCol] to bOk
33111>>>>>>>                If not bOk Begin
33113>>>>>>>                    If not bRequestValidateAll Begin
33115>>>>>>>                        Function_Return True
33116>>>>>>>                    End
33116>>>>>>>>
33116>>>>>>>                    Else Begin
33117>>>>>>>                        Move True to bError
33118>>>>>>>                    End
33118>>>>>>>>
33118>>>>>>>                End
33118>>>>>>>>
33118>>>>>>>            Loop
33119>>>>>>>>
33119>>>>>>>            Function_Return bError
33120>>>>>>>        End
33120>>>>>>>>
33120>>>>>>>        
33120>>>>>>>        // if data aware, perform validation through the DDs
33120>>>>>>>        Get Server to hoDD
33121>>>>>>>        If (hoDD <> 0) Begin
33123>>>>>>>            Get pbRequesteValidateAll to bRequestValidateAll
33124>>>>>>>            If bRequestValidateAll Begin
33126>>>>>>>                Get Request_Validate_All of hoDD to bError
33127>>>>>>>            End
33127>>>>>>>>
33127>>>>>>>            Else Begin
33128>>>>>>>                Get Request_Validate of hoDD to bError
33129>>>>>>>            End
33129>>>>>>>>
33129>>>>>>>            
33129>>>>>>>        End
33129>>>>>>>>
33129>>>>>>>        Function_Return bError
33130>>>>>>>    End_Function
33131>>>>>>>

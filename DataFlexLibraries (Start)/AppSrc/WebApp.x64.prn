25834>>>>>>>>>>>    // Override's basic AllowUpdateDD behaviour (cWebBaseDEO).
25834>>>>>>>>>>>    Procedure AllowUpdateDD Boolean ByRef bAllow
25836>>>>>>>>>>>        If (bAllow) Begin
25838>>>>>>>>>>>            WebGet pbEditable to bAllow
25839>>>>>>>>>>>            If (not(bAllow)) ;                Procedure_Return
25842>>>>>>>>>>>            

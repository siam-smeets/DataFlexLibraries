10662>>>>>>>>>    Procedure SQLSetParameter Integer iParamNum String sParamValue Integer iParamType
10664>>>>>>>>>        
10664>>>>>>>>>        Integer ihdbc
10664>>>>>>>>>        Integer ihstmt
10664>>>>>>>>>        String  sDrvrId
10664>>>>>>>>>        Integer iVoid
10664>>>>>>>>>        String  sEmpty
10664>>>>>>>>>        Integer iType
10664>>>>>>>>>        
10664>>>>>>>>>        If (num_arguments < 3) Begin
10666>>>>>>>>>            Move typeString to iType
10667>>>>>>>>>        End
10667>>>>>>>>>>
10667>>>>>>>>>        Else Begin
10668>>>>>>>>>            Move iParamType to iType
10669>>>>>>>>>        End
10669>>>>>>>>>>
10669>>>>>>>>>        
10669>>>>>>>>>        Case Begin
10669>>>>>>>>>            Case (iType = typeDate )    
10671>>>>>>>>>
10671>>>>>>>>>                If (sParamValue <> "") Begin
10673>>>>>>>>>                    ConvertToXml typeDate sParamValue to sParamValue
10674>>>>>>>>>                End
10674>>>>>>>>>>
10674>>>>>>>>>                
10674>>>>>>>>>                Break
10675>>>>>>>>>
10675>>>>>>>>>            Case (iType = typeDatetime )    
10678>>>>>>>>>
10678>>>>>>>>>                If (sParamValue <> "") Begin
10680>>>>>>>>>                    ConvertToXml esqlDatetime sParamValue to sParamValue
10681>>>>>>>>>                    Move (Replace('T',sParamValue,' ')) to sParamValue 
10682>>>>>>>>>                End
10682>>>>>>>>>>
10682>>>>>>>>>
10682>>>>>>>>>                Break
10683>>>>>>>>>
10683>>>>>>>>>            Case (iType = typeNumber )    
10686>>>>>>>>>
10686>>>>>>>>>                If (sParamValue <> "") Begin
10688>>>>>>>>>                    ConvertToXml typeNumber sParamValue to sParamValue
10689>>>>>>>>>                End
10689>>>>>>>>>>
10689>>>>>>>>>                
10689>>>>>>>>>                Break
10690>>>>>>>>>            
10690>>>>>>>>>            Case (iType = typeTime )    
10693>>>>>>>>>
10693>>>>>>>>>                If (sParamValue <> "") Begin
10695>>>>>>>>>                    ConvertToXml esqlTime sParamValue to sParamValue
10696>>>>>>>>>                End
10696>>>>>>>>>>
10696>>>>>>>>>                
10696>>>>>>>>>                Break
10697>>>>>>>>>                
10697>>>>>>>>>            Case Else
10697>>>>>>>>>                    // sParamValue is a string type or a type that must be passed as a string
10697>>>>>>>>>                    Break
10698>>>>>>>>>                
10698>>>>>>>>>        Case End
10698>>>>>>>>>        
10698>>>>>>>>>        
10698>>>>>>>>>        // Initialize
10698>>>>>>>>>        Move "" to sEmpty
10699>>>>>>>>>        
10699>>>>>>>>>        // Get the cli handles
10699>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10700>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10701>>>>>>>>>        Get psDriverId            to sDrvrId
10702>>>>>>>>>        
10702>>>>>>>>>        // Call the procedure
10702>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10704>>>>>>>>>            // Pass the information
10704>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                Callback Self ;                Passing ihdbc iParamnum ihstmt ;                Result iVoid
10709>>>>>>>>>            
10709>>>>>>>>>            // Pass the argument
10709>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLSETPROCARG ;                Callback Self ;                Passing sParamValue sEmpty 0 ;                Result iVoid
10714>>>>>>>>>        End
10714>>>>>>>>>>
10714>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLSetParameter"
10716>>>>>>>>>    End_Procedure
10717>>>>>>>>>    
10717>>>>>>>>>    
10717>>>>>>>>>    // Call a stored procedure
10717>>>>>>>>>    Procedure SQLCall
10719>>>>>>>>>        Integer ihdbc
10719>>>>>>>>>        Integer ihstmt
10719>>>>>>>>>        String  sDrvrId
10719>>>>>>>>>        Integer iVoid
10719>>>>>>>>>        String  sEmpty
10719>>>>>>>>>        
10719>>>>>>>>>        // Initialize
10719>>>>>>>>>        Move "" to sEmpty
10720>>>>>>>>>        
10720>>>>>>>>>        // Get the cli handles
10720>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10721>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10722>>>>>>>>>        Get psDriverId            to sDrvrId
10723>>>>>>>>>        
10723>>>>>>>>>        // Call the procedure
10723>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10725>>>>>>>>>            // Call the procedure
10725>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCALL ;                Callback Self ;                Passing ihdbc sEmpty ihstmt ;                Result iVoid
10730>>>>>>>>>            
10730>>>>>>>>>            Send SQLGetStatementAttributes
10731>>>>>>>>>            Set piLastArgument to 0
10732>>>>>>>>>        End
10732>>>>>>>>>>
10732>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLCall"
10734>>>>>>>>>    End_Procedure
10735>>>>>>>>>    
10735>>>>>>>>>    
10735>>>>>>>>>    // Get the next argument
10735>>>>>>>>>    Function SQLGetNextArgument Returns String
10737>>>>>>>>>        Integer iArgnum
10737>>>>>>>>>        String  sResult
10737>>>>>>>>>        
10737>>>>>>>>>        Get piLastArgument to iArgnum
10738>>>>>>>>>        Increment iArgnum
10739>>>>>>>>>        Get SQLGetArgument iArgnum to sResult
10740>>>>>>>>>        Set piLastArgument to iArgnum
10741>>>>>>>>>        
10741>>>>>>>>>        Function_Return sResult
10742>>>>>>>>>    End_Function
10743>>>>>>>>>    
10743>>>>>>>>>    
10743>>>>>>>>>    
10743>>>>>>>>>    // Get the specified argument from a procedure
10743>>>>>>>>>    Function SQLGetArgument Integer iArgnum Returns String
10745>>>>>>>>>        Integer ihdbc
10745>>>>>>>>>        Integer ihstmt
10745>>>>>>>>>        String  sDrvrId
10745>>>>>>>>>        Integer iVoid
10745>>>>>>>>>        String  sEmpty
10745>>>>>>>>>        String  sArgument
10745>>>>>>>>>        Integer iLen
10745>>>>>>>>>        
10745>>>>>>>>>        // Initialize
10745>>>>>>>>>        Move "" to sEmpty
10746>>>>>>>>>        Move "" to sArgument
10747>>>>>>>>>        
10747>>>>>>>>>        // Get the cli handles
10747>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10748>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10749>>>>>>>>>        Get psDriverId            to sDrvrId
10750>>>>>>>>>        
10750>>>>>>>>>        // Call the procedure
10750>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10752>>>>>>>>>            // Pass the information
10752>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                Callback Self ;                Passing ihdbc iArgnum ihstmt ;                Result iVoid
10757>>>>>>>>>            
10757>>>>>>>>>            // Get the length
10757>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLGETPROCARGLEN ;                Callback Self ;                Passing sEmpty sEmpty 0 ;                Result iLen
10762>>>>>>>>>            
10762>>>>>>>>>            If (iLen) Begin
10764>>>>>>>>>                // Allocate
10764>>>>>>>>>                Move (Repeat(' ', iLen)) to sArgument
10765>>>>>>>>>                
10765>>>>>>>>>                // Pass the argument
10765>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLGETPROCARG ;                    Callback Self ;                    Passing sArgument sEmpty 0 ;                    Result iVoid
10770>>>>>>>>>            End
10770>>>>>>>>>>
10770>>>>>>>>>        End
10770>>>>>>>>>>
10770>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLGetArgument"
10772>>>>>>>>>        
10772>>>>>>>>>        Function_Return sArgument
10773>>>>>>>>>    End_Function
10774>>>>>>>>>    
10774>>>>>>>>>    
10774>>>>>>>>>    // Get the return value of a stored function
10774>>>>>>>>>    Function SQLReturnValue Returns String
10776>>>>>>>>>        Integer ihdbc
10776>>>>>>>>>        Integer ihstmt
10776>>>>>>>>>        String  sDrvrId
10776>>>>>>>>>        Integer iVoid
10776>>>>>>>>>        String  sEmpty
10776>>>>>>>>>        String  sRetval
10776>>>>>>>>>        Integer iLen
10776>>>>>>>>>        
10776>>>>>>>>>        // Initialize
10776>>>>>>>>>        Move "" to sEmpty
10777>>>>>>>>>        Move "" to sRetval
10778>>>>>>>>>        
10778>>>>>>>>>        // Get the cli handles
10778>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10779>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10780>>>>>>>>>        Get psDriverId            to sDrvrId
10781>>>>>>>>>        
10781>>>>>>>>>        // Call the procedure
10781>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10783>>>>>>>>>            // Get the length
10783>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLGETPROCRETVALLEN ;                Callback Self ;                Passing ihdbc sEmpty ihstmt  ;                Result iLen
10788>>>>>>>>>            
10788>>>>>>>>>            If (iLen) Begin
10790>>>>>>>>>                // Allocate
10790>>>>>>>>>                Move (Repeat(' ', iLen)) to sRetval
10791>>>>>>>>>                
10791>>>>>>>>>                // Pass the argument
10791>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLGETPROCRETVAL ;                    Callback Self ;                    Passing ihdbc sRetval ihstmt ;                    Result iVoid
10796>>>>>>>>>            End
10796>>>>>>>>>>
10796>>>>>>>>>        End
10796>>>>>>>>>>
10796>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLReturnValue"
10798>>>>>>>>>        
10798>>>>>>>>>        Function_Return sRetval
10799>>>>>>>>>    End_Function
10800>>>>>>>>>    
10800>>>>>>>>>    
10800>>>>>>>>>    // Switch to the next set
10800>>>>>>>>>    // Returns : 0   = No more result sets
10800>>>>>>>>>    //     <>0 = Switched to next set
10800>>>>>>>>>    Function SQLNextResultSet Returns Integer
10802>>>>>>>>>        Integer ihdbc
10802>>>>>>>>>        Integer ihstmt
10802>>>>>>>>>        String  sDrvrId
10802>>>>>>>>>        Integer iResult
10802>>>>>>>>>        String  sEmpty
10802>>>>>>>>>        
10802>>>>>>>>>        // Initialize
10802>>>>>>>>>        Move "" to sEmpty
10803>>>>>>>>>        Move 0  to iResult
10804>>>>>>>>>        
10804>>>>>>>>>        // Get the cli handles
10804>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10805>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10806>>>>>>>>>        Get psDriverId            to sDrvrId
10807>>>>>>>>>        
10807>>>>>>>>>        // Call the procedure
10807>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10809>>>>>>>>>            // Get the length
10809>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLNEXTRESULTSET ;                Callback Self ;                Passing ihdbc sEmpty ihstmt  ;                Result iResult
10814>>>>>>>>>            
10814>>>>>>>>>            Send SQLGetStatementAttributes
10815>>>>>>>>>            Set piLastArgument to 0
10816>>>>>>>>>        End
10816>>>>>>>>>>
10816>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLNextResultSet"
10818>>>>>>>>>        
10818>>>>>>>>>        Function_Return iResult
10819>>>>>>>>>    End_Function
10820>>>>>>>>>    
10820>>>>>>>>>    
10820>>>>>>>>>    // Setup a file that will be acivated after a succesfull
10820>>>>>>>>>    //fetch on the statement
10820>>>>>>>>>    Procedure SQLFetchActivatesBuffer Integer iFileNum Integer bState
10822>>>>>>>>>        Integer ihdbc
10822>>>>>>>>>        Integer ihstmt
10822>>>>>>>>>        String  sDrvrId
10822>>>>>>>>>        Integer iResult
10822>>>>>>>>>        Integer bIsOpen
10822>>>>>>>>>        Integer iVoid
10822>>>>>>>>>        String  sFileType
10822>>>>>>>>>        
10822>>>>>>>>>        // Check if file is open
10822>>>>>>>>>        Get_Attribute DF_FILE_OPENED of iFileNum to bIsOpen
10825>>>>>>>>>        If (bIsOpen) Begin
10827>>>>>>>>>            // Get the cli handles
10827>>>>>>>>>            Get phCLIStatementHandle  to ihstmt
10828>>>>>>>>>            Get phCLIConnectionHandle to ihdbc
10829>>>>>>>>>            Get psDriverId            to sDrvrId
10830>>>>>>>>>            
10830>>>>>>>>>            // Call the procedure
10830>>>>>>>>>            If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10832>>>>>>>>>                // Check if the file has the correct type
10832>>>>>>>>>                Get_Attribute DF_FILE_DRIVER of iFileNum to sFileType
10835>>>>>>>>>                If (sFileType = sDrvrId) Begin
10837>>>>>>>>>                    // Setup the buffer
10837>>>>>>>>>                    Call_Driver iFileNum sDrvrId Function FUNC_SQLBUFFERSTATUS ;                        Callback Self ;                        Passing ihdbc bState ihstmt  ;                        Result iVoid
10842>>>>>>>>>                End
10842>>>>>>>>>>
10842>>>>>>>>>                Else ;                    Send StmtError CLIERR_SQLINVALID_BIND_FILE ("File" * String(iFileNum) * "type incompatible with statement ("  + sFileType + ")") "SQLBindFile"
10844>>>>>>>>>            End
10844>>>>>>>>>>
10844>>>>>>>>>            Else ;                Send HandleError ihstmt ihdbc sDrvrId "SQLFetchActivatesBuffer"
10846>>>>>>>>>        End
10846>>>>>>>>>>
10846>>>>>>>>>        Else ;            Send StmtError CLIERR_SQLINVALID_BUFFER ("File not open (number =" * String(iFileNum) + ")") "SQLFetchActivatesBuffer"
10848>>>>>>>>>    End_Procedure
10849>>>>>>>>>    
10849>>>>>>>>>    
10849>>>>>>>>>    
10849>>>>>>>>>    Function SQLGetMessage Integer iMessageNum Returns String
10851>>>>>>>>>        Integer ihdbc
10851>>>>>>>>>        Integer ihstmt
10851>>>>>>>>>        String  sDrvrId
10851>>>>>>>>>        String  sMessage
10851>>>>>>>>>        Integer iVoid
10851>>>>>>>>>        
10851>>>>>>>>>        // Initialize
10851>>>>>>>>>        Move "" to sMessage
10852>>>>>>>>>        
10852>>>>>>>>>        // Get the cli handles
10852>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10853>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10854>>>>>>>>>        Get psDriverId            to sDrvrId
10855>>>>>>>>>        
10855>>>>>>>>>        // Call the procedure
10855>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10857>>>>>>>>>            // Setup function arguments
10857>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                Callback Self ;                Passing ihdbc iMessageNum ihstmt ;                Result iVoid
10862>>>>>>>>>            
10862>>>>>>>>>            Move (Repeat(' ', 1024)) to sMessage
10863>>>>>>>>>            // Get the length
10863>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLGETMESSAGE ;                Callback Self ;                Passing iVoid sMessage iVoid ;                Result iVoid
10868>>>>>>>>>        End
10868>>>>>>>>>>
10868>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLGetDiagRec"
10870>>>>>>>>>        
10870>>>>>>>>>        Function_Return sMessage
10871>>>>>>>>>    End_Function
10872>>>>>>>>>    
10872>>>>>>>>>    
10872>>>>>>>>>    
10872>>>>>>>>>    // Remove the component identifier from a diagnostic message
10872>>>>>>>>>    Function RemoveComponentIdentifier String sDiagMessage Returns String
10874>>>>>>>>>        While (Left(sDiagMessage, 1) = "[")
10878>>>>>>>>>            Move (Right(sDiagMessage, Length(sDiagMessage) - Pos("]", sDiagMessage))) to sDiagMessage
10879>>>>>>>>>        Loop
10880>>>>>>>>>>
10880>>>>>>>>>        
10880>>>>>>>>>        Function_Return sDiagMessage
10881>>>>>>>>>    End_Function
10882>>>>>>>>>    
10882>>>>>>>>>    
10882>>>>>>>>>    
10882>>>>>>>>>    // Convert a DataFlex date to a SQL Date. Use dummy zero dates.
10882>>>>>>>>>    Function DFDateToSQLDate Date dDFDate Integer iSQLType Returns String
10884>>>>>>>>>        
10884>>>>>>>>>        Integer iType
10884>>>>>>>>>        String  sSQLDate
10884>>>>>>>>>        Integer iOrgDateFmt
10884>>>>>>>>>        Integer iOrgDateSep
10884>>>>>>>>>        
10884>>>>>>>>>        String sDriverId
10884>>>>>>>>>        String sDummyZeroDate
10884>>>>>>>>>        String sDummyZeroDateMssqlDatetime
10884>>>>>>>>>        
10884>>>>>>>>>        // Change date format to military, SQL dates are military dates
10884>>>>>>>>>        Get_Attribute DF_DATE_FORMAT to iOrgDateFmt
10887>>>>>>>>>        Get_Attribute DF_DATE_SEPARATOR to iOrgDateSep
10890>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to DF_DATE_MILITARY
10893>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to (Ascii('-'))
10896>>>>>>>>>        
10896>>>>>>>>>        // We only need to convert if the date is 0
10896>>>>>>>>>        If (Integer(dDFDate = 0)) Begin
10898>>>>>>>>>            
10898>>>>>>>>>            If (num_arguments < 2) Begin
10900>>>>>>>>>                Move SQL_TYPE_TIMESTAMP to iType
10901>>>>>>>>>            End
10901>>>>>>>>>>
10901>>>>>>>>>            Else Begin
10902>>>>>>>>>                Move iSQLType to iType
10903>>>>>>>>>            End
10903>>>>>>>>>>
10903>>>>>>>>>            
10903>>>>>>>>>            
10903>>>>>>>>>            Get psDriverID to sDriverId
10904>>>>>>>>>            Get psDummyZeroDate to sDummyZeroDate
10905>>>>>>>>>            
10905>>>>>>>>>            If ( (iType = SQL_TYPE_TIMESTAMP) and (sDriverID = 'MSSQLDRV') ) Begin
10907>>>>>>>>>                Get psDummyZeroDateMssqlDatetime to sDummyZeroDateMssqlDatetime
10908>>>>>>>>>                Move sDummyZeroDateMssqlDatetime to sSQLDate
10909>>>>>>>>>            End
10909>>>>>>>>>>
10909>>>>>>>>>            Else Begin
10910>>>>>>>>>                Move sDummyZeroDate to sSQLDate
10911>>>>>>>>>            End
10911>>>>>>>>>>
10911>>>>>>>>>            
10911>>>>>>>>>        End
10911>>>>>>>>>>
10911>>>>>>>>>        Else Begin
10912>>>>>>>>>            Move dDFDate to sSQLDate
10913>>>>>>>>>        End
10913>>>>>>>>>>
10913>>>>>>>>>        
10913>>>>>>>>>        // Change date format back to original
10913>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to iOrgDateFmt
10916>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to iOrgDateSep
10919>>>>>>>>>        
10919>>>>>>>>>        Function_Return sSQLDate
10920>>>>>>>>>    End_Function
10921>>>>>>>>>    
10921>>>>>>>>>    
10921>>>>>>>>>    // Convert a SQL date to a DataFlex Date. Use dummy zero dates.
10921>>>>>>>>>    Function SQLDateToDFDate String sSQLDate Returns Date
10923>>>>>>>>>        
10923>>>>>>>>>        Integer iType
10923>>>>>>>>>        Date    dDFDate
10923>>>>>>>>>        Integer iOrgDateFmt
10923>>>>>>>>>        Integer iOrgDateSep
10923>>>>>>>>>        
10923>>>>>>>>>        String  sDriverId
10923>>>>>>>>>        String  sDummyZeroDate
10923>>>>>>>>>        String  sDummyZeroDateMssqlDatetime
10923>>>>>>>>>        
10923>>>>>>>>>        Get psDriverID to sDriverId
10924>>>>>>>>>        
10924>>>>>>>>>        Get psDummyZeroDate to sDummyZeroDate
10925>>>>>>>>>        Get psDummyZeroDateMssqlDatetime to sDummyZeroDateMssqlDatetime
10926>>>>>>>>>        
10926>>>>>>>>>        Get_Attribute DF_DATE_FORMAT to iOrgDateFmt
10929>>>>>>>>>        Get_Attribute DF_DATE_SEPARATOR to iOrgDateSep
10932>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to DF_DATE_MILITARY
10935>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to (Ascii('-'))
10938>>>>>>>>>        
10938>>>>>>>>>        Move (Left(sSQLDate,10)) to sSQLDate
10939>>>>>>>>>        
10939>>>>>>>>>        If ( (sSQLDate = sDummyZeroDate) or ;            ( (sDriverId = 'MSSQLDRV') and (sSQLDate = sDummyZeroDateMssqlDatetime) ) )  Begin
10941>>>>>>>>>            Move 0 to dDFDate
10942>>>>>>>>>        End
10942>>>>>>>>>>
10942>>>>>>>>>        Else Begin
10943>>>>>>>>>            Move sSQLDate to dDFDate
10944>>>>>>>>>        End
10944>>>>>>>>>>
10944>>>>>>>>>        
10944>>>>>>>>>        // Change date format back to original
10944>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to iOrgDateFmt
10947>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to iOrgDateSep
10950>>>>>>>>>        
10950>>>>>>>>>        Function_Return dDFDate
10951>>>>>>>>>    End_Function
10952>>>>>>>>>    
10952>>>>>>>>>End_Class
10953>>>>>>>>>
10953>>>>>>>>>
10953>>>>>>>>>// Connection object for embedded SQL                          
10953>>>>>>>>>// This provides the ability to create a connection for a driver.     
10953>>>>>>>>>// It will contain child statement objects                            
10953>>>>>>>>>
10953>>>>>>>>>Class cSQLConnection is a cObject
10954>>>>>>>>>    
10954>>>>>>>>>    Procedure Construct_object
10956>>>>>>>>>        Forward Send Construct_object
10958>>>>>>>>>        
10958>>>>>>>>>        Property Integer phCLIConnectionHandle       0
10959>>>>>>>>>        
10959>>>>>>>>>        Property String  psDriverID        ""
10960>>>>>>>>>        Property Integer piBindFile        0
10961>>>>>>>>>        
10961>>>>>>>>>        Property String psDummyZeroDate              '0001-01-01'
10962>>>>>>>>>        Property String psDummyZeroDateMssqlDatetime '1753-01-01'
10963>>>>>>>>>        
10963>>>>>>>>>    End_Procedure
10964>>>>>>>>>    
10964>>>>>>>>>    
10964>>>>>>>>>    
10964>>>>>>>>>    // Store basic information about the connection
10964>>>>>>>>>    Procedure StoreConnectionInfo Handle hCLIConnectionHandle String sDrvrId
10966>>>>>>>>>        
10966>>>>>>>>>        String sDummyZeroDate
10966>>>>>>>>>        Integer iDriverIndex
10966>>>>>>>>>        
10966>>>>>>>>>        Set phCLIConnectionHandle to hCLIConnectionHandle
10967>>>>>>>>>        Set psDriverID            to sDrvrId
10968>>>>>>>>>        
10968>>>>>>>>>        Case Begin
10968>>>>>>>>>            Case (sDrvrId = "MSSQLDRV")
10970>>>>>>>>>                Set psDummyZeroDate to '0001-01-01'
10971>>>>>>>>>                Set psDummyZeroDateMssqlDatetime to '1753-01-01'
10972>>>>>>>>>                Break
10973>>>>>>>>>            Case (sDrvrId = "DB2_DRV")
10976>>>>>>>>>                Set psDummyZeroDate to '0001-01-01'
10977>>>>>>>>>                Break
10978>>>>>>>>>            Case (sDrvrId = "ODBC_DRV")
10981>>>>>>>>>                Get DriverIndex "ODBC_DRV" to iDriverIndex
10982>>>>>>>>>                If (iDriverIndex <> 0) Begin
10984>>>>>>>>>                    Get_Attribute DF_DRIVER_DUMMY_ZERO_DATE_VALUE of iDriverIndex to sDummyZeroDate
10987>>>>>>>>>                End
10987>>>>>>>>>>
10987>>>>>>>>>                Else Begin
10988>>>>>>>>>                    Move '0001-01-01' to sDummyZeroDate
10989>>>>>>>>>                End
10989>>>>>>>>>>
10989>>>>>>>>>
10989>>>>>>>>>                Set psDummyZeroDate to sDummyZeroDate
10990>>>>>>>>>                Break
10991>>>>>>>>>                
10991>>>>>>>>>        Case End
10991>>>>>>>>>        
10991>>>>>>>>>    End_Procedure
10992>>>>>>>>>    
10992>>>>>>>>>    Function DriverIndex String sDriver Returns Integer
10994>>>>>>>>>        
10994>>>>>>>>>        String  sCurrentDriver
10994>>>>>>>>>        Integer iNumberOfDrivers iDriver iCount
10994>>>>>>>>>        
10994>>>>>>>>>        Move 0 to iDriver
10995>>>>>>>>>        
10995>>>>>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iNumberOfDrivers
10998>>>>>>>>>        For iCount from 1 to iNumberOfDrivers
11004>>>>>>>>>>
11004>>>>>>>>>            
11004>>>>>>>>>            Get_Attribute DF_DRIVER_NAME of iCount to sCurrentDriver
11007>>>>>>>>>            If ( Uppercase(sCurrentDriver) = Uppercase(sDriver) ) Begin
11009>>>>>>>>>                Move iCount to iDriver
11010>>>>>>>>>            End
11010>>>>>>>>>>
11010>>>>>>>>>        Loop
11011>>>>>>>>>>
11011>>>>>>>>>        
11011>>>>>>>>>        Function_Return iDriver
11012>>>>>>>>>        
11012>>>>>>>>>    End_Function
11013>>>>>>>>>
11013>>>>>>>>>    
11013>>>>>>>>>    // Destroy the SQLConnection object
11013>>>>>>>>>    Procedure DestroySQLConnection
11015>>>>>>>>>        Send Destroy
11016>>>>>>>>>    End_Procedure
11017>>>>>>>>>    
11017>>>>>>>>>    
11017>>>>>>>>>    // Connect to a database server
11017>>>>>>>>>    // Returns : 1 Succesfully connected
11017>>>>>>>>>    //           0 Not connected
11017>>>>>>>>>    Function SQLConnect String sDrvrID String sConnect Returns Integer
11019>>>>>>>>>        Integer ihdbc
11019>>>>>>>>>        String  sEmpty
11019>>>>>>>>>        
11019>>>>>>>>>        // Initialize
11019>>>>>>>>>        Move "" to sEmpty
11020>>>>>>>>>        Move 0  to ihdbc
11021>>>>>>>>>        
11021>>>>>>>>>        Move False to Err
11022>>>>>>>>>        
11022>>>>>>>>>        // Call the driver function to connect
11022>>>>>>>>>        Call_Driver 0 sDrvrId Function FUNC_SQLCONNECT ;            Callback Self ;            Passing sConnect sEmpty Self ;            Result ihdbc
11027>>>>>>>>>        
11027>>>>>>>>>        // If there was an error, make result invalid
11027>>>>>>>>>        If (Err) ;            Move 0 to ihdbc
11030>>>>>>>>>        
11030>>>>>>>>>        // Check result and store it
11030>>>>>>>>>        If (ihdbc <> 0) ;            Send StoreConnectionInfo ihdbc sDrvrId
11033>>>>>>>>>        
11033>>>>>>>>>        // Return success status
11033>>>>>>>>>        Function_Return (ihdbc <> 0)
11034>>>>>>>>>    End_Function
11035>>>>>>>>>    
11035>>>>>>>>>    
11035>>>>>>>>>    // Use a connection of an already open file
11035>>>>>>>>>    Function SQLFileConnect Integer iFileNum Returns Integer
11037>>>>>>>>>        Integer ihdbc
11037>>>>>>>>>        Integer bIsOpen
11037>>>>>>>>>        String  sDrvrId
11037>>>>>>>>>        String  sEmpty
11037>>>>>>>>>        
11037>>>>>>>>>        // Initialize
11037>>>>>>>>>        Move "" to sEmpty
11038>>>>>>>>>        Move 0  to ihdbc
11039>>>>>>>>>        
11039>>>>>>>>>        // Check if file is open
11039>>>>>>>>>        Get_Attribute DF_FILE_OPENED of iFileNum to bIsOpen
11042>>>>>>>>>        If (bIsOpen) Begin
11044>>>>>>>>>            // Fill the driver id, assume longest is 255 characters
11044>>>>>>>>>            Move (Repeat(' ', 255)) to sDrvrId
11045>>>>>>>>>            Get_Attribute DF_FILE_DRIVER of iFileNum to sDrvrId
11048>>>>>>>>>            
11048>>>>>>>>>            Move False to Err
11049>>>>>>>>>            
11049>>>>>>>>>            // Call the driver function to connect
11049>>>>>>>>>            Call_Driver iFileNum sDrvrId Function FUNC_SQLFILECONNECT ;                Callback Self ;                Passing sEmpty sEmpty 0 ;                Result ihdbc
11054>>>>>>>>>            
11054>>>>>>>>>            // If there was an error, make result invalid
11054>>>>>>>>>            If (Err) ;                Move 0 to ihdbc
11057>>>>>>>>>            
11057>>>>>>>>>            // Check result and store it
11057>>>>>>>>>            If (ihdbc <> 0) Begin
11059>>>>>>>>>                // Somehow Call_driver overwrites the sDrvrId variable, restore it here
11059>>>>>>>>>                Get_Attribute DF_FILE_DRIVER of iFileNum to sDrvrId
11062>>>>>>>>>                Send StoreConnectionInfo ihdbc sDrvrId
11063>>>>>>>>>                
11063>>>>>>>>>                // Set filenum so it can be used for fetching
11063>>>>>>>>>                Set piBindFile to iFileNum
11064>>>>>>>>>            End
11064>>>>>>>>>>
11064>>>>>>>>>        End
11064>>>>>>>>>>
11064>>>>>>>>>        
11064>>>>>>>>>        // Return success status
11064>>>>>>>>>        Function_Return (ihdbc <> 0)
11065>>>>>>>>>    End_Function
11066>>>>>>>>>    
11066>>>>>>>>>    
11066>>>>>>>>>    // Establish an embedded SQL connection that uses an existing connection from an earlier login or open.
11066>>>>>>>>>    // Existing connections are identified by there connectstring. (can be obtained with DF_DRIVER_SERVER_NAME attribute)
11066>>>>>>>>>    // If sConnectString exist in the list of existing connections, that connection will be used for embedded SQL.
11066>>>>>>>>>    // The connectstring must be an exact match, but can be case insensitive
11066>>>>>>>>>    // The connectstring can contain a connection id. For example: "DFCONNID=MyConnectionID"
11066>>>>>>>>>    // If no matching connectstring is found, this function will return 0
11066>>>>>>>>>    // This function will only work with CLI connectivity kits 6.2 or later
11066>>>>>>>>>    Function SQLConnectionConnect String sDrvrID String sConnectString Returns Integer
11068>>>>>>>>>        Integer ihdbc
11068>>>>>>>>>        String  sEmpty
11068>>>>>>>>>        Integer iFileNum
11068>>>>>>>>>        
11068>>>>>>>>>        // Initialize
11068>>>>>>>>>        Move "" to sEmpty
11069>>>>>>>>>        Move 0  to ihdbc
11070>>>>>>>>>        
11070>>>>>>>>>        Move False to Err
11071>>>>>>>>>        
11071>>>>>>>>>        // Call the driver function
11071>>>>>>>>>        //   Note we call FUNC_SQLFILECONNECT with iFileNum = 0.
11071>>>>>>>>>        //   This will perform SQLConnectionConnect instead of SQLFileConnect
11071>>>>>>>>>        Move 0 to iFileNum
11072>>>>>>>>>        Call_Driver iFileNum sDrvrId Function FUNC_SQLFILECONNECT ;            Callback Self ;            Passing sConnectString sEmpty Self ;            Result ihdbc
11077>>>>>>>>>        
11077>>>>>>>>>        // If there was an error, make result invalid
11077>>>>>>>>>        If (Err) ;            Move 0 to ihdbc
11080>>>>>>>>>        
11080>>>>>>>>>        // Check result and store it
11080>>>>>>>>>        If (ihdbc <> 0) ;            Send StoreConnectionInfo ihdbc sDrvrId
11083>>>>>>>>>        
11083>>>>>>>>>        // Return success status
11083>>>>>>>>>        Function_Return (ihdbc <> 0)
11084>>>>>>>>>    End_Function
11085>>>>>>>>>    
11085>>>>>>>>>    
11085>>>>>>>>>    // Disconnect from an embedded SQL server and free allocated
11085>>>>>>>>>    // resources
11085>>>>>>>>>    Procedure SQLDisconnect
11087>>>>>>>>>        Integer ihdbc
11087>>>>>>>>>        Integer iVoid
11087>>>>>>>>>        String  sDrvrId
11087>>>>>>>>>        String  sEmpty
11087>>>>>>>>>        
11087>>>>>>>>>        // Initialize
11087>>>>>>>>>        Move "" to sEmpty
11088>>>>>>>>>        
11088>>>>>>>>>        // Get the cli handle
11088>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
11089>>>>>>>>>        Get psDriverId to sDrvrId
11090>>>>>>>>>        
11090>>>>>>>>>        // Free the CLI handle
11090>>>>>>>>>        If (ihdbc <> 0) Begin
11092>>>>>>>>>            // Call the driver function to disconnect
11092>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLDISCONNECT ;                Callback Self ;                Passing sEmpty sEmpty ihdbc ;                Result iVoid
11097>>>>>>>>>            
11097>>>>>>>>>            Move -1 to giLastSQLhdbc
11098>>>>>>>>>            
11098>>>>>>>>>            // Free the DataFlex handle
11098>>>>>>>>>            Send DestroySQLConnection
11099>>>>>>>>>        End
11099>>>>>>>>>>
11099>>>>>>>>>    End_Procedure
11100>>>>>>>>>    
11100>>>>>>>>>    // Create a cSQLStatement object
11100>>>>>>>>>    Function CreateSQLStatement Returns Handle
11102>>>>>>>>>        
11102>>>>>>>>>        Handle hoSQLStatement
11102>>>>>>>>>        Get Create (RefClass(cSQLStatement)) to hoSQLStatement
11103>>>>>>>>>        
11103>>>>>>>>>        // If the connection has a default Bind File, assign it to the
11103>>>>>>>>>        // statement object. The default is set when you open a file with a
11103>>>>>>>>>        // SetFileConnection command.
11103>>>>>>>>>        Set piBindFile of hoSQLStatement to (piBindFile(Self))
11104>>>>>>>>>        
11104>>>>>>>>>        Function_Return hoSQLStatement
11105>>>>>>>>>    End_Function
11106>>>>>>>>>    
11106>>>>>>>>>    
11106>>>>>>>>>    // Open a statement for use
11106>>>>>>>>>    Function SQLOpen Returns Handle
11108>>>>>>>>>        Handle  hoSQLStatement
11108>>>>>>>>>        Integer ihdbc
11108>>>>>>>>>        Integer ihstmt
11108>>>>>>>>>        Integer iVoid
11108>>>>>>>>>        String  sDrvrId
11108>>>>>>>>>        String  sEmpty
11108>>>>>>>>>        String  sDummyZeroDate
11108>>>>>>>>>        String  sDummyZeroDateMssqlDatetime
11108>>>>>>>>>        
11108>>>>>>>>>        // Initialize
11108>>>>>>>>>        Move "" to sEmpty
11109>>>>>>>>>        
11109>>>>>>>>>        // Get the cli handle to the connection
11109>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
11110>>>>>>>>>        Get psDriverId  to sDrvrId
11111>>>>>>>>>        
11111>>>>>>>>>        // Allocate a new handle and populate it
11111>>>>>>>>>        If (ihdbc <> 0) Begin
11113>>>>>>>>>            // Create a new cSQLStatement object
11113>>>>>>>>>            Get CreateSQLStatement to hoSQLStatement
11114>>>>>>>>>            
11114>>>>>>>>>            // Call the driver function to allocate a cli statement handle
11114>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLOPEN ;                Callback Self ;                Passing hoSQLStatement sEmpty ihdbc ;                Result ihstmt
11119>>>>>>>>>            
11119>>>>>>>>>            // If unsuccessful destroy hoSQLStatement
11119>>>>>>>>>            If (ihstmt = 0) Begin
11121>>>>>>>>>                Send DestroySQLStatement of hoSQLStatement
11122>>>>>>>>>                Move 0 to hoSQLStatement
11123>>>>>>>>>            End
11123>>>>>>>>>>
11123>>>>>>>>>            Else Begin
11124>>>>>>>>>                Send StoreStatementInfo of hoSQLStatement ihstmt sDrvrId ihdbc
11125>>>>>>>>>                
11125>>>>>>>>>                // Store DummyZeroDate of hoSQLConnection in hoSQLStatement
11125>>>>>>>>>                Get psDummyZeroDate              to sDummyZeroDate
11126>>>>>>>>>                Get psDummyZeroDateMssqlDatetime to sDummyZeroDateMssqlDatetime
11127>>>>>>>>>                
11127>>>>>>>>>                Set psDummyZeroDate              of hoSQLStatement to sDummyZeroDate
11128>>>>>>>>>                Set psDummyZeroDateMssqlDatetime of hoSQLStatement to sDummyZeroDateMssqlDatetime
11129>>>>>>>>>                
11129>>>>>>>>>            End
11129>>>>>>>>>>
11129>>>>>>>>>        End
11129>>>>>>>>>>
11129>>>>>>>>>        
11129>>>>>>>>>        Function_Return hoSQLStatement
11130>>>>>>>>>    End_Function
11131>>>>>>>>>    
11131>>>>>>>>>End_Class
11132>>>>>>>>>
11132>>>>>>>>>// Manager for embedded SQL handles.                           
11132>>>>>>>>>// We want to be able to use multiple drivers and multiple            
11132>>>>>>>>>// connections within a driver and multiple statements within a       
11132>>>>>>>>>// connection. To allow this we have placed our own handle logic on   
11132>>>>>>>>>// top of the driver handle logic. This way we can handle the         
11132>>>>>>>>>// situation where two driver handles may be equal.                   
11132>>>>>>>>>
11132>>>>>>>>>Class cSQLHandleManager is a cObject
11133>>>>>>>>>    
11133>>>>>>>>>    Procedure Construct_object
11135>>>>>>>>>        Forward Send Construct_object
11137>>>>>>>>>        
11137>>>>>>>>>        Property String  psDefaultDriver      ""
11138>>>>>>>>>        Property String  psDefaultConnection  ""
11139>>>>>>>>>        
11139>>>>>>>>>    End_Procedure
11140>>>>>>>>>    
11140>>>>>>>>>    // Create a cSQLConnection object
11140>>>>>>>>>    Function CreateSQLConnection Returns Handle
11142>>>>>>>>>        Handle hoSQLConnection
11142>>>>>>>>>        Get Create (RefClass(cSQLConnection)) to hoSQLConnection
11143>>>>>>>>>        Function_Return hoSQLConnection
11144>>>>>>>>>    End_Function
11145>>>>>>>>>    
11145>>>>>>>>>    
11145>>>>>>>>>    // Store default connection information
11145>>>>>>>>>    Procedure SQLSetConnect String sDriver String sConnect
11147>>>>>>>>>        Set psDefaultDriver      to sDriver
11148>>>>>>>>>        Set psDefaultConnection  to sConnect
11149>>>>>>>>>    End_Procedure
11150>>>>>>>>>    
11150>>>>>>>>>    
11150>>>>>>>>>    // Make a connection to an embedded SQL server
11150>>>>>>>>>    // Returns : The DataFlex handle to the connection
11150>>>>>>>>>    Function SQLConnect String sDrvrID String sConnect Returns Integer
11152>>>>>>>>>        Handle hoSQLConnection
11152>>>>>>>>>        Integer bOK
11152>>>>>>>>>        
11152>>>>>>>>>        // Check arguments
11152>>>>>>>>>        If (sDrvrID = "" and sConnect = "") Begin
11154>>>>>>>>>            Get psDefaultDriver      to sDrvrId
11155>>>>>>>>>            Get psDefaultConnection  to sConnect
11156>>>>>>>>>        End
11156>>>>>>>>>>
11156>>>>>>>>>        
11156>>>>>>>>>        // Create a cSQLConnection object
11156>>>>>>>>>        Get CreateSQLConnection to hoSQLConnection
11157>>>>>>>>>        // Connect to the database
11157>>>>>>>>>        Get SQLConnect of hoSQLConnection sDrvrID sConnect to bOK
11158>>>>>>>>>        
11158>>>>>>>>>        // If connection to the database failed, destroy the cSQLConnection object and return a 0 handle
11158>>>>>>>>>        If (not(bOK)) Begin
11160>>>>>>>>>            Send DestroySQLConnection of hoSQLConnection
11161>>>>>>>>>            Move 0 to hoSQLConnection
11162>>>>>>>>>        End
11162>>>>>>>>>>
11162>>>>>>>>>        
11162>>>>>>>>>        Function_Return hoSQLConnection
11163>>>>>>>>>    End_Function
11164>>>>>>>>>    
11164>>>>>>>>>    
11164>>>>>>>>>    
11164>>>>>>>>>    // Make an existing connection available for use with Embedded SQL.
11164>>>>>>>>>    // The connection is identified by the number of a file
11164>>>>>>>>>    // that is open for that connection.
11164>>>>>>>>>    Function SQLFileConnect Integer iFileNum Returns Handle
11166>>>>>>>>>        Handle hoSQLConnection
11166>>>>>>>>>        Integer bOK
11166>>>>>>>>>        
11166>>>>>>>>>        // Create a cSQLConnection object
11166>>>>>>>>>        Get CreateSQLConnection to hoSQLConnection
11167>>>>>>>>>        Get SQLFileConnect of hoSQLConnection iFileNum to bOK
11168>>>>>>>>>        
11168>>>>>>>>>        // If connection to the database failed, destroy the cSQLConnection object and return a 0 handle
11168>>>>>>>>>        If (not(bOK)) Begin
11170>>>>>>>>>            Send DestroySQLConnection of hoSQLConnection
11171>>>>>>>>>            Move 0 to hoSQLConnection
11172>>>>>>>>>        End
11172>>>>>>>>>>
11172>>>>>>>>>        
11172>>>>>>>>>        Function_Return hoSQLConnection
11173>>>>>>>>>    End_Function
11174>>>>>>>>>    
11174>>>>>>>>>    // Establish an embedded SQL connection that uses an existing connection from an earlier login or open.
11174>>>>>>>>>    // Existing connections are identified by there connectstring. (can be obtained with DF_DRIVER_SERVER_NAME attribute)
11174>>>>>>>>>    // If sConnectString exist in the list of existing connections, that connection will be used for embedded SQL.
11174>>>>>>>>>    // The connectstrings must be an exact match, but can be case insensitive
11174>>>>>>>>>    // If no matching connectstring is found, this function will return 0
11174>>>>>>>>>    // This function will only work with CLI connectivity kits 6.2 or later
11174>>>>>>>>>    Function SQLConnectionConnect String sDrvrID String sConnectString Returns Integer
11176>>>>>>>>>        Handle hoSQLConnection
11176>>>>>>>>>        Integer bOK
11176>>>>>>>>>        
11176>>>>>>>>>        // Check arguments
11176>>>>>>>>>        If (sDrvrID = "" and sConnectString = "") Begin
11178>>>>>>>>>            Get psDefaultDriver      to sDrvrId
11179>>>>>>>>>            Get psDefaultConnection  to sConnectString
11180>>>>>>>>>        End
11180>>>>>>>>>>
11180>>>>>>>>>        
11180>>>>>>>>>        // Create a cSQLConnection object
11180>>>>>>>>>        Get CreateSQLConnection to hoSQLConnection
11181>>>>>>>>>        // Connect to the database
11181>>>>>>>>>        Get SQLConnectionConnect of hoSQLConnection sDrvrID sConnectString to bOK
11182>>>>>>>>>        
11182>>>>>>>>>        // If connection to the database failed, destroy the cSQLConnection object and return a 0 handle
11182>>>>>>>>>        If (not(bOK)) Begin
11184>>>>>>>>>            Send DestroySQLConnection of hoSQLConnection
11185>>>>>>>>>            Move 0 to hoSQLConnection
11186>>>>>>>>>        End
11186>>>>>>>>>>
11186>>>>>>>>>        
11186>>>>>>>>>        Function_Return hoSQLConnection
11187>>>>>>>>>    End_Function
11188>>>>>>>>>    
11188>>>>>>>>>    
11188>>>>>>>>>End_Class

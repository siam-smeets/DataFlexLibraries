13575>>>>>>>>>>>    // This is the Error_Report for non AJAX style applications. This could be 
13575>>>>>>>>>>>    // Web Service, HTTP Handler, ASP or old style webapps. We've copied it here
13575>>>>>>>>>>>    // rather than trying to integrate it directly into Error_Report. It gets called by
13575>>>>>>>>>>>    // Error_Report as needed.
13575>>>>>>>>>>>    Procedure BasicErrorReport Integer iError Integer iLine String ErrMsg
13577>>>>>>>>>>>        String sSystemErr sMess sLabel sFile sDtl sFullError
13577>>>>>>>>>>>        String sStack sSystemAndStack
13577>>>>>>>>>>>        Integer iErrFile iErrField
13577>>>>>>>>>>>        Boolean bCritical bQueueErrors bLogAllErrors bLocal bHtmlErrors
13577>>>>>>>>>>>        Handle hoInetSession
13577>>>>>>>>>>>        Boolean bUnhandledSupport
13577>>>>>>>>>>>        Boolean bDebugging bTrapped
13577>>>>>>>>>>>        Integer iSrc iTxtlen
13577>>>>>>>>>>>        String sCaption
13577>>>>>>>>>>>
13577>>>>>>>>>>>        
13577>>>>>>>>>>>        Get phoInetSession to hoInetSession // this may or may not be set yet.
13578>>>>>>>>>>>        
13578>>>>>>>>>>>        Get IsCritical iError to bCritical
13579>>>>>>>>>>>        Get pbUnhandledErrorSupport to bUnhandledSupport
13580>>>>>>>>>>>        Move (IsDebuggerPresent()) to bDebugging
13581>>>>>>>>>>>        
13581>>>>>>>>>>>        // if an operator error this may be a Procedure UserError situation where the
13581>>>>>>>>>>>        // caption is passed in the error text. This handler does not support setting the caption so we just remove it.
13581>>>>>>>>>>>        // The ajax superclass handler will support this
13581>>>>>>>>>>>        If (iError=DFERR_OPERATOR) Begin
13583>>>>>>>>>>>            Move (pos(C_ErrorCaption,ErrMsg)) to iSrc
13584>>>>>>>>>>>            If iSrc Begin
13586>>>>>>>>>>>                Move (length(C_ErrorCaption)) to  iTxtLen
13587>>>>>>>>>>>                Move (remove(ErrMsg, 1, iSrc-1 + iTxtLen )) to sCaption // will not get used here
13588>>>>>>>>>>>                Move (Left(ErrMsg,iSrc-1)) to ErrMsg
13589>>>>>>>>>>>            End
13589>>>>>>>>>>>>
13589>>>>>>>>>>>        End
13589>>>>>>>>>>>>
13589>>>>>>>>>>>        
13589>>>>>>>>>>>        Get Error_Description iError ErrMsg  to sSystemErr
13590>>>>>>>>>>>        
13590>>>>>>>>>>>        // if the error source is identified we can get extended error
13590>>>>>>>>>>>        // text for our error message. This capability is a standard part
13590>>>>>>>>>>>        // of VDF5
13590>>>>>>>>>>>        If ghoErrorSource Begin
13592>>>>>>>>>>>            // These messages were just added to the DD.
13592>>>>>>>>>>>            Get Extended_Error_file   of ghoErrorSource to iErrFile
13593>>>>>>>>>>>            Get Extended_Error_Field  of ghoErrorSource to iErrField
13594>>>>>>>>>>>            // we are making the assumption that ghoErrorSource is a DD object
13594>>>>>>>>>>>            // If it is not, we will have problems.....but it will be!
13594>>>>>>>>>>>            If (iErrFile>0) Begin
13596>>>>>>>>>>>                Get_Attribute DF_FILE_DISPLAY_NAME of iErrFile to sFile
13599>>>>>>>>>>>                If (iErrField>0) Begin
13601>>>>>>>>>>>                    Get File_Field_Label of ghoErrorSource iErrFile iErrField DD_LABEL_LONG to sLabel
13602>>>>>>>>>>>                    Move (SFormat(C_$FieldInDataFile,sLabel, sFile)) to sMess
13603>>>>>>>>>>>                End
13603>>>>>>>>>>>>
13603>>>>>>>>>>>                Else Begin
13604>>>>>>>>>>>                    Move (SFormat(C_$InDataFile,sFile)) to sMess
13605>>>>>>>>>>>                End
13605>>>>>>>>>>>>
13605>>>>>>>>>>>                Append sSystemErr "\n" sMess
13607>>>>>>>>>>>            End
13607>>>>>>>>>>>>
13607>>>>>>>>>>>        End
13607>>>>>>>>>>>>
13607>>>>>>>>>>>        
13607>>>>>>>>>>>        Move (SFormat(C_$VDFErrorInLine, iError, iLine)) to sDtl
13608>>>>>>>>>>>        If (iErrFile  > 0) ;            Move (sDtl * DD_FILE_TEXT  * String(iErrFile))  to sDtl
13611>>>>>>>>>>>        If (iErrField > 0) ;            Move (sDtl * DD_FIELD_TEXT * String(iErrField)) to sDtl
13614>>>>>>>>>>>        // full error is systemError + Error and line numbers
13614>>>>>>>>>>>        Move (sSystemErr + "\n" + sDtl) to sFullError
13615>>>>>>>>>>>        
13615>>>>>>>>>>>        // If 0, the COM object is not yet ready to be used. If an error occurs in this
13615>>>>>>>>>>>        // condition, we consider this error to always be fatal and will notify WebApp
13615>>>>>>>>>>>        // Server of this error via WebAppFatalError command
13615>>>>>>>>>>>        If (hoInetSession=0) Begin
13617>>>>>>>>>>>            
13617>>>>>>>>>>>            If bDebugging Begin
13619>>>>>>>>>>>                Send UnhandledErrorDisplay iLine sFullError
13620>>>>>>>>>>>            End
13620>>>>>>>>>>>>
13620>>>>>>>>>>>            Else Begin
13621>>>>>>>>>>>                CallStackDump sStack
13622>>>>>>>>>>>                WebAppFatalError (Replaces("\n", (sFullError + "\n\n" + sStack) , character(13)+character(10)))
13623>>>>>>>>>>>                // we only arrive here if WebApp cannot handle the error. All we can
13623>>>>>>>>>>>                // do is abort.
13623>>>>>>>>>>>                //Send MessageBoxError sFullError 1 // might be useful for VDF debugging, but cannot be used on server
13623>>>>>>>>>>>            End
13623>>>>>>>>>>>>
13623>>>>>>>>>>>            Abort
13624>>>>>>>>>>>>
13624>>>>>>>>>>>        End
13624>>>>>>>>>>>>
13624>>>>>>>>>>>        Else Begin
13625>>>>>>>>>>>            
13625>>>>>>>>>>>            Get pbAllErrorstoLocal    of hoInetSession to bLocal
13626>>>>>>>>>>>            Get pbQueueErrors         of hoInetSession to bQueueErrors
13627>>>>>>>>>>>            Get pbAllErrorstoEventLog of hoInetSession to bLogAllErrors
13628>>>>>>>>>>>            Get pbAllErrorsToHtml     of hoInetSession to bHtmlErrors
13629>>>>>>>>>>>            
13629>>>>>>>>>>>            // If error is critical, we cannot go on.
13629>>>>>>>>>>>            If bCritical Begin
13631>>>>>>>>>>>                CallStackDump sStack
13632>>>>>>>>>>>                Move (Replaces(Character(13)+Character(10),sStack, "\n")) to sStack
13633>>>>>>>>>>>                Move (sSystemErr + "\n\n" + sStack) to sSystemAndStack
13634>>>>>>>>>>>                Send ReportCriticalError to hoInetSession iError (If(bUnhandledSupport, sSystemAndStack, sSystemErr)) iLine iErrFile iErrField
13635>>>>>>>>>>>                
13635>>>>>>>>>>>                // also attempt to send message to client (html browser)
13635>>>>>>>>>>>                If bHtmlErrors Begin
13637>>>>>>>>>>>                    // The option to disable stack dumps only makes sense if the developer is using html errors to report unhandled problems
13637>>>>>>>>>>>                    // and for some reason the stack dump will mess up existing applications. This seems very unlikely but we are providing
13637>>>>>>>>>>>                    // a way to disable this if needed via pbUnhandledSupport.
13637>>>>>>>>>>>                    Send ReportError to hoInetSession iError (If(bUnhandledSupport, sSystemAndStack, sSystemErr)) iLine iErrFile iErrField
13638>>>>>>>>>>>                End
13638>>>>>>>>>>>>
13638>>>>>>>>>>>                
13638>>>>>>>>>>>                // if we are passing errors to VDF console, report the error
13638>>>>>>>>>>>                // if we we debugging, thereis no point in doing this
13638>>>>>>>>>>>                If (not(bDebugging) and bLocal) Begin
13640>>>>>>>>>>>                    Send MessageBoxError (sFullError + "\n\n" + sStack) // 1 means critical
13641>>>>>>>>>>>                End
13641>>>>>>>>>>>>
13641>>>>>>>>>>>                
13641>>>>>>>>>>>                // log the critical error to the event log
13641>>>>>>>>>>>                // if debugging, this can be an unhandled error
13641>>>>>>>>>>>                If bDebugging Begin
13643>>>>>>>>>>>                    Send UnhandledErrorDisplay iLine sFullError
13644>>>>>>>>>>>                End
13644>>>>>>>>>>>>
13644>>>>>>>>>>>                Else Begin
13645>>>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack  iLine iErrFile iErrField
13646>>>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError C_$CriticalErrorProgramHalted iLine 0 0
13647>>>>>>>>>>>                End
13647>>>>>>>>>>>>
13647>>>>>>>>>>>                // and end it all
13647>>>>>>>>>>>                Abort
13648>>>>>>>>>>>>
13648>>>>>>>>>>>            End
13648>>>>>>>>>>>>
13648>>>>>>>>>>>            
13648>>>>>>>>>>>            // if we are passing errors to VDF console, report the error
13648>>>>>>>>>>>            If bLocal Begin
13650>>>>>>>>>>>                Send MessageBoxError sFullError 0 // 0 means non-critical
13651>>>>>>>>>>>            End
13651>>>>>>>>>>>>
13651>>>>>>>>>>>            
13651>>>>>>>>>>>            // we make the following assumptions:
13651>>>>>>>>>>>            // If errors are queue
13651>>>>>>>>>>>            //    We assume the error is expected, and controlled
13651>>>>>>>>>>>            //    Write error to queue
13651>>>>>>>>>>>            //    Ddo not write to Event Log unless we are logging all errors.
13651>>>>>>>>>>>            //
13651>>>>>>>>>>>            // if errors are not queued
13651>>>>>>>>>>>            //    We assume the error is unexpected, and must be controlled
13651>>>>>>>>>>>            //    Display HTML error to browser unless this is disabled
13651>>>>>>>>>>>            //    Send to the event log (under the assumption that the error is unexpected).
13651>>>>>>>>>>>            CallStackDump sStack
13652>>>>>>>>>>>            Move (Replaces(Character(13)+Character(10),sStack, "\n")) to sStack
13653>>>>>>>>>>>            Move (sSystemErr + "\n\n" + sStack) to sSystemAndStack
13654>>>>>>>>>>>                
13654>>>>>>>>>>>            If bQueueErrors Begin
13656>>>>>>>>>>>                Send Set_Error iError sSystemErr sFullError iLine iErrFile iErrField
13657>>>>>>>>>>>                If bLogAllErrors Begin
13659>>>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack iLine iErrFile iErrField
13660>>>>>>>>>>>                End
13660>>>>>>>>>>>>
13660>>>>>>>>>>>            End
13660>>>>>>>>>>>>
13660>>>>>>>>>>>            Else Begin
13661>>>>>>>>>>>                If bHtmlErrors Begin
13663>>>>>>>>>>>                    // The option to disable stack dumps only makes sense if the developer is using html errors to report unhandled problems
13663>>>>>>>>>>>                    // and for some reason the stack dump will mess up existing applications. This seems very unlikely but we are providing
13663>>>>>>>>>>>                    // a way to disable this if needed via pbUnhandledSupport.
13663>>>>>>>>>>>                    Send ReportError to hoInetSession iError (If(bUnhandledSupport, sSystemAndStack, sSystemErr)) iLine iErrFile iErrField
13664>>>>>>>>>>>                End
13664>>>>>>>>>>>>
13664>>>>>>>>>>>                If bDebugging  Begin
13666>>>>>>>>>>>                    Send UnhandledErrorDisplay iLine sFullError
13667>>>>>>>>>>>                End
13667>>>>>>>>>>>>
13667>>>>>>>>>>>                Else Begin
13668>>>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack iLine iErrFile iErrField
13669>>>>>>>>>>>                End
13669>>>>>>>>>>>>
13669>>>>>>>>>>>            End
13669>>>>>>>>>>>>
13669>>>>>>>>>>>        End
13669>>>>>>>>>>>>
13669>>>>>>>>>>>        
13669>>>>>>>>>>>        
13669>>>>>>>>>>>    End_Procedure
13670>>>>>>>>>>>
13670>>>>>>>>>>>    //  Is called by df on errors. It searches additional information and
13670>>>>>>>>>>>    //  saves the error. The main part of this is the error handler for AJAX framework
13670>>>>>>>>>>>    // applications If a basic or a legacy webapp, this Error is "forwarded" to BasicErrorReport.
13670>>>>>>>>>>>    //
13670>>>>>>>>>>>    Procedure HandleError Integer iErrNum Integer iErrLine String sErrText
13672>>>>>>>>>>>
13672>>>>>>>>>>>        Send BasicErrorReport iErrNum iErrLine sErrText
13673>>>>>>>>>>>        
13673>>>>>>>>>>>    End_Procedure
13674>>>>>>>>>>>    
13674>>>>>>>>>>>    
13674>>>>>>>>>>>    //
13674>>>>>>>>>>>    // These are all old style WebApp error interfaces that only exist for compatibility purposes
13674>>>>>>>>>>>    //    
13674>>>>>>>>>>>    Procedure ClearErrors
13676>>>>>>>>>>>        Send Delete_data of oErrorNumber
13677>>>>>>>>>>>        Send Delete_Data of oErrorText
13678>>>>>>>>>>>        Send Delete_Data of oFullErrorText
13679>>>>>>>>>>>        Send Delete_Data of oFileNr
13680>>>>>>>>>>>        Send Delete_Data of oFieldNr
13681>>>>>>>>>>>        Send Delete_Data of oLineNr
13682>>>>>>>>>>>    End_Procedure

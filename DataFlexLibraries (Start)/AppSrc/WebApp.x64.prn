844>>>>>>>>>
844>>>>>>>>>//     This function shows the error message for the system error codes
844>>>>>>>>>//     returned by GetLastError and returns the error code or NO_ERROR.
844>>>>>>>>>Function ShowLastError Global Returns Integer
846>>>>>>>>>    Integer iError iFlags iChars iResult
846>>>>>>>>>    Pointer pAddress
846>>>>>>>>>    WString sBuffer
846>>>>>>>>>    
846>>>>>>>>>    // Get the system error code
846>>>>>>>>>    Move (GetLastError()) to iError
847>>>>>>>>>    If (iError = NO_ERROR) ;        Function_Return NO_ERROR
850>>>>>>>>>    
850>>>>>>>>>    // Initialize pAddress, just to make sure AddressOf() works
850>>>>>>>>>    Move 0 to pAddress
851>>>>>>>>>    
851>>>>>>>>>    // Set the flags...
851>>>>>>>>>    Move (FORMAT_MESSAGE_ALLOCATE_BUFFER ior FORMAT_MESSAGE_FROM_SYSTEM ior FORMAT_MESSAGE_IGNORE_INSERTS) to iFlags
852>>>>>>>>>    
852>>>>>>>>>    // If FormatMessage fails iBytes will be 0, therefore no bytes will be copied and the error will only
852>>>>>>>>>    // display the error code returned from GetLastError...
852>>>>>>>>>    Move (FormatMessageW(iFlags,0,iError,0,AddressOf(pAddress),0,0)) to iChars
853>>>>>>>>>    
853>>>>>>>>>    // Allocate the buffer...
853>>>>>>>>>    Move (Repeat(Character(0),iChars)) to sBuffer
854>>>>>>>>>    If (iChars > 0) ;        Move (CopyMemory(AddressOf(sBuffer),pAddress,iChars * 2)) to iResult
857>>>>>>>>>    
857>>>>>>>>>    // Display the error code and message, if no message is available use 'No error text available'.
857>>>>>>>>>    If (Trim(sBuffer) = "") ;        Move C_$NoErrorTextAvailable to sBuffer
860>>>>>>>>>    Error DFERR_WINDOWS ("("+String(iError)+") "+sBuffer)
861>>>>>>>>>>
861>>>>>>>>>    
861>>>>>>>>>    // Free memory used by the buffer...
861>>>>>>>>>    Move (Free(pAddress)) to iResult
862>>>>>>>>>    Function_Return iError
863>>>>>>>>>End_Function
864>>>>>>>>>
864>>>>>>>>>//     global returns the size of the screen
864>>>>>>>>>// If eMode is 0 or no argument is passed, return actual screen size
864>>>>>>>>>// if eMode is 1, return workspace size. (adjusted for Taskbar)
864>>>>>>>>>Function GUIScreen_Size Global Integer eMode Returns Integer
866>>>>>>>>>    Integer iTop iLeft iRight iBottom bSuccess iHeight iWidth iSize
866>>>>>>>>>    String  sRect
866>>>>>>>>>    Pointer lpsRect
866>>>>>>>>>    // if no arguments passed or it is 0, get full screen.
866>>>>>>>>>    If (Num_arguments=0 or eMode=0) ;        Function_Return (GetSystemMetrics(SM_CYSCREEN)*65536 + ;        GetSystemMetrics(SM_CXSCREEN) )
869>>>>>>>>>    
869>>>>>>>>>    // This is a replacement for the GUIScreen_Size. The normal function uses the
869>>>>>>>>>    // GetSystemMetrics to get the workable screensize. The systemmetric API call doesn't
869>>>>>>>>>    // care about the size of your taskbar. The result of this is that panels that
869>>>>>>>>>    // are auto_located on your screen suddenly run off the screen even with plenty of
869>>>>>>>>>    // space around them.
869>>>>>>>>>    // (Contributed by Wil van Antwerpen)
869>>>>>>>>>    tWinRect Rect
869>>>>>>>>>    tWinRect Rect
869>>>>>>>>>    Move (SystemParametersInfo(SPI_GETWORKAREA, 0, AddressOf(Rect), 0)) to bSuccess
870>>>>>>>>>    If bSuccess Begin
872>>>>>>>>>        Move (rect.bottom - Rect.top) to iHeight
873>>>>>>>>>        Move (Rect.right - Rect.left) to iWidth
874>>>>>>>>>    End
874>>>>>>>>>>
874>>>>>>>>>    Function_Return  ((iHeight*65536) + iWidth)
875>>>>>>>>>    
875>>>>>>>>>End_Function
876>>>>>>>>>
876>>>>>>>>>// Convert String to Oem->Ansi or Ansi->Oem: Pass bToAnsi to determine convserion
876>>>>>>>>>// This will convert both DF Strings and C Strings (zero terminated). If passed a
876>>>>>>>>>// Cstring it will return a string with a terminating zero. If passed a DFstring
876>>>>>>>>>// the terminating zero is not returned.
876>>>>>>>>>// This function is used by ToAnsi and ToOEM. Developers are encouraged to use
876>>>>>>>>>// these two functions
876>>>>>>>>>
876>>>>>>>>>Function gConvertChar Global Integer bToAnsi String sString Returns String
878>>>>>>>>>    Pointer psString
878>>>>>>>>>    Integer iVoid bIsCString
878>>>>>>>>>    If (sString = "") ;        Function_Return sString
881>>>>>>>>>    
881>>>>>>>>>    Move (ascii(Right(sString,1))=0) to bIsCString
882>>>>>>>>>    If not bISCString ;        Append sString (character(0))
885>>>>>>>>>    Move (AddressOf(sString)) to psString
886>>>>>>>>>    If bToAnsi ;        Move (OEMToANSI(psString,psString)) to iVoid
889>>>>>>>>>    Else       ;        Move (ANSItoOEM(psString,psString)) to iVoid
891>>>>>>>>>    
891>>>>>>>>>    Function_Return (If(bIsCString, sString, cstring(sString)))
892>>>>>>>>>End_Function
893>>>>>>>>>
893>>>>>>>>>//    Convert OEM string to ANSI
893>>>>>>>>>//    Can be either DF string or zero terminated C style string
893>>>>>>>>>Function ToANSI Global String sString Returns String
895>>>>>>>>>    Function_Return (gConvertChar(1,sString))
896>>>>>>>>>End_Function
897>>>>>>>>>MARK$AS$OBSOLETEUNICODE Get ToANSI "Obsolete use of ToANSI, use Utf8ToAnsi or OemToUtf8 instead."
897>>>>>>>>>
897>>>>>>>>>//    Convert ANSI string to OEM
897>>>>>>>>>//    Can be either DF string or zero terminated C style string
897>>>>>>>>>Function ToOEM Global String sString Returns String
899>>>>>>>>>    Function_Return (gConvertChar(0,sString))
900>>>>>>>>>End_Function
901>>>>>>>>>MARK$AS$OBSOLETEUNICODE Get ToOEM "Obsolete use of ToOEM, use Utf8ToOem or AnsiToUtf8 instead."
901>>>>>>>>>
901>>>>>>>>>// Convert Passed info into an Ascii (ansi) character using the
901>>>>>>>>>// current regional style defined within windows.
901>>>>>>>>>//
901>>>>>>>>>// Pass:    Virtual Key, Shift key state, Capslock key state
901>>>>>>>>>// Return:  Ascii Char
901>>>>>>>>>Function To_Ascii Global Integer vKey Integer bShift Integer bCaps Returns Integer
903>>>>>>>>>    Integer iScan iChar
903>>>>>>>>>    Map_virtual_key vKey to iScan              // convert vkey to scan code
904>>>>>>>>>    Reset_key_Array                            // clear keyboard array
905>>>>>>>>>    Set_Key_Array vKey to ($80)                // Push VKey Down
906>>>>>>>>>    If bShift ;        Set_Key_Array VK_SHIFT to ($80)  // if shift, push shift key down
909>>>>>>>>>    If bCaps  ;        Set_Key_Array VK_CAPITAL to 1    // if Capslock, toggle capital key
912>>>>>>>>>    To_Ascii ((iScan*65536)+vkey) to iChar     // convert.
913>>>>>>>>>    Function_Return iChar
914>>>>>>>>>End_Function
915>>>>>>>>>
915>>>>>>>>>//    Get currency symbol from Windows, stop any "." from symbol
915>>>>>>>>>Function Default_Currency_Symbol Global Returns String
917>>>>>>>>>    WString sCurrency
917>>>>>>>>>    Pointer lpCurrency
917>>>>>>>>>    Integer iVal

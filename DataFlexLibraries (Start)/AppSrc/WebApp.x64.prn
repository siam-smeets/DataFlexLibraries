27938>>>>>>>    // helper for ClearConstrainFiles
27938>>>>>>>    Procedure ClearConstrainFile2 Handle hoDD
27940>>>>>>>        Handle hoDDNext
27940>>>>>>>        Integer iCount iMax
27940>>>>>>>        Set Visited_State of hoDD to True
27941>>>>>>>        // First process all server DDs
27941>>>>>>>        Get Data_Set_Server_Count of hoDD to iMax
27942>>>>>>>        For iCount from 0 to (iMax-1)
27948>>>>>>>>
27948>>>>>>>            Get Data_Set_Server of hoDD iCount to hoDDNext
27949>>>>>>>            If not (Visited_state(hoDDNext)) Begin
27951>>>>>>>                Send ClearConstrainFile2 hoDDNext
27952>>>>>>>            End
27952>>>>>>>>
27952>>>>>>>        Loop
27953>>>>>>>>
27953>>>>>>>        Set Constrain_File of hoDD to 0
27954>>>>>>>    End_Procedure
27955>>>>>>>
27955>>>>>>>    // clear all constrain files from the passed main DD on up.
27955>>>>>>>    Procedure ClearConstrainFiles Handle hoMainDD
27957>>>>>>>        If hoMainDD Begin
27959>>>>>>>            Send Initialize_Visited to hoMainDD False False // False=don't clear Column marks
27960>>>>>>>            Send ClearConstrainFile2 hoMainDD
27961>>>>>>>        End
27961>>>>>>>>
27961>>>>>>>    End_Procedure
27962>>>>>>>
27962>>>>>>>    // Returns the invokingobject when used in a drilldown
27962>>>>>>>    // NavigateFoward context. This should be an object within an invoking
27962>>>>>>>    // view or the invoking view. Often this would be the focus object when
27962>>>>>>>    // a prompt action is called.
27962>>>>>>>    Function GetInvokingObject Returns Handle 
27964>>>>>>>        Handle hoInvoker
27964>>>>>>>        String sInvoker
27964>>>>>>>        
27964>>>>>>>        Move C_WebUnresolvedObject to hoInvoker
27965>>>>>>>        
27965>>>>>>>        WebGet psInvokingObject to sInvoker
27966>>>>>>>        If (sInvoker <> "[NULL]") Begin
27968>>>>>>>            Get WebObjectByName sInvoker to hoInvoker
27969>>>>>>>        End
27969>>>>>>>>
27969>>>>>>>        
27969>>>>>>>        Function_Return hoInvoker        
27970>>>>>>>    End_Function
27971>>>>>>>
27971>>>>>>>    // Sets the invoking object for this view to hoInvokingObject.
27971>>>>>>>    Procedure SetInvokingObject Handle hoInvokingObject
27973>>>>>>>        Handle hoView
27973>>>>>>>        String sInvoker
27973>>>>>>>        
27973>>>>>>>        If (hoInvokingObject <> C_WebUnresolvedObject) Begin
27975>>>>>>>            Get WebObjectName of hoInvokingObject to sInvoker
27976>>>>>>>        End
27976>>>>>>>>
27976>>>>>>>        Else Begin
27977>>>>>>>            Move "[NULL]" to sInvoker
27978>>>>>>>        End
27978>>>>>>>>
27978>>>>>>>        
27978>>>>>>>        WebSet psInvokingObject to sInvoker
27979>>>>>>>    End_Procedure
27980>>>>>>>    
27980>>>>>>>    // Unconditionally navigate back to this view.
27980>>>>>>>    // We assume any data-loss checking has been done (if not, it's too late)
27980>>>>>>>    // If bCancel is true this is a Cancel operation (NavigateCancel), else a Close operation (NavigateClose)
27980>>>>>>>    // If a Close a callback, can and should be passed to update the NavigateData data before processing the close.
27980>>>>>>>    // This can be called when this view is not synched, in which case you should not trust the
27980>>>>>>>    // data or the web properties.
27980>>>>>>>    Procedure NavigateBackToHere Boolean bCancel Handle hoCallback
27982>>>>>>>        Handle hoTopView hoInvokingView
27982>>>>>>>        tWebValueTree tVT
27982>>>>>>>        tWebValueTree tVT
27982>>>>>>>        tWebNavigateData NavigateData
27982>>>>>>>        tWebNavigateData NavigateData
27982>>>>>>>        String[] aParams
27983>>>>>>>        
27983>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView   // handle to the current top of view
27984>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoInvokingView // 2nd to top
27985>>>>>>>        
27985>>>>>>>        
27985>>>>>>>        If (not(bCancel) and hoCallback <> 0) Begin
27987>>>>>>>            // Get NavigateData from the view that is being closed
27987>>>>>>>            // start with the NavigateData from the view being closed
27987>>>>>>>            Get GetNavigateData of hoTopView to NavigateData
27988>>>>>>>            // if we are not going back to the invoking view this means you are jumping back several 
27988>>>>>>>            // breadcrumb items. The navigate type is always undefined and it is up to the developer to
27988>>>>>>>            // decide what to do with the returned data in OnNavigateBack
27988>>>>>>>            If (Self <> hoInvokingView) Begin
27990>>>>>>>                Move nfUndefined to NavigateData.eNavigateType
27991>>>>>>>            End
27991>>>>>>>>
27991>>>>>>>            Send GetNavigateBackData to hoCallback Self (&NavigateData)
27992>>>>>>>        End
27992>>>>>>>>
27992>>>>>>>        
27992>>>>>>>        // if we are the invoking object, both the top object and invoking are synched and we can proceed directly
27992>>>>>>>        // or if we are performing a cancel the extra round trip would have no real meaning
27992>>>>>>>        If (bCancel or Self = hoInvokingView) Begin
27994>>>>>>>            Send NavigateBackToHereExec (&NavigateData) bCancel hoCallback
27995>>>>>>>        End
27995>>>>>>>>
27995>>>>>>>        Else Begin
27996>>>>>>>            //  Navigating back multiple levels means that we need another round trip as the view we are navigating towards is nto synchronized
27996>>>>>>>                        
27996>>>>>>>            Move bCancel to aParams[0]
27997>>>>>>>            
27997>>>>>>>            //  Because "" indicates the WebApp object we have an extra boolean indicating if there actually is a callback object
27997>>>>>>>            If (hoCallback > 0) Begin
27999>>>>>>>                Move True to aParams[1]
28000>>>>>>>                Get WebObjectName of hoCallback to aParams[2]
28001>>>>>>>            End
28001>>>>>>>>
28001>>>>>>>            Else Begin
28002>>>>>>>                Move False to aParams[1]
28003>>>>>>>                Move "" to aParams[2]
28004>>>>>>>            End
28004>>>>>>>>
28004>>>>>>>            
28004>>>>>>>            ValueTreeSerializeParameter NavigateData to tVT
28005>>>>>>>            
28005>>>>>>>            //  Perform client action that will call NavigateBackToHere_Callback
28005>>>>>>>            Send ClientAction "navigateBackToHere" aParams tVT
28006>>>>>>>        End
28006>>>>>>>>
28006>>>>>>>        
28006>>>>>>>    End_Procedure
28007>>>>>>>
28007>>>>>>>    //  Actually performs the navigateBackToHere operation, either called directly or asynchronously
28007>>>>>>>    //  by NavigateBackToHere_Callback.
28007>>>>>>>    Procedure NavigateBackToHereExec tWebNavigateData ByRef NavigateData Boolean bCancel Handle hoCallback
28009>>>>>>>        Handle hoTopView 
28009>>>>>>>        Handle hoDD hoMainDD hoTarget hoInvokingObject hoInvokingObjectDD hoInvokingView hoNextView
28009>>>>>>>        String psInvoker sTitle sStateHash
28009>>>>>>>        Integer eViewType eTopViewStyle eViewStyle
28009>>>>>>>        RowID ri
28009>>>>>>>        Boolean bParentLookup bOverrideViewState
28009>>>>>>>        Integer iConstrainingFile eRefindError
28009>>>>>>>        Handle hoConstrainingParent hoRefindError
28009>>>>>>>        RowID riConstrainingParent
28009>>>>>>>        Boolean bSuccess
28009>>>>>>>        
28009>>>>>>>        //  Indicate that we are navigating
28009>>>>>>>        Set pbNavigating to True
28010>>>>>>>        
28010>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView   // handle to the current top of view
28011>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoInvokingView // 2nd to top
28012>>>>>>>        
28012>>>>>>>        If (hoTopView = Self) Begin
28014>>>>>>>            Error DFERR_PROGRAM "NavigateBackToHere is already the top of the stack"
28015>>>>>>>>
28015>>>>>>>        End
28015>>>>>>>>
28015>>>>>>>        
28015>>>>>>>        Get NextViewHandleByView of (ViewStack(Self)) Self to hoNextView
28016>>>>>>>        Get GetInvokingObject of hoNextView to hoInvokingObject 
28017>>>>>>>        
28017>>>>>>>        Get peWebViewStyle to eViewStyle
28018>>>>>>>        Get peWebViewStyle of hoTopView to eTopViewStyle       
28019>>>>>>>        
28019>>>>>>>        // send ShowView directly (this shows the view without clearing the 
28019>>>>>>>        // entire viewstack)
28019>>>>>>>        Get pbOverrideStateOnShow to bOverrideViewState
28020>>>>>>>        Set pbOverrideStateOnShow to False
28021>>>>>>>        // if we navigate from a regular drill down view to a dialog we need to perform some more logic
28021>>>>>>>        If (eTopViewStyle = wvsDrillDown and eViewStyle = wvsDialog) Begin
28023>>>>>>>            Send RestoreDialog
28024>>>>>>>        End
28024>>>>>>>>
28024>>>>>>>        Else Begin
28025>>>>>>>            Send ShowView to (Host(Self)) Self 
28026>>>>>>>        End
28026>>>>>>>>
28026>>>>>>>        
28026>>>>>>>        Set pbOverrideStateOnShow to bOverrideViewState
28027>>>>>>>        // pop all unwanted views off the stack...
28027>>>>>>>        Send PopDownToView of (ViewStack(Self)) Self
28028>>>>>>>        Send UpdateInvokingViewDrillDownStyle
28029>>>>>>>
28029>>>>>>>        
28029>>>>>>>        // In this case we need to consider what to do with the data that
28029>>>>>>>        // is passed back from the previous top view.
28029>>>>>>>        Get peViewType to eViewType
28030>>>>>>>        Get Main_DD to hoMainDD  
28031>>>>>>>        
28031>>>>>>>        If hoMainDD Begin
28033>>>>>>>            Send Refind_Records of hoMainDD
28034>>>>>>>        End
28034>>>>>>>>
28034>>>>>>>
28034>>>>>>>        // if a close / update 
28034>>>>>>>        If (not(bCancel) and hoCallback <> 0) Begin
28036>>>>>>>
28036>>>>>>>            // if navigate from was relational (child, parent or main) we can do refinding
28036>>>>>>>            If (NavigateData.eNavigateType = nfFromChild or NavigateData.eNavigateType = nfFromMain or NavigateData.eNavigateType = nfFromParent) Begin
28038>>>>>>>                Get FindDDOForTable NavigateData.iTable to hoDD
28039>>>>>>>                If hoDD Begin
28041>>>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to ri
28042>>>>>>>                    
28042>>>>>>>                    If (eViewType = vtZoom) Begin
28044>>>>>>>                        // This will force constrained parents to update if appropriate
28044>>>>>>>                        
28044>>>>>>>                        // Use the DD of the invoking object as our starting point 
28044>>>>>>>                        If hoInvokingObject Begin
28046>>>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
28047>>>>>>>                        End
28047>>>>>>>>
28047>>>>>>>                        // if no server (unlikely) use the view's main dd 
28047>>>>>>>                        If not (hoInvokingObjectDD) Begin
28049>>>>>>>                            Get Main_DD to hoInvokingObjectDD        
28050>>>>>>>                        End
28050>>>>>>>>
28050>>>>>>>                        If (hoInvokingObjectDD) Begin
28052>>>>>>>                            // assume a parent DD is a parent lookup. If so, we don't update
28052>>>>>>>                            // the rest of the view. If not a lookup, do a clear_all so the
28052>>>>>>>                            // findbyrowid updates all deos 
28052>>>>>>>                            // which_data_Set only searches up.
28052>>>>>>>                            Get Which_Data_Set of hoInvokingObjectDD NavigateData.iTable to hoTarget
28053>>>>>>>                            Move (hoTarget and hoTarget<>hoInvokingObjectDD) to bParentLookup
28054>>>>>>>                            If not bParentLookup Begin
28056>>>>>>>                                // if constrained we will need to constraining parent
28056>>>>>>>                                // DD and row in case this is a null child RowId
28056>>>>>>>                                Get Constrain_File of hoDD to iConstrainingFile
28057>>>>>>>                                If (iConstrainingFile) Begin
28059>>>>>>>                                    Get Which_Data_Set of hoDD iConstrainingFile to hoConstrainingParent
28060>>>>>>>                                    If hoConstrainingParent Begin
28062>>>>>>>                                        Get CurrentRowId of hoConstrainingParent to riConstrainingParent
28063>>>>>>>                                    End
28063>>>>>>>>
28063>>>>>>>                                End
28063>>>>>>>>
28063>>>>>>>                                Send Clear_All of hoDD
28064>>>>>>>                                If (IsNullRowID(ri) and hoConstrainingParent) Begin
28066>>>>>>>                                    Get FindByRowIdEx of hoConstrainingParent iConstrainingFile riConstrainingParent to bSuccess
28067>>>>>>>                                    If not bSuccess Begin
28069>>>>>>>                                        // this is quite unlikely
28069>>>>>>>                                        // This is kind of complex because it means that the constraining parent cannot be
28069>>>>>>>                                        // reloaded. In such a case you probably should not be in the view at all and
28069>>>>>>>                                        // should navigate back
28069>>>>>>>                                        Move hoDD to hoRefindError
28070>>>>>>>                                        Move retCannotRereadConstrainingParent to eRefindError
28071>>>>>>>                                    End
28071>>>>>>>>
28071>>>>>>>                                End
28071>>>>>>>>
28071>>>>>>>                            End
28071>>>>>>>>
28071>>>>>>>                        End
28071>>>>>>>>
28071>>>>>>>                        If (hoRefindError=0) Begin
28073>>>>>>>                            If (IsNullRowID(ri)) Begin
28075>>>>>>>                                // Assume Create New Record
28075>>>>>>>                                Send Clear to hoDD
28076>>>>>>>                            End
28076>>>>>>>>
28076>>>>>>>                            Else Begin
28077>>>>>>>                                // Load up the selected rowID
28077>>>>>>>                                Get FindByRowIdEx of hoDD NavigateData.iTable ri to bSuccess
28078>>>>>>>                                If not bSuccess Begin
28080>>>>>>>                                    // this is quite unlikely
28080>>>>>>>                                    Send Clear of hoDD // this will leave the zoom cleared
28081>>>>>>>                                    Move hoDD to hoRefindError
28082>>>>>>>                                    Move retCannotRereadMain to eRefindError
28083>>>>>>>                                End
28083>>>>>>>>
28083>>>>>>>                            End
28083>>>>>>>>
28083>>>>>>>                        End
28083>>>>>>>>
28083>>>>>>>                    End
28083>>>>>>>>
28083>>>>>>>                    // else... if vtSelect the test below will catch this for any non cancel
28083>>>>>>>                    //         vtSelect. That way we catch hoDD=0 cases and nfundefined.
28083>>>>>>>                End
28083>>>>>>>>
28083>>>>>>>            End
28083>>>>>>>>
28083>>>>>>>
28083>>>>>>>            // This handles all select and weblist closes.        
28083>>>>>>>            // We do this for all view types because a zoom might contain a list
28083>>>>>>>            // If there is a missing hoDD or ri is null it will do a refresh of whatever
28083>>>>>>>            // is in the DD. If there is a rowid, it will refind around that.
28083>>>>>>>            Broadcast Recursive Send RefreshListForBackNavigation bCancel hoDD ri
28085>>>>>>>            
28085>>>>>>>        End
28085>>>>>>>>
28085>>>>>>>        // cancel
28085>>>>>>>        Else Begin
28086>>>>>>>            
28086>>>>>>>            // case of a cancel going back one level
28086>>>>>>>            If (Self = hoInvokingView) Begin
28088>>>>>>>                // This handles all select and weblist cancels.        
28088>>>>>>>                // We do this for all view types because a zoom might contain a list
28088>>>>>>>                Broadcast Recursive Send RefreshListForBackNavigation bCancel 0 (NullRowID())
28090>>>>>>>            End
28090>>>>>>>>
28090>>>>>>>            // if going back multiple levels, we don't do an update on the list because the list is not in scope. 
28090>>>>>>>            // Currently we are choosing not to  incur the overhead of extra roundtrip for a multi-level cancel.
28090>>>>>>>        End
28090>>>>>>>>
28090>>>>>>>            
28090>>>>>>>        
28090>>>>>>>        If hoInvokingObject Begin
28092>>>>>>>            Send ConditionalFocus of hoInvokingObject
28093>>>>>>>        End            
28093>>>>>>>>
28093>>>>>>>
28093>>>>>>>        //  Update the URL      
28093>>>>>>>        Send UpdateStateHash False
28094>>>>>>>        Send UpdatePageTitle
28095>>>>>>>        
28095>>>>>>>        //  We are done navigating now
28095>>>>>>>        Set pbNavigating to False
28096>>>>>>>
28096>>>>>>>        If (hoRefindError) Begin
28098>>>>>>>            // last thing that happens, you can do whatever
28098>>>>>>>            Send OnNavigateBackRefindError hoConstrainingParent eRefindError
28099>>>>>>>        End
28099>>>>>>>>
28099>>>>>>>        Else If (not(bCancel)) Begin
28102>>>>>>>        
28102>>>>>>>            // this is the object within the invoking view that called this
28102>>>>>>>            If (hoInvokingObject and hoCallback) Begin
28104>>>>>>>                // We are now the focus. You can use this to customize the update
28104>>>>>>>                // of to do another navigation 
28104>>>>>>>                Send OnNavigateBack of hoInvokingObject hoCallback NavigateData
28105>>>>>>>            End
28105>>>>>>>>
28105>>>>>>>        End
28105>>>>>>>>
28105>>>>>>>    End_Procedure
28106>>>>>>>    
28106>>>>>>>    //  Published procedure called by the client when it gets the navigateToClient client-action. 
28106>>>>>>>    //  This is done when navigating back multiple levels and the view we are navigating too was 
28106>>>>>>>    //  not synchronized. When this procedure is called the current view and the top view are both
28106>>>>>>>    //  being synchronized.
28106>>>>>>>    Procedure NavigateBackToHere_Callback Boolean bCancel Boolean bCallback String sCallback
28108>>>>>>>        tWebValueTree VT
28108>>>>>>>        tWebValueTree VT
28108>>>>>>>        tWebNavigateData NavigateData
28108>>>>>>>        tWebNavigateData NavigateData
28108>>>>>>>        Handle hoCallback
28108>>>>>>>        
28108>>>>>>>        Get ptActionData to VT
28109>>>>>>>        ValueTreeDeserializeParameter VT to NavigateData
28110>>>>>>>        
28110>>>>>>>        If (bCallback) Begin
28112>>>>>>>            Get WebObjectByName sCallback to hoCallback
28113>>>>>>>        End
28113>>>>>>>>
28113>>>>>>>        
28113>>>>>>>        Send NavigateBackToHereExec NavigateData bCancel hoCallback
28114>>>>>>>        
28114>>>>>>>    End_Procedure
28115>>>>>>>    
28115>>>>>>>    // determine the navigateFrom type based on the view being activated (self) and the
28115>>>>>>>    // invoking view and object (passed)
28115>>>>>>>    Function DetermineNavigateFromType Handle hoInvokingView Handle hoInvokingObject Handle ByRef iNavigateFile Returns Integer
28117>>>>>>>        Handle hoInvokingDD hoMainDD hoDDO
28117>>>>>>>        Integer iInvokingFile iMainFile
28117>>>>>>>        Integer iServers iServer iServerFile
28117>>>>>>>        Boolean bDataBindable
28117>>>>>>>        Move 0 to iNavigateFile
28118>>>>>>>        
28118>>>>>>>        If (hoInvokingView) Begin
28120>>>>>>>            
28120>>>>>>>            If (hoInvokingObject) Begin
28122>>>>>>>                Get Server of hoInvokingObject to hoInvokingDD
28123>>>>>>>            End
28123>>>>>>>>
28123>>>>>>>            Else Begin
28124>>>>>>>                Get Server of hoInvokingView to hoInvokingDD
28125>>>>>>>            End
28125>>>>>>>>
28125>>>>>>>            
28125>>>>>>>            Get Server to hoMainDD
28126>>>>>>>            
28126>>>>>>>            If (hoInvokingDD and hoMainDD) Begin
28128>>>>>>>                Get Main_File of hoInvokingDD to iInvokingFile
28129>>>>>>>                Get Main_File of hoMainDD to iMainFile
28130>>>>>>>                
28130>>>>>>>                If (iInvokingFile = iMainFile) Begin
28132>>>>>>>                    Move iMainFile to iNavigateFile
28133>>>>>>>                    Function_Return nfFromMain
28134>>>>>>>                End
28134>>>>>>>>
28134>>>>>>>                Else If ( Which_Data_Set(hoInvokingDD, iMainFile)) Begin
28137>>>>>>>                    Move iMainFile to iNavigateFile
28138>>>>>>>                    Function_Return nfFromChild
28139>>>>>>>                End
28139>>>>>>>>
28139>>>>>>>                Else Begin
28140>>>>>>>                    Get Data_Set_Server_Count of hoMainDD to iServers
28141>>>>>>>                    For iServer from 0 to (iServers-1)
28147>>>>>>>>
28147>>>>>>>                        Get Data_Set_Server of hoMainDD iServer to hoDDO
28148>>>>>>>                        Get Main_File of hoDDO to iServerFile
28149>>>>>>>                        If (iInvokingFile = iServerFile) Begin
28151>>>>>>>                            Move iInvokingFile to iNavigateFile
28152>>>>>>>                            Function_Return nfFromParent
28153>>>>>>>                        End
28153>>>>>>>>
28153>>>>>>>                    Loop
28154>>>>>>>>
28154>>>>>>>                End
28154>>>>>>>>
28154>>>>>>>            End
28154>>>>>>>>
28154>>>>>>>        End
28154>>>>>>>>
28154>>>>>>>        Function_Return nfUndefined
28155>>>>>>>    End_Function
28156>>>>>>>    
28156>>>>>>>    // Send this to navigate to the target view and add it to the view stack.
28156>>>>>>>    //
28156>>>>>>>    // eNavigateType - The Navigate From Type (i.e. nfFromMain, nfFromParent, etc)
28156>>>>>>>    // hoInvokingObject - This is the control in the "from view" that will populate the Navigate Data.
28156>>>>>>>    //                    The navigate data describes the role this view will play. Typically you will
28156>>>>>>>    //                    pass the object handle of the control that called NavigateForward.
28156>>>>>>>    //                    This control must understand the GetNavigateForwardData callback message.
28156>>>>>>>    Procedure NavigateForward Handle hoInvokingObject
28158>>>>>>>        Handle hoInvokingView hoTestInvokingObject
28158>>>>>>>        tWebNavigateData NavigateData
28158>>>>>>>        tWebNavigateData NavigateData
28158>>>>>>>        Integer iExpectedTable eNavigateType// eAppStateMode eTestNavType iTestTable
28158>>>>>>>        
28158>>>>>>>        // temporary for conversion. This will raise an error for older style NavigateFoward
28158>>>>>>>        // which passed two arguments. 
28158>>>>>>>        If (num_arguments<>1) Begin
28160>>>>>>>            Error DFERR_PROGRAM "NavigateForward has wrong number of parameters. Probably old style call"
28161>>>>>>>>
28161>>>>>>>            Procedure_Return
28162>>>>>>>        End
28162>>>>>>>>
28162>>>>>>>        
28162>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" initStateDefault to NavigateData.NamedValues
28163>>>>>>>        
28163>>>>>>>        Send NavigateForward2 hoInvokingObject NavigateData ntNavigateForward
28164>>>>>>>    End_Procedure
28165>>>>>>>
28165>>>>>>>    // Just like NavigateForward but it always makes this an nfUndefined navigation. This provides a way
28165>>>>>>>    // for developers to perform a custom forward navigation (nfUndefined) when the natural navigation would be
28165>>>>>>>    // some other navigation. When doing a custom navigation, the only option is nfUndefined because allowing a 
28165>>>>>>>    // developer to assign any other navigate-from type when it is not what is expected will probably not work.
28165>>>>>>>    // Note that the NavigateData data can be further customized in OnGetNavigateForwardData
28165>>>>>>>    // this is for advanced use - normally NavigateForward is used.
28165>>>>>>>    Procedure NavigateForwardCustom Handle hoInvokingObject
28167>>>>>>>        tWebNavigateData NavigateData
28167>>>>>>>        tWebNavigateData NavigateData
28167>>>>>>>        
28167>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" initStateDefault to NavigateData.NamedValues
28168>>>>>>>        
28168>>>>>>>        Send NavigateForward2 hoInvokingObject NavigateData ntNavigateForwardCustom
28169>>>>>>>    End_Procedure
28170>>>>>>>    
28170>>>>>>>    
28170>>>>>>>    // Navigates into this view when restoring a state. This means that most likely the view will 
28170>>>>>>>    // not be shown but is just initialzed to correct the view stack. The view will be loaded to 
28170>>>>>>>    // the client asynchronously to optimize performance.
28170>>>>>>>    //
28170>>>>>>>    // Params:
28170>>>>>>>    //      bTopView    If true this is the topmost view that will be displayed.
28170>>>>>>>    //      sMainId     Record ID of the main DD (from the state hash).
28170>>>>>>>    //      sStateHash  The full state hash for this view.
28170>>>>>>>    // Returns:
28170>>>>>>>    //      False if the main ID is not a valid record.
28170>>>>>>>    Function NavigateInitialize Handle hoInvokingObject Boolean bTopView String sStateHash Integer eNavMode Returns Boolean
28172>>>>>>>        tWebNavigateData NavigateData
28172>>>>>>>        tWebNavigateData NavigateData
28172>>>>>>>        Handle hoInvokingView hoMainDD
28172>>>>>>>        RowID rRowId
28172>>>>>>>        Boolean bFound bSuccess bIsDynamic
28172>>>>>>>        
28172>>>>>>>        
28172>>>>>>>        // Add extra properties used during initialization
28172>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" (If(bTopView, initStateReinitializeTopView, initStateReinitialize)) to NavigateData.NamedValues
28173>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_StateHash" sStateHash to NavigateData.NamedValues
28174>>>>>>>        
28174>>>>>>>        // Get into the standard initialization
28174>>>>>>>        Set pbNavReinitError to False
28175>>>>>>>        Send NavigateForward2 hoInvokingObject NavigateData eNavMode
28176>>>>>>>        Get pbNavReinitError to bSuccess
28177>>>>>>>        Move (not(bSuccess)) to bSuccess
28178>>>>>>>        
28178>>>>>>>        Function_Return bSuccess
28179>>>>>>>    End_Function
28180>>>>>>>    
28180>>>>>>>    // Reads the record id from the statehash and puts it in the NavigateData struct, this is called during 
28180>>>>>>>    // the forward navigation (only for NavigateInitialize).
28180>>>>>>>    //
28180>>>>>>>    // Params:
28180>>>>>>>    //      NavigateData    Byreference navigationdata struct (so it can be altered).
28180>>>>>>>    Procedure NavigateInitializeUpdateRowId tWebNavigateData ByRef NavigateData
28182>>>>>>>        String sHash sMainId sView sCustom
28182>>>>>>>        Integer eStateMode iTable
28182>>>>>>>        Handle hoMainDD
28182>>>>>>>        RowID rRowID
28182>>>>>>>        Boolean bSuccess
28182>>>>>>>        
28182>>>>>>>        Get peStateMode to eStateMode
28183>>>>>>>        Get Main_DD to hoMainDD
28184>>>>>>>        
28184>>>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_StateHash" to sHash
28185>>>>>>>        Send ParseViewStateHash of (Host(Self)) sHash (&sView) (&sMainId) (&sCustom)
28186>>>>>>>        
28186>>>>>>>        // Set rowid from the state hash
28186>>>>>>>        If ((peViewType(Self) = vtZoom and eStateMode = vsmDefault) or eStateMode = vsmRecord) Begin
28188>>>>>>>            If (hoMainDD <> 0) Begin
28190>>>>>>>                Move (Main_File(hoMainDD)) to iTable
28191>>>>>>>                Get HashRecordIdToRowId iTable sMainId (&rRowId) to bSuccess
28192>>>>>>>                If (bSuccess) Begin
28194>>>>>>>                    Move (SerializeRowID(rRowId)) to NavigateData.sRowID
28195>>>>>>>                    Move iTable to  NavigateData.iTable
28196>>>>>>>                    Move False to NavigateData.bNewRecord
28197>>>>>>>                End
28197>>>>>>>>
28197>>>>>>>                Else Begin
28198>>>>>>>                    Set pbNavReinitError to True
28199>>>>>>>                    If (pbStateHashInvalidError(Host(Self))) Begin
28201>>>>>>>                        Error DFERR_WEBAPP_INVALID_URL_REC
28202>>>>>>>>
28202>>>>>>>                    End
28202>>>>>>>>
28202>>>>>>>                End
28202>>>>>>>>
28202>>>>>>>            End
28202>>>>>>>>
28202>>>>>>>        End
28202>>>>>>>>
28202>>>>>>>        Else If (eStateMode = vsmDefault) Begin
28205>>>>>>>            If (NavigateData.iTable > 0) Begin
28207>>>>>>>                Get HashRecordIdToRowId NavigateData.iTable sMainId (&rRowId) to bSuccess
28208>>>>>>>                If (bSuccess) Begin
28210>>>>>>>                    Move (SerializeRowID(rRowId)) to NavigateData.sRowID
28211>>>>>>>                End
28211>>>>>>>>
28211>>>>>>>                Else Begin
28212>>>>>>>                    Set pbNavReinitError to True
28213>>>>>>>                    If (pbStateHashInvalidError(Host(Self))) Begin
28215>>>>>>>                        Error DFERR_WEBAPP_INVALID_URL_REC
28216>>>>>>>>
28216>>>>>>>                    End
28216>>>>>>>>
28216>>>>>>>                End
28216>>>>>>>>
28216>>>>>>>            End
28216>>>>>>>>
28216>>>>>>>        End
28216>>>>>>>>
28216>>>>>>>    End_Procedure
28217>>>>>>>    
28217>>>>>>>    // Determines if this view needs to be reininitialized when restoring the state looking at the
28217>>>>>>>    // record id.
28217>>>>>>>    //
28217>>>>>>>    // Params:
28217>>>>>>>    //      sExpectedMainId     Record ID of the main table navigation table to compare to record buffer.
28217>>>>>>>    Function NeedReinitialize String sExpectedMainId Returns Boolean
28219>>>>>>>        tWebNavigateData navData
28219>>>>>>>        tWebNavigateData navData
28219>>>>>>>        Integer eStateMode
28219>>>>>>>        Handle hoMainDD
28219>>>>>>>        RowID rRowId
28219>>>>>>>        Boolean bValid
28219>>>>>>>        
28219>>>>>>>        Get peStateMode to eStateMode
28220>>>>>>>        Get Main_DD to hoMainDD
28221>>>>>>>        
28221>>>>>>>        If ((peViewType(Self) = vtZoom and eStateMode = vsmDefault) or eStateMode = vsmRecord) Begin
28223>>>>>>>            Get GetNavigateData to navData
28224>>>>>>>            
28224>>>>>>>            If (hoMainDD <> 0) Begin
28226>>>>>>>                If (sExpectedMainId <> "" ) Begin    
28228>>>>>>>                    Get HashRecordIdToRowId (navData.iTable) sExpectedMainId (&rRowId) to bValid
28229>>>>>>>                    If (bValid and IsSameRowID(rRowId, CurrentRowId(hoMainDD))) Begin
28231>>>>>>>                        Function_Return False
28232>>>>>>>                    End
28232>>>>>>>>
28232>>>>>>>                End
28232>>>>>>>>
28232>>>>>>>                Else If (navData.bNewRecord and not(HasRecord(hoMainDD))) Begin
28235>>>>>>>                    Function_Return False
28236>>>>>>>                End
28236>>>>>>>>
28236>>>>>>>            End
28236>>>>>>>>
28236>>>>>>>            Else Begin
28237>>>>>>>                Function_Return False
28238>>>>>>>            End
28238>>>>>>>>
28238>>>>>>>        End
28238>>>>>>>>
28238>>>>>>>        Else If (eStateMode = vsmDefault) Begin
28241>>>>>>>            Get GetNavigateData to navData
28242>>>>>>>            
28242>>>>>>>            If (navData.iTable > 0) Begin
28244>>>>>>>                Get HashRecordIdToRowId (navData.iTable) sExpectedMainId (&rRowId) to bValid
28245>>>>>>>                If (bValid and navData.sRowID = SerializeRowID(rRowId)) Begin
28247>>>>>>>                    Function_Return False
28248>>>>>>>                End
28248>>>>>>>>
28248>>>>>>>            End
28248>>>>>>>>
28248>>>>>>>            
28248>>>>>>>            If (navData.eNavigateType = nfUndefined) Begin
28250>>>>>>>                Function_Return False
28251>>>>>>>            End
28251>>>>>>>>
28251>>>>>>>        End
28251>>>>>>>>
28251>>>>>>>        
28251>>>>>>>        Function_Return True
28252>>>>>>>    End_Function
28253>>>>>>>
28253>>>>>>>    // Called back by the LoadViewCallBack procedure that makes sure that the view is actually in 
28253>>>>>>>    // sync (by going back to the client and optionally loading it).
28253>>>>>>>    Procedure NavigateForward_CallBack
28255>>>>>>>        Send NavigateForwardFinish
28256>>>>>>>    End_Procedure
28257>>>>>>>
28257>>>>>>>    // called by NavigateForward and NavigateForwardCustom only 
28257>>>>>>>    Procedure NavigateForward2 Handle hoInvokingObject tWebNavigateData NavigateData Integer eNavMode
28259>>>>>>>        Integer eWebViewStyle eInvokingViewStyle eInitMode iMainFile iStackSize
28259>>>>>>>        Handle hoInvokingObjectTemp hoInvokingView hoMainDD hoInvokingViewDD 
28259>>>>>>>        Boolean bOK bChanged bErr bHasRecord bCancel bHandled
28259>>>>>>>        String sInvokingView sReason sViewName
28259>>>>>>>        tWebViewInfo[] aViewStack
28259>>>>>>>        tWebViewInfo[] aViewStack
28260>>>>>>>        RowID riMainRowId
28260>>>>>>>        
28260>>>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_Mode" to eInitMode
28261>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoInvokingView
28262>>>>>>>        Get Main_DD to hoMainDD
28263>>>>>>>                
28263>>>>>>>        // Test Access rights...
28263>>>>>>>        Get AllowAccess to bOK
28264>>>>>>>        If (not(bOK)) Begin
28266>>>>>>>            Get ViewAccessDenied Self False to bHandled
28267>>>>>>>            Procedure_Return
28268>>>>>>>        End
28268>>>>>>>>
28268>>>>>>>        
28268>>>>>>>        // Test for valid view style
28268>>>>>>>        Get peWebViewStyle to eWebViewStyle
28269>>>>>>>        If (eWebViewStyle = wvsDesktop) Begin
28271>>>>>>>            Error DFERR_PROGRAM "Can't navigate forward to a non-drill down view"
28272>>>>>>>>
28272>>>>>>>            Procedure_Return
28273>>>>>>>        End
28273>>>>>>>>
28273>>>>>>>
28273>>>>>>>        // Test that we can actually navigate to this view
28273>>>>>>>        Get CanPushView of (ViewStack(Self)) Self (&sReason) to bOK
28274>>>>>>>        
28274>>>>>>>        If (not(bOK)) Begin
28276>>>>>>>            Get WebObjectName to sViewName
28277>>>>>>>            Error DFERR_PROGRAM ("View stack navigate error: Cannot Navigate to (" + sViewName + "). " + sReason)
28278>>>>>>>>
28278>>>>>>>            Procedure_Return             
28279>>>>>>>        End
28279>>>>>>>>
28279>>>>>>>
28279>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
28280>>>>>>>        Move (SizeOfArray(aViewStack)) to iStackSize
28281>>>>>>>        
28281>>>>>>>        // Populate the Navigate Data struct.
28281>>>>>>>        If (eNavMode = ntNavigateForwardCustom) Begin
28283>>>>>>>            Move nfUndefined to NavigateData.eNavigateType
28284>>>>>>>        End
28284>>>>>>>>
28284>>>>>>>        Else Begin      
28285>>>>>>>            //  Determine navigation type and table
28285>>>>>>>            Get DetermineNavigateFromType hoInvokingView hoInvokingObject (&NavigateData.iTable) to NavigateData.eNavigateType
28286>>>>>>>        End 
28286>>>>>>>>
28286>>>>>>>        
28286>>>>>>>        //  Determine rowid and fire OnGetNavigateForwardData
28286>>>>>>>        If (hoInvokingObject <> C_WebUnresolvedObject) Begin
28288>>>>>>>            Send GetNavigateForwardData of hoInvokingObject Self (&NavigateData)
28289>>>>>>>        End
28289>>>>>>>>
28289>>>>>>>        
28289>>>>>>>        //  Override rowid when initializing from a state hash
28289>>>>>>>        If (eInitMode = initStateReinitialize or eInitMode = initStateReinitializeTopView) Begin
28291>>>>>>>            Send NavigateInitializeUpdateRowId (&NavigateData)
28292>>>>>>>            If (pbNavReinitError(Self)) ;                Procedure_Return
28295>>>>>>>        End
28295>>>>>>>>
28295>>>>>>>        
28295>>>>>>>        //  Give a last change to intervene before actual changes will be made
28295>>>>>>>        Send SetNavigateData NavigateData   // Set the navigationdata so that Refresh reads the right init_mode
28296>>>>>>>        Move False to bCancel
28297>>>>>>>        Send OnNavigating (&NavigateData) hoInvokingView hoInvokingObject (&bCancel)
28298>>>>>>>        If (bCancel) Begin
28300>>>>>>>            Set pbNavReinitError to True
28301>>>>>>>            Procedure_Return
28302>>>>>>>        End
28302>>>>>>>>
28302>>>>>>>        
28302>>>>>>>        // update the top of the stack with what is now the current record which
28302>>>>>>>        // should have been returned in NavigateData
28302>>>>>>>        If (iStackSize and aViewStack[iStackSize-1].iMainTable = NavigateData.iTable) Begin 
28304>>>>>>>            Move (DeserializeRowID(NavigateData.sRowID)) to aViewStack[iStackSize-1].riMainTable
28305>>>>>>>            WebSet paViewStack of (ViewStack(Self)) to aViewStack
28306>>>>>>>        End
28306>>>>>>>>
28306>>>>>>>                
28306>>>>>>>        // Store the NavigateData
28306>>>>>>>        Send SetNavigateData NavigateData
28307>>>>>>>        Send SetInvokingObject hoInvokingObject
28308>>>>>>>        
28308>>>>>>>        // if we must first save, we require a successful save
28308>>>>>>>        // or an existing record with no changes
28308>>>>>>>        If (NavigateData.bSaveBeforeNavigate and eInitMode = initStateDefault) Begin
28310>>>>>>>            Get Server of hoInvokingView to hoInvokingViewDD
28311>>>>>>>            If (hoInvokingViewDD) Begin
28313>>>>>>>                Get HasRecord of hoInvokingViewDD to bHasRecord
28314>>>>>>>            End
28314>>>>>>>>
28314>>>>>>>            Get SaveViewBeforeNavigate of hoInvokingView to bErr
28315>>>>>>>            If bErr Begin
28317>>>>>>>                Set pbNavReinitError to True    //  This should never happen!
28318>>>>>>>                Procedure_Return
28319>>>>>>>            End
28319>>>>>>>>
28319>>>>>>>            // if a new successful save we must udpate navigateData and the
28319>>>>>>>            // top of the view stack with the new record
28319>>>>>>>            If (hoInvokingViewDD and not(bHasRecord)) Begin
28321>>>>>>>                Get Main_File of hoInvokingViewDD to iMainFile
28322>>>>>>>                If (NavigateData.iTable = iMainFile) Begin
28324>>>>>>>                    Get CurrentRowId of hoInvokingViewDD to riMainRowId
28325>>>>>>>                    Move (SerializeRowID(riMainRowId)) to NavigateData.sRowID
28326>>>>>>>                    Send SetNavigateData NavigateData
28327>>>>>>>                    
28327>>>>>>>                    If (iStackSize) Begin 
28329>>>>>>>                        Move riMainRowId to aViewStack[iStackSize-1].riMainTable
28330>>>>>>>                        WebSet paViewStack of (ViewStack(Self)) to aViewStack
28331>>>>>>>                    End
28331>>>>>>>>
28331>>>>>>>                End
28331>>>>>>>>
28331>>>>>>>            End
28331>>>>>>>>
28331>>>>>>>        End
28331>>>>>>>>
28331>>>>>>>        
28331>>>>>>>        //Check if we need to hide a dialog
28331>>>>>>>        If (hoInvokingView <> 0) Begin
28333>>>>>>>           Get peWebViewStyle of hoInvokingView to eInvokingViewStyle
28334>>>>>>>            If (eInvokingViewStyle = wvsDialog and eWebViewStyle <> wvsDialog) Begin
28336>>>>>>>                //If this happens we navigated from a dialog to a view which means we should hide all dialogs.
28336>>>>>>>                Send HideAllDialogs
28337>>>>>>>            End
28337>>>>>>>>
28337>>>>>>>        End
28337>>>>>>>>
28337>>>>>>>        
28337>>>>>>>        //  Finish navigation
28337>>>>>>>        If (eInitMode = initStateReinitialize) Begin
28339>>>>>>>            Send DelayLoadview of (Host(Self)) Self 
28340>>>>>>>            Send NavigateForwardFinish 
28341>>>>>>>        End
28341>>>>>>>>
28341>>>>>>>        Else Begin
28342>>>>>>>            Send ShowView of (Host(Self)) Self (RefProc(NavigateForward_CallBack)) Self
28343>>>>>>>        End
28343>>>>>>>>
28343>>>>>>>    End_Procedure
28344>>>>>>>    
28344>>>>>>>    // This message is sent when navigating into a view (forward navigation) and is the last chance
28344>>>>>>>    // to influence the navigation data before the navigation is performed. It also is the place to 
28344>>>>>>>    // cancel the navigation.
28344>>>>>>>    Procedure OnNavigating tWebNavigateData ByRef NavigateData Handle hoInvokingView Handle hoInvokingObject Boolean ByRef bCancel
28346>>>>>>>    End_Procedure
28347>>>>>>>    
28347>>>>>>>    // The last step of the forward navigation where the view navigating to is in sync and finds 
28347>>>>>>>    // and constraints are performed based on the NavigateDataFinish. This procedure does look at
28347>>>>>>>    // the DDO structure of the invoking view but that shouldn't be a problem.
28347>>>>>>>    Procedure NavigateForwardFinish
28349>>>>>>>        Integer iStackSize iParentTable eInitMode
28349>>>>>>>        Handle hoMainDD hoParentDD hoInvokingView hoInvokingObject hoTopView
28349>>>>>>>        Boolean bOK bHasRecord bPrevNav
28349>>>>>>>        RowID ri
28349>>>>>>>        tWebNavigateData NavigateData
28349>>>>>>>        tWebNavigateData NavigateData
28349>>>>>>>        tWebViewInfo[] aViewStack
28349>>>>>>>        tWebViewInfo[] aViewStack
28350>>>>>>>        Handle[] hoStackDDOs
28351>>>>>>>        RowID[] riStackRowIds
28352>>>>>>>        Boolean bDynamicConstraints bOverrideViewState bFindParent bErr bSuccess
28352>>>>>>>        Integer eWebViewStyle eViewType
28352>>>>>>>        Integer iMainFile iConstrainFile eRefindError
28352>>>>>>>        String sMainRowId sTitle sCustomStateHash
28352>>>>>>>        RowID riMainRowId
28352>>>>>>>        Handle hoInvokingViewDD hoInvokingObjectDD hoRefindError
28352>>>>>>>        
28352>>>>>>>        //  Indicate that we are navigating
28352>>>>>>>        Set pbNavigating to True
28353>>>>>>>        
28353>>>>>>>        Get Main_DD to hoMainDD
28354>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoInvokingView
28355>>>>>>>        If (hoInvokingView <> C_WebUnresolvedObject) Begin
28357>>>>>>>            Get GetInvokingObject to hoInvokingObject
28358>>>>>>>        End
28358>>>>>>>>
28358>>>>>>>        
28358>>>>>>>        Get GetNavigateData to NavigateData
28359>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
28360>>>>>>>        Move (SizeOfArray(aViewStack)) to iStackSize
28361>>>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_Mode" to eInitMode
28362>>>>>>>
28362>>>>>>>        
28362>>>>>>>        Get peViewType to eViewType
28363>>>>>>>        Get IsDynamicConstraints to bDynamicConstraints
28364>>>>>>>        
28364>>>>>>>        // Interpret the navigate data 
28364>>>>>>>        
28364>>>>>>>        If hoMainDD Begin
28366>>>>>>>            
28366>>>>>>>            Send Refind_Records of hoMainDD
28367>>>>>>>            
28367>>>>>>>            
28367>>>>>>>            //  We are performing finds on the invoking views here to 'correct' their current records based on our navigate-data
28367>>>>>>>            If (hoInvokingObject <> C_WebUnresolvedObject and eInitMode <> initStateDefault and NavigateData.iTable > 0) Begin
28369>>>>>>>                Handle hoInvokingServer hoInvokingDD
28369>>>>>>>                RowID riNavRowId
28369>>>>>>>                
28369>>>>>>>                Get Server of hoInvokingObject to hoInvokingServer 
28370>>>>>>>                If (hoInvokingServer > 0 and IsInCallActionScope(hoInvokingObject)) Begin
28372>>>>>>>                    Get Data_Set of hoInvokingServer NavigateData.iTable to hoInvokingDD
28373>>>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to riNavRowId
28374>>>>>>>                    
28374>>>>>>>                    If (hoinvokingdd > 0 and not(IsSameRowId(CurrentRowId(hoInvokingDD), riNavRowId))) Begin
28376>>>>>>>                        Get pbNavigating of hoInvokingView to bPrevNav
28377>>>>>>>                        Set pbNavigating of hoInvokingView to True
28378>>>>>>>                        If (IsNullRowID(riNavRowId)) Begin
28380>>>>>>>                            Send Clear of hoInvokingDD
28381>>>>>>>                        End
28381>>>>>>>>
28381>>>>>>>                        Else Begin
28382>>>>>>>                            Send FindByRowId of hoInvokingDD NavigateData.iTable riNavRowId
28383>>>>>>>                        End
28383>>>>>>>>
28383>>>>>>>                        Set pbNavigating of hoInvokingView to bPrevNav
28384>>>>>>>                    End
28384>>>>>>>>
28384>>>>>>>                End
28384>>>>>>>>
28384>>>>>>>            End
28384>>>>>>>>
28384>>>>>>>            
28384>>>>>>>            If (bDynamicConstraints) Begin
28386>>>>>>>                // this re-establishes all existing constraints
28386>>>>>>>                Send EstablishConstrainFiles hoMainDD aViewStack (&hoStackDDOs) (&riStackRowIds)    
28387>>>>>>>                
28387>>>>>>>                // Now Set hew highest level constrain_file if needed.
28387>>>>>>>                Move False to bFindParent
28388>>>>>>>                // if fromParent we need a constraint
28388>>>>>>>                If (NavigateData.eNavigateType = nfFromParent and iStackSize>0) Begin
28390>>>>>>>                    Move aViewStack[iStackSize-1].iMainTable to iParentTable
28391>>>>>>>                    // must be an immediate parent of the main DDO or this is an error          
28391>>>>>>>                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28392>>>>>>>                    If (hoParentDD = 0) Begin
28394>>>>>>>                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28395>>>>>>>>
28395>>>>>>>                    End
28395>>>>>>>>
28395>>>>>>>                    
28395>>>>>>>                    Set Constrain_File of hoMainDD to iParentTable
28396>>>>>>>                    
28396>>>>>>>                    // find the constraining parent record and its parents
28396>>>>>>>                    Move True to bFindParent
28397>>>>>>>                    Move aViewStack[iStackSize-1].riMainTable to ri
28398>>>>>>>                End
28398>>>>>>>>
28398>>>>>>>                // if fromMain and the parent view is fromParent or a manual constraint
28398>>>>>>>                // we need a constraint added here
28398>>>>>>>                Else If (NavigateData.eNavigateType = nfFromMain) Begin
28401>>>>>>>
28401>>>>>>>                    If (hoInvokingObject) Begin
28403>>>>>>>                        Boolean bIsDynamic bIsDynamicBase
28403>>>>>>>                        Handle hoWidgetObj hoWidgetObjDD
28403>>>>>>>                        
28403>>>>>>>                        If (hoWidgetObj <> 0) Begin
28405>>>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
28406>>>>>>>                            Get Server of hoWidgetObj to hoWidgetObjDD
28407>>>>>>>                            
28407>>>>>>>                            If (hoInvokingObjectDD and hoWidgetObjDD<>hoInvokingObjectDD) Begin
28409>>>>>>>                            
28409>>>>>>>                                Get Constrain_File of hoInvokingObjectDD to iConstrainFile
28410>>>>>>>                                If (hoWidgetObjDD > 0) Begin
28412>>>>>>>                                    Get Main_File of hoWidgetObjDD to iParentTable
28413>>>>>>>                                End
28413>>>>>>>>
28413>>>>>>>                                // if there is an invokingDD constraint, it is a manual constraint. We only support
28413>>>>>>>                                // navigating from this if that cosntraint parent is the invoking view's main dd
28413>>>>>>>                                If (iConstrainFile and iParentTable=iConstrainFile) Begin
28415>>>>>>>                                    // must be an immediate parent of the main DDO or this is an error          
28415>>>>>>>                                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28416>>>>>>>                                    If (hoParentDD = 0) Begin
28418>>>>>>>                                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28419>>>>>>>>
28419>>>>>>>                                    End
28419>>>>>>>>
28419>>>>>>>                                    
28419>>>>>>>                                    Set Constrain_File of hoMainDD to iParentTable
28420>>>>>>>                                    
28420>>>>>>>                                    // find the constraining parent record and its parents
28420>>>>>>>                                    Move True to bFindParent
28421>>>>>>>                                    // this is the parent record to refind
28421>>>>>>>                                    Get CurrentRowId of hoWidgetObjDD to ri
28422>>>>>>>                                End
28422>>>>>>>>
28422>>>>>>>                                Else If (hoWidgetObjDD > 0) Begin
28425>>>>>>>                                    // this is a navigate from we don't allow.
28425>>>>>>>                                    Error DFERR_PROGRAM ("Cannot navigate from this invoking manually constrained DDO for table# "+String(iParentTable))
28426>>>>>>>>
28426>>>>>>>                                End
28426>>>>>>>>
28426>>>>>>>                            End
28426>>>>>>>>
28426>>>>>>>                            Else Begin
28427>>>>>>>                                Send Refind_Records of hoInvokingObjectDD
28428>>>>>>>                                Get CurrentRowId of hoInvokingObjectDD to ri
28429>>>>>>>                                Move (SerializeRowID(ri)) to NavigateData.sRowID
28430>>>>>>>                            End
28430>>>>>>>>
28430>>>>>>>                        End
28430>>>>>>>>
28430>>>>>>>                        Else Begin
28431>>>>>>>                            
28431>>>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
28432>>>>>>>                            Get Server of hoInvokingView to hoInvokingViewDD
28433>>>>>>>                            // special fromMain case where the DDO is not the view's main_dd but is
28433>>>>>>>                            // a child DD that has a constraint. If so we only support this one level
28433>>>>>>>                            // deep and the DD must be constrained to the invoking view's main DD.
28433>>>>>>>                            // for example, mavigating from ZoomOrder's detail grid tp a detail zoom
28433>>>>>>>                            If (hoInvokingObjectDD and hoInvokingViewDD<>hoInvokingObjectDD) Begin
28435>>>>>>>                            
28435>>>>>>>                                Get Constrain_File of hoInvokingObjectDD to iConstrainFile
28436>>>>>>>                                If (hoInvokingViewDD > 0) Begin
28438>>>>>>>                                    Get Main_File of hoInvokingViewDD to iParentTable
28439>>>>>>>                                End
28439>>>>>>>>
28439>>>>>>>                                // if there is an invokingDD constraint, it is a manual constraint. We only support
28439>>>>>>>                                // navigating from this if that cosntraint parent is the invoking view's main dd
28439>>>>>>>                                If (iConstrainFile and iParentTable=iConstrainFile) Begin
28441>>>>>>>                                    // must be an immediate parent of the main DDO or this is an error          
28441>>>>>>>                                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28442>>>>>>>                                    If (hoParentDD = 0) Begin
28444>>>>>>>                                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28445>>>>>>>>
28445>>>>>>>                                    End
28445>>>>>>>>
28445>>>>>>>                                    
28445>>>>>>>                                    Set Constrain_File of hoMainDD to iParentTable
28446>>>>>>>                                    
28446>>>>>>>                                    // find the constraining parent record and its parents
28446>>>>>>>                                    Move True to bFindParent
28447>>>>>>>                                    // this is the parent record to refind
28447>>>>>>>                                    Get CurrentRowId of hoInvokingViewDD to ri
28448>>>>>>>                                End
28448>>>>>>>>
28448>>>>>>>                                Else If (hoInvokingViewDD > 0) Begin
28451>>>>>>>                                    // this is a navigate from we don't allow.
28451>>>>>>>                                    Error DFERR_PROGRAM ("Cannot navigate from this invoking manually constrained DDO for table# "+String(iParentTable))
28452>>>>>>>>
28452>>>>>>>                                End
28452>>>>>>>>
28452>>>>>>>                            End
28452>>>>>>>>
28452>>>>>>>                            
28452>>>>>>>                        End
28452>>>>>>>>
28452>>>>>>>                    End
28452>>>>>>>>
28452>>>>>>>                    // this is a more typical fromMain where invoking view is constrained amd
28452>>>>>>>                    // we want to use that constraint. 
28452>>>>>>>                    If  (not(bFindParent) and aViewStack[iStackSize-1].eNavigateType=nfFromParent and iStackSize>1) Begin
28454>>>>>>>                        Move aViewStack[iStackSize-2].iMainTable to iParentTable
28455>>>>>>>                        // must be an immediate parent of the main DDO or this is an error          
28455>>>>>>>                        Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28456>>>>>>>                        If (hoParentDD = 0) Begin
28458>>>>>>>                            Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28459>>>>>>>>
28459>>>>>>>                        End
28459>>>>>>>>
28459>>>>>>>                        // note constrain_file should already be set
28459>>>>>>>                        Move True to bFindParent
28460>>>>>>>                        Move aViewStack[iStackSize-2].riMainTable to ri
28461>>>>>>>                    End
28461>>>>>>>>
28461>>>>>>>                End
28461>>>>>>>>
28461>>>>>>>                
28461>>>>>>>            End
28461>>>>>>>>
28461>>>>>>>    
28461>>>>>>>            // Used to set ordering for a List. Do it here so any grid fills will use the right index.
28461>>>>>>>            // Let's do this before any finds occur on the new view. This can be used to set up custom
28461>>>>>>>            // constraints
28461>>>>>>>            Send NavigateForwardPreFindInit NavigateData hoInvokingObject
28462>>>>>>>
28462>>>>>>>            // Now rebuild the constraints
28462>>>>>>>            Send RebuildAllConstraints of hoMainDD
28463>>>>>>>        
28463>>>>>>>            // Now refind the parent if needed.
28463>>>>>>>            // This will only happen with dynamic constraints but this makes our intention clear.
28463>>>>>>>            If (bDynamicConstraints and bFindParent) Begin
28465>>>>>>>                // no autofill stops a child findfirst. We don't need that here  
28465>>>>>>>                Get FindByRowIdExNoAutoFill of hoParentDD iParentTable ri to bSuccess
28466>>>>>>>                // we also consider navigating forward from a null consrained parent an error
28466>>>>>>>                If (not(bSuccess) or IsNullRowID(ri)) Begin
28468>>>>>>>                    // This is kind of complex because it means that the constraining parent cannot be
28468>>>>>>>                    // reloaded. In such a case you probably should not be in the view at all and
28468>>>>>>>                    // should navigate back
28468>>>>>>>                    Move hoParentDD to hoRefindError
28469>>>>>>>                    Move retCannotRereadConstrainingParent to eRefindError    
28470>>>>>>>                End
28470>>>>>>>>
28470>>>>>>>            End
28470>>>>>>>>
28470>>>>>>>
28470>>>>>>>            If (hoRefindError=0) Begin
28472>>>>>>>                
28472>>>>>>>                // now find main file as needed
28472>>>>>>>                If ( (NavigateData.eNavigateType = nfFromMain or ;                      NavigateData.eNavigateType = nfFromChild or ;                      NavigateData.eNavigateType = nfUndefined)  ;                     and NavigateData.iTable=Main_File(hoMainDD) and iStackSize>0) Begin
28474>>>>>>>                    
28474>>>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to ri
28475>>>>>>>                    If (IsNullRowID(ri) or NavigateData.bNewRecord) Begin
28477>>>>>>>                        // Assume Create New Record
28477>>>>>>>                        Send Clear to hoMainDD
28478>>>>>>>                    End
28478>>>>>>>>
28478>>>>>>>                    Else Begin
28479>>>>>>>                        // Populate the list around the passed row ID
28479>>>>>>>                        Get FindByRowIdEx of hoMainDD (Main_File(hoMainDD)) ri to bSuccess
28480>>>>>>>                        If not bSuccess Begin
28482>>>>>>>                            Send Clear of hoMainDD
28483>>>>>>>                            Move hoMainDD to hoRefindError
28484>>>>>>>                            Move retCannotRereadMain to eRefindError    
28485>>>>>>>                        End
28485>>>>>>>>
28485>>>>>>>                    End
28485>>>>>>>>
28485>>>>>>>                End
28485>>>>>>>>
28485>>>>>>>                Else If (eViewType=vtZoom and  NavigateData.eNavigateType = nfFromParent and iStackSize>0) Begin
28488>>>>>>>                    // Assume Create New Record
28488>>>>>>>                    Send Clear to hoMainDD
28489>>>>>>>                End
28489>>>>>>>>
28489>>>>>>>    
28489>>>>>>>                // finally, if a select view and we don't have a record tell the grid to
28489>>>>>>>                // do an init
28489>>>>>>>                If (eInitMode <> initStateReinitialize and hoRefindError=0 and eViewType=vtSelect) Begin
28491>>>>>>>                    Get HasRecord of hoMainDD to bOK
28492>>>>>>>                    If not bOK Begin
28494>>>>>>>                        Broadcast Recursive Send InitGrid NavigateData hoInvokingObject
28496>>>>>>>                    End
28496>>>>>>>>
28496>>>>>>>                End
28496>>>>>>>>
28496>>>>>>>    
28496>>>>>>>            End
28496>>>>>>>>
28496>>>>>>>        End
28496>>>>>>>>
28496>>>>>>>        
28496>>>>>>>        // Update the View Stack
28496>>>>>>>        Send PushView to (ViewStack(Self)) Self NavigateData.eNavigateType
28497>>>>>>>        Send UpdateInvokingViewDrillDownStyle 
28498>>>>>>>        
28498>>>>>>>
28498>>>>>>>        
28498>>>>>>>        
28498>>>>>>>        //  Cleanup navigation data
28498>>>>>>>        Get NamedValueRemove NavigateData.NamedValues "Init_Mode" to NavigateData.NamedValues
28499>>>>>>>        Send SetNavigateData NavigateData
28500>>>>>>>        
28500>>>>>>>        // if a find error, reverse the navigation. We assume that navigating to a view with
28500>>>>>>>        // records that cannot be found should be reversed. 
28500>>>>>>>        If hoRefindError Begin
28502>>>>>>>            If (eInitMode = initStateReinitialize or eInitMode = initStateReinitializeTopView) Begin
28504>>>>>>>                Set pbNavReinitError to True
28505>>>>>>>                If (pbStateHashInvalidError(Host(Self))) Begin
28507>>>>>>>                    Error DFERR_WEBAPP_INVALID_URL_REC
28508>>>>>>>>
28508>>>>>>>                End
28508>>>>>>>>
28508>>>>>>>            End
28508>>>>>>>>
28508>>>>>>>            Else Begin
28509>>>>>>>                Send OnNavigateForwardRefindError hoRefindError eRefindError
28510>>>>>>>            End
28510>>>>>>>>
28510>>>>>>>        End
28510>>>>>>>>
28510>>>>>>>        Else Begin
28511>>>>>>>            Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject    // Hook to modify the view before opening it 
28512>>>>>>>        End
28512>>>>>>>>
28512>>>>>>>        
28512>>>>>>>        //  We are done navigating now
28512>>>>>>>        Set pbNavigating to False
28513>>>>>>>        
28513>>>>>>>        // Update URL (check if still the topview, OnNavigateForward might have done a navigation)
28513>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView
28514>>>>>>>        If (eInitMode <> initStateReinitialize and hoTopView = Self) Begin 
28516>>>>>>>            Send UpdateStateHash (eInitMode = initStateReinitializeTopView or pbStateReplace(Self))
28517>>>>>>>                        
28517>>>>>>>            Send UpdatePageTitle
28518>>>>>>>        End
28518>>>>>>>>
28518>>>>>>>    End_Procedure
28519>>>>>>>    
28519>>>>>>>    
28519>>>>>>>    
28519>>>>>>>    // set ordering for a List. Do it here so any grid fills will use the right index.
28519>>>>>>>    // Let's do this before any finds occur on the new view
28519>>>>>>>    Procedure NavigateForwardPreFindInit tWebNavigateData NavigateData Handle hoInvokingObject
28521>>>>>>>        Integer eViewType
28521>>>>>>>        Get peViewType to eViewType
28522>>>>>>>        If (eViewType=vtSelect) Begin
28524>>>>>>>            Broadcast Recursive Send InitOrdering NavigateData hoInvokingObject
28526>>>>>>>        End
28526>>>>>>>>
28526>>>>>>>        Send OnNavigateForwardPreFindInit NavigateData hoInvokingObject
28527>>>>>>>    End_Procedure
28528>>>>>>>    
28528>>>>>>>    // This is called during NavigateForward after the automatic constraints have been applied but
28528>>>>>>>    // before the constraints have been rebuilt and any records have been found for the view.
28528>>>>>>>    // This primarily exists to give you a chance to apply any additional constraints for the view. You can
28528>>>>>>>    // also use this to set any finding properties such as piSortCol, etc.
28528>>>>>>>    // You should not use this to find DD records or fill the DDOs yourself - it won't work!
28528>>>>>>>    Procedure OnNavigateForwardPreFindInit  tWebNavigateData NavigateData Handle hoInvokingObject
28530>>>>>>>    End_Procedure
28531>>>>>>>    
28531>>>>>>>    // use to navigate to the start of the stack. If there is a default view it
28531>>>>>>>    // will navigate to there.
28531>>>>>>>    // if bUnconditional, do this without checking for changed states
28531>>>>>>>    Procedure NavigateBegin Handle hoInvokingObject Boolean bUnconditional
28533>>>>>>>        Boolean bOk
28533>>>>>>>        Handle hoTop hoDefault
28533>>>>>>>        
28533>>>>>>>        Get GetDefaultView of (Host(Self)) to hoDefault
28534>>>>>>>        
28534>>>>>>>        // reset the breadcrumb stack respecting the default view
28534>>>>>>>        Get Reset of (ViewStack(Self)) (hoDefault <> Self) bUnconditional to bOK
28535>>>>>>>        If (bOK) Begin
28537>>>>>>>            Send NavigateForward hoInvokingObject // note that we do not pass on the invoking object to preven the navigation logic from making wrong assumptions
28538>>>>>>>        End
28538>>>>>>>>
28538>>>>>>>    End_Procedure
28539>>>>>>>
28539>>>>>>>    // Send this to change the default caption that is shown for this view
28539>>>>>>>    // in a breadcrumb.
28539>>>>>>>    Procedure SetBreadcrumbCaption String sCaption
28541>>>>>>>        Send SetCaption of (ViewStack(Self)) Self sCaption
28542>>>>>>>    End_Procedure
28543>>>>>>>
28543>>>>>>>    // this gets the breadcrumb caption 
28543>>>>>>>    Function GetBreadcrumbCaption Returns String
28545>>>>>>>        String sCaption
28545>>>>>>>        Get GetCaption of (ViewStack(Self)) Self to sCaption
28546>>>>>>>        Function_Return sCaption
28547>>>>>>>    End_Function
28548>>>>>>>
28548>>>>>>>    // Send this to change the default caption that is shown for this view
28548>>>>>>>    // in a "heading". Typically used by a breadcrumb object when it is simply
28548>>>>>>>    // displaying a view heading rather than the entire breadcrumb.
28548>>>>>>>    Procedure SetHeaderCaption String sCaption
28550>>>>>>>        Send SetHeaderCaption of (ViewStack(Self)) Self sCaption
28551>>>>>>>        
28551>>>>>>>        Send UpdatePageTitle
28552>>>>>>>    End_Procedure
28553>>>>>>>
28553>>>>>>>    // this gets the breadcrumb heading scaption 
28553>>>>>>>    Function GetHeaderCaption Returns String
28555>>>>>>>        String sCaption
28555>>>>>>>        Get GetHeaderCaption of (ViewStack(Self)) Self to sCaption
28556>>>>>>>        Function_Return sCaption
28557>>>>>>>    End_Function
28558>>>>>>>
28558>>>>>>>    // if a view is changed, how do we close this?
28558>>>>>>>    // This uses peChangedViewAction and a corresponding
28558>>>>>>>    // Verify_Data_Loss_Msg / Verify_SaveClearCancel_msg to
28558>>>>>>>    // determine the action. Therefore setting the Verify_xxx_msg overrides
28558>>>>>>>    // the peChangedViewExitAction and force a non-verified abandoning of changes  
28558>>>>>>>    Function GetChangedViewExitAction Returns Integer
28560>>>>>>>        Integer iMsg eCloseAction
28560>>>>>>>        
28560>>>>>>>        Get peChangedViewExitAction to eCloseAction
28561>>>>>>>        If (eCloseAction=cveConfirmAbandonChanges) Begin
28563>>>>>>>            Get Verify_Data_Loss_Msg to iMsg
28564>>>>>>>            If (iMsg=0) Begin
28566>>>>>>>                Move cveAbandonChanges to eCloseAction
28567>>>>>>>            End
28567>>>>>>>>
28567>>>>>>>        End
28567>>>>>>>>
28567>>>>>>>        Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
28570>>>>>>>            Get Verify_SaveClearCancel_msg to iMsg
28571>>>>>>>            If (iMsg=0) Begin
28573>>>>>>>                Move cveAbandonChanges to eCloseAction
28574>>>>>>>            End
28574>>>>>>>>
28574>>>>>>>        End
28574>>>>>>>>
28574>>>>>>>        Function_Return eCloseAction
28575>>>>>>>    End_Function
28576>>>>>>>    
28576>>>>>>>
28576>>>>>>>    // Callback message in response to VerifyRequest Callback. Called via NavigateClose, 
28576>>>>>>>    // do not call this directly.
28576>>>>>>>    // This is used for Yes/No verifies
28576>>>>>>>    Procedure NavigateClose_Callback Integer eConfirmMode
28578>>>>>>>        If (eConfirmMode = cmYes) Begin
28580>>>>>>>            Send NavigateCloseExec False // means close no save
28581>>>>>>>        End
28581>>>>>>>>
28581>>>>>>>    End_Procedure
28582>>>>>>>
28582>>>>>>>    // This is used for Yes/No/Cancel verifies (Save, Clear, Cancel)
28582>>>>>>>    Procedure NavigateCloseYNC_Callback Integer eConfirmMode
28584>>>>>>>        If (eConfirmMode = cmYes) Begin
28586>>>>>>>            Send NavigateCloseExec True
28587>>>>>>>        End
28587>>>>>>>>
28587>>>>>>>        Else If (eConfirmMode = cmNo) Begin
28590>>>>>>>            Send NavigateCloseExec False // means close no save
28591>>>>>>>        End
28591>>>>>>>>
28591>>>>>>>    End_Procedure
28592>>>>>>>    
28592>>>>>>>
28592>>>>>>>    // If a view is the current top view, you can send this message to it
28592>>>>>>>    // to close the view. If there is a view underneath in the view stack
28592>>>>>>>    // then it will be passed back navigation data from the callback object.
28592>>>>>>>    // This control must understand the GetNavigateBackData callback message.
28592>>>>>>>    // 
28592>>>>>>>    // If there is no special data to pass back to the view underneath in 
28592>>>>>>>    // the view stack then you should call NavigateCancel.
28592>>>>>>>    Procedure NavigateClose Handle hoCallback
28594>>>>>>>        Handle hoView
28594>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoView
28595>>>>>>>        Send NavigateCloseTo hoView hoCallback
28596>>>>>>>    End_Procedure
28597>>>>>>>
28597>>>>>>>    // NavigateCloseTo is passed the view to return to. Normally NavigateClose is used and this is for more
28597>>>>>>>    // advanced usage when closing several views but wanting to return a value to the view
28597>>>>>>>    // 1. When multi-level closes are used the navigateFrom type is always changed to nfUndefined meaning you must
28597>>>>>>>    //    handle the update yourself.
28597>>>>>>>    // 2. We only check for data-loss changes in the top view. If there are changes in views in between this and the destination
28597>>>>>>>    //    view, they are lost.
28597>>>>>>>    // Use this with care.
28597>>>>>>>    Procedure NavigateCloseTo Handle hoView Handle hoCallback
28599>>>>>>>        Handle hoMainDD
28599>>>>>>>        Boolean bCanPopView bChanged 
28599>>>>>>>        Integer eCloseAction iIndex
28599>>>>>>>        String sReason sNavigateDataCallbackObj sInvokingView
28599>>>>>>>        Integer eWebViewStyle
28599>>>>>>>
28599>>>>>>>        Get peWebViewStyle to eWebViewStyle
28600>>>>>>>        If (eWebViewStyle = wvsDesktop) Begin
28602>>>>>>>            Error DFERR_PROGRAM "Can't navigate back with a non-drill down view"
28603>>>>>>>>
28603>>>>>>>            Procedure_Return
28604>>>>>>>        End            
28604>>>>>>>>
28604>>>>>>>
28604>>>>>>>
28604>>>>>>>        If hoView Begin
28606>>>>>>>            Get GetViewIndex of (ViewStack(Self)) hoView to iIndex
28607>>>>>>>            If (iIndex=-1) Begin
28609>>>>>>>                Error DFERR_PROGRAM "Target view not in view stack"
28610>>>>>>>>
28610>>>>>>>                Procedure_Return
28611>>>>>>>            End
28611>>>>>>>>
28611>>>>>>>            Get WebObjectName of hoView to sInvokingView
28612>>>>>>>        End
28612>>>>>>>>
28612>>>>>>>        WebSet psNavigateBackView to sInvokingView
28613>>>>>>>        
28613>>>>>>>        Get WebObjectName of hoCallback to sNavigateDataCallbackObj
28614>>>>>>>        WebSet psNavigateDataCallbackObj to sNavigateDataCallbackObj
28615>>>>>>>
28615>>>>>>>        Get CanPopView of (ViewStack(Self)) Self (&sReason) to bCanPopView
28616>>>>>>>        
28616>>>>>>>        If (bCanPopView) Begin
28618>>>>>>>            Get IsViewChanged to bChanged
28619>>>>>>>            
28619>>>>>>>            If bChanged Begin
28621>>>>>>>                Get GetChangedViewExitAction to eCloseAction
28622>>>>>>>                If (eCloseAction=cveConfirmAbandonChanges) Begin
28624>>>>>>>                    Send VerifyRequest (RefProc(NavigateClose_Callback)) (RefFunc(Verify_Data_Loss_msg))
28625>>>>>>>                End
28625>>>>>>>>
28625>>>>>>>                Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
28628>>>>>>>                    Send VerifyRequest (RefProc(NavigateCloseYNC_Callback)) (RefFunc(Verify_SaveClearCancel_msg))
28629>>>>>>>                End
28629>>>>>>>>
28629>>>>>>>                Else If (eCloseAction=cveSave) Begin
28632>>>>>>>                    Send NavigateCloseExec True
28633>>>>>>>                End
28633>>>>>>>>
28633>>>>>>>                Else Begin
28634>>>>>>>                    Send NavigateCloseExec False
28635>>>>>>>                End
28635>>>>>>>>
28635>>>>>>>            End
28635>>>>>>>>
28635>>>>>>>            Else Begin            
28636>>>>>>>                Send NavigateCloseExec False
28637>>>>>>>            End
28637>>>>>>>>
28637>>>>>>>        End
28637>>>>>>>>
28637>>>>>>>        Else Begin
28638>>>>>>>            Error DFERR_PROGRAM ("View stack Navigate error: " + sReason)
28639>>>>>>>>
28639>>>>>>>        End
28639>>>>>>>>
28639>>>>>>>    End_Procedure
28640>>>>>>>    
28640>>>>>>>    // This actually performs the Navigate Close operation. This will close the current
28640>>>>>>>    // view and pop the view stack without returning any data to the invoking view.
28640>>>>>>>    // This operates like a cancel. All data loss checking and confirmation has already
28640>>>>>>>    // been performed before we get here.
28640>>>>>>>    //
28640>>>>>>>    // Called via NavigateCloseTo, do not call this directly.
28640>>>>>>>    Procedure NavigateCloseExec Boolean bSave
28642>>>>>>>        Handle hoView hoCallback
28642>>>>>>>        String sNavigateDataCallbackObj sView
28642>>>>>>>        Boolean bErr
28642>>>>>>>        
28642>>>>>>>        If bSave Begin
28644>>>>>>>           Get SaveViewExec to bErr            
28645>>>>>>>           If bErr ;            Procedure_Return 
28648>>>>>>>        End
28648>>>>>>>>
28648>>>>>>>        
28648>>>>>>>        WebGet psNavigateBackView to sView   // handle to the new top of view
28649>>>>>>>        If (Trim(sView) <> "") Begin
28651>>>>>>>            Get FindWebObject of (Owner(Self)) sView to hoView
28652>>>>>>>            WebGet psNavigateDataCallbackObj to sNavigateDataCallbackObj
28653>>>>>>>            If (sNavigateDataCallbackObj<>"") Begin
28655>>>>>>>                Get WebObjectByName sNavigateDataCallbackObj to hoCallback
28656>>>>>>>            End
28656>>>>>>>>
28656>>>>>>>            Send NavigateBackToHere of hoView False (If(hoCallback, hoCallback, Self))
28657>>>>>>>        End
28657>>>>>>>>
28657>>>>>>>        Else Begin
28658>>>>>>>            Send Hide   // If the view stack is empty, just hide this view
28659>>>>>>>        End
28659>>>>>>>>
28659>>>>>>>    End_Procedure
28660>>>>>>>
28660>>>>>>>    // this attempts a save and returns True if it failed.
28660>>>>>>>    // There should be no confirmation messages at this point.
28660>>>>>>>    // Unlike RequestSaveExec, this has to attempt a save at the view level.
28660>>>>>>>    // Currently it just saves the view's Server, which may not always be enough if
28660>>>>>>>    // have sub-DD like detail lines.
28660>>>>>>>    Function SaveViewExec Returns Boolean
28662>>>>>>>        Handle hoServer
28662>>>>>>>        Integer iRetVal
28662>>>>>>>        Boolean bRequestValidateAll bErr
28662>>>>>>>        Get Server to hoServer
28663>>>>>>>        If hoServer Begin
28665>>>>>>>            Get pbRequesteValidateAll to bRequestValidateAll
28666>>>>>>>            If bRequestValidateAll Begin
28668>>>>>>>                Get Request_Validate_All of hoServer to iRetVal
28669>>>>>>>            End
28669>>>>>>>>
28669>>>>>>>            Else Begin
28670>>>>>>>                Get Request_Validate of hoServer to iRetVal
28671>>>>>>>            End
28671>>>>>>>>
28671>>>>>>>            If (iRetVal=0) Begin
28673>>>>>>>                Move False to Err
28674>>>>>>>                Send Request_Save to hoServer
28675>>>>>>>                Move Err to iRetVal
28676>>>>>>>            End
28676>>>>>>>>
28676>>>>>>>        End
28676>>>>>>>>
28676>>>>>>>        Function_Return iRetVal
28677>>>>>>>    End_Function
28678>>>>>>>
28678>>>>>>>    // Save before navigate forward to some other view. Return 0 if ok.
28678>>>>>>>    // Upon completion a saved record must exist, else return non zero
28678>>>>>>>    Function SaveViewBeforeNavigate Returns Boolean
28680>>>>>>>        Handle hoServer
28680>>>>>>>        Boolean bChanged bErr bHasRec
28680>>>>>>>        Get Server to hoServer
28681>>>>>>>        Get IsViewChanged to bChanged
28682>>>>>>>        
28682>>>>>>>        If (bChanged) Begin
28684>>>>>>>           Get SaveViewExec to bErr
28685>>>>>>>        End
28685>>>>>>>>
28685>>>>>>>        Else Begin
28686>>>>>>>            // if nothing to save but a new record, we will attempt validation and save anyway. Most
28686>>>>>>>            // likely this will raise a validation error providing the user feedback that they cannot
28686>>>>>>>            // navigate forward without a valid save
28686>>>>>>>            If (hoServer) Begin
28688>>>>>>>                Get HasRecord of hoServer to bHasRec
28689>>>>>>>                If not bHasRec Begin
28691>>>>>>>                    Get SaveViewExec to bErr
28692>>>>>>>                End
28692>>>>>>>>
28692>>>>>>>            End
28692>>>>>>>>
28692>>>>>>>        End
28692>>>>>>>>
28692>>>>>>>        Function_Return bErr
28693>>>>>>>    End_Function
28694>>>>>>>
28694>>>>>>>
28694>>>>>>>    // Callback message in response to VerifyRequest Callback. Called via NavigateClose, 
28694>>>>>>>    // do not call this directly.
28694>>>>>>>    // This is used for Yes/No verifies
28694>>>>>>>    Procedure NavigateCancel_Callback Integer eConfirmMode
28696>>>>>>>        If (eConfirmMode = cmYes) Begin
28698>>>>>>>            Send NavigateCancelExec False
28699>>>>>>>        End
28699>>>>>>>>
28699>>>>>>>    End_Procedure
28700>>>>>>>
28700>>>>>>>    // This is used for Yes/No/Cancel verifies (Save, Clear, Cancel)
28700>>>>>>>    Procedure NavigateCancelYNC_Callback Integer eConfirmMode
28702>>>>>>>        If (eConfirmMode = cmYes) Begin
28704>>>>>>>            Send NavigateCancelExec True
28705>>>>>>>        End
28705>>>>>>>>
28705>>>>>>>        Else If (eConfirmMode = cmNo) Begin
28708>>>>>>>            Send NavigateCancelExec False // means close no save
28709>>>>>>>        End
28709>>>>>>>>
28709>>>>>>>    End_Procedure
28710>>>>>>>    
28710>>>>>>>
28710>>>>>>>    // If a view is the current top view, you can send this message to it
28710>>>>>>>    // to close the view. Typically this message is sent to a view by a 
28710>>>>>>>    // Cancel on the view.
28710>>>>>>>    Procedure NavigateCancel 
28712>>>>>>>        Handle hoView
28712>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoView
28713>>>>>>>        Send NavigateCancelTo hoView
28714>>>>>>>    End_Procedure
28715>>>>>>>    
28715>>>>>>>    // If a view is the current top view, you can send this message to it
28715>>>>>>>    // to close the view and navigate down to the passed view. Typically this message is sent to
28715>>>>>>>    // a view by a breacrumb navigate back action
28715>>>>>>>    Procedure NavigateCancelTo Handle hoView
28717>>>>>>>        Boolean bCanPopView bChanged  bOk
28717>>>>>>>        Integer eCloseAction
28717>>>>>>>        String sReason sInvokingView
28717>>>>>>>        Integer eWebViewStyle iIndex
28717>>>>>>>
28717>>>>>>>        Get peWebViewStyle to eWebViewStyle
28718>>>>>>>        If (eWebViewStyle = wvsDesktop) Begin
28720>>>>>>>            Error DFERR_PROGRAM "Can't navigate back with a non-drill down view"
28721>>>>>>>>
28721>>>>>>>            Procedure_Return
28722>>>>>>>        End            
28722>>>>>>>>
28722>>>>>>>        
28722>>>>>>>        If hoView Begin
28724>>>>>>>            Get GetViewIndex of (ViewStack(Self)) hoView to iIndex
28725>>>>>>>            If (iIndex=-1) Begin
28727>>>>>>>                Error DFERR_PROGRAM "Target view not in view stack"
28728>>>>>>>>
28728>>>>>>>                Procedure_Return
28729>>>>>>>            End
28729>>>>>>>>
28729>>>>>>>            Get WebObjectName of hoView to sInvokingView
28730>>>>>>>        End
28730>>>>>>>>
28730>>>>>>>        WebSet psNavigateBackView to sInvokingView
28731>>>>>>>        
28731>>>>>>>        Get CanPopView of (ViewStack(Self)) Self (&sReason) to bCanPopView
28732>>>>>>>        
28732>>>>>>>        If (bCanPopView) Begin
28734>>>>>>>            
28734>>>>>>>            // Set the callback object that will be used by NavigateCloseExec
28734>>>>>>>            Get IsViewChanged to bChanged
28735>>>>>>>            If bChanged Begin
28737>>>>>>>                Get GetChangedViewExitAction to eCloseAction
28738>>>>>>>                If (eCloseAction=cveConfirmAbandonChanges) Begin
28740>>>>>>>                    Send VerifyRequest (RefProc(NavigateCancel_Callback)) (RefFunc(Verify_Data_Loss_msg))
28741>>>>>>>                End
28741>>>>>>>>
28741>>>>>>>                Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
28744>>>>>>>                    Send VerifyRequest (RefProc(NavigateCancelYNC_Callback)) (RefFunc(Verify_SaveClearCancel_msg))
28745>>>>>>>                End
28745>>>>>>>>
28745>>>>>>>                Else If (eCloseAction=cveSave) Begin
28748>>>>>>>                    Send NavigateCancelExec True
28749>>>>>>>                End
28749>>>>>>>>
28749>>>>>>>                Else Begin
28750>>>>>>>                    Send NavigateCancelExec False
28751>>>>>>>                End
28751>>>>>>>>
28751>>>>>>>            End
28751>>>>>>>>
28751>>>>>>>            Else Begin            
28752>>>>>>>                Send NavigateCancelExec False
28753>>>>>>>            End
28753>>>>>>>>
28753>>>>>>>        End
28753>>>>>>>>
28753>>>>>>>        Else Begin
28754>>>>>>>            Error DFERR_PROGRAM ("View stack Navigate error: " + sReason)
28755>>>>>>>>
28755>>>>>>>        End
28755>>>>>>>>
28755>>>>>>>    End_Procedure
28756>>>>>>>
28756>>>>>>>    
28756>>>>>>>    // This actually performs the Navigate Close operation. This will close the current
28756>>>>>>>    // view and pop the view stack without returning any data to the invoking view.
28756>>>>>>>    // This operates like a cancel. All data loss checking and confirmation has already
28756>>>>>>>    // been performed before we get here.
28756>>>>>>>    //
28756>>>>>>>    // Called via NavigateCancel, do not call this directly.
28756>>>>>>>    Procedure NavigateCancelExec Boolean bSave
28758>>>>>>>        Handle hoView hoCallback
28758>>>>>>>        Boolean bErr
28758>>>>>>>        String sView
28758>>>>>>>
28758>>>>>>>        If bSave Begin
28760>>>>>>>           Get SaveViewExec to bErr            
28761>>>>>>>           If bErr ;            Procedure_Return
28764>>>>>>>           // If save was successful treat this as a close and not a cancel
28764>>>>>>>           Send NavigateCloseExec False 
28765>>>>>>>           Procedure_Return
28766>>>>>>>        End
28766>>>>>>>>
28766>>>>>>>
28766>>>>>>>//        // Navigate to the next view down in the view stack
28766>>>>>>>//        Send PopView to (ViewStack(Self))                  // removes this view
28766>>>>>>>//        Get TopViewHandle of (ViewStack(Self)) to hoView   // handle to the new top of view
28766>>>>>>>        WebGet psNavigateBackView to sView   // handle to the new top of view
28767>>>>>>>
28767>>>>>>>        If (Trim(sView) <> "") Begin
28769>>>>>>>            Get FindWebObject of (Owner(Self)) sView to hoView
28770>>>>>>>            Send NavigateBackToHere of hoView True 0
28771>>>>>>>        End
28771>>>>>>>>
28771>>>>>>>        Else Begin
28772>>>>>>>            Send Hide   // If the view stack is empty, just hide this view
28773>>>>>>>        End
28773>>>>>>>>
28773>>>>>>>    End_Procedure
28774>>>>>>>
28774>>>>>>>    // Loads default data for NavigateData for NavigateForward.
28774>>>>>>>    // This must be executed from the point of view
28774>>>>>>>    // of the invoking object, which is the object that calls this.
28774>>>>>>>    Procedure LoadDefaultNavigateForwardData Handle hoInvokIngObject tWebNavigateData ByRef NavigateData
28776>>>>>>>        Integer iFile iField
28776>>>>>>>        String sValue
28776>>>>>>>        Handle hoServer hoDDO
28776>>>>>>>        Boolean bChanged bDataBindable
28776>>>>>>>        RowID ri
28776>>>>>>>        
28776>>>>>>>        // step Populate the Navigate Data struct with the best guess values from
28776>>>>>>>        // this control's server DDO.
28776>>>>>>>        // If this is called from outside a view, like a main menu, this should
28776>>>>>>>        // delegate to cWebApp and return 0.
28776>>>>>>>        Get Server of hoInvokIngObject to hoServer
28777>>>>>>>        
28777>>>>>>>        If (hoServer) Begin
28779>>>>>>>            Get pbDataBindable of hoInvokIngObject to bDataBindable
28780>>>>>>>            Get Main_File of hoServer to iFile
28781>>>>>>>            
28781>>>>>>>            If (NavigateData.eNavigateType=nfFromParent) Begin
28783>>>>>>>
28783>>>>>>>                // Assertion: Check that the constraining table is set properly
28783>>>>>>>                If (iFile<>NavigateData.iTable) Begin
28785>>>>>>>                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromParent"
28786>>>>>>>>
28786>>>>>>>                    Procedure_Return
28787>>>>>>>                End
28787>>>>>>>>
28787>>>>>>>
28787>>>>>>>                Get CurrentRowId of hoServer to ri
28788>>>>>>>                Move (SerializeRowID(ri)) to NavigateData.sRowID 
28789>>>>>>>            End
28789>>>>>>>>
28789>>>>>>>            Else If (NavigateData.eNavigateType=nfFromChild or NavigateData.eNavigateType=nfFromMain) Begin
28792>>>>>>>
28792>>>>>>>                // Assertion: Check that the table is set properly for a from main
28792>>>>>>>                If (NavigateData.eNavigateType=nfFromMain and NavigateData.iTable<>iFile) Begin
28794>>>>>>>                    // With the NavigateInitialize logic we don't always have the right invoking object where this is not an error but something we want to correct
28794>>>>>>>                    Move NavigateData.iTable to iFile
28795>>>>>>>//                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromMain"
28795>>>>>>>//                    Procedure_Return
28795>>>>>>>                End
28795>>>>>>>>
28795>>>>>>>                // Assertion: Check that the table is set properly for a from child
28795>>>>>>>                If (NavigateData.eNavigateType=nfFromChild and (NavigateData.iTable=0 or NavigateData.iTable=iFile)) Begin
28797>>>>>>>                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromChild"
28798>>>>>>>>
28798>>>>>>>                    Procedure_Return
28799>>>>>>>                End
28799>>>>>>>>
28799>>>>>>>
28799>>>>>>>                // use the DDO that owns the file 
28799>>>>>>>                Get Data_Set of hoServer NavigateData.iTable to hoDDO
28800>>>>>>>                If hoDDO Begin
28802>>>>>>>                    Get CurrentRowId of hoDDO to ri
28803>>>>>>>                    If (bDataBindable) Begin
28805>>>>>>>                        Get Data_File of hoInvokIngObject  to iFile
28806>>>>>>>                        If (iFile=NavigateData.iTable) Begin
28808>>>>>>>                            Get Data_Field of hoInvokIngObject to iField
28809>>>>>>>                            Move iField to NavigateData.iColumn
28810>>>>>>>                            WebGet pbChanged of hoInvokIngObject to bChanged
28811>>>>>>>                            // if changed we will do item_find (read) to seed this
28811>>>>>>>                            If bChanged Begin
28813>>>>>>>                                // note this deferred (a DDO read)
28813>>>>>>>                                Send Item_Find of hoServer GE iFile iField True False True
28814>>>>>>>                                Move (GetRowID(iFile)) to ri
28815>>>>>>>                            End
28815>>>>>>>>
28815>>>>>>>                        End
28815>>>>>>>>
28815>>>>>>>                    End
28815>>>>>>>>
28815>>>>>>>                    Move (SerializeRowID(ri)) to NavigateData.sRowID    // Store the resulting RowID
28816>>>>>>>                End
28816>>>>>>>>
28816>>>>>>>            End
28816>>>>>>>>
28816>>>>>>>            // If undefined we provide no extra information. Trying to guess what the developer wants
28816>>>>>>>            // to do will just make things too confusing. Use OnGetNavigateForwardData to set whatever you want 
28816>>>>>>>        End
28816>>>>>>>>
28816>>>>>>>    End_Procedure
28817>>>>>>>    
28817>>>>>>>    // loads default data for NavigateData for a NavigateClose
28817>>>>>>>    // This must be executed from the point of view
28817>>>>>>>    // of the invoking object, which is the object that calls this.
28817>>>>>>>    
28817>>>>>>>    Procedure LoadDefaultNavigateBackData Handle hoInvokingObject tWebNavigateData ByRef NavigateData
28819>>>>>>>        Integer iFile iField
28819>>>>>>>        Handle hoServer
28819>>>>>>>        Boolean bChanged bDataBindable
28819>>>>>>>        RowID ri
28819>>>>>>>        
28819>>>>>>>        // Populate the Navigate Data struct with the best guess values from
28819>>>>>>>        // this control's server DDO
28819>>>>>>>        // If this is called from outside a view, like a main menu, this should
28819>>>>>>>        // delegate to cWebApp and return 0.
28819>>>>>>>        Get Server of hoInvokingObject to hoServer
28820>>>>>>>        If (hoServer) Begin
28822>>>>>>>            Get pbDataBindable of hoInvokingObject to bDataBindable
28823>>>>>>>            Get CurrentRowId of hoServer to ri
28824>>>>>>>            Move (SerializeRowID(ri)) to NavigateData.sRowID 
28825>>>>>>>            Get Main_File of hoServer to NavigateData.iTable
28826>>>>>>>            
28826>>>>>>>            If (bDataBindable) Begin
28828>>>>>>>                Get Data_File of hoInvokingObject  to iFile
28829>>>>>>>                Get Data_Field of hoInvokingObject to iField
28830>>>>>>>                
28830>>>>>>>                Move iFile  to NavigateData.iTable
28831>>>>>>>                Move iField to NavigateData.iColumn
28832>>>>>>>            End
28832>>>>>>>>
28832>>>>>>>        End
28832>>>>>>>>
28832>>>>>>>    
28832>>>>>>>    End_Procedure
28833>>>>>>>    
28833>>>>>>>    
28833>>>>>>>    // Triggers an update of the state hash and pushes it to the history stack.
28833>>>>>>>    //
28833>>>>>>>    // Params:
28833>>>>>>>    //      bReplace    If true the new state will replace the existing state instead of pushing a 
28833>>>>>>>    //                  new history item.
28833>>>>>>>    Procedure UpdateStateHash Boolean bReplace
28835>>>>>>>        String sPrevHash sStateHash
28835>>>>>>>        
28835>>>>>>>        If (peApplicationStateMode(Host(Self)) <> asmOff) Begin
28837>>>>>>>            Get GenerateStateHash to sStateHash
28838>>>>>>>
28838>>>>>>>            If (bReplace) Begin
28840>>>>>>>                Get StateHash of (Host(Self)) to sPrevHash
28841>>>>>>>                If (sStateHash <> sPrevHash) Begin
28843>>>>>>>                    Send SetStateHash of (Host(Self)) sStateHash "" True
28844>>>>>>>                End
28844>>>>>>>>
28844>>>>>>>            End
28844>>>>>>>>
28844>>>>>>>            Else Begin
28845>>>>>>>                Send SetStateHash of (Host(Self)) sStateHash "" False
28846>>>>>>>            End
28846>>>>>>>>
28846>>>>>>>        End
28846>>>>>>>>
28846>>>>>>>    End_Procedure
28847>>>>>>>    
28847>>>>>>>    
28847>>>>>>>    // Triggered when a state hash is defined allowing the application to add a custom piece to the
28847>>>>>>>    // hash. This piece can be used inside OnShow / OnLoad / OnNavigateForward to restore the state.
28847>>>>>>>    //
28847>>>>>>>    // Params:
28847>>>>>>>    //      ByRef sStateHash    String that should be filled with the custom hash.
28847>>>>>>>    Procedure OnDefineCustomStateHash String ByRef sStateHash
28849>>>>>>>    End_Procedure
28850>>>>>>>    
28850>>>>>>>    
28850>>>>>>>    // Determines the custom state hash by parsing it out of the view state hash. The view state
28850>>>>>>>    // has is retrieved form the navigation data or read directly from the url.
28850>>>>>>>    //
28850>>>>>>>    // Returns:
28850>>>>>>>    //      Custom state hash.
28850>>>>>>>    Function CustomStateHash Returns String
28852>>>>>>>        Integer eViewStyle
28852>>>>>>>        String sStateHash sView sRecordId sCustomHash
28852>>>>>>>        tWebNavigateData navData
28852>>>>>>>        tWebNavigateData navData
28852>>>>>>>        
28852>>>>>>>        Get peWebViewStyle to eViewStyle
28853>>>>>>>        
28853>>>>>>>        If (eViewStyle = wvsDesktop) Begin
28855>>>>>>>            Get StateHash of (Host(Self)) to sStateHash
28856>>>>>>>        End
28856>>>>>>>>
28856>>>>>>>        Else If (eViewStyle = wvsDrillDown or eViewStyle = wvsDialog) Begin
28859>>>>>>>            Get GetNavigateData to navData
28860>>>>>>>            Get NamedValueGet navData.NamedValues "Init_StateHash" to sStateHash
28861>>>>>>>        End
28861>>>>>>>>
28861>>>>>>>        
28861>>>>>>>        Send ParseViewStateHash of (Host(Self)) sStateHash (&sView) (&sRecordId) (&sCustomHash)
28862>>>>>>>        
28862>>>>>>>        Function_Return sCustomHash
28863>>>>>>>    End_Function
28864>>>>>>>    
28864>>>>>>>    
28864>>>>>>>    // Converts a record id from a hash for a specific table into a rowid. By default it offloads
28864>>>>>>>    // this to RecordIdToRowId of the Data Dictionary.
28864>>>>>>>    //
28864>>>>>>>    // Params:
28864>>>>>>>    //      iFile       File number.
28864>>>>>>>    //      sRecordId   String representing the record id.
28864>>>>>>>    //      rRowId      (ByRef) Filled with the rowid by this function.
28864>>>>>>>    // Returns:
28864>>>>>>>    //      True if the record id is valid.
28864>>>>>>>    Function HashRecordIdToRowId Integer iFile String sRecordId RowID ByRef rRowId Returns Boolean
28866>>>>>>>        Handle hoMainDD hoDD
28866>>>>>>>        Boolean bFound
28866>>>>>>>        
28866>>>>>>>        Move True to bFound
28867>>>>>>>        
28867>>>>>>>        Get Main_DD to hoMainDD
28868>>>>>>>        If (hoMainDD > 0) Begin
28870>>>>>>>            Get Data_Set of hoMainDD iFile to hoDD
28871>>>>>>>            
28871>>>>>>>            If (hoDD > 0) Begin
28873>>>>>>>                If (Lowercase(sRecordId) <> (Lowercase(psStateNewRecordId(Self)))) Begin
28875>>>>>>>                    Get RecordIdToRowId of hoDD sRecordId (&rRowId) to bFound
28876>>>>>>>                End
28876>>>>>>>>
28876>>>>>>>            End
28876>>>>>>>>
28876>>>>>>>        End
28876>>>>>>>>
28876>>>>>>>        
28876>>>>>>>        Function_Return bFound
28877>>>>>>>    End_Function
28878>>>>>>>    
28878>>>>>>>    
28878>>>>>>>    // Converts a rowid into a state hash record id (a readable format). By default this is
28878>>>>>>>    // offloaded to the Data Dictionary RowIdToRecordId logic that works on the primary key.
28878>>>>>>>    //
28878>>>>>>>    // Params:
28878>>>>>>>    //      iFile       File number.
28878>>>>>>>    //      sRowId      Serialized rowid.
28878>>>>>>>    // Returns:
28878>>>>>>>    //      Record id.
28878>>>>>>>    Function GenerateStateHashRecordId Integer iFile RowID rRowId Returns String
28880>>>>>>>        Handle hoMainDD hoDD
28880>>>>>>>        String sRecordId
28880>>>>>>>        
28880>>>>>>>        
28880>>>>>>>        Get Main_DD to hoMainDD
28881>>>>>>>        If (hoMainDD > 0) Begin
28883>>>>>>>            Get Data_Set of hoMainDD iFile to hoDD
28884>>>>>>>            
28884>>>>>>>            If (hoDD > 0) Begin
28886>>>>>>>                If (IsNullRowID(rRowId)) Begin
28888>>>>>>>                    Move (psStateNewRecordId(Self)) to sRecordId
28889>>>>>>>                End
28889>>>>>>>>
28889>>>>>>>                Else Begin
28890>>>>>>>                    Get RowIdToRecordId of hoDD rRowId to sRecordId
28891>>>>>>>                End
28891>>>>>>>>
28891>>>>>>>            End
28891>>>>>>>>
28891>>>>>>>        End
28891>>>>>>>>
28891>>>>>>>        
28891>>>>>>>        Function_Return sRecordId
28892>>>>>>>    End_Function
28893>>>>>>>    
28893>>>>>>>    
28893>>>>>>>    // Generates the view state hash for the drill-down model. Recursively calls its invoking view
28893>>>>>>>    // (if it is in sync) to get the entire view stack in the hash.
28893>>>>>>>    //
28893>>>>>>>    // Returns:
28893>>>>>>>    //      View state hash including hashes of invoking views.
28893>>>>>>>    Function GenerateStateHash_DrillDown Returns String
28895>>>>>>>        String sInvokingHash sViewHash sHash sName sId sCustom sRowId
28895>>>>>>>        Boolean bInScope
28895>>>>>>>        Handle hoInvokingView hoDefault hoMain hoInvokingObject
28895>>>>>>>        tWebNavigateData navData
28895>>>>>>>        tWebNavigateData navData
28895>>>>>>>        Integer eViewType eStateMode
28895>>>>>>>        RowID rRowId
28895>>>>>>>        
28895>>>>>>>        Get InvokingViewHandleByView of (ViewStack(Self)) Self to hoInvokingView
28896>>>>>>>        Get peStateMode to eStateMode
28897>>>>>>>        Get GetDefaultView of (Host(Self)) to hoDefault
28898>>>>>>>        
28898>>>>>>>        
28898>>>>>>>        If (eStateMode <> vsmOff) Begin
28900>>>>>>>            Get peViewType to eViewType
28901>>>>>>>            
28901>>>>>>>            
28901>>>>>>>            //  For zoom views or record views we look at the main DD
28901>>>>>>>            If (eStateMode = vsmRecord or (eViewType = vtZoom and eStateMode = vsmDefault)) Begin
28903>>>>>>>                Get Main_DD to hoMain
28904>>>>>>>                
28904>>>>>>>                If (hoMain > 0) Begin
28906>>>>>>>                    Get CurrentRowId of hoMain to rRowId
28907>>>>>>>                    
28907>>>>>>>                    Get GenerateStateHashRecordId (Main_File(hoMain)) rRowId to sId
28908>>>>>>>                End
28908>>>>>>>>
28908>>>>>>>            End
28908>>>>>>>>
28908>>>>>>>            Else If (eStateMode = vsmDefault) Begin
28911>>>>>>>                //  For other views we we look at the navigation data (if eStatEMode is default)
28911>>>>>>>                Get GetNavigateData to navData
28912>>>>>>>                
28912>>>>>>>                Case Begin
28912>>>>>>>                    Case (navData.eNavigateType = nfFromParent)
28914>>>>>>>                    Case (navData.eNavigateType = nfFromChild)
28917>>>>>>>                    Case (navData.eNavigateType = nfFromMain) 
28920>>>>>>>                        If (hoInvokingView = C_WebUnresolvedObject) Begin
28922>>>>>>>                            Function_Return ""
28923>>>>>>>                        End
28923>>>>>>>>
28923>>>>>>>                        
28923>>>>>>>                        If (navData.bNewRecord) Begin
28925>>>>>>>                            Move "" to sId    
28926>>>>>>>                        End
28926>>>>>>>>
28926>>>>>>>                        Else Begin
28927>>>>>>>                            Move navData.sRowID to sRowId
28928>>>>>>>                        End
28928>>>>>>>>
28928>>>>>>>                        
28928>>>>>>>                        Get GenerateStateHashRecordId of hoInvokingView navData.iTable (DeserializeRowID(sRowId)) to sId
28929>>>>>>>                        
28929>>>>>>>                        Case Break
28930>>>>>>>                Case End
28930>>>>>>>            End
28930>>>>>>>>
28930>>>>>>>        
28930>>>>>>>            Get GetInvokingObject to hoInvokingObject
28931>>>>>>>            Get StateHashKey hoInvokingObject to sName
28932>>>>>>>            
28932>>>>>>>            If (sName <> "") Begin
28934>>>>>>>                Send OnDefineCustomStateHash (&sCustom)
28935>>>>>>>            
28935>>>>>>>                Get ConcatViewStateHash of (Host(Self)) sName sId sCustom to sViewHash
28936>>>>>>>            End
28936>>>>>>>>
28936>>>>>>>        End
28936>>>>>>>>
28936>>>>>>>        
28936>>>>>>>        If (hoInvokingView <> C_WebUnresolvedObject) Begin
28938>>>>>>>            Get IsInCallActionScope of hoInvokingView to bInScope
28939>>>>>>>            If (bInScope) Begin
28941>>>>>>>                Get GenerateStateHash_DrillDown of hoInvokingView to sInvokingHash
28942>>>>>>>                WebSet psInvokingStateHash to sInvokingHash
28943>>>>>>>            End
28943>>>>>>>>
28943>>>>>>>            Else Begin
28944>>>>>>>                WebGet psInvokingStateHash to sInvokingHash 
28945>>>>>>>            End
28945>>>>>>>>
28945>>>>>>>            
28945>>>>>>>        End
28945>>>>>>>>
28945>>>>>>>        
28945>>>>>>>        If (eStateMode <> vsmOff) Begin
28947>>>>>>>            Get AppendStateHash of (Host(Self)) sInvokingHash sViewHash to sHash
28948>>>>>>>        End
28948>>>>>>>>
28948>>>>>>>        Else Begin
28949>>>>>>>            Move sInvokingHash to sHash
28950>>>>>>>        End
28950>>>>>>>>
28950>>>>>>>        
28950>>>>>>>        Function_Return sHash
28951>>>>>>>    End_Function
28952>>>>>>>    
28952>>>>>>>
28952>>>>>>>    // Restores the view state for desktop style by performing a find if needed.
28952>>>>>>>    //
28952>>>>>>>    // Params:
28952>>>>>>>    //      sRecordId       Record id.
28952>>>>>>>    //      bManualEnter    True if the state was changed manually so a find should be done (the
28952>>>>>>>    //                      back button won't cause a find on desktop-style).
28952>>>>>>>    Procedure RestoreViewState_Desktop String sRecordId Boolean bManualEnter
28954>>>>>>>        String sRowId
28954>>>>>>>        Integer iPos
28954>>>>>>>        Handle hoMain
28954>>>>>>>        RowID rRowId
28954>>>>>>>        Boolean bValid
28954>>>>>>>        
28954>>>>>>>        If (pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self)) Begin
28956>>>>>>>            If (bManualEnter) Begin
28958>>>>>>>                Get Main_DD to hoMain
28959>>>>>>>                
28959>>>>>>>                If (hoMain > 0) Begin
28961>>>>>>>                    Get HashRecordIdToRowId (Main_File(hoMain)) sRecordId (&rRowId) to bValid  
28962>>>>>>>                    If (bValid and not(IsSameRowID(CurrentRowId(hoMain), rRowId))) Begin
28964>>>>>>>                        Send FindByRowId of hoMain (Main_File(hoMain)) rRowId
28965>>>>>>>                    End
28965>>>>>>>>
28965>>>>>>>                    Else If (not(bValid)) Begin
28968>>>>>>>                        
28968>>>>>>>                        If (pbStateHashInvalidError(Host(Self))) Begin
28970>>>>>>>                            Error DFERR_WEBAPP_INVALID_URL_REC
28971>>>>>>>>
28971>>>>>>>                        End
28971>>>>>>>>
28971>>>>>>>                        Send Clear of hoMain
28972>>>>>>>                    End
28972>>>>>>>>
28972>>>>>>>                End
28972>>>>>>>>
28972>>>>>>>            End
28972>>>>>>>>
28972>>>>>>>            Else Begin
28973>>>>>>>                Send UpdateStateHash True
28974>>>>>>>            End
28974>>>>>>>>
28974>>>>>>>        End
28974>>>>>>>>
28974>>>>>>>    End_Procedure
28975>>>>>>>    
28975>>>>>>>    
28975>>>>>>>    // Generates the view state hash for desktop-style.
28975>>>>>>>    //
28975>>>>>>>    // Returns:
28975>>>>>>>    //      View state string.
28975>>>>>>>    Function GenerateStateHash_Desktop Returns String
28977>>>>>>>        String sState sName sCustom sRowId sRecordId
28977>>>>>>>        Handle hoMain
28977>>>>>>>        RowID rRowId
28977>>>>>>>        Integer eStateMode
28977>>>>>>>        
28977>>>>>>>        Get peStateMode to eStateMode
28978>>>>>>>        
28978>>>>>>>        If (eStateMode = vsmOff) Begin
28980>>>>>>>            Function_Return ""
28981>>>>>>>        End
28981>>>>>>>>
28981>>>>>>>        
28981>>>>>>>        If ((eStateMode = vsmDefault or eStateMode = vsmRecord) and pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self)) Begin
28983>>>>>>>            Get Main_DD to hoMain
28984>>>>>>>            If (hoMain > 0) Begin
28986>>>>>>>                Get CurrentRowId of hoMain to rRowId
28987>>>>>>>                
28987>>>>>>>                Get GenerateStateHashRecordId (Main_File(hoMain)) rRowId to sRecordId
28988>>>>>>>            End
28988>>>>>>>>
28988>>>>>>>        End
28988>>>>>>>>
28988>>>>>>>        
28988>>>>>>>        Get psStateViewName to sName
28989>>>>>>>        
28989>>>>>>>        Send OnDefineCustomStateHash (&sCustom)
28990>>>>>>>        
28990>>>>>>>        Get ConcatViewStateHash of (Host(Self)) sName sRecordId sCustom to sState
28991>>>>>>>        
28991>>>>>>>        Function_Return sState
28992>>>>>>>    End_Function
28993>>>>>>>    
28993>>>>>>>    
28993>>>>>>>    // Generates the current state hash for this view.
28993>>>>>>>    //
28993>>>>>>>    // Returns:
28993>>>>>>>    //      State hash for this view (for drill-down this includes invoking view hashes).
28993>>>>>>>    Function GenerateStateHash Returns String
28995>>>>>>>        Integer eViewStyle
28995>>>>>>>        String sResult
28995>>>>>>>        
28995>>>>>>>        Get peWebViewStyle to eViewStyle
28996>>>>>>>        If (eViewStyle = wvsDesktop) Begin
28998>>>>>>>            Get GenerateStateHash_Desktop to sResult    
28999>>>>>>>        End
28999>>>>>>>>
28999>>>>>>>        Else If (eViewStyle = wvsDrillDown or eViewStyle = wvsDialog) Begin
29002>>>>>>>            Get GenerateStateHash_DrillDown to sResult
29003>>>>>>>        End
29003>>>>>>>>
29003>>>>>>>        
29003>>>>>>>        Function_Return sResult
29004>>>>>>>    End_Function
29005>>>>>>>    
29005>>>>>>>    // Updates the page title with the current view title (if pbUpdateApplicationTitle of cWebApp 
29005>>>>>>>    // is true).
29005>>>>>>>    Procedure UpdatePageTitle
29007>>>>>>>        String sViewTitle
29007>>>>>>>        Boolean bUpdate
29007>>>>>>>        
29007>>>>>>>        WebGet pbUpdateApplicationTitle of (Host(Self)) to bUpdate
29008>>>>>>>        
29008>>>>>>>        If (bUpdate) Begin
29010>>>>>>>            If (peWebViewStyle(Self) = wvsDrillDown) Begin
29012>>>>>>>                Get GetHeaderCaption to sViewTitle
29013>>>>>>>            End
29013>>>>>>>>
29013>>>>>>>            Else Begin
29014>>>>>>>                WebGet psCaption to sViewTitle
29015>>>>>>>            End
29015>>>>>>>>
29015>>>>>>>            
29015>>>>>>>            Send UpdatePageTitle of (Host(Self)) Self sViewTitle
29016>>>>>>>        End    
29016>>>>>>>>
29016>>>>>>>    End_Procedure
29017>>>>>>>    
29017>>>>>>>    
29017>>>>>>>    // Default refresh logic that updates the state hash when the record changes.
29017>>>>>>>    // 
29017>>>>>>>    // Params:
29017>>>>>>>    //      eMode   The refresh mode.
29017>>>>>>>    Procedure Refresh Integer eMode
29019>>>>>>>        String sName sHash sView 
29019>>>>>>>        Integer eViewType eViewStyle eStateMode iIndex
29019>>>>>>>        tWebNavigateData navData
29019>>>>>>>        tWebNavigateData navData
29019>>>>>>>        
29019>>>>>>>        Forward Send Refresh eMode
29021>>>>>>>                
29021>>>>>>>        // if application style is wvsNone it is a basic non-framework application that does handle web-views at
29021>>>>>>>        // all - refresh should do nothing. This allows web lookups to get added to a basic webapp. While
29021>>>>>>>        // compiled, we don't want to use them.        
29021>>>>>>>        If (peApplicationStyle(Host(Self)) = wvsNone or peApplicationStateMode(Host(Self)) = asmOff) ;            Procedure_Return
29024>>>>>>>        
29024>>>>>>>        If (not(AppSynching(Owner(Self)))) Begin
29026>>>>>>>            If (phoLoadView(Host(Self)) <> Self and phoCurrentShowView(Host(Self)) <> Self and not(pbNavigating(Self)) and not(pbInitForShow(Self))) Begin
29028>>>>>>>                Get peViewType to eViewType
29029>>>>>>>                Get peWebViewStyle to eViewStyle
29030>>>>>>>                Get peStateMode to eStateMode
29031>>>>>>>                
29031>>>>>>>                If (eViewStyle = wvsDrillDown) Begin
29033>>>>>>>                    If (eStateMode = vsmRecord or (eViewStyle = wvsDrillDown and eViewType = vtZoom and eStateMode = vsmDefault)) Begin
29035>>>>>>>                        //  Check if still initializing (we can't check if the name is in the URL because the statehash might not be up-to-date)
29035>>>>>>>                        Get GetNavigateData to navData
29036>>>>>>>                        Get NamedValueIndex navData.NamedValues "Init_Mode" to iIndex
29037>>>>>>>                        If (iIndex < 0) Begin
29039>>>>>>>                            Send UpdateStateHash True
29040>>>>>>>                        End
29040>>>>>>>>
29040>>>>>>>                    End
29040>>>>>>>>
29040>>>>>>>                End
29040>>>>>>>>
29040>>>>>>>                Else Begin
29041>>>>>>>                    If (eStateMode = vsmRecord or (eStateMode = vsmDefault and pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self))) Begin
29043>>>>>>>                        Get psStateViewName to sName
29044>>>>>>>                        Get StateHash of (Host(Self)) to sHash
29045>>>>>>>                        Send ParseViewStateHash sHash (&sView)        
29046>>>>>>>                        
29046>>>>>>>                        If (lowercase(sName) = Lowercase(sView)) Begin
29048>>>>>>>                            Send UpdateStateHash True
29049>>>>>>>                        End
29049>>>>>>>>
29049>>>>>>>                    End
29049>>>>>>>>
29049>>>>>>>                End
29049>>>>>>>>
29049>>>>>>>            End
29049>>>>>>>>
29049>>>>>>>        End
29049>>>>>>>>
29049>>>>>>>    End_Procedure
29050>>>>>>>    
29050>>>>>>>    
29050>>>>>>>    // This is an event hook sent to a view during NavigateForward. 
29050>>>>>>>    // You can augment this event to modify the view based on the 
29050>>>>>>>    // navigation context that is passed in the NavigateData parameter.
29050>>>>>>>    //
29050>>>>>>>    // You would typically use this event when a view is re-used in 
29050>>>>>>>    // different contexts within your application and you would like 
29050>>>>>>>    // to modify the appearance and features of the view accordingly.
29050>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
29052>>>>>>>    End_Procedure
29053>>>>>>>    
29053>>>>>>>    // Callback handler for the Show function used when navigating into a desktop view with the 
29053>>>>>>>    // drilldown model. It adds the view to the stack, now that we know for sure that it is in sync.
29053>>>>>>>    Procedure Show_CallBack Handle hoView
29055>>>>>>>        Send PushView to (ViewStack(Self)) hoView nfUndefined
29056>>>>>>>    End_Procedure
29057>>>>>>>
29057>>>>>>>    // This is overridden to handle desktop and drill down views.
29057>>>>>>>    // 1. if this is a dialog or if there is no stack, it just does a normal show
29057>>>>>>>    // dfirst Clear the view stack down as far as the default
29057>>>>>>>    // view, then load this view.
29057>>>>>>>    //
29057>>>>>>>    // Note: Augmenting this here means two things:
29057>>>>>>>    // 1. The application already supports the View Stack (drill-down)
29057>>>>>>>    // 2. That the Show command in the superclass does -not- try to manipulate the view stack.  
29057>>>>>>>    Procedure Show
29059>>>>>>>        Handle hoDefaultView hoTopView
29059>>>>>>>        Integer eWebViewStyle
29059>>>>>>>        Boolean bOK bUnconditional
29059>>>>>>>        Get peWebViewStyle to eWebViewStyle
29060>>>>>>>        If ((ViewStack(Self))=0 or eWebViewStyle=wvsDialog) Begin
29062>>>>>>>            Forward Send Show
29064>>>>>>>        End
29064>>>>>>>>
29064>>>>>>>        Else If (eWebViewStyle = wvsDesktop) Begin
29067>>>>>>>            Get GetDefaultView to hoDefaultView
29068>>>>>>>            Get TopViewHandle of (ViewStack(Self)) to hoTopView
29069>>>>>>>            Move (hoTopView=0 or peWebViewStyle(hoTopView)=wvsDesktop) to bUnconditional
29070>>>>>>>            Get Reset of (ViewStack(Self)) True bUnconditional to bOK
29071>>>>>>>            If bOK Begin
29073>>>>>>>                // if a non-drilldown just show and add to view stack
29073>>>>>>>                Send SetInvokingObject 0
29074>>>>>>>                Send ShowView to (Host(Self)) Self (RefProc(Show_CallBack)) Self
29075>>>>>>>            End
29075>>>>>>>>
29075>>>>>>>        End
29075>>>>>>>>
29075>>>>>>>        // moving to a drill down view - same as NavigateBegin
29075>>>>>>>        Else Begin
29076>>>>>>>            Send NavigatePathBegin Self False
29077>>>>>>>        End
29077>>>>>>>>
29077>>>>>>>    End_Procedure
29078>>>>>>>
29078>>>>>>>
29078>>>>>>>    // Send this to update psInvokingView of this view to the name of the next view down
29078>>>>>>>    // in the view stack. Also, psInvokingView of this next view down is set to "".
29078>>>>>>>    // This ensures that Only to top view in the view stack and its invoking view are synchronized.
29078>>>>>>>    // The view that receives this message should be the top view in the view stack. 
29078>>>>>>>    Procedure UpdateInvokingViewDrillDownStyle
29080>>>>>>>        Handle hoInvokingView
29080>>>>>>>        String sInvokingView
29080>>>>>>>        
29080>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoInvokingView
29081>>>>>>>        
29081>>>>>>>        If (hoInvokingView = 0) Begin
29083>>>>>>>            Move "" to sInvokingView
29084>>>>>>>        End
29084>>>>>>>>
29084>>>>>>>        Else Begin
29085>>>>>>>            Get WebObjectName of hoInvokingView to sInvokingView
29086>>>>>>>            WebSet psInvokingView of hoInvokingView to ""
29087>>>>>>>        End
29087>>>>>>>>
29087>>>>>>>        
29087>>>>>>>        WebSet psInvokingView to sInvokingView
29088>>>>>>>    End_Procedure
29089>>>>>>>    
29089>>>>>>>    //  Empty stub of cWebModalDialog API to prevent issues when delegating this message from controls (cWebPromptList).
29089>>>>>>>    Procedure NotifyCloseModalDialog
29091>>>>>>>    End_Procedure
29092>>>>>>>    
29092>>>>>>>    //  Empty stub of cWebModalDialog API to prevent issues when delegating this message from controls (cWebPromptList).
29092>>>>>>>    Function ReturnObject Returns Handle
29094>>>>>>>        Function_Return C_WebUnresolvedObject
29095>>>>>>>    End_Function
29096>>>>>>>    
29096>>>>>>>    
29096>>>>>>>    // hook called during End_Construct_Object that provides developer a way
29096>>>>>>>    // to customize any properties based on peWebViewStyle. To be used in a 
29096>>>>>>>    // sub-class or object. 
29096>>>>>>>    Procedure OnCustomizeWebViewStyle
29098>>>>>>>    End_Procedure
29099>>>>>>>    
29099>>>>>>>    Procedure PostSerializeObject
29101>>>>>>>        //  Assing key handlers
29101>>>>>>>        Send DefaultKeyHandlers
29102>>>>>>>    End_Procedure
29103>>>>>>>    
29103>>>>>>>    // Hides all active dialogs
29103>>>>>>>    Procedure HideAllDialogs
29105>>>>>>>        Handle hoView
29105>>>>>>>        String sInvokingView
29105>>>>>>>        Integer eViewStyle iCount
29105>>>>>>>        tWebViewInfo[] aViewStack
29105>>>>>>>        tWebViewInfo[] aViewStack
29106>>>>>>>        
29106>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
29107>>>>>>>        // We start from the 2nd last element going down
29107>>>>>>>        Move (SizeOfArray(aViewStack)-1) to iCount
29108>>>>>>>        
29108>>>>>>>        While (iCount <> 0)
29112>>>>>>>            Get WebObjectByName aViewStack[iCount].sViewName False to hoView
29113>>>>>>>            Get peWebViewStyle of hoView to eViewStyle
29114>>>>>>>            //If the previous view isnt a dialog we can stop looking back
29114>>>>>>>            If (eViewStyle <> wvsDialog) Begin
29116>>>>>>>                Procedure_Return
29117>>>>>>>            End
29117>>>>>>>>
29117>>>>>>>            
29117>>>>>>>            Send Hide of hoView
29118>>>>>>>            
29118>>>>>>>            Decrement iCount
29119>>>>>>>        Loop
29120>>>>>>>>
29120>>>>>>>    End_Procedure
29121>>>>>>>    
29121>>>>>>>    // Shows a dialog again. It does this by showing All the previous dialogs in the viewstack up untill the first actual view.
29121>>>>>>>    Procedure RestoreDialog
29123>>>>>>>        Handle hoView hoNextView
29123>>>>>>>        String sViewName
29123>>>>>>>        Integer eViewStyle iIndex iCount iViewsInStack iAmountOfViewsToShow
29123>>>>>>>        Handle[] aViewsToShow
29124>>>>>>>        Boolean bFirstNonDialogView
29124>>>>>>>        tWebViewInfo[] aViewStack
29124>>>>>>>        tWebViewInfo[] aViewStack
29125>>>>>>>        tWebViewInfo searchStack
29125>>>>>>>        tWebViewInfo searchStack
29125>>>>>>>        
29125>>>>>>>        Get psStateViewName to sViewName
29126>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
29127>>>>>>>        Move sViewName to searchStack.sViewName        
29128>>>>>>>        Move (SearchArray(searchStack, aViewStack)) to iIndex
29129>>>>>>>        Move Self to aViewsToShow[-1]
29130>>>>>>>        
29130>>>>>>>        // This should never be possible
29130>>>>>>>        If (iIndex = -1) Begin
29132>>>>>>>            Procedure_Return
29133>>>>>>>        End
29133>>>>>>>>
29133>>>>>>>        
29133>>>>>>>        //Start going down the viewstack, and start showing each view that isnt a drill down view.
29133>>>>>>>        While (not(bFirstNonDialogView))
29137>>>>>>>            Decrement iIndex
29138>>>>>>>            Get FindWebObject of (Owner(Self)) aViewStack[iIndex].sViewName to hoView
29139>>>>>>>            Get peWebViewStyle of hoView to eViewStyle
29140>>>>>>>            Move (InsertInArray(aViewsToShow, 0, hoView)) to aViewsToShow
29141>>>>>>>            
29141>>>>>>>            If (eViewStyle <> wvsDialog) Begin
29143>>>>>>>                Move True to bFirstNonDialogView
29144>>>>>>>            End
29144>>>>>>>>
29144>>>>>>>        Loop
29145>>>>>>>>
29145>>>>>>>        
29145>>>>>>>        //Now loop through the array of views we should be showing
29145>>>>>>>        Move (SizeOfArray(aViewsToShow)-1) to iAmountOfViewsToShow
29146>>>>>>>        For iCount from 0 to iAmountOfViewsToShow
29152>>>>>>>>
29152>>>>>>>            Send ShowView to (Host(Self)) aViewsToShow[iCount]
29153>>>>>>>        Loop
29154>>>>>>>>
29154>>>>>>>    End_Procedure
29155>>>>>>>    
29155>>>>>>>    // Augmented to add check if view is in sync.
29155>>>>>>>    Function GetAccessible Returns Integer
29157>>>>>>>        Integer iAccessible
29157>>>>>>>        Boolean bInSync
29157>>>>>>>        
29157>>>>>>>        Get IsViewInSync Self to bInSync
29158>>>>>>>        
29158>>>>>>>        If (bInSync) ;            Forward Get GetAccessible to iAccessible
29162>>>>>>>        Else ;            Move 0 to iAccessible
29164>>>>>>>            
29164>>>>>>>        Function_Return iAccessible
29165>>>>>>>    End_Function
29166>>>>>>>    
29166>>>>>>>    // Returns true if the view is in the view stack.
29166>>>>>>>    Function IsInViewStack Returns Boolean
29168>>>>>>>        Integer iIndex
29168>>>>>>>        
29168>>>>>>>        //  If there is no viewstack this is probably not a drill-down application

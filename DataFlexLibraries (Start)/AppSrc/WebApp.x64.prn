30451>>>>>>>>>    // Performs a logout and a reset of the session. May trigger a login if one is required.
30451>>>>>>>>>    Procedure RequestLogout
30453>>>>>>>>>        Boolean bValid
30453>>>>>>>>>        Integer eLoginMode eAppStateMode 
30453>>>>>>>>>        String sStateHash
30453>>>>>>>>>        Handle hoWebApp
30453>>>>>>>>>        
30453>>>>>>>>>        Get Host to hoWebApp
30454>>>>>>>>>        
30454>>>>>>>>>        //  We end the session and create a new one (so the user is logged out)
30454>>>>>>>>>        Send EndSession // close the current session key
30455>>>>>>>>>        Get RecreateSession of hoWebApp to bValid
30456>>>>>>>>>        
30456>>>>>>>>>        //  Now we try to 
30456>>>>>>>>>        Get LoginMode to eLoginMode
30457>>>>>>>>>        
30457>>>>>>>>>        If (eLoginMode = lmLoginRequired) Begin
30459>>>>>>>>>            Get peApplicationStateMode to eAppStateMode
30460>>>>>>>>>            
30460>>>>>>>>>            //  If history management is used we add an entry for the default view, and then refresh, so after login the user gets back to the dashboard
30460>>>>>>>>>            If (eAppStateMode <> asmOff) Begin
30462>>>>>>>>>                Send SetStateHash of hoWebApp "" "" False
30463>>>>>>>>>            End
30463>>>>>>>>>>
30463>>>>>>>>>
30463>>>>>>>>>            Send NavigateRefresh of hoWebApp          // refresh the WebApp at the client (triggers a login)
30464>>>>>>>>>        End
30464>>>>>>>>>>
30464>>>>>>>>>    End_Procedure

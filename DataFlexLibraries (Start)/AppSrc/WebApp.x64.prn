29274>>>>>>>        Handle hoJson
29274>>>>>>>        UChar[] ucData
29275>>>>>>>        
29275>>>>>>>        //  Set headers & status
29275>>>>>>>        Send SetResponseStatus usStatusCode sReason sDescription
29276>>>>>>>        Send AddHttpResponseHeader "Content-Type" "application/json; charset=utf-8"
29277>>>>>>>        Send AddHttpResponseHeader "Cache-Control" "no-cache"
29278>>>>>>>        

9415>>>>>>>Use cBaseErrorHandler.pkg
Including file: cBaseErrorHandler.pkg    (C:\Appl\DataFlex 26.0\Pkg\cBaseErrorHandler.pkg)
9415>>>>>>>>>Use errornum.inc
9415>>>>>>>>>Use cTrappedErrors.pkg
Including file: cTrappedErrors.pkg    (C:\Appl\DataFlex 26.0\Pkg\cTrappedErrors.pkg)
9415>>>>>>>>>>>Define MAX_ERROR_NUMBER for 32766
9415>>>>>>>>>>>
9415>>>>>>>>>>>// This array stores the set of trapped errors as toggled ranges starting
9415>>>>>>>>>>>// with the errors that are trapped. The array should always contain 0 and
9415>>>>>>>>>>>// MAX_ERROR_NUMBER + 1, which are the limits. If an array contained the
9415>>>>>>>>>>>// following items...
9415>>>>>>>>>>>//
9415>>>>>>>>>>>// { 0, 5, 10, MAX_ERROR_NUMBER + 1 }.
9415>>>>>>>>>>>//
9415>>>>>>>>>>>// This would mean that errors 1 - 4 are trapped, 5 - 9 are ignored, and
9415>>>>>>>>>>>// 10 through the rest are trapped.
9415>>>>>>>>>>>//
9415>>>>>>>>>>>Class cTrappedErrors is an array
9416>>>>>>>>>>>    Procedure Construct_Object
9418>>>>>>>>>>>        Forward Send Construct_Object
9420>>>>>>>>>>>        
9420>>>>>>>>>>>        Send initArray
9421>>>>>>>>>>>    End_Procedure
9422>>>>>>>>>>>    
9422>>>>>>>>>>>    // Find largest error LE targetError. Assumes array is sorted.
9422>>>>>>>>>>>    Function findErrorLE Integer targetError Returns Integer
9424>>>>>>>>>>>        
9424>>>>>>>>>>>        Integer lowIndex hiIndex midIndex currError
9424>>>>>>>>>>>        
9424>>>>>>>>>>>        // If error is outside of boudary conditions, use
9424>>>>>>>>>>>        // value of closest valid error# instead.
9424>>>>>>>>>>>        If (targetError <= 0);            Move 1 to targetError
9427>>>>>>>>>>>        Else If (targetError >= MAX_ERROR_NUMBER) ;            Move ( MAX_ERROR_NUMBER - 1 ) to targetError
9431>>>>>>>>>>>        
9431>>>>>>>>>>>        Move 0 to lowIndex
9432>>>>>>>>>>>        Move ( item_count( Self ) - 1 ) to hiIndex
9433>>>>>>>>>>>        
9433>>>>>>>>>>>        // midIndex will contain the closest error LE to target upon exit.
9433>>>>>>>>>>>        Repeat
9433>>>>>>>>>>>>
9433>>>>>>>>>>>            
9433>>>>>>>>>>>            Move ( ( lowIndex + hiIndex ) / 2 ) to midIndex
9434>>>>>>>>>>>            Move ( integer_value( Self, midIndex ) )  to currError
9435>>>>>>>>>>>            
9435>>>>>>>>>>>            // midIndex is targetIndex if a match occurs
9435>>>>>>>>>>>            If (currError = targetError) ;                Function_Return midIndex
9438>>>>>>>>>>>            
9438>>>>>>>>>>>            // We are either on it or just below it.
9438>>>>>>>>>>>            If ( lowIndex = midIndex ) Begin
9440>>>>>>>>>>>                
9440>>>>>>>>>>>                If ( integer_value( Self, hiIndex ) le targetError ) ;                    Move hiIndex to midIndex
9443>>>>>>>>>>>                
9443>>>>>>>>>>>                Function_Return midIndex
9444>>>>>>>>>>>                
9444>>>>>>>>>>>            End
9444>>>>>>>>>>>>
9444>>>>>>>>>>>            
9444>>>>>>>>>>>            // No match, so move the boundaries.
9444>>>>>>>>>>>            If (currError > targetError) ;                Move ( midIndex - 1 ) to hiIndex
9447>>>>>>>>>>>            Else ;                Move midIndex to lowIndex
9449>>>>>>>>>>>            
9449>>>>>>>>>>>        Until lowIndex gt hiIndex
9451>>>>>>>>>>>        
9451>>>>>>>>>>>        Function_Return midIndex
9452>>>>>>>>>>>        
9452>>>>>>>>>>>    End_Function
9453>>>>>>>>>>>    
9453>>>>>>>>>>>    // Boundaries of the table are assumed to hold error limits.
9453>>>>>>>>>>>    Procedure initArray
9455>>>>>>>>>>>        Send delete_data
9456>>>>>>>>>>>        Set array_value  0 to 0
9457>>>>>>>>>>>        Set array_value  1 to ( MAX_ERROR_NUMBER + 1 )
9458>>>>>>>>>>>    End_Procedure
9459>>>>>>>>>>>    
9459>>>>>>>>>>>    // Return 1 if Error is trapped, 0 otherwise.
9459>>>>>>>>>>>    Function IsTrapped Integer Error# Returns Integer
9461>>>>>>>>>>>        Function_Return ( not ( mod( findErrorLE( Self, Error# ), 2 ) ) )
9462>>>>>>>>>>>    End_Function
9463>>>>>>>>>>>    
9463>>>>>>>>>>>    // Add the error as long as it doesn't violate boundary conditions.
9463>>>>>>>>>>>    // This routine leaves the array unsorted.
9463>>>>>>>>>>>    Procedure addError Integer Error#
9465>>>>>>>>>>>        If ( ( Error# lt MAX_ERROR_NUMBER ) and ( Error# gt 0 ) ) ;            Set array_value  ( item_count( Self ) ) to ( Integer( Error# ) )
9468>>>>>>>>>>>    End_Procedure
9469>>>>>>>>>>>    
9469>>>>>>>>>>>    // Set error to flagged state.
9469>>>>>>>>>>>    Procedure handleError Integer Error# Integer trapFlag
9471>>>>>>>>>>>        
9471>>>>>>>>>>>        Integer prevErrIndex prevErrFlag prevErrValue nextErrValue
9471>>>>>>>>>>>        
9471>>>>>>>>>>>        If ( ( Error# gt MAX_ERROR_NUMBER ) or ( Error# lt 0 ) ) Begin
9473>>>>>>>>>>>            Error DFERR_ERROR_NUMBER_OUT_OF_RANGE
9474>>>>>>>>>>>>
9474>>>>>>>>>>>            Procedure_Return
9475>>>>>>>>>>>        End
9475>>>>>>>>>>>>
9475>>>>>>>>>>>        
9475>>>>>>>>>>>        Get findErrorLE Error# to prevErrIndex
9476>>>>>>>>>>>        Get isTrapped   Error# to prevErrFlag
9477>>>>>>>>>>>        
9477>>>>>>>>>>>        // if eq, Error already handled in some range.
9477>>>>>>>>>>>        If (PrevErrFlag <> trapFlag) Begin
9479>>>>>>>>>>>            
9479>>>>>>>>>>>            // This is kind of complicated. If we are adding an error,
9479>>>>>>>>>>>            // we have to account for the error already being in the
9479>>>>>>>>>>>            // array as well as rejoining ranges that have been previously
9479>>>>>>>>>>>            // split and splitting ranges when adding a new flag.
9479>>>>>>>>>>>            
9479>>>>>>>>>>>            Get integer_value  ( prevErrIndex + 1 ) to nextErrValue
9480>>>>>>>>>>>            Get integer_value  prevErrIndex         to prevErrValue
9481>>>>>>>>>>>            
9481>>>>>>>>>>>            // Do this first so prevErrIndex stays valid.
9481>>>>>>>>>>>            If (nextErrValue = ( Error# + 1 )) ;                Send delete_item ( prevErrIndex + 1 )
9484>>>>>>>>>>>            Else ;                Send addError ( Error# + 1 )
9486>>>>>>>>>>>            
9486>>>>>>>>>>>            If ( prevErrValue < Error# ) ;                Send addError Error#
9489>>>>>>>>>>>            Else ;                Send delete_item prevErrIndex
9491>>>>>>>>>>>        End
9491>>>>>>>>>>>>
9491>>>>>>>>>>>        Send sort_items UPWARD_DIRECTION
9492>>>>>>>>>>>        
9492>>>>>>>>>>>    End_Procedure
9493>>>>>>>>>>>    
9493>>>>>>>>>>>    // Flag error as trappable
9493>>>>>>>>>>>    Procedure Trap_Error Integer Error#
9495>>>>>>>>>>>        Send handleError Error# 1
9496>>>>>>>>>>>    End_Procedure
9497>>>>>>>>>>>    
9497>>>>>>>>>>>    // Flag error as non-trappable
9497>>>>>>>>>>>    Procedure Ignore_Error Integer Error#
9499>>>>>>>>>>>        Send handleError Error# 0
9500>>>>>>>>>>>    End_Procedure
9501>>>>>>>>>>>    
9501>>>>>>>>>>>    // Flag all errors as trappable
9501>>>>>>>>>>>    Procedure Trap_All
9503>>>>>>>>>>>        Send initArray
9504>>>>>>>>>>>    End_Procedure
9505>>>>>>>>>>>    
9505>>>>>>>>>>>    // Flag all errors as non-trappable
9505>>>>>>>>>>>    Procedure Ignore_All
9507>>>>>>>>>>>        Send delete_data
9508>>>>>>>>>>>        Set array_value 0 to 0
9509>>>>>>>>>>>        Set array_value 1 to 1
9510>>>>>>>>>>>        Set array_value 2 to ( MAX_ERROR_NUMBER + 1 )
9511>>>>>>>>>>>    End_Procedure

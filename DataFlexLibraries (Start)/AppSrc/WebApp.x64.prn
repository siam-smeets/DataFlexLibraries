35580>>>>>>>        Set pbShowLabel to False
35581>>>>>>>        Set psJSClass to "df.WebBreadcrumb"
35582>>>>>>>        
35582>>>>>>>        // Assert that the WebApp has a view stack object
35582>>>>>>>        If (ViewStack(Self) = C_WebUnresolvedObject) Begin
35584>>>>>>>            Error DFERR_PROGRAM "View stack object missing in application using the breadcrumb control." 
35585>>>>>>>>
35585>>>>>>>        End

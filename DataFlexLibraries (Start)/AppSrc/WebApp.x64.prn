21347>>>>>>>>>        // Indicate that we are finished initializing the WebApp. This comes
21347>>>>>>>>>        // after Forward Send End_Construct_Object to make sure we are fully
21347>>>>>>>>>        // protected.
21347>>>>>>>>>        Set pbInitWebApp to False
21348>>>>>>>>>    End_Procedure

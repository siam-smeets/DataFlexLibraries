10471>>>>>>>>>        
10471>>>>>>>>>        // Get the attribute
10471>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10473>>>>>>>>>            Case Begin
10473>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_COLUMNCOUNT)
10475>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_ROWCOUNT)
10478>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_ROWCOUNT_TYPE)
10481>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_NUMMESSAGES)
10484>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_CURSOR_TYPE)

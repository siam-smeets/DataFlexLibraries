12496>>>>>>>
12496>>>>>>>// Mixin for nodes.
12496>>>>>>>//
12496>>>>>>>//  First the declaration of functions that have no object references.
12496>>>>>>>//
12496>>>>>>>
12496>>>>>>>
12496>>>>>>>Class cXMLDOMNodeMixin is a Mixin
12497>>>>>>>    
12497>>>>>>>    Import_Class_Protocol cXMLDOMMixin
12498>>>>>>>    
12498>>>>>>>    //  Append Node to the end of list. Returns passed Object handle if Ok, 0 if error
12498>>>>>>>    
12498>>>>>>>    Function AppendNode Handle hoNode Returns Handle
12500>>>>>>>        Handle hinfcNode
12500>>>>>>>        Handle infcReturned
12500>>>>>>>        // Get COM Interface to call Append child.
12500>>>>>>>        Get XMLInterface of hoNode to hinfcNode
12501>>>>>>>        If (hinfcNode=0) ;            Function_Return 0
12504>>>>>>>        Get AppendChild hinfcNode to infcReturned
12505>>>>>>>        // Interface returned is stored in DataFlex object.
12505>>>>>>>        If (infcReturned=0) ;            Function_Return 0
12508>>>>>>>        Set XMLInterface of hoNode to infcReturned
12509>>>>>>>        Function_Return hoNode
12510>>>>>>>    End_Function
12511>>>>>>>    
12511>>>>>>>    //  Insert NewNode before Node. Returns passed newnode Object handle if Ok, 0 if error
12511>>>>>>>    
12511>>>>>>>    Function InsertBeforeNode Handle hoNewNode Handle hoNode Returns Handle
12513>>>>>>>        Handle hinfcNewNode hinfcNode hoRefNode infcReturned
12513>>>>>>>        Integer iType
12513>>>>>>>        // DOM says if no refnode argument passed or it is 0, append to end
12513>>>>>>>        If (Num_Arguments=1) ;            Move 0 to hoRefNode
12516>>>>>>>        Else ;            Move hoNode to hoRefNode
12518>>>>>>>        Get XMLInterface of hoNewNode to hinfcNewNode
12519>>>>>>>        If (hinfcNewNode=0) ;            Function_Return 0
12522>>>>>>>        If hoRefNode Begin
12524>>>>>>>            Get XMLInterface of hoRefNode to hinfcNode
12525>>>>>>>            If (hinfcNode=0) ;                Function_Return 0
12528>>>>>>>        End
12528>>>>>>>>
12528>>>>>>>        Get InsertBefore hinfcNewNode hinfcNode to infcReturned
12529>>>>>>>        If (infcReturned=0) ;            Function_Return 0
12532>>>>>>>        // Interface returned is stored in DataFlex object.
12532>>>>>>>        Set XMLInterface of hoNewNode to infcReturned
12533>>>>>>>        Function_Return hoNewNode
12534>>>>>>>    End_Function
12535>>>>>>>    
12535>>>>>>>    //  Remove Node. Returns object Id of removed node, zero if error
12535>>>>>>>    //  Important: The node is not destroyed! This lets you move it elsewhere if you want
12535>>>>>>>    
12535>>>>>>>    Function RemoveNode Handle hoNode Returns Handle
12537>>>>>>>        Handle hInfcNode
12537>>>>>>>        Get XMLInterface of hoNode to hInfcNode
12538>>>>>>>        If (hinfcNode=0) ;            Function_Return 0
12541>>>>>>>        Get RemoveChild hInfcNode to hinfcNode
12542>>>>>>>        If (hinfcNode=0) ;            Function_Return 0
12545>>>>>>>        Set XMLInterface of hoNode to hinfcNode
12546>>>>>>>        Function_Return hoNode
12547>>>>>>>    End_Function
12548>>>>>>>    
12548>>>>>>>    //  Replace Node. Returns object Id of replaced node, zero if error
12548>>>>>>>    //  Important: The replaced node is not destroyed! This lets you move it elsewhere if you want
12548>>>>>>>    
12548>>>>>>>    Function ReplaceNode Handle hoNewNode Handle hoNodeToReplace Returns Handle
12550>>>>>>>        Handle hInfcNewNode hinfcNodetoReplace hinfcNode
12550>>>>>>>        Get XMLInterface of hoNewNode       to hInfcNewNode
12551>>>>>>>        Get XMLInterface of hoNodetoReplace to hInfcNodetoreplace
12552>>>>>>>        If (hinfcNewNode=0 or hInfcNodeToReplace=0) ;            Function_Return 0
12555>>>>>>>        Get ReplaceChild hInfcNewNode hinfcNodeToReplace to hinfcNode
12556>>>>>>>        If (hinfcNode=0) ;            Function_Return 0
12559>>>>>>>        Set XMLInterface of hoNodetoReplace to hinfcNode
12560>>>>>>>        Function_Return hoNodetoReplace
12561>>>>>>>    End_Function
12562>>>>>>>    
12562>>>>>>>    // Remove the named node. Returns handle to removed node. You must destroy
12562>>>>>>>    // or move this removed object as needed
12562>>>>>>>    
12562>>>>>>>    Function RemoveNamedNode String sQueryString Returns Handle
12564>>>>>>>        Handle hoNode
12564>>>>>>>        Handle hInfcTemplate hinfcNode
12564>>>>>>>        Integer iRet
12564>>>>>>>        Get SelectSingleNode sQueryString to hinfcTemplate
12565>>>>>>>        If (hinfcTemplate) Begin
12567>>>>>>>            // Remove child returns an interface to the disassociated node.
12567>>>>>>>            // It should be disposed by setting it to an object and then calling destroy
12567>>>>>>>            Get RemoveChild hInfcTemplate to hInfcNode
12568>>>>>>>            // Even if hInfcTemplate and hInfcNode are the same their reference count will be incremented.
12568>>>>>>>            // Therefore we must destroy one the interfaces which will decrement the reference count thus
12568>>>>>>>            // avoding a memory leak
12568>>>>>>>            Move (invokexml(DF_IXMLDOMNODE, DESTROY_XML_INTERFACE, hInfcTemplate, 0, 0, 0, 0)) to iRet
12569>>>>>>>            If hInfcNode ;                Get CreateXMLNode hinfcNode to hoNode
12572>>>>>>>        End
12572>>>>>>>>
12572>>>>>>>        Function_Return hoNode
12573>>>>>>>    End_Function
12574>>>>>>>    
12574>>>>>>>    // This function creates a clone of the passed Node. if bRecurse all child nodes are also
12574>>>>>>>    // cloned. The object Id of the new clone object is returned.
12574>>>>>>>    // The interface of the object returned can be used in AppendChild to add
12574>>>>>>>    // the node to the XML Document.
12574>>>>>>>    
12574>>>>>>>    Function CloneNode Integer bRecurse Returns Handle
12576>>>>>>>        Handle hoNewNode
12576>>>>>>>        Handle hinfcNewNode
12576>>>>>>>        Get CloneInfcNode (If(bRecurse,-1,0)) to hinfcNewNode
12577>>>>>>>        If hinfcNewNode ;            Get CreateXMLNode hinfcNewNode to hoNewNode
12580>>>>>>>        Function_Return hoNewNode
12581>>>>>>>    End_Function

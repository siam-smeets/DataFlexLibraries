22158>>>>>>>>>>>>>    // Determines the current state hash. Depending on peApplicationState it looks at the location 
22158>>>>>>>>>>>>>    // hash or a property.
22158>>>>>>>>>>>>>    //
22158>>>>>>>>>>>>>    // Returns:
22158>>>>>>>>>>>>>    //      The current application state hash (since it was last updated).
22158>>>>>>>>>>>>>    Function StateHash Returns String
22160>>>>>>>>>>>>>        String sStateHash
22160>>>>>>>>>>>>>        
22160>>>>>>>>>>>>>        // When the hash is not part of the URL but we do support history then the state hash is
22160>>>>>>>>>>>>>        // stored in a web property unad updated by SetStateHash and HistoryPopState.
22160>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryOnly) Begin
22162>>>>>>>>>>>>>            WebGet psCurrentAppState to sStateHash
22163>>>>>>>>>>>>>        End
22163>>>>>>>>>>>>>>
22163>>>>>>>>>>>>>        
22163>>>>>>>>>>>>>        // When the hash is part of the URL we can always read it from the URL. Note that this 
22163>>>>>>>>>>>>>        // doesn't reflect changes made during this request.
22163>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryAndUrls) Begin
22165>>>>>>>>>>>>>            WebGet psLocationHash to sStateHash
22166>>>>>>>>>>>>>            
22166>>>>>>>>>>>>>            If (Left(sStateHash, 1) = "#") Begin
22168>>>>>>>>>>>>>                Move (Right(sStateHash, Length(sStateHash) - 1)) to sStateHash
22169>>>>>>>>>>>>>            End
22169>>>>>>>>>>>>>>
22169>>>>>>>>>>>>>        End 
22169>>>>>>>>>>>>>>
22169>>>>>>>>>>>>>        Function_Return sStateHash
22170>>>>>>>>>>>>>    End_Function
22171>>>>>>>>>>>>>    
22171>>>>>>>>>>>>>    // Restores the passed state hash and updates the history.
22171>>>>>>>>>>>>>    //
22171>>>>>>>>>>>>>    // Params:
22171>>>>>>>>>>>>>    //  sStateHash  State hash to restore.
22171>>>>>>>>>>>>>    //  bReplace    If true the current history item is replaced (instead of adding a new history item).
22171>>>>>>>>>>>>>    Procedure NavigateToStateHash String sStateHash Boolean bReplace
22173>>>>>>>>>>>>>        Send SetStateHash sStateHash "" bReplace
22174>>>>>>>>>>>>>        Send RestoreState sStateHash
22175>>>>>>>>>>>>>    End_Procedure

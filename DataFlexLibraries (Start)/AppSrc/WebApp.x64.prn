31696>>>>>        // and error_object_id. 
31696>>>>>        If (not(ghoWebErrorHandler) or Error_Object_Id<>ghoWebErrorHandler) Begin
31698>>>>>            Error DFERR_PROGRAM "Error object (ghoWebErrorHandler) not properly assigned"        
31699>>>>>>
31699>>>>>        End
31699>>>>>>
31699>>>>>
31699>>>>>        
31699>>>>>        Send Define_cWebCallHandler_mixin
31700>>>>>        Send Define_cWebOnCallEndHandler_mixin
31701>>>>>        Send Define_cWebObjectOwner_mixin
31702>>>>>        Send Define_cWebObjectHost_mixin
31703>>>>>        Send Define_cWebPropertyHost_mixin
31704>>>>>        Send Define_cWebViewHost_mixin
31705>>>>>        Send Define_cWebNavPathHelper_mixin
31706>>>>>        Send Define_cWebSessionHost_mixin
31707>>>>>        Send Define_cWebSyncHost_mixin
31708>>>>>        Send Define_cWebHostAPI_mixin
31709>>>>>        Send Define_cWebNavigationHost_mixin
31710>>>>>        
31710>>>>>        
31710>>>>>        // Place in its own component file so that Studio creates a proper 
31710>>>>>        // WebServiceDispatcher.wso for this.
31710>>>>>        Use WebServiceDispatcher.wo
Including file: WebServiceDispatcher.wo    (C:\Training\DataFlexLibraries\DfPkg\DataFlex_dev_Web_UI_Server-1.0.45\AppSrc\WebServiceDispatcher.wo)
31710>>>>>>>// this should only be used by cWebApp and cWebServiceDispatcher must already be Used.
31710>>>>>>>// We do this so the Studio will see this as a component and create the needed .wso file

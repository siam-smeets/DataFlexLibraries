21336>>>>>>>>>    //      sBrowserLanguage             Language as reported by the browser (like "en-US" or "nl-NL").
21336>>>>>>>>>    //      iBrowserTimezoneOffsetMins   Timezone offset in minutes as reported by the browser. Usually 
21336>>>>>>>>>    //                                  considers daylight saving time.
21336>>>>>>>>>    Procedure OnInitializeLocales String sBrowserLanguage Integer iBrowserTimezoneOffsetMins
21338>>>>>>>>>    End_Procedure

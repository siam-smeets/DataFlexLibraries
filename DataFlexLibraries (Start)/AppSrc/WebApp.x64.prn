5996>>>>>>>
5996>>>>>>>    // Augmented to return true if a non-constrained parent DD has a change. This way
5996>>>>>>>    // Should_Save_row only filters changes in a consrained parent.
5996>>>>>>>
5996>>>>>>>    Function Should_Save_Row Returns Boolean
5998>>>>>>>        Boolean bShouldSaveRow bShouldSave bRelatesToConstraint
5998>>>>>>>        Integer iServers iServer iServerFile
5998>>>>>>>        Handle hoServerDD
5998>>>>>>>        Forward Get Should_Save_Row to bShouldSaveRow // will be true if this DD is changed or has a changed parent.
6000>>>>>>>        Get Should_Save to bShouldSave // will be true if there is a change anywhere up the entire save structure
6001>>>>>>>        If (not(bShouldSaveRow) and bShouldSave) Begin
6003>>>>>>>            // If here we have a changed in an server but not the this DD. We need a further refinement. If the server
6003>>>>>>>            // change is in a constrained server, we don't consider this a change because you can switch rows without losing
6003>>>>>>>            // data (with RT changes made for 17.0).
6003>>>>>>>            Get Data_Set_Server_Count to iServers
6004>>>>>>>            For iServer from 0 to (iServers-1)
6010>>>>>>>>
6010>>>>>>>                Get Data_Set_Server iServer to hoServerDD
6011>>>>>>>                Get Should_Save of hoServerDD to bShouldSave
6012>>>>>>>                If bShouldSave Begin
6014>>>>>>>                    Get Main_File of hoServerDD to iServerFile
6015>>>>>>>                    Get IsRelatesToConstrained iServerFile to bRelatesToConstraint
6016>>>>>>>                    If not bRelatesToConstraint Begin
6018>>>>>>>                        Function_Return True
6019>>>>>>>                    End
6019>>>>>>>>
6019>>>>>>>                End
6019>>>>>>>>
6019>>>>>>>            Loop
6020>>>>>>>>
6020>>>>>>>        End
6020>>>>>>>>
6020>>>>>>>        Function_Return bShouldSaveRow
6021>>>>>>>    End_Function
6022>>>>>>>
6022>>>>>>>    // returns true if any relates-to constraining server needs a save. Normally there will be
6022>>>>>>>    // one or zero related-to parents. If Should_Save_Row returns false it is possible that there
6022>>>>>>>    // is a change up the relates-to constrained branch. If so, this will return True. This can be
6022>>>>>>>    // used to better determine the changed status of your DDO sructure
6022>>>>>>>    Function ShouldSaveConstrainedToServer Returns Boolean
6024>>>>>>>        Boolean bShouldSave bRelatesToConstraint
6024>>>>>>>        Integer iServers iServer iServerFile
6024>>>>>>>        Handle hoServerDD
6024>>>>>>>        Get Data_Set_Server_Count to iServers
6025>>>>>>>        For iServer from 0 to (iServers-1)
6031>>>>>>>>
6031>>>>>>>            Get Data_Set_Server iServer to hoServerDD
6032>>>>>>>            Get Main_File of hoServerDD to iServerFile
6033>>>>>>>            Get IsRelatesToConstrained iServerFile to bRelatesToConstraint
6034>>>>>>>            If bRelatesToConstraint Begin
6036>>>>>>>                Get Should_Save of hoServerDD to bShouldSave
6037>>>>>>>                If bShouldSave Begin
6039>>>>>>>                    Function_Return True
6040>>>>>>>                End
6040>>>>>>>>
6040>>>>>>>            End
6040>>>>>>>>
6040>>>>>>>        Loop
6041>>>>>>>>
6041>>>>>>>        Function_Return False
6042>>>>>>>    End_Function
6043>>>>>>>
6043>>>>>>>    Function FindServerInformationElement Integer iFile Returns Integer
6045>>>>>>>        tDDServerInformation[] ServerInformation
6045>>>>>>>        tDDServerInformation[] ServerInformation
6046>>>>>>>        tDDServerInformation ServerSearch
6046>>>>>>>        tDDServerInformation ServerSearch
6046>>>>>>>        Integer iIndex
6046>>>>>>>        Move iFile to ServerSearch.iParent
6047>>>>>>>        Get pServerInformation to ServerInformation
6048>>>>>>>        Function_Return (SearchArray(ServerSearch,ServerInformation))
6049>>>>>>>    End_Function
6050>>>>>>>
6050>>>>>>>    Procedure AddServerData Integer iFile Integer eParam Boolean bValue
6052>>>>>>>        tDDServerInformation[] ServerInformation
6052>>>>>>>        tDDServerInformation[] ServerInformation
6053>>>>>>>        Integer iIndex
6053>>>>>>>        Handle hoDDO
6053>>>>>>>
6053>>>>>>>        Get pServerInformation to ServerInformation
6054>>>>>>>        Get FindServerInformationElement iFile to iIndex
6055>>>>>>>        If (iIndex=-1) Begin
6057>>>>>>>            Move (SizeOfArray(ServerInformation)) to iIndex
6058>>>>>>>            Move iFile to ServerInformation[iIndex].iParent
6059>>>>>>>            // defaults must always be false!
6059>>>>>>>            Move False to ServerInformation[iIndex].bParentNoSwitchIfCommitted
6060>>>>>>>            Move False to ServerInformation[iIndex].bAllowNullParent
6061>>>>>>>            Move False to ServerInformation[iIndex].bNoCascadeDelete
6062>>>>>>>            Move False to ServerInformation[iIndex].bCascadeDeleteNullTheParent
6063>>>>>>>        End
6063>>>>>>>>
6063>>>>>>>
6063>>>>>>>        If (eParam=0) Begin
6065>>>>>>>            If (bValue<>ServerInformation[iIndex].bAllowNullParent) Begin
6067>>>>>>>                Move bValue to ServerInformation[iIndex].bAllowNullParent
6068>>>>>>>                Send AdjustDeleteValidateStructure iFile
6069>>>>>>>            End
6069>>>>>>>>
6069>>>>>>>        End
6069>>>>>>>>
6069>>>>>>>        Else If (eParam=1) Begin
6072>>>>>>>            Move bValue to ServerInformation[iIndex].bParentNoSwitchIfCommitted
6073>>>>>>>        End
6073>>>>>>>>
6073>>>>>>>        Else If (eParam=2) Begin
6076>>>>>>>            Move bValue to ServerInformation[iIndex].bNoCascadeDelete
6077>>>>>>>        End
6077>>>>>>>>
6077>>>>>>>        Else Begin // (3)
6078>>>>>>>            If (bValue<>ServerInformation[iIndex].bCascadeDeleteNullTheParent) Begin
6080>>>>>>>                Move bValue to ServerInformation[iIndex].bCascadeDeleteNullTheParent
6081>>>>>>>                Send AdjustDeleteValidateStructure iFile
6082>>>>>>>            End
6082>>>>>>>>
6082>>>>>>>        End
6082>>>>>>>>
6082>>>>>>>        Set pServerInformation to ServerInformation
6083>>>>>>>    End_Procedure
6084>>>>>>>
6084>>>>>>>    Function GetServerData Integer iFile Integer eParam Returns Boolean
6086>>>>>>>        Boolean bValue
6086>>>>>>>        tDDServerInformation[] ServerInformation
6086>>>>>>>        tDDServerInformation[] ServerInformation
6087>>>>>>>        Integer iIndex
6087>>>>>>>        Get pServerInformation to ServerInformation
6088>>>>>>>        Get FindServerInformationElement iFile to iIndex
6089>>>>>>>        // when not found in array, we want to make sure that we return false. Therefore
6089>>>>>>>        // false should always be the default.
6089>>>>>>>        If (iIndex<>-1) Begin
6091>>>>>>>            If (eParam=0) Begin
6093>>>>>>>                Move ServerInformation[iIndex].bAllowNullParent to bValue
6094>>>>>>>            End
6094>>>>>>>>
6094>>>>>>>            Else If (eParam=1) Begin
6097>>>>>>>                Move ServerInformation[iIndex].bParentNoSwitchIfCommitted to bValue
6098>>>>>>>            End
6098>>>>>>>>
6098>>>>>>>            Else If (eParam=2) Begin
6101>>>>>>>                Move ServerInformation[iIndex].bNoCascadeDelete to bValue
6102>>>>>>>            End
6102>>>>>>>>
6102>>>>>>>            Else Begin
6103>>>>>>>                Move ServerInformation[iIndex].bCascadeDeleteNullTheParent to bValue
6104>>>>>>>            End
6104>>>>>>>>
6104>>>>>>>        End
6104>>>>>>>>
6104>>>>>>>        Function_Return bValue
6105>>>>>>>    End_Function
6106>>>>>>>
6106>>>>>>>    Procedure AdjustDeleteValidateStructure2
6108>>>>>>>        Integer iCount i
6108>>>>>>>        Handle hoDDO
6108>>>>>>>        Boolean bVisited
6108>>>>>>>        Set Visited_State to True
6109>>>>>>>        Set Cascade_Delete_Structure_Validated_State to False
6110>>>>>>>        Get Data_Set_Server_Count to iCount
6111>>>>>>>        For i from 0 to (iCount-1)
6117>>>>>>>>
6117>>>>>>>            Get Data_Set_Server i to hoDDO
6118>>>>>>>            Get Visited_State of hoDDO to bVisited
6119>>>>>>>            If (not(bVisited)) Begin
6121>>>>>>>                Send AdjustDeleteValidateStructure2 of hoDDO
6122>>>>>>>            End
6122>>>>>>>>
6122>>>>>>>        Loop
6123>>>>>>>>
6123>>>>>>>    End_Procedure
6124>>>>>>>
6124>>>>>>>    // This is called in the unlikely case that NullParent/CascadeNull are set dynamically. It
6124>>>>>>>    // tells the parent DDO to recheck its validate-delete structure and it tells all ancestors of
6124>>>>>>>    // this parent to do the same. If called while DDOs are being created (via a class setting) there
6124>>>>>>>    // will not be a connected parent for iFile, which is fine.
6124>>>>>>>    Procedure AdjustDeleteValidateStructure Integer iFile
6126>>>>>>>        Handle hoDDO
6126>>>>>>>        Get Which_Data_Set iFile to hoDDO
6127>>>>>>>        If hoDDO Begin
6129>>>>>>>            Send Initialize_Visited of hoDDO False False
6130>>>>>>>            Send AdjustDeleteValidateStructure2 of hoDDO
6131>>>>>>>        End
6131>>>>>>>>
6131>>>>>>>    End_Procedure
6132>>>>>>>

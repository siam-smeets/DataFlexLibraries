7252>>>>>>>>>    Pointer pWFD
7252>>>>>>>>>    tWin32FindDataW tWFD
7252>>>>>>>>>    tWin32FindDataW tWFD
7252>>>>>>>>>
7252>>>>>>>>>    // lpsWin32FindData is a pointer to a WIN32_FIND_DATAW struct, which contains pointers to UTF-8 strings.
7252>>>>>>>>>    // These string must be converted to UTF-16 and afterwards back to UTF-8.
7252>>>>>>>>>
7252>>>>>>>>>    // Copy the struct to a local struct that can be modified to UTF-16.
7252>>>>>>>>>    Move (SizeOfType(tWin32FindData) - MAX_PATH - MAX_ALTPATH) to iSizeOfStructWithoutStrings
7253>>>>>>>>>    Move (AddressOf(tWFD)) to pWFD
7254>>>>>>>>>    Move (MemCopy(pWFD, lpsWin32FindData, iSizeOfStructWithoutStrings)) to iVoid
7255>>>>>>>>>    // But do the strings separately and convert them to wide strings (UTF16).
7255>>>>>>>>>    Move (PointerToString(lpsWin32FindData + iSizeOfStructWithoutStrings)) to wFileName
7256>>>>>>>>>    Move (PointerToString(lpsWin32FindData + iSizeOfStructWithoutStrings + MAX_PATH)) to wAlternateFileName
7257>>>>>>>>>    Move (MemCopy(pWFD + iSizeOfStructWithoutStrings, AddressOf(wFileName), SizeOfString(wFileName)*2)) to iVoid
7258>>>>>>>>>    Move (MemCopy(pWFD + iSizeOfStructWithoutStrings + (MAX_PATH*2), AddressOf(wAlternateFileName), SizeOfString(wAlternateFileName)*2)) to iVoid
7259>>>>>>>>>    
7259>>>>>>>>>    // Call the function
7259>>>>>>>>>    Move (winFindNextFileW (hFindFile, pWFD)) to iResult  
7260>>>>>>>>>
7260>>>>>>>>>    // Copy the struct contents back to the incoming one.
7260>>>>>>>>>    Move (CopyMemory(lpsWin32FindData, pWFD, iSizeOfStructWithoutStrings)) to iVoid
7261>>>>>>>>>    
7261>>>>>>>>>    // But do the strings separately and convert them to UTF8
7261>>>>>>>>>    Move (PointerToWString(pWFD + iSizeOfStructWithoutStrings)) to sFileName
7262>>>>>>>>>    Move (PointerToWString(pWFD + iSizeOfStructWithoutStrings + (MAX_PATH*2))) to sAlternateFileName
7263>>>>>>>>>    
7263>>>>>>>>>    // Extend string with 0 to the maximum number of characters
7263>>>>>>>>>    If (SizeOfString(sFileName)<MAX_PATH) ;        Append sFileName (Repeat(Character(0), MAX_PATH - SizeOfString(sFileName)))
7266>>>>>>>>>    If (SizeOfString(sAlternateFileName)<MAX_ALTPATH) ;        Append sAlternateFileName (Repeat(Character(0), MAX_ALTPATH - SizeOfString(sAlternateFileName)))
7269>>>>>>>>>        
7269>>>>>>>>>    Move (MemCopy(lpsWin32FindData + iSizeOfStructWithoutStrings, AddressOf(sFileName), MAX_PATH)) to iVoid
7270>>>>>>>>>    Move (MemCopy(lpsWin32FindData + iSizeOfStructWithoutStrings + MAX_PATH, AddressOf(sAlternateFileName), MAX_ALTPATH)) to iVoid
7271>>>>>>>>>    
7271>>>>>>>>>    Function_Return iResult
7272>>>>>>>>>End_Function

15224>>>>>>>>>>>    //  Converts a datetime into a GMT string by converting it to the UTC time and and outputting 
15224>>>>>>>>>>>    //  it in the format Wdy, DD Mon YYYY HH:MM:SS GMT.
15224>>>>>>>>>>>    Function GMTString DateTime dtDate Returns String
15226>>>>>>>>>>>        String sGMT
15226>>>>>>>>>>>        Integer iUTCOffset iDay iMonth
15226>>>>>>>>>>>        
15226>>>>>>>>>>>        Move (SysConf (SYSCONF_UTC_TIME_OFFSET)) to iUTCOffset
15227>>>>>>>>>>>        Move (DateAddSecond(dtDate, iUTCOffset)) to dtDate
15228>>>>>>>>>>>        
15228>>>>>>>>>>>        Move (DateGetDayOfWeek(dtDate)) to iDay
15229>>>>>>>>>>>        If (iDay = 1) ;            Move ("Sun") to  sGMT
15232>>>>>>>>>>>        If (iDay = 2) ;            Move ("Mon") to  sGMT
15235>>>>>>>>>>>        If (iDay = 3) ;            Move ("Tue") to  sGMT
15238>>>>>>>>>>>        If (iDay = 4) ;            Move ("Wed") to  sGMT
15241>>>>>>>>>>>        If (iDay = 5) ;            Move ("Thu") to  sGMT
15244>>>>>>>>>>>        If (iDay = 6) ;            Move ("Fri") to  sGMT
15247>>>>>>>>>>>        If (iDay = 7) ;            Move ("Sat") to  sGMT
15250>>>>>>>>>>>        
15250>>>>>>>>>>>        Move (sGMT + ", " + Right("0" + String(DateGetDay(dtDate)), 2) + " ") to sGMT
15251>>>>>>>>>>>        
15251>>>>>>>>>>>        Move (DateGetMonth(dtDate)) to iMonth
15252>>>>>>>>>>>        If (iMonth = 1) ;            Move (sGMT + "Jan") to  sGMT
15255>>>>>>>>>>>        If (iMonth = 2) ;            Move (sGMT + "Feb") to  sGMT
15258>>>>>>>>>>>        If (iMonth = 3) ;            Move (sGMT + "Mar") to  sGMT
15261>>>>>>>>>>>        If (iMonth = 4) ;            Move (sGMT + "Apr") to  sGMT
15264>>>>>>>>>>>        If (iMonth = 5) ;            Move (sGMT + "May") to  sGMT
15267>>>>>>>>>>>        If (iMonth = 6) ;            Move (sGMT + "Jun") to  sGMT
15270>>>>>>>>>>>        If (iMonth = 7) ;            Move (sGMT + "Jul") to  sGMT
15273>>>>>>>>>>>        If (iMonth = 8) ;            Move (sGMT + "Aug") to  sGMT
15276>>>>>>>>>>>        If (iMonth = 9) ;            Move (sGMT + "Sep") to  sGMT
15279>>>>>>>>>>>        If (iMonth = 10) ;            Move (sGMT + "Oct") to  sGMT
15282>>>>>>>>>>>        If (iMonth = 11) ;            Move (sGMT + "Nov") to  sGMT
15285>>>>>>>>>>>        If (iMonth = 12) ;            Move (sGMT + "Dec") to  sGMT
15288>>>>>>>>>>>        
15288>>>>>>>>>>>        Move (sGMT + SFormat(" %1 %2:%3:%4 GMT", DateGetYear(dtDate), Right("0" + String(DateGetHour(dtDate)), 2), Right("0" + String(DateGetMinute(dtDate)), 2),Right("0" + String(DateGetSecond(dtDate)), 2))) to sGMT
15289>>>>>>>>>>>        
15289>>>>>>>>>>>        Function_Return sGMT
15290>>>>>>>>>>>    End_Function

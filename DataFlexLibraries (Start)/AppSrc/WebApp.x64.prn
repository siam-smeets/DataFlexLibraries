577>>>>>>>>>>>External_Function WinMonitorFromPoint "MonitorFromPoint" user32.dll ;    BigInt winPoint ;   // Specifies the point of interest in virtual-screen coordinates as a folded 64-bit integer. First 4 bytes are x, last 4 bytes are y.    DWord dwFlags ;     // Determines the function's return value if the window does not intersect any display monitor (e.g. MONITOR_DEFAULTTONEAREST)    Returns Handle
578>>>>>>>>>>>
578>>>>>>>>>>>// Wrapper for calling this function with separate x and y
578>>>>>>>>>>>Function MonitorFromPoint Global Integer ixPos Integer iyPos DWord dwFlags Returns Handle
580>>>>>>>>>>>    Handle hMonitor
580>>>>>>>>>>>    
580>>>>>>>>>>>    BigInt iWinPoint
580>>>>>>>>>>>    Move iyPos to iWinPoint
581>>>>>>>>>>>    Move ((iWinPoint * 65536 * 65536) + ixPos) to iWinPoint    // folded 64-bit integer
582>>>>>>>>>>>    Move (WinMonitorFromPoint(iWinPoint, dwFlags)) to hMonitor
583>>>>>>>>>>>    
583>>>>>>>>>>>    Function_Return hMonitor
584>>>>>>>>>>>End_Function

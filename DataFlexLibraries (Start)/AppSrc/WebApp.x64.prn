38658>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
38659>>>>>    
38659>>>>>    Procedure Construct_Object
38661>>>>>        Handle hoObj
38661>>>>>        
38661>>>>>        Forward Send Construct_Object
38663>>>>>        
38663>>>>>        Set pbSessionCookieHttpOnly to True
38664>>>>>        
38664>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
38665>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
38666>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
38667>>>>>        
38667>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
38668>>>>>        Set phoUserDD to hoObj
38669>>>>>        
38669>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
38670>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
38671>>>>>        Set phoSessionDD to hoObj
38672>>>>>        
38672>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
38673>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
38674>>>>>        Set phoCrypto to hoObj
38675>>>>>        
38675>>>>>        Property Boolean pbPasswordHashing True
38676>>>>>        
38676>>>>>        Property Boolean pbCreatingNewSession False
38677>>>>>        Property String psLoginName
38678>>>>>        Property String psUserName ""
38679>>>>>        Property Integer piUserRights 0
38680>>>>>    End_Procedure
38681>>>>>    
38681>>>>>    Procedure End_Construct_Object
38683>>>>>        Boolean bPasswordHashing
38683>>>>>        Handle hoCrypto
38683>>>>>        Integer iFieldLen iRequiredBufferSize
38683>>>>>        String sErrorText
38683>>>>>
38683>>>>>        Forward Send End_Construct_Object
38685>>>>>        
38685>>>>>        Get pbPasswordHashing to bPasswordHashing
38686>>>>>        If (bPasswordHashing) Begin
38688>>>>>            Get phoCrypto to hoCrypto
38689>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
38692>>>>>            Get RequiredBufferSize of hoCrypto to iRequiredBufferSize
38693>>>>>            Move (iRequiredBufferSize + 3) to iRequiredBufferSize
38694>>>>>            If (iFieldLen < iRequiredBufferSize) Begin
38696>>>>>                Move (SFormat (C_$PasswordFieldNotLargeEnough, iRequiredBufferSize)) To sErrorText
38697>>>>>                Error DFERR_PROGRAM sErrorText
38698>>>>>>
38698>>>>>            End
38698>>>>>>
38698>>>>>        End
38698>>>>>>
38698>>>>>    End_Procedure
38699>>>>>    
38699>>>>>    Function CreateSession String sRemoteAddress Returns String
38701>>>>>        String sSessionKey
38701>>>>>        Integer iErr
38701>>>>>        Boolean bLogWebSession
38701>>>>>        Handle hoSessionDD       
38701>>>>>        Get phoSessionDD to hoSessionDD
38702>>>>>        
38702>>>>>        //  Get session key
38702>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
38704>>>>>        
38704>>>>>        Get pbLogWebSession to bLogWebSession
38705>>>>>        If not bLogWebSession Begin
38707>>>>>            Function_Return sSessionKey        
38708>>>>>        End
38708>>>>>>
38708>>>>>
38708>>>>>        //  Store session
38708>>>>>        Send Clear of hoSessionDD
38709>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
38710>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
38711>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
38712>>>>>        Get Request_Validate of hoSessionDD to iErr
38713>>>>>        If (iErr) Begin
38715>>>>>            // this should not happen. If it does its a programming error
38715>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
38716>>>>>>
38716>>>>>            Function_Return ""
38717>>>>>        End
38717>>>>>>
38717>>>>>        Send Request_Save of hoSessionDD
38718>>>>>        If (Err) Begin
38720>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
38720>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
38721>>>>>>
38721>>>>>            Function_Return ""
38722>>>>>        End
38722>>>>>>
38722>>>>>       
38722>>>>>        Function_Return sSessionKey        
38723>>>>>    End_Function
38724>>>>>    
38724>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
38726>>>>>        DateTime dtLastAccess dtCurrent
38726>>>>>        TimeSpan tsDiff
38726>>>>>        Integer iErr iSessionTimeout iSpanMinutes
38726>>>>>        Boolean bResult bCreatingNewSession
38726>>>>>        Boolean bLogWebSession bLoadWebApp
38726>>>>>        Integer eLoginMode
38726>>>>>        String sTime
38726>>>>>        Handle hoSessionDD hoUserDD       
38726>>>>>        
38726>>>>>        Move False to bLoadWebApp
38727>>>>>        If (num_arguments >= 2) Begin
38729>>>>>            Move bOptLoadWebApp to bLoadWebApp
38730>>>>>        End
38730>>>>>>
38730>>>>>        
38730>>>>>        Get phoSessionDD to hoSessionDD
38731>>>>>        Get phoUserDD to hoUserDD
38732>>>>>        
38732>>>>>        Get pbLogWebSession to bLogWebSession
38733>>>>>        Get peLoginMode to eLoginMode
38734>>>>>        
38734>>>>>        // for this object, you can only disable logging if login completely is disabled
38734>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
38736>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
38737>>>>>>
38737>>>>>            Function_Return False
38738>>>>>        End
38738>>>>>>
38738>>>>>
38738>>>>>        //  Clear session properties
38738>>>>>        Set psSessionKey to ""
38739>>>>>        Send UpdateSessionProperties True
38740>>>>>        
38740>>>>>        If not bLogWebSession Begin
38742>>>>>            Forward Get ValidateSession sSessionKey to bResult
38744>>>>>            Function_Return bResult
38745>>>>>        End        
38745>>>>>>
38745>>>>>        
38745>>>>>        Move False to bResult
38746>>>>>        Get piSessionTimeout to iSessionTimeout 
38747>>>>>        
38747>>>>>        //  Check if session exists
38747>>>>>        Send Clear of hoSessionDD
38748>>>>>        Move sSessionKey to WebAppSession.SessionKey
38749>>>>>        Send Find of hoSessionDD EQ Index.1
38750>>>>>            
38750>>>>>        If (Found) Begin
38752>>>>>            //  Calculate timespan between now and last access time
38752>>>>>            Move (CurrentDateTime()) to dtCurrent
38753>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
38754>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
38755>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
38756>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
38757>>>>>            
38757>>>>>            //  Check if session didn't time out
38757>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
38759>>>>>                Forward Get ValidateSession sSessionKey to bResult
38761>>>>>                   
38761>>>>>                If (bResult) Begin
38763>>>>>                    //  Update session record
38763>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
38764>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
38765>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
38766>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
38767>>>>>                    Get Request_Validate of hoSessionDD to iErr
38768>>>>>                    If (iErr) Begin
38770>>>>>                        // this should not happen. If it does its a programming error
38770>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
38771>>>>>>
38771>>>>>                        Function_Return False
38772>>>>>                    End
38772>>>>>>
38772>>>>>                    Send Request_Save of hoSessionDD
38773>>>>>                    
38773>>>>>                    //  Update user properties
38773>>>>>                    Send UpdateSessionProperties False
38774>>>>>                End
38774>>>>>>
38774>>>>>            End
38774>>>>>>
38774>>>>>            Else Begin
38775>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
38775>>>>>                Get pbCreatingNewSession to bCreatingNewSession
38776>>>>>                
38776>>>>>                If (not(bCreatingNewSession)) Begin
38778>>>>>                    If (not(bLoadWebApp)) Begin
38780>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
38781>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
38782>>>>>>
38782>>>>>                        Send NavigateRefresh of (Host(Self))          // refresh the WebApp at the client (triggers a login)
38783>>>>>                    End
38783>>>>>>
38783>>>>>                    Else Begin
38784>>>>>                        Set pbCreatingNewSession to True                    
38785>>>>>                        Get RecreateSession of (Host(Self)) to bResult 
38786>>>>>                        Set pbCreatingNewSession to False                        
38787>>>>>                    End
38787>>>>>>
38787>>>>>                End
38787>>>>>>
38787>>>>>            End
38787>>>>>>
38787>>>>>        End
38787>>>>>>
38787>>>>>        Else Begin
38788>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
38789>>>>>>
38789>>>>>        End
38789>>>>>>
38789>>>>>        
38789>>>>>        Function_Return bResult
38790>>>>>    End_Function
38791>>>>>    
38791>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
38793>>>>>        If (not(pbPasswordHashing(Self))) Begin
38795>>>>>            Move sPassword to sHash
38796>>>>>            Function_Return True
38797>>>>>        End
38797>>>>>>
38797>>>>>        
38797>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
38799>>>>>            Function_Return False
38800>>>>>        End
38800>>>>>>
38800>>>>>        Move ("V1$" + sHash) to sHash
38801>>>>>        Function_Return True
38802>>>>>    End_Function
38803>>>>>    
38803>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
38805>>>>>        If (not(pbPasswordHashing(Self))) Begin
38807>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
38810>>>>>            Function_Return (sUserPassword = sEnteredPassword)
38811>>>>>        End
38811>>>>>>
38811>>>>>        
38811>>>>>        String sVersion
38811>>>>>        Move (Left(sUserPassword, 3)) to sVersion
38812>>>>>        If (sVersion = "V1$") Begin
38814>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
38817>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
38818>>>>>        End
38818>>>>>>
38818>>>>>        Else Begin
38819>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
38822>>>>>            Function_Return False
38823>>>>>        End
38823>>>>>>
38823>>>>>    End_Function
38824>>>>>    
38824>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
38826>>>>>        Handle hoUserDD
38826>>>>>        Integer iErr
38826>>>>>        Get phoUserDD to hoUserDD
38827>>>>>        
38827>>>>>        //  Find the user
38827>>>>>        Send Clear of hoUserDD
38828>>>>>        Move sLoginName to WebAppUser.LoginName
38829>>>>>        Send Find of hoUserDD EQ Index.1
38830>>>>>        If (Found) Begin
38832>>>>>            Send Clear of hoUserDD
38833>>>>>            Function_Return False
38834>>>>>        End
38834>>>>>>
38834>>>>>        
38834>>>>>        Send Clear of hoUserDD
38835>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
38836>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
38837>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
38839>>>>>            Send Clear of hoUserDD
38840>>>>>            Function_Return False
38841>>>>>        End
38841>>>>>>
38841>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
38842>>>>>        Get Request_Validate of hoUserDD to iErr
38843>>>>>        If (iErr) Begin
38845>>>>>            Send Clear of hoUserDD
38846>>>>>            Function_Return False
38847>>>>>        End
38847>>>>>>
38847>>>>>        
38847>>>>>        Send Request_Save of hoUserDD
38848>>>>>        Function_Return (not(Err))
38849>>>>>    End_Function
38850>>>>>    
38850>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
38852>>>>>        String sSessionKey sUserPassword
38852>>>>>        Handle hoSessionDD hoUserDD
38852>>>>>        Boolean bMatch bUpgrade
38852>>>>>        
38852>>>>>        Get phoSessionDD to hoSessionDD
38853>>>>>        Get phoUserDD to hoUserDD
38854>>>>>        Integer iErr eLoginMode
38854>>>>>        
38854>>>>>        // Refind session record
38854>>>>>        Get psSessionKey to sSessionKey
38855>>>>>        Send Clear of hoSessionDD
38856>>>>>        Move sSessionKey to WebAppSession.SessionKey
38857>>>>>        Send Find of hoSessionDD EQ Index.1
38858>>>>>        
38858>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
38860>>>>>            Get peLoginMode to eLoginMode
38861>>>>>            
38861>>>>>            //  Find the user
38861>>>>>            Move sLoginName to WebAppUser.LoginName
38862>>>>>            Send Find of hoUserDD EQ Index.1
38863>>>>>            
38863>>>>>            // Check username and password
38863>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
38865>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
38866>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
38867>>>>>                
38867>>>>>                If (bMatch) Begin
38869>>>>>                    // Store the login
38869>>>>>                    If (bUpgrade) Begin
38871>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
38872>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
38875>>>>>                    End
38875>>>>>>
38875>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
38876>>>>>                    Get Request_Validate of hoSessionDD to iErr
38877>>>>>                    If (iErr) Begin
38879>>>>>                        // this should not happen. If it does its a programming error
38879>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
38880>>>>>>
38880>>>>>                        Function_Return False
38881>>>>>                    End
38881>>>>>>
38881>>>>>                    
38881>>>>>                    Send Request_Save of hoSessionDD
38882>>>>>                    
38882>>>>>                    // Update session properties
38882>>>>>                    Send UpdateSessionProperties False
38883>>>>>                    Send NotifyChangeRights
38884>>>>>                    Function_Return True
38885>>>>>                End
38885>>>>>>
38885>>>>>                Else Begin
38886>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
38886>>>>>                    Send Clear of hoUserDD
38887>>>>>                End
38887>>>>>>
38887>>>>>            End
38887>>>>>>
38887>>>>>            Else Begin
38888>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
38888>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
38889>>>>>            End
38889>>>>>>
38889>>>>>        End
38889>>>>>>
38889>>>>>        Else Begin
38890>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
38890>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
38891>>>>>        End
38891>>>>>>
38891>>>>>          
38891>>>>>        Function_Return False
38892>>>>>    End_Function

26087>>>>>>>>>>>    Function OnCheckCustomConstrains Returns Boolean
26089>>>>>>>>>>>        Integer iColumn iField iFile
26089>>>>>>>>>>>        String sValue sFieldValue
26089>>>>>>>>>>>        Boolean bSearchHiddenColumns bHidden
26089>>>>>>>>>>>        Handle[] ahoColumns
26090>>>>>>>>>>>
26090>>>>>>>>>>>        WebGet psSearchTerm to sValue
26091>>>>>>>>>>>        If (sValue = "") Function_Return True
26094>>>>>>>>>>>
26094>>>>>>>>>>>        Get phoColumnObjects to ahoColumns
26095>>>>>>>>>>>        WebGet pbSearchHiddenColumns to bSearchHiddenColumns
26096>>>>>>>>>>>
26096>>>>>>>>>>>        Move (Lowercase(sValue)) to sValue
26097>>>>>>>>>>>        
26097>>>>>>>>>>>        While (iColumn < SizeOfArray(ahoColumns))
26101>>>>>>>>>>>            WebGet pbHidden of ahoColumns[iColumn] to bHidden
26102>>>>>>>>>>>            If (bSearchHiddenColumns or not(bHidden)) Begin
26104>>>>>>>>>>>                Get Data_File of ahoColumns[iColumn] to iFile
26105>>>>>>>>>>>                Get Data_Field of ahoColumns[iColumn] to iField
26106>>>>>>>>>>>
26106>>>>>>>>>>>                If (iField) Begin
26108>>>>>>>>>>>                    Get_Field_Value iFile iField to sFieldValue
26111>>>>>>>>>>>                    If (Lowercase(sFieldValue) contains sValue) Begin
26113>>>>>>>>>>>                        Move (SizeOfArray(ahoColumns)) to iColumn
26114>>>>>>>>>>>                        Function_Return True
26115>>>>>>>>>>>                    End
26115>>>>>>>>>>>>
26115>>>>>>>>>>>                End
26115>>>>>>>>>>>>
26115>>>>>>>>>>>            End
26115>>>>>>>>>>>>
26115>>>>>>>>>>>
26115>>>>>>>>>>>            Increment iColumn
26116>>>>>>>>>>>        Loop
26117>>>>>>>>>>>>
26117>>>>>>>>>>>
26117>>>>>>>>>>>        Function_Return False
26118>>>>>>>>>>>    End_Function
26119>>>>>>>>>>>
26119>>>>>>>>>>>    Function BuildFilter Returns String
26121>>>>>>>>>>>        Integer iColumn iField iFile
26121>>>>>>>>>>>        String sSearchValue sFilter sColumnFilter
26121>>>>>>>>>>>        Boolean bSearchHiddenColumns bHidden
26121>>>>>>>>>>>        Handle hoReadingDD
26121>>>>>>>>>>>        Handle[] ahoColumns
26122>>>>>>>>>>>
26122>>>>>>>>>>>        WebGet psSearchTerm to sSearchValue
26123>>>>>>>>>>>        If (sSearchValue = "") Function_Return ""
26126>>>>>>>>>>>
26126>>>>>>>>>>>        Get ReadingServer to hoReadingDD
26127>>>>>>>>>>>        If (hoReadingDD = 0) Function_Return ""
26130>>>>>>>>>>>
26130>>>>>>>>>>>        Get phoColumnObjects to ahoColumns
26131>>>>>>>>>>>        WebGet pbSearchHiddenColumns to bSearchHiddenColumns
26132>>>>>>>>>>>
26132>>>>>>>>>>>        While (iColumn < SizeOfArray(ahoColumns))
26136>>>>>>>>>>>            WebGet pbHidden of ahoColumns[iColumn] to bHidden
26137>>>>>>>>>>>            If (bSearchHiddenColumns or not(bHidden)) Begin
26139>>>>>>>>>>>                Get Data_File of ahoColumns[iColumn] to iFile
26140>>>>>>>>>>>                Get Data_Field of ahoColumns[iColumn] to iField
26141>>>>>>>>>>>
26141>>>>>>>>>>>                If (iFile <> 0 and iField <> 0) Begin
26143>>>>>>>>>>>                    Get BuildFilterExpressionForField hoReadingDD iFile iField sSearchValue to sColumnFilter
26144>>>>>>>>>>>                    If (sColumnFilter <> "") Begin
26146>>>>>>>>>>>                        If (sFilter <> "") Begin
26148>>>>>>>>>>>                            Move (sFilter + " OR ") to sFilter
26149>>>>>>>>>>>                        End
26149>>>>>>>>>>>>
26149>>>>>>>>>>>                        Move (sFilter + sColumnFilter) to sFilter
26150>>>>>>>>>>>                    End
26150>>>>>>>>>>>>
26150>>>>>>>>>>>                End
26150>>>>>>>>>>>>
26150>>>>>>>>>>>            End
26150>>>>>>>>>>>>
26150>>>>>>>>>>>
26150>>>>>>>>>>>            Increment iColumn
26151>>>>>>>>>>>        Loop
26152>>>>>>>>>>>>
26152>>>>>>>>>>>
26152>>>>>>>>>>>        If (sFilter <> "") Begin
26154>>>>>>>>>>>            Move ("(" + sFilter + ")") to sFilter
26155>>>>>>>>>>>        End
26155>>>>>>>>>>>>
26155>>>>>>>>>>>
26155>>>>>>>>>>>        Function_Return sFilter
26156>>>>>>>>>>>    End_Function

9715>>>>>>>>>Procedure UserError Global String sMessage String sCaption
9717>>>>>>>>>    String sCapt
9717>>>>>>>>>    If (Error_Object_Id=0) Begin
9719>>>>>>>>>        Error DFERR_PROGRAM "No Error Handler"
9720>>>>>>>>>>
9720>>>>>>>>>        Procedure_Return
9721>>>>>>>>>    End
9721>>>>>>>>>>
9721>>>>>>>>>    
9721>>>>>>>>>    // Accept not passing a caption in which case the error handler's
9721>>>>>>>>>    // default caption. It had been the intention to require a caption ("" if none)
9721>>>>>>>>>    // but having no caption kind of worked where the caption would be "0". Since it
9721>>>>>>>>>    // kind of worked, I don't want to remove this which might generate runtime errors.
9721>>>>>>>>>    If (num_arguments>1) Begin
9723>>>>>>>>>        Move sCaption to sCapt
9724>>>>>>>>>    End
9724>>>>>>>>>>
9724>>>>>>>>>    
9724>>>>>>>>>    Error DFERR_OPERATOR (sMessage + If(sCapt<>"",C_ErrorCaption + sCapt,""))
9725>>>>>>>>>>
9725>>>>>>>>>End_Procedure

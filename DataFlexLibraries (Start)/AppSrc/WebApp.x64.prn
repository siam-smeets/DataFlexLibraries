29253>>>>>>>    // Generates a fatal error (HTTP error) with JSON in the body.
29253>>>>>>>    Procedure ReportFatalError UShort usStatusCode String sReason UShort usStatusSubCode String sDescription
29255>>>>>>>        Handle hoJson hoJsonErr
29255>>>>>>>        UChar[] ucData
29256>>>>>>>        
29256>>>>>>>        //  Set headers & status
29256>>>>>>>        Send SetResponseStatus usStatusCode sReason usStatusSubCode
29257>>>>>>>        Send AddHttpResponseHeader "Content-Type" "application/json; charset=utf-8"
29258>>>>>>>        Send AddHttpResponseHeader "Cache-Control" "no-cache"
29259>>>>>>>        
29259>>>>>>>        //  Generate JSON response header
29259>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJson
29260>>>>>>>        Send InitializeJsonType of hoJson jsonTypeObject
29261>>>>>>>        
29261>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonErr
29262>>>>>>>        Send InitializeJsonType of hoJsonErr jsonTypeObject
29263>>>>>>>        Send SetMember of hoJson "error" hoJsonErr
29264>>>>>>>        
29264>>>>>>>        Send SetMemberValue of hoJsonErr "status" jsonTypeString usStatusCode
29265>>>>>>>        Send SetMemberValue of hoJsonErr "reason" jsonTypeString sReason
29266>>>>>>>        Send SetMemberValue of hoJsonErr "message" jsonTypeString sDescription
29267>>>>>>>        
29267>>>>>>>        Get StringifyUtf8 of hoJson to ucData
29268>>>>>>>        Send OutputUChar ucData
29269>>>>>>>        
29269>>>>>>>        Send Destroy of hoJsonErr
29270>>>>>>>        Send Destroy of hoJson
29271>>>>>>>    End_Procedure
29272>>>>>>>    
29272>>>>>>>    // Generates a fatal error (HTTP error) with JSON in the body in the style of cWebService so 
29272>>>>>>>    // that older JavaScript Engines can parse them.

3773>>>>>>>
3773>>>>>>>    // This procedure can be used to set the Item_Options of a field. This can
3773>>>>>>>    // be passed any number of arguments.
3773>>>>>>>    // Support the following special first parameters:
3773>>>>>>>    //      DD_CLEAR_FIELD_OPTIONS     - clear all following passed otpions
3773>>>>>>>    //      DD_CLEAR_ALL_FIELD_OPTIONS - clear all options
3773>>>>>>>    Procedure Set Field_Options Integer iField Integer iArg1 // plus unknown arguments
3775>>>>>>>        Integer iObj
3775>>>>>>>        Integer iOptions
3775>>>>>>>        Integer iOption
3775>>>>>>>        Integer iArg
3775>>>>>>>        Integer iClear
3775>>>>>>>        Integer iType
3775>>>>>>>        Move (Record_Buffer(Self)) to iObj
3776>>>>>>>        Get Item_Options of iObj iField to iOptions
3777>>>>>>>        //
3777>>>>>>>        For iArg from 2 to Num_Arguments
3783>>>>>>>>
3783>>>>>>>            Move iArg& to iOption // tricky way to parse passed arguments
3784>>>>>>>
3784>>>>>>>            If (iOption = DD_CLEAR_ALL_FIELD_OPTIONS) ;                Move 0 to iOptions
3787>>>>>>>            Else If (iOption = DD_CLEAR_FIELD_OPTIONS) ;                Move 1 to iClear
3791>>>>>>>            Else If not iClear ;                Move (iOptions ior iOption) to iOptions
3795>>>>>>>            Else ; // only unset bits already set! Note multiple bits can be passed                Move (iOptions - (iOptions iand iOption)) to iOptions
3797>>>>>>>        Loop
3798>>>>>>>>
3798>>>>>>>        //
3798>>>>>>>        //Get_Attribute DF_FIELD_TYPE of (Main_File(self)) iField to iType
3798>>>>>>>        //If (iType=DF_TEXT or iType=DF_BINARY) ;            // if text of binary
3798>>>>>>>        //    Move (iOptions iOR DD_DISPLAYONLY) to iOptions // make sure DO is set
3798>>>>>>>
3798>>>>>>>        Set Item_Options of iObj iField to iOptions
3799>>>>>>>    End_Procedure
3800>>>>>>>
3800>>>>>>>    // This function returns all the item_options which have been set for
3800>>>>>>>    // a field. The value from the Record_Buffer object will be binary or'ed
3800>>>>>>>    // with constand Default_Item_Options and the DD_AUTOCLEAR constants when
3800>>>>>>>    // the Autoclear_State of the field has been set.
3800>>>>>>>    // Keep in mind that Autoclear is *not* kept in the Item_Options
3800>>>>>>>    // property.
3800>>>>>>>    Function Field_Options Integer iField Returns Integer
3802>>>>>>>        Function_Return (Item_Options(Record_Buffer(Self), iField))
3803>>>>>>>    End_Function
3804>>>>>>>
3804>>>>>>>    Function Field_Option Integer iField Integer iOption Returns Integer
3806>>>>>>>        Integer iOptions
3806>>>>>>>        Integer iState
3806>>>>>>>        Get Item_Options of (Record_Buffer(Self)) iField to iOptions
3807>>>>>>>        // All bits must match for it to be True (e.g., displayonly requires noput & noenter)
3807>>>>>>>        Move ((iOptions iand iOption)=iOption) to iState
3808>>>>>>>        Function_Return iState
3809>>>>>>>    End_Function
3810>>>>>>>
3810>>>>>>>
3810>>>>>>>    Procedure Set Foreign_Field_Options Integer iField Integer iArg1 // Integer iOption
3812>>>>>>>        Integer iObj
3812>>>>>>>        Integer iOptions
3812>>>>>>>        Integer iOption
3812>>>>>>>        Integer iArg
3812>>>>>>>        Integer iClear
3812>>>>>>>
3812>>>>>>>
3812>>>>>>>        Move (Record_Buffer(Self)) to iObj
3813>>>>>>>        Get Aux_Value of iObj iField to iOptions
3814>>>>>>>        //
3814>>>>>>>        For iArg from 2 to Num_Arguments
3820>>>>>>>>
3820>>>>>>>            Move iArg& to iOption // tricky way to parse passed arguments
3821>>>>>>>            If (iOption = DD_CLEAR_ALL_FIELD_OPTIONS) ;                Move 0 to iOptions
3824>>>>>>>            Else If (iOption = DD_CLEAR_FIELD_OPTIONS) ;                Move 1 to iClear
3828>>>>>>>            Else If not iClear ;                Move (iOptions ior iOption) to iOptions
3832>>>>>>>            Else ; // only unset bits already set! Note multiple bits can be passed                Move (iOptions - (iOptions iand iOption)) to iOptions
3834>>>>>>>        Loop
3835>>>>>>>>
3835>>>>>>>        //
3835>>>>>>>        Set Aux_Value of iObj iField to iOptions
3836>>>>>>>    End_Procedure
3837>>>>>>>
3837>>>>>>>    Function Foreign_Field_Options Integer iField Returns Integer
3839>>>>>>>        Integer iOpts
3839>>>>>>>        Get ForeignFieldOptions of Record_Buffer iField to iOpts
3840>>>>>>>        Function_Return iOpts
3841>>>>>>>    End_Function
3842>>>>>>>
3842>>>>>>>    Procedure Set Foreign_Field_Option Integer iField Integer iOption Integer bSet
3844>>>>>>>        If bSet Begin
3846>>>>>>>            Set Foreign_Field_Options iField to iOption
3847>>>>>>>        End
3847>>>>>>>>
3847>>>>>>>        Else Begin
3848>>>>>>>            Set Foreign_Field_Options iField to DD_CLEAR_FIELD_OPTIONS iOption
3849>>>>>>>        End
3849>>>>>>>>
3849>>>>>>>    End_Procedure
3850>>>>>>>
3850>>>>>>>    Function Foreign_Field_Option Integer iField Integer iOption Returns Integer
3852>>>>>>>        Integer iOptions
3852>>>>>>>        Integer iState
3852>>>>>>>        Get Foreign_Field_Options iField to iOptions
3853>>>>>>>        Move ((iOptions iand iOption)=iOption) to iState
3854>>>>>>>        Function_Return iState

9119>>>>>>>>>        If (sText = "No") ;            Function_Return RO_NO
9122>>>>>>>>>        Else If (sText = "Ignore Change") ;            Function_Return RO_IGNORECHANGE
9126>>>>>>>>>        Else If (sText = "Accept Change") ;            Function_Return RO_ACCEPTCHANGE
9130>>>>>>>>>        Else If (sText = "Error On Change") ;            Function_Return RO_ERRORONCHANGE
9134>>>>>>>>>    End_Function
9135>>>>>>>>>    
9135>>>>>>>>>    

15440>>>>>>>    // This is the main entry point called from the VdfInternetSession singleton.
15440>>>>>>>    Procedure HandleHttpRequest String sVerb String sPath String sQueryString String sContentType String sAcceptType DWord iSize
15442>>>>>>>        Integer iVoid
15442>>>>>>>        
15442>>>>>>>        Move (Uppercase(sVerb)) to sVerb
15443>>>>>>>        
15443>>>>>>>        //  Update request properties
15443>>>>>>>        Set psRequestContentType to sContentType
15444>>>>>>>        Set psRequestVerb to sVerb
15445>>>>>>>        Set psRequestPath to sPath
15446>>>>>>>        Set psRequestQueryString to sQueryString
15447>>>>>>>        Set psRequestAcceptType to sAcceptType
15448>>>>>>>        Set piRequestSize to iSize
15449>>>>>>>        Set pbDataSent to False
15450>>>>>>>        
15450>>>>>>>        //  Trigger request events
15450>>>>>>>        Send OnPreRequest sVerb sPath
15451>>>>>>>        
15451>>>>>>>        Send OnHttpRequest sVerb sPath sContentType sAcceptType iSize
15452>>>>>>>        
15452>>>>>>>        Send OnPostRequest sVerb sPath
15453>>>>>>>        
15453>>>>>>>        //  Clear request properties
15453>>>>>>>        Set psRequestVerb to ""
15454>>>>>>>        Set psRequestPath to sPath
15455>>>>>>>        Set psRequestQueryString to ""
15456>>>>>>>        Set psRequestContentType to ""
15457>>>>>>>        Set psRequestAcceptType to ""
15458>>>>>>>        Set piRequestSize to 0
15459>>>>>>>        Set pbDataSent to False
15460>>>>>>>    End_Procedure
15461>>>>>>>
15461>>>>>>>    // Parses a content-type header string and splits it into just the content-type (put into 
15461>>>>>>>    // sContenttype passed by reference) and returns an array of name value pairs that were in the 
15461>>>>>>>    // content-type string.
15461>>>>>>>    Function ParseContentType String ByRef sContentType Returns tNameValuePair[]
15463>>>>>>>        tNameValuePair[] aValues
15463>>>>>>>        tNameValuePair[] aValues
15464>>>>>>>        String[] aParts aPair
15466>>>>>>>        Integer iPart iVal
15466>>>>>>>        
15466>>>>>>>        Move (StrSplitToArray(sContentType, ";")) to aParts
15467>>>>>>>        If (SizeOfArray(aParts) > 0) Begin
15469>>>>>>>            Move aParts[0] to sContentType
15470>>>>>>>            
15470>>>>>>>            For iPart from 1 to (SizeOfArray(aParts) - 1)
15476>>>>>>>>
15476>>>>>>>                Move (StrSplitToArray(aParts[iPart], "=")) to aPair
15477>>>>>>>                If (SizeOfArray(aPair) > 1) Begin
15479>>>>>>>                    Move (Trim(Uppercase(aPair[0]))) to aValues[iVal].sName
15480>>>>>>>                    Move (Trim(aPair[1])) to aValues[iVal].sValue
15481>>>>>>>                End
15481>>>>>>>>
15481>>>>>>>            Loop
15482>>>>>>>>
15482>>>>>>>        End
15482>>>>>>>>
15482>>>>>>>        
15482>>>>>>>        Function_Return aValues
15483>>>>>>>    End_Function
15484>>>>>>>    

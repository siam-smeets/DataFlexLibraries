22603>>>>>>>>>>>>>    
22603>>>>>>>>>>>>>    //
22603>>>>>>>>>>>>>    //  Looks up the web property type based on the object handle and the index and returns the right handler.
22603>>>>>>>>>>>>>    //
22603>>>>>>>>>>>>>    Function PropertyHandler Handle hoObject Integer eMode Returns Handle
22605>>>>>>>>>>>>>        Handle hoHandler hoNeighborhood
22605>>>>>>>>>>>>>        Handle[] aHandlers
22606>>>>>>>>>>>>>        
22606>>>>>>>>>>>>>        Move -1 to hoHandler
22607>>>>>>>>>>>>>        
22607>>>>>>>>>>>>>        If (eMode = wptClient) Begin
22609>>>>>>>>>>>>>            Get phoClientHandler to hoHandler    
22610>>>>>>>>>>>>>        End
22610>>>>>>>>>>>>>>
22610>>>>>>>>>>>>>        Else If (eMode = wptServerPage) Begin
22613>>>>>>>>>>>>>            Get phoServerHandler to hoHandler
22614>>>>>>>>>>>>>        End
22614>>>>>>>>>>>>>>
22614>>>>>>>>>>>>>        Else If (eMode = wptServerSession) Begin
22617>>>>>>>>>>>>>            //  The server properties with page lifetime are stored per neighborhood (per view..)
22617>>>>>>>>>>>>>            Get phoSessionHandler to hoHandler
22618>>>>>>>>>>>>>        End
22618>>>>>>>>>>>>>>
22618>>>>>>>>>>>>>        Else If (eMode = wptClientProtected) Begin
22621>>>>>>>>>>>>>            Get phoClientProtectedHandler to hoHandler
22622>>>>>>>>>>>>>        End
22622>>>>>>>>>>>>>>
22622>>>>>>>>>>>>>        
22622>>>>>>>>>>>>>        Function_Return hoHandler
22623>>>>>>>>>>>>>    End_Function
22624>>>>>>>>>>>>>    
22624>>>>>>>>>>>>>    
22624>>>>>>>>>>>>>
22624>>>>>>>>>>>>>    
22624>>>>>>>>>>>>>    
22624>>>>>>>>>>>>>    //
22624>>>>>>>>>>>>>    // Called by the cWebApp when a new request comes in to initialize the client web properties. 
22624>>>>>>>>>>>>>    // Forwards the request to the client handler.
22624>>>>>>>>>>>>>    //
22624>>>>>>>>>>>>>    Procedure Call_PreWebProps tWebCallContext ByRef cctx
22626>>>>>>>>>>>>>        Handle hoHandler
22626>>>>>>>>>>>>>        
22626>>>>>>>>>>>>>        Get phoServerHandler to hoHandler
22627>>>>>>>>>>>>>        Send InitializeCall of hoHandler cctx.request.Header.aSyncProps cctx.request.Header.aAdvSyncP
22628>>>>>>>>>>>>>        
22628>>>>>>>>>>>>>        Get phoSessionHandler to hoHandler
22629>>>>>>>>>>>>>        Send InitializeCall of hoHandler cctx.request.Header.aSyncProps cctx.request.Header.aAdvSyncP
22630>>>>>>>>>>>>>        
22630>>>>>>>>>>>>>        Get phoClientHandler to hoHandler
22631>>>>>>>>>>>>>        Send InitializeCall of hoHandler cctx.request.Header.aSyncProps cctx.request.Header.aAdvSyncP
22632>>>>>>>>>>>>>    End_Procedure
22633>>>>>>>>>>>>>    
22633>>>>>>>>>>>>>    
22633>>>>>>>>>>>>>    //
22633>>>>>>>>>>>>>    // Special feature of client web properties that during a LoadView some properties already on 
22633>>>>>>>>>>>>>    // the client are sent and are marked as synchronized. Forwards this request to the client
22633>>>>>>>>>>>>>    // handler.
22633>>>>>>>>>>>>>    //
22633>>>>>>>>>>>>>    Procedure ProcessLoadViewClientSyncProps Handle hoView
22635>>>>>>>>>>>>>        Handle hoHandler
22635>>>>>>>>>>>>>        
22635>>>>>>>>>>>>>        Get phoClientHandler to hoHandler
22636>>>>>>>>>>>>>        
22636>>>>>>>>>>>>>        Send ProcessLoadViewClientSyncProps of hoHandler hoView
22637>>>>>>>>>>>>>    End_Procedure
22638>>>>>>>>>>>>>    
22638>>>>>>>>>>>>>    
22638>>>>>>>>>>>>>    //
22638>>>>>>>>>>>>>    // Called by the cWebApp class when the processing of a request is finished. All handlers are
22638>>>>>>>>>>>>>    // triggered to store their properties and the client ahndler puts the in the passed arrays so 
22638>>>>>>>>>>>>>    // they are sent back to the client.
22638>>>>>>>>>>>>>    //
22638>>>>>>>>>>>>>    Procedure Call_PostWebProps tWebCallContext ByRef cctx
22640>>>>>>>>>>>>>        Handle hoHandler
22640>>>>>>>>>>>>>
22640>>>>>>>>>>>>>        //  Handle server properties (note that this might change client properties like psSPKey of ghoWebApp
22640>>>>>>>>>>>>>        Get phoServerHandler to hoHandler
22641>>>>>>>>>>>>>        Send FinishedCall of hoHandler (&cctx.response.Header.aSyncProps) (&cctx.response.Header.aAdvSyncP)
22642>>>>>>>>>>>>>        
22642>>>>>>>>>>>>>        Get phoSessionHandler to hoHandler
22643>>>>>>>>>>>>>        Send FinishedCall of hoHandler (&cctx.response.Header.aSyncProps) (&cctx.response.Header.aAdvSyncP)
22644>>>>>>>>>>>>>        
22644>>>>>>>>>>>>>        //  Load client web properties
22644>>>>>>>>>>>>>        Get phoClientHandler to hoHandler
22645>>>>>>>>>>>>>        Send FinishedCall of hoHandler (&cctx.response.Header.aSyncProps) (&cctx.response.Header.aAdvSyncP)
22646>>>>>>>>>>>>>    End_Procedure
22647>>>>>>>>>>>>>End_Class
22648>>>>>>>>>>>>>
22648>>>>>>>>>>>>>// Returns the value of the named Web Property belonging to the named object.
22648>>>>>>>>>>>>>// Displays an appropriate message if the property cannot be reached.
22648>>>>>>>>>>>>>//
22648>>>>>>>>>>>>>// Only use this function in the Debugger Watches window to watch Web 
22648>>>>>>>>>>>>>// Property values. Should never be used to get a Web Property value in 
22648>>>>>>>>>>>>>// your application. Use WebGet instead.
22648>>>>>>>>>>>>>
22648>>>>>>>>>>>>>Function _wp Global Handle hoObject String sPropName Returns Variant
22650>>>>>>>>>>>>>    Boolean bIsAjaxWebObject bInScope
22650>>>>>>>>>>>>>    String sObject
22650>>>>>>>>>>>>>    Handle hoHandler hoOwner
22650>>>>>>>>>>>>>    Variant vReturn
22650>>>>>>>>>>>>>    tWebPropMetaData pubProp
22650>>>>>>>>>>>>>    tWebPropMetaData pubProp
22650>>>>>>>>>>>>>    
22650>>>>>>>>>>>>>    //  Test ig target object is WO
22650>>>>>>>>>>>>>    Get IsAjaxWebObject of hoObject to bIsAjaxWebObject
22651>>>>>>>>>>>>>    Get Object_Label of hoObject to sObject
22652>>>>>>>>>>>>>    
22652>>>>>>>>>>>>>    If (not(bIsAjaxWebObject)) Begin
22654>>>>>>>>>>>>>        Function_Return ("Object " + sObject + " does not support web properties")
22655>>>>>>>>>>>>>    End
22655>>>>>>>>>>>>>>
22655>>>>>>>>>>>>>    
22655>>>>>>>>>>>>>    //  Find property index
22655>>>>>>>>>>>>>    Get FindWebPropertyMetaByName of hoObject sPropName to pubProp
22656>>>>>>>>>>>>>    If (pubProp.hmGetter = 0) Begin
22658>>>>>>>>>>>>>        Function_Return (sPropName + " is not a web property of " + sObject) 
22659>>>>>>>>>>>>>    End
22659>>>>>>>>>>>>>>
22659>>>>>>>>>>>>>    
22659>>>>>>>>>>>>>    //  Get handler
22659>>>>>>>>>>>>>    Get Owner of hoObject to hoOwner
22660>>>>>>>>>>>>>    If (hoOwner = -1) Begin
22662>>>>>>>>>>>>>        Function_Return (SFormat("Object '%1' is not a valid web web object for %2.", sObject, "WebGet"))        
22663>>>>>>>>>>>>>    End
22663>>>>>>>>>>>>>>
22663>>>>>>>>>>>>>    
22663>>>>>>>>>>>>>    Get PropertyHandler of hoOwner hoObject pubProp.eMode to hoHandler
22664>>>>>>>>>>>>>    If (hoHandler = -1) Begin
22666>>>>>>>>>>>>>        Function_Return (SFormat("Property '%2' of object '%1' is not a valid web property for %3, check the web property meta value.", sPropName, sObject, "WebGet"))        
22667>>>>>>>>>>>>>    End
22667>>>>>>>>>>>>>>
22667>>>>>>>>>>>>>    
22667>>>>>>>>>>>>>    // Test if handler is active....
22667>>>>>>>>>>>>>    If (not(pbActive(hoHandler))) Begin
22669>>>>>>>>>>>>>        Function_Return "Web property handler is inactive"
22670>>>>>>>>>>>>>    End
22670>>>>>>>>>>>>>>
22670>>>>>>>>>>>>>    
22670>>>>>>>>>>>>>    // Test if in scope
22670>>>>>>>>>>>>>    Get IsObjectInCallActionScope of hoHandler hoObject to bInScope
22671>>>>>>>>>>>>>    If (not(bInScope)) Begin
22673>>>>>>>>>>>>>        Function_Return ("Object " + sObject + " is out of scope. Web property " + sPropName + " not available")
22674>>>>>>>>>>>>>    End
22674>>>>>>>>>>>>>>
22674>>>>>>>>>>>>>    
22674>>>>>>>>>>>>>    // Now call the actual handler (now if something goes wrong it is a proper error)
22674>>>>>>>>>>>>>    Get GetScalarSyncProp of hoHandler hoObject (&pubProp) to vReturn
22675>>>>>>>>>>>>>    
22675>>>>>>>>>>>>>    Function_Return vReturn
22676>>>>>>>>>>>>>End_Function

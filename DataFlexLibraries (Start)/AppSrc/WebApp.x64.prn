33660>>>>>>>    
33660>>>>>>>    // Sent by DDO when there is a clear/find/save/delete.
33660>>>>>>>    //
33660>>>>>>>    // eMode - Determines the type of DDO operation which generated this refresh message. 
33660>>>>>>>    //         It may be one of the following:
33660>>>>>>>    //         Mode_Clear:             Used only for DEOs attached to the DDO that was the
33660>>>>>>>    //                                 "origin" of a Clear operation, (i.e., the DDO received
33660>>>>>>>    //                                 the original Clear message). All other DDOs Send their 
33660>>>>>>>    //                                 DEOs the refresh message passing mode_find_or_clear_set.  
33660>>>>>>>    //         Mode_Find_or_Clear_Set: Used for DEOs attached to DDOs which have Found and/or cleared records.  
33660>>>>>>>    //         Mode_Clear_All:         Used for DEOs attached to any DDO that participated in a clear_all operation.  
33660>>>>>>>    //         Mode_Delete:            Used for DEOs attached to any DDO that performed a successful deletion. 
33660>>>>>>>    //                                 DDOs that were merely updated as the result of a deletion Use Mode_Find_or_Clear_Set.  
33660>>>>>>>    //         Mode_Save:              Used for DEOs attached to any DDO involved in a successful Save operation. 
33660>>>>>>>    Procedure Refresh Integer eMode
33662>>>>>>>        Boolean bActive bAppSynching bClearSelectionOnRefresh
33662>>>>>>>        
33662>>>>>>>        Get Active_State to bActive
33663>>>>>>>        Get AppSynching to bAppSynching
33664>>>>>>>        Get pbPrivateClearSelectionOnRefresh to bClearSelectionOnRefresh
33665>>>>>>>
33665>>>>>>>        If (bActive and not(bAppSynching) and bClearSelectionOnRefresh) Begin
33667>>>>>>>            If (eMode = MODE_CLEAR or eMode = Mode_Find_or_Clear_Set or eMode = MODE_CLEAR_ALL) Begin
33669>>>>>>>                Send ClearListSelection
33670>>>>>>>            End
33670>>>>>>>>
33670>>>>>>>        End
33670>>>>>>>>
33670>>>>>>>        Forward Send Refresh eMode
33672>>>>>>>    End_Procedure
33673>>>>>>>    
33673>>>>>>>    // Abstracted to disable selection-clearing if just searching for text.
33673>>>>>>>    Procedure OnSearch String sSearchText
33675>>>>>>>        Boolean bPrivateClearSelectionOnRefresh
33675>>>>>>>        Get pbPrivateClearSelectionOnRefresh to bPrivateClearSelectionOnRefresh
33676>>>>>>>        
33676>>>>>>>        Set pbPrivateClearSelectionOnRefresh to False
33677>>>>>>>        Forward Send OnSearch sSearchText
33679>>>>>>>        Set pbPrivateClearSelectionOnRefresh to bPrivateClearSelectionOnRefresh
33680>>>>>>>    End_Procedure
33681>>>>>>>    

23857>>>>>>>>>>>>>>>>>>>    
23857>>>>>>>>>>>>>>>>>>>    // This procedure adds the specified object id (hoServer) to this object's
23857>>>>>>>>>>>>>>>>>>>    // set of database agents who are merely 'watched', and establishes a
23857>>>>>>>>>>>>>>>>>>>    // connection between the database agent and this object.
23857>>>>>>>>>>>>>>>>>>>    //
23857>>>>>>>>>>>>>>>>>>>    Procedure Add_Watched_Server Integer hoServer
23859>>>>>>>>>>>>>>>>>>>        Integer iIndex
23859>>>>>>>>>>>>>>>>>>>        Handle hoWatchedServers
23859>>>>>>>>>>>>>>>>>>>        
23859>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
23860>>>>>>>>>>>>>>>>>>>        If (hoWatchedServers = 0) Begin
23862>>>>>>>>>>>>>>>>>>>            Get Create of Desktop U_Broadcaster to hoWatchedServers // modern syntax
23863>>>>>>>>>>>>>>>>>>>            Set Watched_Servers to hoWatchedServers
23864>>>>>>>>>>>>>>>>>>>        End
23864>>>>>>>>>>>>>>>>>>>>
23864>>>>>>>>>>>>>>>>>>>        
23864>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to False
23865>>>>>>>>>>>>>>>>>>>        Get Find_Element of hoWatchedServers hoServer to iIndex
23866>>>>>>>>>>>>>>>>>>>        
23866>>>>>>>>>>>>>>>>>>>        If (iIndex < 0) Begin
23868>>>>>>>>>>>>>>>>>>>            Send Add_Element to hoWatchedServers hoServer
23869>>>>>>>>>>>>>>>>>>>        End
23869>>>>>>>>>>>>>>>>>>>>
23869>>>>>>>>>>>>>>>>>>>        
23869>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to True
23870>>>>>>>>>>>>>>>>>>>        
23870>>>>>>>>>>>>>>>>>>>        If (iIndex < 0 and Active_State(Self)) Begin
23872>>>>>>>>>>>>>>>>>>>            Send Add_User_Interface to hoServer Self True // TRUE for watchers
23873>>>>>>>>>>>>>>>>>>>        End
23873>>>>>>>>>>>>>>>>>>>>
23873>>>>>>>>>>>>>>>>>>>    End_Procedure
23874>>>>>>>>>>>>>>>>>>>    
23874>>>>>>>>>>>>>>>>>>>    Procedure Add_ChangedStateWatched_Server Integer hoServer
23876>>>>>>>>>>>>>>>>>>>        Integer iIndex
23876>>>>>>>>>>>>>>>>>>>        Handle hoWatchedServers
23876>>>>>>>>>>>>>>>>>>>        
23876>>>>>>>>>>>>>>>>>>>        Get ChangedStateWatched_Servers to hoWatchedServers
23877>>>>>>>>>>>>>>>>>>>        If (hoWatchedServers = 0) Begin
23879>>>>>>>>>>>>>>>>>>>            Get Create of Desktop U_Broadcaster to hoWatchedServers // modern syntax
23880>>>>>>>>>>>>>>>>>>>            Set ChangedStateWatched_Servers to hoWatchedServers
23881>>>>>>>>>>>>>>>>>>>        End
23881>>>>>>>>>>>>>>>>>>>>
23881>>>>>>>>>>>>>>>>>>>        
23881>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to False
23882>>>>>>>>>>>>>>>>>>>        Get Find_Element of hoWatchedServers hoServer to iIndex
23883>>>>>>>>>>>>>>>>>>>        
23883>>>>>>>>>>>>>>>>>>>        If (iIndex < 0) Begin
23885>>>>>>>>>>>>>>>>>>>            Send Add_Element to hoWatchedServers hoServer
23886>>>>>>>>>>>>>>>>>>>        End
23886>>>>>>>>>>>>>>>>>>>>
23886>>>>>>>>>>>>>>>>>>>        
23886>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to True
23887>>>>>>>>>>>>>>>>>>>    End_Procedure
23888>>>>>>>>>>>>>>>>>>>    
23888>>>>>>>>>>>>>>>>>>>    
23888>>>>>>>>>>>>>>>>>>>    // Expects the class to understand the Active_State property. Relies on the pbDataBindable interface.
23888>>>>>>>>>>>>>>>>>>>    Procedure Attach_Deo_To_Server
23890>>>>>>>>>>>>>>>>>>>        Integer iFile iField
23890>>>>>>>>>>>>>>>>>>>        Boolean bDataBindable bServerScan
23890>>>>>>>>>>>>>>>>>>>        Handle hoServer hoFileDDO hoWatchedServers
23890>>>>>>>>>>>>>>>>>>>        
23890>>>>>>>>>>>>>>>>>>>        Get Server to hoServer
23891>>>>>>>>>>>>>>>>>>>        Get Data_File  to iFile
23892>>>>>>>>>>>>>>>>>>>        Get Data_Field to iField
23893>>>>>>>>>>>>>>>>>>>        Get pbDataBindable to bDataBindable        
23894>>>>>>>>>>>>>>>>>>>        
23894>>>>>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
23896>>>>>>>>>>>>>>>>>>>            Send Add_User_Interface to hoServer Self
23897>>>>>>>>>>>>>>>>>>>            // Extended_DEO_State is used to determine whether the object receives the data binding related
23897>>>>>>>>>>>>>>>>>>>            // message interface from the server DDO...
23897>>>>>>>>>>>>>>>>>>>            Set Extended_DEO_State to (Extended_DSO_State(hoServer) and bDataBindable)
23898>>>>>>>>>>>>>>>>>>>        End
23898>>>>>>>>>>>>>>>>>>>>
23898>>>>>>>>>>>>>>>>>>>        
23898>>>>>>>>>>>>>>>>>>>        Get private_pbServersScanned to bServerScan
23899>>>>>>>>>>>>>>>>>>>        If (not(bServerScan)) Begin
23901>>>>>>>>>>>>>>>>>>>            Send Scan_Servers
23902>>>>>>>>>>>>>>>>>>>        End
23902>>>>>>>>>>>>>>>>>>>>
23902>>>>>>>>>>>>>>>>>>>        
23902>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
23903>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
23905>>>>>>>>>>>>>>>>>>>            Send Add_User_Interface to hoWatchedServers Self True // True for watchers
23906>>>>>>>>>>>>>>>>>>>        End
23906>>>>>>>>>>>>>>>>>>>>
23906>>>>>>>>>>>>>>>>>>>        
23906>>>>>>>>>>>>>>>>>>>        Set Active_State to True
23907>>>>>>>>>>>>>>>>>>>    End_Procedure
23908>>>>>>>>>>>>>>>>>>>    
23908>>>>>>>>>>>>>>>>>>>    // Changed so that this respects Change_disabled_state. I don't
23908>>>>>>>>>>>>>>>>>>>    // like this here but its the best I can think of. Therefore, all
23908>>>>>>>>>>>>>>>>>>>    // objects using server.pkg must understand Change_disabled_state.
23908>>>>>>>>>>>>>>>>>>>    //
23908>>>>>>>>>>>>>>>>>>>    // Changed to not remove from server if static.
23908>>>>>>>>>>>>>>>>>>>    Procedure Set Changed_State Integer newVal
23910>>>>>>>>>>>>>>>>>>>        Integer hoServer hoWatchedServers
23910>>>>>>>>>>>>>>>>>>>        
23910>>>>>>>>>>>>>>>>>>>        If not (Change_Disabled_State(Self)) Begin
23912>>>>>>>>>>>>>>>>>>>            Forward Set Changed_State to newVal
23914>>>>>>>>>>>>>>>>>>>            Get server to hoServer
23915>>>>>>>>>>>>>>>>>>>            
23915>>>>>>>>>>>>>>>>>>>            If (newVal and hoServer) Begin
23917>>>>>>>>>>>>>>>>>>>                Set Changed_State of hoServer to True
23918>>>>>>>>>>>>>>>>>>>                // We also set changed_state of all "foreign" servers. These
23918>>>>>>>>>>>>>>>>>>>                // are the ones whose Data_File is a parent File
23918>>>>>>>>>>>>>>>>>>>                Get ChangedStateWatched_Servers to hoWatchedServers
23919>>>>>>>>>>>>>>>>>>>                If hoWatchedServers ;                    Set Changed_State of hoWatchedServers to True
23922>>>>>>>>>>>>>>>>>>>            End
23922>>>>>>>>>>>>>>>>>>>>
23922>>>>>>>>>>>>>>>>>>>        End
23922>>>>>>>>>>>>>>>>>>>>
23922>>>>>>>>>>>>>>>>>>>    End_Procedure
23923>>>>>>>>>>>>>>>>>>>    
23923>>>>>>>>>>>>>>>>>>>    // returns the table's status for the refresh event. A table can either be
23923>>>>>>>>>>>>>>>>>>>    // cleared, found or not touched by the operation. This can only be called while
23923>>>>>>>>>>>>>>>>>>>    // within Refresh. This was created to hide the private is_file_included command
23923>>>>>>>>>>>>>>>>>>>    Function DDRefreshTableStatus Integer iTable Returns Integer
23925>>>>>>>>>>>>>>>>>>>        Boolean bIncluded
23925>>>>>>>>>>>>>>>>>>>        is_file_included iTable 1 to bIncluded // see if main file is in find done array
23927>>>>>>>>>>>>>>>>>>>        If bIncluded Begin
23929>>>>>>>>>>>>>>>>>>>            Function_Return ddrtsFound
23930>>>>>>>>>>>>>>>>>>>        End
23930>>>>>>>>>>>>>>>>>>>>
23930>>>>>>>>>>>>>>>>>>>        is_file_included iTable 0 to bIncluded // see if main file is in clear done array
23932>>>>>>>>>>>>>>>>>>>        If bIncluded Begin
23934>>>>>>>>>>>>>>>>>>>            Function_Return ddrtsCleared
23935>>>>>>>>>>>>>>>>>>>            
23935>>>>>>>>>>>>>>>>>>>        End
23935>>>>>>>>>>>>>>>>>>>>
23935>>>>>>>>>>>>>>>>>>>        Function_Return ddrtsNone
23936>>>>>>>>>>>>>>>>>>>    End_Function
23937>>>>>>>>>>>>>>>>>>>    
23937>>>>>>>>>>>>>>>>>>>    //   This procedure empties the Watched_Servers broadcaster, after
23937>>>>>>>>>>>>>>>>>>>    //   detaching this object from all of the broadcaster's elements.
23937>>>>>>>>>>>>>>>>>>>    //   This procedure is invoked by Find_Servers_to_Watch, in preparation
23937>>>>>>>>>>>>>>>>>>>    //   for a scan.
23937>>>>>>>>>>>>>>>>>>>    Procedure Delete_Watched_Servers
23939>>>>>>>>>>>>>>>>>>>        Integer hoWatchedServers
23939>>>>>>>>>>>>>>>>>>>        
23939>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
23940>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
23942>>>>>>>>>>>>>>>>>>>            Send Remove_User_Interface to hoWatchedServers Self True // detach from all, TRUE for watchers
23943>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to False
23944>>>>>>>>>>>>>>>>>>>            Send Delete_Data to hoWatchedServers                     // empty it
23945>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to True
23946>>>>>>>>>>>>>>>>>>>        End
23946>>>>>>>>>>>>>>>>>>>>
23946>>>>>>>>>>>>>>>>>>>        
23946>>>>>>>>>>>>>>>>>>>        Get ChangedStateWatched_Servers to hoWatchedServers
23947>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
23949>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to False
23950>>>>>>>>>>>>>>>>>>>            Send Delete_Data to hoWatchedServers                     // empty it
23951>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to True
23952>>>>>>>>>>>>>>>>>>>        End
23952>>>>>>>>>>>>>>>>>>>>
23952>>>>>>>>>>>>>>>>>>>    End_Procedure
23953>>>>>>>>>>>>>>>>>>>    
23953>>>>>>>>>>>>>>>>>>>    // Required DD/DEO interface. Indicates if this DEO is a data bindable control or a container.
23953>>>>>>>>>>>>>>>>>>>    // For cWebControls, this is just another way of querying pbDataBindable, used by DD's
23953>>>>>>>>>>>>>>>>>>>    Function DEO_Control_Object Returns Boolean
23955>>>>>>>>>>>>>>>>>>>        Boolean bDataBindable
23955>>>>>>>>>>>>>>>>>>>        Get pbDataBindable to bDataBindable
23956>>>>>>>>>>>>>>>>>>>        Function_Return bDataBindable

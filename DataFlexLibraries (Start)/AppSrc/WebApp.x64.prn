16421>>>>>>>>>>>    Procedure Define_cWebObject_mixin
16423>>>>>>>>>>>        Handle hoMeta
16423>>>>>>>>>>>        
16423>>>>>>>>>>>        Send Define_cWebPropertyMetaData_mixin
16424>>>>>>>>>>>        
16424>>>>>>>>>>>        //  cWebClassPropertyData object handling administration of class level web properties
16424>>>>>>>>>>>        Property Handle phoClassPropMeta C_WebUnresolvedObject
16425>>>>>>>>>>>        
16425>>>>>>>>>>>        //  Find reference to the class level web properties
16425>>>>>>>>>>>        Get CreateClassPropMetaData of ghoWebClassPropertyMetaStore (ObjectClass(Self)) to hoMeta
16426>>>>>>>>>>>        Set phoClassPropMeta to hoMeta
16427>>>>>>>>>>>        
16427>>>>>>>>>>>        Property tWebPropRule[] paPubPropertyRules     // Responsive mode property values
16428>>>>>>>>>>>        
16428>>>>>>>>>>>        // Published Methods:
16428>>>>>>>>>>>        // The set of published procedures and functions in this object. This comprises
16428>>>>>>>>>>>        // the legal call interface of this object i.e. client calls. When CallAction is
16428>>>>>>>>>>>        // received from the client, the name of the action method must match one of these
16428>>>>>>>>>>>        // published methods otherwise it will be ignored. This makes resolving the action
16428>>>>>>>>>>>        // method easier and closes a possible security hole if any action could be called.
16428>>>>>>>>>>>        // - Procedure Set is not supported.
16428>>>>>>>>>>>        // - You cannot publish a Procedure and a Function with the same name in the same object.
16428>>>>>>>>>>>        //
16428>>>>>>>>>>>        // These  arrays should contain matching members. i.e. the i'th member
16428>>>>>>>>>>>        // of each array should pertain to the same published method. The data
16428>>>>>>>>>>>        // is stored in separate arrays instead of an array of struct in order
16428>>>>>>>>>>>        // to allow fast searches in each array.
16428>>>>>>>>>>>        Property Handle[]  paPubMethodHandles       // handle to the procedure or function
16429>>>>>>>>>>>        Property String[]  paPubMethodNames         // name of the method
16430>>>>>>>>>>>        Property Boolean[] paPubMethodIsFunction    // true if the published method is a function, False if it is a procedure.
16431>>>>>>>>>>>        
16431>>>>>>>>>>>        // Array of nested child cWebControl object handles. This is iterated during the
16431>>>>>>>>>>>        // SerializeToJSON call. See Also paChildWebControlNames
16431>>>>>>>>>>>        Property Handle[] paChildWebControls
16432>>>>>>>>>>>
16432>>>>>>>>>>>        Property Boolean pbDataBindable False    // True if the object supports the cWebBaseDEO interface (i.e. Entry_Item, Data_File & Data_Field)
16433>>>>>>>>>>>        
16433>>>>>>>>>>>        Property Handle phoActionJsonData C_WebUnresolvedObject // cJsonObject handle representing the action data during a server action.
16434>>>>>>>>>>>        
16434>>>>>>>>>>>        Property String psJSClass ""             // JavaScript class name of client-side object
16435>>>>>>>>>>>        
16435>>>>>>>>>>>        Property Handle phoWebNeighborhood C_WebUnresolvedObject  // object handle of this object's container WebView, WebDialog or cWebApp object.
16436>>>>>>>>>>>
16436>>>>>>>>>>>
16436>>>>>>>>>>>        // Dynamic object properties:
16436>>>>>>>>>>>        // A cWebObject can be a dynamic object. In that case, some additional properties
16436>>>>>>>>>>>        // will be set. These properties should be used with caution. Dynamic object rely 
16436>>>>>>>>>>>        // on certain hooks in the regular flow of an application, so changes in these 
16436>>>>>>>>>>>        // properties can stop an application from functioning.      
16436>>>>>>>>>>>        Property String psDynamicObjectId           // The (unique) ID of the dynamic object
16437>>>>>>>>>>>        
16437>>>>>>>>>>>        Property Handle phoOwner C_WebUnresolvedObject  // The owner object of this (dynamic) web object
16438>>>>>>>>>>>        
16438>>>>>>>>>>>        Property Handle phoHost C_WebUnresolvedObject   // The host of this web object (cWebApp or cLocalWebControlHost)
16439>>>>>>>>>>>        
16439>>>>>>>>>>>        Property Boolean pbGhost False  // Ghost objects do not communicate to the client
16440>>>>>>>>>>>
16440>>>>>>>>>>>        Set peNeighborhood to nhNo
16441>>>>>>>>>>>        Set psJSClass to "df.WebObject"
16442>>>>>>>>>>>        Send RegisterThisWebObject
16443>>>>>>>>>>>    End_Procedure
16444>>>>>>>>>>>    
16444>>>>>>>>>>>    Import_Class_Protocol cWebPropertyMetaData_mixin
16445>>>>>>>>>>>    
16445>>>>>>>>>>>    // Checks whether the object is dynamic. Relies on the fact that 'phoOwner'
16445>>>>>>>>>>>    // will only be set for dynamic objects. Therefore, the property should
16445>>>>>>>>>>>    // never be set for regular objects.
16445>>>>>>>>>>>    Function IsDynamicObject Returns Boolean
16447>>>>>>>>>>>        Handle hoOwner
16447>>>>>>>>>>>        Boolean bRes
16447>>>>>>>>>>>        
16447>>>>>>>>>>>        Get Owner to hoOwner
16448>>>>>>>>>>>        If (hoOwner <> Self) ;            Get IsDynamicObjectContainer of hoOwner to bRes
16451>>>>>>>>>>>        Else ;            Move False to bRes
16453>>>>>>>>>>>        
16453>>>>>>>>>>>        Function_Return bRes
16454>>>>>>>>>>>    End_Function  
16455>>>>>>>>>>>    
16455>>>>>>>>>>>    
16455>>>>>>>>>>>    // Checks if the webobject is loaded to the client by asking the owner.
16455>>>>>>>>>>>    Function IsLoaded Returns Boolean
16457>>>>>>>>>>>        
16457>>>>>>>>>>>        Handle hoOwner hoNeighborhood
16457>>>>>>>>>>>        Boolean bIsLoaded
16457>>>>>>>>>>>        
16457>>>>>>>>>>>        Move False to bIsLoaded
16458>>>>>>>>>>>        If (pbGhost(Self)) ;            Function_Return False
16461>>>>>>>>>>>        
16461>>>>>>>>>>>        If (IsDynamicObject(Self)) Begin
16463>>>>>>>>>>>            Get Owner to hoOwner
16464>>>>>>>>>>>            Get IsLoaded of hoOwner to bIsLoaded
16465>>>>>>>>>>>        End
16465>>>>>>>>>>>>
16465>>>>>>>>>>>        Else Begin
16466>>>>>>>>>>>            Get phoWebNeighborHood to hoNeighborhood
16467>>>>>>>>>>>            If (hoNeighborhood <> C_WebUnresolvedObject) Begin
16469>>>>>>>>>>>                Get IsLoaded of hoNeighborhood to bIsLoaded
16470>>>>>>>>>>>            End
16470>>>>>>>>>>>>
16470>>>>>>>>>>>        End
16470>>>>>>>>>>>>
16470>>>>>>>>>>>            
16470>>>>>>>>>>>        Function_Return bIsLoaded
16471>>>>>>>>>>>    End_Function
16472>>>>>>>>>>>    
16472>>>>>>>>>>>    // Returns the owner of the object which is the host (cWebApp/cLocalWebControlHost) or the cWebDynamicObjectContainer.
16472>>>>>>>>>>>    Function Owner Returns Handle
16474>>>>>>>>>>>        Handle hoOwner
16474>>>>>>>>>>>
16474>>>>>>>>>>>        Get phoOwner to hoOwner
16475>>>>>>>>>>>        
16475>>>>>>>>>>>        If (hoOwner = C_WebUnresolvedObject) Begin
16477>>>>>>>>>>>            Delegate Get FindOwner to hoOwner
16479>>>>>>>>>>>
16479>>>>>>>>>>>            If (hoOwner = C_WebUnresolvedObject) ;                Error DFERR_PROGRAM "WebObject without owner"
16482>>>>>>>>>>>            
16482>>>>>>>>>>>            Set phoOwner to hoOwner
16483>>>>>>>>>>>        End
16483>>>>>>>>>>>>
16483>>>>>>>>>>>        
16483>>>>>>>>>>>        Function_Return hoOwner
16484>>>>>>>>>>>    End_Function
16485>>>>>>>>>>>    
16485>>>>>>>>>>>    // Uses delegation to find the owner object.
16485>>>>>>>>>>>    Function FindOwner Returns Handle
16487>>>>>>>>>>>        Handle hoOwner
16487>>>>>>>>>>>
16487>>>>>>>>>>>        Get phoOwner to hoOwner
16488>>>>>>>>>>>        
16488>>>>>>>>>>>        If (hoOwner = C_WebUnresolvedObject) Begin
16490>>>>>>>>>>>            Delegate Get FindOwner to hoOwner
16492>>>>>>>>>>>        End
16492>>>>>>>>>>>>
16492>>>>>>>>>>>        
16492>>>>>>>>>>>        Function_Return hoOwner
16493>>>>>>>>>>>    End_Function
16494>>>>>>>>>>>    
16494>>>>>>>>>>>    // Returns the host of the web object (cWebApp or cLocalWebControlHost).
16494>>>>>>>>>>>    Function Host Returns Handle
16496>>>>>>>>>>>        Handle hoHost
16496>>>>>>>>>>>
16496>>>>>>>>>>>        Get phoHost to hoHost
16497>>>>>>>>>>>        
16497>>>>>>>>>>>        If (hoHost = C_WebUnresolvedObject) Begin
16499>>>>>>>>>>>            Delegate Get FindHost to hoHost
16501>>>>>>>>>>>            
16501>>>>>>>>>>>            If (hoHost = C_WebUnresolvedObject) ;                Error DFERR_PROGRAM "WebObject without host"
16504>>>>>>>>>>>            
16504>>>>>>>>>>>            Set phoHost to hoHost
16505>>>>>>>>>>>        End
16505>>>>>>>>>>>>
16505>>>>>>>>>>>        
16505>>>>>>>>>>>        Function_Return hoHost
16506>>>>>>>>>>>    End_Function
16507>>>>>>>>>>>    
16507>>>>>>>>>>>    // Uses delegation to find the host object.
16507>>>>>>>>>>>    Function FindHost Returns Handle
16509>>>>>>>>>>>        Handle hoHost
16509>>>>>>>>>>>
16509>>>>>>>>>>>        Get phoHost to hoHost
16510>>>>>>>>>>>        
16510>>>>>>>>>>>        If (hoHost = C_WebUnresolvedObject) Begin
16512>>>>>>>>>>>            Delegate Get FindHost to hoHost
16514>>>>>>>>>>>        End
16514>>>>>>>>>>>>
16514>>>>>>>>>>>        
16514>>>>>>>>>>>        Function_Return hoHost
16515>>>>>>>>>>>    End_Function
16516>>>>>>>>>>>    

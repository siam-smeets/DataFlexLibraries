10652>>>>>>>>>        
10652>>>>>>>>>        If (num_arguments < 2) Begin
10654>>>>>>>>>            Move typeString to iType
10655>>>>>>>>>        End
10655>>>>>>>>>>
10655>>>>>>>>>        Else Begin
10656>>>>>>>>>            Move iParamType to iType
10657>>>>>>>>>        End

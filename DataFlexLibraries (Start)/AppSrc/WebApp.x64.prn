25193>>>>>>>>>>>>>    Function StrSplitToArrayUnescapedWithTrim String sStr String sDel Returns String[]
25195>>>>>>>>>>>>>        Integer iCounter iLast iLength iDelLength iEscapedLength
25195>>>>>>>>>>>>>        String sEscapedDel
25195>>>>>>>>>>>>>        String[] aValues
25196>>>>>>>>>>>>>        
25196>>>>>>>>>>>>>        Move 1 to iLast
25197>>>>>>>>>>>>>        Move (Length(sStr)) to iLength
25198>>>>>>>>>>>>>        Move (Length(sDel)) to iDelLength
25199>>>>>>>>>>>>>        Move ("\" + sDel) to sEscapedDel
25200>>>>>>>>>>>>>        Move (Length(sEscapedDel)) to iEscapedLength
25201>>>>>>>>>>>>>        
25201>>>>>>>>>>>>>        If (iLength = 0) Begin
25203>>>>>>>>>>>>>             Function_Return aValues
25204>>>>>>>>>>>>>        End
25204>>>>>>>>>>>>>>
25204>>>>>>>>>>>>>        
25204>>>>>>>>>>>>>        For iCounter from 1 to iLength
25210>>>>>>>>>>>>>>
25210>>>>>>>>>>>>>            If (Mid(sStr, iDelLength, iCounter) = sDel and ;                Mid(sStr, iEscapedLength, iCounter - 1) <> sEscapedDel) Begin
25212>>>>>>>>>>>>>                Move (Trim(Replaces(sEscapedDel, Mid(sStr, iCounter - iLast, iLast), sDel))) to aValues[SizeOfArray(aValues)]
25213>>>>>>>>>>>>>                Move (iCounter + 1) to iLast
25214>>>>>>>>>>>>>            End
25214>>>>>>>>>>>>>>
25214>>>>>>>>>>>>>        Loop
25215>>>>>>>>>>>>>>
25215>>>>>>>>>>>>>        Move (Trim(Replaces(sEscapedDel, Mid(sStr, iCounter - iLast, iLast), sDel))) to aValues[SizeOfArray(aValues)]
25216>>>>>>>>>>>>>        Function_Return aValues
25217>>>>>>>>>>>>>    End_Function
25218>>>>>>>>>>>>>    
25218>>>>>>>>>>>>>    Function StrReplacesUnescaped String sReplace String sStr String sWith Returns String
25220>>>>>>>>>>>>>        Integer iCounter iLast iDelLength iEscapedLength
25220>>>>>>>>>>>>>        String sEscapedDel sPre sPost
25220>>>>>>>>>>>>>        
25220>>>>>>>>>>>>>        Move 1 to iLast
25221>>>>>>>>>>>>>        Move (Length(sReplace)) to iDelLength
25222>>>>>>>>>>>>>        Move ("\" + sReplace) to sEscapedDel
25223>>>>>>>>>>>>>        Move (Length(sEscapedDel)) to iEscapedLength
25224>>>>>>>>>>>>>        
25224>>>>>>>>>>>>>        If ((Length(sStr)) = 0) Begin
25226>>>>>>>>>>>>>            Function_Return sStr
25227>>>>>>>>>>>>>        End
25227>>>>>>>>>>>>>>
25227>>>>>>>>>>>>>        
25227>>>>>>>>>>>>>        While (iCounter <= Length(sStr))
25231>>>>>>>>>>>>>            If (Mid(sStr, iDelLength, iCounter) = sReplace and Mid(sStr, iEscapedLength, iCounter - 1) <> sEscapedDel) Begin
25233>>>>>>>>>>>>>                Move (Left(sStr, iCounter - iDelLength) + sWith + Mid(sStr, (Length(sStr)) - iCounter, iCounter + 1)) to sStr
25234>>>>>>>>>>>>>                Move (iCounter + iEscapedLength - 1) to iCounter
25235>>>>>>>>>>>>>                Move (iCounter + 1) to iLast
25236>>>>>>>>>>>>>            End
25236>>>>>>>>>>>>>>
25236>>>>>>>>>>>>>            Increment iCounter
25237>>>>>>>>>>>>>        Loop
25238>>>>>>>>>>>>>>
25238>>>>>>>>>>>>>        Function_Return sStr
25239>>>>>>>>>>>>>    End_Function

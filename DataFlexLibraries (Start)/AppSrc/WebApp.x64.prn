30225>>>>>>>>>>>    Function KeyParameter Handle hKey Integer iQuery Returns Integer
30227>>>>>>>>>>>        Integer iBuffer iLen
30227>>>>>>>>>>>        Boolean bOk
30227>>>>>>>>>>>        
30227>>>>>>>>>>>        Move (SizeOfType(Integer)) to iLen
30228>>>>>>>>>>>        Move (CryptGetKeyParam(hKey,iQuery,AddressOf(iBuffer),AddressOf(iLen),0)) to bOk
30229>>>>>>>>>>>        Function_Return iBuffer
30230>>>>>>>>>>>    End_Function
30231>>>>>>>>>>>    
30231>>>>>>>>>>>    // Retrieves a hash value
30231>>>>>>>>>>>    Function HashValue Handle lhHash Returns UChar[]
30233>>>>>>>>>>>        UChar[] ucHash
30234>>>>>>>>>>>        Integer liResult
30234>>>>>>>>>>>        DWord   dwDataLen
30234>>>>>>>>>>>        
30234>>>>>>>>>>>        Move 0 to dwDataLen
30235>>>>>>>>>>>        Move (CryptGetHashParam(lhHash,HP_HASHVAL,0,AddressOf(dwDataLen),0)) to liResult
30236>>>>>>>>>>>        If (liResult = 0) ;            Function_Return ""
30239>>>>>>>>>>>        
30239>>>>>>>>>>>        Move (ResizeArray(ucHash, dwDataLen, 0)) to ucHash
30240>>>>>>>>>>>        Move (CryptGetHashParam(lhHash,HP_HASHVAL,AddressOf(ucHash),AddressOf(dwDataLen),0)) to liResult
30241>>>>>>>>>>>        If (liResult = 0) ;            Function_Return ""
30244>>>>>>>>>>>        
30244>>>>>>>>>>>        Function_Return ucHash
30245>>>>>>>>>>>    End_Function
30246>>>>>>>>>>>
30246>>>>>>>>>>>    // Encrypts data
30246>>>>>>>>>>>    Function Encrypt UChar[] ucPassword UChar[] ucData Returns UChar[]
30248>>>>>>>>>>>        Handle hProv hHash hKey
30248>>>>>>>>>>>        Integer iAlgorithm iDataLen iCipherLen iErr
30248>>>>>>>>>>>        Boolean bOk
30248>>>>>>>>>>>        
30248>>>>>>>>>>>        Get AcquireContext to hProv
30249>>>>>>>>>>>        If (hProv) Begin
30251>>>>>>>>>>>            Get CreateHash hProv to hHash
30252>>>>>>>>>>>            If (hHash) Begin
30254>>>>>>>>>>>                Get HashData hHash ucPassword to bOk
30255>>>>>>>>>>>                If (bOk) Begin
30257>>>>>>>>>>>                    Get piCipher to iAlgorithm
30258>>>>>>>>>>>                    Get DeriveKey hProv hHash to hKey
30259>>>>>>>>>>>                End
30259>>>>>>>>>>>>
30259>>>>>>>>>>>                Get DestroyHash hHash to bOk
30260>>>>>>>>>>>            End
30260>>>>>>>>>>>>
30260>>>>>>>>>>>            
30260>>>>>>>>>>>            If (hKey) Begin
30262>>>>>>>>>>>                //  First call to determine resulting data size
30262>>>>>>>>>>>                Move (SizeOfArray(ucData)) to iDataLen
30263>>>>>>>>>>>                Move (SizeOfArray(ucData)) to iCipherLen
30264>>>>>>>>>>>                Move (CryptEncrypt(hKey, 0, True, 0, 0, AddressOf(iCipherLen), iDataLen)) to bOk
30265>>>>>>>>>>>                
30265>>>>>>>>>>>                //  Reserve space in string
30265>>>>>>>>>>>                If (iDataLen < iCipherLen) Begin
30267>>>>>>>>>>>                    Move (ResizeArray(ucData, iCipherLen, 0)) to ucData
30268>>>>>>>>>>>                End
30268>>>>>>>>>>>>
30268>>>>>>>>>>>                
30268>>>>>>>>>>>                //  Call to really decrypt
30268>>>>>>>>>>>                Move (CryptEncrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iDataLen),SizeOfArray(ucData))) to bOk
30269>>>>>>>>>>>                //If (not(bOk)) Begin
30269>>>>>>>>>>>                //Move "" to sData
30269>>>>>>>>>>>                //Move (GetLastError()) to iErr
30269>>>>>>>>>>>                //End
30269>>>>>>>>>>>                
30269>>>>>>>>>>>                Get DestroyKey hKey to bOk
30270>>>>>>>>>>>            End 
30270>>>>>>>>>>>>
30270>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30271>>>>>>>>>>>        End 
30271>>>>>>>>>>>>
30271>>>>>>>>>>>        Function_Return ucData
30272>>>>>>>>>>>    End_Function
30273>>>>>>>>>>>    
30273>>>>>>>>>>>    // Decrypts data
30273>>>>>>>>>>>    Function Decrypt UChar[] ucPassword UChar[] ucData Returns UChar[]
30275>>>>>>>>>>>        Handle hProv hHash hKey
30275>>>>>>>>>>>        Integer iAlgorithm iDataLen
30275>>>>>>>>>>>        Boolean bOk
30275>>>>>>>>>>>        
30275>>>>>>>>>>>        Get AcquireContext to hProv
30276>>>>>>>>>>>        If (hProv) Begin
30278>>>>>>>>>>>            Get CreateHash hProv to hHash
30279>>>>>>>>>>>            If (hHash) Begin
30281>>>>>>>>>>>                Get HashData hHash ucPassword to bOk
30282>>>>>>>>>>>                If (bOk) Begin
30284>>>>>>>>>>>                    Get piCipher to iAlgorithm
30285>>>>>>>>>>>                    Get DeriveKey hProv hHash to hKey
30286>>>>>>>>>>>                End
30286>>>>>>>>>>>>
30286>>>>>>>>>>>                Get DestroyHash hHash to bOk
30287>>>>>>>>>>>            End
30287>>>>>>>>>>>>
30287>>>>>>>>>>>            
30287>>>>>>>>>>>            If (hKey) Begin
30289>>>>>>>>>>>                Move (SizeOfArray(ucData)) to iDataLen
30290>>>>>>>>>>>                Move (CryptDecrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iDataLen))) to bOk
30291>>>>>>>>>>>                //  Resulting data can be shorter as the input string, in that case we shorten the result string
30291>>>>>>>>>>>                If (SizeOfArray (ucData) > iDataLen) Begin
30293>>>>>>>>>>>                    Move (ResizeArray(ucData, iDataLen)) to ucData
30294>>>>>>>>>>>                End
30294>>>>>>>>>>>>
30294>>>>>>>>>>>                
30294>>>>>>>>>>>                Get DestroyKey hKey to bOk
30295>>>>>>>>>>>            End
30295>>>>>>>>>>>>
30295>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30296>>>>>>>>>>>        End
30296>>>>>>>>>>>>
30296>>>>>>>>>>>        Function_Return ucData
30297>>>>>>>>>>>    End_Function
30298>>>>>>>>>>>    
30298>>>>>>>>>>>    // Creates a key
30298>>>>>>>>>>>    Function CreateKey Handle hProv Returns Handle
30300>>>>>>>>>>>        Integer iAlg iType iByte iLength iSize
30300>>>>>>>>>>>        CryptoBlob keyBlob
30300>>>>>>>>>>>        CryptoBlob keyBlob
30300>>>>>>>>>>>        Boolean bOk
30300>>>>>>>>>>>        Handle hKey
30300>>>>>>>>>>>        UChar[] aKey
30301>>>>>>>>>>>
30301>>>>>>>>>>>        Get paKey to aKey
30302>>>>>>>>>>>        Get piKeyAlg to iAlg
30303>>>>>>>>>>>        Get piKeyType to iType
30304>>>>>>>>>>>        Move iAlg                   to keyBlob.header.bType
30305>>>>>>>>>>>        Move CUR_BLOB_VERSION       to keyBlob.header.bVersion
30306>>>>>>>>>>>        Move iType                  to keyBlob.header.aiKeyAlg
30307>>>>>>>>>>>        Move (SizeOfArray(aKey))    to keyBlob.cbKeySize
30308>>>>>>>>>>>        
30308>>>>>>>>>>>        Move (SizeOfArray(aKey)-1) to iLength
30309>>>>>>>>>>>        For iByte from 0 to iLength
30315>>>>>>>>>>>>
30315>>>>>>>>>>>            Move aKey[iByte] to keyBlob.rgbKeyData[iByte]
30316>>>>>>>>>>>        Loop
30317>>>>>>>>>>>>
30317>>>>>>>>>>>        
30317>>>>>>>>>>>        Move 0 to hKey
30318>>>>>>>>>>>        Move (CryptImportKey(hProv,AddressOf(keyBlob),SizeOfType(CryptoBlob),0,0,AddressOf(hKey))) to bOk
30319>>>>>>>>>>>        Function_Return hKey
30320>>>>>>>>>>>    End_Function
30321>>>>>>>>>>>    
30321>>>>>>>>>>>    // Sets the key parameters
30321>>>>>>>>>>>    Function SetKeyParameters Handle hKey Returns Boolean
30323>>>>>>>>>>>        Integer iPadding iMode
30323>>>>>>>>>>>        Boolean bOk
30323>>>>>>>>>>>        UChar[] aIV
30324>>>>>>>>>>>        
30324>>>>>>>>>>>        //Move (SizeOfArray(aIV)-1) to iLength
30324>>>>>>>>>>>        //For iByte from 0 to iLength
30324>>>>>>>>>>>        //    Move iByte to aIV[iByte]
30324>>>>>>>>>>>        //Loop
30324>>>>>>>>>>>
30324>>>>>>>>>>>        // Set initialization vector
30324>>>>>>>>>>>        Get paIV to aIV
30325>>>>>>>>>>>        Move (CryptSetKeyParam(hKey,KP_IV,AddressOf(aIV),0)) to bOk
30326>>>>>>>>>>>        If (bOk) Begin
30328>>>>>>>>>>>            // Set padding
30328>>>>>>>>>>>            Get piKeyPadding to iPadding
30329>>>>>>>>>>>            Move (CryptSetKeyParam(hKey,KP_PADDING,AddressOf(iPadding),0)) to bOk
30330>>>>>>>>>>>            If (bOk) Begin
30332>>>>>>>>>>>                // Set move
30332>>>>>>>>>>>                Get piKeyMode to iMode
30333>>>>>>>>>>>                Move (CryptSetKeyParam(hKey,KP_MODE,AddressOf(iMode),0)) to bOk
30334>>>>>>>>>>>            End
30334>>>>>>>>>>>>
30334>>>>>>>>>>>        End
30334>>>>>>>>>>>>
30334>>>>>>>>>>>        Function_Return bOk        
30335>>>>>>>>>>>    End_Function
30336>>>>>>>>>>>    
30336>>>>>>>>>>>    // Encrypts using block cipher
30336>>>>>>>>>>>    Function BlockEncrypt UChar[] ucData Returns UChar[]
30338>>>>>>>>>>>        Handle hProv hKey
30338>>>>>>>>>>>        Integer iLen iSize iBlocks
30338>>>>>>>>>>>        Boolean bOk
30338>>>>>>>>>>>        
30338>>>>>>>>>>>        Get AcquireContext to hProv
30339>>>>>>>>>>>        If (hProv) Begin
30341>>>>>>>>>>>            // Create key
30341>>>>>>>>>>>            Get CreateKey hProv to hKey
30342>>>>>>>>>>>            If (hKey) Begin
30344>>>>>>>>>>>                Get SetKeyParameters hKey to bOk
30345>>>>>>>>>>>                If (bOk) Begin
30347>>>>>>>>>>>                    // Buffer for block ciphers can be up to block length larger
30347>>>>>>>>>>>                    Get piBlockSize to iSize
30348>>>>>>>>>>>                    Move (SizeOfArray(ucData)) to iLen
30349>>>>>>>>>>>                    
30349>>>>>>>>>>>                    Move ((iLen/iSize)+1) to iBlocks
30350>>>>>>>>>>>                    Move (ResizeArray(ucData,iBlocks*iSize)) to ucData
30351>>>>>>>>>>>                    Move (CryptEncrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iLen),SizeOfArray(ucData))) to bOk
30352>>>>>>>>>>>                End
30352>>>>>>>>>>>>
30352>>>>>>>>>>>                Get DestroyKey hKey to bOk
30353>>>>>>>>>>>            End
30353>>>>>>>>>>>>
30353>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30354>>>>>>>>>>>        End
30354>>>>>>>>>>>>
30354>>>>>>>>>>>        Function_Return ucData
30355>>>>>>>>>>>    End_Function
30356>>>>>>>>>>>    
30356>>>>>>>>>>>    // Decrypts using block cipher
30356>>>>>>>>>>>    Function BlockDecrypt UChar[] ucData Returns UChar[]
30358>>>>>>>>>>>        Handle hProv hKey
30358>>>>>>>>>>>        Integer iLen
30358>>>>>>>>>>>        Boolean bOk
30358>>>>>>>>>>>        
30358>>>>>>>>>>>        Get AcquireContext to hProv
30359>>>>>>>>>>>        If (hProv) Begin
30361>>>>>>>>>>>            // Create key
30361>>>>>>>>>>>            Get CreateKey hProv to hKey
30362>>>>>>>>>>>            If (hKey) Begin
30364>>>>>>>>>>>                Get SetKeyParameters hKey to bOk
30365>>>>>>>>>>>                If (bOk) Begin
30367>>>>>>>>>>>                    Move (SizeOfArray(ucData)) to iLen
30368>>>>>>>>>>>                    Move (CryptDecrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iLen))) to bOk
30369>>>>>>>>>>>                    Move (ResizeArray(ucData,iLen)) to ucData
30370>>>>>>>>>>>                End
30370>>>>>>>>>>>>
30370>>>>>>>>>>>                Get DestroyKey hKey to bOk
30371>>>>>>>>>>>            End
30371>>>>>>>>>>>>
30371>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30372>>>>>>>>>>>        End
30372>>>>>>>>>>>>
30372>>>>>>>>>>>        Function_Return ucData
30373>>>>>>>>>>>    End_Function

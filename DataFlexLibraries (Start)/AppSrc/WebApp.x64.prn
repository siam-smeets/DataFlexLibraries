29410>>>>>>>>>>>    //  Parses newline characters 
29410>>>>>>>>>>>    Procedure SkipNewLine tMultipartParsingData ByRef parsedata
29412>>>>>>>>>>>        //  Skip carriage return
29412>>>>>>>>>>>        If (parsedata.iChunkRead < SizeOfArray(parsedata.ucCurrentChunk) and parsedata.ucCurrentChunk[parsedata.iChunkRead] = 13) Begin
29414>>>>>>>>>>>            Increment parsedata.iChunkRead
29415>>>>>>>>>>>            If (parsedata.iChunkRead >= SizeOfArray(parsedata.ucCurrentChunk)) Begin
29417>>>>>>>>>>>                Send ReadChunk (&parsedata)
29418>>>>>>>>>>>            End
29418>>>>>>>>>>>>
29418>>>>>>>>>>>        
29418>>>>>>>>>>>            //  Skip line feed
29418>>>>>>>>>>>            If (parsedata.iChunkRead < SizeOfArray(parsedata.ucCurrentChunk) and parsedata.ucCurrentChunk[parsedata.iChunkRead] = 10) Begin
29420>>>>>>>>>>>                Increment parsedata.iChunkRead
29421>>>>>>>>>>>                If (parsedata.iChunkRead >= SizeOfArray(parsedata.ucCurrentChunk)) Begin
29423>>>>>>>>>>>                    Send ReadChunk (&parsedata)
29424>>>>>>>>>>>                End
29424>>>>>>>>>>>>
29424>>>>>>>>>>>            End
29424>>>>>>>>>>>>
29424>>>>>>>>>>>        End
29424>>>>>>>>>>>>
29424>>>>>>>>>>>    End_Procedure
29425>>>>>>>>>>>    
29425>>>>>>>>>>>    //  Moves to the next chunk by updating the parsing data. It reads the next chunk for peeking ahead.
29425>>>>>>>>>>>    Procedure ReadChunk tMultipartParsingData ByRef parsedata
29427>>>>>>>>>>>        //  Move to next chunk (already in cache)
29427>>>>>>>>>>>        Move (parsedata.iChunkOffset + SizeOfArray(parsedata.ucCurrentChunk)) to parsedata.iChunkOffset
29428>>>>>>>>>>>        Move parsedata.ucNextChunk to parsedata.ucCurrentChunk
29429>>>>>>>>>>>        Move 0 to parsedata.iChunkRead
29430>>>>>>>>>>>        
29430>>>>>>>>>>>        //  Update the boundpos
29430>>>>>>>>>>>        Get FindToken (&parsedata) parsedata.ucBoundary False False to parsedata.iBoundPos
29431>>>>>>>>>>>        
29431>>>>>>>>>>>        //  Cache the next chunk
29431>>>>>>>>>>>        If (not(parsedata.bEndOfReq)) Begin
29433>>>>>>>>>>>            Get RequestDataUChar HTTP_DEFAULT_CHUNK_SIZE to parsedata.ucNextChunk
29434>>>>>>>>>>>            Move (SizeOfArray(parsedata.ucNextChunk) < HTTP_DEFAULT_CHUNK_SIZE) to parsedata.bEndOfReq
29435>>>>>>>>>>>            Move (parsedata.iSize + SizeOfArray(parsedata.ucNextChunk)) to parsedata.iSize
29436>>>>>>>>>>>        End
29436>>>>>>>>>>>>
29436>>>>>>>>>>>    End_Procedure
29437>>>>>>>>>>>    
29437>>>>>>>>>>>    //  Extracts a value from the request (like content-type, filename, field name). The current 
29437>>>>>>>>>>>    //  position (iChunkRead) will be moved until the end of the value.
29437>>>>>>>>>>>    //  
29437>>>>>>>>>>>    //  Params:
29437>>>>>>>>>>>    //      parsedata   Parsing data for the current parse.
29437>>>>>>>>>>>    //      ucToken     The token that marks the end of the field.
29437>>>>>>>>>>>    //      bBoundPos   If true it will not read past the next boundary.
29437>>>>>>>>>>>    Function ExtractField tMultipartParsingData ByRef parsedata UChar[] ucToken Boolean bBoundPos Returns String
29439>>>>>>>>>>>        Integer iTokenPos
29439>>>>>>>>>>>        UChar[] ucResult
29440>>>>>>>>>>>        String sResult
29440>>>>>>>>>>>        
29440>>>>>>>>>>>        Get FindToken (&parsedata) ucToken False bBoundPos to iTokenPos
29441>>>>>>>>>>>        
29441>>>>>>>>>>>        //  The token might run into the next chunk
29441>>>>>>>>>>>        While (iTokenPos < 0 and (parsedata.iChunkOffset + parsedata.iChunkRead < parsedata.iSize) and not(parsedata.bAbort))
29445>>>>>>>>>>>            Move (AppendArray(ucResult, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk)))) to ucResult
29446>>>>>>>>>>>            Send ReadChunk (&parsedata)
29447>>>>>>>>>>>            Get FindToken (&parsedata) ucToken False False to iTokenPos
29448>>>>>>>>>>>        Loop
29449>>>>>>>>>>>>
29449>>>>>>>>>>>        
29449>>>>>>>>>>>        If (iTokenPos > 0) Begin
29451>>>>>>>>>>>            Move (AppendArray(ucResult, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, iTokenPos - 1))) to ucResult
29452>>>>>>>>>>>            Move (iTokenPos + SizeOfArray(ucToken)) to parsedata.iChunkRead
29453>>>>>>>>>>>        End
29453>>>>>>>>>>>>
29453>>>>>>>>>>>        Else Begin
29454>>>>>>>>>>>            Move (ResizeArray(ucResult, 0)) to ucResult
29455>>>>>>>>>>>        End
29455>>>>>>>>>>>>
29455>>>>>>>>>>>        
29455>>>>>>>>>>>        Get ConvertRequestDataToString ucResult to sResult
29456>>>>>>>>>>>        Function_Return sResult
29457>>>>>>>>>>>    End_Function

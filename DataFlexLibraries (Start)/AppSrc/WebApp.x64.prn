16151>>>>>>>>>>>>>>>
16151>>>>>>>>>>>>>>>/*The administration of web properties at runtime is now optimized so and deduplicated at class level. So each cWebObject instance holds a reference to a cWebClassPropertyData object that stores the web property data for its class. Optionally it can also have a second cWebPropertyMetaData object that stores web properties created at object level.*/
16151>>>>>>>>>>>>>>>
16151>>>>>>>>>>>>>>>/*Represents a single web property, is used for storage and to pass a web property reference arround.  */
16151>>>>>>>>>>>>>>>Struct tWebPropMetaData
16151>>>>>>>>>>>>>>>    Handle hmSetter     //  Setter message
16151>>>>>>>>>>>>>>>    Handle hmGetter     //  Getter message
16151>>>>>>>>>>>>>>>    String sName        //  Name with proper casing
16151>>>>>>>>>>>>>>>    Integer eType       //  Property type (cArgInt, cArgStr, cArgArray, cArgStruct, ...)
16151>>>>>>>>>>>>>>>    Integer eMode       //  Web property mode (wptClient, wptServerPage, wptServerSession, wptClientProtected)
16151>>>>>>>>>>>>>>>    String sDefault     //  Initial value of the property 
16151>>>>>>>>>>>>>>>End_Struct
16151>>>>>>>>>>>>>>>
16151>>>>>>>>>>>>>>>/*Maintains administration of web properties. Stores them in a sorted array for quick access.*/
16151>>>>>>>>>>>>>>>Class cWebPropertyMetaData_mixin is a Mixin
16152>>>>>>>>>>>>>>>    
16152>>>>>>>>>>>>>>>    Procedure Define_cWebPropertyMetaData_mixin
16154>>>>>>>>>>>>>>>        Property tWebPropMetaData[] paWebPropertyMeta
16155>>>>>>>>>>>>>>>    End_Procedure
16156>>>>>>>>>>>>>>>    
16156>>>>>>>>>>>>>>>    Procedure RegisterWebProperty Handle hmGetter Handle hmSetter String sName Integer iType Integer eMode String sOptDefault
16158>>>>>>>>>>>>>>>        tWebPropMetaData newProp
16158>>>>>>>>>>>>>>>        tWebPropMetaData newProp
16158>>>>>>>>>>>>>>>        tWebPropMetaData[] details
16158>>>>>>>>>>>>>>>        tWebPropMetaData[] details
16159>>>>>>>>>>>>>>>        Integer iPos
16159>>>>>>>>>>>>>>>        
16159>>>>>>>>>>>>>>>        Move hmSetter to newProp.hmSetter
16160>>>>>>>>>>>>>>>        Get paWebPropertyMeta to details
16161>>>>>>>>>>>>>>>        Move (BinarySearchArray(newProp, details, False)) to iPos
16162>>>>>>>>>>>>>>>        If (iPos = -1) Begin
16164>>>>>>>>>>>>>>>            Move (BinarySearchInsertPos()) to iPos
16165>>>>>>>>>>>>>>>            Move hmGetter to newProp.hmGetter
16166>>>>>>>>>>>>>>>            Move sName to newProp.sName
16167>>>>>>>>>>>>>>>            Move iType to newProp.eType
16168>>>>>>>>>>>>>>>            Move eMode to newProp.eMode
16169>>>>>>>>>>>>>>>            //  Only class meta data stores the default value
16169>>>>>>>>>>>>>>>            If (num_arguments > 5) ;                Move sOptDefault to newProp.sDefault
16172>>>>>>>>>>>>>>>            
16172>>>>>>>>>>>>>>>            Move (InsertInArray(details, iPos, newProp)) to details
16173>>>>>>>>>>>>>>>            Set paWebPropertyMeta to details
16174>>>>>>>>>>>>>>>        End    
16174>>>>>>>>>>>>>>>>
16174>>>>>>>>>>>>>>>        Else If (num_arguments > 5 and iType <> cArgArray and iType <> cArgStruct) Begin
16177>>>>>>>>>>>>>>>            If (sOptDefault <> details[iPos].sDefault) Begin
16179>>>>>>>>>>>>>>>                //Error DFERR_PROGRAM (SFormat("Web %1 property redefined with different default ('%2' <> '%3')!", sName, vDefault, details[iPos].vDefault))
16179>>>>>>>>>>>>>>>                Move sOptDefault to details[iPos].sDefault
16180>>>>>>>>>>>>>>>                Set paWebPropertyMeta to details
16181>>>>>>>>>>>>>>>            End
16181>>>>>>>>>>>>>>>>
16181>>>>>>>>>>>>>>>        End
16181>>>>>>>>>>>>>>>>
16181>>>>>>>>>>>>>>>    End_Procedure
16182>>>>>>>>>>>>>>>    
16182>>>>>>>>>>>>>>>    Function FindWebPropertyBySetter Handle hmSetter Returns tWebPropMetaData
16184>>>>>>>>>>>>>>>        tWebPropMetaData[] details
16184>>>>>>>>>>>>>>>        tWebPropMetaData[] details
16185>>>>>>>>>>>>>>>        tWebPropMetaData search 
16185>>>>>>>>>>>>>>>        tWebPropMetaData search 
16185>>>>>>>>>>>>>>>        Integer iPos
16185>>>>>>>>>>>>>>>        
16185>>>>>>>>>>>>>>>        Get paWebPropertyMeta to details

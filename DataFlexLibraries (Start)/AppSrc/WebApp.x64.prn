22138>>>>>>>>>>>>>    // Updates the state hash by pushing a new history item or replacing the existing one. Looks at
22138>>>>>>>>>>>>>    // peApplicationStateMode to see what it should do.
22138>>>>>>>>>>>>>    //
22138>>>>>>>>>>>>>    // Params:
22138>>>>>>>>>>>>>    //      sStateHash      New state hash.
22138>>>>>>>>>>>>>    //      sTitle          New page title.
22138>>>>>>>>>>>>>    //      bReplace        If true the current state is replaced, if false a new history item is 
22138>>>>>>>>>>>>>    //                      pushed.
22138>>>>>>>>>>>>>    Procedure SetStateHash String sStateHash String sTitle Boolean bReplace
22140>>>>>>>>>>>>>        tWebValueTree vt
22140>>>>>>>>>>>>>        tWebValueTree vt
22140>>>>>>>>>>>>>       
22140>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryOnly) Begin
22142>>>>>>>>>>>>>            Move sStateHash to vt.v
22143>>>>>>>>>>>>>            
22143>>>>>>>>>>>>>            If (bReplace) Begin
22145>>>>>>>>>>>>>                Send HistoryReplaceState "" sTitle vt
22146>>>>>>>>>>>>>            End
22146>>>>>>>>>>>>>>
22146>>>>>>>>>>>>>            Else Begin
22147>>>>>>>>>>>>>                Send HistoryPushState "" sTitle vt
22148>>>>>>>>>>>>>            End
22148>>>>>>>>>>>>>>
22148>>>>>>>>>>>>>            WebSet psCurrentAppState to sStateHash
22149>>>>>>>>>>>>>        End
22149>>>>>>>>>>>>>>
22149>>>>>>>>>>>>>        
22149>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryAndUrls) Begin
22151>>>>>>>>>>>>>            Send StateHashToUrl (&sStateHash)
22152>>>>>>>>>>>>>            If (bReplace) Begin
22154>>>>>>>>>>>>>                Send HistoryReplaceState sStateHash sTitle
22155>>>>>>>>>>>>>            End
22155>>>>>>>>>>>>>>
22155>>>>>>>>>>>>>            Else Begin
22156>>>>>>>>>>>>>                Send HistoryPushState sStateHash sTitle
22157>>>>>>>>>>>>>            End
22157>>>>>>>>>>>>>>
22157>>>>>>>>>>>>>        End
22157>>>>>>>>>>>>>>
22157>>>>>>>>>>>>>    End_Procedure

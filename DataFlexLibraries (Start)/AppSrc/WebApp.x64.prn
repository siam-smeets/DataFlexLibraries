15160>>>>>>>>>>>    // Gets a cookie value based on passed name.
15160>>>>>>>>>>>    //
15160>>>>>>>>>>>    // Params:
15160>>>>>>>>>>>    //  sName   Name of the cookie key.
15160>>>>>>>>>>>    // Returns:
15160>>>>>>>>>>>    //  The value of the cookie key.
15160>>>>>>>>>>>    //
15160>>>>>>>>>>>    Function GetCookie String sName Returns String
15162>>>>>>>>>>>        String sCookie sCookieUC sNameUC sValue
15162>>>>>>>>>>>        Integer iPos iPos2
15162>>>>>>>>>>>        
15162>>>>>>>>>>>        //  Get entire cookie string using ServerVariable method
15162>>>>>>>>>>>        Get ServerVariable "HTTP_COOKIE" to sCookie
15163>>>>>>>>>>>        
15163>>>>>>>>>>>        Move 0 to iPos
15164>>>>>>>>>>>        Move (Uppercase(sCookie)) to sCookieUC
15165>>>>>>>>>>>        Move (Uppercase(sName)) to sNameUC
15166>>>>>>>>>>>        
15166>>>>>>>>>>>        //  Loop over GET parameters
15166>>>>>>>>>>>        Repeat
15166>>>>>>>>>>>>
15166>>>>>>>>>>>            Increment iPos
15167>>>>>>>>>>>            
15167>>>>>>>>>>>            //  Determine position of the name
15167>>>>>>>>>>>            Move (Pos("=", sCookieUC, iPos)) to iPos2
15168>>>>>>>>>>>            
15168>>>>>>>>>>>            //  Check the name
15168>>>>>>>>>>>            If (Trim(Mid(sCookieUC, iPos2 - iPos, iPos)) = sNameUC) Begin
15170>>>>>>>>>>>                
15170>>>>>>>>>>>                //  Determine position of the value
15170>>>>>>>>>>>                Increment iPos2 //  Step over the =
15171>>>>>>>>>>>                Move (Pos(";", sCookie, iPos2)) to iPos
15172>>>>>>>>>>>                
15172>>>>>>>>>>>                If (iPos > 0) Begin
15174>>>>>>>>>>>                    Move (Mid(sCookie, iPos - iPos2, iPos2)) to sValue
15175>>>>>>>>>>>                End
15175>>>>>>>>>>>>
15175>>>>>>>>>>>                Else Begin
15176>>>>>>>>>>>                    Move ((Mid(sCookie, (Length(sCookie) - iPos2 + 1), iPos2))) to sValue
15177>>>>>>>>>>>                End
15177>>>>>>>>>>>>
15177>>>>>>>>>>>                
15177>>>>>>>>>>>                //  Unescape cookie value
15177>>>>>>>>>>>                Move (UrlDecode(sValue)) to sValue
15178>>>>>>>>>>>                
15178>>>>>>>>>>>                Function_Return sValue
15179>>>>>>>>>>>            End
15179>>>>>>>>>>>>
15179>>>>>>>>>>>            
15179>>>>>>>>>>>            Move (Pos(";", sCookie, iPos2)) to iPos
15180>>>>>>>>>>>        Until (not(iPos > 0)) 
15182>>>>>>>>>>>        
15182>>>>>>>>>>>        Function_Return ""
15183>>>>>>>>>>>    End_Function
15184>>>>>>>>>>>
15184>>>>>>>>>>>    
15184>>>>>>>>>>>    // Sets a cookie using the given name and value. The iExpires parameter determines the number 
15184>>>>>>>>>>>    // of hours before the cookie will expire. If 0 is passed the cookie will be Set as a session 
15184>>>>>>>>>>>    // cookie meaning that it will be cleared as soon as the browser is closed. Note that it is 
15184>>>>>>>>>>>    // advised to not use special characters and no "=" and ";" in the name and value.
15184>>>>>>>>>>>    //
15184>>>>>>>>>>>    // Params:
15184>>>>>>>>>>>    //  sName       Cookie key name.
15184>>>>>>>>>>>    //  sValue      New value for the cookie key.
15184>>>>>>>>>>>    //  iExpires    Number of hours before the cookie expires (0 = session).
15184>>>>>>>>>>>    //  sOptPath    Path for which the cookie should be stored ('' for the current path, '/' for 
15184>>>>>>>>>>>    //              the entire domain).
15184>>>>>>>>>>>    //  sOptDomain  Domain for which the cookie is set.
15184>>>>>>>>>>>    //  bOptSecure  If true the cookie is set as a secure cookie so it is only sent with HTTPS 
15184>>>>>>>>>>>    //              connections.
15184>>>>>>>>>>>    //  bOptHttpOnly    If true the cookie is set as a http only cookie so that it is not 
15184>>>>>>>>>>>    //                  accessible from JavaScript.
15184>>>>>>>>>>>    //
15184>>>>>>>>>>>    Procedure SetCookie String sName String sValue Integer iOptExpires String sOptPath String sOptDomain Boolean bOptSecure Boolean bOptHttpOnly String sOptSameSite
15186>>>>>>>>>>>        String sSetCookie sGMT sSameSite
15186>>>>>>>>>>>        DateTime dtExpires
15186>>>>>>>>>>>        
15186>>>>>>>>>>>        //  Encode the value and add it to the cookie string
15186>>>>>>>>>>>        Move (UrlEncode(sValue, True)) to sValue
15187>>>>>>>>>>>        Move (sName + "=" + sValue) to sSetCookie
15188>>>>>>>>>>>        
15188>>>>>>>>>>>        //  If an expiracy number of hours is set we add that to the cookie string
15188>>>>>>>>>>>        If (num_arguments >= 3) Begin
15190>>>>>>>>>>>            If (iOptExpires > 0) Begin
15192>>>>>>>>>>>                Move (DateAddHour(CurrentDateTime(), iOptExpires)) to dtExpires                
15193>>>>>>>>>>>                Get GMTString dtExpires to sGMT
15194>>>>>>>>>>>                Move (sSetCookie + "; Expires=" + sGMT) to sSetCookie
15195>>>>>>>>>>>            End
15195>>>>>>>>>>>>
15195>>>>>>>>>>>        End
15195>>>>>>>>>>>>
15195>>>>>>>>>>>        
15195>>>>>>>>>>>        //  Add path if needed
15195>>>>>>>>>>>        If (num_arguments >= 4) Begin
15197>>>>>>>>>>>            If (Trim(sOptPath) <> "") Begin
15199>>>>>>>>>>>                Move (UrlEncode(sOptPath, False)) to sOptPath
15200>>>>>>>>>>>                Move (sSetCookie + "; Path=" + sOptPath) to sSetCookie
15201>>>>>>>>>>>            End
15201>>>>>>>>>>>>
15201>>>>>>>>>>>        End
15201>>>>>>>>>>>>
15201>>>>>>>>>>>        
15201>>>>>>>>>>>        //  Add domain if needed
15201>>>>>>>>>>>        If (num_arguments >= 5) Begin
15203>>>>>>>>>>>            If (Trim(sOptDomain) <> "") Begin
15205>>>>>>>>>>>                Move (UrlEncode(sOptDomain, False)) to sOptDomain
15206>>>>>>>>>>>                Move (sSetCookie + "; Domain=" + sOptDomain) to sSetCookie
15207>>>>>>>>>>>            End
15207>>>>>>>>>>>>
15207>>>>>>>>>>>        End
15207>>>>>>>>>>>>
15207>>>>>>>>>>>        
15207>>>>>>>>>>>        //  Add secure if needed
15207>>>>>>>>>>>        If (num_arguments >= 6) Begin
15209>>>>>>>>>>>            If (bOptSecure) Begin
15211>>>>>>>>>>>                Move (sSetCookie + "; Secure") to sSetCookie
15212>>>>>>>>>>>            End
15212>>>>>>>>>>>>
15212>>>>>>>>>>>        End
15212>>>>>>>>>>>>
15212>>>>>>>>>>>        
15212>>>>>>>>>>>        //  Add httponly if needed
15212>>>>>>>>>>>        If (num_arguments >= 7) Begin
15214>>>>>>>>>>>            If (bOptHttpOnly) Begin
15216>>>>>>>>>>>                Move (sSetCookie + "; HttpOnly") to sSetCookie
15217>>>>>>>>>>>            End
15217>>>>>>>>>>>>
15217>>>>>>>>>>>        End
15217>>>>>>>>>>>>
15217>>>>>>>>>>>        
15217>>>>>>>>>>>        //  Add SameSite attribute
15217>>>>>>>>>>>        Move "Lax" to sSameSite
15218>>>>>>>>>>>        If (num_arguments >= 8) Begin
15220>>>>>>>>>>>            Move sOptSameSite to sSameSite
15221>>>>>>>>>>>        End
15221>>>>>>>>>>>>
15221>>>>>>>>>>>        Move (sSetCookie + "; SameSite=" + Trim(sSameSite)) to sSetCookie
15222>>>>>>>>>>>        
15222>>>>>>>>>>>        //  Add the Set-Cookie HTTP header
15222>>>>>>>>>>>        Send AddHttpResponseHeader of ghInetSession "Set-Cookie" sSetCookie
15223>>>>>>>>>>>    End_Procedure

14226>>>>>>>>>
14226>>>>>>>>>// The cVDFInternetSession class is considered private. All WBOs talk to this
14226>>>>>>>>>// by sending messages to the ghInetSession handle but this entire interface is
14226>>>>>>>>>// is private. All public access is defined in the WBOs and in the cWebApp object
14226>>>>>>>>>//
14226>>>>>>>>>
14226>>>>>>>>>Class cVDFInternetSession is a OLEVDFInetSession
14227>>>>>>>>>    
14227>>>>>>>>>    Procedure Construct_Object
14229>>>>>>>>>        Forward Send Construct_Object
14231>>>>>>>>>        
14231>>>>>>>>>        Move Self to ghInetSession
14232>>>>>>>>>        
14232>>>>>>>>>        // when errors are reported should technical info be provided. If set
14232>>>>>>>>>        // to true you get Error#, Line#, File# and Field#. 
14232>>>>>>>>>        Property Integer pbVerboseErrors False
14233>>>>>>>>>        
14233>>>>>>>>>        // When True, VDF errors are queued. This should only be set
14233>>>>>>>>>        // indirectly with ErrorQueueStart and ErrorQueueEnd
14233>>>>>>>>>        Property Integer pbQueueErrors False
14234>>>>>>>>>        
14234>>>>>>>>>        // If true, ALL errors are recorded in the event log. This
14234>>>>>>>>>        // is good for debugging. If false only appropriate error
14234>>>>>>>>>        // are event logged.
14234>>>>>>>>>        Property Integer pbAllErrorsToEventLog False
14235>>>>>>>>>        
14235>>>>>>>>>        // If true, errors are directed to the VDF error handler. This
14235>>>>>>>>>        // means an error will pop up on your VDF program. Normally not
14235>>>>>>>>>        // wanted for the web, but this can be useful when debugging at
14235>>>>>>>>>        // the server
14235>>>>>>>>>        Property Integer pbAllErrorsToLocal False
14236>>>>>>>>>        
14236>>>>>>>>>        // If false, no errors will be sent to the HTML client.
14236>>>>>>>>>        // Normally, this should be true. Might be useful when debugging
14236>>>>>>>>>        Property Integer pbAllErrorsToHtml True
14237>>>>>>>>>        
14237>>>>>>>>>        
14237>>>>>>>>>        // obsolete constants
14237>>>>>>>>>        Enum_List // note that these can be IORed together
14237>>>>>>>>>            Define C_hoNormal  for 1
14237>>>>>>>>>            Define C_hoFile    for 2
14237>>>>>>>>>            Define C_hoConsole for 4
14237>>>>>>>>>        End_Enum_List
14237>>>>>>>>>        Define C_HtmlOutputFileChannel for 9
14237>>>>>>>>>        
14237>>>>>>>>>        Property Integer peHtmlOutput         C_hoNormal
14238>>>>>>>>>        Property String  psHtmlOutputFileName "WebAppHtmlOut.txt"
14239>>>>>>>>>        // No longer used with modern WebApps
14239>>>>>>>>>        Property Integer pbFirstTimeOpen      False
14240>>>>>>>>>        
14240>>>>>>>>>        // used to prevent recursion in LogEvent method
14240>>>>>>>>>        Property Integer pbPrivateInLogEvent False
14241>>>>>>>>>        
14241>>>>>>>>>        Object oFileIds is a cFileIdsSet
14243>>>>>>>>>        End_Object
14244>>>>>>>>>        
14244>>>>>>>>>        // list of wbos (for asp)
14244>>>>>>>>>        Object oWpoIds is a cWpoIdsSet
14246>>>>>>>>>        End_Object
14247>>>>>>>>>        
14247>>>>>>>>>        
14247>>>>>>>>>        // list of wsos (for web-service)
14247>>>>>>>>>        Object oWsoIds is a cWpoIdsSet
14249>>>>>>>>>        End_Object
14250>>>>>>>>>        
14250>>>>>>>>>        // list of cWebWindows (views, dialogs for web framewor)
14250>>>>>>>>>        Object oWWoIds is a cWpoIdsSet
14252>>>>>>>>>        End_Object
14253>>>>>>>>>        
14253>>>>>>>>>        // list of raw http handlers
14253>>>>>>>>>        Object oHttpHIds is a cWpoIdsSet
14255>>>>>>>>>        End_Object
14256>>>>>>>>>        
14256>>>>>>>>>        // Used to store endpoint between detach and release
14256>>>>>>>>>        Property Integer peDetachEndPointEnvironment WebAppEnvNone
14257>>>>>>>>>        
14257>>>>>>>>>        Send Initialize_Files of oFileIds
14258>>>>>>>>>        
14258>>>>>>>>>    End_Procedure
14259>>>>>>>>>    

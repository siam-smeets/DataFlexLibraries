34154>>>>>>>Use cWebView.pkg
34154>>>>>>>
34154>>>>>>>// Use this class to implement a floating modal window that can contain a data entry view.
34154>>>>>>>// For example a prompt list dialog.
34154>>>>>>>//
34154>>>>>>>// Add support for:
34154>>>>>>>// - Invoking view object handle.
34154>>>>>>>// - Window size.
34154>>>>>>>
34154>>>>>>>// Make the following interface for this class private...
34154>>>>>>>
34154>>>>>>>Class cWebModalDialog is a cWebView
34155>>>>>>>    
34155>>>>>>>    Procedure Construct_Object
34157>>>>>>>        Forward Send Construct_Object
34159>>>>>>>        
34159>>>>>>>        // Published Properties
34159>>>>>>>        Property Boolean pbResizable True             // True if the window can be resized (with mouse)
34162>>>>>>>        Property Boolean pbShowClose True             // True if the title has a close button to hide the window
34165>>>>>>>        Property Boolean pbShowMax False              // True if the title has a max button to maximize the window 
34168>>>>>>>        Property Boolean pbShowMin False              // True if the title has a min button to minimize the window
34171>>>>>>>        Property Integer piLeft 0                   // Left co-ordinate, in pixels of the window
34174>>>>>>>        Property Integer piMinHeight 80               // Minimum height, in pixels, of the window
34177>>>>>>>        Property Integer piTop 0                    // Top co-ordinate, in pixels of the window
34180>>>>>>>        Property Integer piWidth -1                   // Width, in pixels of the window
34183>>>>>>>        
34183>>>>>>>        Property Boolean pbServerOnEscape False   // Set to true to trigger server OnEscape event
34186>>>>>>>        Property String psClientOnEscape ""       // Name of client side OnEscape event handler
34189>>>>>>>        
34189>>>>>>>        Property String psReturnMessage "OnCloseModalDialog"   // callback method name
34192>>>>>>>        Property String psReturnObject             // callback object name
34195>>>>>>>        Property Boolean pbCanceled True          // maintained by class when used in a default manner
34198>>>>>>>        
34198>>>>>>>        //  Configure super classes
34198>>>>>>>        Set pbOverrideStateOnShow to True
34199>>>>>>>        Set pbScroll to False
34200>>>>>>>        
34200>>>>>>>        Set piMinWidth to 200
34201>>>>>>>        Set peWebViewStyle to wvsDialog
34202>>>>>>>        
34202>>>>>>>        Set psJSClass to "df.WebModalDialog"
34203>>>>>>>    End_Procedure
34204>>>>>>>    
34204>>>>>>>
34204>>>>>>>    // Returns a handle to the invoking view object. i.e. the view that activated this modal dialog.
34204>>>>>>>    // Returns C_WebUnresolvedObject if there is no invoking view. See also psInvokingView
34204>>>>>>>    Function InvokingView Returns Handle
34206>>>>>>>        Handle hoInvokingView
34206>>>>>>>        String sInvokingView
34206>>>>>>>        
34206>>>>>>>        WebGet psInvokingView to sInvokingView
34207>>>>>>>        If (Trim(sInvokingView) <> "") Begin
34209>>>>>>>            Get FindWebObject of (Owner(Self)) sInvokingView to hoInvokingView
34210>>>>>>>            Function_Return hoInvokingView
34211>>>>>>>        End
34211>>>>>>>>
34211>>>>>>>         
34211>>>>>>>        Function_Return C_WebUnresolvedObject    
34212>>>>>>>    End_Function   
34213>>>>>>>    
34213>>>>>>>     
34213>>>>>>>    // Does a standard modal dialog invocation. It web-sets pbCanceled to True (which can be
34213>>>>>>>    // set to true on a successful close), it sets the callback object and sets the default
34213>>>>>>>    // callback message "OnCloseModalDialog". Finally it calls OnPopup
34213>>>>>>>    Procedure Popup Handle hoReturnObject
34215>>>>>>>        String sReturnMethod sReturnObject
34215>>>>>>>        WebSet pbCanceled to True // this gets reset if it closes ok
34216>>>>>>>        Get WebObjectName of hoReturnObject to sReturnObject
34217>>>>>>>        WebSet psReturnObject to sReturnObject
34218>>>>>>>        Send Show
34219>>>>>>>    End_Procedure
34220>>>>>>>    
34220>>>>>>>    // Can be called to do a successful closing of a panel. It sets pbCanceled to False, sends hide
34220>>>>>>>    // and class NotifyCloseModalDialog, which performs the callback using data web-set in Popup
34220>>>>>>>    Procedure Ok
34222>>>>>>>        WebSet pbCanceled to False
34223>>>>>>>        Send NotifyCloseModalDialog
34224>>>>>>>        Send CloseDialog
34225>>>>>>>    End_Procedure
34226>>>>>>>
34226>>>>>>>    // Can be called to do a non-successful closing of a panel. pbCanceled will be True (from Popup),
34226>>>>>>>    // it sends hide and it optionally sends NotifyCloseModalDialog, which performs the callback using data web-set in Popup.
34226>>>>>>>    // It sends NotifyCloseModalPanel if pbServerOnEscape is True. This makes the assumption that pbServerOnEscape means that
34226>>>>>>>    // you want to send a close notification and callback even when canceled in any manner.
34226>>>>>>>    Procedure Cancel
34228>>>>>>>        Boolean bServerOnEscape
34228>>>>>>>        WebGet pbServerOnEscape to bServerOnEscape
34229>>>>>>>        If (bServerOnEscape) Begin
34231>>>>>>>            Send NotifyCloseModalDialog
34232>>>>>>>        End
34232>>>>>>>>
34232>>>>>>>        Send CloseDialog
34233>>>>>>>    End_Procedure
34234>>>>>>>    
34234>>>>>>>    // this is called when the Esc key or "x" is pressed
34234>>>>>>>    Procedure OnEscape
34236>>>>>>>        Send Cancel
34237>>>>>>>    End_Procedure
34238>>>>>>>    
34238>>>>>>>    
34238>>>>>>>    // Sends the callback method to the callback object using values web-set in Popup. This is 
34238>>>>>>>    // usually called by Ok and maybe Cancel.
34238>>>>>>>    Procedure NotifyCloseModalDialog
34240>>>>>>>        Handle hoReturnObject hReturnMessage
34240>>>>>>>        String sReturnObject sReturnMessage
34240>>>>>>>        Boolean bOpenedWithNavigate
34240>>>>>>>        
34240>>>>>>>        //Check if we got here through navigation or through Send popup
34240>>>>>>>        Get OpenedWithNavigate to bOpenedWithNavigate
34241>>>>>>>        //If sReturnObject is an empty string we got here through Send popup
34241>>>>>>>        If (bOpenedWithNavigate) Begin
34243>>>>>>>            WebGet psInvokingObject to sReturnObject
34244>>>>>>>        End
34244>>>>>>>>
34244>>>>>>>        Else Begin
34245>>>>>>>            WebGet psReturnObject to sReturnObject
34246>>>>>>>        End
34246>>>>>>>>
34246>>>>>>>        
34246>>>>>>>        WebGet psReturnMessage to sReturnMessage
34247>>>>>>>
34247>>>>>>>        Get WebObjectByName sReturnObject to hoReturnObject
34248>>>>>>>        If hoReturnObject Begin
34250>>>>>>>            If (sReturnMessage <> "") Begin
34252>>>>>>>                Get WebMethodByName of hoReturnObject sReturnMessage to hReturnMessage
34253>>>>>>>                If hReturnMessage Begin
34255>>>>>>>                    Send hReturnMessage of hoReturnObject Self
34256>>>>>>>                End
34256>>>>>>>>
34256>>>>>>>            End
34256>>>>>>>>
34256>>>>>>>        End
34256>>>>>>>>
34256>>>>>>>    End_Procedure
34257>>>>>>>    
34257>>>>>>>    // Returns a handle to the return object. This is used by controls (cWebPromptList) to get
34257>>>>>>>    // the return object using delegation.
34257>>>>>>>    Function ReturnObject Returns Handle
34259>>>>>>>        String sWO
34259>>>>>>>        Handle hoWO
34259>>>>>>>        Boolean bOpenedWithNavigate
34259>>>>>>>        
34259>>>>>>>        Move C_WebUnresolvedObject to hoWO
34260>>>>>>>        Get OpenedWithNavigate to bOpenedWithNavigate
34261>>>>>>>        
34261>>>>>>>        //When opened with navigate we rely on psInvokingObject, otherwise psReturnObject.
34261>>>>>>>        If (bOpenedWithNavigate) Begin
34263>>>>>>>            WebGet psInvokingObject to sWO
34264>>>>>>>        End
34264>>>>>>>>
34264>>>>>>>        Else Begin
34265>>>>>>>            WebGet psReturnObject to sWO
34266>>>>>>>        End
34266>>>>>>>>
34266>>>>>>>
34266>>>>>>>        If (sWO <> "") Begin
34268>>>>>>>            Get WebObjectByName sWO to hoWO
34269>>>>>>>        End
34269>>>>>>>>
34269>>>>>>>        
34269>>>>>>>        Function_Return hoWO
34270>>>>>>>    End_Function
34271>>>>>>>    
34271>>>>>>>    Function IsDialog Returns Boolean
34273>>>>>>>        Function_Return True
34274>>>>>>>    End_Function
34275>>>>>>>    
34275>>>>>>>    //Calls navigate close for a modal dialog
34275>>>>>>>    Procedure NavigateCloseDialog
34277>>>>>>>        Boolean bCanceled
34277>>>>>>>        WebGet  pbCanceled to bCanceled
34278>>>>>>>        WebSet pbServerOnEscape to False
34279>>>>>>>        Send SetInvokingObject C_WebUnresolvedObject
34280>>>>>>>        If (bCanceled) Begin
34282>>>>>>>            Send NavigateCancel    
34283>>>>>>>        End
34283>>>>>>>>
34283>>>>>>>        Else Begin
34284>>>>>>>            Send NavigateClose Self
34285>>>>>>>        End
34285>>>>>>>>
34285>>>>>>>    End_Procedure
34286>>>>>>>    
34286>>>>>>>    Function OpenedWithNavigate Returns Boolean
34288>>>>>>>        String sInvokingObject
34288>>>>>>>        
34288>>>>>>>        WebGet psInvokingObject of Self to sInvokingObject
34289>>>>>>>        //If the invoking object is either empty or [NULL] we didnt get here through navigation but through a popup
34289>>>>>>>        If (sInvokingObject = "" or sInvokingObject = "[NULL]") Begin
34291>>>>>>>            Function_Return False
34292>>>>>>>        End
34292>>>>>>>>
34292>>>>>>>        
34292>>>>>>>        Function_Return True
34293>>>>>>>    End_Function
34294>>>>>>>    
34294>>>>>>>    // Whenever we come in here through navigation we need pbServerOnEscape to be true.
34294>>>>>>>    // Otherwise we can't properly update the viewstack whenever a user cancels with the x button.
34294>>>>>>>    Procedure NavigateForward2 Handle hoInvokingObject tWebNavigateData NavigateData Integer eNavMode
34296>>>>>>>        Forward Send NavigateForward2 hoInvokingObject NavigateData eNavMode
34298>>>>>>>        WebSet pbServerOnEscape to True 
34299>>>>>>>    End_Procedure
34300>>>>>>>    
34300>>>>>>>    //Helper procedure that closes a dialog with either hide or navigateclose/cancel based on how it was opened
34300>>>>>>>    Procedure CloseDialog
34302>>>>>>>        Boolean bOpenedWithNavigate
34302>>>>>>>        
34302>>>>>>>        Get OpenedWithNavigate to bOpenedWithNavigate
34303>>>>>>>        If (bOpenedWithNavigate) Begin
34305>>>>>>>            Send NavigateCloseDialog
34306>>>>>>>        End
34306>>>>>>>>
34306>>>>>>>        
34306>>>>>>>        Send Hide
34307>>>>>>>    End_Procedure
34308>>>>>>>    
34308>>>>>>>    Procedure End_Construct_Object
34310>>>>>>>        WebPublishProcedure OnEscape
34311>>>>>>>        
34311>>>>>>>        Forward Send End_Construct_Object
34313>>>>>>>    End_Procedure
34314>>>>>>>End_Class

20313>>>>>>>>>>>Use tWebRadioGroup.pkg
20313>>>>>>>>>>>
20313>>>>>>>>>>>/*Defines the API used by radio's to register themselves to their container. Used by cWebWindow and cLocalWebControlHost.  */
20313>>>>>>>>>>>Class cWebRadioContainer_mixin is a Mixin
20314>>>>>>>>>>>      
20314>>>>>>>>>>>    Procedure Define_cWebRadioContainer_mixin
20316>>>>>>>>>>>        Property tWebRadioGroup[] paRadioGroups   // collection of radio button groups in this View\Dialog 
20317>>>>>>>>>>>        Property String[] paRadioGroupNames       // searchable array of group names that are stored in paRagioGroups. One member of paRadioGroups exists for each paRadioGroupNames
20318>>>>>>>>>>>    End_Procedure
20319>>>>>>>>>>>    
20319>>>>>>>>>>>    
20319>>>>>>>>>>>    Procedure AddRadio Handle hoRadio
20321>>>>>>>>>>>        // Radio Button Helper:
20321>>>>>>>>>>>        //
20321>>>>>>>>>>>        // Registers the passed cWebRadio object. The object's group is determined and the radio
20321>>>>>>>>>>>        // is registered with the rest of the objects in that group. If this is the first radio
20321>>>>>>>>>>>        // object in the group then it will become the "master" radio object for that group.
20321>>>>>>>>>>>        String sGroupName
20321>>>>>>>>>>>        Integer iGroup icGroup icRadio
20321>>>>>>>>>>>        String[] aRadioGroupNames
20322>>>>>>>>>>>        tWebRadioGroup[] aRadioGroups
20322>>>>>>>>>>>        tWebRadioGroup[] aRadioGroups
20323>>>>>>>>>>>        
20323>>>>>>>>>>>        Get psGroupName of hoRadio to sGroupName
20324>>>>>>>>>>>        Get paRadioGroups to aRadioGroups
20325>>>>>>>>>>>        Get paRadioGroupNames to aRadioGroupNames
20326>>>>>>>>>>>        
20326>>>>>>>>>>>        // Is this a new group?....
20326>>>>>>>>>>>        Move (SearchArray(sGroupName, aRadioGroupNames, Desktop, RefFunc(DFSTRICMP))) to iGroup   // case insensitive search
20327>>>>>>>>>>>        
20327>>>>>>>>>>>        If (iGroup = -1) Begin
20329>>>>>>>>>>>            // Create a new group amd make this radio button the master....
20329>>>>>>>>>>>            Move (SizeOfArray(aRadioGroups)) to icGroup
20330>>>>>>>>>>>            Move hoRadio    to aRadioGroups[icGroup].hoMaster
20331>>>>>>>>>>>            Move hoRadio    to aRadioGroups[icGroup].aRadioButtons[0]
20332>>>>>>>>>>>            Move sGroupName to aRadioGroups[icGroup].sGroupName
20333>>>>>>>>>>>            Move sGroupName to aRadioGroupNames[icGroup]
20334>>>>>>>>>>>            
20334>>>>>>>>>>>            // Save the changes....
20334>>>>>>>>>>>            Set paRadioGroups to aRadioGroups
20335>>>>>>>>>>>            Set paRadioGroupNames to aRadioGroupNames
20336>>>>>>>>>>>        End
20336>>>>>>>>>>>>
20336>>>>>>>>>>>        Else Begin
20337>>>>>>>>>>>            // Add this radio to the existing group....
20337>>>>>>>>>>>            Move (SizeOfArray(aRadioGroups[iGroup].aRadioButtons)) to icRadio
20338>>>>>>>>>>>            Move hoRadio to aRadioGroups[iGroup].aRadioButtons[icRadio]
20339>>>>>>>>>>>            
20339>>>>>>>>>>>            // Save the changes....
20339>>>>>>>>>>>            Set paRadioGroups to aRadioGroups
20340>>>>>>>>>>>        End
20340>>>>>>>>>>>>
20340>>>>>>>>>>>    End_Procedure
20341>>>>>>>>>>>    
20341>>>>>>>>>>>    
20341>>>>>>>>>>>    Procedure ConnectRadioButtons
20343>>>>>>>>>>>        // Radio button Helper:
20343>>>>>>>>>>>        //
20343>>>>>>>>>>>        // Iterate all of the registered radio groups and connect the cWebRadio objects to their master
20343>>>>>>>>>>>        // radio buttons.
20343>>>>>>>>>>>        String sValue sTemp sMaster
20343>>>>>>>>>>>        Handle hoRadio
20343>>>>>>>>>>>        Integer iGroup icGroup 
20343>>>>>>>>>>>        Integer iRadio icRadio
20343>>>>>>>>>>>        tWebRadioGroup[] aRadioGroups
20343>>>>>>>>>>>        tWebRadioGroup[] aRadioGroups
20344>>>>>>>>>>>        
20344>>>>>>>>>>>        Get paRadioGroups to aRadioGroups
20345>>>>>>>>>>>        Move (SizeOfArray(aRadioGroups)) to icGroup
20346>>>>>>>>>>>        
20346>>>>>>>>>>>        For iGroup from 0 to (icGroup-1)
20352>>>>>>>>>>>>
20352>>>>>>>>>>>            Move (SizeOfArray(aRadioGroups[iGroup].aRadioButtons)) to icRadio
20353>>>>>>>>>>>            Move "" to sValue
20354>>>>>>>>>>>            Get WebObjectName of aRadioGroups[iGroup].hoMaster to sMaster 
20355>>>>>>>>>>>            
20355>>>>>>>>>>>            For iRadio from 0 to (icRadio-1)
20361>>>>>>>>>>>>
20361>>>>>>>>>>>                // Set the master radio....
20361>>>>>>>>>>>                Move aRadioGroups[iGroup].aRadioButtons[iRadio] to hoRadio
20362>>>>>>>>>>>                Set phoMasterRadio of hoRadio to aRadioGroups[iGroup].hoMaster
20363>>>>>>>>>>>                If (hoRadio <> aRadioGroups[iGroup].hoMaster) Begin
20365>>>>>>>>>>>                    Set psMasterName of hoRadio to sMaster
20366>>>>>>>>>>>                End
20366>>>>>>>>>>>>
20366>>>>>>>>>>>                
20366>>>>>>>>>>>                // Get the last non-null psValue setting....
20366>>>>>>>>>>>                Get psValue of hoRadio to sTemp
20367>>>>>>>>>>>                If (sTemp <> "") Begin
20369>>>>>>>>>>>                    Move sTemp to sValue
20370>>>>>>>>>>>                End
20370>>>>>>>>>>>>
20370>>>>>>>>>>>            Loop
20371>>>>>>>>>>>>
20371>>>>>>>>>>>            
20371>>>>>>>>>>>            // If there is no psValue setting then set it to the psRadioValue value of the master radio....
20371>>>>>>>>>>>            If (sValue = "") Begin
20373>>>>>>>>>>>                Get psRadioValue of aRadioGroups[iGroup].hoMaster to sValue
20374>>>>>>>>>>>            End
20374>>>>>>>>>>>>
20374>>>>>>>>>>>            
20374>>>>>>>>>>>            // Synchronize all radios in this group to the same psValue...
20374>>>>>>>>>>>            If (sValue <> "") Begin
20376>>>>>>>>>>>                For iRadio from 0 to (icRadio-1)
20382>>>>>>>>>>>>
20382>>>>>>>>>>>                    Move aRadioGroups[iGroup].aRadioButtons[iRadio] to hoRadio
20383>>>>>>>>>>>                    Set psValue of hoRadio to sValue
20384>>>>>>>>>>>                Loop
20385>>>>>>>>>>>>
20385>>>>>>>>>>>            End
20385>>>>>>>>>>>>
20385>>>>>>>>>>>        Loop
20386>>>>>>>>>>>>
20386>>>>>>>>>>>    End_Procedure
20387>>>>>>>>>>>End_Class

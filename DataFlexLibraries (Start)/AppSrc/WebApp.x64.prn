25982>>>>>>>>>>>    // special Request_Find logic for web-lists. cWebColumn will direct a Request_Find
25982>>>>>>>>>>>    // to here. This understands non-data aware and static lists and ignores those
25982>>>>>>>>>>>    // requests. It also understands peRequestFindMode which can filter out finds that
25982>>>>>>>>>>>    // don't make sense in a grid.
25982>>>>>>>>>>>    
25982>>>>>>>>>>>    Procedure Request_Find Integer eFindMode
25984>>>>>>>>>>>        Integer iFile iField iIndex iMain iRelField 
25984>>>>>>>>>>>        Integer eRequestFindMode eDbGridType
25984>>>>>>>>>>>        Boolean bFound
25984>>>>>>>>>>>        Handle hoServer
25984>>>>>>>>>>>        Boolean bAllowSwitch bDataAware
25984>>>>>>>>>>>        
25984>>>>>>>>>>>        // only data aware grids process request_find
25984>>>>>>>>>>>        Get pbDataAware to bDataAware
25985>>>>>>>>>>>        If not bDataAware Begin
25987>>>>>>>>>>>            Move False to Found
25988>>>>>>>>>>>            Procedure_Return
25989>>>>>>>>>>>        End
25989>>>>>>>>>>>>
25989>>>>>>>>>>>        
25989>>>>>>>>>>>        // find mode determines what kind of finding is supported
25989>>>>>>>>>>>        Get peRequestFindMode to eRequestFindMode
25990>>>>>>>>>>>        
25990>>>>>>>>>>>        // if finding not allowed at all, no find
25990>>>>>>>>>>>        If (eRequestFindMode=rfmFindNone) Begin
25992>>>>>>>>>>>            Move False to Found
25993>>>>>>>>>>>            Procedure_Return
25994>>>>>>>>>>>        End
25994>>>>>>>>>>>>
25994>>>>>>>>>>>
25994>>>>>>>>>>>        Get peDbGridType to eDbGridType
25995>>>>>>>>>>>        Get Server to hoServer
25996>>>>>>>>>>>        Get Data_File to iFile
25997>>>>>>>>>>>        Get Data_Field to iField
25998>>>>>>>>>>>
25998>>>>>>>>>>>        If (hoServer=0 or iFile=0) Begin
26000>>>>>>>>>>>            Move False to Found
26001>>>>>>>>>>>            Procedure_Return
26002>>>>>>>>>>>        End
26002>>>>>>>>>>>>
26002>>>>>>>>>>>
26002>>>>>>>>>>>        Get Main_File of hoServer to iMain
26003>>>>>>>>>>>        
26003>>>>>>>>>>>        // if no finding index, no find
26003>>>>>>>>>>>        Get File_Field_Index of hoServer iFile iField to iIndex
26004>>>>>>>>>>>        If (iIndex=-1) Begin
26006>>>>>>>>>>>            Move False to Found
26007>>>>>>>>>>>            Procedure_Return
26008>>>>>>>>>>>        End
26008>>>>>>>>>>>>
26008>>>>>>>>>>>            
26008>>>>>>>>>>>        // if this is a main file find we will ignore it if main-file finds are
26008>>>>>>>>>>>        // not allowed or the grid is static. If Static, you should not be doing finds
26008>>>>>>>>>>>        // on the mainfile as it will cause the data to all be reloaded.
26008>>>>>>>>>>>        If (iFile=iMain and ( (eRequestFindMode=rfmFindParentOnly) or (eDbGridType<>gtAutomatic) ) ) Begin
26010>>>>>>>>>>>            Move False to Found
26011>>>>>>>>>>>            Procedure_Return
26012>>>>>>>>>>>        End
26012>>>>>>>>>>>>
26012>>>>>>>>>>>        // if main or find all or findparentonly (with a parent find)
26012>>>>>>>>>>>        Else If (iFile=iMain or eRequestFindMode=rfmFindAll or eRequestFindMode=rfmFindParentOnly ) Begin
26015>>>>>>>>>>>            Send Item_Find of hoServer eFindMode iFile iField True True False
26016>>>>>>>>>>>            Move (Found) to bFound
26017>>>>>>>>>>>        End
26017>>>>>>>>>>>>
26017>>>>>>>>>>>        // if parent with find mainonly
26017>>>>>>>>>>>        Else If (eRequestFindMode=rfmFindMainOnly) Begin
26020>>>>>>>>>>>           Move False to Found
26021>>>>>>>>>>>           Procedure_Return 
26022>>>>>>>>>>>        End
26022>>>>>>>>>>>>
26022>>>>>>>>>>>        // is parent with find superfind logic (used by prompt lists)
26022>>>>>>>>>>>        Else Begin
26023>>>>>>>>>>>           Get RelatingField iFile to iRelField
26024>>>>>>>>>>>           If (iRelField=-1) Begin
26026>>>>>>>>>>>               Move False to Found
26027>>>>>>>>>>>               Procedure_Return   
26028>>>>>>>>>>>           End
26028>>>>>>>>>>>>
26028>>>>>>>>>>>           
26028>>>>>>>>>>>           // if superfind mode, which means this is a prompt list we want to be able to change the
26028>>>>>>>>>>>           // parent, even if committed w/ no parent switch set. 
26028>>>>>>>>>>>           //So Clear that parentNoSwitch for the main-dd for this parent Find and then restore it
26028>>>>>>>>>>>           Get ParentNoSwitchIfCommitted of hoServer iFile to bAllowSwitch
26029>>>>>>>>>>>           Set ParentNoSwitchIfCommitted of hoServer iFile to False
26030>>>>>>>>>>>           Send Item_Find of hoServer eFindMode iFile iField True True False
26031>>>>>>>>>>>           Move (Found) to bFound
26032>>>>>>>>>>>           Set ParentNoSwitchIfCommitted of hoServer iFile to bAllowSwitch
26033>>>>>>>>>>>           If ( (bFound) ) Begin
26035>>>>>>>>>>>                Send Item_Find to hoServer GE iMain iRelField True True False
26036>>>>>>>>>>>                Move (Found) to bFound
26037>>>>>>>>>>>           End
26037>>>>>>>>>>>>
26037>>>>>>>>>>>        End
26037>>>>>>>>>>>>
26037>>>>>>>>>>>        
26037>>>>>>>>>>>        Move bFound to Found
26038>>>>>>>>>>>            
26038>>>>>>>>>>>    End_Procedure
26039>>>>>>>>>>>
26039>>>>>>>>>>>    // does a lookup style find for the passed column based on the value of the search text

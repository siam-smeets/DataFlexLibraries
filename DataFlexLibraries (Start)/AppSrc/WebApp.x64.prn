24549>>>>>>>>>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
24550>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
24551>>>>>>>>>>>>>>>>>            
24551>>>>>>>>>>>>>>>>>            //  Determine current filter settings
24551>>>>>>>>>>>>>>>>>            Get SupportsFilterExpressions hoServer to bSupportsFilters
24552>>>>>>>>>>>>>>>>>            Get piaDataFiles to iaFiles
24553>>>>>>>>>>>>>>>>>            Get piaDataFields to iaFields
24554>>>>>>>>>>>>>>>>>            Move (SizeOfArray(iaFiles) > 1) to bScanAll
24555>>>>>>>>>>>>>>>>>                            
24555>>>>>>>>>>>>>>>>>            Move (Length(sFilter)) to iLen
24556>>>>>>>>>>>>>>>>>            Move (Lowercase(sFilter)) to sLowSearch
24557>>>>>>>>>>>>>>>>>            Move False to bSuccess
24558>>>>>>>>>>>>>>>>>            
24558>>>>>>>>>>>>>>>>>            //  Find first record or if a page was selected do a refind and go from there.
24558>>>>>>>>>>>>>>>>>            If (iPage > 0 and Length(prevItem.sRowId) > 0) Begin
24560>>>>>>>>>>>>>>>>>                Move (DeserializeRowID(prevItem.sRowId)) to riTest    
24561>>>>>>>>>>>>>>>>>                If (not(IsNullRowID(riTest))) Begin
24563>>>>>>>>>>>>>>>>>                    Get ReadByRowIdEx of hoServer iFile riTest to bSuccess
24564>>>>>>>>>>>>>>>>>                End
24564>>>>>>>>>>>>>>>>>>
24564>>>>>>>>>>>>>>>>>            End
24564>>>>>>>>>>>>>>>>>>
24564>>>>>>>>>>>>>>>>>            
24564>>>>>>>>>>>>>>>>>            If (not(bSuccess)) Begin
24566>>>>>>>>>>>>>>>>>                If (bSupportsFilters) Begin
24568>>>>>>>>>>>>>>>>>                    Send ApplyFilterExpression hoServer iaFiles iaFields sFilter (&sOrigFilter) (&bOrigActive) (&bFilterApplied)
24569>>>>>>>>>>>>>>>>>                End
24569>>>>>>>>>>>>>>>>>>
24569>>>>>>>>>>>>>>>>>                If (bScanAll or bFilterApplied) Begin
24571>>>>>>>>>>>>>>>>>                    Send Request_Read of hoServer FIRST_RECORD iFile iIndex
24572>>>>>>>>>>>>>>>>>                End
24572>>>>>>>>>>>>>>>>>>
24572>>>>>>>>>>>>>>>>>                Else Begin
24573>>>>>>>>>>>>>>>>>                    Set_Field_Value iFile iField to sFilter
24576>>>>>>>>>>>>>>>>>                    Send Request_Read of hoServer GE iFile iIndex
24577>>>>>>>>>>>>>>>>>                End
24577>>>>>>>>>>>>>>>>>>
24577>>>>>>>>>>>>>>>>>            End
24577>>>>>>>>>>>>>>>>>>
24577>>>>>>>>>>>>>>>>>            Else Begin
24578>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex  
24579>>>>>>>>>>>>>>>>>            End
24579>>>>>>>>>>>>>>>>>>
24579>>>>>>>>>>>>>>>>>            
24579>>>>>>>>>>>>>>>>>            While (Found and (not(iItemIndex >= iPageSize) or bAllData) and not(bBreak))
24583>>>>>>>>>>>>>>>>>                Move False to bBreak
24584>>>>>>>>>>>>>>>>>                Move (ResizeArray(aEntryValues, 0)) to aEntryValues
24585>>>>>>>>>>>>>>>>>                Get CheckAllEntryItem (&aEntryValues) sFilter bCase False False to bOk
24586>>>>>>>>>>>>>>>>>                If (bOk) Begin
24588>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to aItems[iItemIndex].sRowId
24589>>>>>>>>>>>>>>>>>                    Move aEntryValues to aItems[iItemIndex].aValues

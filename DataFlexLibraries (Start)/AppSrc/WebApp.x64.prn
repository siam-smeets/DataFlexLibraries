38533>>>>>>>        
38533>>>>>>>        Move 1 to iBegin
38534>>>>>>>        
38534>>>>>>>        // Parse Algo
38534>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
38535>>>>>>>        If (not(iEnd)) Function_Return False
38538>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
38539>>>>>>>        
38539>>>>>>>        // Parse Salt
38539>>>>>>>        Move (iEnd + 1) to iBegin
38540>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
38541>>>>>>>        If (not(iEnd)) Function_Return False
38544>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
38545>>>>>>>        
38545>>>>>>>        Case Begin
38545>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
38547>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
38550>>>>>>>                Move True to bRequiresTimeCost
38551>>>>>>>                Case Break
38552>>>>>>>            Case Else
38552>>>>>>>                Error 8710 "Invalid algorithm selected."
38553>>>>>>>>
38553>>>>>>>                Function_Return False
38554>>>>>>>        Case End
38554>>>>>>>        
38554>>>>>>>        // Parse optional timecost
38554>>>>>>>        If (bRequiresTimeCost) Begin
38556>>>>>>>            Move (iEnd + 1) to iBegin
38557>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
38558>>>>>>>            If (not(iEnd)) Function_Return False
38561>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
38562>>>>>>>        End
38562>>>>>>>>
38562>>>>>>>        
38562>>>>>>>        // Parse rest hash
38562>>>>>>>        Move (iEnd + 1) to iBegin
38563>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
38564>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
38567>>>>>>>        
38567>>>>>>>        // Base64Decode
38567>>>>>>>        UChar[] ucaSalt
38568>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
38569>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
38572>>>>>>>        
38572>>>>>>>        // Create new hash
38572>>>>>>>        String sNewHash
38572>>>>>>>        If (bRequiresTimeCost) Begin
38574>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
38576>>>>>>>                Function_Return False 
38577>>>>>>>            End
38577>>>>>>>>
38577>>>>>>>        End
38577>>>>>>>>
38577>>>>>>>        Else Begin
38578>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
38580>>>>>>>                Function_Return False 
38581>>>>>>>            End
38581>>>>>>>>
38581>>>>>>>        End
38581>>>>>>>>
38581>>>>>>>        // Use binary comparison, not affected by DF_LOCALE_CODE collation.
38581>>>>>>>        If (SizeOfString(sNewHash) <> SizeOfString(sHash)) ;            Function_Return False
38584>>>>>>>        Function_Return (MemCompare(AddressOf(sNewHash), AddressOf(sHash), SizeOfString(sNewHash)) = 0)
38585>>>>>>>    End_Function
38586>>>>>>>    
38586>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
38588>>>>>>>        Boolean bRequireTimeCost
38588>>>>>>>        UBigInt ullSize
38588>>>>>>>        UChar[] ucaSalt
38589>>>>>>>        String sSalt
38589>>>>>>>        
38589>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
38590>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
38591>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
38594>>>>>>>        
38594>>>>>>>        Case Begin
38594>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
38596>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
38597>>>>>>>                Move True to bRequireTimeCost
38598>>>>>>>                Case Break
38599>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
38602>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
38603>>>>>>>                Move True to bRequireTimeCost
38604>>>>>>>                Case Break
38605>>>>>>>            Case Else
38605>>>>>>>                Error 8710 "Invalid algorithm selected."
38606>>>>>>>>
38606>>>>>>>                Function_Return 0
38607>>>>>>>        Case End
38607>>>>>>>        
38607>>>>>>>        // calculate base64 in a non-floating-manner
38607>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
38608>>>>>>>        
38608>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
38609>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
38610>>>>>>>        If (bRequireTimeCost) Begin
38612>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
38613>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
38614>>>>>>>        End
38614>>>>>>>>
38614>>>>>>>        Else Begin
38615>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
38616>>>>>>>        End
38616>>>>>>>>
38616>>>>>>>        
38616>>>>>>>        Function_Return ullSize
38617>>>>>>>    End_Function
38618>>>>>>>End_Class
38619>>>>>>>
38619>>>>>>>Class cPasswordHasher is a cObject
38620>>>>>>>    
38620>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
38621>>>>>>>    
38621>>>>>>>    Procedure Construct_Object
38623>>>>>>>        Forward Send Construct_Object
38625>>>>>>>        
38625>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
38626>>>>>>>        Property UInteger   puiSaltSize         16
38627>>>>>>>        
38627>>>>>>>        Property UInteger   puiOptTimeCost      420000
38628>>>>>>>    End_Procedure
38629>>>>>>>    
38629>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
38631>>>>>>>        Boolean bOk
38631>>>>>>>        UInteger uiAlgo
38631>>>>>>>        Get peAlgorithm to uiAlgo
38632>>>>>>>        
38632>>>>>>>        Case Begin
38632>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
38634>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
38637>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
38638>>>>>>>                Case Break
38639>>>>>>>            Case Else
38639>>>>>>>                Error 8710 "Invalid algorithm selected."
38640>>>>>>>>
38640>>>>>>>                Function_Return False
38641>>>>>>>        Case End
38641>>>>>>>        
38641>>>>>>>        Function_Return bOk
38642>>>>>>>    End_Function
38643>>>>>>>    
38643>>>>>>>    Function RequiredBufferSize Returns UBigInt
38645>>>>>>>        UBigInt ullSize
38645>>>>>>>        UInteger uiAlgo
38645>>>>>>>        Get peAlgorithm to uiAlgo
38646>>>>>>>        
38646>>>>>>>        Case Begin
38646>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
38648>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
38651>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
38652>>>>>>>                Case Break
38653>>>>>>>            Case Else
38653>>>>>>>                Error 8710 "Invalid algorithm selected."
38654>>>>>>>>
38654>>>>>>>                Function_Return 0
38655>>>>>>>        Case End
38655>>>>>>>        
38655>>>>>>>        Function_Return ullSize
38656>>>>>>>    End_Function
38657>>>>>>>
38657>>>>>>>End_Class

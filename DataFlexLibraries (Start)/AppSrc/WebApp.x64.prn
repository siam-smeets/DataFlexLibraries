35256>>>>>>>    Procedure DisplayExistingFile String sPath
35258>>>>>>>        Boolean bExists
35258>>>>>>>        Integer iChnl iSize iPos
35258>>>>>>>        String sFileName
35258>>>>>>>        
35258>>>>>>>        Move 0 to iSize
35259>>>>>>>        
35259>>>>>>>        File_Exist sPath bExists
35260>>>>>>>        
35260>>>>>>>        Move (RightPos("\", sPath)) to iPos
35261>>>>>>>        Move (Right(sPath, Length(sPath) - iPos)) to sFileName
35262>>>>>>>        
35262>>>>>>>        
35262>>>>>>>        If (bExists) Begin
35264>>>>>>>            //  Determine file size
35264>>>>>>>            Move (Seq_New_Channel()) to iChnl
35265>>>>>>>            If (iChnl >= 0) Begin
35267>>>>>>>                Direct_Input channel iChnl sPath
35269>>>>>>>                Get_Channel_Size iChnl to iSize
35270>>>>>>>                Close_Input iChnl
35271>>>>>>>                Send Seq_Release_Channel iChnl
35272>>>>>>>            End
35272>>>>>>>>
35272>>>>>>>            Else If (iChnl = -1) Begin
35275>>>>>>>                Error DFErr_Program "I/O Channel Error"
35276>>>>>>>>
35276>>>>>>>            End
35276>>>>>>>>
35276>>>>>>>            Else If (iChnl = -2) Begin
35279>>>>>>>                Error DFErr_Program "No I/O Channel Available"
35280>>>>>>>>
35280>>>>>>>            End
35280>>>>>>>>
35280>>>>>>>        End
35280>>>>>>>>
35280>>>>>>>        
35280>>>>>>>        WebSet psFileName to sFileName
35281>>>>>>>        WebSet piFileSize to iSize
35282>>>>>>>        WebSet psFileMime to ""
35283>>>>>>>        WebSet peState to ciUploadStateDisplay
35284>>>>>>>        
35284>>>>>>>        Send ClientAction "updateDetails"
35285>>>>>>>    End_Procedure

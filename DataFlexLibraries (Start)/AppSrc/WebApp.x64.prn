30814>>>>>>>>>                    Move 1 to WebAppServerProps.Locked
30815>>>>>>>>>                    
30815>>>>>>>>>                    Move (CurrentDateTime()) to dtLocked
30816>>>>>>>>>                    Move dtLocked to WebAppServerProps.LockedDate
30817>>>>>>>>>                    Get TimeToString dtLocked to WebAppServerProps.LockedTime
30818>>>>>>>>>                    
30818>>>>>>>>>                    SaveRecord WebAppServerProps
30819>>>>>>>>>                Unlock
30820>>>>>>>>>>
30820>>>>>>>>>            End
30820>>>>>>>>>>
30820>>>>>>>>>            
30820>>>>>>>>>            //  Actually read data
30820>>>>>>>>>            While ((iPage = 0 or Found) and WebAppServerProps.Key = sKey and WebAppServerProps.Page = iPage)    
30824>>>>>>>>>            
30824>>>>>>>>>                //  Actually read data
30824>>>>>>>>>                If (iPage = 0) Begin
30826>>>>>>>>>                    Get_Field_Value WebAppServerProps.File_Number (RefTable(WebAppServerProps.Data)) to ucPropData    
30829>>>>>>>>>                End
30829>>>>>>>>>>
30829>>>>>>>>>                Else Begin
30830>>>>>>>>>                    Get_Field_Value WebAppServerProps.File_Number (RefTable(WebAppServerProps.Data)) to ucPage
30833>>>>>>>>>                    If (SizeOfArray(ucPage) > iMaxSize) Begin
30835>>>>>>>>>                        Move (ResizeArray(ucPage, iMaxSize)) to ucPage
30836>>>>>>>>>                    End
30836>>>>>>>>>>
30836>>>>>>>>>                    Move (AppendArray(ucPropData, ucPage)) to ucPropData
30837>>>>>>>>>                End
30837>>>>>>>>>>
30837>>>>>>>>>                
30837>>>>>>>>>                Increment iPage
30838>>>>>>>>>                Find GT WebAppServerProps by 1
30839>>>>>>>>>>
30839>>>>>>>>>            Loop
30840>>>>>>>>>>
30840>>>>>>>>>            
30840>>>>>>>>>            Function_Return True
30841>>>>>>>>>        End
30841>>>>>>>>>>
30841>>>>>>>>>        Else If (bLocking) Begin
30844>>>>>>>>>            //  If we are locking we need to create an empty record to place the lock
30844>>>>>>>>>            Get CalculateExpires to dtExpires
30845>>>>>>>>>            
30845>>>>>>>>>            Clear WebAppServerProps
30846>>>>>>>>>            Move sKey to WebAppServerProps.Key
30847>>>>>>>>>            Move 0 to WebAppServerProps.Page
30848>>>>>>>>>            
30848>>>>>>>>>            Move (CurrentDateTime()) to dtCreated
30849>>>>>>>>>            Move dtCreated to WebAppServerProps.CreateDate
30850>>>>>>>>>            Get TimeToString dtCreated to WebAppServerProps.CreateTime
30851>>>>>>>>>            
30851>>>>>>>>>            
30851>>>>>>>>>            Move dtExpires to WebAppServerProps.ExpiresDate
30852>>>>>>>>>            Get TimeToString dtExpires to WebAppServerProps.ExpiresTime
30853>>>>>>>>>            
30853>>>>>>>>>            Move 1 to WebAppServerProps.Locked
30854>>>>>>>>>            
30854>>>>>>>>>            Move (CurrentDateTime()) to dtLocked
30855>>>>>>>>>            Move dtLocked to WebAppServerProps.LockedDate
30856>>>>>>>>>            Get TimeToString dtLocked to WebAppServerProps.LockedTime
30857>>>>>>>>>            
30857>>>>>>>>>            SaveRecord WebAppServerProps
30858>>>>>>>>>        End
30858>>>>>>>>>>
30858>>>>>>>>>        
30858>>>>>>>>>        
30858>>>>>>>>>        Function_Return False
30859>>>>>>>>>    End_Function

27676>>>>>>>    
27676>>>>>>>    // Event that is fired when the size of the browser window changes. This event can be used to 
27676>>>>>>>    // make the web application layout responsive to the browser size. It gets the new dimensions
27676>>>>>>>    // of the browser window passed as parameters.
27676>>>>>>>    //
27676>>>>>>>    // Params:
27676>>>>>>>    //  iWindowWidth    Width of the browser window in pixels.
27676>>>>>>>    //  iWindowHeight   Height of the browser window in pixels.
27676>>>>>>>    Procedure OnResizeWindow Integer iWindowWidth Integer iWindowHeight
27678>>>>>>>    End_Procedure    
27679>>>>>>>
27679>>>>>>>    // Generic request find method for handling Request_Find
27679>>>>>>>    // Currently this will get delegated here by objects that do not understand Requset_Find. In the
27679>>>>>>>    // future we could use DEO_Find_Object to not send these messages at all.
27679>>>>>>>    // eFindMode - Can be one of... lt, le, eq, ge, gt, or it may be either Next_Record, First_Record, or Last_Record
27679>>>>>>>    Procedure Request_Find Integer eFindMode
27681>>>>>>>        // Do nothing. Ignore this message in this class.
27681>>>>>>>    End_Procedure
27682>>>>>>>
27682>>>>>>>
27682>>>>>>>    //  Performs the initialization of the view when it is loaded to the client. It is called by 
27682>>>>>>>    //  cWebApp at the right moment (pbOverrideStateOnShow influences this). Clears the DDO 
27682>>>>>>>    //  structures, adds key handlers and sends OnResizeWindow.
27682>>>>>>>    //    
27682>>>>>>>    Procedure InitForShow
27684>>>>>>>        Integer i iCount iWidth iHeight
27684>>>>>>>        Handle hoMainDD
27684>>>>>>>        Handle[] aAdditionalDDOStructures 
27685>>>>>>>        tNameHandlePair[] aDDOs
27685>>>>>>>        tNameHandlePair[] aDDOs
27686>>>>>>>        Boolean bOnResize bPreLoaded bDynamicConstraints
27686>>>>>>>        tDDRemembered[] aEmptyRemembered
27686>>>>>>>        tDDRemembered[] aEmptyRemembered
27687>>>>>>>        
27687>>>>>>>        //  If this is a preloaded view we skip initforshow
27687>>>>>>>        WebGet pbPreLoaded to bPreLoaded
27688>>>>>>>        If (bPreLoaded) Begin
27690>>>>>>>            WebSet pbPreLoaded to False
27691>>>>>>>            Procedure_Return
27692>>>>>>>        End
27692>>>>>>>>
27692>>>>>>>        
27692>>>>>>>        Get Main_DD to hoMainDD
27693>>>>>>>        If (hoMainDD <> 0) Begin
27695>>>>>>>            // Clear dynamic constraints that might have been left from previous show
27695>>>>>>>            Get IsDynamicConstraints to bDynamicConstraints
27696>>>>>>>            If (bDynamicConstraints) Begin
27698>>>>>>>                Send ClearConstrainFiles hoMainDD
27699>>>>>>>                Send Rebuild_Constraints of hoMainDD
27700>>>>>>>            End
27700>>>>>>>>
27700>>>>>>>        End
27700>>>>>>>>
27700>>>>>>>        
27700>>>>>>>        Set pbInitForShow to True
27701>>>>>>>        
27701>>>>>>>        // Clear remember values
27701>>>>>>>        Get paDDOIndex to aDDOs
27702>>>>>>>        Move (SizeOfArray(aDDOs) - 1) to iCount
27703>>>>>>>        For i from 0 to iCount
27709>>>>>>>>
27709>>>>>>>            Set pDDDefaults of aDDOs[i].hValue to aEmptyRemembered
27710>>>>>>>        Loop
27711>>>>>>>>
27711>>>>>>>        
27711>>>>>>>        // Clear the main DDO structure
27711>>>>>>>        If (hoMainDD <> 0) Begin
27713>>>>>>>            Send Clear_All of hoMainDD
27714>>>>>>>        End
27714>>>>>>>>
27714>>>>>>>        
27714>>>>>>>        // Now clear the main dd of any 'additional' DDO structures
27714>>>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
27715>>>>>>>        Move (SizeOfArray(aAdditionalDDOStructures)) to iCount
27716>>>>>>>        
27716>>>>>>>        For i from 0 to (iCount - 1)
27722>>>>>>>>
27722>>>>>>>            If (aAdditionalDDOStructures[i] <> 0) Begin
27724>>>>>>>                Send Clear_All of aAdditionalDDOStructures[i]
27725>>>>>>>            End
27725>>>>>>>>
27725>>>>>>>        Loop
27726>>>>>>>>
27726>>>>>>>        
27726>>>>>>>        //  Rebuild constraints
27726>>>>>>>        Send RebuildDDConstraints
27727>>>>>>>        
27727>>>>>>>        //  Trigger resize event
27727>>>>>>>        Get pbServerOnResizeWindow to bOnResize
27728>>>>>>>        If (bOnResize) Begin
27730>>>>>>>            WebGet piWindowWidth of (Host(Self)) to iWidth
27731>>>>>>>            WebGet piWindowHeight of (Host(Self)) to iHeight
27732>>>>>>>            
27732>>>>>>>            Send OnResizeWindow iWidth iHeight
27733>>>>>>>        End
27733>>>>>>>>
27733>>>>>>>        
27733>>>>>>>        Set pbInitForShow to False
27734>>>>>>>    End_Procedure
27735>>>>>>>    
27735>>>>>>>    
27735>>>>>>>    //  Called always when the view is shown.
27735>>>>>>>    //  
27735>>>>>>>    Procedure DoShow
27737>>>>>>>        Boolean bOnShow
27737>>>>>>>        Integer eViewStyle
27737>>>>>>>        String sPrevHash sView sHashView
27737>>>>>>>        
27737>>>>>>>        //  Fire OnShow (optimization, used to be fired from JavaScript)
27737>>>>>>>        Send OnBeforeShow
27738>>>>>>>        
27738>>>>>>>        Get peWebViewStyle to eViewStyle
27739>>>>>>>        If (eViewStyle = wvsDesktop) Begin
27741>>>>>>>            
27741>>>>>>>            If (peStateMode(Self) <> vsmOff) Begin 
27743>>>>>>>                //  Replace state if the hash no location url
27743>>>>>>>                Get psStateViewName to sView
27744>>>>>>>                Get StateHash of (Host(Self)) to sPrevHash
27745>>>>>>>                Send ParseViewStateHash sPrevHash (&sHashView)
27746>>>>>>>                
27746>>>>>>>                If (Lowercase(sHashView) <> Lowercase(sView)) Begin
27748>>>>>>>                    Send UpdateStateHash ((Trim(sPrevHash) = "") or pbStateReplace(Self))            
27749>>>>>>>                End
27749>>>>>>>>
27749>>>>>>>            End
27749>>>>>>>>
27749>>>>>>>            Send UpdatePageTitle
27750>>>>>>>        End
27750>>>>>>>>
27750>>>>>>>        
27750>>>>>>>    End_Procedure
27751>>>>>>>    
27751>>>>>>>    
27751>>>>>>>    Procedure HandleFindKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27753>>>>>>>        Handle hoFocus
27753>>>>>>>        
27753>>>>>>>        If (pbFindKeys(Self)) Begin
27755>>>>>>>            Get DEOControlFocusObject to hoFocus
27756>>>>>>>            If (hoFocus) Begin
27758>>>>>>>                Case Begin
27758>>>>>>>                    Case (iKey = 119)
27760>>>>>>>                        Send Request_Find of hoFocus  GT
27761>>>>>>>                        Case Break
27762>>>>>>>                    Case (iKey = 118)
27765>>>>>>>                        Send Request_Find of hoFocus  LT
27766>>>>>>>                        Case Break
27767>>>>>>>                    Case (iKey = 120)
27770>>>>>>>                        Send Request_Find of hoFocus  GE
27771>>>>>>>                        Case Break
27772>>>>>>>                    Case (iKey = 36 and bCtrl)
27775>>>>>>>                        Send Request_Find of hoFocus  FIRST_RECORD
27776>>>>>>>                        Case Break
27777>>>>>>>                    Case (iKey = 35 and bCtrl)
27780>>>>>>>                        Send Request_Find of hoFocus  LAST_RECORD
27781>>>>>>>                        Case Break
27782>>>>>>>                Case End
27782>>>>>>>                
27782>>>>>>>            End
27782>>>>>>>>
27782>>>>>>>        End
27782>>>>>>>>
27782>>>>>>>    End_Procedure
27783>>>>>>>    
27783>>>>>>>    Procedure HandleClearKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27785>>>>>>>        Handle hoFocus
27785>>>>>>>        
27785>>>>>>>        If (pbClearKeys(Self) and iKey = 116) Begin 
27787>>>>>>>            Get DEOControlFocusObject to hoFocus
27788>>>>>>>            
27788>>>>>>>            If (hoFocus) Begin
27790>>>>>>>                If (bCtrl) Begin
27792>>>>>>>                    Send Request_Clear_All of hoFocus
27793>>>>>>>                End
27793>>>>>>>>
27793>>>>>>>                Else Begin
27794>>>>>>>                    Send Request_Clear of hoFocus
27795>>>>>>>                End
27795>>>>>>>>
27795>>>>>>>            End
27795>>>>>>>>
27795>>>>>>>        End
27795>>>>>>>>
27795>>>>>>>    End_Procedure
27796>>>>>>>    
27796>>>>>>>    Procedure HandleDeleteKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27798>>>>>>>        Handle hoFocus
27798>>>>>>>        
27798>>>>>>>        If (pbDeleteKeys(Self) and iKey = 113 and bShift) Begin
27800>>>>>>>            Get DEOFocusObject to hoFocus
27801>>>>>>>            If hoFocus Begin
27803>>>>>>>                Send Request_Delete of hoFocus
27804>>>>>>>            End
27804>>>>>>>>
27804>>>>>>>        End
27804>>>>>>>>
27804>>>>>>>    End_Procedure
27805>>>>>>>    
27805>>>>>>>    Procedure HandleSaveKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27807>>>>>>>        Handle hoFocus
27807>>>>>>>        
27807>>>>>>>        If (pbSaveKeys(Self) and iKey = 113 and not(bShift)) Begin
27809>>>>>>>            Get DEOFocusObject to hoFocus
27810>>>>>>>            If hoFocus Begin
27812>>>>>>>                Send Request_Save of hoFocus
27813>>>>>>>            End
27813>>>>>>>>
27813>>>>>>>        End
27813>>>>>>>>
27813>>>>>>>    End_Procedure
27814>>>>>>>    
27814>>>>>>>    
27814>>>>>>>    
27814>>>>>>>    Procedure DefaultKeyHandlers
27816>>>>>>>        If (pbFindKeys(Self)) Begin
27818>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 119 False False False   //  F8
27819>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 118 False False False   //  F7
27820>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 120 False False False   //  F9
27821>>>>>>>            
27821>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 36 False False True     //  Ctrl - home
27822>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 35 False False True     //  Ctrl - end
27823>>>>>>>        End
27823>>>>>>>>
27823>>>>>>>        
27823>>>>>>>        If (pbClearKeys(Self)) Begin
27825>>>>>>>            Send AddKeyHandler (RefProc(HandleClearKey)) 116 False False False  //  F5
27826>>>>>>>            Send AddKeyHandler (RefProc(HandleClearKey)) 116 False False True   //  Ctrl - F5
27827>>>>>>>        End
27827>>>>>>>>
27827>>>>>>>        
27827>>>>>>>        If (pbDeleteKeys(Self)) Begin
27829>>>>>>>            Send AddKeyHandler (RefProc(HandleDeleteKey)) 113 True False False  //  Shift - F2
27830>>>>>>>        End
27830>>>>>>>>
27830>>>>>>>        
27830>>>>>>>        If (pbSaveKeys(Self)) Begin
27832>>>>>>>            Send AddKeyHandler (RefProc(HandleSaveKey)) 113 False False False   //  F2
27833>>>>>>>        End
27833>>>>>>>>
27833>>>>>>>        
27833>>>>>>>    End_Procedure
27834>>>>>>>    
27834>>>>>>>    // Show an unhandled refind error for this DDO.
27834>>>>>>>    Procedure CannotRefindRecordUnhandledError Handle hoDDO
27836>>>>>>>        Integer iFile
27836>>>>>>>        String sExtMess sFile sView
27836>>>>>>>        Get WebObjectName to sView
27837>>>>>>>        Get Main_File of hoDDO to iFile
27838>>>>>>>        Get ErrorMessageTableName of hoDDO iFile to sFile
27839>>>>>>>        Move ("View:" * sView - "." * DD_FILE_TEXT * String(iFile) * "-" * sFile) to sExtMess
27840>>>>>>>        Error DFERR_REC_NOT_FOUND sExtMess
27841>>>>>>>>
27841>>>>>>>    End_Procedure
27842>>>>>>>
27842>>>>>>>    
27842>>>>>>>    // Sent when a NavigateForward fails. 
27842>>>>>>>    // By default call standard OnRefindRecordError and a NavigateCancel. This allows for customization
27842>>>>>>>    // eReason can be retCannotRereadMain or retCannotRereadConstrainingParent
27842>>>>>>>    Procedure OnNavigateForwardRefindError Handle hoDD Integer eReason
27844>>>>>>>        Send OnRefindRecordError hoDD reoNavigateForward eReason
27845>>>>>>>        // we will cancel this navigation forward
27845>>>>>>>        Send NavigateCancel
27846>>>>>>>    End_Procedure
27847>>>>>>>
27847>>>>>>>    // Sent when a Navigate Back fails. 
27847>>>>>>>    // By default call standard OnRefindRecordError. This allows for customization
27847>>>>>>>    // eReason can be retCannotRereadMain or retCannotRereadConstrainingParent
27847>>>>>>>    Procedure OnNavigateBackRefindError Handle hoDD Integer eReason
27849>>>>>>>        Send OnRefindRecordError hoDD reoNavigateBack eReason
27850>>>>>>>    End_Procedure
27851>>>>>>>
27851>>>>>>>    
27851>>>>>>>    
27851>>>>>>>
27851>>>>>>>    // these are used for setting dynamic enabled controls
27851>>>>>>>     
27851>>>>>>>    // returns true if this view should not allow finds on main-dd DEOs
27851>>>>>>>    // You want no finds with drilldowns that don't come from a main (select to zoom for same DDO)
27851>>>>>>>    Function IsViewNoFindOnMain Returns Boolean
27853>>>>>>>        tWebNavigateData NData
27853>>>>>>>        tWebNavigateData NData
27853>>>>>>>        Integer eWebViewStyle
27853>>>>>>>        Get peWebViewStyle to eWebViewStyle
27854>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27856>>>>>>>            // typically if you navigated from main (from select) you
27856>>>>>>>            // will not want to allow finds or prompts on main field indexes
27856>>>>>>>            Get GetNavigateData to NData
27857>>>>>>>            Function_Return (NData.eNavigateType = nfFromMain)
27858>>>>>>>        End
27858>>>>>>>>
27858>>>>>>>        Else Begin
27859>>>>>>>            Function_Return False
27860>>>>>>>        End
27860>>>>>>>>
27860>>>>>>>    End_Function
27861>>>>>>>    
27861>>>>>>>    // this this view have a No finding on a constrained parent? 
27861>>>>>>>    // Normally drilldowns do not want finding on the constrained parent
27861>>>>>>>    Function IsViewNoFindOnConstrainedParent Returns Boolean
27863>>>>>>>        Integer eWebViewStyle
27863>>>>>>>        Get peWebViewStyle to eWebViewStyle
27864>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27866>>>>>>>            // typically with drill down views you don't allow finds on the
27866>>>>>>>            // constraining child, because that's what you drilled in from
27866>>>>>>>            Function_Return True
27867>>>>>>>        End
27867>>>>>>>>
27867>>>>>>>        Else Begin
27868>>>>>>>            Function_Return False
27869>>>>>>>        End
27869>>>>>>>>
27869>>>>>>>    End_Function
27870>>>>>>>    
27870>>>>>>>    // Is this a read-only. With drilldown this is set true
27870>>>>>>>    // when the NavigateData.bReadOnly is True.
27870>>>>>>>    Function IsViewReadOnly Returns Boolean
27872>>>>>>>        Integer eWebViewStyle
27872>>>>>>>        Get peWebViewStyle to eWebViewStyle
27873>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27875>>>>>>>            // if this was called as read only, it's read only
27875>>>>>>>            tWebNavigateData NData
27875>>>>>>>            tWebNavigateData NData
27875>>>>>>>            Get GetNavigateData to NData
27876>>>>>>>            Function_Return (NData.bReadOnly)
27877>>>>>>>        End
27877>>>>>>>>
27877>>>>>>>        Else Begin
27878>>>>>>>            Function_Return False
27879>>>>>>>        End
27879>>>>>>>>
27879>>>>>>>    End_Function
27880>>>>>>>    
27880>>>>>>>    // this just sets the view readonly property
27880>>>>>>>    // With drilldown style, this is set in tWebNavigateData
27880>>>>>>>    // With non-drilldown, it is not set and you'd have to do this yourself
27880>>>>>>>    Procedure SetViewReadOnly Boolean bReadOnly
27882>>>>>>>        tWebNavigateData NData
27882>>>>>>>        tWebNavigateData NData
27882>>>>>>>        Integer eWebViewStyle
27882>>>>>>>        Get peWebViewStyle to eWebViewStyle
27883>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27885>>>>>>>            // set edit mode in NavigateData
27885>>>>>>>            Get GetNavigateData to NData
27886>>>>>>>            Move bReadOnly to NData.bReadOnly
27887>>>>>>>            Send SetNavigateData NData
27888>>>>>>>        End
27888>>>>>>>>
27888>>>>>>>    End_Procedure
27889>>>>>>>
27889>>>>>>>    // performs a refind and refresh based on the main view's DD record
27889>>>>>>>    // If the record cannot be found a handled error is raised
27889>>>>>>>    Procedure RefreshRecord
27891>>>>>>>        Handle hoDD
27891>>>>>>>        Integer iFile
27891>>>>>>>        RowID RID
27891>>>>>>>        Boolean bSuccess
27891>>>>>>>        Get Server to hoDD
27892>>>>>>>        If hoDD Begin
27894>>>>>>>            Get Main_File of hoDD to iFile
27895>>>>>>>            Get CurrentRowId of hoDD to RID
27896>>>>>>>            Get FindByRowIdEx of hoDD iFile RID to bSuccess
27897>>>>>>>            If not bSuccess Begin
27899>>>>>>>                Send OnRefreshRecordError hoDD
27900>>>>>>>            End
27900>>>>>>>>
27900>>>>>>>        End
27900>>>>>>>>
27900>>>>>>>    End_Procedure
27901>>>>>>>    
27901>>>>>>>    // Sets the edit mode
27901>>>>>>>    // refinds records and resets the DEOs as needed 
27901>>>>>>>    Procedure ChangeEditMode Boolean bEdit
27903>>>>>>>        Send SetViewReadOnly (not(bEdit))
27904>>>>>>>        // for a refind which will change enabled/disabled
27904>>>>>>>        Send RefreshRecord
27905>>>>>>>    End_Procedure

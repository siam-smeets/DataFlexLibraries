10408>>>>>>>>>   Function SQLGetStmtAttribute Integer iAttribId Returns String
10410>>>>>>>>>        Integer ihdbc
10410>>>>>>>>>        Integer ihstmt
10410>>>>>>>>>        String  sResult
10410>>>>>>>>>        String  sDrvrId
10410>>>>>>>>>        
10410>>>>>>>>>        // Initialize
10410>>>>>>>>>        Move "" to sResult
10411>>>>>>>>>        
10411>>>>>>>>>        // Get the cli handles
10411>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10412>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10413>>>>>>>>>        Get psDriverId            to sDrvrId
10414>>>>>>>>>        
10414>>>>>>>>>        // Get the attribute
10414>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") ;            Get SQLPrivateStmtAttribute iAttribId ihdbc sDrvrId ihstmt to sResult
10417>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLGetStmtAttribute"

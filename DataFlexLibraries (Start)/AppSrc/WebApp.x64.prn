21766>>>>>>>>>>>>>        Move (Lowercase(sName)) to sName
21767>>>>>>>>>>>>>        
21767>>>>>>>>>>>>>        For iItem from 0 to (SizeOfArray(aViews) - 1)
21773>>>>>>>>>>>>>>
21773>>>>>>>>>>>>>            If (Lowercase(psStateViewName(aViews[iItem].hoObj)) = sName) Begin
21775>>>>>>>>>>>>>                Function_Return aViews[iItem].hoObj
21776>>>>>>>>>>>>>            End
21776>>>>>>>>>>>>>>
21776>>>>>>>>>>>>>        Loop
21777>>>>>>>>>>>>>>
21777>>>>>>>>>>>>>        
21777>>>>>>>>>>>>>        Function_Return C_WebUnresolvedObject
21778>>>>>>>>>>>>>    End_Function
21779>>>>>>>>>>>>>    
21779>>>>>>>>>>>>>    // Restores the based on the passed state hash. Depending on the application style it continues
21779>>>>>>>>>>>>>    // into the drill-down or desktop-style track.
21779>>>>>>>>>>>>>    //
21779>>>>>>>>>>>>>    // Params:
21779>>>>>>>>>>>>>    //      sStateHash      String containing the full state hash.
21779>>>>>>>>>>>>>    //      bOptManualEnter (optional) True if the hash is entered manually by the user, false if 
21779>>>>>>>>>>>>>    //                      it comes from history. Determines if the record will be found for 
21779>>>>>>>>>>>>>    //                      desktop style (on back navigation we do not do that).
21779>>>>>>>>>>>>>    Procedure RestoreState String sStateHash Boolean bOptManualEnter
21781>>>>>>>>>>>>>        Integer eAppStyle
21781>>>>>>>>>>>>>        Boolean bManualEnter
21781>>>>>>>>>>>>>        
21781>>>>>>>>>>>>>        Move True to bManualEnter
21782>>>>>>>>>>>>>        If (num_arguments > 1) Begin
21784>>>>>>>>>>>>>            Move bOptManualEnter to bManualEnter
21785>>>>>>>>>>>>>        End
21785>>>>>>>>>>>>>>
21785>>>>>>>>>>>>>        
21785>>>>>>>>>>>>>        Get peApplicationStyle to eAppStyle
21786>>>>>>>>>>>>>        
21786>>>>>>>>>>>>>        If (eAppStyle = wvsDesktop) Begin
21788>>>>>>>>>>>>>            Send RestoreState_Desktop sStateHash bManualEnter
21789>>>>>>>>>>>>>        End
21789>>>>>>>>>>>>>>
21789>>>>>>>>>>>>>        Else Begin
21790>>>>>>>>>>>>>            Send RestoreState_DrillDown sStateHash bManualEnter
21791>>>>>>>>>>>>>        End
21791>>>>>>>>>>>>>>
21791>>>>>>>>>>>>>    End_Procedure
21792>>>>>>>>>>>>>    
21792>>>>>>>>>>>>>    // Server-Action
21792>>>>>>>>>>>>>    //
21792>>>>>>>>>>>>>    // Overrides cWebHostAPI_Mixin and extends it with navigation logic
21792>>>>>>>>>>>>>    //
21792>>>>>>>>>>>>>    // Triggered by the client when a history popstate event occurs. This is a browser back 
21792>>>>>>>>>>>>>    // navigation to an item that was added to the history stack using HistoryPushState. The 
21792>>>>>>>>>>>>>    // ptActionData contains the tWebValueTree struct with data passed to HistoryPushItem.
21792>>>>>>>>>>>>>    //
21792>>>>>>>>>>>>>    // Params:
21792>>>>>>>>>>>>>    //      sTitle      Page title for the history item.
21792>>>>>>>>>>>>>    //      sUrl        URL for the history item.
21792>>>>>>>>>>>>>    Procedure HistoryPopState String sTitle String sUrl
21794>>>>>>>>>>>>>        String sStateHash
21794>>>>>>>>>>>>>        tWebValueTree stateData
21794>>>>>>>>>>>>>        tWebValueTree stateData
21794>>>>>>>>>>>>>        
21794>>>>>>>>>>>>>        Get ptActionData to stateData
21795>>>>>>>>>>>>>        
21795>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryOnly) Begin
21797>>>>>>>>>>>>>            WebSet psCurrentAppState to stateData.v
21798>>>>>>>>>>>>>            Send RestoreState stateData.v False 
21799>>>>>>>>>>>>>        End
21799>>>>>>>>>>>>>>
21799>>>>>>>>>>>>>        
21799>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryAndUrls) Begin
21801>>>>>>>>>>>>>            Get StateHash to sStateHash
21802>>>>>>>>>>>>>            Send RestoreState sStateHash False
21803>>>>>>>>>>>>>        End
21803>>>>>>>>>>>>>>
21803>>>>>>>>>>>>>        
21803>>>>>>>>>>>>>        //  Trigger public event
21803>>>>>>>>>>>>>        Send OnHistoryPopState sTitle sUrl stateData
21804>>>>>>>>>>>>>    End_Procedure
21805>>>>>>>>>>>>>    
21805>>>>>>>>>>>>>    // Performs a NavigateBegin to the specified view using the last registered NavigateBegin path 
21805>>>>>>>>>>>>>    // for this view. Use this procedure when doing a NavigateBegin from inside a view (invoking
21805>>>>>>>>>>>>>    // objects inside a view are not allowed any more on NavigateBegin requests). The invoking
21805>>>>>>>>>>>>>    // object will be determined dynamically, if a path is registered from the WebApp then that
21805>>>>>>>>>>>>>    // will be used, else it will use the first registered path it finds.
21805>>>>>>>>>>>>>    //
21805>>>>>>>>>>>>>    // Params:
21805>>>>>>>>>>>>>    //      hoNavigateToView    Handle to the view to navigate into.
21805>>>>>>>>>>>>>    //      bUnconditional      If true no unsaved changes warnings will be given.
21805>>>>>>>>>>>>>    Procedure NavigatePathBegin Handle hoNavigateToView Boolean bUnconditional
21807>>>>>>>>>>>>>        Handle hoInvokingObject
21807>>>>>>>>>>>>>        
21807>>>>>>>>>>>>>        Get FindNavPathInvokingObj Self hoNavigateToView ntNavigateBegin to hoInvokingObject
21808>>>>>>>>>>>>>        
21808>>>>>>>>>>>>>        If (hoInvokingObject <> C_WebUnresolvedObject) Begin
21810>>>>>>>>>>>>>            Send NavigateBegin of hoNavigateToView hoInvokingObject bUnconditional
21811>>>>>>>>>>>>>        End
21811>>>>>>>>>>>>>>
21811>>>>>>>>>>>>>        Else Begin
21812>>>>>>>>>>>>>            Error DFERR_PROGRAM "No navigate begin path defined for the view"
21813>>>>>>>>>>>>>>
21813>>>>>>>>>>>>>        End
21813>>>>>>>>>>>>>>
21813>>>>>>>>>>>>>    End_Procedure
21814>>>>>>>>>>>>>    
21814>>>>>>>>>>>>>    // Callback method passed to the ShowView function that is asynchronous. Will continue 
21814>>>>>>>>>>>>>    // restoring the state after the view is loaded.
21814>>>>>>>>>>>>>    //
21814>>>>>>>>>>>>>    // Params:
21814>>>>>>>>>>>>>    //      hoView  Handle to the loaded view (not actually used).
21814>>>>>>>>>>>>>    Procedure RestoreState_Desktop_Callback Handle hoView
21816>>>>>>>>>>>>>        String sStateHash sView sRecordId
21816>>>>>>>>>>>>>        Integer iPos
21816>>>>>>>>>>>>>        
21816>>>>>>>>>>>>>        Get StateHash to sStateHash
21817>>>>>>>>>>>>>        
21817>>>>>>>>>>>>>        Send ParseViewStateHash sStateHash (&sView) (&sRecordId)
21818>>>>>>>>>>>>>        Send RestoreViewState_Desktop of hoView sRecordId False
21819>>>>>>>>>>>>>    End_Procedure
21820>>>>>>>>>>>>>    
21820>>>>>>>>>>>>>    // Callback method passed to the ShowView function that is asynchronous. Will continue 
21820>>>>>>>>>>>>>    // restoring the state after the view is loaded. This is the 'ManualEnter' callback.
21820>>>>>>>>>>>>>    //
21820>>>>>>>>>>>>>    // Params:
21820>>>>>>>>>>>>>    //      hoView  Handle to the loaded view (not actually used).
21820>>>>>>>>>>>>>    Procedure RestoreState_Desktop_Callback_ManualEnter Handle hoView
21822>>>>>>>>>>>>>        String sStateHash sView sRecordId
21822>>>>>>>>>>>>>        Integer iPos
21822>>>>>>>>>>>>>        
21822>>>>>>>>>>>>>        Get StateHash to sStateHash
21823>>>>>>>>>>>>>        
21823>>>>>>>>>>>>>        Send ParseViewStateHash sStateHash (&sView) (&sRecordId)
21824>>>>>>>>>>>>>        Send RestoreViewState_Desktop of hoView sRecordId True
21825>>>>>>>>>>>>>    End_Procedure
21826>>>>>>>>>>>>>    
21826>>>>>>>>>>>>>    // Desktop-style implementation of the restorestate logic. It finds out which view should be
21826>>>>>>>>>>>>>    // shown and calls ShowView, the callback messages will do further processing. If the state 
21826>>>>>>>>>>>>>    // hash is empty we show the default view.
21826>>>>>>>>>>>>>    //
21826>>>>>>>>>>>>>    // Params:
21826>>>>>>>>>>>>>    //      sStateHash      The full state hash.
21826>>>>>>>>>>>>>    //      bManualEnter    If true the state hash is entered by the user and a record should be 
21826>>>>>>>>>>>>>    //                      found.
21826>>>>>>>>>>>>>    Procedure RestoreState_Desktop String sStateHash Boolean bManualEnter
21828>>>>>>>>>>>>>        Boolean bDefault
21828>>>>>>>>>>>>>        Integer iPos
21828>>>>>>>>>>>>>        String sView
21828>>>>>>>>>>>>>        Handle hoView
21828>>>>>>>>>>>>>        
21828>>>>>>>>>>>>>        Move True to bDefault
21829>>>>>>>>>>>>>        
21829>>>>>>>>>>>>>        If (Trim(sStateHash) <> "") Begin
21831>>>>>>>>>>>>>            Send ParseViewStateHash sStateHash (&sView)
21832>>>>>>>>>>>>>            
21832>>>>>>>>>>>>>            Get ViewByStateHashName sView to hoView
21833>>>>>>>>>>>>>            
21833>>>>>>>>>>>>>            If (hoView > 0) Begin
21835>>>>>>>>>>>>>                If (bManualEnter) Begin
21837>>>>>>>>>>>>>                    Send Showview hoView (RefProc(RestoreState_Desktop_Callback_ManualEnter)) Self
21838>>>>>>>>>>>>>                End
21838>>>>>>>>>>>>>>
21838>>>>>>>>>>>>>                Else Begin
21839>>>>>>>>>>>>>                    Send Showview hoView (RefProc(RestoreState_Desktop_Callback)) Self
21840>>>>>>>>>>>>>                End
21840>>>>>>>>>>>>>>
21840>>>>>>>>>>>>>                Move False to bDefault
21841>>>>>>>>>>>>>            End
21841>>>>>>>>>>>>>>
21841>>>>>>>>>>>>>            Else Begin
21842>>>>>>>>>>>>>                If (pbStateHashInvalidError(Self)) Begin
21844>>>>>>>>>>>>>                    Error DFERR_WEBAPP_INVALID_URL
21845>>>>>>>>>>>>>>
21845>>>>>>>>>>>>>                End
21845>>>>>>>>>>>>>>
21845>>>>>>>>>>>>>                Else  Begin
21846>>>>>>>>>>>>>                    Get GetDefaultView to hoView
21847>>>>>>>>>>>>>                    If (hoView > 0) Begin
21849>>>>>>>>>>>>>                        Send Show of hoView
21850>>>>>>>>>>>>>                        Send UpdateStateHash of hoView True
21851>>>>>>>>>>>>>                    End
21851>>>>>>>>>>>>>>
21851>>>>>>>>>>>>>                End
21851>>>>>>>>>>>>>>
21851>>>>>>>>>>>>>                Procedure_Return
21852>>>>>>>>>>>>>            End
21852>>>>>>>>>>>>>>
21852>>>>>>>>>>>>>        End
21852>>>>>>>>>>>>>>
21852>>>>>>>>>>>>>        
21852>>>>>>>>>>>>>        //  Else we just show the default view
21852>>>>>>>>>>>>>        If (bDefault) Begin
21854>>>>>>>>>>>>>            Get GetDefaultView to hoView
21855>>>>>>>>>>>>>            If (hoView > 0) Begin
21857>>>>>>>>>>>>>                Send Show of hoView
21858>>>>>>>>>>>>>            End
21858>>>>>>>>>>>>>>
21858>>>>>>>>>>>>>        End
21858>>>>>>>>>>>>>>
21858>>>>>>>>>>>>>    End_Procedure
21859>>>>>>>>>>>>>    
21859>>>>>>>>>>>>>    // Drill-down version of the restorestate implementation. It parses the state hash into the 
21859>>>>>>>>>>>>>    // separate pieces and restores the entire view stack. It loops over the views in the state
21859>>>>>>>>>>>>>    // hash and checks if they are already properly initialized, if not it will reinitialize the
21859>>>>>>>>>>>>>    // view and rest of the stack from that point on,  if it is properly initialized it won't do
21859>>>>>>>>>>>>>    // anything for this step.
21859>>>>>>>>>>>>>    //
21859>>>>>>>>>>>>>    // Params:
21859>>>>>>>>>>>>>    //      sStateHash      Full state hash string.
21859>>>>>>>>>>>>>    //      bManualEnter    True if the string is manually entered (not used in drill-down).
21859>>>>>>>>>>>>>    Procedure RestoreState_DrillDown String sStateHash Boolean bManualEnter
21861>>>>>>>>>>>>>        String sViewName sState sMainID sCustomState
21861>>>>>>>>>>>>>        String[] asStates asViews asMainIDs asCustomStates asParams
21866>>>>>>>>>>>>>        Integer iState iNavType iPos iStack iStateTo eViewStyle eTopViewStyle iCount iLastViewIndex iFirstDialogIndex
21866>>>>>>>>>>>>>        Handle hoView hoStackView hoTopView hoPrevView hoDefaultView hoInvoking hjObjectDef
21866>>>>>>>>>>>>>        Handle[] ahViews ahInvokingObjects
21868>>>>>>>>>>>>>        Integer[] aeNavType
21869>>>>>>>>>>>>>        Boolean bAllowAccess bOverrideState bReinitialize bOK bIsLoaded bViewShown bErr bSuccess bIsTopView bHandled
21869>>>>>>>>>>>>>        tWebViewInfo[] aViewStack
21869>>>>>>>>>>>>>        tWebViewInfo[] aViewStack
21870>>>>>>>>>>>>>        
21870>>>>>>>>>>>>>        Move False to bViewShown
21871>>>>>>>>>>>>>        Move False to bReinitialize
21872>>>>>>>>>>>>>        Move False to bErr
21873>>>>>>>>>>>>>        Move 0 to iStack
21874>>>>>>>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack    
21876>>>>>>>>>>>>>        
21876>>>>>>>>>>>>>        Get GetDefaultView to hoDefaultView
21877>>>>>>>>>>>>>        
21877>>>>>>>>>>>>>        //  Split into separate view state hashes
21877>>>>>>>>>>>>>        Get ParseStateHash sStateHash to asStates
21878>>>>>>>>>>>>>        
21878>>>>>>>>>>>>>        //  Resize arrays (for performance and byref calls)
21878>>>>>>>>>>>>>        Move (ResizeArray(asViews, SizeOfArray(asStates))) to asViews
21879>>>>>>>>>>>>>        Move (ResizeArray(asMainIDs, SizeOfArray(asStates))) to asMainIDs
21880>>>>>>>>>>>>>        Move (ResizeArray(asCustomStates, SizeOfArray(asStates))) to asCustomStates
21881>>>>>>>>>>>>>        Move (ResizeArray(ahViews, SizeOfArray(asStates))) to ahViews
21882>>>>>>>>>>>>>        Move (ResizeArray(ahInvokingObjects, SizeOfArray(asStates))) to ahInvokingObjects
21883>>>>>>>>>>>>>        Move (ResizeArray(aeNavType, SizeOfArray(asStates))) to aeNavType
21884>>>>>>>>>>>>>        
21884>>>>>>>>>>>>>        //  Start at global level
21884>>>>>>>>>>>>>        Move Self to hoInvoking
21885>>>>>>>>>>>>>        If (hoDefaultView <> C_WebUnresolvedObject and peStateMode(hoDefaultView) = vsmOff) Begin
21887>>>>>>>>>>>>>            Move hoDefaultView to hoInvoking
21888>>>>>>>>>>>>>            
21888>>>>>>>>>>>>>            Get AllowViewAccess hoDefaultView to bAllowAccess
21889>>>>>>>>>>>>>            
21889>>>>>>>>>>>>>            If (not(bAllowAccess)) Begin
21891>>>>>>>>>>>>>                Get ViewAccessDenied hoDefaultView True to bHandled
21892>>>>>>>>>>>>>                If (bHandled) ;                    Procedure_Return
21895>>>>>>>>>>>>>                    
21895>>>>>>>>>>>>>                Move (ResizeArray(asStates, 0)) to asStates
21896>>>>>>>>>>>>>            End
21896>>>>>>>>>>>>>>
21896>>>>>>>>>>>>>        End
21896>>>>>>>>>>>>>>
21896>>>>>>>>>>>>>                
21896>>>>>>>>>>>>>        //  Parse URL and validate view names
21896>>>>>>>>>>>>>        Move (SizeOfArray(asStates) - 1) to iStateTo
21897>>>>>>>>>>>>>        For iState from 0 to iStateTo
21903>>>>>>>>>>>>>>
21903>>>>>>>>>>>>>            Send ParseViewStateHash asStates[iState] (&asViews[iState]) (&asMainIDs[iState]) (&asCustomStates[iState])
21904>>>>>>>>>>>>>            
21904>>>>>>>>>>>>>            //  Search on previous view
21904>>>>>>>>>>>>>            Get FindNavPathByKey of hoInvoking asViews[iState] (&ahInvokingObjects[iState]) (&aeNavType[iState]) to ahViews[iState]
21905>>>>>>>>>>>>>            
21905>>>>>>>>>>>>>            //  The exception for the default view
21905>>>>>>>>>>>>>            If (ahViews[iState] = C_WebUnresolvedObject and iState <= 1 and hoInvoking = hoDefaultView) Begin
21907>>>>>>>>>>>>>                Get FindNavPathByKey of Self asViews[iState] (&ahInvokingObjects[iState]) (&aeNavType[iState]) to ahViews[iState]
21908>>>>>>>>>>>>>                Move Self to hoInvoking
21909>>>>>>>>>>>>>            End
21909>>>>>>>>>>>>>>
21909>>>>>>>>>>>>>            
21909>>>>>>>>>>>>>            //  If not found we have an invalid URL
21909>>>>>>>>>>>>>            If (ahViews[iState] = C_WebUnresolvedObject) Begin
21911>>>>>>>>>>>>>                //  Gracefull error and fallback to default view
21911>>>>>>>>>>>>>                Get Reset of (ViewStack(Self)) False True to bOK
21912>>>>>>>>>>>>>                If (hoDefaultView > 0) Begin
21914>>>>>>>>>>>>>                    Get NavigateInitialize of hoDefaultView Self True "" ntNavigateBegin to bSuccess
21915>>>>>>>>>>>>>                End
21915>>>>>>>>>>>>>>
21915>>>>>>>>>>>>>                
21915>>>>>>>>>>>>>                If (pbStateHashInvalidError(Self)) Begin
21917>>>>>>>>>>>>>                    Error DFERR_WEBAPP_INVALID_URL
21918>>>>>>>>>>>>>>
21918>>>>>>>>>>>>>                End
21918>>>>>>>>>>>>>>
21918>>>>>>>>>>>>>                Else If (hoDefaultView > 0) Begin
21921>>>>>>>>>>>>>                    Send UpdateStateHash of hoDefaultView True
21922>>>>>>>>>>>>>                End
21922>>>>>>>>>>>>>>
21922>>>>>>>>>>>>>                Procedure_Return
21923>>>>>>>>>>>>>            End
21923>>>>>>>>>>>>>>
21923>>>>>>>>>>>>>            
21923>>>>>>>>>>>>>            Get AllowViewAccess ahViews[iState] to bAllowAccess
21924>>>>>>>>>>>>>            
21924>>>>>>>>>>>>>            If (not(bAllowAccess)) Begin
21926>>>>>>>>>>>>>                Get ViewAccessDenied hoDefaultView True to bHandled
21927>>>>>>>>>>>>>                If (bHandled) ;                    Procedure_Return
21930>>>>>>>>>>>>>                    
21930>>>>>>>>>>>>>                Move (ResizeArray(asStates, 0)) to asStates
21931>>>>>>>>>>>>>                Move -1 to iStateTo
21932>>>>>>>>>>>>>            End
21932>>>>>>>>>>>>>>
21932>>>>>>>>>>>>>            
21932>>>>>>>>>>>>>            Move ahViews[iState] to hoInvoking
21933>>>>>>>>>>>>>        Loop    
21934>>>>>>>>>>>>>>
21934>>>>>>>>>>>>>        
21934>>>>>>>>>>>>>        
21934>>>>>>>>>>>>>        //  Loop over parsed states and compare to view stack
21934>>>>>>>>>>>>>        For iState from 0 to iStateTo
21940>>>>>>>>>>>>>>
21940>>>>>>>>>>>>>            Move hoView to hoPrevView
21941>>>>>>>>>>>>>            
21941>>>>>>>>>>>>>            Move ahViews[iState] to hoView    
21942>>>>>>>>>>>>>            Move asMainIDs[iState] to sMainID
21943>>>>>>>>>>>>>            Move asCustomStates[iState] to sCustomState
21944>>>>>>>>>>>>>            Get peWebViewStyle of hoView to eViewStyle
21945>>>>>>>>>>>>>            
21945>>>>>>>>>>>>>            If (eViewStyle <> wvsDialog) Begin
21947>>>>>>>>>>>>>                Move iState to iLastViewIndex
21948>>>>>>>>>>>>>            End
21948>>>>>>>>>>>>>>
21948>>>>>>>>>>>>>            Else If (eViewStyle = wvsDialog and iFirstDialogIndex = 0) Begin
21951>>>>>>>>>>>>>                Move iState to iFirstDialogIndex
21952>>>>>>>>>>>>>            End
21952>>>>>>>>>>>>>>
21952>>>>>>>>>>>>>            
21952>>>>>>>>>>>>>            //  If we where not reinitializing yet we check if we can get away with doing nothing
21952>>>>>>>>>>>>>            If (not(bReinitialize)) Begin
21954>>>>>>>>>>>>>                Move True to bReinitialize
21955>>>>>>>>>>>>>                
21955>>>>>>>>>>>>>                //  If the default view has vsmOff set then it will be on the stack but not in the hash, so we jump one step
21955>>>>>>>>>>>>>                If (hoDefaultView > 0 and peStateMode(hoDefaultView) = vsmOff and iStack = 0 and SizeOfArray(aViewStack) > 0) Begin
21957>>>>>>>>>>>>>                    Get WebObjectByName aViewStack[iStack].sViewName to hoStackView
21958>>>>>>>>>>>>>                    If (hoStackView = hoDefaultView) Begin
21960>>>>>>>>>>>>>                        Increment iStack
21961>>>>>>>>>>>>>                        Move hoDefaultView to hoPrevView
21962>>>>>>>>>>>>>                    End
21962>>>>>>>>>>>>>>
21962>>>>>>>>>>>>>                End
21962>>>>>>>>>>>>>>
21962>>>>>>>>>>>>>                
21962>>>>>>>>>>>>>                //  Check if stack matches hash
21962>>>>>>>>>>>>>                If (iStack < SizeOfArray(aViewStack)) Begin
21964>>>>>>>>>>>>>                    Get WebObjectByName aViewStack[iStack].sViewName to hoStackView
21965>>>>>>>>>>>>>                    
21965>>>>>>>>>>>>>                    If (hoView = hoStackView) Begin
21967>>>>>>>>>>>>>                        Get NeedReinitialize of hoView sMainID to bReinitialize
21968>>>>>>>>>>>>>                    End
21968>>>>>>>>>>>>>>
21968>>>>>>>>>>>>>                    
21968>>>>>>>>>>>>>                    //  If it didn't we need to close stuff to the level where it matched
21968>>>>>>>>>>>>>                    If (bReinitialize) Begin
21970>>>>>>>>>>>>>                        Get TopViewHandle of (ViewStack(Self)) to hoTopView
21971>>>>>>>>>>>>>                        
21971>>>>>>>>>>>>>                        //  We just rudely close views here, no checks, this is what entering the new URL would basically do as well!
21971>>>>>>>>>>>>>                        Send Hide of hoTopView
21972>>>>>>>>>>>>>                        Send PopDownToView of (ViewStack(Self)) hoPrevView
21973>>>>>>>>>>>>>                    End
21973>>>>>>>>>>>>>>
21973>>>>>>>>>>>>>                End
21973>>>>>>>>>>>>>>
21973>>>>>>>>>>>>>            End
21973>>>>>>>>>>>>>>
21973>>>>>>>>>>>>>            
21973>>>>>>>>>>>>>            //  If the stack didn't match the state hash we need to reinitialize.
21973>>>>>>>>>>>>>            If (bReinitialize) Begin
21975>>>>>>>>>>>>>                If (iStack = 0) Begin
21977>>>>>>>>>>>>>                    Get Reset of (ViewStack(Self)) False True to bOK
21978>>>>>>>>>>>>>                    
21978>>>>>>>>>>>>>                    If (hoDefaultView <> hoView and hoDefaultView > 0) Begin
21980>>>>>>>>>>>>>                        Get NavigateInitialize of hoDefaultView Self (SizeOfArray(asStates) <= 0) "" ntNavigateBegin to bSuccess
21981>>>>>>>>>>>>>                    End
21981>>>>>>>>>>>>>>
21981>>>>>>>>>>>>>                    
21981>>>>>>>>>>>>>                End
21981>>>>>>>>>>>>>>
21981>>>>>>>>>>>>>                
21981>>>>>>>>>>>>>                // Check if this is the top view
21981>>>>>>>>>>>>>                If (iState = (SizeOfArray(asStates) -1)) Begin
21983>>>>>>>>>>>>>                    Move True to bIsTopView
21984>>>>>>>>>>>>>                    
21984>>>>>>>>>>>>>                    //If the top view is a dialog we should render the first actual view too
21984>>>>>>>>>>>>>                    If (eViewStyle = wvsDialog) Begin
21986>>>>>>>>>>>>>                        Move iLastViewIndex to iCount
21987>>>>>>>>>>>>>                        //We need to know what view should be rendered behind the dialog
21987>>>>>>>>>>>>>                        While (iCount < iState)
21991>>>>>>>>>>>>>                            Send ShowView to (Host(Self)) ahViews[iCount]
21992>>>>>>>>>>>>>                            Increment iCount
21993>>>>>>>>>>>>>                        Loop    
21994>>>>>>>>>>>>>>
21994>>>>>>>>>>>>>                    End
21994>>>>>>>>>>>>>>
21994>>>>>>>>>>>>>                    
21994>>>>>>>>>>>>>                End
21994>>>>>>>>>>>>>>
21994>>>>>>>>>>>>>                Else Begin
21995>>>>>>>>>>>>>                    Move False to bIsTopView
21996>>>>>>>>>>>>>                End
21996>>>>>>>>>>>>>>
21996>>>>>>>>>>>>>                
21996>>>>>>>>>>>>>                //  Actually initialize the view
21996>>>>>>>>>>>>>                Get NavigateInitialize of hoView ahInvokingObjects[iState] bIsTopView asStates[iState] aeNavType[iState] to bSuccess
21997>>>>>>>>>>>>>                If (not(bSuccess)) Begin
21999>>>>>>>>>>>>>                    //  Fallback to default view (error is already shown)
21999>>>>>>>>>>>>>                    Get Reset of (ViewStack(Self)) False True to bOK
22000>>>>>>>>>>>>>                    If (hoDefaultView > 0) Begin
22002>>>>>>>>>>>>>                        Get NavigateInitialize of hoDefaultView Self True "" ntNavigateBegin to bSuccess
22003>>>>>>>>>>>>>                    End
22003>>>>>>>>>>>>>>
22003>>>>>>>>>>>>>                    
22003>>>>>>>>>>>>>                    If (hoDefaultView > 0) Begin
22005>>>>>>>>>>>>>                        Send UpdateStateHash of hoDefaultView True
22006>>>>>>>>>>>>>                    End
22006>>>>>>>>>>>>>>
22006>>>>>>>>>>>>>                    Procedure_Return
22007>>>>>>>>>>>>>                End
22007>>>>>>>>>>>>>>
22007>>>>>>>>>>>>>            End
22007>>>>>>>>>>>>>>
22007>>>>>>>>>>>>>            
22007>>>>>>>>>>>>>            Move True to bViewShown
22008>>>>>>>>>>>>>            Increment iStack
22009>>>>>>>>>>>>>      
22009>>>>>>>>>>>>>        Loop    
22010>>>>>>>>>>>>>>
22010>>>>>>>>>>>>>        
22010>>>>>>>>>>>>>        //  If no view is shown we show the default view..
22010>>>>>>>>>>>>>        If (not(bViewShown)) Begin
22012>>>>>>>>>>>>>            Get Reset of (ViewStack(Self)) False True to bOK
22013>>>>>>>>>>>>>            Get NavigateInitialize of hoDefaultView Self (SizeOfArray(asStates) <= 0) "" ntNavigateBegin to bSuccess
22014>>>>>>>>>>>>>        End
22014>>>>>>>>>>>>>>
22014>>>>>>>>>>>>>        
22014>>>>>>>>>>>>>        //  We only serialize the last view in the stack right away
22014>>>>>>>>>>>>>        If (hoView <> C_WebUnresolvedObject) Begin
22016>>>>>>>>>>>>>            
22016>>>>>>>>>>>>>            If (not(bReinitialize)) Begin
22018>>>>>>>>>>>>>                Get TopViewHandle of (ViewStack(Self)) to hoTopView
22019>>>>>>>>>>>>>                If (hoView <> hoTopView) Begin
22021>>>>>>>>>>>>>                    If (hoTopView > 0) Begin
22023>>>>>>>>>>>>>                        Send Hide of hoTopView
22024>>>>>>>>>>>>>                        Get peWebViewStyle of hoTopView to eTopViewStyle
22025>>>>>>>>>>>>>                    End
22025>>>>>>>>>>>>>>
22025>>>>>>>>>>>>>                    Send PopDownToView of (ViewStack(Self)) hoView
22026>>>>>>>>>>>>>                    Send UpdateInvokingViewDrillDownStyle of hoView
22027>>>>>>>>>>>>>                    
22027>>>>>>>>>>>>>                    Get pbOverrideStateOnShow of hoView to bOverrideState
22028>>>>>>>>>>>>>                    Set pbOverrideStateOnShow of hoView to False
22029>>>>>>>>>>>>>                    
22029>>>>>>>>>>>>>                    Get peWebViewStyle of hoView to eViewStyle
22030>>>>>>>>>>>>>                    // When navigating from a regular view to a dialog we should restore more views
22030>>>>>>>>>>>>>                    // Restore everything up untill the first actual view
22030>>>>>>>>>>>>>                    If (eTopViewStyle = wvsDrillDown and eViewStyle = wvsDialog) Begin
22032>>>>>>>>>>>>>                        Move iLastViewIndex to iCount
22033>>>>>>>>>>>>>                        //Start from the last actual view and move up from there on.
22033>>>>>>>>>>>>>                        While (iCount <= iStateTo)
22037>>>>>>>>>>>>>                            Send ShowView to (Host(Self)) ahViews[iCount]
22038>>>>>>>>>>>>>                            Increment iCount
22039>>>>>>>>>>>>>                        Loop
22040>>>>>>>>>>>>>>
22040>>>>>>>>>>>>>                    End
22040>>>>>>>>>>>>>>
22040>>>>>>>>>>>>>                    Else Begin
22041>>>>>>>>>>>>>                        Send ShowView to (Host(Self)) hoView        // Send ShowView so we do not clear the entire viewstack    
22042>>>>>>>>>>>>>                    End
22042>>>>>>>>>>>>>>
22042>>>>>>>>>>>>>                                    
22042>>>>>>>>>>>>>                    Set pbOverrideStateOnShow of hoView to bOverrideState
22043>>>>>>>>>>>>>                End
22043>>>>>>>>>>>>>>
22043>>>>>>>>>>>>>            
22043>>>>>>>>>>>>>            End
22043>>>>>>>>>>>>>>
22043>>>>>>>>>>>>>            Else Begin
22044>>>>>>>>>>>>>                Get IsViewLoaded hoView to bIsLoaded
22045>>>>>>>>>>>>>                If (not(bIsLoaded)) Begin
22047>>>>>>>>>>>>>                    Set phoLoadView to hoView   //  Set phoLoadView as ClientActions sent by OnLoad must be marked as load view client actions
22048>>>>>>>>>>>>>                    
22048>>>>>>>>>>>>>                    Get SerializeObject of hoView to hjObjectDef
22049>>>>>>>>>>>>>                    Send ClientActionEarly "createView" asParams hjObjectDef               
22050>>>>>>>>>>>>>                    Send Destroy of hjObjectDef
22051>>>>>>>>>>>>>                    Set phoLoadView to C_WebUnresolvedObject
22052>>>>>>>>>>>>>                End
22052>>>>>>>>>>>>>>
22052>>>>>>>>>>>>>            End
22052>>>>>>>>>>>>>>
22052>>>>>>>>>>>>>        End    
22052>>>>>>>>>>>>>>
22052>>>>>>>>>>>>>    End_Procedure
22053>>>>>>>>>>>>>    
22053>>>>>>>>>>>>>    // Splits a view state hash string into the different pieces that it can contain.
22053>>>>>>>>>>>>>    //
22053>>>>>>>>>>>>>    // Params:
22053>>>>>>>>>>>>>    //      sStateHash              Complete view state hash.
22053>>>>>>>>>>>>>    //      ByRef sView             Will receive the view name.
22053>>>>>>>>>>>>>    //      Byref sOptRecordId      (optional) Will receive the record id.
22053>>>>>>>>>>>>>    //      ByRef sOptCustomHash    (optional) Will receive the custom hash.
22053>>>>>>>>>>>>>    Procedure ParseViewStateHash String sStateHash String ByRef sView String ByRef sOptRecordId String ByRef sOptCustomHash
22055>>>>>>>>>>>>>        String[] asParts
22056>>>>>>>>>>>>>        
22056>>>>>>>>>>>>>        //  Cut off possible "/" prefix

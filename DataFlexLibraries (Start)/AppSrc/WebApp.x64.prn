15875>>>>>>>>>>>>>>>// Defines the main structure for processing WebApp Framework requests. The tWebCallContext struct
15875>>>>>>>>>>>>>>>// contains the details of the currently processes request. Most steps are defined as empty stub
15875>>>>>>>>>>>>>>>// methods implemented by the other mixins used by cWebApp and cLocalWebControlHost.
15875>>>>>>>>>>>>>>>Class cWebCallHandler_mixin is a Mixin
15876>>>>>>>>>>>>>>>    
15876>>>>>>>>>>>>>>>    Procedure Define_cWebCallHandler_mixin
15878>>>>>>>>>>>>>>>        // Web UI Package Version
15878>>>>>>>>>>>>>>>        Property String psVersionID "1.0.45"   
15881>>>>>>>>>>>>>>>        
15881>>>>>>>>>>>>>>>        Property Boolean pbLogInvalidRequests True  //  Controls if bad requests cause event log entries
15882>>>>>>>>>>>>>>>    End_Procedure
15883>>>>>>>>>>>>>>>    
15883>>>>>>>>>>>>>>>    // Core webapp framework request handling. Initiates all individual steps (Core_...) that
15883>>>>>>>>>>>>>>>    // together process the call.  Note that most steps are implemented in other mixins, and 
15883>>>>>>>>>>>>>>>    // some might remain empty depending on the WebControlHost type (cWebApp vs 
15883>>>>>>>>>>>>>>>    // cLocalWebControlHost vs cWebControlViewhost).
15883>>>>>>>>>>>>>>>    //
15883>>>>>>>>>>>>>>>    // Preconditions:
15883>>>>>>>>>>>>>>>    //  cctx.hoRequest should contain a valid JSON handle to the request data.
15883>>>>>>>>>>>>>>>    //  cctx.hoResponse should contain a valid JSON handle to an empty JSON object.
15883>>>>>>>>>>>>>>>    // Postconditions:
15883>>>>>>>>>>>>>>>    //  cctx.hoResponse will be filled with the response or cctx.iFatalError will contain an 
15883>>>>>>>>>>>>>>>    //  HTTP Error code.
15883>>>>>>>>>>>>>>>    Procedure ProcessRequest tWebCallContext ByRef cctx
15885>>>>>>>>>>>>>>>        //  Clear data from previous requests
15885>>>>>>>>>>>>>>>        Send Call_ClearData (&cctx)
15886>>>>>>>>>>>>>>>        If (cctx.bCancel) Begin
15888>>>>>>>>>>>>>>>            Send Call_FinishErrorHandling (&cctx)
15889>>>>>>>>>>>>>>>            Procedure_Return
15890>>>>>>>>>>>>>>>        End
15890>>>>>>>>>>>>>>>>
15890>>>>>>>>>>>>>>>        
15890>>>>>>>>>>>>>>>        //  Initiate error handling
15890>>>>>>>>>>>>>>>        Send Call_PreErrorHandling (&cctx)
15891>>>>>>>>>>>>>>>        If (cctx.bCancel) Begin
15893>>>>>>>>>>>>>>>            Send Call_FinishErrorHandling (&cctx)
15894>>>>>>>>>>>>>>>            Procedure_Return
15895>>>>>>>>>>>>>>>        End
15895>>>>>>>>>>>>>>>>
15895>>>>>>>>>>>>>>>            
15895>>>>>>>>>>>>>>>        //  Validate the basic request structre
15895>>>>>>>>>>>>>>>        Send Call_ValidateData (&cctx)
15896>>>>>>>>>>>>>>>        If (cctx.bCancel) Begin
15898>>>>>>>>>>>>>>>            Send Call_FinishErrorHandling (&cctx)
15899>>>>>>>>>>>>>>>            Procedure_Return
15900>>>>>>>>>>>>>>>        End
15900>>>>>>>>>>>>>>>>
15900>>>>>>>>>>>>>>>        
15900>>>>>>>>>>>>>>>        //  Check the passed version number
15900>>>>>>>>>>>>>>>        Send Call_VersionCheck (&cctx)
15901>>>>>>>>>>>>>>>        If (cctx.bCancel) Begin
15903>>>>>>>>>>>>>>>            Send Call_FinishErrorHandling (&cctx)
15904>>>>>>>>>>>>>>>            Procedure_Return
15905>>>>>>>>>>>>>>>        End
15905>>>>>>>>>>>>>>>>
15905>>>>>>>>>>>>>>>        If (cctx.bSuccess) Begin
15907>>>>>>>>>>>>>>>            Increment giWebAccCacheCtx  //  Invalidate accessibility cache
15908>>>>>>>>>>>>>>>            
15908>>>>>>>>>>>>>>>            //  Parse the core request structure
15908>>>>>>>>>>>>>>>            Send Call_ParseRequestBody (&cctx)
15909>>>>>>>>>>>>>>>            If (cctx.bCancel) Begin
15911>>>>>>>>>>>>>>>                Send Call_FinishErrorHandling (&cctx)
15912>>>>>>>>>>>>>>>                Procedure_Return
15913>>>>>>>>>>>>>>>            End
15913>>>>>>>>>>>>>>>>
15913>>>>>>>>>>>>>>>            If (cctx.bSuccess) Begin
15915>>>>>>>>>>>>>>>                
15915>>>>>>>>>>>>>>>                //  Validate / initiate session
15915>>>>>>>>>>>>>>>                Send Call_PreValidateSession (&cctx)
15916>>>>>>>>>>>>>>>                If (cctx.bCancel) Begin
15918>>>>>>>>>>>>>>>                    Send Call_CancelWithError (&cctx)
15919>>>>>>>>>>>>>>>                    Procedure_Return
15920>>>>>>>>>>>>>>>                End
15920>>>>>>>>>>>>>>>>
15920>>>>>>>>>>>>>>>                If (cctx.bSuccess) Begin 
15922>>>>>>>>>>>>>>>                    
15922>>>>>>>>>>>>>>>                    //  Initialize attachment handling            
15922>>>>>>>>>>>>>>>                    Send Call_PreAttachments (&cctx)
15923>>>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
15925>>>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
15926>>>>>>>>>>>>>>>                        Procedure_Return
15927>>>>>>>>>>>>>>>                    End
15927>>>>>>>>>>>>>>>>
15927>>>>>>>>>>>>>>>                    
15927>>>>>>>>>>>>>>>                    //  Initialize web property system
15927>>>>>>>>>>>>>>>                    Send Call_PreWebProps (&cctx)
15928>>>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
15930>>>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
15931>>>>>>>>>>>>>>>                        Procedure_Return
15932>>>>>>>>>>>>>>>                    End   
15932>>>>>>>>>>>>>>>>
15932>>>>>>>>>>>>>>>                    
15932>>>>>>>>>>>>>>>                    //  Notify change rights (if nessecary)
15932>>>>>>>>>>>>>>>                    Send Call_PreNotifyChangeRights (&cctx)
15933>>>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
15935>>>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
15936>>>>>>>>>>>>>>>                        Procedure_Return
15937>>>>>>>>>>>>>>>                    End
15937>>>>>>>>>>>>>>>>
15937>>>>>>>>>>>>>>>                    
15937>>>>>>>>>>>>>>>                    //  Synchronize DDO's (if nessecary)
15937>>>>>>>>>>>>>>>                    Send Call_PreSync (&cctx)
15938>>>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
15940>>>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
15941>>>>>>>>>>>>>>>                        Procedure_Return
15942>>>>>>>>>>>>>>>                    End
15942>>>>>>>>>>>>>>>>
15942>>>>>>>>>>>>>>>                    
15942>>>>>>>>>>>>>>>                    //  Execute the core actions (OnClick / OnChange / ...)
15942>>>>>>>>>>>>>>>                    Send Call_Action (&cctx)
15943>>>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
15945>>>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
15946>>>>>>>>>>>>>>>                        Procedure_Return
15947>>>>>>>>>>>>>>>                    End                    
15947>>>>>>>>>>>>>>>>
15947>>>>>>>>>>>>>>>                    
15947>>>>>>>>>>>>>>>                    //  Store DDO states if nessecary
15947>>>>>>>>>>>>>>>                    Send Call_PostSync (&cctx)
15948>>>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
15950>>>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
15951>>>>>>>>>>>>>>>                        Procedure_Return
15952>>>>>>>>>>>>>>>                    End
15952>>>>>>>>>>>>>>>>
15952>>>>>>>>>>>>>>>                    
15952>>>>>>>>>>>>>>>                    //  Fire OnCallEnd event for that need to do cleanup
15952>>>>>>>>>>>>>>>                    Send Call_PostOnCallEnd (&cctx)
15953>>>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
15955>>>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
15956>>>>>>>>>>>>>>>                        Procedure_Return
15957>>>>>>>>>>>>>>>                    End
15957>>>>>>>>>>>>>>>>
15957>>>>>>>>>>>>>>>                    
15957>>>>>>>>>>>>>>>                    //  Add changed web properties to the response or store them if nessecary
15957>>>>>>>>>>>>>>>                    Send Call_PostWebProps (&cctx)
15958>>>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
15960>>>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
15961>>>>>>>>>>>>>>>                        Procedure_Return
15962>>>>>>>>>>>>>>>                    End
15962>>>>>>>>>>>>>>>>
15962>>>>>>>>>>>>>>>                    
15962>>>>>>>>>>>>>>>                    //  Add attachments to the response
15962>>>>>>>>>>>>>>>                    Send Call_PostAttachments (&cctx)
15963>>>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
15965>>>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
15966>>>>>>>>>>>>>>>                        Procedure_Return
15967>>>>>>>>>>>>>>>                    End
15967>>>>>>>>>>>>>>>>
15967>>>>>>>>>>>>>>>                End
15967>>>>>>>>>>>>>>>>
15967>>>>>>>>>>>>>>>            End
15967>>>>>>>>>>>>>>>>
15967>>>>>>>>>>>>>>>        End
15967>>>>>>>>>>>>>>>>
15967>>>>>>>>>>>>>>>        
15967>>>>>>>>>>>>>>>        //  Add client actions to the response
15967>>>>>>>>>>>>>>>        Send Call_PostClientAction (&cctx)
15968>>>>>>>>>>>>>>>        
15968>>>>>>>>>>>>>>>        //  Generate the response body        
15968>>>>>>>>>>>>>>>        Send Call_BuildResponseBody (&cctx)
15969>>>>>>>>>>>>>>>        
15969>>>>>>>>>>>>>>>        //  Stop error handling
15969>>>>>>>>>>>>>>>        Send Call_FinishErrorHandling (&cctx)
15970>>>>>>>>>>>>>>>    End_Procedure
15971>>>>>>>>>>>>>>>    
15971>>>>>>>>>>>>>>>    //  Cancels the request handling but still generates a response with an error
15971>>>>>>>>>>>>>>>    Procedure Call_CancelWithError tWebCallContext ByRef cctx
15973>>>>>>>>>>>>>>>        //  Add client actions
15973>>>>>>>>>>>>>>>        Send Call_PostErrorOnlyClientActions (&cctx)
15974>>>>>>>>>>>>>>>        
15974>>>>>>>>>>>>>>>        //  Generate the response body        
15974>>>>>>>>>>>>>>>        Send Call_BuildResponseBody (&cctx)
15975>>>>>>>>>>>>>>>        
15975>>>>>>>>>>>>>>>        //  Stop error handling
15975>>>>>>>>>>>>>>>        Send Call_FinishErrorHandling (&cctx)
15976>>>>>>>>>>>>>>>    End_Procedure

26456>>>>>>>>>    // returns true if this would be a client sorted field. This is used by
26456>>>>>>>>>    // grid columns to determine a default setting.
26456>>>>>>>>>    Function ClientSortable Returns Boolean
26458>>>>>>>>>        Integer eDBGridType
26458>>>>>>>>>        Boolean bDataAware bScrollable
26458>>>>>>>>>        Get pbDataAware to bDataAware
26459>>>>>>>>>        Get peDbGridType to eDBGridType
26460>>>>>>>>>        Get pbScroll to bScrollable
26461>>>>>>>>>        // It can be client sortable as long as it is static
26461>>>>>>>>>        Function_Return (not(bDataAware) or eDBGridType<>gtAutomatic or not(bScrollable))
26462>>>>>>>>>    End_Function
26463>>>>>>>>>    
26463>>>>>>>>>    // find in DD using eFindMode adjusting for reverse ordering. Use the current index 
26463>>>>>>>>>    Function FindInDD Handle hoDD Integer eMode Returns Boolean
26465>>>>>>>>>        Integer iOrdering
26465>>>>>>>>>        Boolean bReverseOrdering
26465>>>>>>>>>
26465>>>>>>>>>        If (pbNotifyingExternalDD(Self)) Begin
26467>>>>>>>>>            Error DFERR_PROGRAM "Assert: RefreshListFromDD called with pbNotifyingExternalDD set"
26468>>>>>>>>>>
26468>>>>>>>>>        End
26468>>>>>>>>>>
26468>>>>>>>>>
26468>>>>>>>>>        Get IndexOrder to iOrdering
26469>>>>>>>>>        WebGet pbReverseOrdering to bReverseOrdering
26470>>>>>>>>>        Get FindMode eMode bReverseOrdering to eMode
26471>>>>>>>>>        Send Find of hoDD eMode iOrdering    
26472>>>>>>>>>        Function_Return (Found)
26473>>>>>>>>>    End_Function
26474>>>>>>>>>    
26474>>>>>>>>>    // used by public FindFromTop and FindFromBottom
26474>>>>>>>>>    Procedure FindFromTB Boolean bFirst
26476>>>>>>>>>        Handle hoDD
26476>>>>>>>>>        Boolean bDataAware bFound
26476>>>>>>>>>        Get pbDataAware to bDataAware
26477>>>>>>>>>        If bDataAware Begin
26479>>>>>>>>>            Get Server to hoDD
26480>>>>>>>>>            Get FindInDD hoDD (If(bFirst,FIRST_RECORD, LAST_RECORD)) to bFound
26481>>>>>>>>>            If bFound Begin
26483>>>>>>>>>                Send UpdateCurrentRowID
26484>>>>>>>>>            End
26484>>>>>>>>>>
26484>>>>>>>>>            Else Begin
26485>>>>>>>>>                // If not found then the DD didn't change so we must clear the grid.
26485>>>>>>>>>                Send ClearGrid
26486>>>>>>>>>            End
26486>>>>>>>>>>
26486>>>>>>>>>        End
26486>>>>>>>>>>
26486>>>>>>>>>    End_Procedure
26487>>>>>>>>>    
26487>>>>>>>>>    // Server action
26487>>>>>>>>>    //
26487>>>>>>>>>    // Sent when the client navigates the focus from one row to another.
26487>>>>>>>>>    // sGoToRow - Indicates how to treat the second parameter:
26487>>>>>>>>>    //            "row"   - indicates that we are going to a specific row as specified in sToRowID
26487>>>>>>>>>    //            "first" - indicates that we are going to the first row in the data set. Ignore sToRowID.
26487>>>>>>>>>    //            "last"  - indicates that we are going to the last row in the data set. Ignore sToRowID.
26487>>>>>>>>>    //            "new"   - indicates that we are creating a new row. Ignore sToRowID.
26487>>>>>>>>>    // Returns  - True if the navigation is allowed, otherwise returns False.
26487>>>>>>>>>    Function ChangeCurrentRow String sGotoRow String sToRowID Returns Boolean 
26489>>>>>>>>>        Handle hoDD
26489>>>>>>>>>        Integer iMainFile
26489>>>>>>>>>        RowID riRowID
26489>>>>>>>>>        Boolean bReturn bOldGridAction bDataAware bSuccess
26489>>>>>>>>>        String sPreviousRowId
26489>>>>>>>>>        String[] aParams
26490>>>>>>>>>        
26490>>>>>>>>>        Get pbDataAware to bDataAware
26491>>>>>>>>>        WebGet psCurrentRowId to sPreviousRowId
26492>>>>>>>>>        
26492>>>>>>>>>        // Give grid a chance to do its row change logic via AllowChangeSelectedRow
26492>>>>>>>>>        Get AllowChangeSelectedRow sGotoRow sToRowID to bReturn
26493>>>>>>>>>
26493>>>>>>>>>        // load the new row
26493>>>>>>>>>        If (bReturn) Begin   
26495>>>>>>>>>            If (bDataAware) Begin
26497>>>>>>>>>                // data-aware
26497>>>>>>>>>                Get Server to hoDD
26498>>>>>>>>>                
26498>>>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
26499>>>>>>>>>                If (hoDD) Begin
26501>>>>>>>>>                    Move (Lowercase(sGotoRow)) to sGotoRow
26502>>>>>>>>>                    
26502>>>>>>>>>                    Case Begin
26502>>>>>>>>>                        Case (sGotoRow = "row")
26504>>>>>>>>>                            Set pbNotifyingExternalDD to True // indicate that we are simply in a client row change event.
26505>>>>>>>>>                            // Load the ToRowID's record into the DDO structure. This triggers a refresh to all
26505>>>>>>>>>                            // connected DDO's including cWebColumn objects
26505>>>>>>>>>                            Get Main_File of hoDD to iMainFile
26506>>>>>>>>>                            Move (DeserializeRowID(sToRowID)) to riRowID
26507>>>>>>>>>                            // load the "to" row into the DDO. Should indirectly set psCurrentRowId
26507>>>>>>>>>                            Get FindByRowIdEx of hoDD iMainFile riRowID to bSuccess
26508>>>>>>>>>                            // Handle errors
26508>>>>>>>>>                            If (not(bSuccess)) Begin
26510>>>>>>>>>                                Set pbNotifyingExternalDD to False
26511>>>>>>>>>                                Send HandleCacheError
26512>>>>>>>>>                            End
26512>>>>>>>>>>
26512>>>>>>>>>                            Case Break
26513>>>>>>>>>        
26513>>>>>>>>>                        Case (sGotoRow = "first")
26516>>>>>>>>>                        Case (sGotoRow = "last")
26519>>>>>>>>>                            // With first and last, we do a dd Find, which should refresh the entire grid
26519>>>>>>>>>                            Set pbNotifyingExternalDD to False
26520>>>>>>>>>                            // With first and last, we do a dd Find, which should refresh the entire grid
26520>>>>>>>>>                            If (sGotoRow = "first") Begin
26522>>>>>>>>>                                Get FindInDD hoDD FIRST_RECORD to bSuccess
26523>>>>>>>>>                            End
26523>>>>>>>>>>
26523>>>>>>>>>                            Else Begin
26524>>>>>>>>>                                Get FindInDD hoDD LAST_RECORD to bSuccess
26525>>>>>>>>>                            End
26525>>>>>>>>>>
26525>>>>>>>>>
26525>>>>>>>>>                            //  If not found then the DD didn't cause a refresh so we do it manually here
26525>>>>>>>>>                            If (not(bSuccess)) Begin
26527>>>>>>>>>                                Send ClearGrid
26528>>>>>>>>>                            End
26528>>>>>>>>>>
26528>>>>>>>>>                            
26528>>>>>>>>>                            
26528>>>>>>>>>                            Case Break
26529>>>>>>>>>        
26529>>>>>>>>>                    Case End               
26529>>>>>>>>>                    Set pbNotifyingExternalDD to bOldGridAction
26530>>>>>>>>>                                    
26530>>>>>>>>>                End
26530>>>>>>>>>>
26530>>>>>>>>>                Else Begin
26531>>>>>>>>>                    Error DFERR_PROGRAM C_$WebGridDoesNotHaveDDOServer
26532>>>>>>>>>>
26532>>>>>>>>>                End
26532>>>>>>>>>>
26532>>>>>>>>>            End
26532>>>>>>>>>>
26532>>>>>>>>>            Else Begin
26533>>>>>>>>>                // non-data-aware: We simply load the row sent by the client into the DEOs (columns)
26533>>>>>>>>>                If (sGotoRow = "row") Begin
26535>>>>>>>>>                    Send FillFromActionData 
26536>>>>>>>>>                End
26536>>>>>>>>>>
26536>>>>>>>>>            End
26536>>>>>>>>>>
26536>>>>>>>>>            
26536>>>>>>>>>            //  Fire user event
26536>>>>>>>>>            Send OnChangeCurrentRow sPreviousRowId sToRowID
26537>>>>>>>>>        End
26537>>>>>>>>>>
26537>>>>>>>>>        
26537>>>>>>>>>        //  Send client action that processes the row change (this is done to preserve the order combined with list refreshes)
26537>>>>>>>>>        Move bReturn to aParams[0]
26538>>>>>>>>>        Send ClientAction "handleRowChange" aParams
26539>>>>>>>>>        
26539>>>>>>>>>        Function_Return bReturn
26540>>>>>>>>>    End_Function
26541>>>>>>>>>    
26541>>>>>>>>>    
26541>>>>>>>>>    //  Called by the client when the sorting is changed. The piSortColumn and pbReverseSorting are
26541>>>>>>>>>    //  already updated when it is called.
26541>>>>>>>>>    Procedure ChangeSorting Integer iCol Boolean bReverse Integer iPrevCol Boolean bPrevReverse
26543>>>>>>>>>        Send GridRefresh
26544>>>>>>>>>    End_Procedure

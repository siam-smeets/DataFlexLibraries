26157>>>>>>>>>>>    Procedure DisregardFilter Variant vFilterState
26159>>>>>>>>>>>        tWebListFilterState FilterState
26159>>>>>>>>>>>        tWebListFilterState FilterState
26159>>>>>>>>>>>        Handle hoDD
26159>>>>>>>>>>>        String sOrigFilter
26159>>>>>>>>>>>        Boolean bOrigActive bFilterSet
26159>>>>>>>>>>>
26159>>>>>>>>>>>        Move vFilterState to FilterState
26160>>>>>>>>>>>        If (not(FilterState.bDisregardFilter)) Begin
26162>>>>>>>>>>>            Procedure_Return
26163>>>>>>>>>>>        End
26163>>>>>>>>>>>>
26163>>>>>>>>>>>
26163>>>>>>>>>>>        Get pbSearchSQLFilterSet to bFilterSet
26164>>>>>>>>>>>        If (not(bFilterSet)) Begin
26166>>>>>>>>>>>            Procedure_Return
26167>>>>>>>>>>>        End
26167>>>>>>>>>>>>
26167>>>>>>>>>>>
26167>>>>>>>>>>>        Get phoSearchSQLFilterDD to hoDD
26168>>>>>>>>>>>        If (hoDD <> 0) Begin
26170>>>>>>>>>>>            Get psSearchSQLOrigFilter to sOrigFilter
26171>>>>>>>>>>>            Get pbSearchSQLOrigActive to bOrigActive
26172>>>>>>>>>>>
26172>>>>>>>>>>>            Set psSQLFilter of hoDD to sOrigFilter
26173>>>>>>>>>>>            Set pbUseDDSqlFilters of hoDD to bOrigActive
26174>>>>>>>>>>>        End
26174>>>>>>>>>>>>
26174>>>>>>>>>>>
26174>>>>>>>>>>>        Set psSearchSQLOrigFilter to ""
26175>>>>>>>>>>>        Set pbSearchSQLOrigActive to False
26176>>>>>>>>>>>        Set phoSearchSQLFilterDD to 0
26177>>>>>>>>>>>        Set pbSearchSQLFilterSet to False
26178>>>>>>>>>>>    End_Procedure

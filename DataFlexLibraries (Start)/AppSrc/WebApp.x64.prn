38155>>>>>        String sEncryptPassword
38155>>>>>        UChar[] ucBinary ucPlain
38157>>>>>        Boolean bIsHex
38157>>>>>        Integer iLen iVoid
38157>>>>>        Pointer pBinary
38157>>>>>        
38157>>>>>        If (sBase64EncryptedPassword <> "") Begin
38159>>>>>            //  Decode from Base64
38159>>>>>            Move (Base64Decode(AddressOf(sBase64EncryptedPassword), &iLen)) to pBinary
38160>>>>>            
38160>>>>>            Move (ResizeArray(ucBinary, iLen, 0)) to ucBinary

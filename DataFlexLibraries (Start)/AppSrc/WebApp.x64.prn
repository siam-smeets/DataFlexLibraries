13237>>>>>>>        Property Handle phoTempDomNodeMap (Create(Self,U_cXMLDOMNamedNodeMap))
13238>>>>>>>        
13238>>>>>>>        // added in 15.1. If no COM pointer, msxml6 is most likely not installed. This will
13238>>>>>>>        // raise an unhandled error, which could be augmented to do something else.

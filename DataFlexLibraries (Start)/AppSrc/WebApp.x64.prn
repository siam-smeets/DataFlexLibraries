37497>>>>>>>    
37497>>>>>>>    // This is called to trigger the OnFileDrop event.
37497>>>>>>>    //
37497>>>>>>>    // Published!
37497>>>>>>>    Function FileDrop String sDropTargetName Integer eDropPosition Returns String
37499>>>>>>>        String[][] aFiles 
37500>>>>>>>        String[][] aResult
37501>>>>>>>        String sPath sData
37501>>>>>>>        Integer iFile iTo
37501>>>>>>>        Handle hoJsonObj hoJsonDragData hoJsonDropData hoDropTarget hoJson
37501>>>>>>>
37501>>>>>>>        //  Parse JSON
37501>>>>>>>        Get phoActionJsonData to hoJson
37502>>>>>>>        
37502>>>>>>>        Get Member of hoJson "DragData" to hoJsonDragData // <-- Contains files array
37503>>>>>>>        Get Member of hoJson "DropData" to hoJsonDropData // Drop data based on target
37504>>>>>>>        
37504>>>>>>>        Get WebObjectByName sDropTargetName to hoDropTarget
37505>>>>>>>        
37505>>>>>>>        If (hoDropTarget <> C_WebUnresolvedObject) Begin
37507>>>>>>>            Set phoJsonDropData of hoDropTarget to hoJsonDropData
37508>>>>>>>        End
37508>>>>>>>>
37508>>>>>>>        
37508>>>>>>>        // Extract files
37508>>>>>>>        Get JsonToDataType of hoJsonDragData to aFiles
37509>>>>>>>        
37509>>>>>>>        Move (SizeOfArray(aFiles) - 1) to iTo
37510>>>>>>>        
37510>>>>>>>        For iFile from 0 to iTo
37516>>>>>>>>
37516>>>>>>>            Move aFiles[iFile][0] to aResult[iFile][0]
37517>>>>>>>            
37517>>>>>>>            Get OnFileDrop aFiles[iFile][1] aFiles[iFile][2] aFiles[iFile][3] hoDropTarget eDropPosition to sPath
37518>>>>>>>            
37518>>>>>>>            If (sPath <> "") Begin
37520>>>>>>>                Get FileUploadKey of (ResourceManager(Self)) sPath to aResult[iFile][1]
37521>>>>>>>            End
37521>>>>>>>>
37521>>>>>>>            Else Begin
37522>>>>>>>                Move "" to aResult[iFile][1]
37523>>>>>>>            End
37523>>>>>>>>
37523>>>>>>>        Loop
37524>>>>>>>>
37524>>>>>>>        
37524>>>>>>>        //  Return upload paths to client
37524>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonObj
37525>>>>>>>        Send DataTypeToJson of hoJsonObj aResult
37526>>>>>>>        Get Stringify of hoJsonObj to sData
37527>>>>>>>        Send Destroy of hoJsonObj
37528>>>>>>>        
37528>>>>>>>        Function_Return sData
37529>>>>>>>        
37529>>>>>>>        //  Cleanup
37529>>>>>>>        If (hoDropTarget <> C_WebUnresolvedObject) Begin
37531>>>>>>>            Set phoJsonDropData of hoDropTarget to C_WebUnresolvedObject
37532>>>>>>>        End
37532>>>>>>>>
37532>>>>>>>    End_Function
37533>>>>>>>    
37533>>>>>>>    // User augmented, can be used to respond to a file drop and should return the path to store the file
37533>>>>>>>    Function OnFileDrop String sFileName BigInt iBytes String sMime Handle hoDropTarget WebDropPosition eDropPosition Returns String
37535>>>>>>>        Function_Return ""
37536>>>>>>>    End_Function
37537>>>>>>>
37537>>>>>>>    Procedure End_Construct_Object
37539>>>>>>>        Forward Send End_Construct_Object
37541>>>>>>>        
37541>>>>>>>        // Since we have our own End_Construct_Object, we need to manually publish the methods from the cWebFileUploadMixin
37541>>>>>>>        Send PublishFileUploadMethods
37542>>>>>>>        WebPublishFunction FileDrop
37543>>>>>>>    End_Procedure
37544>>>>>>>
37544>>>>>>>End_Class

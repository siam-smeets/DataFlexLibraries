31893>>>>>>>    Procedure SetChecked Boolean bChecked
31895>>>>>>>        // Sets the control's value according to the psCheckedValue and psUncheckedValue settings.
31895>>>>>>>        //
31895>>>>>>>        // Note: during WebApp initialization (while all the Web Objects are being created) then this
31895>>>>>>>        // message will set the design-time psValue, at all other times it will WebSet the client's
31895>>>>>>>        // synchronized psValue.
31895>>>>>>>        String sValue
31895>>>>>>>        Boolean bInitWebApp
31895>>>>>>>        
31895>>>>>>>        Get Initializing of (Host(Self)) to bInitWebApp
31896>>>>>>>        If (bInitWebApp) Begin
31898>>>>>>>            If (bChecked) Begin
31900>>>>>>>                Get psChecked to sValue
31901>>>>>>>            End
31901>>>>>>>>
31901>>>>>>>            Else Begin
31902>>>>>>>                Get psUnchecked to sValue 
31903>>>>>>>            End
31903>>>>>>>>
31903>>>>>>>            
31903>>>>>>>            Set psValue to sValue
31904>>>>>>>        End
31904>>>>>>>>
31904>>>>>>>        Else Begin
31905>>>>>>>            If (bChecked) Begin
31907>>>>>>>                WebGet psChecked to sValue
31908>>>>>>>            End
31908>>>>>>>>
31908>>>>>>>            Else Begin
31909>>>>>>>                WebGet psUnchecked to sValue 
31910>>>>>>>            End
31910>>>>>>>>
31910>>>>>>>            
31910>>>>>>>            WebSet psValue to sValue
31911>>>>>>>        End
31911>>>>>>>>
31911>>>>>>>    End_Procedure

3419>>>>>>>    // This procedure will notify every attached DEO that the value of a
3419>>>>>>>    // field has been changed. Every DEO needs to update its value to reflect
3419>>>>>>>    // the new value.
3419>>>>>>>    Procedure Field_Value_Changed Integer iField String sValue
3421>>>>>>>        Integer iMax
3421>>>>>>>        Integer iCount
3421>>>>>>>        Integer iDEO
3421>>>>>>>        Integer iMain_File
3421>>>>>>>        Integer iNoChange
3421>>>>>>>        Get Change_Disabled_State to iNoChange
3422>>>>>>>        Get Main_File to iMain_File
3423>>>>>>>        Get Data_Set_User_Interface_Count to iMax
3424>>>>>>>        Decrement iMax
3425>>>>>>>        For iCount from 0 to iMax
3431>>>>>>>>
3431>>>>>>>            Get Data_Set_User_Interface iCount to iDEO
3432>>>>>>>            If (Extended_DEO_State(iDEO) ) Begin
3434>>>>>>>                Send File_Field_Value_Changed to iDEO iMain_File iField sValue iNoChange
3435>>>>>>>            End
3435>>>>>>>>
3435>>>>>>>        Loop
3436>>>>>>>>
3436>>>>>>>    End_Procedure
3437>>>>>>>
3437>>>>>>>    // Gets/Sets Field_Changed_State of the passed field. Will Set Changed_
3437>>>>>>>    // state if appropriate (if change_disabled_state is false)
3437>>>>>>>    Function Field_Changed_State Integer iField Returns Integer
3439>>>>>>>        Function_Return ;            (Item_Changed_State(Record_Buffer(Self), iField))
3440>>>>>>>    End_Function
3441>>>>>>>
3441>>>>>>>
3441>>>>>>>    // Handle NoPut here. If the field is noput set the field_changed_State but do not set the
3441>>>>>>>    // DD's changed_state. As of 17.0, we changed the rule so that noput DEOs always update the DD.
3441>>>>>>>    // They set the field_Current_value and they set the field_changed_state. If noput they will
3441>>>>>>>    // not set changed_state. This now makes windows and web consistent.
3441>>>>>>>    Procedure Set Field_Changed_State Integer iField Integer iState
3443>>>>>>>        Boolean bNoPut bOldSt bIsCommitted
3443>>>>>>>
3443>>>>>>>        Get Field_Option iField DD_NOPUT to bNoPut
3444>>>>>>>        If not bNoPut Begin // if not noput, see if this is a committed and therefore noput
3446>>>>>>>            Get IsCommitted to bIsCommitted
3447>>>>>>>            If bIsCommitted Begin
3449>>>>>>>                Get IsFieldCommitted iField to bNoPut
3450>>>>>>>            End
3450>>>>>>>>
3450>>>>>>>        End
3450>>>>>>>>
3450>>>>>>>
3450>>>>>>>        If bNoPut Begin
3452>>>>>>>            Get Change_disabled_State to bOldSt
3453>>>>>>>            Set Change_disabled_State to True
3454>>>>>>>        End
3454>>>>>>>>
3454>>>>>>>
3454>>>>>>>        Set Item_Changed_State of (Record_Buffer(Self)) iField to iState
3455>>>>>>>        // the cDDBuffer class item_changed_state does not attempt to set
3455>>>>>>>        // changed_state, so we do it here. This will allow for future
3455>>>>>>>        // greater flexibilities.
3455>>>>>>>        If (iState) Begin
3457>>>>>>>            Set Changed_State of (Record_Buffer(Self)) to True
3458>>>>>>>        End
3458>>>>>>>>
3458>>>>>>>        If bNoPut Begin
3460>>>>>>>            Set Change_disabled_State to bOldSt
3461>>>>>>>        End
3461>>>>>>>>
3461>>>>>>>
3461>>>>>>>    End_Procedure
3462>>>>>>>
3462>>>>>>>    // As above, but passes both file and field
3462>>>>>>>    Function File_Field_Changed_State Integer iFile Integer iField Returns Integer
3464>>>>>>>        Integer iDSO
3464>>>>>>>        Get Data_Set iFile to iDSO
3465>>>>>>>        If iDSO ;            Function_Return (Field_Changed_State(iDSO, iField))
3468>>>>>>>    End_Function
3469>>>>>>>
3469>>>>>>>    Procedure Set File_Field_Changed_State Integer iFile Integer iField Integer iState
3471>>>>>>>        Integer iDSO

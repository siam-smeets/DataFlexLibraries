9081>>>>>>>>>    // Convert a text to the corresponding
9081>>>>>>>>>    // Generate_Record_ID_Method attribute value
9081>>>>>>>>>    //
9081>>>>>>>>>    Function TextToRIMValue String sText Returns Integer
9083>>>>>>>>>        If (sText = "None") ;            Function_Return RIM_NONE
9086>>>>>>>>>        Else If (sText = "Identity Column") ;            Function_Return RIM_IDENTITY_COLUMN
9090>>>>>>>>>        Else If (sText = "Dispenser Table") ;            Function_Return RIM_DISPENSER_TABLE
9094>>>>>>>>>        Else If (sText = "External") ;            Function_Return RIM_EXTERNAL
9098>>>>>>>>>    End_Function

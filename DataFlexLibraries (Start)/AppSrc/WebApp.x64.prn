25027>>>>>>>>>>>>>>>    Function SelectionSource Returns Handle
25029>>>>>>>>>>>>>>>        Function_Return (phoSelectionSource(Self))
25030>>>>>>>>>>>>>>>    End_Function
25031>>>>>>>>>>>>>>>    
25031>>>>>>>>>>>>>>>    Procedure OnCreate tSelectionItem ByRef NewItem Boolean ByRef bCancel
25033>>>>>>>>>>>>>>>        // Stub
25033>>>>>>>>>>>>>>>    End_Procedure
25034>>>>>>>>>>>>>>>
25034>>>>>>>>>>>>>>>    Procedure OnSelectControlSuggestion String sRowId String sValue Integer iAdditionalItems Integer iPage
25036>>>>>>>>>>>>>>>        Case Begin
25036>>>>>>>>>>>>>>>            Case (sRowId = C_WebBaseSelectionForm_More_Control) 
25038>>>>>>>>>>>>>>>                Send FindSuggestions sValue iPage iAdditionalItems
25039>>>>>>>>>>>>>>>                Case Break
25040>>>>>>>>>>>>>>>            Case (sRowId = C_WebBaseSelectionForm_CreateNew_Control) 
25043>>>>>>>>>>>>>>>                Send CreateNewByValue sValue
25044>>>>>>>>>>>>>>>                Case Break
25045>>>>>>>>>>>>>>>            Case (sRowId = C_WebBaseSelectionForm_AdvancedSearch_Control)
25048>>>>>>>>>>>>>>>                Send OnPrompt
25049>>>>>>>>>>>>>>>                Case Break
25050>>>>>>>>>>>>>>>        Case End
25050>>>>>>>>>>>>>>>    End_Procedure
25051>>>>>>>>>>>>>>>    
25051>>>>>>>>>>>>>>>    Procedure CreateNewByValue String sValue
25053>>>>>>>>>>>>>>>        tSelectionItem oNewItem
25053>>>>>>>>>>>>>>>        tSelectionItem oNewItem
25053>>>>>>>>>>>>>>>        Boolean bCancel bFound bErr bAllowCreate bSuccess
25053>>>>>>>>>>>>>>>        Integer iFile iField
25053>>>>>>>>>>>>>>>        Handle hoSelectionSource hoServer hoTable
25053>>>>>>>>>>>>>>>        
25053>>>>>>>>>>>>>>>        Get pbAllowCreate to bAllowCreate
25054>>>>>>>>>>>>>>>        If (not(bAllowCreate)) ;            Procedure_Return
25057>>>>>>>>>>>>>>>        
25057>>>>>>>>>>>>>>>        Move sValue to oNewItem.aValues[0]
25058>>>>>>>>>>>>>>>        Send OnCreate (&oNewItem) (&bCancel)
25059>>>>>>>>>>>>>>>        
25059>>>>>>>>>>>>>>>        If (bCancel) ;            Procedure_Return
25062>>>>>>>>>>>>>>>        
25062>>>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
25063>>>>>>>>>>>>>>>        
25063>>>>>>>>>>>>>>>        If (hoSelectionSource > 0) Begin
25065>>>>>>>>>>>>>>>            If (pbAutoCreate(hoSelectionSource)) Begin
25067>>>>>>>>>>>>>>>                Get CreateItem of hoSelectionSource (&oNewItem) oNewItem.aValues[0] to bSuccess
25068>>>>>>>>>>>>>>>                If (not(bSuccess)) ;                    Procedure_Return
25071>>>>>>>>>>>>>>>            End
25071>>>>>>>>>>>>>>>>
25071>>>>>>>>>>>>>>>        End
25071>>>>>>>>>>>>>>>>
25071>>>>>>>>>>>>>>>        
25071>>>>>>>>>>>>>>>        Send OnPostCreate oNewItem
25072>>>>>>>>>>>>>>>    End_Procedure
25073>>>>>>>>>>>>>>>    
25073>>>>>>>>>>>>>>>    Procedure Refill
25075>>>>>>>>>>>>>>>        String[] aParams
25076>>>>>>>>>>>>>>>        Move True to aParams[0]
25077>>>>>>>>>>>>>>>        Send ClientAction "suggestLoad" aParams
25078>>>>>>>>>>>>>>>    End_Procedure
25079>>>>>>>>>>>>>>>    
25079>>>>>>>>>>>>>>>    Procedure FindSuggestions String sFilter Integer iPage Integer iAdditionalItems
25081>>>>>>>>>>>>>>>        tSelectionItem[] aItems
25081>>>>>>>>>>>>>>>        tSelectionItem[] aItems
25082>>>>>>>>>>>>>>>        Handle hoJson hoSelectionSource
25082>>>>>>>>>>>>>>>        Boolean bLast bIsObj
25082>>>>>>>>>>>>>>>        tSelectionItem prevItem
25082>>>>>>>>>>>>>>>        tSelectionItem prevItem
25082>>>>>>>>>>>>>>>        String[] aParams
25083>>>>>>>>>>>>>>>        Integer iPageSize
25083>>>>>>>>>>>>>>>            
25083>>>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
25084>>>>>>>>>>>>>>>        WebGet piPageSize to iPageSize
25085>>>>>>>>>>>>>>>        
25085>>>>>>>>>>>>>>>        // For suggestionmode additional items are required in the webtagsform.
25085>>>>>>>>>>>>>>>        Move (iPageSize + iAdditionalItems) to iPageSize
25086>>>>>>>>>>>>>>>        
25086>>>>>>>>>>>>>>>        Get phoActionJsonData to hoJson
25087>>>>>>>>>>>>>>>        If (hoJson > 0) Begin
25089>>>>>>>>>>>>>>>            Get JsonToDataType of hoJson to prevItem
25090>>>>>>>>>>>>>>>        End
25090>>>>>>>>>>>>>>>>
25090>>>>>>>>>>>>>>>        
25090>>>>>>>>>>>>>>>        If (hoSelectionSource > 0) Begin
25092>>>>>>>>>>>>>>>            Send FetchItems of hoSelectionSource (&aItems) (&bLast) sFilter prevItem iPageSize iPage
25093>>>>>>>>>>>>>>>            If (pbAllData(hoSelectionSource)) Begin
25095>>>>>>>>>>>>>>>                Move True to bLast
25096>>>>>>>>>>>>>>>            End
25096>>>>>>>>>>>>>>>>
25096>>>>>>>>>>>>>>>        End
25096>>>>>>>>>>>>>>>>
25096>>>>>>>>>>>>>>>        
25096>>>>>>>>>>>>>>>        Send OnFindSuggestions (&aItems) (&bLast) sFilter prevItem iPage
25097>>>>>>>>>>>>>>>        
25097>>>>>>>>>>>>>>>        Send InitializeCustomButtons (&aItems) bLast sFilter
25098>>>>>>>>>>>>>>>        
25098>>>>>>>>>>>>>>>        Move sFilter to aParams[0]
25099>>>>>>>>>>>>>>>        Move (String(bLast)) to aParams[1]
25100>>>>>>>>>>>>>>>        Send ClientAction "suggestHandle" aParams aItems iPage
25101>>>>>>>>>>>>>>>    End_Procedure

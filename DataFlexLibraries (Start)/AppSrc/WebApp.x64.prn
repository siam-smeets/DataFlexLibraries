25954>>>>>>>>>>>        Send OnDefineTooltip (&tCell.sTooltip)
25955>>>>>>>>>>>        Send OnDefineCssClass (&tCell.sCssClassName)
25956>>>>>>>>>>>        
25956>>>>>>>>>>>        Move sValue to tCell.sValue
25957>>>>>>>>>>>    End_Procedure

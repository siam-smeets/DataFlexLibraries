26260>>>>>>>>>    Import_Class_Protocol cWebListFilter_mixin
26261>>>>>>>>>    
26261>>>>>>>>>    Procedure Construct_Object
26263>>>>>>>>>        Forward Send Construct_Object
26265>>>>>>>>>        Send Define_cFilterExpression_mixin
26266>>>>>>>>>        Send Define_cWebListFilter_mixin
26267>>>>>>>>>        
26267>>>>>>>>>        Property Integer piOrdering -1                // initial ordering index see also Function Ordering
26268>>>>>>>>>        Property Integer piPageSize 80                // Max number of rows to send to the client at a time. 0 = load all available rows
26269>>>>>>>>>        
26269>>>>>>>>>        // should columns adjust their pbEnabled based on the DDO binding or should it be static.
26269>>>>>>>>>        // Normally only grids should be dynamic. This property is queried by cWebColumn objects.
26269>>>>>>>>>        Property Boolean pbColumnsEnabledStatic True
26270>>>>>>>>>
26270>>>>>>>>>        Property Integer peRequestFindMode rfmFindAll
26271>>>>>>>>>        
26271>>>>>>>>>        Property Boolean pbDataAware True             // Set True if Grid Columns use data binding to DDO. False if there should be no DDO connection.
26274>>>>>>>>>
26274>>>>>>>>>        Property Integer peDbGridType gtAutomatic           // If set to true, data is static and load just once. Only used with pbDataAware=T.
26277>>>>>>>>>        
26277>>>>>>>>>        Property Integer peGrouping grpDisabled
26280>>>>>>>>>        
26280>>>>>>>>>        Property Boolean pbGroupsCollapsible True
26283>>>>>>>>>        
26283>>>>>>>>>        Property Boolean pbGroupsCollapseByDefault False
26286>>>>>>>>>        
26286>>>>>>>>>        Property Handle[] phoColumnObjects            // ordered list of cWebColumn objects (in left to right column order)
26287>>>>>>>>>        Property Boolean pbNotifyingExternalDD False  // Private: Used to indicate to the Refresh event that we are handling an event generated by some action on the list/grid control (i.e. delete row, change row, etc)
26288>>>>>>>>>        Property Boolean pbGridBehavior False         // Private: Used by cWebColumn objects to test if they live in a cWebList (read only) or a cWebGrid (save and other stuff is supported)
26289>>>>>>>>>        Property Boolean pbInClearGrid False          // Private: should be set when a DD Clear is supposed refresh an empty grid instead of adding a new row            
26290>>>>>>>>>        
26290>>>>>>>>>        Property Boolean pbSuppressCacheError True // if a record cannot be found in cache, do we report the error?        
26291>>>>>>>>>        // Published Properties
26291>>>>>>>>>        Property Boolean pbColumnSortable True      // If true, column sorting is allowed (which may be server side or client side)
26294>>>>>>>>>        Property Boolean pbAutoSearch True          // If true the search dialog will popup automatically when the user starts typing
26297>>>>>>>>>        Property Boolean pbShowSelected True        // If true the list will visually show which row is selected.
26300>>>>>>>>>        Property Boolean pbShowHeader True          // If true the list will show a header that allows the user to see the column captions and sorting.
26303>>>>>>>>>        Property Boolean pbShowFooter False          // If true the list will show a footer that allows the user to see the footer information.
26306>>>>>>>>>        Property Boolean pbScroll True              // If true the list will scroll vertically
26309>>>>>>>>>        
26309>>>>>>>>>        Property Boolean pbReverseOrdering False    // If true then the current grid ordering is reversed
26312>>>>>>>>>        Property Boolean pbUnOrdered False          // If True then the grid data has potentially become unordered due to changes in the data
26315>>>>>>>>>        Property Integer piSortColumn -1            // Indicates which column the grid is currently sorted on (-1 means the data is sorted via piOrdering)
26318>>>>>>>>>        Property String psCurrentRowId ""           // Row ID of the currently selected row.
26321>>>>>>>>>        Property Integer piCurrentRowIndex -1       // The row index of the currently selected row on the client. Does not reflect row changes on the server within the current request. Note that if peGridType is set to gtAutomatic this number is relative to the rows in cache on the client.
26324>>>>>>>>>        Property Integer piRowCount 0               // The number of rows currently on the client. Note that if peGridType is set to gtAutomatic this number does not represent the entire set.
26327>>>>>>>>>        
26327>>>>>>>>>        Property Boolean pbColumnsResizable True
26330>>>>>>>>>        
26330>>>>>>>>>        Property Boolean pbAutoColumnSizing True
26333>>>>>>>>>        
26333>>>>>>>>>        Property Boolean pbOfflineEditing False      // Optimization: Disable server call on row change
26336>>>>>>>>>        Property String psPlaceHolder ""            //  Placeholder text shown if the list has no records
26339>>>>>>>>>        
26339>>>>>>>>>        Property Integer piLimitRows 0              // Only show the first x rows (0 = show all), requires peDbGridType to be set to gtAllData or pbScroll to false!
26342>>>>>>>>>        
26342>>>>>>>>>        Property String psKeyBuddy ""
26345>>>>>>>>>        
26345>>>>>>>>>        Property Handle phoKeyBuddy C_WebUnresolvedObject   //  Can be set to another cWebBaseUIObject and the cWebList will respond to key actions on that control 
26346>>>>>>>>>        
26346>>>>>>>>>         
26346>>>>>>>>>        Property Boolean pbServerOnRowClick False   // Switches the OnRowClick event on and off
26349>>>>>>>>>        Property String psClientOnRowClick ""       // Can be set to a client-side JavaScript event handler for the OnRowClick event
26352>>>>>>>>>        
26352>>>>>>>>>        Property Boolean pbAllowDeleteRow False   // Allows deleting rows.
26353>>>>>>>>>        
26353>>>>>>>>>        Property Boolean pbAllowColumnReordering True // Allows the moving of columns by dragging.
26356>>>>>>>>>        Property Boolean pbAllowColumnHiding True // Allows the showing and hiding of columns by context menu.
26359>>>>>>>>>        
26359>>>>>>>>>        Property Boolean pbStoreColumnLayout True
26362>>>>>>>>>        Property String psClientOnColumnLayoutChanged ""
26365>>>>>>>>>        Property Boolean pbServerOnColumnLayoutChanged False
26368>>>>>>>>>        
26368>>>>>>>>>        Property Boolean pbStoreGroupConfig True
26371>>>>>>>>>        Property String psClientOnGroupConfigChanged ""
26374>>>>>>>>>        Property Boolean pbServerOnGroupConfigChanged False
26377>>>>>>>>>        
26377>>>>>>>>>        Property Boolean pbServerOnGroupHeaderToggle False
26380>>>>>>>>>        
26380>>>>>>>>>        Property Boolean pbUseCustomHeaderMenu False
26381>>>>>>>>>        Property Boolean pbUseHeaderMenuOnWholeList False // Implicit (True) if pbShowHeader is (False)
26382>>>>>>>>>        Property Handle phPrivateDefaultHeaderMenu 0
26383>>>>>>>>>                
26383>>>>>>>>>        Set psJSClass to "df.WebList"
26384>>>>>>>>>        Set Auto_Fill_State to True                 // Indicates that server DDO should find first record in it's dataset (important to set True for constrained child grids such as Order Details, for unconstrained lists it does not matter what the value is).
26385>>>>>>>>>        Set pbShowLabel to False                    // Lists won't have a label by default
26386>>>>>>>>>        Set piColumnSpan to 0                       // Lists will span the whole width by default (0 does this)
26387>>>>>>>>>        Set piHeight to 200
26388>>>>>>>>>    End_Procedure

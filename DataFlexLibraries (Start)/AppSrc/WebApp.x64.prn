22316>>>>>>>>>>>>>>>    //
22316>>>>>>>>>>>>>>>    // Triggered to clear the data between requests. Resets al data stored during a request.
22316>>>>>>>>>>>>>>>    //
22316>>>>>>>>>>>>>>>    Procedure ClearData
22318>>>>>>>>>>>>>>>        tWebChangedProps[] aEmptyChanged
22318>>>>>>>>>>>>>>>        tWebChangedProps[] aEmptyChanged
22319>>>>>>>>>>>>>>>        tWebSyncProps[] aEmptySync
22319>>>>>>>>>>>>>>>        tWebSyncProps[] aEmptySync
22320>>>>>>>>>>>>>>>        tWebCacheAdvProp[] aEmptyAdv
22320>>>>>>>>>>>>>>>        tWebCacheAdvProp[] aEmptyAdv
22321>>>>>>>>>>>>>>>        Handle[] aEmptyHandle
22322>>>>>>>>>>>>>>>        Integer iStoreIndex
22322>>>>>>>>>>>>>>>        
22322>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22323>>>>>>>>>>>>>>>        Move aEmptyChanged to gaSyncChangedProps[iStoreIndex]
22324>>>>>>>>>>>>>>>        Move aEmptySync to gaSyncProps[iStoreIndex]
22325>>>>>>>>>>>>>>>        Move aEmptyAdv to gaAdvSyncProps[iStoreIndex]
22326>>>>>>>>>>>>>>>        Move aEmptyHandle to gaSyncObjectHandles[iStoreIndex]
22327>>>>>>>>>>>>>>>        
22327>>>>>>>>>>>>>>>        Set piSize to 0
22328>>>>>>>>>>>>>>>        Set piCapacity to 0
22329>>>>>>>>>>>>>>>        
22329>>>>>>>>>>>>>>>        Set pbActive to False
22330>>>>>>>>>>>>>>>    End_Procedure
22331>>>>>>>>>>>>>>>    

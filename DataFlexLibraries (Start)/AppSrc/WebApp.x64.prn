37310>>>>>>>    Procedure QueryLocation_Callback String sCallbackMsg String sCallbackObj Integer iErr String sLatitude String sLongitude String sAccuracy String sSpeed String sHeading
37312>>>>>>>        Number nLatitude nLongitude nAccuracy nSpeed nHeading
37312>>>>>>>        Handle hoCallback hmCallback
37312>>>>>>>        
37312>>>>>>>        //  Values are passed in fixed format so convert without localization
37312>>>>>>>        CvtLocalization Off
37313>>>>>>>        Move sLatitude to nLatitude
37314>>>>>>>        Move sLongitude to nLongitude
37315>>>>>>>        Move sAccuracy to nAccuracy
37316>>>>>>>        Move sSpeed to nSpeed
37317>>>>>>>        Move sHeading to nHeading
37318>>>>>>>        CvtLocalization On
37319>>>>>>>        
37319>>>>>>>        Get WebObjectByName sCallbackObj to hoCallback
37320>>>>>>>        If (hoCallback <> C_WebUnresolvedObject) Begin
37322>>>>>>>            Get WebMethodByName of hoCallback sCallbackMsg to hmCallback
37323>>>>>>>            
37323>>>>>>>            If (hmCallback <> C_WebUnresolvedObject) Begin
37325>>>>>>>                Send hmCallback of hoCallback iErr nLatitude nLongitude nAccuracy nSpeed nHeading
37326>>>>>>>            End
37326>>>>>>>>
37326>>>>>>>        End
37326>>>>>>>>
37326>>>>>>>    End_Procedure

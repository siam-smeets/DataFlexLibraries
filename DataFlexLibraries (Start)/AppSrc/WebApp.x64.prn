30405>>>>>>>>>        Property String psSessionCookieName "dfWebApp"      //  Name of the cookie in which the session key is stored
30406>>>>>>>>>        Property Integer piSessionCookieTimeout 0           //  The number hours that the session cookie should be stored (0 for the current browser session)
30407>>>>>>>>>        Property String psSessionCookiePath ""              //  Determines the path for which the session key cookie is set ('/' for entire domain, '' for the current path)
30408>>>>>>>>>        Property String psSessionCookieDomain ""            //  Determines the domain name for which the cookie is set (if the app is running on a subdomain the cookie can be shared accross the entire domain, "" means just for the current domain)
30409>>>>>>>>>        Property Boolean pbSessionCookieSecure False        //  Determines if the session cookie should be set as a secure cookie so that it is only send for HTTPS connections
30410>>>>>>>>>        Property Boolean pbSessionCookieHttpOnly False      //  Determines if the session cookie should be set as HTTP Only cookie so that it is not accessible from JavaScript.
30411>>>>>>>>>        Property String psSessionCookieSameSite "Lax"    //  Determines the samesite attribute of the session cookie.
30412>>>>>>>>>        
30412>>>>>>>>>        
30412>>>>>>>>>        Property Integer piSessionKeyLength 36
30413>>>>>>>>>        
30413>>>>>>>>>        Property Handle phoRandomizer -1

29561>>>>>>>>>>>            If (iOffset < 0) Begin
29563>>>>>>>>>>>                Set piParseErrorCode to 3
29564>>>>>>>>>>>                Set psParseError to "Invalid request format: expected boundary"
29565>>>>>>>>>>>                Function_Return False
29566>>>>>>>>>>>            End
29566>>>>>>>>>>>>
29566>>>>>>>>>>>            
29566>>>>>>>>>>>            
29566>>>>>>>>>>>            //  Find the next boundary

22677>>>>>>>>>>>
22677>>>>>>>>>>>Class cWebViewHost_mixin is a Mixin
22678>>>>>>>>>>>    Procedure Define_cWebViewHost_mixin
22680>>>>>>>>>>>        
22680>>>>>>>>>>>        Property tWebControlMapItem[] paViews          // Collection of all views available within this host
22681>>>>>>>>>>>        
22681>>>>>>>>>>>        Property Handle[] paDDOViews                   // Collection of view object handles referenced in each member of the RequestHeader.aDDOs
22682>>>>>>>>>>>        
22682>>>>>>>>>>>        
22682>>>>>>>>>>>        
22682>>>>>>>>>>>        Property Handle phoLoadView C_WebUnresolvedObject       // handle to view to load during a CallAction to LoadView
22683>>>>>>>>>>>        
22683>>>>>>>>>>>        Property Handle phoLoginView C_WebUnresolvedObject      // handle of login view to load when application is loaded.
22684>>>>>>>>>>>        Property Handle phoDefaultView C_WebUnresolvedObject    // handle of the default view to load when web application is loaded (unless there is a login screen to be shown - see phoLoginView)
22685>>>>>>>>>>>        
22685>>>>>>>>>>>        Property Handle phoCommandBar C_WebUnresolvedObject     // handle to child cWebCommandbar object
22686>>>>>>>>>>>        
22686>>>>>>>>>>>        
22686>>>>>>>>>>>        Property Integer peApplicationStyle wvsDesktop 
22687>>>>>>>>>>>        
22687>>>>>>>>>>>        Property Boolean pbTestSyncDDO False // for testing only (s/b False on release)
22688>>>>>>>>>>>        
22688>>>>>>>>>>>        Property String[] paLoadedViews     // List of all views loaded to the client (used by ShowView to determine if it should go back to the client)
22691>>>>>>>>>>>        
22691>>>>>>>>>>>        Property String psCurrentView ""    // Name of the currently active view
22694>>>>>>>>>>>        Property Handle phoCurrentShowView  C_WebUnresolvedObject // Handle to the view currently being shown (used to check if OnNavigateForward calls another view during show
22695>>>>>>>>>>>        
22695>>>>>>>>>>>        
22695>>>>>>>>>>>        Property String psApplicationTitle "DataFlex WebApp"        // The title shown in the browser title bar
22698>>>>>>>>>>>        Property Boolean pbUpdateApplicationTitle True              // If true the title in the title bar is automatically updated
22701>>>>>>>>>>>        
22701>>>>>>>>>>>        // When set to True all views will show an unhandled error when a refind record
22701>>>>>>>>>>>        // fails (usually some kind of FindByRowIdEx call). Normally this is False because
22701>>>>>>>>>>>        // refinds can fail in a multi-user environment and the framework will handle this
22701>>>>>>>>>>>        // as best it can. However, refind errors can also be caused by a programming error.
22701>>>>>>>>>>>        // If you set this true during debugging you will be notified of refind errors that
22701>>>>>>>>>>>        // may be a programming bug. This can work well because the multi-user can't refind
22701>>>>>>>>>>>        // error usually does not occur while debugging. If you set this True while testing,
22701>>>>>>>>>>>        // remember to set it back to False when deploying.  
22701>>>>>>>>>>>        Property Boolean pbShowAllRefindErrors False
22702>>>>>>>>>>>    End_Procedure
22703>>>>>>>>>>>    
22703>>>>>>>>>>>    // An object is only in-scope during a WebApp CallAction in the following cases:
22703>>>>>>>>>>>    // - It is a Global Object: cWebApp or its child objects (but not a cWebWindow child).
22703>>>>>>>>>>>    // - It is part of the stack of views\dialog in the cWebApp's paDDOViews property.
22703>>>>>>>>>>>    // - During a call to LoadView, it is part of the view being loaded.
22703>>>>>>>>>>>    Function OwnerIsInCallActionScope Handle hoWO Returns Boolean
22705>>>>>>>>>>>        Integer iViewIndex
22705>>>>>>>>>>>        Handle hoWebNeighborhood hoLoadView
22705>>>>>>>>>>>        Handle[] aDDOViews
22706>>>>>>>>>>>        
22706>>>>>>>>>>>        Get phoWebNeighborhood of hoWO to hoWebNeighborhood    // This property is set during object creation
22707>>>>>>>>>>>        
22707>>>>>>>>>>>        // Test if the neighborhood property is actually correctly set.
22707>>>>>>>>>>>        If (hoWebNeighborhood = C_WebUnresolvedObject) Begin
22709>>>>>>>>>>>            Function_Return False
22710>>>>>>>>>>>        End
22710>>>>>>>>>>>>
22710>>>>>>>>>>>        
22710>>>>>>>>>>>        // is this in the cWebApp Neighborhood?
22710>>>>>>>>>>>        If (hoWebNeighborhood = Self) Begin
22712>>>>>>>>>>>            Function_Return True
22713>>>>>>>>>>>        End
22713>>>>>>>>>>>>
22713>>>>>>>>>>>        
22713>>>>>>>>>>>        // is this a View that is being loaded?
22713>>>>>>>>>>>        Get phoLoadView to hoLoadView
22714>>>>>>>>>>>        If (hoWebNeighborhood = hoLoadView) Begin
22716>>>>>>>>>>>            Function_Return True
22717>>>>>>>>>>>        End
22717>>>>>>>>>>>>
22717>>>>>>>>>>>        
22717>>>>>>>>>>>        // is this in the neighborhood of one of the focus windows?
22717>>>>>>>>>>>        Get paDDOViews to aDDOViews     // This property is set during CallAction
22718>>>>>>>>>>>        Move (SearchArray(hoWebNeighborhood, aDDOViews)) to iViewIndex
22719>>>>>>>>>>>        Function_Return (iViewIndex <> -1)
22720>>>>>>>>>>>    End_Function
22721>>>>>>>>>>>    
22721>>>>>>>>>>>    Procedure OwnerRegisterView Handle hoView
22723>>>>>>>>>>>        tWebControlMapItem new
22723>>>>>>>>>>>        tWebControlMapItem new
22723>>>>>>>>>>>        tWebControlMapItem[] aViews
22723>>>>>>>>>>>        tWebControlMapItem[] aViews
22724>>>>>>>>>>>        
22724>>>>>>>>>>>        Get paViews to aViews
22725>>>>>>>>>>>        
22725>>>>>>>>>>>        Move hoView to new.hoObj
22726>>>>>>>>>>>        Move (Uppercase(Name(hoView))) to new.sName
22727>>>>>>>>>>>        
22727>>>>>>>>>>>        If (BinarySearchArray(new, aViews, False) = -1) Begin
22729>>>>>>>>>>>            Move (InsertInArray(aViews, BinarySearchInsertPos(), new)) to aViews
22730>>>>>>>>>>>            Set paViews to aViews
22731>>>>>>>>>>>        End
22731>>>>>>>>>>>>
22731>>>>>>>>>>>        Else Begin
22732>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat("View with name '%1' already registered.", new.sName))
22733>>>>>>>>>>>>
22733>>>>>>>>>>>        End
22733>>>>>>>>>>>>
22733>>>>>>>>>>>    End_Function
22734>>>>>>>>>>>    
22734>>>>>>>>>>>    Function FindView String sViewName Boolean bSilent Returns Handle
22736>>>>>>>>>>>        tWebControlMapItem[] aViews
22736>>>>>>>>>>>        tWebControlMapItem[] aViews
22737>>>>>>>>>>>        tWebControlMapItem search
22737>>>>>>>>>>>        tWebControlMapItem search
22737>>>>>>>>>>>        Integer iPos
22737>>>>>>>>>>>        
22737>>>>>>>>>>>        Get paViews to aViews
22738>>>>>>>>>>>        Move (Uppercase(Trim(sViewName))) to search.sName
22739>>>>>>>>>>>        Move (BinarySearchArray(search, aViews, False)) to iPos
22740>>>>>>>>>>>        
22740>>>>>>>>>>>        If (iPos <> -1) Begin
22742>>>>>>>>>>>            Function_Return aViews[iPos].hoObj
22743>>>>>>>>>>>        End
22743>>>>>>>>>>>>
22743>>>>>>>>>>>        
22743>>>>>>>>>>>        If (not(bSilent)) Begin
22745>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, sViewName))
22746>>>>>>>>>>>>
22746>>>>>>>>>>>        End
22746>>>>>>>>>>>>
22746>>>>>>>>>>>        
22746>>>>>>>>>>>        Function_Return C_WebUnresolvedObject
22747>>>>>>>>>>>    End_Function
22748>>>>>>>>>>>    
22748>>>>>>>>>>>    Function OwnerActionState Handle hoWO Returns Integer
22750>>>>>>>>>>>        Handle hoLoadView hoNeigborhood
22750>>>>>>>>>>>        
22750>>>>>>>>>>>        Get phoLoadView to hoLoadView
22751>>>>>>>>>>>        Get phoWebNeighborhood to hoNeigborhood
22752>>>>>>>>>>>        
22752>>>>>>>>>>>        If (hoLoadView <> C_WebUnresolvedObject and hoLoadView = hoNeigborhood) Begin
22754>>>>>>>>>>>            Function_Return ctExecViewLoad
22755>>>>>>>>>>>        End
22755>>>>>>>>>>>>
22755>>>>>>>>>>>        
22755>>>>>>>>>>>        Function_Return ctExecDefault    //  Execute as a default client action (after synchronization of web properties)
22756>>>>>>>>>>>    End_Function
22757>>>>>>>>>>>    
22757>>>>>>>>>>>    // Called by LoadWebApp to load the initial view
22757>>>>>>>>>>>    Procedure Load_InitialView
22759>>>>>>>>>>>        Handle hoView
22759>>>>>>>>>>>        String sStateHash
22759>>>>>>>>>>>        Integer eAppStyle
22759>>>>>>>>>>>        String[] aLoadedViews
22760>>>>>>>>>>>        
22760>>>>>>>>>>>        WebGet paLoadedViews to aLoadedViews
22761>>>>>>>>>>>        If (SizeOfArray(aLoadedViews) > 0) ;            Procedure_Return
22764>>>>>>>>>>>        
22764>>>>>>>>>>>        //  Get forced initial view (login dialog or so)
22764>>>>>>>>>>>        Get ForcedInitialView to hoView
22765>>>>>>>>>>>        
22765>>>>>>>>>>>        //  Set initial page title (a login dialog might not set one)
22765>>>>>>>>>>>        Send UpdatePageTitle C_WebUnresolvedObject ""
22766>>>>>>>>>>>        
22766>>>>>>>>>>>        //  Send back default view unless a login dialog needs to be sent
22766>>>>>>>>>>>        If (hoView = C_WebUnresolvedObject) Begin
22768>>>>>>>>>>>            //  Restore application state
22768>>>>>>>>>>>            If (peApplicationStateMode(Self) <> asmOff) Begin
22770>>>>>>>>>>>                Get StateHash to sStateHash 
22771>>>>>>>>>>>                Send RestoreState sStateHash True
22772>>>>>>>>>>>            End
22772>>>>>>>>>>>>
22772>>>>>>>>>>>            Else Begin //  Or return default view
22773>>>>>>>>>>>                Get GetDefaultView to hoView
22774>>>>>>>>>>>                If (hoView > 0) Begin
22776>>>>>>>>>>>                    Send Show of hoView
22777>>>>>>>>>>>                End
22777>>>>>>>>>>>>
22777>>>>>>>>>>>            End
22777>>>>>>>>>>>>
22777>>>>>>>>>>>        End
22777>>>>>>>>>>>>
22777>>>>>>>>>>>        Else Begin
22778>>>>>>>>>>>            Get peApplicationStyle to eAppStyle
22779>>>>>>>>>>>            If (eAppStyle = wvsDrillDown) Begin
22781>>>>>>>>>>>               Send NavigateBegin of hoView Self True 
22782>>>>>>>>>>>            End
22782>>>>>>>>>>>>
22782>>>>>>>>>>>            Else Begin
22783>>>>>>>>>>>                Send Show of hoView    
22784>>>>>>>>>>>            End
22784>>>>>>>>>>>>
22784>>>>>>>>>>>        End
22784>>>>>>>>>>>>
22784>>>>>>>>>>>    End_Procedure
22785>>>>>>>>>>>    
22785>>>>>>>>>>>    Function ViewAccessDenied Handle hoView Boolean bRestoreState Returns Boolean
22787>>>>>>>>>>>        tOnViewAccessDenied deniedDetails
22787>>>>>>>>>>>        tOnViewAccessDenied deniedDetails
22787>>>>>>>>>>>        Integer eAppStyle
22787>>>>>>>>>>>        
22787>>>>>>>>>>>        Move hoView to deniedDetails.hoView
22788>>>>>>>>>>>        Move bRestoreState to deniedDetails.bRestoreState
22789>>>>>>>>>>>        Move False to deniedDetails.bHandled
22790>>>>>>>>>>>        Move C_WebUnresolvedObject to deniedDetails.hoNavigateToView
22791>>>>>>>>>>>        
22791>>>>>>>>>>>        Send OnViewAccessDenied (&deniedDetails)
22792>>>>>>>>>>>        If (deniedDetails.bHandled) ;            Function_Return True
22795>>>>>>>>>>>        
22795>>>>>>>>>>>        If (deniedDetails.hoNavigateToView <> C_WebUnresolvedObject) Begin
22797>>>>>>>>>>>            Get peApplicationStyle to eAppStyle
22798>>>>>>>>>>>            If (eAppStyle = wvsDrillDown) Begin
22800>>>>>>>>>>>                Send NavigatePathBegin deniedDetails.hoNavigateToView True
22801>>>>>>>>>>>            End
22801>>>>>>>>>>>>
22801>>>>>>>>>>>            Else Begin
22802>>>>>>>>>>>                Send Show of deniedDetails.hoNavigateToView    
22803>>>>>>>>>>>            End 
22803>>>>>>>>>>>>
22803>>>>>>>>>>>            Function_Return True
22804>>>>>>>>>>>        End
22804>>>>>>>>>>>>
22804>>>>>>>>>>>        
22804>>>>>>>>>>>        Function_Return False
22805>>>>>>>>>>>    End_Function
22806>>>>>>>>>>>    
22806>>>>>>>>>>>    // Event that is fired when the user tries to navigate into a view or dialog and access is denied. Implement this 
22806>>>>>>>>>>>    // procedure to customize behavior (for example show a login view). By default triggers the Access Denied error.
22806>>>>>>>>>>>    Procedure OnViewAccessDenied tOnViewAccessDenied ByRef details
22808>>>>>>>>>>>        Error DFERR_WEBAPP_ACCESS_DENIED
22809>>>>>>>>>>>>
22809>>>>>>>>>>>    End_Procedure
22810>>>>>>>>>>>
22810>>>>>>>>>>>
22810>>>>>>>>>>>    // Client Action: Sends hideView to the client to hide the passed view. A hidden view can be re-shown without making
22810>>>>>>>>>>>    // a server call (see ShowView). Note, a hidden view and it's data is still present on the client. 
22810>>>>>>>>>>>    // If access to a view is to be securely restricted Use CloseView instead.
22810>>>>>>>>>>>    // See also "Hide" method of cWebView.
22810>>>>>>>>>>>    // See also "ShowView" 
22810>>>>>>>>>>>    Procedure HideView Handle hoView
22812>>>>>>>>>>>        String sView sCurrent sInvoking
22812>>>>>>>>>>>        String[] aParams
22813>>>>>>>>>>>
22813>>>>>>>>>>>        Get Object_Label of hoView to sView
22814>>>>>>>>>>>        
22814>>>>>>>>>>>        WebGet psCurrentView to sCurrent
22815>>>>>>>>>>>        If (sView = sCurrent) Begin
22817>>>>>>>>>>>            WebGet psInvokingView of hoView to sInvoking
22818>>>>>>>>>>>            WebSet psCurrentView to sInvoking
22819>>>>>>>>>>>        End
22819>>>>>>>>>>>>
22819>>>>>>>>>>>        
22819>>>>>>>>>>>        Move sView to aParams[0]       // Pass the view name as the 1st parameter.
22820>>>>>>>>>>>        Move False to aParams[1]       // We do want to send OnHide if needed
22821>>>>>>>>>>>        Send ClientAction "hideView" aParams 
22822>>>>>>>>>>>    End_Procedure
22823>>>>>>>>>>>    
22823>>>>>>>>>>>    
22823>>>>>>>>>>>    //  Determines if a view loaded on the client by looking at paLoadedViews.
22823>>>>>>>>>>>    //
22823>>>>>>>>>>>    //  hoView      - Handle to the view object.
22823>>>>>>>>>>>    //  Returns true if the view is available on the client.
22823>>>>>>>>>>>    Function IsViewLoaded Handle hoView Returns Boolean
22825>>>>>>>>>>>        String [] aLoadedViews
22826>>>>>>>>>>>        String sView
22826>>>>>>>>>>>        
22826>>>>>>>>>>>        Get WebObjectName of hoView to sView
22827>>>>>>>>>>>        WebGet paLoadedViews to aLoadedViews
22828>>>>>>>>>>>        
22828>>>>>>>>>>>        Function_Return (SearchArray(UpperCase(sView), aLoadedViews) >= 0)
22829>>>>>>>>>>>    End_Function
22830>>>>>>>>>>>    
22830>>>>>>>>>>>    
22830>>>>>>>>>>>    //  Determines if a view is in sync using IsInCallActionScope.
22830>>>>>>>>>>>    //
22830>>>>>>>>>>>    //  hoView      - Handle to the view object.
22830>>>>>>>>>>>    //  Returns true if the view is currently in sync.
22830>>>>>>>>>>>    Function IsViewInSync Handle hoView Returns Boolean
22832>>>>>>>>>>>        Boolean bResult
22832>>>>>>>>>>>        
22832>>>>>>>>>>>        Get IsInCallActionScope of hoView to bResult
22833>>>>>>>>>>>        
22833>>>>>>>>>>>        Function_Return bResult
22834>>>>>>>>>>>    End_Function
22835>>>>>>>>>>>    
22835>>>>>>>>>>>    //  Determines the currently shown view.
22835>>>>>>>>>>>    //
22835>>>>>>>>>>>    //  Returns a handle to the currently shown view.
22835>>>>>>>>>>>    Function CurrentView Returns Handle
22837>>>>>>>>>>>        String sView
22837>>>>>>>>>>>        Handle hoView
22837>>>>>>>>>>>        
22837>>>>>>>>>>>        Move C_WebUnresolvedObject to hoView
22838>>>>>>>>>>>        
22838>>>>>>>>>>>        WebGet psCurrentView to sView
22839>>>>>>>>>>>        If (sView <> "") Begin
22841>>>>>>>>>>>            Get WebObjectByName sView to hoView
22842>>>>>>>>>>>        End
22842>>>>>>>>>>>>
22842>>>>>>>>>>>        
22842>>>>>>>>>>>        Function_Return hoView
22843>>>>>>>>>>>    End_Function
22844>>>>>>>>>>>    
22844>>>>>>>>>>>    // Server-Action
22844>>>>>>>>>>>    //
22844>>>>>>>>>>>    // Part of the CallAction interface. Used to return a view's object definition to the client.
22844>>>>>>>>>>>    // Returns a structure of objects and properties for nested DDO and cWebObjects
22844>>>>>>>>>>>    // These are returned to the client as serialized JSON.
22844>>>>>>>>>>>    // sViewName     - Is the name of the view to be loaded
22844>>>>>>>>>>>    // sInvokingView - Is the name of the view that triggered the LoadView call. This is mostly used
22844>>>>>>>>>>>    //                 in the cWebDialog class when activating a modal dialog.
22844>>>>>>>>>>>    Function LoadView String sViewName String sInvokingView Returns Boolean
22846>>>>>>>>>>>        Handle hoView
22846>>>>>>>>>>>        Handle[] aDDOViews
22847>>>>>>>>>>>        String[] aLoadedViews asParams
22849>>>>>>>>>>>        Boolean bAllowAccess bLoaded bHandled
22849>>>>>>>>>>>        Handle hjObjectDef
22849>>>>>>>>>>>        tWebDDODef DDODef
22849>>>>>>>>>>>        tWebDDODef DDODef
22849>>>>>>>>>>>        String sPreLoad
22849>>>>>>>>>>>
22849>>>>>>>>>>>        // Get a handle to the view we are loading....
22849>>>>>>>>>>>        Get GetAjaxWebAppView of (phoWebControlLocator(Self)) sViewName to hoView
22850>>>>>>>>>>>        
22850>>>>>>>>>>>        If (hoView <> C_WebUnresolvedObject) Begin
22852>>>>>>>>>>>            
22852>>>>>>>>>>>            // Set up the web properties system to allow WebGet to access this view....
22852>>>>>>>>>>>            Set phoLoadView to hoView
22853>>>>>>>>>>>            Send ProcessLoadViewClientSyncProps hoView
22854>>>>>>>>>>>            
22854>>>>>>>>>>>            // Test AllowViewAcess here because this explicitly tests access to the view we are loading.
22854>>>>>>>>>>>            // That is not the case when testing AllowViewAccess from CallAction. In CallAction we only
22854>>>>>>>>>>>            // test AllowViewAccess of the view that is processing the call (this might be different).
22854>>>>>>>>>>>            Get AllowViewAccess hoView to bAllowAccess
22855>>>>>>>>>>>    
22855>>>>>>>>>>>            If (bAllowAccess) Begin
22857>>>>>>>>>>>                // Add to the list of views to synchronize back to the client....
22857>>>>>>>>>>>                Get paDDOViews to aDDOViews
22858>>>>>>>>>>>                If (SearchArray(hoView, aDDOViews) < 0) Begin
22860>>>>>>>>>>>                    Move hoView to aDDOViews[SizeOfArray(aDDOViews)]
22861>>>>>>>>>>>                End
22861>>>>>>>>>>>>
22861>>>>>>>>>>>                Set paDDOViews to aDDOViews
22862>>>>>>>>>>>
22862>>>>>>>>>>>                //  Perform initialization (clear, set constraints)
22862>>>>>>>>>>>                Send InitForShow of hoView                    
22863>>>>>>>>>>>                
22863>>>>>>>>>>>                // we want view sync before OnLoad
22863>>>>>>>>>>>                Send NotifySyncWebApp of hoView
22864>>>>>>>>>>>                    
22864>>>>>>>>>>>                // Serialize the view to JSON....
22864>>>>>>>>>>>                Get SerializeObject of hoView to hjObjectDef
22865>>>>>>>>>>>                Send ClientActionEarly "createView" asParams hjObjectDef    
22866>>>>>>>>>>>                Send Destroy of hjObjectDef           
22867>>>>>>>>>>>
22867>>>>>>>>>>>                // Set the psInvokingView web property. We need this to be set already during LoadView
22867>>>>>>>>>>>                // if we are loading a Modal Dialog...
22867>>>>>>>>>>>                //WebSet psInvokingView of hoView to sInvokingView
22867>>>>>>>>>>>                Send InitInvokingView to hoView sInvokingView
22868>>>>>>>>>>>                
22868>>>>>>>>>>>                Set phoLoadView to C_WebUnresolvedObject
22869>>>>>>>>>>>                
22869>>>>>>>>>>>                //  Mark view as loaded
22869>>>>>>>>>>>                WebGet paLoadedViews to aLoadedViews
22870>>>>>>>>>>>                If (SearchArray(Uppercase(sViewName), aLoadedViews) = -1) Begin
22872>>>>>>>>>>>                    Move (Uppercase(sViewName)) to aLoadedViews[SizeOfArray(aLoadedViews)]
22873>>>>>>>>>>>                    WebSet paLoadedViews to aLoadedViews
22874>>>>>>>>>>>                End            
22874>>>>>>>>>>>>
22874>>>>>>>>>>>                
22874>>>>>>>>>>>                Function_Return True
22875>>>>>>>>>>>            End
22875>>>>>>>>>>>>
22875>>>>>>>>>>>            Else Begin
22876>>>>>>>>>>>                Get ViewAccessDenied hoView False to bHandled
22877>>>>>>>>>>>            End
22877>>>>>>>>>>>>
22877>>>>>>>>>>>        End
22877>>>>>>>>>>>>
22877>>>>>>>>>>>        
22877>>>>>>>>>>>        Function_Return False
22878>>>>>>>>>>>    End_Function
22879>>>>>>>>>>>    
22879>>>>>>>>>>>    //  Loads and initializes a view asynchronously (the loading is done via a separate round-trip).
22879>>>>>>>>>>>    //  This is used for performance reasons when restoring the application state from a URL path.
22879>>>>>>>>>>>    //
22879>>>>>>>>>>>    //  Note: Should only be used when the view is not loaded to the client!!
22879>>>>>>>>>>>    //  
22879>>>>>>>>>>>    //  - hoView        Handle to the view.
22879>>>>>>>>>>>    Procedure DelayLoadview Handle hoView
22881>>>>>>>>>>>        String[] aParams
22882>>>>>>>>>>>        Handle[] aDDOViews
22883>>>>>>>>>>>        
22883>>>>>>>>>>>        // Add to the list of views to synchronize back to the client....
22883>>>>>>>>>>>        Get paDDOViews to aDDOViews
22884>>>>>>>>>>>        If (SearchArray(hoView, aDDOViews) < 0) Begin
22886>>>>>>>>>>>            Move hoView to aDDOViews[SizeOfArray(aDDOViews)]
22887>>>>>>>>>>>        End
22887>>>>>>>>>>>>
22887>>>>>>>>>>>        Set paDDOViews to aDDOViews
22888>>>>>>>>>>>
22888>>>>>>>>>>>        //  Add load view client action
22888>>>>>>>>>>>        Get WebObjectName of hoView to aParams[0]
22889>>>>>>>>>>>        Move 1 to aParams[1]
22890>>>>>>>>>>>        Send ClientAction "loadView" aParams
22891>>>>>>>>>>>        
22891>>>>>>>>>>>        //  Initialize view
22891>>>>>>>>>>>        Send InitForShow of hoView
22892>>>>>>>>>>>        WebSet pbPreLoaded of hoView to True
22894>>>>>>>>>>>
22894>>>>>>>>>>>        //  We want view sync before OnLoad
22894>>>>>>>>>>>        Send NotifySyncWebApp of hoView
22895>>>>>>>>>>>        
22895>>>>>>>>>>>
22895>>>>>>>>>>>    End_Procedure
22896>>>>>>>>>>>      
22896>>>>>>>>>>>    
22896>>>>>>>>>>>    //  Shows a view and loads it (if nessecary). If a view is loaded and synchronized it will be 
22896>>>>>>>>>>>    //  shown directly (when returned to the client) and processing can continue. If a view is 
22896>>>>>>>>>>>    //  loaded to the client but not synchronized it depends on pbOverrideStateOnShow what happens.
22896>>>>>>>>>>>    //  If pbOverrideStateOnShow is false it will go back to the client before it continues and this 
22896>>>>>>>>>>>    //  makes the message asynchronous. If pbOverridestateOnShow is true it will continue and 
22896>>>>>>>>>>>    //  instruct the client to reinitialize the view before rendering it. If the view is not loaded
22896>>>>>>>>>>>    //  it will load the view (add the definitions to the response) and show it directly. The
22896>>>>>>>>>>>    //  optional handler message needs to be published and the object needs to be a web object.
22896>>>>>>>>>>>    //
22896>>>>>>>>>>>    //  - hoView                Handle of the view to be shown.
22896>>>>>>>>>>>    //  - hmOptCallBackMsg      (optional) Callback message executed when the view is initialized.
22896>>>>>>>>>>>    //  - hoOptCallbackObj      (optional) Object to which the callback message should be sent.
22896>>>>>>>>>>>    Procedure ShowView Handle hoView Handle hmOptCallbackMsg Handle hoOptCallbackObj
22898>>>>>>>>>>>        Boolean bIsLoaded bInSync bAllowAccess bShowDirect
22898>>>>>>>>>>>        String sView
22898>>>>>>>>>>>        String[] aParams
22899>>>>>>>>>>>        tWebClientAction tClientAction
22899>>>>>>>>>>>        tWebClientAction tClientAction
22899>>>>>>>>>>>        tWebClientAction[] aClientActions
22899>>>>>>>>>>>        tWebClientAction[] aClientActions
22900>>>>>>>>>>>        Handle hmCallbackMsg hoCallbackObj
22900>>>>>>>>>>>        Boolean bHandled
22900>>>>>>>>>>>        
22900>>>>>>>>>>>        If (num_arguments > 2) Begin
22902>>>>>>>>>>>            Move hmOptCallbackMsg to hmCallbackMsg
22903>>>>>>>>>>>            Move hoOptCallbackObj to hoCallbackObj
22904>>>>>>>>>>>        End
22904>>>>>>>>>>>>
22904>>>>>>>>>>>        
22904>>>>>>>>>>>        Move False to bShowDirect
22905>>>>>>>>>>>        
22905>>>>>>>>>>>        Get WebObjectName of hoView to sView
22906>>>>>>>>>>>                
22906>>>>>>>>>>>        // Test AllowViewAcess here because this explicitly tests access to the view we are loading.
22906>>>>>>>>>>>        // That is not the case when testing AllowViewAccess from CallAction. In CallAction we only
22906>>>>>>>>>>>        // test AllowViewAccess of the view that is processing the call (this might be different).
22906>>>>>>>>>>>        Get AllowViewAccess hoView to bAllowAccess
22907>>>>>>>>>>>        If (not(bAllowAccess)) Begin
22909>>>>>>>>>>>            Get ViewAccessDenied hoView False to bHandled
22910>>>>>>>>>>>            Procedure_Return
22911>>>>>>>>>>>        End
22911>>>>>>>>>>>>
22911>>>>>>>>>>>        
22911>>>>>>>>>>>        Set phoCurrentShowView to hoView    // Property used to check if no other ShowView is called meanwhile (check is in ShowView_Exec)
22912>>>>>>>>>>>        Get IsViewLoaded hoView to bIsLoaded
22913>>>>>>>>>>>        If (not(bIsLoaded)) Begin
22915>>>>>>>>>>>            //  If the view is not loaded we load it now
22915>>>>>>>>>>>            Get LoadView sView 0 to bIsLoaded
22916>>>>>>>>>>>            If (bIsLoaded) Begin
22918>>>>>>>>>>>                Move True to bShowDirect
22919>>>>>>>>>>>            End
22919>>>>>>>>>>>>
22919>>>>>>>>>>>        End
22919>>>>>>>>>>>>
22919>>>>>>>>>>>        Else Begin
22920>>>>>>>>>>>            Get IsViewInSync hoView to bInSync
22921>>>>>>>>>>>            If (bInSync) Begin
22923>>>>>>>>>>>                Move True to bShowDirect
22924>>>>>>>>>>>            End
22924>>>>>>>>>>>>
22924>>>>>>>>>>>            Else Begin
22925>>>>>>>>>>>                If (pbOverrideStateOnShow(hoView)) Begin
22927>>>>>>>>>>>                    //  If pbOverrideStateOnShow is true we can override it by unloading it on the client and simply loading it fresh (we used to do sneaky things here before 20.0)
22927>>>>>>>>>>>                    
22927>>>>>>>>>>>                    //  Add an early executed action to unload the view
22927>>>>>>>>>>>                    Move "unloadView"   to tClientAction.sName
22928>>>>>>>>>>>                    Move ""             to tClientAction.sTarget
22929>>>>>>>>>>>                    Move ctExecEarly    to tClientAction.eType
22930>>>>>>>>>>>                    Move sView          to tClientAction.aParams[0]
22931>>>>>>>>>>>                    
22931>>>>>>>>>>>                    Get paClientActions to aClientActions
22932>>>>>>>>>>>                    Move tClientAction to aClientActions[SizeOfArray(aClientActions)]
22933>>>>>>>>>>>                    Set paClientActions to aClientActions
22934>>>>>>>>>>>                    
22934>>>>>>>>>>>                    //  Load the view fresh and show when succesfull
22934>>>>>>>>>>>                    Get LoadView sView 0 to bIsLoaded
22935>>>>>>>>>>>                    If (bIsLoaded) Begin
22937>>>>>>>>>>>                        Move True to bShowDirect
22938>>>>>>>>>>>                    End
22938>>>>>>>>>>>>
22938>>>>>>>>>>>                End
22938>>>>>>>>>>>>
22938>>>>>>>>>>>                Else Begin
22939>>>>>>>>>>>                    //  We need to go to the client first
22939>>>>>>>>>>>                    Move sView to aParams[0]
22940>>>>>>>>>>>                    
22940>>>>>>>>>>>                    If (hmCallbackMsg > 0) Begin
22942>>>>>>>>>>>                        Get WebMethodName of hoCallbackObj hmCallbackMsg to aParams[1]
22943>>>>>>>>>>>                        Get WebObjectName of hoCallbackObj to aParams[2]
22944>>>>>>>>>>>                    End
22944>>>>>>>>>>>>
22944>>>>>>>>>>>                    
22944>>>>>>>>>>>                    Send ClientAction "showView" aParams
22945>>>>>>>>>>>                End
22945>>>>>>>>>>>>
22945>>>>>>>>>>>            End
22945>>>>>>>>>>>>
22945>>>>>>>>>>>        End
22945>>>>>>>>>>>>
22945>>>>>>>>>>>        
22945>>>>>>>>>>>        If (bShowDirect) Begin
22947>>>>>>>>>>>            // Do callback
22947>>>>>>>>>>>            If (hmCallbackMsg > 0) Begin
22949>>>>>>>>>>>                Send hmCallbackMsg of hoCallbackObj hoView
22950>>>>>>>>>>>            End
22950>>>>>>>>>>>>
22950>>>>>>>>>>>            
22950>>>>>>>>>>>            // Directly show the view
22950>>>>>>>>>>>            Send ShowView_Exec hoView False
22951>>>>>>>>>>>        End    
22951>>>>>>>>>>>>
22951>>>>>>>>>>>    End_Procedure
22952>>>>>>>>>>>    
22952>>>>>>>>>>>    
22952>>>>>>>>>>>    //  Actually shows the view by sending doShow and performing the renderView client action.
22952>>>>>>>>>>>    //
22952>>>>>>>>>>>    //  - hoView        Handle of the view object to the be shown.
22952>>>>>>>>>>>    //  - bStandalone   If true this is a standalone view (oWebApp.displayView(..)) and not 
22952>>>>>>>>>>>    //                  rendered by renderview.
22952>>>>>>>>>>>    Procedure ShowView_Exec Handle hoView Boolean bStandalone
22954>>>>>>>>>>>        String[] aParams
22955>>>>>>>>>>>        String sView
22955>>>>>>>>>>>        Handle hoInvokingView
22955>>>>>>>>>>>        
22955>>>>>>>>>>>        //  Check if the showview is not overriden by a different ShowView call inside OnNavigateForward, phoCurrentShowView should be set before this function is called
22955>>>>>>>>>>>        If (phoCurrentShowView(Self) = hoView or (phoCurrentShowView(Self) <> C_WebUnresolvedObject and IsDialog(phoCurrentShowView(Self)))) Begin
22957>>>>>>>>>>>            Send DoShow of hoView
22958>>>>>>>>>>>            Get WebObjectName of hoView to sView
22959>>>>>>>>>>>            
22959>>>>>>>>>>>            WebSet psCurrentView to sView
22960>>>>>>>>>>>            
22960>>>>>>>>>>>            If (not(bStandalone)) Begin
22962>>>>>>>>>>>                Move sView to aParams[0]
22963>>>>>>>>>>>                Send ClientAction "renderView" aParams
22964>>>>>>>>>>>            End
22964>>>>>>>>>>>>
22964>>>>>>>>>>>            
22964>>>>>>>>>>>            Set phoCurrentShowView to C_WebUnresolvedObject
22965>>>>>>>>>>>        End
22965>>>>>>>>>>>>
22965>>>>>>>>>>>    End_Procedure
22966>>>>>>>>>>>    
22966>>>>>>>>>>>    
22966>>>>>>>>>>>    //  Server-Action
22966>>>>>>>>>>>    //
22966>>>>>>>>>>>    //  Called by the JavaScript Engine to show a view. This can either be initiated by the server 
22966>>>>>>>>>>>    //  via ShowView (view was loaded to the client but not in sync) or be initiated from the 
22966>>>>>>>>>>>    //  client like with cWebMenuItemLoadView.
22966>>>>>>>>>>>    //
22966>>>>>>>>>>>    //  - sView         Name of the view.
22966>>>>>>>>>>>    //  - bStandalone   True if the view is shown separately (oWebApp.displayView).
22966>>>>>>>>>>>    //  - sOptCallbackMsg   (optional) String with the published procedure that needs to be called 
22966>>>>>>>>>>>    //                      when the view is initialized.
22966>>>>>>>>>>>    //  - sOptCallback      (optional) Name of the web object handling the callback message.
22966>>>>>>>>>>>    Procedure ShowView_FromClient String sView Boolean bStandalone String sOptCallbackMsg String sOptCallbackObj
22968>>>>>>>>>>>        Handle hoView hmCallbackMsg hoCallbackObj
22968>>>>>>>>>>>        Boolean bIsLoaded bInSync
22968>>>>>>>>>>>        
22968>>>>>>>>>>>        If (num_arguments > 3) Begin
22970>>>>>>>>>>>            Get WebObjectByName sOptCallbackObj to hoCallbackObj
22971>>>>>>>>>>>            If (hoCallbackObj > 0) Begin
22973>>>>>>>>>>>                Get WebMethodByName of hoCallbackObj sOptCallbackMsg to hmCallbackMsg
22974>>>>>>>>>>>            End
22974>>>>>>>>>>>>
22974>>>>>>>>>>>        End
22974>>>>>>>>>>>>
22974>>>>>>>>>>>        
22974>>>>>>>>>>>        Get WebObjectByName sView to hoView
22975>>>>>>>>>>>        Get IsViewLoaded hoView to bIsLoaded
22976>>>>>>>>>>>        Set phoCurrentShowView to hoView    // Property used to check if no other ShowView is called meanwhile (check is in ShowView_Exec)
22977>>>>>>>>>>>        
22977>>>>>>>>>>>        If (not(bIsLoaded)) Begin
22979>>>>>>>>>>>            Get LoadView sView 0 to bIsLoaded
22980>>>>>>>>>>>            If (bIsLoaded) Begin
22982>>>>>>>>>>>                
22982>>>>>>>>>>>                // Do callback
22982>>>>>>>>>>>                If (hmCallbackMsg > 0) Begin
22984>>>>>>>>>>>                    Send hmCallbackMsg of hoCallbackObj hoView
22985>>>>>>>>>>>                End
22985>>>>>>>>>>>>
22985>>>>>>>>>>>                
22985>>>>>>>>>>>                Send ShowView_Exec hoView bStandalone
22986>>>>>>>>>>>            End
22986>>>>>>>>>>>>
22986>>>>>>>>>>>        End
22986>>>>>>>>>>>>
22986>>>>>>>>>>>        Else Begin
22987>>>>>>>>>>>            Get IsViewInSync hoView to bInSync
22988>>>>>>>>>>>            If (bInSync) Begin
22990>>>>>>>>>>>                // Do callback
22990>>>>>>>>>>>                If (hmCallbackMsg > 0) Begin
22992>>>>>>>>>>>                    Send hmCallbackMsg of hoCallbackObj hoView
22993>>>>>>>>>>>                End
22993>>>>>>>>>>>>
22993>>>>>>>>>>>                
22993>>>>>>>>>>>                Send ShowView_Exec hoView bStandalone
22994>>>>>>>>>>>            End
22994>>>>>>>>>>>>
22994>>>>>>>>>>>            Else Begin
22995>>>>>>>>>>>                Error DFERR_OPERATOR "ShowView_FromClient requires view to be synchronized if loaded."
22996>>>>>>>>>>>>
22996>>>>>>>>>>>            End
22996>>>>>>>>>>>>
22996>>>>>>>>>>>        End
22996>>>>>>>>>>>>
22996>>>>>>>>>>>    End_Procedure
22997>>>>>>>>>>>    
22997>>>>>>>>>>>    
22997>>>>>>>>>>>    // Client Action: Sends unloadView to the client to remove the passed view and its web properties.
22997>>>>>>>>>>>    // An Unloaded view must be reloaded from the server before it can be displayed again (using LoadView). 
22997>>>>>>>>>>>    // Note, unloading a view is more secure than hiding it because its data is removed from the client.
22997>>>>>>>>>>>    // See also "Unload" method of cWebView.
22997>>>>>>>>>>>    // See also "LoadView"
22997>>>>>>>>>>>    Procedure UnloadView Handle hoView
22999>>>>>>>>>>>        String sViewName
22999>>>>>>>>>>>        String[] aParams
23000>>>>>>>>>>>        
23000>>>>>>>>>>>        Get Object_Label of hoView to sViewName
23001>>>>>>>>>>>        Move sViewName      to aParams[0]   // Pass the view name as the 1st parameter.
23002>>>>>>>>>>>        Move True           to aParams[1]
23003>>>>>>>>>>>        Send ClientAction "unloadView" aParams
23004>>>>>>>>>>>    End_Procedure
23005>>>>>>>>>>>    
23005>>>>>>>>>>>    
23005>>>>>>>>>>>    // Triggers when the page title is automatically updated and concatenates the the application 
23005>>>>>>>>>>>    // title with the view title. Can be augmented / overriden to 
23005>>>>>>>>>>>    //
23005>>>>>>>>>>>    // Params:
23005>>>>>>>>>>>    //      ByRef sTitle    Contains the page title when coming in, should receive the full title.
23005>>>>>>>>>>>    //      hoView          Handle to the current view (can be C_WebUnresolvedObject).
23005>>>>>>>>>>>    //      sViewTitle      Current caption of the view (can be "").
23005>>>>>>>>>>>    Procedure OnGeneratePageTitle String ByRef sTitle Handle hoView String sViewTitle
23007>>>>>>>>>>>        If (Trim(sViewTitle) <> "") Begin
23009>>>>>>>>>>>            Move (sTitle + " - " + sViewTitle) to sTitle
23010>>>>>>>>>>>        End
23010>>>>>>>>>>>>
23010>>>>>>>>>>>    End_Procedure
23011>>>>>>>>>>>    
23011>>>>>>>>>>>    
23011>>>>>>>>>>>    // Updates the page title by generating the full title based on the passed view title.
23011>>>>>>>>>>>    //
23011>>>>>>>>>>>    // Params:
23011>>>>>>>>>>>    //      hoView      Handle to the current view (can be C_WebUnresolvedObject).
23011>>>>>>>>>>>    //      sViewTitle  Current view caption.
23011>>>>>>>>>>>    Procedure UpdatePageTitle Handle hoView String sViewTitle
23013>>>>>>>>>>>        String sTitle
23013>>>>>>>>>>>        Boolean bUpdate
23013>>>>>>>>>>>        
23013>>>>>>>>>>>        WebGet pbUpdateApplicationTitle to bUpdate
23014>>>>>>>>>>>        
23014>>>>>>>>>>>        If (bUpdate) Begin
23016>>>>>>>>>>>            WebGet psApplicationTitle to sTitle
23017>>>>>>>>>>>            
23017>>>>>>>>>>>            Send OnGeneratePageTitle (&sTitle) hoView sViewTitle
23018>>>>>>>>>>>            
23018>>>>>>>>>>>            Send SetPageTitle sTitle
23019>>>>>>>>>>>        End
23019>>>>>>>>>>>>
23019>>>>>>>>>>>    End_Procedure
23020>>>>>>>>>>>
23020>>>>>>>>>>>
23020>>>>>>>>>>>    // This can be sent to any child object to retrieve the object handle of the parent view via delegation.
23020>>>>>>>>>>>    // If delegation reaches here it means there is no view object so we return C_WebUnresolvedObject.
23020>>>>>>>>>>>    Function ViewObject Returns Handle
23022>>>>>>>>>>>        Function_Return C_WebUnresolvedObject
23023>>>>>>>>>>>    End_Function
23024>>>>>>>>>>>    
23024>>>>>>>>>>>    
23024>>>>>>>>>>>    // Locate_Server and Server are used so that child objects can resolve 
23024>>>>>>>>>>>    // that a server does not exit.
23024>>>>>>>>>>>    Function Locate_Server Returns Handle
23026>>>>>>>>>>>        Function_Return 0
23027>>>>>>>>>>>    End_Function
23028>>>>>>>>>>>    
23028>>>>>>>>>>>    
23028>>>>>>>>>>>    Function Server Returns Handle
23030>>>>>>>>>>>        Function_Return 0
23031>>>>>>>>>>>    End_Function
23032>>>>>>>>>>>
23032>>>>>>>>>>>    // Determines if an initial view (like a login dialog) needs to be shown. Overriden in
23032>>>>>>>>>>>    // cWebSessionHost_mixin to handle showing of a login view.
23032>>>>>>>>>>>    //
23032>>>>>>>>>>>    // Returns:
23032>>>>>>>>>>>    //  Handle to the initial view that needs to be shown (C_WebUnresolvedObject if none)
23032>>>>>>>>>>>    Function ForcedInitialView Returns Handle
23034>>>>>>>>>>>        Function_Return C_WebUnresolvedObject
23035>>>>>>>>>>>    End_Function
23036>>>>>>>>>>>
23036>>>>>>>>>>>    // returns the default view, which is normally phoDefaultView.
23036>>>>>>>>>>>    // Is provided for augmentation so developers can specify the default view dynamically
23036>>>>>>>>>>>    Function GetDefaultView Returns Handle
23038>>>>>>>>>>>        Handle hoView
23038>>>>>>>>>>>        Get phoDefaultView to hoView
23039>>>>>>>>>>>        Function_Return hoView
23040>>>>>>>>>>>    End_Function
23041>>>>>>>>>>>
23041>>>>>>>>>>>    // Synchronizes the current records with the passed row id's for each DDO in the
23041>>>>>>>>>>>    // passed collection of DDO structures. Each Structure in the collection belongs
23041>>>>>>>>>>>    // to a different view. The aDDOViews parameter is populated with the object handle
23041>>>>>>>>>>>    // of each view referenced in the aDDODefs collection
23041>>>>>>>>>>>    //
23041>>>>>>>>>>>    // During this process the view is tested for AllowViewAccess. If access is denied to
23041>>>>>>>>>>>    // any view in the stack then SynchronizeDDOs is aborted and the function returns False.
23041>>>>>>>>>>>    Procedure Call_PreSync tWebCallContext ByRef cctx
23043>>>>>>>>>>>        Integer i icDDODef
23043>>>>>>>>>>>        Handle[] aDDOViews
23044>>>>>>>>>>>        Handle hoInvokingObject
23044>>>>>>>>>>>        
23044>>>>>>>>>>>        Send NotifySyncWebApp         
23045>>>>>>>>>>>        
23045>>>>>>>>>>>        // Iterate the DDODefs array and synchronize the DDOs for each view....
23045>>>>>>>>>>>        Move (SizeOfArray(cctx.request.Header.aDDOViews)) to icDDODef
23046>>>>>>>>>>>        
23046>>>>>>>>>>>        //  First get all the object references
23046>>>>>>>>>>>        For i from 0 to (icDDODef - 1)
23052>>>>>>>>>>>>
23052>>>>>>>>>>>            // Get the array of object handles to the views referenced in the request header's aDDODefs collection....
23052>>>>>>>>>>>            Get GetAjaxWebAppView of (phoWebControlLocator(Self)) cctx.request.Header.aDDOViews[i] to aDDOViews[i]
23053>>>>>>>>>>>        Loop
23054>>>>>>>>>>>>
23054>>>>>>>>>>>        
23054>>>>>>>>>>>        Set paDDOViews to aDDOViews
23055>>>>>>>>>>>        
23055>>>>>>>>>>>        //  Now update data bindings (note that this needs to happen after paDDOViews is set for accessibility checks
23055>>>>>>>>>>>        For i from 0 to (icDDODef - 1)
23061>>>>>>>>>>>>
23061>>>>>>>>>>>            // Process the synchronized psValue and pbChanged properties for each control that has a data binding
23061>>>>>>>>>>>            Broadcast Recursive Send UpdateDataBinding to aDDOViews[i]
23063>>>>>>>>>>>            
23063>>>>>>>>>>>            // Get the invoking object, as this might create dynamic objects which could sync their DDO's and we don't want that to happen later
23063>>>>>>>>>>>            Get GetInvokingObject of aDDOViews[i] to hoInvokingObject
23064>>>>>>>>>>>        Loop
23065>>>>>>>>>>>>
23065>>>>>>>>>>>    End_Procedure
23066>>>>>>>>>>>
23066>>>>>>>>>>>    Procedure Call_PostOnCallEnd tWebCallContext ByRef cctx
23068>>>>>>>>>>>        Integer i icDDODef
23068>>>>>>>>>>>        Handle[] aDDOViews
23069>>>>>>>>>>>        
23069>>>>>>>>>>>        // Iterate all the DDODefs in the Request and return the DDODefs for each one in the response
23069>>>>>>>>>>>        Get paDDOViews to aDDOViews
23070>>>>>>>>>>>        Move (SizeOfArray(aDDOViews)) to icDDODef
23071>>>>>>>>>>>        
23071>>>>>>>>>>>        For i from 0 to (icDDODef - 1)
23077>>>>>>>>>>>>
23077>>>>>>>>>>>            Send TriggerOnCallEnd of aDDOViews[i]
23078>>>>>>>>>>>        Loop
23079>>>>>>>>>>>>
23079>>>>>>>>>>>        
23079>>>>>>>>>>>        Send TriggerOnCallEnd
23080>>>>>>>>>>>    End_Procedure
23081>>>>>>>>>>>    
23081>>>>>>>>>>>    // This event is sent for every AJAX call to this view. This can be used by your
23081>>>>>>>>>>>    // security rights management system to set various global rights and roles constraints
23081>>>>>>>>>>>    // properties during each AJAX call.
23081>>>>>>>>>>>    // Note: You should not use web properties for this purpose since synchronized
23081>>>>>>>>>>>    // properties are sync'ed to the client and thus considered insecure.
23081>>>>>>>>>>>    Procedure OnSyncWebApp
23083>>>>>>>>>>>    End_Procedure
23084>>>>>>>>>>>    
23084>>>>>>>>>>>    Procedure NotifySyncWebApp
23086>>>>>>>>>>>        Send OnSyncWebApp
23087>>>>>>>>>>>    End_Procedure
23088>>>>>>>>>>>
23088>>>>>>>>>>>    Procedure End_Construct_cWebViewHost_mixin
23090>>>>>>>>>>>        WebPublishFunction LoadView
23091>>>>>>>>>>>        WebPublishProcedure LoadViewCallBack_CallBack
23092>>>>>>>>>>>        WebPublishProcedure ShowView_FromClient
23093>>>>>>>>>>>    End_Procedure
23094>>>>>>>>>>>
23094>>>>>>>>>>>End_Class
23095>>>>>>>>>
23095>>>>>>>>>Register_Procedure OnUpdateViewStack
23095>>>>>>>>>
23095>>>>>>>>>// Singleton stack object. Store and manipulates information about the stack of views
23095>>>>>>>>>// in a drill-down navigation architecture.
23095>>>>>>>>>Class cWebViewStack is a cWebObject
23096>>>>>>>>>    
23096>>>>>>>>>    Procedure Construct_Object
23098>>>>>>>>>        Forward Send Construct_Object
23100>>>>>>>>>        
23100>>>>>>>>>        // Global handle is deprecated.
23100>>>>>>>>>        Move Self to ghoWebViewStack
23101>>>>>>>>>        // Set the viewstack of the cWebApp or cLocalWebControlHost to this object
23101>>>>>>>>>        Set phoViewStack of (Host(Self)) to Self
23102>>>>>>>>>        
23102>>>>>>>>>        Property tWebViewInfo[] paViewStack    // The stack of current views navigated to in the drill-down view stack.
23105>>>>>>>>>        
23105>>>>>>>>>        Property Handle[] paClientControls     // Array of client web controls that are notified whenever the view stack is modified
23106>>>>>>>>>    End_Procedure 
23107>>>>>>>>>
23107>>>>>>>>>    
23107>>>>>>>>>    // Returns the total number of views currently in the view stack.
23107>>>>>>>>>    Function ViewStackSize Returns Integer
23109>>>>>>>>>        Integer iCount
23109>>>>>>>>>        tWebViewInfo[] aViewStack
23109>>>>>>>>>        tWebViewInfo[] aViewStack
23110>>>>>>>>>        WebGet paViewStack to aViewStack
23111>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iCount
23112>>>>>>>>>        Function_Return iCount
23113>>>>>>>>>    End_Function
23114>>>>>>>>>
23114>>>>>>>>>        
23114>>>>>>>>>    // Adds a new client object to the set of listening client objects.
23114>>>>>>>>>    // See also NotifyClients
23114>>>>>>>>>    Procedure AddClient Handle hoClient
23116>>>>>>>>>        Integer iCount
23116>>>>>>>>>        Handle[] aClientControls
23117>>>>>>>>>        
23117>>>>>>>>>        Get paClientControls to aClientControls
23118>>>>>>>>>        Move (SizeOfArray(aClientControls)) to iCount
23119>>>>>>>>>        Move hoClient to aClientControls[iCount]
23120>>>>>>>>>        Set paClientControls to aClientControls
23121>>>>>>>>>    End_Procedure
23122>>>>>>>>>
23122>>>>>>>>>
23122>>>>>>>>>
23122>>>>>>>>>    // sReason - [Out] Passes back the reason why Pop View is not allowed.
23122>>>>>>>>>    // Returns true if you can pop the passed View. 
23122>>>>>>>>>    // Returns False if the view is not at the top of the stack
23122>>>>>>>>>    Function CanPopView Handle hoView String ByRef sReason Returns Boolean
23124>>>>>>>>>        Integer iCount
23124>>>>>>>>>        String sViewName
23124>>>>>>>>>        tWebViewInfo[] aViewStack
23124>>>>>>>>>        tWebViewInfo[] aViewStack
23125>>>>>>>>>        
23125>>>>>>>>>        //Send DeserializeViewStack
23125>>>>>>>>>        WebGet paViewStack to aViewStack
23126>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iCount
23127>>>>>>>>>        Get WebObjectName of hoView to sViewName
23128>>>>>>>>>        
23128>>>>>>>>>        If (iCount > 0 and sViewName = aViewStack[iCount-1].sViewName) Begin
23130>>>>>>>>>            Function_Return True
23131>>>>>>>>>        End
23131>>>>>>>>>>
23131>>>>>>>>>        Else Begin
23132>>>>>>>>>            Move "This is not the top view." to sReason
23133>>>>>>>>>            Function_Return False
23134>>>>>>>>>        End
23134>>>>>>>>>>
23134>>>>>>>>>    End_Function
23135>>>>>>>>>    
23135>>>>>>>>>    // sReason - [Out] Passes back the reason why Push View is not allowed.
23135>>>>>>>>>    // Returns true if you can push the passed View. 
23135>>>>>>>>>    // Returns False If the view is already on the view stack.
23135>>>>>>>>>    Function CanPushView Handle hoView String ByRef sReason Returns Boolean
23137>>>>>>>>>        Integer iIndex
23137>>>>>>>>>        Boolean bOK
23137>>>>>>>>>        
23137>>>>>>>>>        Get GetViewIndex hoView to iIndex
23138>>>>>>>>>        Move (iIndex = -1) to bOK
23139>>>>>>>>>        If (not(bOK)) Begin
23141>>>>>>>>>            Move "View is already in the view stack." to sReason        
23142>>>>>>>>>        End
23142>>>>>>>>>>
23142>>>>>>>>>        Function_Return bOK
23143>>>>>>>>>    End_Function
23144>>>>>>>>>
23144>>>>>>>>>    
23144>>>>>>>>>    // Returns the index in the view stack of the passed view handle. 
23144>>>>>>>>>    // Returns -1 if the view is not in the stack
23144>>>>>>>>>    Function GetViewIndex Handle hoView Returns Integer
23146>>>>>>>>>        Integer i iCount
23146>>>>>>>>>        String sViewName
23146>>>>>>>>>        tWebViewInfo[] aViewStack
23146>>>>>>>>>        tWebViewInfo[] aViewStack
23147>>>>>>>>>
23147>>>>>>>>>        If (hoView <> 0) Begin        
23149>>>>>>>>>            WebGet paViewStack to aViewStack
23150>>>>>>>>>            Move (SizeOfArray(aViewStack)) to iCount
23151>>>>>>>>>            Get WebObjectName of hoView to sViewName
23152>>>>>>>>>            
23152>>>>>>>>>            For i from 0 to (iCount-1)
23158>>>>>>>>>>
23158>>>>>>>>>                If (sViewName = aViewStack[i].sViewName) Begin
23160>>>>>>>>>                    Function_Return i
23161>>>>>>>>>                End
23161>>>>>>>>>>
23161>>>>>>>>>            Loop
23162>>>>>>>>>>
23162>>>>>>>>>        End
23162>>>>>>>>>>
23162>>>>>>>>>        
23162>>>>>>>>>        Function_Return -1
23163>>>>>>>>>    End_Function
23164>>>>>>>>>
23164>>>>>>>>>
23164>>>>>>>>>    // Returns the view handle of the view below the top of stack. 
23164>>>>>>>>>    // Returns 0 If there are less than two views in the stack.
23164>>>>>>>>>    // See also TopViewHandle.
23164>>>>>>>>>    Function InvokingViewHandle Returns Handle
23166>>>>>>>>>        Integer iTop
23166>>>>>>>>>        Handle hoView
23166>>>>>>>>>        tWebViewInfo[] aViewStack
23166>>>>>>>>>        tWebViewInfo[] aViewStack
23167>>>>>>>>>
23167>>>>>>>>>        // Update the stack
23167>>>>>>>>>        //Send DeserializeViewStack
23167>>>>>>>>>        WebGet paViewStack to aViewStack
23168>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
23169>>>>>>>>>            
23169>>>>>>>>>        If (iTop < 2) Begin
23171>>>>>>>>>            Function_Return 0
23172>>>>>>>>>        End
23172>>>>>>>>>>
23172>>>>>>>>>        Else Begin
23173>>>>>>>>>            Get WebObjectByName aViewStack[iTop-2].sViewName to hoView
23174>>>>>>>>>            Function_Return hoView
23175>>>>>>>>>        End
23175>>>>>>>>>>
23175>>>>>>>>>    End_Function
23176>>>>>>>>>    
23176>>>>>>>>>    // Returns the view handle of the invoking view of a specific view that is on the stack. 
23176>>>>>>>>>    // Returns C_WebUnresolvedObject if the view is not found on the stack.
23176>>>>>>>>>    Function InvokingViewHandleByView Handle hoView Returns Handle
23178>>>>>>>>>        Integer iIndex
23178>>>>>>>>>
23178>>>>>>>>>        tWebViewInfo[] aViewStack
23178>>>>>>>>>        tWebViewInfo[] aViewStack
23179>>>>>>>>>
23179>>>>>>>>>        // Update the stack
23179>>>>>>>>>        //Send DeserializeViewStack
23179>>>>>>>>>        WebGet paViewStack to aViewStack
23180>>>>>>>>>        
23180>>>>>>>>>        Get GetViewIndex hoView to iIndex
23181>>>>>>>>>        If (iIndex > 0) Begin
23183>>>>>>>>>       
23183>>>>>>>>>            Get WebObjectByName aViewStack[iIndex-1].sViewName to hoView
23184>>>>>>>>>            Function_Return hoView
23185>>>>>>>>>        End
23185>>>>>>>>>>
23185>>>>>>>>>        
23185>>>>>>>>>        Function_Return C_WebUnresolvedObject
23186>>>>>>>>>    End_Function
23187>>>>>>>>>    
23187>>>>>>>>>    
23187>>>>>>>>>    // Returns the view in the stack after the passed view. So the view of which the passed view is
23187>>>>>>>>>    // the invoking view. If the passed view is not in the stack or is the top view then
23187>>>>>>>>>    // C_WebUnresolvedObject will be returned.
23187>>>>>>>>>    Function NextViewHandleByView Handle hoView Returns Handle
23189>>>>>>>>>        Integer iIndex
23189>>>>>>>>>
23189>>>>>>>>>        tWebViewInfo[] aViewStack
23189>>>>>>>>>        tWebViewInfo[] aViewStack
23190>>>>>>>>>
23190>>>>>>>>>        // Update the stack
23190>>>>>>>>>        //Send DeserializeViewStack
23190>>>>>>>>>        WebGet paViewStack to aViewStack
23191>>>>>>>>>        
23191>>>>>>>>>        Get GetViewIndex hoView to iIndex
23192>>>>>>>>>        If (iIndex < SizeOfArray(aViewStack) - 1) Begin
23194>>>>>>>>>       
23194>>>>>>>>>            Get WebObjectByName aViewStack[iIndex+1].sViewName to hoView
23195>>>>>>>>>            Function_Return hoView
23196>>>>>>>>>        End
23196>>>>>>>>>>
23196>>>>>>>>>        
23196>>>>>>>>>        Function_Return C_WebUnresolvedObject
23197>>>>>>>>>    End_Function
23198>>>>>>>>>
23198>>>>>>>>>    
23198>>>>>>>>>    // Notifies all listening client objects that the view stack has changed.
23198>>>>>>>>>    // These objects must understand the OnUpdateViewStack event.
23198>>>>>>>>>    // See also AddClient
23198>>>>>>>>>    Procedure NotifyClients
23200>>>>>>>>>        Integer i iCount
23200>>>>>>>>>        Handle[] aClientControls
23201>>>>>>>>>        
23201>>>>>>>>>        Get paClientControls to aClientControls
23202>>>>>>>>>        Move (SizeOfArray(aClientControls)) to iCount
23203>>>>>>>>>        
23203>>>>>>>>>        For i from 0 to (iCount-1)
23209>>>>>>>>>>
23209>>>>>>>>>            Send OnUpdateViewStack to aClientControls[i]
23210>>>>>>>>>        Loop
23211>>>>>>>>>>
23211>>>>>>>>>    End_Procedure
23212>>>>>>>>>    
23212>>>>>>>>>    
23212>>>>>>>>>    // Pops all members of the stack down to the passed view handle. If the view is
23212>>>>>>>>>    // not on the stack then nothing is removed.
23212>>>>>>>>>    Procedure PopDownToView Handle hoView
23214>>>>>>>>>        Integer iIndex iTopOfStack
23214>>>>>>>>>        tWebViewInfo[] aViewStack
23214>>>>>>>>>        tWebViewInfo[] aViewStack
23215>>>>>>>>>
23215>>>>>>>>>        Get GetViewIndex hoView to iIndex
23216>>>>>>>>>        
23216>>>>>>>>>        If (iIndex <> -1) Begin
23218>>>>>>>>>            // Update the stack
23218>>>>>>>>>            WebGet paViewStack to aViewStack
23219>>>>>>>>>            Move (ResizeArray(aViewStack, iIndex+1)) to aViewStack
23220>>>>>>>>>            WebSet paViewStack to aViewStack        
23221>>>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
23222>>>>>>>>>        End
23222>>>>>>>>>>
23222>>>>>>>>>    End_Procedure
23223>>>>>>>>>
23223>>>>>>>>>
23223>>>>>>>>>    // Pops a view off the top of the view stack.
23223>>>>>>>>>    Procedure PopView
23225>>>>>>>>>        Integer iTop
23225>>>>>>>>>        tWebViewInfo[] aViewStack
23225>>>>>>>>>        tWebViewInfo[] aViewStack
23226>>>>>>>>>
23226>>>>>>>>>        // Update the stack
23226>>>>>>>>>        WebGet paViewStack to aViewStack
23227>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
23228>>>>>>>>>        
23228>>>>>>>>>        If (iTop = 0) Begin
23230>>>>>>>>>            Error DFERR_PROGRAM "View Stack Error: Pop past end of stack"
23231>>>>>>>>>>
23231>>>>>>>>>        End
23231>>>>>>>>>>
23231>>>>>>>>>        Else Begin
23232>>>>>>>>>            Move (ResizeArray(aViewStack, iTop - 1)) to aViewStack
23233>>>>>>>>>            WebSet paViewStack to aViewStack        
23234>>>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
23235>>>>>>>>>        End
23235>>>>>>>>>>
23235>>>>>>>>>    End_Procedure
23236>>>>>>>>>
23236>>>>>>>>>    
23236>>>>>>>>>    // Pushes a new view to the top of the view stack (Note: we assume hoView's web properties are in scope).
23236>>>>>>>>>    Procedure PushView Handle hoView Integer eNavigateType
23238>>>>>>>>>        Handle hoMainDD
23238>>>>>>>>>        Integer iTop
23238>>>>>>>>>        tWebViewInfo ViewInfo
23238>>>>>>>>>        tWebViewInfo ViewInfo
23238>>>>>>>>>        tWebViewInfo[] aViewStack
23238>>>>>>>>>        tWebViewInfo[] aViewStack
23239>>>>>>>>>        RowID riId
23239>>>>>>>>>        // Before pushing any new view onto the stack we want 
23239>>>>>>>>>        // to retrieve the latest "Should_Save state of the
23239>>>>>>>>>        // current top view...
23239>>>>>>>>>        Send UpdateShouldSave
23240>>>>>>>>>        
23240>>>>>>>>>        // Populate the ViewInfo struct
23240>>>>>>>>>        Get WebObjectName of hoView  to ViewInfo.sViewName
23241>>>>>>>>>        WebGet psCaption of hoView   to ViewInfo.sCaption
23242>>>>>>>>>        Move ViewInfo.sCaption       to ViewInfo.sHeaderCaption    // by default these are both set to the same value
23243>>>>>>>>>        Get peViewType of hoView     to ViewInfo.eViewType
23244>>>>>>>>>        Move eNavigateType           to ViewInfo.eNavigateType 
23245>>>>>>>>>        
23245>>>>>>>>>        Get Main_DD of hoView to hoMainDD
23246>>>>>>>>>        If (hoMainDD <> 0) Begin
23248>>>>>>>>>            Get Main_File of hoMainDD to ViewInfo.iMainTable
23249>>>>>>>>>            Get CurrentRowId of hoMainDD to riId
23250>>>>>>>>>            Move riId to ViewInfo.riMainTable
23251>>>>>>>>>//            Move (SerializeRowID(riId)) to ViewInfo.sMainTableRowID
23251>>>>>>>>>        End
23251>>>>>>>>>>
23251>>>>>>>>>        
23251>>>>>>>>>        // Update the stack
23251>>>>>>>>>        WebGet paViewStack to aViewStack
23252>>>>>>>>>        Move (InsertInArray(aViewStack,-1,ViewInfo)) to aViewStack
23253>>>>>>>>>        WebSet paViewStack to aViewStack        
23254>>>>>>>>>        Send NotifyClients    // Notify the view stack clients of this change
23255>>>>>>>>>    End_Procedure
23256>>>>>>>>>    
23256>>>>>>>>>    // returns handle of object we can close up to
23256>>>>>>>>>    // hoCloseToView is the view you want to close to. If 0, it's all.
23256>>>>>>>>>    // bSkipTop deremines if you should skip the top of the stack, which sometimes gets special
23256>>>>>>>>>    // treatment.
23256>>>>>>>>>    Function CanCloseViews Handle hoCloseToView Boolean bSkipTop Returns Handle
23258>>>>>>>>>        tWebViewInfo[] aViewStack
23258>>>>>>>>>        tWebViewInfo[] aViewStack
23259>>>>>>>>>        Integer iStackViews eCloseAction
23259>>>>>>>>>        Handle hoView
23259>>>>>>>>>        Boolean bStop
23259>>>>>>>>>        Send UpdateShouldSave to (ViewStack(Self))
23260>>>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
23261>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iStackViews
23262>>>>>>>>>        If bSkipTop Begin
23264>>>>>>>>>            Decrement iStackViews
23265>>>>>>>>>        End
23265>>>>>>>>>>
23265>>>>>>>>>        While (iStackViews and not(bStop))
23269>>>>>>>>>            Decrement iStackViews
23270>>>>>>>>>            Get WebObjectByName aViewStack[iStackViews].sViewName to hoView
23271>>>>>>>>>            If (hoView=hoCloseToView) Begin
23273>>>>>>>>>                Move 0 to iStackViews
23274>>>>>>>>>            End
23274>>>>>>>>>>
23274>>>>>>>>>            Else If (aViewStack[iStackViews].bShouldSave) Begin
23277>>>>>>>>>                Get GetChangedViewExitAction of hoView to eCloseAction 
23278>>>>>>>>>                // we only allow a close if it is a pure adandon changes.
23278>>>>>>>>>                If (eCloseAction<>cveAbandonChanges) Begin
23280>>>>>>>>>                   Function_Return hoView 
23281>>>>>>>>>                End
23281>>>>>>>>>>
23281>>>>>>>>>            End
23281>>>>>>>>>>
23281>>>>>>>>>        Loop
23282>>>>>>>>>>
23282>>>>>>>>>        Function_Return hoCloseToView
23283>>>>>>>>>    End_Function
23284>>>>>>>>>    
23284>>>>>>>>>    // Clears the view stack.
23284>>>>>>>>>    // bDefaultView - Pass True if the default view should be pushed onto the
23284>>>>>>>>>    //                view stack automatically after it is reset.
23284>>>>>>>>>    // Returns - True if the Reset succeeded.
23284>>>>>>>>>    //           False if the View stack could not be reset (usually due to unsaved changes in
23284>>>>>>>>>    //           one of the current views in the stack).
23284>>>>>>>>>    Function Reset Boolean bDefaultView Boolean bUnconditional Returns Boolean
23286>>>>>>>>>        Handle hoShouldSaveView 
23286>>>>>>>>>        Handle hoTopView hoDefaultView
23286>>>>>>>>>        Integer iDefaultViewIndex
23286>>>>>>>>>        tWebViewInfo[] aViewStack
23286>>>>>>>>>        tWebViewInfo[] aViewStack
23287>>>>>>>>>        String sReason
23287>>>>>>>>>        
23287>>>>>>>>>        Get GetDefaultView of (Host(Self)) to hoDefaultView
23288>>>>>>>>>        Get TopViewHandle to hoTopView
23289>>>>>>>>>        
23289>>>>>>>>>        // First see if it is OK to close all of the current views down
23289>>>>>>>>>        // to the current first view.
23289>>>>>>>>>        If bUnconditional Begin
23291>>>>>>>>>            Move hoDefaultView to hoShouldSaveView
23292>>>>>>>>>        End
23292>>>>>>>>>>
23292>>>>>>>>>        Else Begin
23293>>>>>>>>>            Get CanCloseViews hoDefaultView False to hoShouldSaveView
23294>>>>>>>>>        End
23294>>>>>>>>>>
23294>>>>>>>>>        If (hoShouldSaveView<>hoDefaultView) Begin
23296>>>>>>>>>            If (hoShouldSaveView <> hoTopView) Begin
23298>>>>>>>>>                Send ShowView to (Host(Self)) hoShouldSaveView
23299>>>>>>>>>            End
23299>>>>>>>>>>
23299>>>>>>>>>            Send PopDownToView of (ViewStack(Self)) hoShouldSaveView
23300>>>>>>>>>            Send UpdateInvokingViewDrillDownStyle to hoShouldSaveView
23301>>>>>>>>>            Send CantCloseChangedViewError
23302>>>>>>>>>            Function_Return False
23303>>>>>>>>>        End
23303>>>>>>>>>>
23303>>>>>>>>>        
23303>>>>>>>>>        // If we got here then we can reset the stack...
23303>>>>>>>>>        If (hoTopView <> 0) Begin
23305>>>>>>>>>            If (hoDefaultView <> hoTopView or not(bDefaultView)) Begin
23307>>>>>>>>>                Send Hide to hoTopView    // First hide the current view
23308>>>>>>>>>            End
23308>>>>>>>>>>
23308>>>>>>>>>        End
23308>>>>>>>>>>
23308>>>>>>>>>        
23308>>>>>>>>>        // Make sure we do not clear the default view off the stack
23308>>>>>>>>>        If (bDefaultView and hoDefaultView <> 0) Begin
23310>>>>>>>>>            // Test that the default view is the first view in the stack
23310>>>>>>>>>            Get GetViewIndex hoDefaultView to iDefaultViewIndex
23311>>>>>>>>>            
23311>>>>>>>>>            If (iDefaultViewIndex = 0) Begin
23313>>>>>>>>>                WebGet paViewStack to aViewStack
23314>>>>>>>>>                Move (ResizeArray(aViewStack, 1)) to aViewStack
23315>>>>>>>>>            End
23315>>>>>>>>>>
23315>>>>>>>>>        End
23315>>>>>>>>>>
23315>>>>>>>>>        
23315>>>>>>>>>        // Clear the stack
23315>>>>>>>>>        WebSet paViewStack to aViewStack        
23316>>>>>>>>>        Send NotifyClients    // Notify the view stack clients of this change
23317>>>>>>>>>        
23317>>>>>>>>>        Function_Return True
23318>>>>>>>>>    End_Function
23319>>>>>>>>>
23319>>>>>>>>>
23319>>>>>>>>>//    // Returns the view handle of the top most view that has a should save flag 
23319>>>>>>>>>//    // set to True. Returns 0 if there are no views with should save = True.
23319>>>>>>>>>//    // hoAboveView - Only checks views in the view stack above this view handle
23319>>>>>>>>>//    //               pass 0 to check the entire stack
23319>>>>>>>>>//    Function TopShouldSaveViewHandles Handle hoAboveView Returns Handle[]
23319>>>>>>>>>//        Handle[] hoShouldSaveViews
23319>>>>>>>>>//        Integer i iCount iAboveView iChanged
23319>>>>>>>>>//        tWebViewInfo[] aViewStack
23319>>>>>>>>>//        
23319>>>>>>>>>//        // search the view stack....
23319>>>>>>>>>//        
23319>>>>>>>>>//        Get GetViewIndex hoAboveView to iAboveView
23319>>>>>>>>>//        //Send DeserializeViewStack
23319>>>>>>>>>//        WebGet paViewStack to aViewStack
23319>>>>>>>>>//        Move (SizeOfArray(aViewStack)) to iCount
23319>>>>>>>>>//        Increment iAboveView
23319>>>>>>>>>//        For i from iAboveView to (iCount-1)
23319>>>>>>>>>//            If (aViewStack[i].bShouldSave) Begin
23319>>>>>>>>>//                Get WebObjectByName aViewStack[i].sViewName to hoShouldSaveViews[iChanged]
23319>>>>>>>>>//                Increment iChanged
23319>>>>>>>>>//            End
23319>>>>>>>>>//        Loop
23319>>>>>>>>>//        Function_Return hoShouldSaveViews
23319>>>>>>>>>//    End_Function
23319>>>>>>>>>
23319>>>>>>>>>
23319>>>>>>>>>    // Returns the view handle of the top of stack. Returns 0 if the Stack is empty.
23319>>>>>>>>>    // See also InvokingViewHandle.
23319>>>>>>>>>    Function TopViewHandle Returns Handle
23321>>>>>>>>>        Integer iTop
23321>>>>>>>>>        Handle hoView
23321>>>>>>>>>        tWebViewInfo[] aViewStack
23321>>>>>>>>>        tWebViewInfo[] aViewStack
23322>>>>>>>>>
23322>>>>>>>>>        // Update the stack
23322>>>>>>>>>        WebGet paViewStack to aViewStack
23323>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
23324>>>>>>>>>            
23324>>>>>>>>>        If (iTop = 0) Begin
23326>>>>>>>>>            Function_Return C_WebUnresolvedObject
23327>>>>>>>>>        End
23327>>>>>>>>>>
23327>>>>>>>>>        Else Begin
23328>>>>>>>>>            Get WebObjectByName aViewStack[iTop-1].sViewName to hoView
23329>>>>>>>>>            Function_Return hoView
23330>>>>>>>>>        End
23330>>>>>>>>>>
23330>>>>>>>>>    End_Function
23331>>>>>>>>>    
23331>>>>>>>>>    
23331>>>>>>>>>    // Updates the Should Save value of the top view in the view stack
23331>>>>>>>>>    Procedure UpdateShouldSave
23333>>>>>>>>>        Integer iTop
23333>>>>>>>>>        Handle hoView hoMain_DD
23333>>>>>>>>>        tWebViewInfo[] aViewStack
23333>>>>>>>>>        tWebViewInfo[] aViewStack
23334>>>>>>>>>
23334>>>>>>>>>        // Update the stack
23334>>>>>>>>>        //Send DeserializeViewStack
23334>>>>>>>>>        WebGet paViewStack to aViewStack
23335>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
23336>>>>>>>>>            
23336>>>>>>>>>        If (iTop > 0) Begin
23338>>>>>>>>>            Get WebObjectByName aViewStack[iTop-1].sViewName to hoView
23339>>>>>>>>>            Get IsViewChanged of hoView to aViewStack[iTop-1].bShouldSave
23340>>>>>>>>>            WebSet paViewStack to aViewStack
23341>>>>>>>>>        End
23341>>>>>>>>>>
23341>>>>>>>>>    End_Procedure
23342>>>>>>>>>    
23342>>>>>>>>>    // dynamically change the breadcrumb caption for a view
23342>>>>>>>>>    Procedure SetCaption Handle hoView String sCaption
23344>>>>>>>>>        tWebViewInfo[] aViewStack
23344>>>>>>>>>        tWebViewInfo[] aViewStack
23345>>>>>>>>>        Integer iIndex
23345>>>>>>>>>        Get GetViewIndex hoView to iIndex
23346>>>>>>>>>        If (iIndex>=0) Begin
23348>>>>>>>>>            WebGet paViewStack to aViewStack 
23349>>>>>>>>>            Move sCaption to aViewStack[iIndex].sCaption
23350>>>>>>>>>            WebSet paViewStack to aViewStack 
23351>>>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
23352>>>>>>>>>        End
23352>>>>>>>>>>
23352>>>>>>>>>    End_Procedure
23353>>>>>>>>>
23353>>>>>>>>>    // get breadcrumb caption for this view
23353>>>>>>>>>    Function GetCaption Handle hoView Returns String
23355>>>>>>>>>        tWebViewInfo[] aViewStack
23355>>>>>>>>>        tWebViewInfo[] aViewStack
23356>>>>>>>>>        Integer iIndex
23356>>>>>>>>>        Get GetViewIndex hoView to iIndex
23357>>>>>>>>>        If (iIndex>=0) Begin
23359>>>>>>>>>            WebGet paViewStack to aViewStack 
23360>>>>>>>>>            Function_Return aViewStack[iIndex].sCaption
23361>>>>>>>>>        End
23361>>>>>>>>>>
23361>>>>>>>>>    End_Function
23362>>>>>>>>>    
23362>>>>>>>>>    // dynamically change the "header" caption for a view
23362>>>>>>>>>    Procedure SetHeaderCaption Handle hoView String sCaption
23364>>>>>>>>>        tWebViewInfo[] aViewStack
23364>>>>>>>>>        tWebViewInfo[] aViewStack
23365>>>>>>>>>        Integer iIndex
23365>>>>>>>>>        Get GetViewIndex hoView to iIndex
23366>>>>>>>>>        If (iIndex>=0) Begin
23368>>>>>>>>>            WebGet paViewStack to aViewStack 
23369>>>>>>>>>            Move sCaption to aViewStack[iIndex].sHeaderCaption
23370>>>>>>>>>            WebSet paViewStack to aViewStack 
23371>>>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
23372>>>>>>>>>        End
23372>>>>>>>>>>
23372>>>>>>>>>    End_Procedure
23373>>>>>>>>>
23373>>>>>>>>>    // get header caption for this view
23373>>>>>>>>>    Function GetHeaderCaption Handle hoView Returns String
23375>>>>>>>>>        tWebViewInfo[] aViewStack
23375>>>>>>>>>        tWebViewInfo[] aViewStack
23376>>>>>>>>>        Integer iIndex
23376>>>>>>>>>        Get GetViewIndex hoView to iIndex
23377>>>>>>>>>        If (iIndex>=0) Begin
23379>>>>>>>>>            WebGet paViewStack to aViewStack 
23380>>>>>>>>>            Function_Return aViewStack[iIndex].sHeaderCaption
23381>>>>>>>>>        End
23381>>>>>>>>>>
23381>>>>>>>>>    End_Function
23382>>>>>>>>>
23382>>>>>>>>>    // Send this to the stack view to Navigate Back down the View Stack to this view.
23382>>>>>>>>>    // The target view can be in any position in the current view stack, but 
23382>>>>>>>>>    // it must belong to the current view stack.
23382>>>>>>>>>    //
23382>>>>>>>>>    // Each view in the view stack, above the target view, will be tested for
23382>>>>>>>>>    // data loss (pending saves). If one of the higher views requires a save
23382>>>>>>>>>    // then it will be activated instead and the "save changes" message will
23382>>>>>>>>>    // be shown.
23382>>>>>>>>>    //
23382>>>>>>>>>    // Typically, this message will be called by a breadcrumb navigation control.
23382>>>>>>>>>    //
23382>>>>>>>>>    Procedure NavigateBack Handle hoTargetView Boolean bUnconditional
23384>>>>>>>>>        Handle hoView hoInvokingView hoTopView  
23384>>>>>>>>>        Integer iIndex
23384>>>>>>>>>        Boolean bTopChanged
23384>>>>>>>>>        Integer iStackViews
23384>>>>>>>>>        tWebViewInfo[] aViewStack
23384>>>>>>>>>        tWebViewInfo[] aViewStack
23385>>>>>>>>>        
23385>>>>>>>>>        Get TopViewHandle to hoTopView
23386>>>>>>>>>        If not hoTopView Begin
23388>>>>>>>>>            Procedure_Return
23389>>>>>>>>>        End
23389>>>>>>>>>>
23389>>>>>>>>>        
23389>>>>>>>>>        Get GetViewIndex hoTargetView to iIndex
23390>>>>>>>>>        If (iIndex=-1) Begin
23392>>>>>>>>>            Error DFERR_PROGRAM "Target view not in view stack"
23393>>>>>>>>>>
23393>>>>>>>>>            Procedure_Return
23394>>>>>>>>>        End
23394>>>>>>>>>>
23394>>>>>>>>>
23394>>>>>>>>>        If bUnconditional Begin
23396>>>>>>>>>            Move hoTargetView to hoView
23397>>>>>>>>>        End
23397>>>>>>>>>>
23397>>>>>>>>>        Else Begin
23398>>>>>>>>>            Get InvokingViewHandle to hoInvokingView
23399>>>>>>>>>    
23399>>>>>>>>>            If (hoTargetView = hoInvokingView) Begin
23401>>>>>>>>>                Send NavigateCancel of hoTopView
23402>>>>>>>>>                Procedure_Return
23403>>>>>>>>>            End
23403>>>>>>>>>>
23403>>>>>>>>>    
23403>>>>>>>>>            // If we are not the current top then make sure we are not popping off
23403>>>>>>>>>            // any views that have pending changes (should save)...
23403>>>>>>>>>            Get IsViewChanged of hoTopView to bTopChanged
23404>>>>>>>>>            Get CanCloseViews hoTargetView True to hoView
23405>>>>>>>>>            If (hoView = hoTargetView and bTopChanged) Begin
23407>>>>>>>>>               Send NavigateCancelTo of hoTopView hoView 
23408>>>>>>>>>               Procedure_Return
23409>>>>>>>>>            End
23409>>>>>>>>>>
23409>>>>>>>>>            Else If (bTopChanged) Begin
23412>>>>>>>>>               Move hoTopView to hoView 
23413>>>>>>>>>            End
23413>>>>>>>>>>
23413>>>>>>>>>    
23413>>>>>>>>>            If (hoView <> hoTargetView) Begin
23415>>>>>>>>>                Send CantCloseChangedViewError
23416>>>>>>>>>            End
23416>>>>>>>>>>
23416>>>>>>>>>        End
23416>>>>>>>>>>
23416>>>>>>>>>        // finish the navigation back to the view
23416>>>>>>>>>        If (hoView <> hoTopView) Begin
23418>>>>>>>>>            Send NavigateBackToHere of hoView True 0
23419>>>>>>>>>        End
23419>>>>>>>>>>
23419>>>>>>>>>    End_Procedure
23420>>>>>>>>>
23420>>>>>>>>>    // navigate back to named view.
23420>>>>>>>>>    Procedure NavigateBackByName String sViewName
23422>>>>>>>>>        Handle hoView hoTopView
23422>>>>>>>>>        If (sViewName <> "") Begin
23424>>>>>>>>>            Get WebObjectByName sViewName to hoView
23425>>>>>>>>>            Get TopViewHandle to hoTopView
23426>>>>>>>>>            If (hoView > 0 and hoView <> hoTopView) Begin
23428>>>>>>>>>                Send NavigateBack hoView False
23429>>>>>>>>>            End
23429>>>>>>>>>>
23429>>>>>>>>>        End
23429>>>>>>>>>>
23429>>>>>>>>>    End_Procedure
23430>>>>>>>>>    

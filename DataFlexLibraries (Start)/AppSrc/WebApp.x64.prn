15045>>>>>>>>>    // Create variant string from UChar array. data is encoded by eCharType
15045>>>>>>>>>    Function VariantStrFromUCharArray UChar[] ucSource Integer eCodeType Returns Variant
15047>>>>>>>>>        Variant vValue
15047>>>>>>>>>        Pointer pvValue
15047>>>>>>>>>        Boolean bOk
15047>>>>>>>>>        Pointer pWStr
15047>>>>>>>>>        Move "" to vValue
15048>>>>>>>>>        
15048>>>>>>>>>        //Initialize pWstr variable so it has the correct type and AddressOf will return a proper pointer
15048>>>>>>>>>        Move 0 to pWStr
15049>>>>>>>>>        //Convert the Ansi string to Unicode
15049>>>>>>>>>        If (eCodeType=CP_UTF16) Begin
15051>>>>>>>>>            Move 0 to ucSource[SizeOfArray(ucSource)]
15052>>>>>>>>>            Move 0 to ucSource[SizeOfArray(ucSource)]
15053>>>>>>>>>            Move (AddressOf(ucSource)) to pWStr
15054>>>>>>>>>        End
15054>>>>>>>>>>
15054>>>>>>>>>        Else Begin
15055>>>>>>>>>            Move (MultiToWideBuffer( eCodeType, AddressOf(ucSource), SizeOfArray(ucSource), AddressOf(pWStr))) to bOk
15056>>>>>>>>>        End
15056>>>>>>>>>>
15056>>>>>>>>>        //Initialize vValue variable so it has the correct type and AddressOf will return a proper pointer
15056>>>>>>>>>        Move 0 to vValue
15057>>>>>>>>>        Move (AddressOf(vValue)) to pvValue
15058>>>>>>>>>        //Change the Variant type to VT_BSTR
15058>>>>>>>>>        Move (StoreDw(pvValue,0,OLE_VT_Bstr)) to bOk
15059>>>>>>>>>        //Allocate a proper COM BSTR, assign the Unicode string, and store the BSTR in the Variant variable
15059>>>>>>>>>        Move (StorePtr(pvValue,8,SysAllocString(pWStr))) to bOk
15060>>>>>>>>>        //Now clear up the Unicode string, the Variant owns a BSTR copy of the string
15060>>>>>>>>>        If (eCodeType<>CP_UTF16) Begin
15062>>>>>>>>>            Move (Free(pWStr)) to bOk
15063>>>>>>>>>        End
15063>>>>>>>>>>
15063>>>>>>>>>        Function_Return vValue
15064>>>>>>>>>    End_Function

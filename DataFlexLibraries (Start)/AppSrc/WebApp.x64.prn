31474>>>>>>>>>    End_Procedure
31475>>>>>>>>>
31475>>>>>>>>>    //  Is called by df on errors. It searches additional information and
31475>>>>>>>>>    //  saves the error. The main part of this is the error handler for AJAX framework
31475>>>>>>>>>    // applications If a basic or a legacy webapp, this Error is "forwarded" to BasicErrorReport.
31475>>>>>>>>>    //
31475>>>>>>>>>    Procedure HandleError Integer iErrNum Integer iErrLine String sErrText
31477>>>>>>>>>        String sSystemErr  sCaption  sExtErr
31477>>>>>>>>>        Boolean bUserError bDisplayControl
31477>>>>>>>>>        Boolean bOldAllErrorsToHtml bAllErrorstoEventLog bInRecording bTrapped
31477>>>>>>>>>        Integer iErrFile iErrField iSrc iTxtlen
31477>>>>>>>>>        Handle hoCurrentView hoTargetControl hoInetSession
31477>>>>>>>>>        
31477>>>>>>>>>                
31477>>>>>>>>>        Get phoInetSession to hoInetSession
31478>>>>>>>>>        Get pbInErrorRecording to bInRecording
31479>>>>>>>>>        
31479>>>>>>>>>        // This means is not happening during an AJAX style Request or it means that this is an
31479>>>>>>>>>        // old webapp style error. If hoInetSession is 0, it is fatal
31479>>>>>>>>>        If (not(bInRecording)) Begin
31481>>>>>>>>>            Send BasicErrorReport iErrNum iErrLine sErrText
31482>>>>>>>>>        End
31482>>>>>>>>>>
31482>>>>>>>>>        Else If (hoInetSession=0) Begin
31485>>>>>>>>>            // this should not be possible at this point.
31485>>>>>>>>>            // If it is, it's fatal and program will abort
31485>>>>>>>>>            Send BasicErrorReport iErrNum iErrLine sErrText
31486>>>>>>>>>            // will abort
31486>>>>>>>>>        End
31486>>>>>>>>>>
31486>>>>>>>>>        Else Begin
31487>>>>>>>>>            
31487>>>>>>>>>            // process an error that occurs during an AJAX Server request
31487>>>>>>>>>            
31487>>>>>>>>>            Move False to bDisplayControl
31488>>>>>>>>>            
31488>>>>>>>>>            // the caption normally used for handled user errors
31488>>>>>>>>>            Get psUserErrorCaption to sCaption
31489>>>>>>>>>            // if an operator error this may be a Procedure UserError situation where the
31489>>>>>>>>>            // caption is passed in the error text. If so, get the caption
31489>>>>>>>>>            If (iErrNum=DFERR_OPERATOR) Begin
31491>>>>>>>>>                Move (pos(C_ErrorCaption,sErrText)) to iSrc
31492>>>>>>>>>                If iSrc Begin
31494>>>>>>>>>                    Move (length(C_ErrorCaption)) to  iTxtLen
31495>>>>>>>>>                    Move (remove(sErrText, 1, iSrc-1 + iTxtLen )) to sCaption
31496>>>>>>>>>                    Move (Left(sErrText,iSrc-1)) to sErrText
31497>>>>>>>>>                End
31497>>>>>>>>>>
31497>>>>>>>>>            End
31497>>>>>>>>>>
31497>>>>>>>>>            
31497>>>>>>>>>            // Get the message....
31497>>>>>>>>>            Get Error_Description iErrNum sErrText to sSystemErr
31498>>>>>>>>>            
31498>>>>>>>>>            // Get file and field (of data dictionary error) if available
31498>>>>>>>>>            // and use this to determine the target control by searching
31498>>>>>>>>>            // for the first control with the same data binding....
31498>>>>>>>>>            If (ghoErrorSource <> 0) Begin
31500>>>>>>>>>                Get Extended_Error_file  of ghoErrorSource to iErrFile
31501>>>>>>>>>                Get Extended_Error_Field of ghoErrorSource to iErrField
31502>>>>>>>>>                
31502>>>>>>>>>                If (iErrFile > 0) Begin
31504>>>>>>>>>                    Get DetermineCurrentView to hoCurrentView
31505>>>>>>>>>                    Move False to bDisplayControl
31506>>>>>>>>>                    If (iErrField > 0 and hoCurrentView <> C_WebUnresolvedObject) Begin
31508>>>>>>>>>                        Get FirstControlWithDataBinding of hoCurrentView iErrFile iErrField to hoTargetControl
31509>>>>>>>>>                        
31509>>>>>>>>>                        If (hoTargetControl <> C_WebUnresolvedObject) Begin
31511>>>>>>>>>                            //  Try to display local error balloon
31511>>>>>>>>>                            Get ShowControlError of hoTargetControl iErrNum sSystemErr to bDisplayControl
31512>>>>>>>>>                        End
31512>>>>>>>>>>
31512>>>>>>>>>                    End
31512>>>>>>>>>>
31512>>>>>>>>>                    //  If no control found (or capable of showing errors) then we extend the error message with file and field name
31512>>>>>>>>>                    If (not(bDisplayControl)) Begin
31514>>>>>>>>>                        Get Extended_Error_Message of ghoErrorSource to sExtErr
31515>>>>>>>>>                        Move (sErrText + "\n" + sExtErr) to sErrText
31516>>>>>>>>>                        Move (sSystemErr + "\n" + sExtErr) to sSystemErr
31517>>>>>>>>>                        Move (Replaces("\n",sSystemErr,"\n\r")) to sSystemErr
31518>>>>>>>>>                    End
31518>>>>>>>>>>
31518>>>>>>>>>                End
31518>>>>>>>>>>
31518>>>>>>>>>            End
31518>>>>>>>>>>
31518>>>>>>>>>            
31518>>>>>>>>>            // Test if this is a user error or an unhandled error (i.e. "find past end of file")....
31518>>>>>>>>>            Get IsUserError iErrNum to bUserError
31519>>>>>>>>>            If not bUserError Begin
31521>>>>>>>>>                Get psUnhandledErrorCaption to sCaption
31522>>>>>>>>>            End
31522>>>>>>>>>>
31522>>>>>>>>>            
31522>>>>>>>>>            //  Forward the error to the webapp object (if not already handled by the contorl)
31522>>>>>>>>>            If (phoWebHost(Self) > 0) Begin
31524>>>>>>>>>                If (not(bDisplayControl)) Begin
31526>>>>>>>>>                    Send ShowError of (phoWebHost(Self)) iErrNum iErrLine sSystemErr sCaption bUserError
31527>>>>>>>>>                End
31527>>>>>>>>>>
31527>>>>>>>>>            End
31527>>>>>>>>>>
31527>>>>>>>>>            Get pbAllErrorstoEventLog of hoInetSession to bAllErrorstoEventLog
31528>>>>>>>>>            If (not(bUserError) or bAllErrorstoEventLog) Begin
31530>>>>>>>>>                Send BasicErrorReport iErrNum iErrLine sErrText
31531>>>>>>>>>            End
31531>>>>>>>>>>
31531>>>>>>>>>        End
31531>>>>>>>>>>
31531>>>>>>>>>    End_Procedure
31532>>>>>>>>>    
31532>>>>>>>>>    // FinishRecording:
31532>>>>>>>>>    
31532>>>>>>>>>    // Stops fetching the error by resetting the origional error handler.
31532>>>>>>>>>    //
31532>>>>>>>>>    // Returns - Array with error structs of occurred errors
31532>>>>>>>>>    Procedure FinishRecording
31534>>>>>>>>>        Boolean bInErrorRecording
31534>>>>>>>>>        Get pbInErrorRecording to bInErrorRecording
31535>>>>>>>>>        If bInErrorRecording Begin
31537>>>>>>>>>            Set pbInErrorRecording to False
31538>>>>>>>>>        End
31538>>>>>>>>>>
31538>>>>>>>>>    End_Procedure
31539>>>>>>>>>    
31539>>>>>>>>>    
31539>>>>>>>>>    // Starts fetching the errors by setting this object as the error handler
31539>>>>>>>>>    // and clearing the error array.
31539>>>>>>>>>    Procedure StartRecording Handle hoHost
31541>>>>>>>>>        Boolean bInErrorRecording
31541>>>>>>>>>        
31541>>>>>>>>>        Get pbInErrorRecording to bInErrorRecording
31542>>>>>>>>>        If (not(bInErrorRecording)) Begin
31544>>>>>>>>>            Set pbInErrorRecording to True
31545>>>>>>>>>        End
31545>>>>>>>>>>
31545>>>>>>>>>        
31545>>>>>>>>>        Set phoWebHost to hoHost
31546>>>>>>>>>    End_Procedure

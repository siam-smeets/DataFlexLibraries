1410>>>>>>>>>
1410>>>>>>>>>// Various Week of Year functions
1410>>>>>>>>>
1410>>>>>>>>>// Get day of week where weeks starts on iWeekDayStart
1410>>>>>>>>>//
1410>>>>>>>>>Function DateGetDayofWeek_WDS Global DateTime dValue Integer iWeekDayStart Returns Integer
1412>>>>>>>>>    Function_Return (Mod(DateGetDayOfWeek(dValue)-1 - (iWeekDayStart-1) + 7,7) + 1)
1413>>>>>>>>>End_Function
1414>>>>>>>>>
1414>>>>>>>>>// Simple Week of year where first day of week is passed and first week
1414>>>>>>>>>// is the week containing Jan 1.
1414>>>>>>>>>// pass what first day of week as 1=Sun, 2=Mon, etc.
1414>>>>>>>>>//
1414>>>>>>>>>Function DateGetWeekOfYear_WDS Global DateTime dValue Integer iWeekDayStart Returns Integer
1416>>>>>>>>>    Integer iDayWk iDays iWks
1416>>>>>>>>>    DateTime dtFirst
1416>>>>>>>>>    
1416>>>>>>>>>    If (IsNullDateTime(dValue) or not(IsDateValid(dValue))) Begin
1418>>>>>>>>>        Error DFERR_INVALID_DATETIME
1419>>>>>>>>>>
1419>>>>>>>>>        Function_Return 0
1420>>>>>>>>>    End
1420>>>>>>>>>>
1420>>>>>>>>>    
1420>>>>>>>>>    Move dValue to dtFirst
1421>>>>>>>>>    Move (DateSetDay(dtFirst,1)) to dtFirst
1422>>>>>>>>>    Move (DateSetMonth(dtFirst,1)) to dtFirst
1423>>>>>>>>>    // 0-6 where 0 = iWeekDateStart
1423>>>>>>>>>    Move (DateGetDayOfWeek_WDS(dtFirst,iWeekDayStart)-1) to iDayWk
1424>>>>>>>>>    Move (DateGetDayOfYear(dValue)) to iDays
1425>>>>>>>>>    Move ((iDays-1 + iDayWk)/7 + 1) to iWks
1426>>>>>>>>>    
1426>>>>>>>>>    Function_Return iWks
1427>>>>>>>>>End_Function
1428>>>>>>>>>
1428>>>>>>>>>// Simple Week of year where first day of week is Sunday and first week
1428>>>>>>>>>// is the week containing Jan 1.
1428>>>>>>>>>//
1428>>>>>>>>>Function DateGetWeekOfYear Global DateTime dValue Returns Integer
1430>>>>>>>>>    Function_Return (DateGetWeekOfYear_WDS(dValue,1))
1431>>>>>>>>>End_Function
1432>>>>>>>>>
1432>>>>>>>>>// Get day of week where weeks starts on Monday (ISO standard)
1432>>>>>>>>>//
1432>>>>>>>>>Function DateGetDayofWeekISO Global DateTime dValue Returns Integer
1434>>>>>>>>>    Function_Return (DateGetDayofWeek_WDS(dValue,2))
1435>>>>>>>>>End_Function
1436>>>>>>>>>
1436>>>>>>>>>// Return Year of Week for ISO week year
1436>>>>>>>>>//
1436>>>>>>>>>Function DateGetYearOfWeekISO Global DateTime dValue Returns Integer
1438>>>>>>>>>    // Create a new date object for the thursday of this week
1438>>>>>>>>>    Move (Date(dValue) - Mod(DateGetDayOfWeek(dValue) -1 + 6, 7)+ 3) to dValue
1439>>>>>>>>>    Function_Return (DateGetYear(dValue))
1440>>>>>>>>>End_Function
1441>>>>>>>>>
1441>>>>>>>>>// return Week of year according to ISO standards where
1441>>>>>>>>>// Monday is the first Day of a week and the first week of the year is the
1441>>>>>>>>>// week that has a Thursday (or, restated, has four of more days in the week).
1441>>>>>>>>>//
1441>>>>>>>>>Function DateGetWeekOfYearISO Global DateTime dValue Returns Integer
1443>>>>>>>>>    Integer iDayWk dayNr iWks
1443>>>>>>>>>    DateTime dtFirst target
1443>>>>>>>>>    DateTime firstThursday
1443>>>>>>>>>    Integer iDy iDiff
1443>>>>>>>>>    
1443>>>>>>>>>    If (IsNullDateTime(dValue) or not(IsDateValid(dValue))) Begin
1445>>>>>>>>>        Error DFERR_INVALID_DATETIME
1446>>>>>>>>>>
1446>>>>>>>>>        Function_Return 0
1447>>>>>>>>>    End
1447>>>>>>>>>>
1447>>>>>>>>>    
1447>>>>>>>>>    Move dValue to target
1448>>>>>>>>>    // ISO week date weeks start on monday
1448>>>>>>>>>    // so correct the day number
1448>>>>>>>>>    Move (DateGetDayOfWeek_WDS(dValue,2)-1) to dayNr
1449>>>>>>>>>    
1449>>>>>>>>>    // ISO 8601 states that week 1 is the week
1449>>>>>>>>>    // with the first thursday of that year.
1449>>>>>>>>>    // Set the target date to the thursday in the target week
1449>>>>>>>>>    Move (Date(dValue) - dayNr +3) to target
1450>>>>>>>>>    Move ((target)) to firstThursday
1451>>>>>>>>>    
1451>>>>>>>>>    // Set the target to the first thursday of the year
1451>>>>>>>>>    // First set the target to january first
1451>>>>>>>>>    Move (DateSetMonth(target,1)) to target
1452>>>>>>>>>    Move (DateSetDay(target,1)) to target
1453>>>>>>>>>    // Not a thursday? Correct the date to the next thursday
1453>>>>>>>>>    Move (DateGetDayOfWeek(target)-1) to iDy
1454>>>>>>>>>    If (iDy<> 4) Begin
1456>>>>>>>>>        Move (DateSetDay(target,mod(4 - iDy + 7,7)+1)) to target
1457>>>>>>>>>    End
1457>>>>>>>>>>
1457>>>>>>>>>    
1457>>>>>>>>>    // The weeknumber is the number of weeks between the
1457>>>>>>>>>    // first thursday of the year and the thursday in the target week
1457>>>>>>>>>    Move (Date(firstThursday) - Date(target)) to iDiff
1458>>>>>>>>>    Move (iDiff / 7 + 1) to iWks
1459>>>>>>>>>    
1459>>>>>>>>>    If (iDiff/7.0<>iDiff/7) ;        Increment iWks
1462>>>>>>>>>    
1462>>>>>>>>>    Function_Return iWks
1463>>>>>>>>>End_Function

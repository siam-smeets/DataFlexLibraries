25844>>>>>>>>>>>
25844>>>>>>>>>>>    // Return the best index for this column. If -1, there is no good index
25844>>>>>>>>>>>
25844>>>>>>>>>>>    Function DefaultIndex Returns Integer
25846>>>>>>>>>>>        Integer iFile iField iMainFile iIndex iFieldIndex
25846>>>>>>>>>>>        Integer iRelField eRequestFindMode
25846>>>>>>>>>>>        Handle hoDDO
25846>>>>>>>>>>>  
25846>>>>>>>>>>>        Get Server to hoDDO
25847>>>>>>>>>>>        Get Data_File  to iFile
25848>>>>>>>>>>>        Get Data_Field to iField
25849>>>>>>>>>>>        
25849>>>>>>>>>>>        // If we are attached to a data binding then apply the data dictionary attributes....
25849>>>>>>>>>>>        If ((hoDDO = 0) or (iFile = 0)) Begin
25851>>>>>>>>>>>            Function_Return -1
25852>>>>>>>>>>>        End
25852>>>>>>>>>>>>
25852>>>>>>>>>>>
25852>>>>>>>>>>>        Get Main_File of hoDDO to iMainFile
25853>>>>>>>>>>>        
25853>>>>>>>>>>>        // we don't use the DD FieldIndex message because it respects a DD Ordering override
25853>>>>>>>>>>>        If (iField>0) Begin
25855>>>>>>>>>>>            Get_Attribute DF_FIELD_INDEX of iFile iField to iFieldIndex
25858>>>>>>>>>>>            Move (If(iFieldIndex=0,-1,iFieldIndex)) to iIndex
25859>>>>>>>>>>>        End
25859>>>>>>>>>>>>
25859>>>>>>>>>>>        Else Begin
25860>>>>>>>>>>>            Move 0 to iIndex // recnum index
25861>>>>>>>>>>>        End
25861>>>>>>>>>>>>
25861>>>>>>>>>>>        
25861>>>>>>>>>>>        If (iFile <> iMainFile and iIndex<>-1) Begin
25863>>>>>>>>>>>            // if field is not main-file, we normally don't sort but we allow
25863>>>>>>>>>>>            // one special mode for prompt lists that sorts on the main-file's
25863>>>>>>>>>>>            // index that relates to this parent
25863>>>>>>>>>>>            Delegate Get peRequestFindMode to eRequestFindMode
25865>>>>>>>>>>>            If (eRequestFindMode<>rfmFindMainSuper) Begin
25867>>>>>>>>>>>                Move -1 to iIndex
25868>>>>>>>>>>>            End
25868>>>>>>>>>>>>
25868>>>>>>>>>>>            Else Begin
25869>>>>>>>>>>>                // if non-main file and super find allowed we check for a super-find path
25869>>>>>>>>>>>                If (iIndex>=0) Begin
25871>>>>>>>>>>>                    // it has an index, now make that there is a relational link
25871>>>>>>>>>>>                    // between the main server file and this parent file. If not, no index
25871>>>>>>>>>>>                    Get RelatingField iFile to iRelField
25872>>>>>>>>>>>                    If (iRelField=-1) Begin
25874>>>>>>>>>>>                        Move -1 to iIndex
25875>>>>>>>>>>>                    End
25875>>>>>>>>>>>>
25875>>>>>>>>>>>                    Else Begin
25876>>>>>>>>>>>                        Get_Attribute DF_FIELD_INDEX of iMainFile iRelField to iIndex
25879>>>>>>>>>>>                    End
25879>>>>>>>>>>>>
25879>>>>>>>>>>>                End
25879>>>>>>>>>>>>
25879>>>>>>>>>>>
25879>>>>>>>>>>>            End
25879>>>>>>>>>>>>
25879>>>>>>>>>>>        End
25879>>>>>>>>>>>>
25879>>>>>>>>>>>        Function_Return iIndex    
25880>>>>>>>>>>>    End_Function
25881>>>>>>>>>>>    
25881>>>>>>>>>>>    
25881>>>>>>>>>>>    // Augmented to apply a pbSortable value for columns that are not already set
25881>>>>>>>>>>>    Procedure Attach_Deo_To_Server
25883>>>>>>>>>>>        Integer iIndex iSortable eDataType eFooterDataType iPrecision iFooterPrecision
25883>>>>>>>>>>>        Boolean bClientSortable
25883>>>>>>>>>>>        String sMask sFooterMask
25883>>>>>>>>>>>
25883>>>>>>>>>>>        Forward Send Attach_Deo_To_Server
25885>>>>>>>>>>>        
25885>>>>>>>>>>>        Get peDataType to eDataType
25886>>>>>>>>>>>        Get peFooterDataType to eFooterDataType
25887>>>>>>>>>>>        If (eFooterDataType = C_WebDefault) Begin
25889>>>>>>>>>>>            Set peFooterDataType to eDataType
25890>>>>>>>>>>>        End
25890>>>>>>>>>>>>
25890>>>>>>>>>>>        
25890>>>>>>>>>>>        Get psMask to sMask
25891>>>>>>>>>>>        Get psFooterMask to sFooterMask
25892>>>>>>>>>>>        If (sFooterMask = "") Begin
25894>>>>>>>>>>>            Set psFooterMask to sMask
25895>>>>>>>>>>>        End
25895>>>>>>>>>>>>
25895>>>>>>>>>>>         
25895>>>>>>>>>>>        Get piPrecision to iPrecision
25896>>>>>>>>>>>        Get piFooterPrecision to iFooterPrecision
25897>>>>>>>>>>>        If (iFooterPrecision = C_WebDefault) Begin
25899>>>>>>>>>>>            Set piFooterPrecision to iPrecision
25900>>>>>>>>>>>        End
25900>>>>>>>>>>>>
25900>>>>>>>>>>>
25900>>>>>>>>>>>        // need to set piDefaultIndex and pbSortable (if not explicitly set)
25900>>>>>>>>>>>        // find out who does the sorting, the client or the server
25900>>>>>>>>>>>        Delegate Get ClientSortable to bClientSortable
25902>>>>>>>>>>>        Get pbSortable to iSortable
25903>>>>>>>>>>>        
25903>>>>>>>>>>>        If (bClientSortable) Begin
25905>>>>>>>>>>>            // if client sorting, we dont care about piDefaultIndex
25905>>>>>>>>>>>            // and if  pbSortable is undefined, true is a good default
25905>>>>>>>>>>>            If (iSortable = C_WebDefault) Begin
25907>>>>>>>>>>>                Set pbSortable to True
25908>>>>>>>>>>>            End
25908>>>>>>>>>>>>
25908>>>>>>>>>>>        End
25908>>>>>>>>>>>>
25908>>>>>>>>>>>        Else Begin
25909>>>>>>>>>>>            
25909>>>>>>>>>>>            // if server sorting, we will set piDefaultIndex
25909>>>>>>>>>>>            // and if pbSortable is undefined, set it based on having an index
25909>>>>>>>>>>>            Get piDefaultIndex to iIndex
25910>>>>>>>>>>>            
25910>>>>>>>>>>>            If (iIndex = -1) Begin
25912>>>>>>>>>>>                Get DefaultIndex to iIndex
25913>>>>>>>>>>>                Set piDefaultIndex to iIndex 
25914>>>>>>>>>>>            End
25914>>>>>>>>>>>>
25914>>>>>>>>>>>            
25914>>>>>>>>>>>            // If the pbSortable is undefined, set a proper default for it
25914>>>>>>>>>>>            If (iSortable = C_WebDefault) Begin
25916>>>>>>>>>>>                Set pbSortable to (iIndex <> -1)
25917>>>>>>>>>>>            End
25917>>>>>>>>>>>>
25917>>>>>>>>>>>        End
25917>>>>>>>>>>>>
25917>>>>>>>>>>>
25917>>>>>>>>>>>    End_Procedure
25918>>>>>>>>>>>    
25918>>>>>>>>>>>    
25918>>>>>>>>>>>    // Sent after each DEO Object has been attached to its DDO server and had all the DDO field settings
25918>>>>>>>>>>>    // applied to its published properties. We will set default values to any cWebControl properties that
25918>>>>>>>>>>>    // are still unassigned...
25918>>>>>>>>>>>    Procedure AfterAttachDDO
25920>>>>>>>>>>>        Forward Send AfterAttachDDO
25922>>>>>>>>>>>        

29624>>>>>>>>>>>                        
29624>>>>>>>>>>>                        Send ReadChunk (&parsedata)            
29625>>>>>>>>>>>                    End
29626>>>>>>>>>>>>
29626>>>>>>>>>>>                    
29626>>>>>>>>>>>                    If (parsedata.iBoundPos > 0) Begin
29628>>>>>>>>>>>                        //  Cut off newline
29628>>>>>>>>>>>                        Move (parsedata.iBoundPos - 1) to iOffset
29629>>>>>>>>>>>                        If (Integer(parsedata.ucCurrentChunk[iOffset]) = 10) ;                            Decrement iOffset
29632>>>>>>>>>>>                        If (Integer(parsedata.ucCurrentChunk[iOffset]) = 13) ;                            Decrement iOffset

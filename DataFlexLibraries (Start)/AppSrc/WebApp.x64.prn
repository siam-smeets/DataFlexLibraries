31924>>>>>>>    Procedure AfterAttachDDO
31926>>>>>>>        // Sent after each DEO Object has been attached to its DDO server and had all the DDO field settings
31926>>>>>>>        // applied to its published properties. We will set default values to any cWebControl properties that
31926>>>>>>>        // are still unassigned...
31926>>>>>>>        String sChecked sUnchecked
31926>>>>>>>        
31926>>>>>>>        // Set default values for any unassigned properties
31926>>>>>>>        Forward Send AfterAttachDDO
31928>>>>>>>        
31928>>>>>>>        Get psChecked to sChecked
31929>>>>>>>        Get psUnchecked to sUnchecked
31930>>>>>>>        
31930>>>>>>>        // If both values are unassigned (null) then set them to default values.
31930>>>>>>>        If (Trim(sChecked) = "" and Trim(sUnchecked) = "") Begin
31932>>>>>>>            Set psChecked to "1"
31933>>>>>>>            Set psUnchecked to "0"
31934>>>>>>>        End
31934>>>>>>>>
31934>>>>>>>    End_Procedure
31935>>>>>>>    
31935>>>>>>>
31935>>>>>>>    Procedure Attach_Deo_To_Server
31937>>>>>>>        // Augmented to apply psCheckedValue & psUncheckedValue from the DDO's data binding...
31937>>>>>>>        Integer iFile iField
31937>>>>>>>        Handle hoDDO
31937>>>>>>>        String sValue
31937>>>>>>>
31937>>>>>>>        Forward Send Attach_Deo_To_Server
31939>>>>>>>
31939>>>>>>>        Get Server to hoDDO
31940>>>>>>>        Get Data_File  to iFile
31941>>>>>>>        Get Data_Field to iField
31942>>>>>>>        
31942>>>>>>>        // If we are attached to a data binding then apply the data dictionary attributes....
31942>>>>>>>        If ((hoDDO <> 0) and (iFile <> 0)) Begin
31944>>>>>>>            // Apply data binding's File_Field_Checkbox_Value setings....
31944>>>>>>>            Get psChecked to sValue
31945>>>>>>>            
31945>>>>>>>            If (Trim(sValue) = "") Begin    // Only apply data binding is there is no explicit setting
31947>>>>>>>                Get File_Field_CheckBox_Value of hoDDO iFile iField True to sValue
31948>>>>>>>                Set psChecked to sValue
31949>>>>>>>            End
31949>>>>>>>>
31949>>>>>>>            
31949>>>>>>>            Get psUnchecked to sValue
31950>>>>>>>            
31950>>>>>>>            If (Trim(sValue) = "") Begin    // Only apply data binding is there is no explicit setting
31952>>>>>>>                Get File_Field_CheckBox_Value of hoDDO iFile iField False to sValue
31953>>>>>>>                Set psUnchecked to sValue
31954>>>>>>>            End
31954>>>>>>>>
31954>>>>>>>        End
31954>>>>>>>>
31954>>>>>>>    End_Procedure
31955>>>>>>>End_Class

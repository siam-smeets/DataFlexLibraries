17553>>>>>>>>>>>    // Returns the object handle of the first child web control with a data binding
17553>>>>>>>>>>>    // matching the passed Table.column (file & field). 
17553>>>>>>>>>>>    //
17553>>>>>>>>>>>    // This is a Recursive Function, you call it the first time passing the object 
17553>>>>>>>>>>>    // handle of a cWebView (or other window) as hoParent. It will recursively
17553>>>>>>>>>>>    // search the children of the view. It is assumed the view itself is not the
17553>>>>>>>>>>>    // object we are looking for.
17553>>>>>>>>>>>    //
17553>>>>>>>>>>>    // hoParent - Is the view containing the cWebControl objects to be searched.
17553>>>>>>>>>>>    // iFile  - Is the data binding table number we are looking for.
17553>>>>>>>>>>>    // iField - Is the data binding column we are looking for.
17553>>>>>>>>>>>    // Returns - The object handle of the first matching child web control.
17553>>>>>>>>>>>    Function FirstControlWithDataBinding Integer iFile Integer iField Returns Handle
17555>>>>>>>>>>>        Integer iTestFile iTestField
17555>>>>>>>>>>>        Integer i icWebObject
17555>>>>>>>>>>>        Boolean bDataBindable
17555>>>>>>>>>>>        Handle hoTarget
17555>>>>>>>>>>>        Handle[] aChildWebControls
17556>>>>>>>>>>>        
17556>>>>>>>>>>>        // Iterate and test the parent's children....
17556>>>>>>>>>>>        Get paChildWebControls to aChildWebControls
17557>>>>>>>>>>>        Move (SizeOfArray(aChildWebControls)) to icWebObject
17558>>>>>>>>>>>        
17558>>>>>>>>>>>        For i from 0 to (icWebObject - 1)
17564>>>>>>>>>>>>
17564>>>>>>>>>>>            Get pbDataBindable of aChildWebControls[i] to bDataBindable
17565>>>>>>>>>>>            
17565>>>>>>>>>>>            If (bDataBindable) Begin
17567>>>>>>>>>>>                Get Data_File  of aChildWebControls[i] to iTestFile
17568>>>>>>>>>>>                Get Data_Field of aChildWebControls[i] to iTestField
17569>>>>>>>>>>>                
17569>>>>>>>>>>>                If ((iTestFile = iFile) and (iTestField = iField)) Begin
17571>>>>>>>>>>>                    Function_Return aChildWebControls[i]
17572>>>>>>>>>>>                End
17572>>>>>>>>>>>>
17572>>>>>>>>>>>            End
17572>>>>>>>>>>>>
17572>>>>>>>>>>>        Loop
17573>>>>>>>>>>>>
17573>>>>>>>>>>>        
17573>>>>>>>>>>>        // If we got to this point then we need to look deeper by recursing
17573>>>>>>>>>>>        // into the child objects....
17573>>>>>>>>>>>        For i from 0 to (icWebObject - 1)
17579>>>>>>>>>>>>
17579>>>>>>>>>>>            Get FirstControlWithDataBinding of aChildWebControls[i] iFile iField to hoTarget
17580>>>>>>>>>>>            
17580>>>>>>>>>>>            If (hoTarget <> C_WebUnresolvedObject) Begin
17582>>>>>>>>>>>                Function_Return hoTarget
17583>>>>>>>>>>>            End
17583>>>>>>>>>>>>
17583>>>>>>>>>>>        Loop
17584>>>>>>>>>>>>
17584>>>>>>>>>>>        
17584>>>>>>>>>>>        Function_Return C_WebUnresolvedObject
17585>>>>>>>>>>>    End_Function

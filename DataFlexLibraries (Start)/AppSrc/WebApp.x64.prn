39577>>>    // This can be used to show and hide buttons based on context.
39577>>>    // This can be called any time the view is active.
39577>>>    Procedure SetActionButtons
39580>>>        tWebNavigateData NavigateData
39580>>>        tWebNavigateData NavigateData
39580>>>        Boolean bHasRecord
39580>>>        Handle hoDD
39580>>>
39580>>>        Get Server to hoDD
39581>>>        Get GetNavigateData to NavigateData
39582>>>        
39582>>>        If (hoDD) Begin
39584>>>            Get HasRecord of hoDD to bHasRecord
39585>>>        End
39585>>>>
39585>>>        Else Begin
39586>>>            Move False to bHasRecord
39587>>>        End
39587>>>>
39587>>>
39587>>>        // let's hide all buttons and then show the ones we want
39587>>>        WebSet pbRender of oEditBtn to False 
39588>>>        WebSet pbRender of oSaveBtn to False
39589>>>        WebSet pbRender of oCancelChangesBtn to False
39590>>>        WebSet pbRender of oDeleteBtn to False
39591>>>
39591>>>        If (NavigateData.bReadOnly) Begin 
39593>>>            WebSet pbRender of oEditBtn to True 
39594>>>        End
39594>>>>
39594>>>        Else Begin
39595>>>            WebSet pbRender of oSaveBtn to True
39596>>>            WebSet pbRender of oCancelChangesBtn to True
39597>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39598>>>        End
39598>>>>
39598>>>    End_Procedure

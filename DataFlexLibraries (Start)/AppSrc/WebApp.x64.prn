19345>>>>>>>>>>>>>>>
19345>>>>>>>>>>>>>>>// Supports:
19345>>>>>>>>>>>>>>>// - User changable value.
19345>>>>>>>>>>>>>>>// - Apply DD attributes (Field Options, Mask, Datatyle, length, etc.
19345>>>>>>>>>>>>>>>// - DDO request interface (Request_Find, Next, Previous, First, Last, Save, Delete, Clear, etc).
19345>>>>>>>>>>>>>>>//
19345>>>>>>>>>>>>>>>// Not Supported:
19345>>>>>>>>>>>>>>>// - Set Currency_Mask and Set Numeric_Mask interfaces are not supported. This is a confusing interface
19345>>>>>>>>>>>>>>>//   as it sets several properties and it is not possible to model in the Studio. It is better and more
19345>>>>>>>>>>>>>>>//   clear to just set each individual property as required psMask, peDataType and piMaxLength.
19345>>>>>>>>>>>>>>>Class cWebBaseDEO is a cWebBaseControl
19346>>>>>>>>>>>>>>>    
19346>>>>>>>>>>>>>>>    Procedure Construct_Object
19348>>>>>>>>>>>>>>>        Forward Send Construct_Object
19350>>>>>>>>>>>>>>>
19350>>>>>>>>>>>>>>>        // these can be set via entry_item command....
19350>>>>>>>>>>>>>>>        Property Integer private_Data_File 0    // The binding table
19351>>>>>>>>>>>>>>>        Property Integer private_Data_Field 0   // The binding table column
19352>>>>>>>>>>>>>>>        Property Boolean private_pbIgnoreOnValueChanged False   // Used when setting Field_Changed_Value on the DDO. This prevents processing the resulting File_Field_Value_Changed event.
19353>>>>>>>>>>>>>>>        Property Handle phoPrompt 0
19354>>>>>>>>>>>>>>>        
19354>>>>>>>>>>>>>>>        // Set true to stop DEOs from web-setting pbEnabled statically based
19354>>>>>>>>>>>>>>>        // on the state of the DDO
19354>>>>>>>>>>>>>>>        Property Boolean pbEnabledStatic False        
19355>>>>>>>>>>>>>>>
19355>>>>>>>>>>>>>>>        // Published Properties....
19355>>>>>>>>>>>>>>>        Property Integer pbCapslock C_WebDefault     // True if DD_Capslock. Set by data binding.
19358>>>>>>>>>>>>>>>        Property Boolean pbChanged False             // True if the value was changed on the client
19361>>>>>>>>>>>>>>>        Property Boolean pbFieldDefault False        // True if the value was set as a default value (Field_Default_Value)
19364>>>>>>>>>>>>>>>        Property Integer pbRequired C_WebDefault     // True if a non-null value is required to be entered. Set by data binding.
19367>>>>>>>>>>>>>>>        Property Integer peAlign C_WebDefault        // Text alignment - alLeft, alRight, alCenter  ("not" set by DDO data binding. Usually the datatype will automatically determine the alignment but this property can override the automatic alignment)
19370>>>>>>>>>>>>>>>        Property Integer peDataType C_WebDefault     // Determines the data type of the control's psValue data. Set by data binding.
19373>>>>>>>>>>>>>>>        Property Boolean pbLimitDateRange True       // If true the client will limit dates to fit the DataFlex Date type (0001-01-01 -- 2500-01-1). Setting this to false can cause conversion errors.
19376>>>>>>>>>>>>>>>        
19376>>>>>>>>>>>>>>>        Property Integer piMaxLength C_WebDefault    // Max number of characters that can be entered into this control. Set by data binding.
19379>>>>>>>>>>>>>>>        Property Integer piPrecision C_WebDefault    // Max number of numbers that can be entered after the decimal point for a numeric data type.
19382>>>>>>>>>>>>>>>        Property String psMask ""                    // The mask string for this control. Set by data binding.
19385>>>>>>>>>>>>>>>        Property String psValue ""                   // The value that is displayed in the control. Note: depending on the peDataType, the value may be formatted for data transfer, e.g. for typeDate, value is stored in universal format for transferring dates: yyyy-mm-dd.
19388>>>>>>>>>>>>>>>        
19388>>>>>>>>>>>>>>>        Property Boolean pbHasControlError False    // Indicates it the client is showing errors, used as optimization to prevent a ClearControlErrors to be sent for every field cahnge
19391>>>>>>>>>>>>>>>        
19391>>>>>>>>>>>>>>>        Property Integer pbServerOnValidate C_WebDefault
19394>>>>>>>>>>>>>>>        Property String psClientOnValidate ""
19397>>>>>>>>>>>>>>>        Property Boolean pbServerOnChange False
19400>>>>>>>>>>>>>>>        Property String psClientOnChange ""
19403>>>>>>>>>>>>>>>        
19403>>>>>>>>>>>>>>>        Property Integer pbServerOnAutoFind C_WebDefault
19406>>>>>>>>>>>>>>>        Property String psClientOnAutoFind ""
19409>>>>>>>>>>>>>>>        
19409>>>>>>>>>>>>>>>        Property Boolean pbNoUpdateIfHidden True
19410>>>>>>>>>>>>>>>        Property Boolean pbNoFillIfHidden True
19411>>>>>>>>>>>>>>>
19411>>>>>>>>>>>>>>>        Set pbDataBindable to True
19412>>>>>>>>>>>>>>>    End_Procedure
19413>>>>>>>>>>>>>>>    
19413>>>>>>>>>>>>>>>    Import_Class_Protocol find_edit_mixin
19414>>>>>>>>>>>>>>>    
19414>>>>>>>>>>>>>>>    // Mark as DEO
19414>>>>>>>>>>>>>>>    Function DEO_Object Returns Boolean
19416>>>>>>>>>>>>>>>        // all web objects should understand this message. Will be set True in sub-classes
19416>>>>>>>>>>>>>>>        Function_Return True
19417>>>>>>>>>>>>>>>    End_Function
19418>>>>>>>>>>>>>>>    
19418>>>>>>>>>>>>>>>    // Mark as DEO
19418>>>>>>>>>>>>>>>    Function DEO_Control_Object Returns Boolean
19420>>>>>>>>>>>>>>>        Function_Return True
19421>>>>>>>>>>>>>>>    End_Function
19422>>>>>>>>>>>>>>>    
19422>>>>>>>>>>>>>>>    //  Called to check if filling the DEO with data is allowed. Calls AllowFillDEO to determine.
19422>>>>>>>>>>>>>>>    Function FillDEOAllowed Returns Boolean
19424>>>>>>>>>>>>>>>        Boolean bAllow
19424>>>>>>>>>>>>>>>        
19424>>>>>>>>>>>>>>>        Move True to bAllow
19425>>>>>>>>>>>>>>>        Send AllowFillDEO (&bAllow)
19426>>>>>>>>>>>>>>>        
19426>>>>>>>>>>>>>>>        Function_Return bAllow
19427>>>>>>>>>>>>>>>    End_Function
19428>>>>>>>>>>>>>>>    
19428>>>>>>>>>>>>>>>    //  Called to check if updating the DD with data is allowed. Calls AllowUpdateDD to determine.
19428>>>>>>>>>>>>>>>    Function UpdateDDAllowed Returns Boolean
19430>>>>>>>>>>>>>>>        Boolean bAllow
19430>>>>>>>>>>>>>>>        
19430>>>>>>>>>>>>>>>        Move True to bAllow
19431>>>>>>>>>>>>>>>        Send AllowUpdateDD (&bAllow)
19432>>>>>>>>>>>>>>>        
19432>>>>>>>>>>>>>>>        Function_Return bAllow
19433>>>>>>>>>>>>>>>    End_Function
19434>>>>>>>>>>>>>>>    
19434>>>>>>>>>>>>>>>    
19434>>>>>>>>>>>>>>>    // Sent after each DEO Object has been attached to its DDO server and had all the DDO field settings
19434>>>>>>>>>>>>>>>    // applied to its published properties. We will set default values to any cWebControl properties that
19434>>>>>>>>>>>>>>>    // are still unassigned...
19434>>>>>>>>>>>>>>>    Procedure AfterAttachDDO
19436>>>>>>>>>>>>>>>        Integer iValue
19436>>>>>>>>>>>>>>>        String sValue
19436>>>>>>>>>>>>>>>        
19436>>>>>>>>>>>>>>>        // Set default values for any unassigned properties
19436>>>>>>>>>>>>>>>        Get pbServerOnAutoFind to iValue
19437>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19439>>>>>>>>>>>>>>>            Set pbServerOnAutoFind to False
19440>>>>>>>>>>>>>>>        End
19440>>>>>>>>>>>>>>>>
19440>>>>>>>>>>>>>>>
19440>>>>>>>>>>>>>>>        Get pbCapslock to iValue
19441>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19443>>>>>>>>>>>>>>>            Set pbCapslock to False
19444>>>>>>>>>>>>>>>        End
19444>>>>>>>>>>>>>>>>
19444>>>>>>>>>>>>>>>
19444>>>>>>>>>>>>>>>        Get pbRequired to iValue
19445>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19447>>>>>>>>>>>>>>>            Set pbRequired to False
19448>>>>>>>>>>>>>>>        End
19448>>>>>>>>>>>>>>>>
19448>>>>>>>>>>>>>>>
19448>>>>>>>>>>>>>>>        Get peDataType to iValue
19449>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19451>>>>>>>>>>>>>>>            Set peDataType to typeASCII
19452>>>>>>>>>>>>>>>        End
19452>>>>>>>>>>>>>>>>
19452>>>>>>>>>>>>>>>
19452>>>>>>>>>>>>>>>        Get piMaxLength to iValue
19453>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19455>>>>>>>>>>>>>>>            Set piMaxLength to 32768
19456>>>>>>>>>>>>>>>        End
19456>>>>>>>>>>>>>>>>
19456>>>>>>>>>>>>>>>
19456>>>>>>>>>>>>>>>        Get piPrecision to iValue
19457>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
19459>>>>>>>>>>>>>>>            Set piPrecision to 0
19460>>>>>>>>>>>>>>>        End
19460>>>>>>>>>>>>>>>>
19460>>>>>>>>>>>>>>>        
19460>>>>>>>>>>>>>>>        Get psMask to sValue
19461>>>>>>>>>>>>>>>        If (sValue = String(C_WebDefault)) Begin
19463>>>>>>>>>>>>>>>            Set psMask to ""
19464>>>>>>>>>>>>>>>        End
19464>>>>>>>>>>>>>>>>
19464>>>>>>>>>>>>>>>    End_Procedure
19465>>>>>>>>>>>>>>>
19465>>>>>>>>>>>>>>>    // Augmented to set all of the various properties controlled by the DDO. This is triggered when a data-bound
19465>>>>>>>>>>>>>>>    // control 
19465>>>>>>>>>>>>>>>    Procedure Attach_Deo_To_Server
19467>>>>>>>>>>>>>>>        Integer iFile iField iMaxLength iPrecision iDDOOptions iValue
19467>>>>>>>>>>>>>>>        Integer eFieldType eMaskType eDataType iValidateMSG
19467>>>>>>>>>>>>>>>        String sMask sLabel sTooltip sValue
19467>>>>>>>>>>>>>>>        Boolean bAutoFind bAutoFindGE bCapslock bRequired bNoEnter bZeroSuppress bFindRequired
19467>>>>>>>>>>>>>>>        Boolean bAutoLabelState bStatic
19467>>>>>>>>>>>>>>>        Handle hoDDO hoFileDDO
19467>>>>>>>>>>>>>>>
19467>>>>>>>>>>>>>>>        Forward Send Attach_Deo_To_Server
19469>>>>>>>>>>>>>>>
19469>>>>>>>>>>>>>>>        Get Server to hoDDO
19470>>>>>>>>>>>>>>>        Get Data_File  to iFile
19471>>>>>>>>>>>>>>>        Get Data_Field to iField
19472>>>>>>>>>>>>>>>        
19472>>>>>>>>>>>>>>>        // If we are attached to a data binding then apply all the data dictionary attributes....
19472>>>>>>>>>>>>>>>        If ((hoDDO <> 0) and (iFile <> 0)) Begin
19474>>>>>>>>>>>>>>>            Get Data_Set of hoDDO iFile to hoFileDDO    // Get the file's DDO
19475>>>>>>>>>>>>>>>            
19475>>>>>>>>>>>>>>>            // Field Options
19475>>>>>>>>>>>>>>>            Get File_Field_Options of hoDDO iFile iField to iDDOOptions
19476>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_AutoFind, iDDOOptions))      to bAutoFind
19477>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_AutoFind_GE, iDDOOptions))   to bAutoFindGE
19478>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_CapsLock, iDDOOptions))      to bCapslock
19479>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_NoEnter, iDDOOptions))       to bNoEnter
19480>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_Required, iDDOOptions))      to bRequired
19481>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_Zero_Suppress, iDDOOptions)) to bZeroSuppress
19482>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_FindReq, iDDOOptions))       to bFindRequired
19483>>>>>>>>>>>>>>>
19483>>>>>>>>>>>>>>>            // Set the DEO properties....
19483>>>>>>>>>>>>>>>            Get pbServerOnAutoFind to iValue
19484>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19486>>>>>>>>>>>>>>>                Set pbServerOnAutoFind to (bAutoFind or bAutoFindGE)
19487>>>>>>>>>>>>>>>            End
19487>>>>>>>>>>>>>>>>
19487>>>>>>>>>>>>>>>            
19487>>>>>>>>>>>>>>>            Get pbCapslock to iValue
19488>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19490>>>>>>>>>>>>>>>                Set pbCapslock to bCapslock
19491>>>>>>>>>>>>>>>            End
19491>>>>>>>>>>>>>>>>
19491>>>>>>>>>>>>>>>            
19491>>>>>>>>>>>>>>>            Get pbRequired to iValue
19492>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19494>>>>>>>>>>>>>>>                /*                We do not set pbRequired for parent fields because this will prevent clearing of                 the parent using autofind. We will set pbServerOnValidate to true so that the DD                 will still give the error when tabbing out of the field (the DD also looks at the                 changed-state to determine if it is really nessecary).                */
19494>>>>>>>>>>>>>>>                Set pbRequired to (bRequired and (hoFileDDO = hoDDO))
19495>>>>>>>>>>>>>>>            End
19495>>>>>>>>>>>>>>>>
19495>>>>>>>>>>>>>>>            
19495>>>>>>>>>>>>>>>            Get pbEnabledStatic to bStatic
19496>>>>>>>>>>>>>>>            If (not(bStatic) and bNoEnter) Begin
19498>>>>>>>>>>>>>>>                // Only disable if bNoEnter is True. Otherwise respect the current pbEnabled state...
19498>>>>>>>>>>>>>>>                Set pbEnabled to False
19499>>>>>>>>>>>>>>>            End
19499>>>>>>>>>>>>>>>>
19499>>>>>>>>>>>>>>>           
19499>>>>>>>>>>>>>>>            // handle tool tip...
19499>>>>>>>>>>>>>>>            Get psToolTip to sToolTip
19500>>>>>>>>>>>>>>>            If (sToolTip = "") Begin    // only change the tooltip if it is not already set
19502>>>>>>>>>>>>>>>                Get File_Field_Status_Help of hoDDO iFile iField to sToolTip
19503>>>>>>>>>>>>>>>                Set psToolTip to sToolTip
19504>>>>>>>>>>>>>>>            End
19504>>>>>>>>>>>>>>>>
19504>>>>>>>>>>>>>>>            
19504>>>>>>>>>>>>>>>            // Set peDataType, psMask, piMaxLength, piPrecision
19504>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_TYPE   of iFile iField to eFieldType    // the type of the column
19507>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_LENGTH of iFile iField to iMaxLength    // max number of characters of the column
19510>>>>>>>>>>>>>>>            Get File_Field_Mask_Type of hoDDO iFile iField to eMaskType    // the type specified in the DDO
19511>>>>>>>>>>>>>>>            Get File_Field_Mask      of hoDDO iFile iField to sMask        // the mask string specified in the DDO
19512>>>>>>>>>>>>>>>
19512>>>>>>>>>>>>>>>            Case Begin
19512>>>>>>>>>>>>>>>                Case (eFieldType = DF_BCD)
19514>>>>>>>>>>>>>>>                    Get_Attribute DF_FIELD_PRECISION of iFile iField to iPrecision
19517>>>>>>>>>>>>>>>                    Move typeNumber to eDataType 
19518>>>>>>>>>>>>>>>                    Case Break
19519>>>>>>>>>>>>>>>                   
19519>>>>>>>>>>>>>>>                Case (eFieldType = DF_DATE)
19522>>>>>>>>>>>>>>>                    Move typeDate to eDataType
19523>>>>>>>>>>>>>>>                    Move 10 to iMaxLength
19524>>>>>>>>>>>>>>>                    Case Break
19525>>>>>>>>>>>>>>>                   
19525>>>>>>>>>>>>>>>                Case (eFieldType = DF_DATETIME)
19528>>>>>>>>>>>>>>>                    Move typeDateTime to eDataType
19529>>>>>>>>>>>>>>>                    Move 26 to iMaxLength              // should be enough for "mm/dd/yyyy hh:mm:ss.fff pm"
19530>>>>>>>>>>>>>>>                    Case Break
19531>>>>>>>>>>>>>>>          
19531>>>>>>>>>>>>>>>                Case (eFieldType = DF_ASCII)
19534>>>>>>>>>>>>>>>                Case Else
19534>>>>>>>>>>>>>>>                    Move typeASCII to eDataType
19535>>>>>>>>>>>>>>>                    Case Break
19536>>>>>>>>>>>>>>>            Case End           
19536>>>>>>>>>>>>>>>
19536>>>>>>>>>>>>>>>            // if the mask is blank but the field type is numeric or currency
19536>>>>>>>>>>>>>>>            // we will build an automatic mask based on our default mask
19536>>>>>>>>>>>>>>>            If (eMaskType = Mask_Numeric_Window or eMaskType = Mask_Currency_Window and sMask = '') Begin
19538>>>>>>>>>>>>>>>                If (eMaskType = Mask_Numeric_Window) Begin
19540>>>>>>>>>>>>>>>                    Move (Field_Number_Default_Mask( iFile, iField, "*")) to sMask
19541>>>>>>>>>>>>>>>                End
19541>>>>>>>>>>>>>>>>
19541>>>>>>>>>>>>>>>                Else Begin
19542>>>>>>>>>>>>>>>                    Move (Field_Number_Default_Mask( iFile, iField, "&curren;,*;(&curren;,*)")) to sMask
19543>>>>>>>>>>>>>>>                End
19543>>>>>>>>>>>>>>>>
19543>>>>>>>>>>>>>>>            End
19543>>>>>>>>>>>>>>>>
19543>>>>>>>>>>>>>>>
19543>>>>>>>>>>>>>>>            // If zero-suppress add a "Z" to first char of mask only if Z is not already there.
19543>>>>>>>>>>>>>>>            If (bZeroSuppress) Begin
19545>>>>>>>>>>>>>>>                If ((sMask <> "") and (Left(sMask,1) <> "Z") ) Begin
19547>>>>>>>>>>>>>>>                    Move ("Z" + sMask) to sMask
19548>>>>>>>>>>>>>>>                End
19548>>>>>>>>>>>>>>>>
19548>>>>>>>>>>>>>>>            End
19548>>>>>>>>>>>>>>>>
19548>>>>>>>>>>>>>>>            
19548>>>>>>>>>>>>>>>            // Enable server side validation if Field_Validate_msg available
19548>>>>>>>>>>>>>>>            Move 0 to iValidateMSG
19549>>>>>>>>>>>>>>>            If (hoDDO = hoFileDDO) Begin    // If this is not a "foreign-field"
19551>>>>>>>>>>>>>>>                Get Field_Validate_msg of hoDDO iField to iValidateMSG
19552>>>>>>>>>>>>>>>            End
19552>>>>>>>>>>>>>>>>
19552>>>>>>>>>>>>>>>            
19552>>>>>>>>>>>>>>>            Get pbServerOnValidate to iValue
19553>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19555>>>>>>>>>>>>>>>                //  We enable pbServerOnValidate for required parent fields because they can't use client-side pbRequired validation
19555>>>>>>>>>>>>>>>                Set pbServerOnValidate to ((iValidateMSG <> 0) or bFindRequired or (bRequired and (hoFileDDO <> hoDDO)))
19556>>>>>>>>>>>>>>>            End
19556>>>>>>>>>>>>>>>>
19556>>>>>>>>>>>>>>>
19556>>>>>>>>>>>>>>>            // Set the DEO properties
19556>>>>>>>>>>>>>>>            Get peDataType to iValue
19557>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19559>>>>>>>>>>>>>>>                Set peDataType to eDataType
19560>>>>>>>>>>>>>>>            End
19560>>>>>>>>>>>>>>>>
19560>>>>>>>>>>>>>>>
19560>>>>>>>>>>>>>>>            Get piMaxLength to iValue
19561>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19563>>>>>>>>>>>>>>>                Set piMaxLength to iMaxLength
19564>>>>>>>>>>>>>>>            End
19564>>>>>>>>>>>>>>>>
19564>>>>>>>>>>>>>>>    
19564>>>>>>>>>>>>>>>            Get piPrecision to iValue
19565>>>>>>>>>>>>>>>            If (iValue = C_WebDefault) Begin
19567>>>>>>>>>>>>>>>                Set piPrecision to iPrecision
19568>>>>>>>>>>>>>>>            End
19568>>>>>>>>>>>>>>>>
19568>>>>>>>>>>>>>>>            
19568>>>>>>>>>>>>>>>            Get psMask to sValue
19569>>>>>>>>>>>>>>>            If (sValue = "") Begin
19571>>>>>>>>>>>>>>>                Set psMask to sMask
19572>>>>>>>>>>>>>>>            End
19572>>>>>>>>>>>>>>>>
19572>>>>>>>>>>>>>>>        End
19572>>>>>>>>>>>>>>>>
19572>>>>>>>>>>>>>>>    End_Procedure
19573>>>>>>>>>>>>>>>
19573>>>>>>>>>>>>>>>    
19573>>>>>>>>>>>>>>>    // Private: Returns the autofind mode for the column's data binding.
19573>>>>>>>>>>>>>>>    // (See DoAutoFind)
19573>>>>>>>>>>>>>>>    Function AutoFindMode Returns Integer
19575>>>>>>>>>>>>>>>        Handle hoDD 
19575>>>>>>>>>>>>>>>        Integer iFile iField iOpts bOn
19575>>>>>>>>>>>>>>>
19575>>>>>>>>>>>>>>>        Get Data_File to iFile
19576>>>>>>>>>>>>>>>        Get Data_Field to iField
19577>>>>>>>>>>>>>>>        Get Server to hoDD
19578>>>>>>>>>>>>>>>        
19578>>>>>>>>>>>>>>>        If (hoDD <> 0 and iFile <> 0) Begin
19580>>>>>>>>>>>>>>>            Get File_Field_Options of hoDD iFile iField to iOpts
19581>>>>>>>>>>>>>>>            
19581>>>>>>>>>>>>>>>            If ((iOpts iand DD_AUTOFIND_GE) = DD_AUTOFIND_GE) ;                Function_Return amAutoFindGE
19584>>>>>>>>>>>>>>>            Else If ((iOpts iand DD_AUTOFIND) = DD_AUTOFIND) ;                Function_Return amAutoFindEQ
19588>>>>>>>>>>>>>>>        End
19588>>>>>>>>>>>>>>>>
19588>>>>>>>>>>>>>>>        Function_Return amNoAutoFind
19589>>>>>>>>>>>>>>>    End_Function
19590>>>>>>>>>>>>>>>
19590>>>>>>>>>>>>>>>
19590>>>>>>>>>>>>>>>    // this will be sent by the Entry_item command
19590>>>>>>>>>>>>>>>    Procedure Bind_Data Integer iFile Integer iField
19592>>>>>>>>>>>>>>>        Set Data_File to iFile
19593>>>>>>>>>>>>>>>        Set Data_Field to iField
19594>>>>>>>>>>>>>>>    End_Procedure
19595>>>>>>>>>>>>>>>    
19595>>>>>>>>>>>>>>>    
19595>>>>>>>>>>>>>>>    // required DD/DEO interface
19595>>>>>>>>>>>>>>>    Function Checkbox_Item_State Integer iItem Returns Integer
19597>>>>>>>>>>>>>>>        // not used in cWebControl
19597>>>>>>>>>>>>>>>    End_Function  
19598>>>>>>>>>>>>>>>
19598>>>>>>>>>>>>>>>    Function ConvertFromTransport Handle hmGetter String sValue Integer eType Returns String
19600>>>>>>>>>>>>>>>        // This function converts a Web Property value from the generic format appropriate for
19600>>>>>>>>>>>>>>>        // transport. For example a data value should be converted from XML transport format 
19600>>>>>>>>>>>>>>>        // for dates. e.g. European "2013-03-24" is converted into "24/03/2013"
19600>>>>>>>>>>>>>>>        //                 USA      "2013-03-24" is converted into "03/24/2013"
19600>>>>>>>>>>>>>>>        // The parameters sName, sValue are the property name and property value being sent from the client.
19600>>>>>>>>>>>>>>>        // Returns the property value that is converted to server format.
19600>>>>>>>>>>>>>>>        // For most properties this function does nothing. You can augment this function to do special
19600>>>>>>>>>>>>>>>        // conversions for new WebProperties that you create.
19600>>>>>>>>>>>>>>>        // See also ConvertToTransport.
19600>>>>>>>>>>>>>>>        String sReturn
19600>>>>>>>>>>>>>>>        Integer eDataType
19600>>>>>>>>>>>>>>>        
19600>>>>>>>>>>>>>>>        Forward Get ConvertFromTransport hmGetter sValue eType to sReturn
19602>>>>>>>>>>>>>>>
19602>>>>>>>>>>>>>>>        // Test for special property "psValue"....
19602>>>>>>>>>>>>>>>        If (hmGetter = RefFunc(psValue)) Begin
19604>>>>>>>>>>>>>>>            // Test if the value represents a number, date or datetime. If so we must convert
19604>>>>>>>>>>>>>>>            // the value into a universal format for transferring it to the client....
19604>>>>>>>>>>>>>>>            Get peDataType to eDataType   // If the object supports psValue it should also support peDataType. If not peDataType will get delegated to ghoWebApp and return typeASCII.
19605>>>>>>>>>>>>>>>            // Note: For efficienty we do not WebGet peDataType! In other words we do not
19605>>>>>>>>>>>>>>>            // get the "synchronized copy of peDataType (if there is one). This is much more
19605>>>>>>>>>>>>>>>            // efficient but it also assumes that a control's peDataType does not change 
19605>>>>>>>>>>>>>>>            // dynamically. This should be OK....
19605>>>>>>>>>>>>>>>            CVTLOCALIZATION ON      //  WebGet turns localization OFF, but for psValue we want it ON as this is a string property
19606>>>>>>>>>>>>>>>                                    //  Note: This means that we have to keep CVTLOCALIZATION private, since we now turn it ON twice 
19606>>>>>>>>>>>>>>>                                    //  while turning it OFF once. That is no problem as it never goes below 0, until other code will start using it.
19606>>>>>>>>>>>>>>>            Move (ConvertFromClient(eDataType, sValue)) to sReturn
19607>>>>>>>>>>>>>>>            
19607>>>>>>>>>>>>>>>        End
19607>>>>>>>>>>>>>>>>
19607>>>>>>>>>>>>>>>        
19607>>>>>>>>>>>>>>>        Function_Return sReturn
19608>>>>>>>>>>>>>>>    End_Function
19609>>>>>>>>>>>>>>>
19609>>>>>>>>>>>>>>>    Function ConvertToTransport Handle hmGetter Variant vValue Integer iType  Returns String
19611>>>>>>>>>>>>>>>        // This function converts a Web Property value into a generic format appropriate for
19611>>>>>>>>>>>>>>>        // transport to the client. For example a data value should be converted into XML transport format 
19611>>>>>>>>>>>>>>>        // for dates. e.g. European "24/03/2013" is converted into "2013-03-24"
19611>>>>>>>>>>>>>>>        //                 USA      "03/24/2013" is converted into "2013-03-24"
19611>>>>>>>>>>>>>>>        // The parameters sName, sValue are the property name and property value being sent to the client.
19611>>>>>>>>>>>>>>>        // Returns the property value that is converted for transport.
19611>>>>>>>>>>>>>>>        // For most properties this function does nothing. You can augment this function to do special
19611>>>>>>>>>>>>>>>        // conversions for new WebProperties that you create.
19611>>>>>>>>>>>>>>>        // See also ConvertFromTransport.
19611>>>>>>>>>>>>>>>        String sReturn
19611>>>>>>>>>>>>>>>        Integer eDataType
19611>>>>>>>>>>>>>>>        
19611>>>>>>>>>>>>>>>        // Test for special property "psValue"....
19611>>>>>>>>>>>>>>>        If (hmGetter = RefFunc(psValue)) Begin
19613>>>>>>>>>>>>>>>            // Test if the value represents a number, date or datetime. If so we must convert
19613>>>>>>>>>>>>>>>            // the value into a universal format for transferring it to the client....
19613>>>>>>>>>>>>>>>            Get peDataType to eDataType   // If the object supports psValue it should also support peDataType. If not peDataType will get delegated to ghoWebApp and return typeASCII.
19614>>>>>>>>>>>>>>>            // Note: For efficienty we do not WebGet peDataType! In other words we do not
19614>>>>>>>>>>>>>>>            // get the "synchronized copy of peDataType (if there is one). This is much more
19614>>>>>>>>>>>>>>>            // efficient but it also assumes that a control's peDataType does not change 
19614>>>>>>>>>>>>>>>            // dynamically. This should be OK....
19614>>>>>>>>>>>>>>>            CVTLOCALIZATION ON      //  SerializeObject turns localization OFF, but for psValue we want it ON as this is a string property
19615>>>>>>>>>>>>>>>                        //  Note: This means that we have to keep CVTLOCALIZATION private, since we now turn it ON twice 
19615>>>>>>>>>>>>>>>                        //  while turning it OFF once. That is no problem as it never goes below 0, until other code will start using it.
19615>>>>>>>>>>>>>>>            Move (ConvertToClient(eDataType, vValue)) to sReturn
19616>>>>>>>>>>>>>>>        End
19616>>>>>>>>>>>>>>>>
19616>>>>>>>>>>>>>>>        Else Begin
19617>>>>>>>>>>>>>>>            Forward Get ConvertToTransport hmGetter vValue iType  to sReturn
19619>>>>>>>>>>>>>>>        End
19619>>>>>>>>>>>>>>>>
19619>>>>>>>>>>>>>>>        
19619>>>>>>>>>>>>>>>        Function_Return sReturn
19620>>>>>>>>>>>>>>>    End_Function
19621>>>>>>>>>>>>>>>    
19621>>>>>>>>>>>>>>>    
19621>>>>>>>>>>>>>>>    // These are needed because Get Data_File and Get Data_Field expects the Item interface to be present
19621>>>>>>>>>>>>>>>    // so these cannot be declared as straight properties.        
19621>>>>>>>>>>>>>>>    Procedure Set Data_File Integer iItem Integer iFile
19623>>>>>>>>>>>>>>>        Set private_Data_File to iFile
19624>>>>>>>>>>>>>>>    End_Procedure
19625>>>>>>>>>>>>>>>    
19625>>>>>>>>>>>>>>>    Procedure Set Data_Field Integer iItem Integer iField
19627>>>>>>>>>>>>>>>        Set private_Data_Field to iField
19628>>>>>>>>>>>>>>>    End_Procedure
19629>>>>>>>>>>>>>>>    
19629>>>>>>>>>>>>>>>    Function Data_File Integer iItem Returns Integer
19631>>>>>>>>>>>>>>>        Function_Return (private_Data_File(Self))
19632>>>>>>>>>>>>>>>    End_Function
19633>>>>>>>>>>>>>>>    
19633>>>>>>>>>>>>>>>    Function Data_Field Integer iItem Returns Integer
19635>>>>>>>>>>>>>>>        Function_Return (private_Data_Field(Self))
19636>>>>>>>>>>>>>>>    End_Function
19637>>>>>>>>>>>>>>>
19637>>>>>>>>>>>>>>>    // Performs an autofind if there is an autofind DD setting and the field is changed.
19637>>>>>>>>>>>>>>>    // As soon as a succuessful autofind occurs, the field is reset.
19637>>>>>>>>>>>>>>>    Procedure DoAutoFind
19639>>>>>>>>>>>>>>>        Integer bChanged eAuto iCur
19639>>>>>>>>>>>>>>>        Handle hoDD hoServer 
19639>>>>>>>>>>>>>>>        Handle[] hoDDs
19640>>>>>>>>>>>>>>>        Integer iFile iField
19640>>>>>>>>>>>>>>>        Boolean bAllowNull bNull bNoFindOnMain
19640>>>>>>>>>>>>>>>        Integer iStat
19640>>>>>>>>>>>>>>>        String sValue
19640>>>>>>>>>>>>>>>        
19640>>>>>>>>>>>>>>>        Get Server to hoServer
19641>>>>>>>>>>>>>>>        Get Data_File  to iFile
19642>>>>>>>>>>>>>>>        Get Data_Field to iField       
19643>>>>>>>>>>>>>>>        
19643>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
19645>>>>>>>>>>>>>>>            
19645>>>>>>>>>>>>>>>            // We only do an autofind check if the DD field value is changed and it is an autofind field
19645>>>>>>>>>>>>>>>                    
19645>>>>>>>>>>>>>>>            Get File_Field_Changed_state of hoServer iFile iField to bChanged
19646>>>>>>>>>>>>>>>            If (bChanged) Begin
19648>>>>>>>>>>>>>>>                Get AutoFindMode to eAuto
19649>>>>>>>>>>>>>>>                If (eAuto<>0) Begin
19651>>>>>>>>>>>>>>>                   Get Which_Data_Set of hoServer iFile to hoDD
19652>>>>>>>>>>>>>>>                   If (hoDD and hoDD<>hoServer) Begin
19654>>>>>>>>>>>>>>>                       Get Field_Current_Value of hoDD iField to sValue
19655>>>>>>>>>>>>>>>                       Get IsEmptyField of hoDD iField sValue to bNull
19656>>>>>>>>>>>>>>>                       // if this is an empty value this may be a null parent. See if the
19656>>>>>>>>>>>>>>>                       // child that is below this parent supports null parents for this file
19656>>>>>>>>>>>>>>>                       If bNull Begin
19658>>>>>>>>>>>>>>>                           Send DDOServerPath of hoServer hoDD (&hoDDs) // if hoDDs returns items, 0 is hoDD and 1 is its child
19659>>>>>>>>>>>>>>>                           If (SizeOfArray(hoDDs)) Begin
19661>>>>>>>>>>>>>>>                              Get IsNullParentAllowed of hoDDs[1] iFile to bAllowNull                    
19662>>>>>>>>>>>>>>>                           End
19662>>>>>>>>>>>>>>>>
19662>>>>>>>>>>>>>>>                       End
19662>>>>>>>>>>>>>>>>
19662>>>>>>>>>>>>>>>                   End
19662>>>>>>>>>>>>>>>>
19662>>>>>>>>>>>>>>>                   Else Begin
19663>>>>>>>>>>>>>>>                        If (not(HasRecord(hoServer))) Begin
19665>>>>>>>>>>>>>>>                            // if a main file autofind, see if we allow this with new records
19665>>>>>>>>>>>>>>>                            Get IsViewNoFindOnMain to bNoFindOnMain
19666>>>>>>>>>>>>>>>                        End
19666>>>>>>>>>>>>>>>>
19666>>>>>>>>>>>>>>>                   End
19666>>>>>>>>>>>>>>>>
19666>>>>>>>>>>>>>>>                   If (bNull and bAllowNull) Begin
19668>>>>>>>>>>>>>>>                        Send Request_ClearBindingTable // if null, do a clear (essentially a find nothing)
19669>>>>>>>>>>>>>>>                   End
19669>>>>>>>>>>>>>>>>
19669>>>>>>>>>>>>>>>                   Else If (bNoFindOnMain) Begin
19672>>>>>>>>>>>>>>>                        // if here, this is the anti-autofind. If an autofind would succeed, it's a duplicate record error 
19672>>>>>>>>>>>>>>>                        // This is used by drilldowns when a find or autofind is not appropriate because it
19672>>>>>>>>>>>>>>>                        // will find a record. This should only occur with new records 
19672>>>>>>>>>>>>>>>                        Clear iFile
19673>>>>>>>>>>>>>>>                        // this will be a deferred (read) find.
19673>>>>>>>>>>>>>>>                        Send File_Field_Find of hoServer EQ iFile iField True False True
19674>>>>>>>>>>>>>>>                        Get_Attribute DF_FILE_STATUS of iFile to iStat
19677>>>>>>>>>>>>>>>                        If (iStat = DF_FILE_ACTIVE) Begin
19679>>>>>>>>>>>>>>>                            Send Data_set_error of hoServer iField DFERR_ENTER_VALID_REC_ID "Duplicate Record Id not allowed"
19680>>>>>>>>>>>>>>>                        End
19680>>>>>>>>>>>>>>>>
19680>>>>>>>>>>>>>>>                        Else Begin
19681>>>>>>>>>>>>>>>                            Send HideAllControlErrors DFERR_ENTER_VALID_REC_ID                             
19682>>>>>>>>>>>>>>>                        End
19682>>>>>>>>>>>>>>>>
19682>>>>>>>>>>>>>>>                   End
19682>>>>>>>>>>>>>>>>
19682>>>>>>>>>>>>>>>                   Else Begin
19683>>>>>>>>>>>>>>>                      Send File_Field_AutoFind of hoServer iFile iField (If(eAuto=amAutoFindGE, GE, EQ)) 
19684>>>>>>>>>>>>>>>                   End
19684>>>>>>>>>>>>>>>>
19684>>>>>>>>>>>>>>>                End
19684>>>>>>>>>>>>>>>>
19684>>>>>>>>>>>>>>>            End
19684>>>>>>>>>>>>>>>>
19684>>>>>>>>>>>>>>>        End
19684>>>>>>>>>>>>>>>>
19684>>>>>>>>>>>>>>>    End_Procedure
19685>>>>>>>>>>>>>>>
19685>>>>>>>>>>>>>>>
19685>>>>>>>>>>>>>>>
19685>>>>>>>>>>>>>>>    // Notify DEO that DDO label has changed.
19685>>>>>>>>>>>>>>>    Procedure File_Field_Label_Changed Integer iFile Integer iField Boolean bLong String sLabel
19687>>>>>>>>>>>>>>>        // Do nothing
19687>>>>>>>>>>>>>>>    End_Procedure  
19688>>>>>>>>>>>>>>>    
19688>>>>>>>>>>>>>>>
19688>>>>>>>>>>>>>>>    // Notify DEO that DDO mask has changed.
19688>>>>>>>>>>>>>>>    Procedure File_Field_Mask_Changed Integer iFile Integer iField String sMask
19690>>>>>>>>>>>>>>>        // Do nothing
19690>>>>>>>>>>>>>>>    End_Procedure  
19691>>>>>>>>>>>>>>>    
19691>>>>>>>>>>>>>>>    //  Notify DEO that a field option has changed in the DDO.
19691>>>>>>>>>>>>>>>    Procedure File_Field_Option_Changed Integer iFile Integer iField Integer iOptions Integer bClear
19693>>>>>>>>>>>>>>>        // Do nothing
19693>>>>>>>>>>>>>>>    End_Procedure
19694>>>>>>>>>>>>>>>    
19694>>>>>>>>>>>>>>>    
19694>>>>>>>>>>>>>>>    // Sent by DDOs to all DEOs whenever a DDO file/field value is changed.
19694>>>>>>>>>>>>>>>    // If the file/filed value matches then it means this DEO is attached to
19694>>>>>>>>>>>>>>>    // the same file/Field that got changed. Set the Object's synchronized 
19694>>>>>>>>>>>>>>>    // psValue according to the passed value.
19694>>>>>>>>>>>>>>>    Procedure File_Field_Value_Changed Integer iFile Integer iField String sValue Integer iChangeDisabled
19696>>>>>>>>>>>>>>>        Integer iDataFile iDataField
19696>>>>>>>>>>>>>>>        Boolean bSynchingFieldDefaults
19696>>>>>>>>>>>>>>>        
19696>>>>>>>>>>>>>>>        // Protect agains re-entrant calls....
19696>>>>>>>>>>>>>>>        If (private_pbIgnoreOnValueChanged(Self)) Begin
19698>>>>>>>>>>>>>>>            Procedure_Return
19699>>>>>>>>>>>>>>>        End
19699>>>>>>>>>>>>>>>>
19699>>>>>>>>>>>>>>>        
19699>>>>>>>>>>>>>>>        // Do not process if this was triggered during synching of DD field defaults...
19699>>>>>>>>>>>>>>>        Delegate Get SynchingFieldDefaults to bSynchingFieldDefaults
19701>>>>>>>>>>>>>>>        If (bSynchingFieldDefaults) Begin
19703>>>>>>>>>>>>>>>            Procedure_Return
19704>>>>>>>>>>>>>>>        End
19704>>>>>>>>>>>>>>>>
19704>>>>>>>>>>>>>>>        
19704>>>>>>>>>>>>>>>        Get Data_File to iDataFile
19705>>>>>>>>>>>>>>>
19705>>>>>>>>>>>>>>>        If (iDataFile = iFile) Begin
19707>>>>>>>>>>>>>>>            Get Data_Field to iDataField
19708>>>>>>>>>>>>>>>            
19708>>>>>>>>>>>>>>>            If (iDataField = iField) Begin
19710>>>>>>>>>>>>>>>                WebSet psValue to sValue
19711>>>>>>>>>>>>>>>                Send HideAllControlErrors
19712>>>>>>>>>>>>>>>                If not iChangeDisabled Begin
19714>>>>>>>>>>>>>>>                    WebSet pbChanged to True
19715>>>>>>>>>>>>>>>                End
19715>>>>>>>>>>>>>>>>
19715>>>>>>>>>>>>>>>                Else Begin
19716>>>>>>>>>>>>>>>                    WebSet pbFieldDefault to True
19717>>>>>>>>>>>>>>>                End
19717>>>>>>>>>>>>>>>>
19717>>>>>>>>>>>>>>>            End
19717>>>>>>>>>>>>>>>>
19717>>>>>>>>>>>>>>>        End
19717>>>>>>>>>>>>>>>>
19717>>>>>>>>>>>>>>>    End_Procedure
19718>>>>>>>>>>>>>>>
19718>>>>>>>>>>>>>>>
19718>>>>>>>>>>>>>>>    Procedure File_Field_Pointer_Value_Changed Integer iFile Integer iField Pointer pValue Integer iChangeDisabled
19720>>>>>>>>>>>>>>>        // called by the DD to support text fields?
19720>>>>>>>>>>>>>>>        Integer iDataFile iDataField
19720>>>>>>>>>>>>>>>        String sValue
19720>>>>>>>>>>>>>>>        
19720>>>>>>>>>>>>>>>        If (private_pbIgnoreOnValueChanged(Self)) Begin
19722>>>>>>>>>>>>>>>            Procedure_Return
19723>>>>>>>>>>>>>>>        End
19723>>>>>>>>>>>>>>>>
19723>>>>>>>>>>>>>>>        
19723>>>>>>>>>>>>>>>        Get Data_File to iDataFile
19724>>>>>>>>>>>>>>>
19724>>>>>>>>>>>>>>>        If (iDataFile = iFile) Begin
19726>>>>>>>>>>>>>>>            Get Data_Field to iDataField
19727>>>>>>>>>>>>>>>            
19727>>>>>>>>>>>>>>>            If (iDataField = iField) Begin
19729>>>>>>>>>>>>>>>                Move (PointerToString(pValue)) to sValue    // get the string at this pointer value
19730>>>>>>>>>>>>>>>                WebSet psValue to sValue
19731>>>>>>>>>>>>>>>                Send HideAllControlErrors
19732>>>>>>>>>>>>>>>                
19732>>>>>>>>>>>>>>>                If (not(iChangeDisabled)) Begin
19734>>>>>>>>>>>>>>>                    WebSet pbChanged to True
19735>>>>>>>>>>>>>>>                End
19735>>>>>>>>>>>>>>>>
19735>>>>>>>>>>>>>>>                Else Begin
19736>>>>>>>>>>>>>>>                    WebSet pbFieldDefault to True
19737>>>>>>>>>>>>>>>                End
19737>>>>>>>>>>>>>>>>
19737>>>>>>>>>>>>>>>            End
19737>>>>>>>>>>>>>>>>
19737>>>>>>>>>>>>>>>        End
19737>>>>>>>>>>>>>>>>
19737>>>>>>>>>>>>>>>    End_Procedure
19738>>>>>>>>>>>>>>>
19738>>>>>>>>>>>>>>>    // Returns True if the table column is configured to be "commitable".
19738>>>>>>>>>>>>>>>    // i.e. once saved should not be changed.
19738>>>>>>>>>>>>>>>    Function IsCommitable Returns Boolean
19740>>>>>>>>>>>>>>>        Integer iFile iField iDDOOptions
19740>>>>>>>>>>>>>>>        Integer iClients iClient iMain
19740>>>>>>>>>>>>>>>        Handle hoServer hoOwner hoChild     
19740>>>>>>>>>>>>>>>        Boolean bCommitable
19740>>>>>>>>>>>>>>>        
19740>>>>>>>>>>>>>>>        Get Data_File to iFile
19741>>>>>>>>>>>>>>>        Get Data_Field to iField
19742>>>>>>>>>>>>>>>        Get Server to hoServer
19743>>>>>>>>>>>>>>>        Move False to bCommitable
19744>>>>>>>>>>>>>>>        
19744>>>>>>>>>>>>>>>        If (iFile and hoServer) Begin
19746>>>>>>>>>>>>>>>            // the purpose is to determine if this is a commitable field....
19746>>>>>>>>>>>>>>>            Get Which_Data_Set of hoServer iFile to hoOwner
19747>>>>>>>>>>>>>>>            
19747>>>>>>>>>>>>>>>            // if this is the main file, we check the DD_Commit flag....
19747>>>>>>>>>>>>>>>            If (hoOwner = hoServer) Begin 
19749>>>>>>>>>>>>>>>                Get File_Field_Options of hoServer iFile iField to iDDOOptions
19750>>>>>>>>>>>>>>>                Move (IsFlagIn(DD_COMMIT, iDDOOptions)) to bCommitable
19751>>>>>>>>>>>>>>>            End
19751>>>>>>>>>>>>>>>>
19751>>>>>>>>>>>>>>>            // if this is a parent, we test for a child NoSwitchIfCommitted flag
19751>>>>>>>>>>>>>>>            Else If (hoOwner) Begin
19754>>>>>>>>>>>>>>>                Get Data_Set_Client_Count of hoOwner to iClients
19755>>>>>>>>>>>>>>>                Get Main_File of hoOwner to iMain
19756>>>>>>>>>>>>>>>                Move 0 to iClient
19757>>>>>>>>>>>>>>>                
19757>>>>>>>>>>>>>>>                While (not(bCommitable) and iClient < iClients)
19761>>>>>>>>>>>>>>>                    Get Data_Set_Client of hoOwner iClient to hoChild
19762>>>>>>>>>>>>>>>                    Get ParentNoSwitchIfCommitted of hoChild iMain to bCommitable
19763>>>>>>>>>>>>>>>                    Increment iClient
19764>>>>>>>>>>>>>>>                Loop
19765>>>>>>>>>>>>>>>>
19765>>>>>>>>>>>>>>>            End
19765>>>>>>>>>>>>>>>>
19765>>>>>>>>>>>>>>>        End
19765>>>>>>>>>>>>>>>>
19765>>>>>>>>>>>>>>>        
19765>>>>>>>>>>>>>>>        Function_Return bCommitable
19766>>>>>>>>>>>>>>>    End_Function
19767>>>>>>>>>>>>>>>
19767>>>>>>>>>>>>>>>
19767>>>>>>>>>>>>>>>    // If there is no data binding (no Entry_Item command) but the DEO is served by a DDO then the DEO is 
19767>>>>>>>>>>>>>>>    // a calculated value. The initial data is filled by sending the OnSetCalculatedValue event. This is fired
19767>>>>>>>>>>>>>>>    // whenever the DDO performs a find, clear or delete operation.
19767>>>>>>>>>>>>>>>    //
19767>>>>>>>>>>>>>>>    // sValue - [out] a ByRef value which this event should fill with the calculated value.
19767>>>>>>>>>>>>>>>    Procedure OnSetCalculatedValue String ByRef sValue
19769>>>>>>>>>>>>>>>        // To be augmented by the user
19769>>>>>>>>>>>>>>>    End_Procedure
19770>>>>>>>>>>>>>>>    
19770>>>>>>>>>>>>>>>    // call to invoke a prompt list
19770>>>>>>>>>>>>>>>    // with drilldown apps, we always returns 0 for PromptObject and we 
19770>>>>>>>>>>>>>>>    // always do nothing with prompt. We expect you to handle this all via
19770>>>>>>>>>>>>>>>    // pbPromptButton and OnPrompt. This resolves forward reference issues and
19770>>>>>>>>>>>>>>>    // in the long run is more flexible
19770>>>>>>>>>>>>>>>    Procedure Prompt
19772>>>>>>>>>>>>>>>        Handle hoPrompt
19772>>>>>>>>>>>>>>>        Integer eStyle
19772>>>>>>>>>>>>>>>        Delegate Get WebViewStyle to eStyle
19774>>>>>>>>>>>>>>>        If (eStyle=wvsDesktop or eStyle=wvsDialog) Begin
19776>>>>>>>>>>>>>>>            Get PromptObject to hoPrompt
19777>>>>>>>>>>>>>>>            If hoPrompt Begin
19779>>>>>>>>>>>>>>>                Get WebViewStyle of hoPrompt to eStyle
19780>>>>>>>>>>>>>>>                If (eStyle =wvsDrillDown) Begin
19782>>>>>>>>>>>>>>>                    Error DFERR_PROGRAM "Cannot Prompt to a drill down object from a desktop view"
19783>>>>>>>>>>>>>>>>
19783>>>>>>>>>>>>>>>                End
19783>>>>>>>>>>>>>>>>
19783>>>>>>>>>>>>>>>                Else Begin
19784>>>>>>>>>>>>>>>                    Send Popup of hoPrompt Self
19785>>>>>>>>>>>>>>>                End
19785>>>>>>>>>>>>>>>>
19785>>>>>>>>>>>>>>>            end
19785>>>>>>>>>>>>>>>>
19785>>>>>>>>>>>>>>>        End
19785>>>>>>>>>>>>>>>>
19785>>>>>>>>>>>>>>>    End_Procedure
19786>>>>>>>>>>>>>>>
19786>>>>>>>>>>>>>>>    // called by prompt lists as part of callback to customize a list
19786>>>>>>>>>>>>>>>    Procedure Prompt_Callback Handle hoPrompt
19788>>>>>>>>>>>>>>>    End_Procedure
19789>>>>>>>>>>>>>>>
19789>>>>>>>>>>>>>>>    // returns PromptObject. returns phoPrompt
19789>>>>>>>>>>>>>>>    Function PromptObject Returns Handle
19791>>>>>>>>>>>>>>>        Handle hoPrompt
19791>>>>>>>>>>>>>>>        Integer eStyle
19791>>>>>>>>>>>>>>>        Delegate Get WebViewStyle to eStyle
19793>>>>>>>>>>>>>>>        If (eStyle = wvsDesktop or eStyle=wvsDialog) Begin
19795>>>>>>>>>>>>>>>            Get phoPrompt to hoPrompt
19796>>>>>>>>>>>>>>>        End
19796>>>>>>>>>>>>>>>>
19796>>>>>>>>>>>>>>>        Function_Return hoPrompt
19797>>>>>>>>>>>>>>>    End_Function    
19798>>>>>>>>>>>>>>>   
19798>>>>>>>>>>>>>>>    
19798>>>>>>>>>>>>>>>    // Sent by DDO when there is a clear/find/save/delete.
19798>>>>>>>>>>>>>>>    // This should Set all necessary web properties of the control
19798>>>>>>>>>>>>>>>    // For example psValue, pbEnabled, pbChanged.
19798>>>>>>>>>>>>>>>    //
19798>>>>>>>>>>>>>>>    // eMode - Determines the type of DDO operation which generated this refresh message. 
19798>>>>>>>>>>>>>>>    //         It may be one of the following:
19798>>>>>>>>>>>>>>>    //         Mode_Clear:             Used only for DEOs attached to the DDO that was the
19798>>>>>>>>>>>>>>>    //                                 "origin" of a Clear operation, (i.e., the DDO received
19798>>>>>>>>>>>>>>>    //                                 the original Clear message). All other DDOs Send their 
19798>>>>>>>>>>>>>>>    //                                 DEOs the refresh message passing mode_find_or_clear_set.  
19798>>>>>>>>>>>>>>>    //         Mode_Find_or_Clear_Set: Used for DEOs attached to DDOs which have Found and/or cleared records.  
19798>>>>>>>>>>>>>>>    //         Mode_Clear_All:         Used for DEOs attached to any DDO that participated in a clear_all operation.  
19798>>>>>>>>>>>>>>>    //         Mode_Delete:            Used for DEOs attached to any DDO that performed a successful deletion. 
19798>>>>>>>>>>>>>>>    //                                 DDOs that were merely updated as the result of a deletion Use Mode_Find_or_Clear_Set.  
19798>>>>>>>>>>>>>>>    //         Mode_Save:              Used for DEOs attached to any DDO involved in a successful Save operation. 
19798>>>>>>>>>>>>>>>    Procedure Refresh Integer eMode
19800>>>>>>>>>>>>>>>        Handle hoDDO
19800>>>>>>>>>>>>>>>        Integer iFile iField iDDOOptions eRTS eDataType
19800>>>>>>>>>>>>>>>        Boolean bActive bAppSynching bNoEnter bCommitable
19800>>>>>>>>>>>>>>>        Boolean bFieldChanged
19800>>>>>>>>>>>>>>>        String sValue sOldValue
19800>>>>>>>>>>>>>>>        Time tTimeVal tTimeNull
19800>>>>>>>>>>>>>>>        
19800>>>>>>>>>>>>>>>        Forward Send Refresh eMode
19802>>>>>>>>>>>>>>>        
19802>>>>>>>>>>>>>>>        Get Active_State to bActive
19803>>>>>>>>>>>>>>>        Get AppSynching of (Host(Self)) to bAppSynching
19804>>>>>>>>>>>>>>>    
19804>>>>>>>>>>>>>>>        If (bActive and not(bAppSynching)) Begin
19806>>>>>>>>>>>>>>>            Get Server to hoDDO
19807>>>>>>>>>>>>>>>            Get Data_File to iFile
19808>>>>>>>>>>>>>>>            Get Data_Field to iField
19809>>>>>>>>>>>>>>>            
19809>>>>>>>>>>>>>>>            Case Begin
19809>>>>>>>>>>>>>>>                Case (eMode = MODE_FIND_OR_CLEAR_SET)
19811>>>>>>>>>>>>>>>                Case (eMode = MODE_CLEAR)
19814>>>>>>>>>>>>>>>                Case (eMode = MODE_CLEAR_ALL)
19817>>>>>>>>>>>>>>>                Case (eMode = MODE_DELETE)
19820>>>>>>>>>>>>>>>                Case (eMode = MODE_SAVE)
19823>>>>>>>>>>>>>>>                    If (iFile <> 0) Begin
19825>>>>>>>>>>>>>>>                        Get DDRefreshTableStatus iFile to eRTS // see if this table is part of the DD's request
19826>>>>>>>>>>>>>>>    
19826>>>>>>>>>>>>>>>                        If (eRTS <> ddrtsNone or eMode = MODE_CLEAR_ALL) Begin
19828>>>>>>>>>>>>>>>                            // Handle dynamic switching of Enabled_State. This would only happen if the
19828>>>>>>>>>>>>>>>                            // file/field is commitable in the DDO....
19828>>>>>>>>>>>>>>>                            // only do commit check if the field is design-time enabled
19828>>>>>>>>>>>>>>>                            If (pbEnabled(Self)) Begin
19830>>>>>>>>>>>>>>>                                Send SetDynamicEnabled
19831>>>>>>>>>>>>>>>                            End            
19831>>>>>>>>>>>>>>>>
19831>>>>>>>>>>>>>>>                            
19831>>>>>>>>>>>>>>>                            //  Do security check
19831>>>>>>>>>>>>>>>                            If (not(FillDEOAllowed(Self))) Begin
19833>>>>>>>>>>>>>>>                                Procedure_Return
19834>>>>>>>>>>>>>>>                            End
19834>>>>>>>>>>>>>>>>
19834>>>>>>>>>>>>>>>                            
19834>>>>>>>>>>>>>>>                            // Refresh should read from the global file buffers unless doing a clear and there are
19834>>>>>>>>>>>>>>>                            // default values waiting in the DDO buffer....
19834>>>>>>>>>>>>>>>    
19834>>>>>>>>>>>>>>>                            If (eRTS = ddrtsCleared or eMode = MODE_CLEAR_ALL) Begin
19836>>>>>>>>>>>>>>>                                // if the DD's field changed state is true, we must have a default value to use
19836>>>>>>>>>>>>>>>                                Get File_Field_Changed_State of hoDDO iFile iField to bFieldChanged
19837>>>>>>>>>>>>>>>                            End
19837>>>>>>>>>>>>>>>>
19837>>>>>>>>>>>>>>>                            Else Begin
19838>>>>>>>>>>>>>>>                                Move False to bFieldChanged
19839>>>>>>>>>>>>>>>                            End
19839>>>>>>>>>>>>>>>>
19839>>>>>>>>>>>>>>>            
19839>>>>>>>>>>>>>>>                            If (bFieldChanged) Begin
19841>>>>>>>>>>>>>>>                                // The DD buffer value has changed after a clear. That means there is a default
19841>>>>>>>>>>>>>>>                                // value to read from the DDO buffer....
19841>>>>>>>>>>>>>>>                                Get File_Field_Current_Value of hoDDO iFile iField to sValue
19842>>>>>>>>>>>>>>>                            End
19842>>>>>>>>>>>>>>>>
19842>>>>>>>>>>>>>>>                            Else Begin
19843>>>>>>>>>>>>>>>                                // In all other cases we read the value directly from the file buffer....
19843>>>>>>>>>>>>>>>                                Get_Field_Value iFile iField to sValue 
19846>>>>>>>>>>>>>>>                                
19846>>>>>>>>>>>>>>>                                // If this was a DDO Clear and the value is "0" for a numeric field
19846>>>>>>>>>>>>>>>                                // then we will Set psValue to "" instead of "0". This simulates 
19846>>>>>>>>>>>>>>>                                // Windows DEO behavior.
19846>>>>>>>>>>>>>>>                                If (eRTS = ddrtsCleared) Begin
19848>>>>>>>>>>>>>>>                                    Get peDataType to eDataType   // If the object supports psValue it should also support peDataType. If not peDataType will get delegated to ghoWebApp and return typeASCII.
19849>>>>>>>>>>>>>>>                                    
19849>>>>>>>>>>>>>>>                                    If (eDataType = typeNumber and Number(sValue) = 0) Begin
19851>>>>>>>>>>>>>>>                                        Move "" to sValue
19852>>>>>>>>>>>>>>>                                    End
19852>>>>>>>>>>>>>>>>
19852>>>>>>>>>>>>>>>                                    
19852>>>>>>>>>>>>>>>                                    If (eDataType = typeTime) Begin
19854>>>>>>>>>>>>>>>                                        Move (NullDateTime()) to tTimeNull
19855>>>>>>>>>>>>>>>                                        Move sValue to tTimeVal
19856>>>>>>>>>>>>>>>                                        If (tTimeNull = tTimeVal) Begin
19858>>>>>>>>>>>>>>>                                            Move "" to sValue
19859>>>>>>>>>>>>>>>                                        End
19859>>>>>>>>>>>>>>>>
19859>>>>>>>>>>>>>>>                                    End
19859>>>>>>>>>>>>>>>>
19859>>>>>>>>>>>>>>>                                End
19859>>>>>>>>>>>>>>>>
19859>>>>>>>>>>>>>>>                            End
19859>>>>>>>>>>>>>>>>
19859>>>>>>>>>>>>>>>                        
19859>>>>>>>>>>>>>>>                            Move (Rtrim(sValue)) to sValue
19860>>>>>>>>>>>>>>>                           
19860>>>>>>>>>>>>>>>    
19860>>>>>>>>>>>>>>>                            // Set the value and changed flag web properties....
19860>>>>>>>>>>>>>>>                            Send HideAllControlErrors
19861>>>>>>>>>>>>>>>                            WebSet psValue to sValue
19862>>>>>>>>>>>>>>>                            WebSet pbChanged to False
19863>>>>>>>>>>>>>>>                            WebSet pbFieldDefault to bFieldChanged // if true, a default is set
19864>>>>>>>>>>>>>>>                        End
19864>>>>>>>>>>>>>>>>
19864>>>>>>>>>>>>>>>                    End
19864>>>>>>>>>>>>>>>>
19864>>>>>>>>>>>>>>>                    Else Begin
19865>>>>>>>>>>>>>>>                        WebGet psValue to sValue
19866>>>>>>>>>>>>>>>                        Move sValue to sOldValue
19867>>>>>>>>>>>>>>>                        Send OnSetCalculatedValue (&sValue)
19868>>>>>>>>>>>>>>>                
19868>>>>>>>>>>>>>>>                        // Set the value and changed flag web properties. In the case of a Clear
19868>>>>>>>>>>>>>>>                        // we will unconditionally set the value/changed flag because a clear always
19868>>>>>>>>>>>>>>>                        // occurs during InitForShow. During InitForShow we have no idea what is 
19868>>>>>>>>>>>>>>>                        // stored on the client so therefore we must make sure that the cleared
19868>>>>>>>>>>>>>>>                        // value is forced to update the client otherwise the current client value
19868>>>>>>>>>>>>>>>                        // would just stay there. 
19868>>>>>>>>>>>>>>>                        If (sValue <> sOldValue or eMode = MODE_CLEAR_ALL) Begin
19870>>>>>>>>>>>>>>>                            WebSet psValue to sValue
19871>>>>>>>>>>>>>>>                            WebSet pbChanged to False
19872>>>>>>>>>>>>>>>                            WebSet pbFieldDefault to False
19873>>>>>>>>>>>>>>>                        End
19873>>>>>>>>>>>>>>>>
19873>>>>>>>>>>>>>>>                    End
19873>>>>>>>>>>>>>>>>
19873>>>>>>>>>>>>>>>                    Case Break
19874>>>>>>>>>>>>>>>            Case End
19874>>>>>>>>>>>>>>>        End
19874>>>>>>>>>>>>>>>>
19874>>>>>>>>>>>>>>>    End_Procedure
19875>>>>>>>>>>>>>>>    
19875>>>>>>>>>>>>>>>    // helper function returns true if any child DDO relates to this
19875>>>>>>>>>>>>>>>    Function IsConstrainingParent Handle hoDDO Returns Boolean
19877>>>>>>>>>>>>>>>        Integer iClients i iFile
19877>>>>>>>>>>>>>>>        Handle hoClient
19877>>>>>>>>>>>>>>>        Boolean bRelates
19877>>>>>>>>>>>>>>>        Get Main_File of hoDDO to iFile
19878>>>>>>>>>>>>>>>        Get Data_Set_Client_Count of hoDDO to iClients
19879>>>>>>>>>>>>>>>        For i from 0 to (iClients-1)
19885>>>>>>>>>>>>>>>>
19885>>>>>>>>>>>>>>>            Get Data_Set_Client of hoDDO i to hoClient
19886>>>>>>>>>>>>>>>            Get IsRelatesToConstrained of hoClient iFile to bRelates
19887>>>>>>>>>>>>>>>            If bRelates Begin
19889>>>>>>>>>>>>>>>                Function_Return True
19890>>>>>>>>>>>>>>>            End
19890>>>>>>>>>>>>>>>>
19890>>>>>>>>>>>>>>>        Loop
19891>>>>>>>>>>>>>>>>
19891>>>>>>>>>>>>>>>        Function_Return False
19892>>>>>>>>>>>>>>>    End_Function
19893>>>>>>>>>>>>>>>    
19893>>>>>>>>>>>>>>>    // returns true if control supports prompt buttons and the prompt button
19893>>>>>>>>>>>>>>>    // default property value (not webproperty) is enabled. Augmented in cWebBaseForm 
19893>>>>>>>>>>>>>>>    Function HasPromptButton Returns Boolean
19895>>>>>>>>>>>>>>>        Function_Return False
19896>>>>>>>>>>>>>>>    End_Function
19897>>>>>>>>>>>>>>>    
19897>>>>>>>>>>>>>>>    // this figures out if a control *should* be dynamically enabled/disabled.
19897>>>>>>>>>>>>>>>    // Typically used by SetDynamicEnabled to webset pbEnabled but can be called
19897>>>>>>>>>>>>>>>    // at any time.
19897>>>>>>>>>>>>>>>    Function IsDynamicEnabled Returns Boolean
19899>>>>>>>>>>>>>>>        Handle hoServer
19899>>>>>>>>>>>>>>>        Handle hoDDO
19899>>>>>>>>>>>>>>>        Integer iFile iField
19899>>>>>>>>>>>>>>>        Boolean bHasRecord bNoEnter bNoPut bKeyField bDisable bAutoFind bAutoFindGe 
19899>>>>>>>>>>>>>>>        Boolean bCommitable bNoFind bIsReadOnly bPromptButton
19899>>>>>>>>>>>>>>>        Integer iDDOOptions
19899>>>>>>>>>>>>>>>    
19899>>>>>>>>>>>>>>>        Get Server to hoServer
19900>>>>>>>>>>>>>>>        Get Data_File to iFile        
19901>>>>>>>>>>>>>>>        Get Data_Field to iField        
19902>>>>>>>>>>>>>>>        If (not(hoServer) or not (iFile)) Begin
19904>>>>>>>>>>>>>>>            Error DFERR_PROGRAM "Server / Data_File required"
19905>>>>>>>>>>>>>>>>
19905>>>>>>>>>>>>>>>            Function_Return True
19906>>>>>>>>>>>>>>>        End
19906>>>>>>>>>>>>>>>>
19906>>>>>>>>>>>>>>>    
19906>>>>>>>>>>>>>>>        Get IsViewReadOnly to bIsReadOnly
19907>>>>>>>>>>>>>>>        
19907>>>>>>>>>>>>>>>        If (bIsReadOnly) Begin
19909>>>>>>>>>>>>>>>            Move True to bDisable                      
19910>>>>>>>>>>>>>>>        End
19910>>>>>>>>>>>>>>>>
19910>>>>>>>>>>>>>>>        Else Begin
19911>>>>>>>>>>>>>>>            Get Data_Set of hoServer iFile to hoDDO
19912>>>>>>>>>>>>>>>            
19912>>>>>>>>>>>>>>>            If (not(hoDDO)) Begin
19914>>>>>>>>>>>>>>>                Error DFERR_PROGRAM "DDO for binding data_file not found"
19915>>>>>>>>>>>>>>>>
19915>>>>>>>>>>>>>>>                Function_Return True
19916>>>>>>>>>>>>>>>            End
19916>>>>>>>>>>>>>>>>
19916>>>>>>>>>>>>>>>            
19916>>>>>>>>>>>>>>>            // this will handle main and foreign options but not commit options
19916>>>>>>>>>>>>>>>            Get File_Field_Options of hoServer iFile iField to iDDOOptions
19917>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_NoEnter, iDDOOptions)) to bNoEnter
19918>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_NoPut, iDDOOptions)) to bNoPut
19919>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_AUTOFIND, iDDOOptions)) to bAutoFind
19920>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_AUTOFIND_GE, iDDOOptions)) to bAutoFindGe
19921>>>>>>>>>>>>>>>            Get HasPromptButton to bPromptButton
19922>>>>>>>>>>>>>>>            
19922>>>>>>>>>>>>>>>            // if main file ddo
19922>>>>>>>>>>>>>>>            If (hoServer = hoDDO) Begin
19924>>>>>>>>>>>>>>>                Get IsViewNoFindOnMain to bNoFind
19925>>>>>>>>>>>>>>>                Get HasRecord of hoServer to bHasRecord
19926>>>>>>>>>>>>>>>                Get Key_Field_State of hoServer iField to bKeyField
19927>>>>>>>>>>>>>>>                If (bNoEnter) Begin
19929>>>>>>>>>>>>>>>                    Move True to bDisable                      
19930>>>>>>>>>>>>>>>                End
19930>>>>>>>>>>>>>>>>
19930>>>>>>>>>>>>>>>                Else If (bHasRecord and bNoFind and (bNoPut or bKeyField or bAutoFind or bAutoFindGe)) Begin
19933>>>>>>>>>>>>>>>                    Move True to bDisable                      
19934>>>>>>>>>>>>>>>                End
19934>>>>>>>>>>>>>>>>
19934>>>>>>>>>>>>>>>                Else If (not(bHasRecord) and bNoFind and bNoPut) Begin
19937>>>>>>>>>>>>>>>                    Move True to bDisable 
19938>>>>>>>>>>>>>>>                End
19938>>>>>>>>>>>>>>>>
19938>>>>>>>>>>>>>>>                Else Begin
19939>>>>>>>>>>>>>>>                    Get IsCommitable to bCommitable
19940>>>>>>>>>>>>>>>                    If (bCommitable) Begin
19942>>>>>>>>>>>>>>>                        Get File_Field_Committed_Options of hoServer iFile iField to iDDOOptions  // possible NoPut, NoEnter additions
19943>>>>>>>>>>>>>>>                        If bNoFind Begin
19945>>>>>>>>>>>>>>>                            Move (iDDOOptions) to bDisable
19946>>>>>>>>>>>>>>>                        End
19946>>>>>>>>>>>>>>>>
19946>>>>>>>>>>>>>>>                        Else Begin
19947>>>>>>>>>>>>>>>                            Move (IsFlagIn(DD_NoEnter, iDDOOptions)) to bDisable
19948>>>>>>>>>>>>>>>                        End
19948>>>>>>>>>>>>>>>>
19948>>>>>>>>>>>>>>>                    End
19948>>>>>>>>>>>>>>>>
19948>>>>>>>>>>>>>>>                End
19948>>>>>>>>>>>>>>>>
19948>>>>>>>>>>>>>>>            End
19948>>>>>>>>>>>>>>>>
19948>>>>>>>>>>>>>>>            // if parent
19948>>>>>>>>>>>>>>>            Else Begin
19949>>>>>>>>>>>>>>>                If (bNoEnter) Begin
19951>>>>>>>>>>>>>>>                    Move True to bDisable
19952>>>>>>>>>>>>>>>                End
19952>>>>>>>>>>>>>>>>
19952>>>>>>>>>>>>>>>                If (bNoPut and not(bPromptButton)) Begin
19954>>>>>>>>>>>>>>>                    Move True to bDisable
19955>>>>>>>>>>>>>>>                End
19955>>>>>>>>>>>>>>>>
19955>>>>>>>>>>>>>>>                Else Begin
19956>>>>>>>>>>>>>>>                    Get IsViewNoFindOnConstrainedParent to bNoFind
19957>>>>>>>>>>>>>>>                    If bNoFind Begin
19959>>>>>>>>>>>>>>>                        Get IsConstrainingParent hoDDO to bDisable
19960>>>>>>>>>>>>>>>                    End
19960>>>>>>>>>>>>>>>>
19960>>>>>>>>>>>>>>>                    If not bDisable Begin
19962>>>>>>>>>>>>>>>                        Get IsCommitable to bCommitable
19963>>>>>>>>>>>>>>>                        If (bCommitable) Begin
19965>>>>>>>>>>>>>>>                            Get File_Field_Committed_Options of hoServer iFile iField to iDDOOptions  // possible NoPut, NoEnter additions
19966>>>>>>>>>>>>>>>                            Move (IsFlagIn(DD_NoEnter, iDDOOptions)) to bDisable
19967>>>>>>>>>>>>>>>                        End
19967>>>>>>>>>>>>>>>>
19967>>>>>>>>>>>>>>>                    End
19967>>>>>>>>>>>>>>>>
19967>>>>>>>>>>>>>>>                End
19967>>>>>>>>>>>>>>>>
19967>>>>>>>>>>>>>>>            End
19967>>>>>>>>>>>>>>>>
19967>>>>>>>>>>>>>>>        End
19967>>>>>>>>>>>>>>>>
19967>>>>>>>>>>>>>>>        Function_Return bDisable
19968>>>>>>>>>>>>>>>    End_Function
19969>>>>>>>>>>>>>>>    
19969>>>>>>>>>>>>>>>    Procedure SetDynamicEnabledDesktopStyle
19971>>>>>>>>>>>>>>>        Handle hoServer
19971>>>>>>>>>>>>>>>        Integer iFile iField iDDOOPtions
19971>>>>>>>>>>>>>>>        Boolean bDisable bNoEnter bCommitable
19971>>>>>>>>>>>>>>>        
19971>>>>>>>>>>>>>>>        Get Server to hoServer
19972>>>>>>>>>>>>>>>        Get Data_File to iFile        
19973>>>>>>>>>>>>>>>        If (not(hoServer) or not (iFile)) Begin
19975>>>>>>>>>>>>>>>            Procedure_Return
19976>>>>>>>>>>>>>>>        End
19976>>>>>>>>>>>>>>>>
19976>>>>>>>>>>>>>>>        
19976>>>>>>>>>>>>>>>        Get IsCommitable to bCommitable
19977>>>>>>>>>>>>>>>        If (bCommitable) Begin
19979>>>>>>>>>>>>>>>            Get Data_Field to iField
19980>>>>>>>>>>>>>>>            Get File_Field_DynamicEntryOptions of hoServer iFile iField to iDDOOptions
19981>>>>>>>>>>>>>>>            Move (IsFlagIn(DD_NoEnter, iDDOOptions)) to bNoEnter
19982>>>>>>>>>>>>>>>            WebSet pbEnabled to (not(bNoEnter))
19983>>>>>>>>>>>>>>>        End
19983>>>>>>>>>>>>>>>>
19983>>>>>>>>>>>>>>>    End_Procedure
19984>>>>>>>>>>>>>>>
19984>>>>>>>>>>>>>>>    Procedure SetDynamicEnabledDrillDownStyle
19986>>>>>>>>>>>>>>>        Handle hoServer
19986>>>>>>>>>>>>>>>        Integer iFile
19986>>>>>>>>>>>>>>>        Boolean bDisable
19986>>>>>>>>>>>>>>>        Get Server to hoServer
19987>>>>>>>>>>>>>>>        Get Data_File to iFile        
19988>>>>>>>>>>>>>>>        If (not(hoServer) or not (iFile)) Begin
19990>>>>>>>>>>>>>>>            Procedure_Return
19991>>>>>>>>>>>>>>>        End
19991>>>>>>>>>>>>>>>>
19991>>>>>>>>>>>>>>>        
19991>>>>>>>>>>>>>>>        Get IsDynamicEnabled to bDisable
19992>>>>>>>>>>>>>>>        WebSet pbEnabled to (not(bDisable))
19993>>>>>>>>>>>>>>>    End_Procedure
19994>>>>>>>>>>>>>>>    
19994>>>>>>>>>>>>>>>    // this websets the enabled state based on the state of the
19994>>>>>>>>>>>>>>>    // web view and the control. This is usually called during Refresh
19994>>>>>>>>>>>>>>>    Procedure SetDynamicEnabled
19996>>>>>>>>>>>>>>>        Integer eWebViewStyle
19996>>>>>>>>>>>>>>>        Boolean bStatic
19996>>>>>>>>>>>>>>>    
19996>>>>>>>>>>>>>>>        Get pbEnabledStatic to bStatic
19997>>>>>>>>>>>>>>>        If (not(bStatic)) Begin
19999>>>>>>>>>>>>>>>            Delegate Get WebViewStyle to eWebViewStyle
20001>>>>>>>>>>>>>>>            If (eWebViewStyle = wvsDrillDown) Begin
20003>>>>>>>>>>>>>>>                Send SetDynamicEnabledDrillDownStyle
20004>>>>>>>>>>>>>>>            End
20004>>>>>>>>>>>>>>>>
20004>>>>>>>>>>>>>>>            Else Begin
20005>>>>>>>>>>>>>>>                Send SetDynamicEnabledDesktopStyle
20006>>>>>>>>>>>>>>>            End
20006>>>>>>>>>>>>>>>>
20006>>>>>>>>>>>>>>>        End                
20006>>>>>>>>>>>>>>>>
20006>>>>>>>>>>>>>>>    End_Procedure
20007>>>>>>>>>>>>>>>
20007>>>>>>>>>>>>>>>    
20007>>>>>>>>>>>>>>>    Procedure Request_Find Integer eFindMode
20009>>>>>>>>>>>>>>>        // Generic request find method for handling Request_Find
20009>>>>>>>>>>>>>>>        // eFindMode - Can be one of... lt, le, eq, ge, gt, or it may be either Next_Record, First_Record, or Last_Record
20009>>>>>>>>>>>>>>>        Integer iField iFile iMainIndex
20009>>>>>>>>>>>>>>>        Handle hoServer
20009>>>>>>>>>>>>>>>
20009>>>>>>>>>>>>>>>        Get Server to hoServer
20010>>>>>>>>>>>>>>>        
20010>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
20012>>>>>>>>>>>>>>>            Get Data_File to iFile
20013>>>>>>>>>>>>>>>            Get Data_Field to iField
20014>>>>>>>>>>>>>>>            
20014>>>>>>>>>>>>>>>            If (iFile > 0) Begin
20016>>>>>>>>>>>>>>>                Send Item_Find to hoServer eFindMode iFile iField True False False   // Entry Update = True, Show find error = True, Deferred State = False
20017>>>>>>>>>>>>>>>            End
20017>>>>>>>>>>>>>>>>
20017>>>>>>>>>>>>>>>        End
20017>>>>>>>>>>>>>>>>
20017>>>>>>>>>>>>>>>    End_Procedure
20018>>>>>>>>>>>>>>>    
20018>>>>>>>>>>>>>>>    // Reads the synchronized psValue and pbChanged properties and updates the DDO data binding appropriately.
20018>>>>>>>>>>>>>>>    // Sent if pbDataBindable is True. Called during the AJAX Call's SynchronizeDDOs stage.
20018>>>>>>>>>>>>>>>    Procedure UpdateDataBinding
20020>>>>>>>>>>>>>>>        Integer iField iFile
20020>>>>>>>>>>>>>>>        Handle hoServer
20020>>>>>>>>>>>>>>>        Boolean bChanged bDefault
20020>>>>>>>>>>>>>>>        String sValue
20020>>>>>>>>>>>>>>>        Boolean bNoPut bNoEnter
20020>>>>>>>>>>>>>>>        Integer iDDOOptions
20020>>>>>>>>>>>>>>>        
20020>>>>>>>>>>>>>>>        If (not(UpdateDDAllowed(Self))) Begin
20022>>>>>>>>>>>>>>>            Procedure_Return
20023>>>>>>>>>>>>>>>        End
20023>>>>>>>>>>>>>>>>
20023>>>>>>>>>>>>>>>        
20023>>>>>>>>>>>>>>>        Get Server to hoServer
20024>>>>>>>>>>>>>>>        
20024>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
20026>>>>>>>>>>>>>>>            Get Data_File to iFile
20027>>>>>>>>>>>>>>>            Get Data_Field to iField
20028>>>>>>>>>>>>>>>            
20028>>>>>>>>>>>>>>>            If (iFile > 0) Begin
20030>>>>>>>>>>>>>>>                WebGet pbChanged to bChanged
20031>>>>>>>>>>>>>>>                WebGet pbFieldDefault to bDefault
20032>>>>>>>>>>>>>>>                
20032>>>>>>>>>>>>>>>                Get File_Field_DynamicEntryOptions of hoServer iFile iField to iDDOOptions
20033>>>>>>>>>>>>>>>                If (bChanged or bDefault or IsFlagIn(DD_FORCEPUT, iDDOOptions)) Begin
20035>>>>>>>>>>>>>>>                    WebGet psValue to sValue
20036>>>>>>>>>>>>>>>                    
20036>>>>>>>>>>>>>>>                    Set private_pbIgnoreOnValueChanged to True                        // Don't process the DDO's File_Field_Value_Changed event!
20037>>>>>>>>>>>>>>>                    
20037>>>>>>>>>>>>>>>                    If (bChanged) ;                        Set File_Field_Changed_Value of hoServer iFile iField to sValue   // Use File_Field because the field doesn't have to be in the server
20040>>>>>>>>>>>>>>>                    Else If (IsFlagIn(DD_FORCEPUT, iDDOOptions)) ;                        Set File_Field_Current_Value of hoServer iFile iField to sValue
20044>>>>>>>>>>>>>>>                    Else ;  // if bDefault                        Set File_Field_default_Value of hoServer iFile iField to sValue
20046>>>>>>>>>>>>>>>    
20046>>>>>>>>>>>>>>>                    Move (IsFlagIn(DD_NoPut, iDDOOptions)) to bNoPut
20047>>>>>>>>>>>>>>>                    If (bNoPut) Begin
20049>>>>>>>>>>>>>>>                        // this tells the DD that this is a DEO update on a noput field, which should only
20049>>>>>>>>>>>>>>>                        // happen with foreign index fields (noput=T,noenter=F). This stops the save update
20049>>>>>>>>>>>>>>>                        Set File_Field_NoPutValueChangedByDeo of hoServer iFile iField to True
20050>>>>>>>>>>>>>>>                    End
20050>>>>>>>>>>>>>>>>
20050>>>>>>>>>>>>>>>                    Set private_pbIgnoreOnValueChanged to False
20051>>>>>>>>>>>>>>>                End    
20051>>>>>>>>>>>>>>>>
20051>>>>>>>>>>>>>>>            End
20051>>>>>>>>>>>>>>>>
20051>>>>>>>>>>>>>>>        End
20051>>>>>>>>>>>>>>>>
20051>>>>>>>>>>>>>>>    End_Procedure
20052>>>>>>>>>>>>>>>    
20052>>>>>>>>>>>>>>>    Function ExecFileFieldMessage Handle hMsg Returns Integer
20054>>>>>>>>>>>>>>>        Integer iFile iField iResult
20054>>>>>>>>>>>>>>>        Handle hoDDO
20054>>>>>>>>>>>>>>>        Get Server to hoDDO
20055>>>>>>>>>>>>>>>        Get Data_File  to iFile
20056>>>>>>>>>>>>>>>        Get Data_Field to iField       
20057>>>>>>>>>>>>>>>        If ((hoDDO <> 0) and (iFile <> 0)) Begin
20059>>>>>>>>>>>>>>>            Get Exec_File_Field_Message of hoDDO iFile iField hMsg to iResult
20060>>>>>>>>>>>>>>>        End
20060>>>>>>>>>>>>>>>>
20060>>>>>>>>>>>>>>>        Function_Return iResult
20061>>>>>>>>>>>>>>>    End_Function
20062>>>>>>>>>>>>>>>    

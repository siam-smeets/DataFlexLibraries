9153>>>>>>>>>    // Return the text f the last error geneated by the driver.
9153>>>>>>>>>    //
9153>>>>>>>>>    Function LastDriverError Returns String
9155>>>>>>>>>        String  sDriverID
9155>>>>>>>>>        String  sLastError
9155>>>>>>>>>        String  sLastErrorLength
9155>>>>>>>>>        Integer iLastErrorLength
9155>>>>>>>>>        Integer iVoid
9155>>>>>>>>>        
9155>>>>>>>>>        // Initialize
9155>>>>>>>>>        Move "" to sLastError
9156>>>>>>>>>        
9156>>>>>>>>>        Get psDriverID to sDriverID
9157>>>>>>>>>        If (sDriverID <> "") Begin
9159>>>>>>>>>            // Get the text of the last error
9159>>>>>>>>>            Move (Repeat(Character(" "), 14)) to sLastErrorlength
9160>>>>>>>>>            Call_Driver 0 sDriverID Function CLI_GETDRIVERATTRIBUTE Callback 0 Passing sLastErrorLength iVoid DRVR_LASTERRORTEXTLENGTH Result iVoid
9165>>>>>>>>>            Move (Left(sLastErrorLength, Pos(Character(0), sLastErrorLength) - 1)) to iLastErrorLength
9166>>>>>>>>>            
9166>>>>>>>>>            If (iLastErrorLength > 0) Begin
9168>>>>>>>>>                Move (Repeat(Character(" "), iLastErrorLength + 1)) to sLastError
9169>>>>>>>>>                Call_Driver 0 sDriverID Function CLI_GETDRIVERATTRIBUTE Callback 0 Passing sLastError iVoid DRVR_LASTERRORTEXT Result iVoid
9174>>>>>>>>>                Move (Left(sLastError, Pos(Character(0), sLastError) - 1)) to sLastError
9175>>>>>>>>>            End
9175>>>>>>>>>>
9175>>>>>>>>>        End
9175>>>>>>>>>>
9175>>>>>>>>>        
9175>>>>>>>>>        Function_Return sLastError
9176>>>>>>>>>    End_Function

24707>>>>>>>>>>>>>>>>>            // this will optimize No_relate. If your DF constraint does not
24707>>>>>>>>>>>>>>>>>            // need a post-relate test, we will disabled relates for this
24707>>>>>>>>>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
24708>>>>>>>>>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
24709>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
24710>>>>>>>>>>>>>>>>>            
24710>>>>>>>>>>>>>>>>>            Move False to bSuccess
24711>>>>>>>>>>>>>>>>>            
24711>>>>>>>>>>>>>>>>>            //  Find first record or if a page was selected do a refind and go from there.
24711>>>>>>>>>>>>>>>>>            If (iPage > 0 and Length(prevItem.sRowId) > 0) Begin
24713>>>>>>>>>>>>>>>>>                Move (DeserializeRowID(prevItem.sRowId)) to riTest    
24714>>>>>>>>>>>>>>>>>                If (not(IsNullRowID(riTest))) Begin
24716>>>>>>>>>>>>>>>>>                    Get FindByRowIdEx of hoServer iFile riTest to bSuccess
24717>>>>>>>>>>>>>>>>>                End
24717>>>>>>>>>>>>>>>>>>
24717>>>>>>>>>>>>>>>>>            End
24717>>>>>>>>>>>>>>>>>>
24717>>>>>>>>>>>>>>>>>            
24717>>>>>>>>>>>>>>>>>            If (not(bSuccess)) Begin
24719>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer FIRST_RECORD iFile iIndex
24720>>>>>>>>>>>>>>>>>            End
24720>>>>>>>>>>>>>>>>>>
24720>>>>>>>>>>>>>>>>>            Else Begin
24721>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex  
24722>>>>>>>>>>>>>>>>>            End
24722>>>>>>>>>>>>>>>>>>
24722>>>>>>>>>>>>>>>>>            
24722>>>>>>>>>>>>>>>>>            While (Found and not(iItemIndex >= iPageSize))
24726>>>>>>>>>>>>>>>>>                Move (ResizeArray(aEntryValues, 0)) to aEntryValues
24727>>>>>>>>>>>>>>>>>                Get CheckAllEntryItem (&aEntryValues) sFilter False True False to bOk
24728>>>>>>>>>>>>>>>>>                If (bOk) Begin
24730>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to aItems[iItemIndex].sRowId
24731>>>>>>>>>>>>>>>>>                    Move aEntryValues to aItems[iItemIndex].aValues
24732>>>>>>>>>>>>>>>>>                    Send OnSetCalculatedValue (&aItems[iItemIndex].aValues[0])
24733>>>>>>>>>>>>>>>>>                    
24733>>>>>>>>>>>>>>>>>                    Increment iItemIndex
24734>>>>>>>>>>>>>>>>>                End
24734>>>>>>>>>>>>>>>>>>
24734>>>>>>>>>>>>>>>>>                    
24734>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex
24735>>>>>>>>>>>>>>>>>            Loop
24736>>>>>>>>>>>>>>>>>>
24736>>>>>>>>>>>>>>>>>            Move (not(Found)) to bLast
24737>>>>>>>>>>>>>>>>>            
24737>>>>>>>>>>>>>>>>>            //  Restore filters
24737>>>>>>>>>>>>>>>>>            Send Clear of hoServer
24738>>>>>>>>>>>>>>>>>            Send DisregardFilterExpression hoServer sOrigFilter bOrigActive bFilterApplied
24739>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
24740>>>>>>>>>>>>>>>>>        End
24740>>>>>>>>>>>>>>>>>>
24740>>>>>>>>>>>>>>>>>    End_Procedure
24741>>>>>>>>>>>>>>>>>
24741>>>>>>>>>>>>>>>>>    Procedure FindValidation Boolean bFullText tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
24743>>>>>>>>>>>>>>>>>        Handle hoTable hoServer
24743>>>>>>>>>>>>>>>>>        Integer iCount iFound iLen iFile iField iItemIndex
24743>>>>>>>>>>>>>>>>>        Variant[][] aData
24744>>>>>>>>>>>>>>>>>        Boolean bCaseSensitive bAllData bOk
24744>>>>>>>>>>>>>>>>>        String sValue sDescription sCompareValue sCompareDescription
24744>>>>>>>>>>>>>>>>>        
24744>>>>>>>>>>>>>>>>>        Get Server to hoServer
24745>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24746>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24747>>>>>>>>>>>>>>>>>        Get pbAllData to bAllData
24748>>>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
24749>>>>>>>>>>>>>>>>>
24749>>>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
24751>>>>>>>>>>>>>>>>>            Get File_Field_Table_Object of hoServer iFile iField to hoTable
24752>>>>>>>>>>>>>>>>>            If (hoTable <> 0) Begin
24754>>>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
24755>>>>>>>>>>>>>>>>>        
24755>>>>>>>>>>>>>>>>>                Get pbCaseSensitive to bCaseSensitive  
24756>>>>>>>>>>>>>>>>>            
24756>>>>>>>>>>>>>>>>>                If (not(bCaseSensitive)) Begin
24758>>>>>>>>>>>>>>>>>                    Move (Lowercase(sFilter)) to sFilter
24759>>>>>>>>>>>>>>>>>                End
24759>>>>>>>>>>>>>>>>>>
24759>>>>>>>>>>>>>>>>>                
24759>>>>>>>>>>>>>>>>>                Move (SizeOfArray(aData)) to iCount
24760>>>>>>>>>>>>>>>>>                Move (Length(sFilter)) to iLen
24761>>>>>>>>>>>>>>>>>                
24761>>>>>>>>>>>>>>>>>                If (iPage > 0 and prevItem.sRowId > 0);                    Move (prevItem.sRowId + 1) to iFound
24764>>>>>>>>>>>>>>>>>            
24764>>>>>>>>>>>>>>>>>                While (iFound < iCount and (not(iItemIndex >= iPageSize) or bAllData))
24768>>>>>>>>>>>>>>>>>                    Move (Trim(aData[iFound][0])) to sValue
24769>>>>>>>>>>>>>>>>>                    Move (Trim(aData[iFound][1])) to sDescription
24770>>>>>>>>>>>>>>>>>                    Get Find_Code_Description of hoTable sValue to sDescription
24771>>>>>>>>>>>>>>>>>                    Move sValue to sCompareValue
24772>>>>>>>>>>>>>>>>>                    Move sDescription to sCompareDescription
24773>>>>>>>>>>>>>>>>>                    If (not(bCaseSensitive)) Begin
24775>>>>>>>>>>>>>>>>>                        Move (Lowercase(sCompareValue)) to sCompareValue
24776>>>>>>>>>>>>>>>>>                        Move (Lowercase(sCompareDescription)) to sCompareDescription
24777>>>>>>>>>>>>>>>>>                    End
24777>>>>>>>>>>>>>>>>>>
24777>>>>>>>>>>>>>>>>>                    Move False to bOk
24778>>>>>>>>>>>>>>>>>                    If (bFullText) Begin
24780>>>>>>>>>>>>>>>>>                        Move (sCompareValue contains sFilter or sCompareDescription contains sFilter) to bOk
24781>>>>>>>>>>>>>>>>>                    End
24781>>>>>>>>>>>>>>>>>>
24781>>>>>>>>>>>>>>>>>                    Else Begin
24782>>>>>>>>>>>>>>>>>                        Move (Left(sCompareValue, iLen) = sFilter or Left(sCompareDescription, iLen) = sFilter) to bOk
24783>>>>>>>>>>>>>>>>>                    End
24783>>>>>>>>>>>>>>>>>>
24783>>>>>>>>>>>>>>>>>                    
24783>>>>>>>>>>>>>>>>>                    If (bOk) Begin
24785>>>>>>>>>>>>>>>>>                        Move (String(iFound)) to aItems[iItemIndex].sRowId
24786>>>>>>>>>>>>>>>>>                        Move sValue to aItems[iItemIndex].aValues[0]
24787>>>>>>>>>>>>>>>>>                        Move sDescription to aItems[iItemIndex].aValues[1]
24788>>>>>>>>>>>>>>>>>                        
24788>>>>>>>>>>>>>>>>>                        Increment iItemIndex
24789>>>>>>>>>>>>>>>>>                    End
24789>>>>>>>>>>>>>>>>>>
24789>>>>>>>>>>>>>>>>>                    
24789>>>>>>>>>>>>>>>>>                    Increment iFound
24790>>>>>>>>>>>>>>>>>                Loop
24791>>>>>>>>>>>>>>>>>>
24791>>>>>>>>>>>>>>>>>                Move (iFound >= iCount) to bLast
24792>>>>>>>>>>>>>>>>>            End
24792>>>>>>>>>>>>>>>>>>
24792>>>>>>>>>>>>>>>>>        End
24792>>>>>>>>>>>>>>>>>>
24792>>>>>>>>>>>>>>>>>    End_Procedure
24793>>>>>>>>>>>>>>>>>
24793>>>>>>>>>>>>>>>>>    Function RefindByRowIdentification String sRowIdentification tSelectionItem ByRef tOut Returns Boolean
24795>>>>>>>>>>>>>>>>>        Handle hoServer hoTable
24795>>>>>>>>>>>>>>>>>        Integer iFile iField iRow
24795>>>>>>>>>>>>>>>>>        Variant[][] aData
24796>>>>>>>>>>>>>>>>>        Boolean bSuccess bCaseSensitive bIsValidationTable
24796>>>>>>>>>>>>>>>>>        RowID rRowId
24796>>>>>>>>>>>>>>>>>        
24796>>>>>>>>>>>>>>>>>        Get Server to hoServer
24797>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24798>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24799>>>>>>>>>>>>>>>>>        Get pbUseValidationTable to bIsValidationTable
24800>>>>>>>>>>>>>>>>>                
24800>>>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
24802>>>>>>>>>>>>>>>>>            If (not(bIsValidationTable)) Begin
24804>>>>>>>>>>>>>>>>>                Move (DeserializeRowID(sRowIdentification)) to rRowId    
24805>>>>>>>>>>>>>>>>>                If (not(IsNullRowID(rRowId))) Begin
24807>>>>>>>>>>>>>>>>>                    Get FindByRowIdEx of hoServer iFile rRowId to bSuccess
24808>>>>>>>>>>>>>>>>>                End
24808>>>>>>>>>>>>>>>>>>
24808>>>>>>>>>>>>>>>>>                If (bSuccess) Begin
24810>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to tOut.sRowId
24811>>>>>>>>>>>>>>>>>                    Get_Field_Value iFile iField to tOut.aValues[0]
24814>>>>>>>>>>>>>>>>>                    Move (Trim(tOut.aValues[0])) to tOut.aValues[0]
24815>>>>>>>>>>>>>>>>>                    Function_Return True
24816>>>>>>>>>>>>>>>>>                End
24816>>>>>>>>>>>>>>>>>>
24816>>>>>>>>>>>>>>>>>            End
24816>>>>>>>>>>>>>>>>>>
24816>>>>>>>>>>>>>>>>>            Else Begin
24817>>>>>>>>>>>>>>>>>                Get File_Field_Table_Object of hoServer iFile iField to hoTable
24818>>>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
24819>>>>>>>>>>>>>>>>>                Get pbCaseSensitive to bCaseSensitive
24820>>>>>>>>>>>>>>>>>            
24820>>>>>>>>>>>>>>>>>                For iRow from 0 to (SizeOfArray(aData) - 1)
24826>>>>>>>>>>>>>>>>>>
24826>>>>>>>>>>>>>>>>>                    If (aData[iRow][0] = sRowIdentification or (not(bCaseSensitive) and Lowercase(aData[iRow][0]) = sRowIdentification)) Begin
24828>>>>>>>>>>>>>>>>>                        If (not(bCaseSensitive)) Begin
24830>>>>>>>>>>>>>>>>>                            Move (Lowercase(aData[iRow][0])) to tOut.sRowId
24831>>>>>>>>>>>>>>>>>                            Move (Lowercase(Trim(aData[iRow][0]))) to tOut.aValues[0]
24832>>>>>>>>>>>>>>>>>                            Move (Lowercase(Trim(aData[iRow][1]))) to tOut.aValues[1]
24833>>>>>>>>>>>>>>>>>                        End
24833>>>>>>>>>>>>>>>>>>
24833>>>>>>>>>>>>>>>>>                        Else Begin
24834>>>>>>>>>>>>>>>>>                            Move aData[iRow][0] to tOut.sRowId
24835>>>>>>>>>>>>>>>>>                            Move (Trim(aData[iRow][0])) to tOut.aValues[0]
24836>>>>>>>>>>>>>>>>>                            Move (Trim(aData[iRow][1])) to tOut.aValues[1]
24837>>>>>>>>>>>>>>>>>                        End
24837>>>>>>>>>>>>>>>>>>
24837>>>>>>>>>>>>>>>>>                        Function_Return True
24838>>>>>>>>>>>>>>>>>                    End
24838>>>>>>>>>>>>>>>>>>
24838>>>>>>>>>>>>>>>>>                Loop
24839>>>>>>>>>>>>>>>>>>
24839>>>>>>>>>>>>>>>>>            End
24839>>>>>>>>>>>>>>>>>>
24839>>>>>>>>>>>>>>>>>        End
24839>>>>>>>>>>>>>>>>>>
24839>>>>>>>>>>>>>>>>>        Function_Return False
24840>>>>>>>>>>>>>>>>>    End_Function
24841>>>>>>>>>>>>>>>>>
24841>>>>>>>>>>>>>>>>>    Function RefindByValue String sValue tSelectionItem ByRef tOut Returns Boolean
24843>>>>>>>>>>>>>>>>>        Handle hoServer hoTable
24843>>>>>>>>>>>>>>>>>        String sDBValue
24843>>>>>>>>>>>>>>>>>        Integer iFile iField iRow iIndex
24843>>>>>>>>>>>>>>>>>        Variant[][] aData
24844>>>>>>>>>>>>>>>>>        Boolean bFound bCaseSensitive bIsValidationTable
24844>>>>>>>>>>>>>>>>>        
24844>>>>>>>>>>>>>>>>>        Get Server to hoServer
24845>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24846>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24847>>>>>>>>>>>>>>>>>        Get pbUseValidationTable to bIsValidationTable
24848>>>>>>>>>>>>>>>>>        Get pbCaseSensitive to bCaseSensitive
24849>>>>>>>>>>>>>>>>>        
24849>>>>>>>>>>>>>>>>>        Get piFindIndex to iIndex
24850>>>>>>>>>>>>>>>>>        If (iIndex <= 0) ;            Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
24855>>>>>>>>>>>>>>>>>        If (iIndex <= 0) ;            Error DFERR_PROGRAM C_$CouldNotFindAnIndex
24858>>>>>>>>>>>>>>>>>                
24858>>>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
24860>>>>>>>>>>>>>>>>>            If (not(bIsValidationTable)) Begin
24862>>>>>>>>>>>>>>>>>                Send Request_Clear of hoServer
24863>>>>>>>>>>>>>>>>>                Set_Field_Value iFile iField to sValue
24866>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GE iFile iIndex
24867>>>>>>>>>>>>>>>>>                Get_Field_Value iFile iField to sDBValue
24870>>>>>>>>>>>>>>>>>                
24870>>>>>>>>>>>>>>>>>                If (Found and (sDBValue = sValue or (not(bCaseSensitive) and Lowercase(sDBValue) = Lowercase(sValue)))) Begin
24872>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to tOut.sRowId
24873>>>>>>>>>>>>>>>>>                    Move (Trim(sValue)) to tOut.aValues[0]
24874>>>>>>>>>>>>>>>>>                    Function_Return True
24875>>>>>>>>>>>>>>>>>                End
24875>>>>>>>>>>>>>>>>>>
24875>>>>>>>>>>>>>>>>>            End
24875>>>>>>>>>>>>>>>>>>
24875>>>>>>>>>>>>>>>>>            Else Begin
24876>>>>>>>>>>>>>>>>>                Get File_Field_Table_Object of hoServer iFile iField to hoTable
24877>>>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
24878>>>>>>>>>>>>>>>>>        
24878>>>>>>>>>>>>>>>>>                For iRow from 0 to (SizeOfArray(aData) - 1)
24884>>>>>>>>>>>>>>>>>>
24884>>>>>>>>>>>>>>>>>                    If (aData[iRow][0] = sValue or (not(bCaseSensitive) and Lowercase(aData[iRow][0]) = Lowercase(sValue))) Begin
24886>>>>>>>>>>>>>>>>>                        Move aData[iRow][0] to tOut.sRowId
24887>>>>>>>>>>>>>>>>>                        Move (Trim(aData[iRow][0])) to tOut.aValues[0]
24888>>>>>>>>>>>>>>>>>                        Move (Trim(aData[iRow][1])) to tOut.aValues[1]
24889>>>>>>>>>>>>>>>>>                        Function_Return True
24890>>>>>>>>>>>>>>>>>                    End
24890>>>>>>>>>>>>>>>>>>
24890>>>>>>>>>>>>>>>>>                Loop
24891>>>>>>>>>>>>>>>>>>
24891>>>>>>>>>>>>>>>>>            End
24891>>>>>>>>>>>>>>>>>>
24891>>>>>>>>>>>>>>>>>        End
24891>>>>>>>>>>>>>>>>>>
24891>>>>>>>>>>>>>>>>>        Function_Return False
24892>>>>>>>>>>>>>>>>>    End_Function
24893>>>>>>>>>>>>>>>>>    
24893>>>>>>>>>>>>>>>>>    Function CreateItem tSelectionItem ByRef oOut String sValue Returns String
24895>>>>>>>>>>>>>>>>>        Boolean bFound bErr
24895>>>>>>>>>>>>>>>>>        Integer iFile iField
24895>>>>>>>>>>>>>>>>>        Handle hoServer hoTable
24895>>>>>>>>>>>>>>>>>        
24895>>>>>>>>>>>>>>>>>        Get RefindByValue sValue (&oOut) to bFound
24896>>>>>>>>>>>>>>>>>        If (bFound) ;            Function_Return True
24899>>>>>>>>>>>>>>>>>        
24899>>>>>>>>>>>>>>>>>        Get Server to hoServer
24900>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24901>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24902>>>>>>>>>>>>>>>>>        Get File_Field_Table_Object of hoServer iFile iField to hoTable
24903>>>>>>>>>>>>>>>>>        
24903>>>>>>>>>>>>>>>>>        If (hoTable <> 0) Begin
24905>>>>>>>>>>>>>>>>>            Error DFERR_PROGRAM C_$CannotInsertIntoValidationTable
24906>>>>>>>>>>>>>>>>>>
24906>>>>>>>>>>>>>>>>>            Function_Return False
24907>>>>>>>>>>>>>>>>>        End
24907>>>>>>>>>>>>>>>>>>
24907>>>>>>>>>>>>>>>>>        Else Begin
24908>>>>>>>>>>>>>>>>>            Send Request_Clear of hoServer
24909>>>>>>>>>>>>>>>>>            Set Field_Changed_Value of hoServer iField to sValue
24910>>>>>>>>>>>>>>>>>            Get Request_Validate of hoServer to bErr
24911>>>>>>>>>>>>>>>>>            If (bErr) Begin 
24913>>>>>>>>>>>>>>>>>                Error DFERR_PROGRAM C_$ErrorWhileSavingNewItem
24914>>>>>>>>>>>>>>>>>>
24914>>>>>>>>>>>>>>>>>                Function_Return False
24915>>>>>>>>>>>>>>>>>            End
24915>>>>>>>>>>>>>>>>>>
24915>>>>>>>>>>>>>>>>>            Send Request_Save of hoServer
24916>>>>>>>>>>>>>>>>>        
24916>>>>>>>>>>>>>>>>>            Move (SerializeRowID(GetRowID(iFile))) to oOut.sRowId
24917>>>>>>>>>>>>>>>>>            Move sValue to oOut.aValues[0]
24918>>>>>>>>>>>>>>>>>        End
24918>>>>>>>>>>>>>>>>>>
24918>>>>>>>>>>>>>>>>>        Function_Return True
24919>>>>>>>>>>>>>>>>>    End_Function
24920>>>>>>>>>>>>>>>>>
24920>>>>>>>>>>>>>>>>>    Procedure End_Construct_Object
24922>>>>>>>>>>>>>>>>>        Forward Send End_Construct_Object
24924>>>>>>>>>>>>>>>>>        
24924>>>>>>>>>>>>>>>>>        Boolean bIsTrapped
24924>>>>>>>>>>>>>>>>>        Get IsTrapped of Error_Object_id DFERR_BAD_MESSAGE to bIsTrapped
24925>>>>>>>>>>>>>>>>>        If (bIsTrapped) Begin
24927>>>>>>>>>>>>>>>>>            Send Ignore_Error of Error_Object_id DFERR_BAD_MESSAGE
24928>>>>>>>>>>>>>>>>>        End
24928>>>>>>>>>>>>>>>>>>
24928>>>>>>>>>>>>>>>>>        Delegate Set SelectionSource to Self
24930>>>>>>>>>>>>>>>>>        If (bIsTrapped) Begin
24932>>>>>>>>>>>>>>>>>            Send Trap_Error of Error_Object_id DFERR_BAD_MESSAGE
24933>>>>>>>>>>>>>>>>>        End
24933>>>>>>>>>>>>>>>>>>
24933>>>>>>>>>>>>>>>>>    End_Procedure

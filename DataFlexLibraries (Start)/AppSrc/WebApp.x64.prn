27245>>>>>>>>>    // Shows the search dialog.
27245>>>>>>>>>    Procedure Search
27247>>>>>>>>>        Send ClientAction "showSearch"
27248>>>>>>>>>    End_Procedure
27249>>>>>>>>>    
27249>>>>>>>>>    
27249>>>>>>>>>    // Called by the JavaScript engine to perform a search on an automatic data aware list
27249>>>>>>>>>    // (peDbGridType = gtAutomatic and pbDataAware = true). It can just perform the find on the DD
27249>>>>>>>>>    // and the list will refresh itself and select the right record.
27249>>>>>>>>>    Procedure OnSearch String sSearchText
27251>>>>>>>>>        Integer iCol
27251>>>>>>>>>        Handle hoCol
27251>>>>>>>>>        WebGet piSortColumn to iCol
27252>>>>>>>>>
27252>>>>>>>>>        If (iCol>=0) Begin
27254>>>>>>>>>            Get GetColumnObject iCol to hoCol
27255>>>>>>>>>            
27255>>>>>>>>>            // Perform the lookup
27255>>>>>>>>>            Send RequestColumnLookup of hoCol sSearchText
27256>>>>>>>>>        End
27256>>>>>>>>>>
27256>>>>>>>>>    End_Procedure
27257>>>>>>>>>
27257>>>>>>>>>    // Attempt to find the field from the server's MainFile that relates to iRelatedFile
27257>>>>>>>>>    Function RelatingField Integer iRelatedFile Returns Integer
27259>>>>>>>>>        Integer iField iRelFile iNumFields iIndex iMainfile
27259>>>>>>>>>        Handle hoServer
27259>>>>>>>>>        Boolean bDDRelates
27259>>>>>>>>>        Get Server to hoServer
27260>>>>>>>>>        Get Main_File of hoServer to iMainfile
27261>>>>>>>>>        Get pbUseDDRelates of hoServer to bDDRelates
27262>>>>>>>>>        Get_Attribute DF_FILE_NUMBER_FIELDS of iMainFile to iNumFields
27265>>>>>>>>>        For iField from 1 to iNumFields
27271>>>>>>>>>>
27271>>>>>>>>>            
27271>>>>>>>>>            // find first field that relates to the related file and has an index.
27271>>>>>>>>>            If (bDDRelates) Begin
27273>>>>>>>>>                Get Field_Related_File of hoServer iField to iRelFile
27274>>>>>>>>>            End
27274>>>>>>>>>>
27274>>>>>>>>>            Else Begin
27275>>>>>>>>>                Get_Attribute DF_FIELD_RELATED_FILE of iMainFile  iField to iRelFile
27278>>>>>>>>>            End
27278>>>>>>>>>>
27278>>>>>>>>>            
27278>>>>>>>>>            If (iRelFile=iRelatedFile) Begin
27280>>>>>>>>>                
27280>>>>>>>>>                If (bDDRelates) Begin
27282>>>>>>>>>                    Get Field_Related_Field of hoServer iField to iIndex
27283>>>>>>>>>                End
27283>>>>>>>>>>
27283>>>>>>>>>                Else Begin
27284>>>>>>>>>                    Get_Attribute DF_FIELD_INDEX of iMainFile iField to iIndex
27287>>>>>>>>>                End
27287>>>>>>>>>>
27287>>>>>>>>>                
27287>>>>>>>>>                If (iIndex>0) Begin
27289>>>>>>>>>                    Function_Return iField
27290>>>>>>>>>                End
27290>>>>>>>>>>
27290>>>>>>>>>            End
27290>>>>>>>>>>
27290>>>>>>>>>        Loop
27291>>>>>>>>>>
27291>>>>>>>>>        Function_Return -1
27292>>>>>>>>>    End_Function
27293>>>>>>>>>
27293>>>>>>>>>    // refresh DD aware Grid from the Top
27293>>>>>>>>>    Procedure FindFromTop
27295>>>>>>>>>       Send FindFromTB True
27296>>>>>>>>>    End_Procedure
27297>>>>>>>>>
27297>>>>>>>>>    // refresh DD aware Grid from the Bottom
27297>>>>>>>>>    Procedure FindFromBottom
27299>>>>>>>>>       Send FindFromTB False
27300>>>>>>>>>    End_Procedure
27301>>>>>>>>>    
27301>>>>>>>>>    // called for Select views to refresh the select list during back navigation.
27301>>>>>>>>>    // If a cancel, there is no target DD and no rowId. Just refresh around what's in the DDO
27301>>>>>>>>>    // If a close, we have a RowId for a target DDO. If the DDO matches this list's DDO, refresh 
27301>>>>>>>>>    // around that. 
27301>>>>>>>>>    // For now this is private
27301>>>>>>>>>    Procedure RefreshListForBackNavigation Boolean bCancel Handle hoDDTarget RowID riTarget
27303>>>>>>>>>        Boolean bDataAware bSuccess
27303>>>>>>>>>        Handle hoDD
27303>>>>>>>>>        Integer iMain
27303>>>>>>>>>        RowID riId
27303>>>>>>>>>        
27303>>>>>>>>>        If (pbGhost(Self)) ;            Procedure_Return
27306>>>>>>>>>        
27306>>>>>>>>>        Get pbDataAware to bDataAware
27307>>>>>>>>>        // if non-data aware there is no list update
27307>>>>>>>>>        If bDataAware Begin
27309>>>>>>>>>            // if close & update, with a different rowid refind the rowid passed in. 
27309>>>>>>>>>            If not bCancel Begin
27311>>>>>>>>>                Get Server to hoDD
27312>>>>>>>>>                If (hoDD and hoDD=hoDDTarget) Begin // test to make sure this is an appropriate list to update
27314>>>>>>>>>                    Get Main_File of hoDD to iMain
27315>>>>>>>>>                    Get CurrentRowId of hoDD to riId
27316>>>>>>>>>                    If (not(IsNullRowID(riTarget)) and not(IsSameRowID(riId,riTarget))) Begin
27318>>>>>>>>>                        // this will cause the list to refresh itself
27318>>>>>>>>>                        Get FindByRowIdEx of hoDD iMain riTarget to bSuccess
27319>>>>>>>>>                        If not bSuccess Begin
27321>>>>>>>>>                            Send HandleCacheError
27322>>>>>>>>>                        End
27322>>>>>>>>>>
27322>>>>>>>>>                        Procedure_Return
27323>>>>>>>>>                    End
27323>>>>>>>>>>
27323>>>>>>>>>                End
27323>>>>>>>>>>
27323>>>>>>>>>            End
27323>>>>>>>>>>
27323>>>>>>>>>            // else, refresh with current information around existing DD
27323>>>>>>>>>            Send RefreshListFromDD
27324>>>>>>>>>        End
27324>>>>>>>>>>
27324>>>>>>>>>    End_Procedure
27325>>>>>>>>>
27325>>>>>>>>>    
27325>>>>>>>>>    
27325>>>>>>>>>    // Refresh a data-aware grid around the current record in the DD
27325>>>>>>>>>    // If that record is 0 or not found, which you really don't want to happen,
27325>>>>>>>>>    // just refresh from firsts record
27325>>>>>>>>>    Procedure RefreshListFromDD
27327>>>>>>>>>        Handle hoDD
27327>>>>>>>>>        RowID riId
27327>>>>>>>>>        Integer iMain
27327>>>>>>>>>        Boolean bDataAware bSuccess
27327>>>>>>>>>        Get pbDataAware to bDataAware
27328>>>>>>>>>        If bDataAware Begin
27330>>>>>>>>>
27330>>>>>>>>>            If (pbNotifyingExternalDD(Self)) Begin
27332>>>>>>>>>                Error DFERR_PROGRAM "Assert: RefreshListFromDD called with pbNotifyingExternalDD set"
27333>>>>>>>>>>
27333>>>>>>>>>            End
27333>>>>>>>>>>
27333>>>>>>>>>
27333>>>>>>>>>            Get Server to hoDD
27334>>>>>>>>>            Get Main_File of hoDD to iMain
27335>>>>>>>>>            Get CurrentRowId of hoDD to riId
27336>>>>>>>>>            Move False to bSuccess
27337>>>>>>>>>            
27337>>>>>>>>>            If (not(IsNullRowID(riId))) Begin
27339>>>>>>>>>                // test to see if the record still exists
27339>>>>>>>>>                Get FindByRowIdEx of hoDD iMain riId to bSuccess 
27340>>>>>>>>>            End
27340>>>>>>>>>>
27340>>>>>>>>>            
27340>>>>>>>>>            If (not(bSuccess)) Begin
27342>>>>>>>>>                // missing record, we don't know what to do.
27342>>>>>>>>>                // Just refresh the entire list
27342>>>>>>>>>                Get FindInDD hoDD FIRST_RECORD to bSuccess
27343>>>>>>>>>                If (not(bSuccess)) Begin
27345>>>>>>>>>                    Send ClearGrid
27346>>>>>>>>>                End
27346>>>>>>>>>>
27346>>>>>>>>>            End
27346>>>>>>>>>>
27346>>>>>>>>>        End
27346>>>>>>>>>>
27346>>>>>>>>>    End_Procedure
27347>>>>>>>>>    
27347>>>>>>>>>    
27347>>>>>>>>>    // This event procedure is called when a row is clicked within the list and pbServerOnRowClick 
27347>>>>>>>>>    // is true. It is called after the actual row change is performed which means that if the row 
27347>>>>>>>>>    // change succeeded the psCurrentRowId matches the clicked row id. In case of a cWebGrid row 
27347>>>>>>>>>    // changes can fail due to validation issues so in that case the clicked row can be different. 
27347>>>>>>>>>    // Note that if pbOfflineEditing is true the buffer will not contain the selected row.
27347>>>>>>>>>    //
27347>>>>>>>>>    // Params:
27347>>>>>>>>>    //  sRowID          The rowid of the clicked row.
27347>>>>>>>>>    //  iColumnIndex    The cWebColumn object index (excl. non-cWebColumn siblings).
27347>>>>>>>>>    //                  When pressing enter in a cWebList this will be -1.
27347>>>>>>>>>    Procedure OnRowClick String sRowID Integer iColumnIndex
27349>>>>>>>>>        //  Empty event stub
27349>>>>>>>>>    End_Procedure
27350>>>>>>>>>
27350>>>>>>>>>    // Callback method sent to the callback control when a view receives NavigateForward.
27350>>>>>>>>>    // This should populate the tWebNavigateData in the default way according to the control's data bindings.
27350>>>>>>>>>    Procedure GetNavigateBackData Handle hoView tWebNavigateData ByRef NavigateData
27352>>>>>>>>>        Integer eGridType
27352>>>>>>>>>        String sId
27352>>>>>>>>>        Handle hoServer 
27352>>>>>>>>>        RowID ri
27352>>>>>>>>>        Boolean bOk bDataAware
27352>>>>>>>>>        
27352>>>>>>>>>        // Populate the Navigate Data struct with the best guess values from
27352>>>>>>>>>        // this control's server DDO
27352>>>>>>>>>        Get Server to hoServer
27353>>>>>>>>>        If (hoServer) Begin
27355>>>>>>>>>            WebGet peDbGridType to eGridType
27356>>>>>>>>>            WebGet pbDataAware to bDataAware
27357>>>>>>>>>            If (bDataAware and  eGridType<>gtAutomatic) Begin
27359>>>>>>>>>                WebGet psCurrentRowId     to sId
27360>>>>>>>>>                Get FindByRowIdEx of hoServer (Main_File(hoServer)) (DeserializeRowID(sId)) to bOk
27361>>>>>>>>>            End
27361>>>>>>>>>>
27361>>>>>>>>>            
27361>>>>>>>>>            WebGet psCurrentRowId     to sId
27362>>>>>>>>>            Get CurrentRowId of hoServer to ri
27363>>>>>>>>>            If (not(IsSameRowID(ri,(DeserializeRowID(sId))))) Begin
27365>>>>>>>>>                Error DFERR_PROGRAM "Assert: Different ids in weblist"
27366>>>>>>>>>>
27366>>>>>>>>>            End
27366>>>>>>>>>>
27366>>>>>>>>>
27366>>>>>>>>>        End
27366>>>>>>>>>>
27366>>>>>>>>>        Forward Send GetNavigateBackData hoView (&NavigateData)
27368>>>>>>>>>        
27368>>>>>>>>>    End_Procedure
27369>>>>>>>>>    
27369>>>>>>>>>    
27369>>>>>>>>>    // Callback method sent to the callback control when a view receives NavigateForward.
27369>>>>>>>>>    // This should populate the tWebNavigateData in the default way according to the control's data bindings.
27369>>>>>>>>>    Procedure GetNavigateForwardData Handle hoView tWebNavigateData ByRef NavigateData
27371>>>>>>>>>        Integer eGridType
27371>>>>>>>>>        String sId
27371>>>>>>>>>        Handle hoServer 
27371>>>>>>>>>        RowID ri
27371>>>>>>>>>        Boolean bOk bOldGridAction bFromDynamic
27371>>>>>>>>>        
27371>>>>>>>>>        // Populate the Navigate Data struct with the best guess values from
27371>>>>>>>>>        // this control's server DDO
27371>>>>>>>>>        Get Server to hoServer
27372>>>>>>>>>        // if not dataaware there will be no server!
27372>>>>>>>>>        If (hoServer) Begin
27374>>>>>>>>>            WebGet peDbGridType to eGridType
27375>>>>>>>>>            WebGet psCurrentRowId     to sId
27376>>>>>>>>>            // if not automatic, the server's row Id may not be current yet. 
27376>>>>>>>>>            If (eGridType<>gtAutomatic) Begin
27378>>>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
27379>>>>>>>>>                Set pbNotifyingExternalDD to True
27380>>>>>>>>>                Get FindByRowIdEx of hoServer (Main_File(hoServer)) (DeserializeRowID(sId)) to bOk
27381>>>>>>>>>                Set pbNotifyingExternalDD to bOldGridAction
27382>>>>>>>>>            End
27382>>>>>>>>>>
27382>>>>>>>>>            
27382>>>>>>>>>            // If the navigation is executed by a dynamic object, we don't care about this sanity check - especially durin initialization
27382>>>>>>>>>            Get IsDynamicObject to bFromDynamic
27383>>>>>>>>>            If (not(bFromDynamic) and not(pbGhost(Self))) Begin
27385>>>>>>>>>                // Assert that the Server's rowid matches the weblist's current row id
27385>>>>>>>>>                // if the DDO has no record, it is possible it could not refind what it
27385>>>>>>>>>                // needed and cleared it. We will not consider this an error, although it
27385>>>>>>>>>                // may display odd stuff (like a cleared parent).
27385>>>>>>>>>                Get CurrentRowId of hoServer to ri
27386>>>>>>>>>                If (not(IsNullRowID(ri)) and  not(IsSameRowID(ri,(DeserializeRowID(sId))))) Begin
27388>>>>>>>>>                    Error DFERR_PROGRAM "Assert: Different ids in weblist"
27389>>>>>>>>>>
27389>>>>>>>>>                End
27389>>>>>>>>>>
27389>>>>>>>>>            End
27389>>>>>>>>>>
27389>>>>>>>>>
27389>>>>>>>>>        End
27389>>>>>>>>>>
27389>>>>>>>>>        Forward Send GetNavigateForwardData hoView (&NavigateData)
27391>>>>>>>>>    
27391>>>>>>>>>    End_Procedure
27392>>>>>>>>>    
27392>>>>>>>>>    // Special augmentation for weblists. If this is not a dataaware grid, we want the server
27392>>>>>>>>>    // to be 0. We also want any child DEOs to have a 0 server, which they will
27392>>>>>>>>>    Function Server Returns Integer
27394>>>>>>>>>        Boolean bDataAware
27394>>>>>>>>>        Handle hoServer
27394>>>>>>>>>        
27394>>>>>>>>>        // note we use the property and not the web-property. Even though this is a web-property
27394>>>>>>>>>        // it is not expected that this would ever be webset changed
27394>>>>>>>>>        Get pbDataAware to bDataAware
27395>>>>>>>>>        If (bDataAware) Begin
27397>>>>>>>>>            Forward Get Server to hoServer
27399>>>>>>>>>        End
27399>>>>>>>>>>
27399>>>>>>>>>        Function_Return hoServer
27400>>>>>>>>>    End_Function
27401>>>>>>>>>
27401>>>>>>>>>    // This message is broadcast to all controls in a list view when
27401>>>>>>>>>    // navigating to the view. It is intended to allow the controls to set the
27401>>>>>>>>>    // ordering of row data (e.g. piOrdering)
27401>>>>>>>>>    Procedure InitOrdering tWebNavigateData NavigateData Handle hoInvokingObject
27403>>>>>>>>>        Integer iMainTable iSortCol
27403>>>>>>>>>        Integer eDbGridType
27403>>>>>>>>>        Handle hoServer hoMainDD
27403>>>>>>>>>        Boolean bDataAware bReverseOrdering
27403>>>>>>>>>    
27403>>>>>>>>>        Get Server to hoServer
27404>>>>>>>>>        Get Main_DD to hoMainDD
27405>>>>>>>>>        
27405>>>>>>>>>        // If no server or the server is not the view's main server, do nothing
27405>>>>>>>>>        If (hoServer=0 or hoServer<>hoMainDD) Begin
27407>>>>>>>>>            Procedure_Return
27408>>>>>>>>>        End
27408>>>>>>>>>>
27408>>>>>>>>>        
27408>>>>>>>>>        Get pbDataAware to bDataAware
27409>>>>>>>>>        Get peDbGridType to eDbGridType
27410>>>>>>>>>        
27410>>>>>>>>>        // restore to design time values
27410>>>>>>>>>        Get pbReverseOrdering to bReverseOrdering
27411>>>>>>>>>        WebSet pbReverseOrdering to bReverseOrdering
27412>>>>>>>>>
27412>>>>>>>>>        Get piSortColumn to iSortCol
27413>>>>>>>>>        WebSet piSortColumn to iSortCol
27414>>>>>>>>>
27414>>>>>>>>>        // if data-aware and autoloading we assign an automatic sort column    
27414>>>>>>>>>        If (eDbGridType <> gtManual and bDataAware) Begin
27416>>>>>>>>>            If (NavigateData.eNavigateType <> nfFromParent) Begin
27418>>>>>>>>>                Get Main_File of hoServer to iMainTable
27419>>>>>>>>>                If (iMainTable = NavigateData.iTable and iMainTable <> 0) Begin
27421>>>>>>>>>                    Get SelectBestColumn NavigateData.iTable NavigateData.iColumn to iSortCol
27422>>>>>>>>>                    If (iSortCol>=0) Begin
27424>>>>>>>>>                        WebSet piSortColumn to iSortCol
27425>>>>>>>>>                    End
27425>>>>>>>>>>
27425>>>>>>>>>                End
27425>>>>>>>>>>
27425>>>>>>>>>            End
27425>>>>>>>>>>
27425>>>>>>>>>        End
27425>>>>>>>>>>
27425>>>>>>>>>    End_Procedure 
27426>>>>>>>>>    
27426>>>>>>>>>    // This message is broadcast to a Select view when navigating to the view and there is no 
27426>>>>>>>>>    // record for the grid. It is intended to allow the list control to fill itself
27426>>>>>>>>>    // automatically when appropriate. It only does a fill if this is data aware grid,
27426>>>>>>>>>    // and the grid's server is the view's main DD. It simply loads from the "first" record 
27426>>>>>>>>>    Procedure InitGrid tWebNavigateData NavigateData Handle hoInvokingObject
27428>>>>>>>>>        Integer iIndex iMainTable
27428>>>>>>>>>        Integer eDbGridType
27428>>>>>>>>>        Handle hoServer hoMainDD
27428>>>>>>>>>        Boolean bSeeded bReverseOrdering bDataAware
27428>>>>>>>>>        Boolean bOldGridAction
27428>>>>>>>>>    
27428>>>>>>>>>        Get Server to hoServer
27429>>>>>>>>>        Get Main_DD to hoMainDD
27430>>>>>>>>>        If (hoServer=0 or hoServer<>hoMainDD) Begin
27432>>>>>>>>>            Procedure_Return
27433>>>>>>>>>        End
27433>>>>>>>>>>
27433>>>>>>>>>        
27433>>>>>>>>>        Get pbDataAware to bDataAware
27434>>>>>>>>>        Get peDbGridType to eDbGridType
27435>>>>>>>>>        
27435>>>>>>>>>        // if manually loaded or not data aware we will not do any init here. It can be done
27435>>>>>>>>>        // in OnNavigateForward
27435>>>>>>>>>        If (eDbGridType = gtManual or not(bDataAware)) Begin
27437>>>>>>>>>            Procedure_Return
27438>>>>>>>>>        End
27438>>>>>>>>>>
27438>>>>>>>>>        
27438>>>>>>>>>        Get pbReverseOrdering to bReverseOrdering
27439>>>>>>>>>        Get Main_File of hoServer to iMainTable
27440>>>>>>>>>        Get IndexOrder to iIndex
27441>>>>>>>>>
27441>>>>>>>>>        // Init list at the "start"
27441>>>>>>>>>        If (bReverseOrdering) Begin
27443>>>>>>>>>            Send Find of hoServer LAST_RECORD iIndex
27444>>>>>>>>>        End
27444>>>>>>>>>>
27444>>>>>>>>>        Else Begin
27445>>>>>>>>>            Send Find of hoServer FIRST_RECORD iIndex
27446>>>>>>>>>        End
27446>>>>>>>>>>
27446>>>>>>>>>
27446>>>>>>>>>        // If the seeding succeeded then ensure that all controls latch onto this
27446>>>>>>>>>        // otherwise just clear the DDOs
27446>>>>>>>>>        Get HasRecord of hoServer to bSeeded
27447>>>>>>>>>        
27447>>>>>>>>>        If bSeeded Begin
27449>>>>>>>>>            // this only updates the current record and does not refill the grid
27449>>>>>>>>>            Get pbNotifyingExternalDD to bOldGridAction
27450>>>>>>>>>            Set pbNotifyingExternalDD to True
27451>>>>>>>>>            Send Request_Assign of hoServer
27452>>>>>>>>>            Set pbNotifyingExternalDD to bOldGridAction
27453>>>>>>>>>        End
27453>>>>>>>>>>
27453>>>>>>>>>        Else Begin
27454>>>>>>>>>            Send ClearGrid
27455>>>>>>>>>        End
27455>>>>>>>>>>
27455>>>>>>>>>    End_Procedure 
27456>>>>>>>>>
27456>>>>>>>>>    Function SelectBestColumn Integer iFile Integer iField Returns Integer
27458>>>>>>>>>        Integer iCol iColFile iColField
27458>>>>>>>>>        Boolean bCol
27458>>>>>>>>>        Handle[] hoColumnObjects
27459>>>>>>>>>        
27459>>>>>>>>>        Get phoColumnObjects to hoColumnObjects
27460>>>>>>>>>        For iCol from 0 to (SizeOfArray(hoColumnObjects)-1)
27466>>>>>>>>>>
27466>>>>>>>>>            Get pbIsWebColumn of hoColumnObjects[iCol] to bCol
27467>>>>>>>>>            If (bCol) Begin
27469>>>>>>>>>                Get Data_File of hoColumnObjects[iCol] iCol to iColFile
27470>>>>>>>>>                If iFile Begin
27472>>>>>>>>>                    Get Data_Field of hoColumnObjects[iCol] iCol to iColField
27473>>>>>>>>>                    If (iColFile=iFile and iColField=iField) Begin
27475>>>>>>>>>                        Function_Return iCol
27476>>>>>>>>>                    End
27476>>>>>>>>>>
27476>>>>>>>>>                End
27476>>>>>>>>>>
27476>>>>>>>>>            End
27476>>>>>>>>>>
27476>>>>>>>>>        Loop
27477>>>>>>>>>>
27477>>>>>>>>>        Function_Return -1
27478>>>>>>>>>    End_Function
27479>>>>>>>>>    
27479>>>>>>>>>    Function DragData Returns Variant
27481>>>>>>>>>        tWebListDragData DragData
27481>>>>>>>>>        tWebListDragData DragData
27481>>>>>>>>>        Handle hoJsonData 
27481>>>>>>>>>        
27481>>>>>>>>>        Get phoJsonDragData to hoJsonData
27482>>>>>>>>>        If (hoJsonData <> C_WebUnresolvedObject) Begin
27484>>>>>>>>>            Get JsonToDataType of hoJsonData to DragData
27485>>>>>>>>>        End
27485>>>>>>>>>>
27485>>>>>>>>>        
27485>>>>>>>>>        Function_Return DragData
27486>>>>>>>>>    End_Function
27487>>>>>>>>>    
27487>>>>>>>>>    Function DropData Returns Variant
27489>>>>>>>>>        tWebListDropData DropData
27489>>>>>>>>>        tWebListDropData DropData
27489>>>>>>>>>        Handle hoJsonData
27489>>>>>>>>>        
27489>>>>>>>>>        Get phoJsonDropData to hoJsonData
27490>>>>>>>>>        
27490>>>>>>>>>        If (hoJsonData <> C_WebUnresolvedObject and IsOfJsonType(hoJsonData, jsonTypeObject)) Begin
27492>>>>>>>>>            Set pbRequireAllMembers of hoJsonData to False
27493>>>>>>>>>            Get JsonToDataType of hoJsonData to DropData
27494>>>>>>>>>        End
27494>>>>>>>>>>
27494>>>>>>>>>        
27494>>>>>>>>>        Function_Return DropData
27495>>>>>>>>>    End_Function
27496>>>>>>>>>    
27496>>>>>>>>>    Function SupportsDragAction Integer eAction Returns Boolean
27498>>>>>>>>>        If (eAction = C_WebDragListRow) Begin
27500>>>>>>>>>            Function_Return True
27501>>>>>>>>>        End
27501>>>>>>>>>>
27501>>>>>>>>>        
27501>>>>>>>>>        Function_Return False
27502>>>>>>>>>    End_Function
27503>>>>>>>>>    
27503>>>>>>>>>    Function SupportsDropAction Integer eAction Returns Boolean
27505>>>>>>>>>        Boolean bSupported
27505>>>>>>>>>        
27505>>>>>>>>>        Forward Get SupportsDropAction eAction to bSupported
27507>>>>>>>>>        
27507>>>>>>>>>        If (not(bSupported)) Begin
27509>>>>>>>>>            If (eAction = C_WebDropListRow) Begin
27511>>>>>>>>>                Move True to bSupported
27512>>>>>>>>>            End
27512>>>>>>>>>>
27512>>>>>>>>>        End
27512>>>>>>>>>>
27512>>>>>>>>>        
27512>>>>>>>>>        Function_Return bSupported
27513>>>>>>>>>    End_Function
27514>>>>>>>>>
27514>>>>>>>>>    // this exposed so developers can create their own error text
27514>>>>>>>>>    Procedure ReportCacheError
27516>>>>>>>>>        Error DFERR_CANT_REFIND_RECORD C_$InvalidRowInCache
27517>>>>>>>>>>
27517>>>>>>>>>    End_Procedure
27518>>>>>>>>>
27518>>>>>>>>>    // called when a record in the cache cannot be refound. Most likely this was deleted
27518>>>>>>>>>    // by another user.
27518>>>>>>>>>    // optionally report the error and do a refresh based around the current DD
27518>>>>>>>>>    Procedure HandleCacheError
27520>>>>>>>>>        Boolean bSuppressCacheError
27520>>>>>>>>>        
27520>>>>>>>>>        Get pbSuppressCacheError to bSuppressCacheError
27521>>>>>>>>>        If not bSuppressCacheError Begin 
27523>>>>>>>>>            Send ReportCacheError
27524>>>>>>>>>        End
27524>>>>>>>>>>
27524>>>>>>>>>        // reload the list based on current DD (this may also fail)
27524>>>>>>>>>        Send RefreshListFromDD        
27525>>>>>>>>>    End_Procedure
27526>>>>>>>>>    
27526>>>>>>>>>    
27526>>>>>>>>>    // This method is received by the Web Control that is the target of a CallAction that is sent
27526>>>>>>>>>    // from the client. Augmented to perform format conversion for parameters passed to OnSearch.
27526>>>>>>>>>    // methods.
27526>>>>>>>>>    Function HandleAction String sAction String[] aParams Handle hoAttachment Returns String
27528>>>>>>>>>        Integer i icParameters iCol
27528>>>>>>>>>        Integer eDataType
27528>>>>>>>>>        Handle hoCol
27528>>>>>>>>>        String sReturnVal
27528>>>>>>>>>        
27528>>>>>>>>>        // Get the parameter count
27528>>>>>>>>>        Move (SizeOfArray(aParams)) to icParameters
27529>>>>>>>>>        
27529>>>>>>>>>        // Special Case: OnChange
27529>>>>>>>>>        If (Uppercase(sAction) = "ONSEARCH") Begin
27531>>>>>>>>>            // If the action is an OnSearch event then we must test if the data type is a number, 
27531>>>>>>>>>            // Date or DateTime. If so we must convert each parameter value from the universal 
27531>>>>>>>>>            // transfer format
27531>>>>>>>>>            WebGet piSortColumn to iCol
27532>>>>>>>>>    
27532>>>>>>>>>            If (iCol >= 0) Begin
27534>>>>>>>>>                // Query the data type of the current sort column
27534>>>>>>>>>                Get GetColumnObject iCol to hoCol
27535>>>>>>>>>                Get peDataType of hoCol to eDataType
27536>>>>>>>>>                // Note: For efficienty we do not WebGet peDataType! In other words we do not
27536>>>>>>>>>                // get the "synchronized copy of peDataType (if there is one). This is much more
27536>>>>>>>>>                // efficient but it also assumes that a control's peDataType does not change 
27536>>>>>>>>>                // dynamically. This should be OK
27536>>>>>>>>>                
27536>>>>>>>>>                // Send Hook for converting the value to format for transport.
27536>>>>>>>>>                For i from 0 to (icParameters - 1)
27542>>>>>>>>>>
27542>>>>>>>>>                    Move (ConvertFromClient(eDataType, aParams[i])) to aParams[i]
27543>>>>>>>>>                Loop
27544>>>>>>>>>>
27544>>>>>>>>>            End
27544>>>>>>>>>>
27544>>>>>>>>>        End
27544>>>>>>>>>>
27544>>>>>>>>>        
27544>>>>>>>>>        // Now call the superclass's implementation of HandleAction 
27544>>>>>>>>>        Forward Get HandleAction sAction aParams hoAttachment to sReturnVal
27546>>>>>>>>>        
27546>>>>>>>>>        Function_Return sReturnVal
27547>>>>>>>>>    End_Function
27548>>>>>>>>>    
27548>>>>>>>>>    // Augment to make sure LoadDataPage is allowed when the control is disabled as well.
27548>>>>>>>>>    Procedure AllowServerAction Boolean  ByRef bAllow String sMethodName Handle hoMessage Boolean bIsFunction
27550>>>>>>>>>        If (hoMessage = RefProc(LoadDataPage)) Begin
27552>>>>>>>>>            Get IsControlAccessible False True to bAllow
27553>>>>>>>>>        End
27553>>>>>>>>>>
27553>>>>>>>>>        Else Begin
27554>>>>>>>>>            Forward Send AllowServerAction (&bAllow) sMethodName hoMessage bIsFunction
27556>>>>>>>>>        End
27556>>>>>>>>>>
27556>>>>>>>>>    End_Procedure
27557>>>>>>>>>        
27557>>>>>>>>>    // This function is called when serializing the object to client. We augment it here to 
27557>>>>>>>>>    // determine psKeyBuddy object name based on the handle set to phoKeyBuddy.
27557>>>>>>>>>    Procedure PreSerializeObject
27559>>>>>>>>>        Handle hoObj
27559>>>>>>>>>        String sObj
27559>>>>>>>>>        
27559>>>>>>>>>        Get phoKeyBuddy to hoObj
27560>>>>>>>>>        If (hoObj <> C_WebUnresolvedObject) Begin
27562>>>>>>>>>            Get WebObjectName of hoObj to sObj            
27563>>>>>>>>>        End
27563>>>>>>>>>>
27563>>>>>>>>>        Set psKeyBuddy to sObj
27564>>>>>>>>>    End_Procedure
27565>>>>>>>>>    
27565>>>>>>>>>    Procedure OnCreateDefaultHeaderMenu
27567>>>>>>>>>        Boolean bShowHeader bUseHeaderMenuOnWholeList
27567>>>>>>>>>        Handle hoDefaultHeaderMenu hoChild
27567>>>>>>>>>        
27567>>>>>>>>>        Get pbShowHeader to bShowHeader
27568>>>>>>>>>        Get pbUseHeaderMenuOnWholeList to bUseHeaderMenuOnWholeList
27569>>>>>>>>>        
27569>>>>>>>>>        Get CreateNamed of Self (RefClass(cWebContextMenu)) "oDefaultHeaderMenu" to hoDefaultHeaderMenu
27570>>>>>>>>>        Set piWidth of hoDefaultHeaderMenu to 220
27571>>>>>>>>>        Get CreateNamed of hoDefaultHeaderMenu (RefClass(cWebMenuColumnList)) "oColumnList" to hoChild
27572>>>>>>>>>        Get CreateNamed of hoDefaultHeaderMenu (RefClass(cWebMenuColumnRestorer)) "oColumnRestorer" to hoChild
27573>>>>>>>>>        Get CreateNamed of hoDefaultHeaderMenu (RefClass(cWebMenuGroupingSelector)) "oGroupingSelector" to hoChild
27574>>>>>>>>>
27574>>>>>>>>>        If (bShowHeader and not(bUseHeaderMenuOnWholeList)) Begin
27576>>>>>>>>>            Set peContext of hoDefaultHeaderMenu to C_WebUIContextListHead
27577>>>>>>>>>        End
27577>>>>>>>>>>
27577>>>>>>>>>        Else Begin
27578>>>>>>>>>            Set peContext of hoDefaultHeaderMenu to C_WebUIContextListFull
27579>>>>>>>>>        End
27579>>>>>>>>>>
27579>>>>>>>>>        
27579>>>>>>>>>        Set phPrivateDefaultHeaderMenu to hoDefaultHeaderMenu
27580>>>>>>>>>    End_Procedure
27581>>>>>>>>>    
27581>>>>>>>>>    Procedure End_Construct_Object
27583>>>>>>>>>        // Create the default menu if no custom was specified.
27583>>>>>>>>>        If (pbUseCustomHeaderMenu(Self) = False) Begin
27585>>>>>>>>>            Send OnCreateDefaultHeaderMenu
27586>>>>>>>>>        End
27586>>>>>>>>>>
27586>>>>>>>>>        
27586>>>>>>>>>        Forward Send End_Construct_Object
27588>>>>>>>>>        // Publish the event methods
27588>>>>>>>>>        WebPublishProcedure HandleProcessDataSet
27589>>>>>>>>>        WebPublishFunction ChangeCurrentRow
27590>>>>>>>>>        WebPublishProcedure LoadDataPage
27591>>>>>>>>>        WebPublishProcedure ChangeSorting
27592>>>>>>>>>        WebPublishProcedure OnSearch
27593>>>>>>>>>        WebPublishProcedure OnRowClick
27594>>>>>>>>>        WebPublishProcedure privateOnColumnLayoutChanged
27595>>>>>>>>>        WebPublishProcedure privateOnGroupConfigChanged
27596>>>>>>>>>        WebPublishProcedure privateOnGroupHeaderToggle
27597>>>>>>>>>    End_Procedure

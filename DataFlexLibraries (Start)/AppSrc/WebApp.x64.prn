37426>>>>>>>        Send OnDrop hoDragSource hoDropTarget eDropPosition
37427>>>>>>>        
37427>>>>>>>        //  Cleanup
37427>>>>>>>        If (hoDragSource <> C_WebUnresolvedObject) Begin
37429>>>>>>>            Set phoJsonDragData of hoDragSource to C_WebUnresolvedObject
37430>>>>>>>        End
37430>>>>>>>>

25327>>>>>>>>>>>>>    Procedure InsertTagBefore String sNextTag String sInsertTag
25329>>>>>>>>>>>>>        Send InsertTagRelative sNextTag True sInsertTag
25330>>>>>>>>>>>>>    End_Procedure
25331>>>>>>>>>>>>>    
25331>>>>>>>>>>>>>    Procedure InsertTagAfter String sPrevTag String sInsertTag
25333>>>>>>>>>>>>>        Send InsertTagRelative sPrevTag False sInsertTag
25334>>>>>>>>>>>>>    End_Procedure
25335>>>>>>>>>>>>>        
25335>>>>>>>>>>>>>    Procedure InsertTagRelative String sRelativeTag Boolean bToLeft String sInsertTag
25337>>>>>>>>>>>>>        Integer iIndex iOffset
25337>>>>>>>>>>>>>        Boolean bAdded bCaseSensitive
25337>>>>>>>>>>>>>        String sNormalizedInsertTag sNormalizedCacheTag
25337>>>>>>>>>>>>>        String[] asTags
25338>>>>>>>>>>>>>        
25338>>>>>>>>>>>>>        // We need to trim both parameters to be sure we comply to the client parsing.
25338>>>>>>>>>>>>>        Move (Trim(sRelativeTag)) to sRelativeTag
25339>>>>>>>>>>>>>        Move (Trim(sInsertTag)) to sInsertTag
25340>>>>>>>>>>>>>        
25340>>>>>>>>>>>>>        // Lower if specified.
25340>>>>>>>>>>>>>        WebGet pbCaseSensitive to bCaseSensitive
25341>>>>>>>>>>>>>        If (not(bCaseSensitive)) Begin
25343>>>>>>>>>>>>>            Move (Uppercase(sRelativeTag)) to sRelativeTag
25344>>>>>>>>>>>>>            Move (Uppercase(sInsertTag)) to sNormalizedInsertTag
25345>>>>>>>>>>>>>        End
25345>>>>>>>>>>>>>>
25345>>>>>>>>>>>>>        Else ;            Move sInsertTag to sNormalizedInsertTag
25347>>>>>>>>>>>>>        
25347>>>>>>>>>>>>>        // Skip if both are the same or if any is empty.
25347>>>>>>>>>>>>>        If (sRelativeTag = sNormalizedInsertTag or ;            Length(sRelativeTag) = 0 or ;            Length(sNormalizedInsertTag) = 0) ;            Procedure_Return
25350>>>>>>>>>>>>>            
25350>>>>>>>>>>>>>        // Set the offset
25350>>>>>>>>>>>>>        Move (If(bToLeft, 0, 1)) to iOffset
25351>>>>>>>>>>>>>        
25351>>>>>>>>>>>>>        // Initialize the tags
25351>>>>>>>>>>>>>        Move False to bAdded
25352>>>>>>>>>>>>>        Get GetTags to asTags
25353>>>>>>>>>>>>>        
25353>>>>>>>>>>>>>        // Loop the tags till we find our target; if not found we insert it at the end [not(bBreak)].
25353>>>>>>>>>>>>>        While (iIndex < SizeOfArray(asTags))
25357>>>>>>>>>>>>>            // Normalize current tag; the relative is already normalized.
25357>>>>>>>>>>>>>            Move asTags[iIndex] to sNormalizedCacheTag
25358>>>>>>>>>>>>>            If (not(bCaseSensitive)) ;                Move (Uppercase(sNormalizedCacheTag)) to sNormalizedCacheTag
25361>>>>>>>>>>>>>            
25361>>>>>>>>>>>>>            // If it is the tag we insert it and skip the inserted tag and the next othrwise it would cause recursion.
25361>>>>>>>>>>>>>            If (sNormalizedCacheTag = sRelativeTag) Begin
25363>>>>>>>>>>>>>                Move (InsertInArray(asTags, iIndex + iOffset, sInsertTag)) to asTags
25364>>>>>>>>>>>>>                Move True to bAdded
25365>>>>>>>>>>>>>                Move (iIndex + 2) to iIndex
25366>>>>>>>>>>>>>            End
25366>>>>>>>>>>>>>>
25366>>>>>>>>>>>>>            // If we find the same instances we remove it since the client would do it either way.
25366>>>>>>>>>>>>>            Else If (sNormalizedCacheTag = sNormalizedInsertTag) Begin
25369>>>>>>>>>>>>>                Move (RemoveFromArray(asTags, iIndex)) to asTags
25370>>>>>>>>>>>>>            End
25370>>>>>>>>>>>>>>
25370>>>>>>>>>>>>>            Else ;                Increment iIndex
25372>>>>>>>>>>>>>        Loop
25373>>>>>>>>>>>>>>
25373>>>>>>>>>>>>>        
25373>>>>>>>>>>>>>        If (not(bAdded)) ;            Move sInsertTag to asTags[SizeOfArray(asTags)]
25376>>>>>>>>>>>>>            
25376>>>>>>>>>>>>>        // Update the tags.
25376>>>>>>>>>>>>>        Send UpdateTags asTags
25377>>>>>>>>>>>>>    End_Procedure

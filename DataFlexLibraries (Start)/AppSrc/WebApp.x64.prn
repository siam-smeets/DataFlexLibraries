24020>>>>>>>>>>>>>>>>>>>    
24020>>>>>>>>>>>>>>>>>>>    //   This procedure discontinues the connection between this object and its
24020>>>>>>>>>>>>>>>>>>>    //   database agent(s) (Server and Watched_Servers).
24020>>>>>>>>>>>>>>>>>>>    Procedure Remove_DEO_From_Server
24022>>>>>>>>>>>>>>>>>>>        Integer hoServer hoWatchedServers
24022>>>>>>>>>>>>>>>>>>>        
24022>>>>>>>>>>>>>>>>>>>        Get Server to hoServer
24023>>>>>>>>>>>>>>>>>>>        
24023>>>>>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
24025>>>>>>>>>>>>>>>>>>>            Send Remove_User_Interface to hoServer Self
24026>>>>>>>>>>>>>>>>>>>        End
24026>>>>>>>>>>>>>>>>>>>>
24026>>>>>>>>>>>>>>>>>>>        
24026>>>>>>>>>>>>>>>>>>>        // Only send if watched-server exists
24026>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
24027>>>>>>>>>>>>>>>>>>>        
24027>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
24029>>>>>>>>>>>>>>>>>>>            Send Remove_User_Interface to hoWatchedServers Self True // TRUE for watchers
24030>>>>>>>>>>>>>>>>>>>        End
24030>>>>>>>>>>>>>>>>>>>>
24030>>>>>>>>>>>>>>>>>>>        
24030>>>>>>>>>>>>>>>>>>>        // when removed the deo is no longer up to date.
24030>>>>>>>>>>>>>>>>>>>        Set Refresh_Dirty_State to True
24031>>>>>>>>>>>>>>>>>>>    End_Procedure
24032>>>>>>>>>>>>>>>>>>>    
24032>>>>>>>>>>>>>>>>>>>    //   This procedure removes the specified object id (hoServer) from this object's
24032>>>>>>>>>>>>>>>>>>>    //   set of database agents who are merely 'watched', and destroys the
24032>>>>>>>>>>>>>>>>>>>    //   connection between the database agent and this object.
24032>>>>>>>>>>>>>>>>>>>    Procedure Remove_Watched_Server Integer hoServer
24034>>>>>>>>>>>>>>>>>>>        Integer iIndex
24034>>>>>>>>>>>>>>>>>>>        Handle hoWatchedServers
24034>>>>>>>>>>>>>>>>>>>        
24034>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
24035>>>>>>>>>>>>>>>>>>>        // Only if w server exists
24035>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
24037>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to False
24038>>>>>>>>>>>>>>>>>>>            Get find_element of hoWatchedServers hoServer to iIndex
24039>>>>>>>>>>>>>>>>>>>            If (iIndex >= 0) Begin
24041>>>>>>>>>>>>>>>>>>>                Send remove_element to hoWatchedServers hoServer
24042>>>>>>>>>>>>>>>>>>>            End
24042>>>>>>>>>>>>>>>>>>>>
24042>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to True
24043>>>>>>>>>>>>>>>>>>>            If (iIndex >= 0 and Active_State(Self)) Begin
24045>>>>>>>>>>>>>>>>>>>                Send Remove_User_Interface to hoServer Self True // TRUE for watchers
24046>>>>>>>>>>>>>>>>>>>            End
24046>>>>>>>>>>>>>>>>>>>>
24046>>>>>>>>>>>>>>>>>>>        End
24046>>>>>>>>>>>>>>>>>>>>
24046>>>>>>>>>>>>>>>>>>>    End_Procedure
24047>>>>>>>>>>>>>>>>>>>    
24047>>>>>>>>>>>>>>>>>>>    // This function returns the object id of the database agent of this object, or 0.
24047>>>>>>>>>>>>>>>>>>>    // If this object's Server is 0, this object's parent's Server is returned, if any.
24047>>>>>>>>>>>>>>>>>>>    // This function is used to allow nested data-entry objects to use the
24047>>>>>>>>>>>>>>>>>>>    // database agent defined by their parent object.
24047>>>>>>>>>>>>>>>>>>>    Function Server Returns Integer
24049>>>>>>>>>>>>>>>>>>>        Integer hoServer
24049>>>>>>>>>>>>>>>>>>>        Get private_Server to hoServer
24050>>>>>>>>>>>>>>>>>>>        If (hoServer = 0) Begin
24052>>>>>>>>>>>>>>>>>>>            Function_Return (Locate_Server(parent(Self)))
24053>>>>>>>>>>>>>>>>>>>        End
24053>>>>>>>>>>>>>>>>>>>>
24053>>>>>>>>>>>>>>>>>>>        Function_Return hoServer
24054>>>>>>>>>>>>>>>>>>>    End_Function
24055>>>>>>>>>>>>>>>>>>>    
24055>>>>>>>>>>>>>>>>>>>    // This procedure sets the value of the Server property of this object,
24055>>>>>>>>>>>>>>>>>>>    // notifying child-objects of the change, and destroying and creating
24055>>>>>>>>>>>>>>>>>>>    // connections with database agents, as required.
24055>>>>>>>>>>>>>>>>>>>    // If the Server of this object is changed while this object is inactive,
24055>>>>>>>>>>>>>>>>>>>    // no notification of child-objects is required or performed.
24055>>>>>>>>>>>>>>>>>>>    Procedure Set Server Integer newVal
24057>>>>>>>>>>>>>>>>>>>        Integer oldVal
24057>>>>>>>>>>>>>>>>>>>        
24057>>>>>>>>>>>>>>>>>>>        Set Explicit_Server_State to (newVal <> 0)
24058>>>>>>>>>>>>>>>>>>>        Get Server to oldVal
24059>>>>>>>>>>>>>>>>>>>        
24059>>>>>>>>>>>>>>>>>>>        If (newVal <> 0) Begin
24061>>>>>>>>>>>>>>>>>>>            Set private_Server to (object_id(newVal))
24062>>>>>>>>>>>>>>>>>>>        End
24062>>>>>>>>>>>>>>>>>>>>
24062>>>>>>>>>>>>>>>>>>>        Else Begin
24063>>>>>>>>>>>>>>>>>>>            Set private_Server to newVal
24064>>>>>>>>>>>>>>>>>>>        End
24064>>>>>>>>>>>>>>>>>>>>
24064>>>>>>>>>>>>>>>>>>>        
24064>>>>>>>>>>>>>>>>>>>        If (Active_State(Self)) Begin
24066>>>>>>>>>>>>>>>>>>>            Broadcast Send server_changed oldVal newVal
24068>>>>>>>>>>>>>>>>>>>            If (oldVal <> 0) Begin
24070>>>>>>>>>>>>>>>>>>>                Send Remove_DEO_From_Server  // detach from current server
24071>>>>>>>>>>>>>>>>>>>            End
24071>>>>>>>>>>>>>>>>>>>>
24071>>>>>>>>>>>>>>>>>>>            If (newval <> 0) Begin
24073>>>>>>>>>>>>>>>>>>>                Send Attach_Deo_To_Server    // attach to new server
24074>>>>>>>>>>>>>>>>>>>            End
24074>>>>>>>>>>>>>>>>>>>>
24074>>>>>>>>>>>>>>>>>>>        End
24074>>>>>>>>>>>>>>>>>>>>
24074>>>>>>>>>>>>>>>>>>>    End_Procedure
24075>>>>>>>>>>>>>>>>>>>    
24075>>>>>>>>>>>>>>>>>>>    //   This procedure servers as notification of a change in the connection
24075>>>>>>>>>>>>>>>>>>>    //   of this object's parent to its database agent.  If this object uses
24075>>>>>>>>>>>>>>>>>>>    //   its parent's database agent by default (see the Server and Find_Server
24075>>>>>>>>>>>>>>>>>>>    //   functions, above), it must disconnect from the old agent and connect
24075>>>>>>>>>>>>>>>>>>>    //   with the new agent.
24075>>>>>>>>>>>>>>>>>>>    Procedure Server_Changed Integer oldVal Integer newVal
24077>>>>>>>>>>>>>>>>>>>        Integer oldSrvr
24077>>>>>>>>>>>>>>>>>>>        
24077>>>>>>>>>>>>>>>>>>>        Get private_Server to oldSrvr
24078>>>>>>>>>>>>>>>>>>>        If (oldSrvr = 0) Begin  //assumes Server(self) = oldVal by deleg
24080>>>>>>>>>>>>>>>>>>>            If (oldVal <> 0) ;                Send remove_user_interface to oldVal Self
24083>>>>>>>>>>>>>>>>>>>            If (newVal <> 0) ;                Send add_user_interface to newVal Self
24086>>>>>>>>>>>>>>>>>>>        End
24086>>>>>>>>>>>>>>>>>>>>
24086>>>>>>>>>>>>>>>>>>>    End_Procedure
24087>>>>>>>>>>>>>>>>>>>    
24087>>>>>>>>>>>>>>>>>>>    // return the DEO that sets the server
24087>>>>>>>>>>>>>>>>>>>    Function ServerDEO Returns Handle
24089>>>>>>>>>>>>>>>>>>>        Handle hoServer hoServerDeo
24089>>>>>>>>>>>>>>>>>>>        Boolean bExplicitServer
24089>>>>>>>>>>>>>>>>>>>        Get Server to hoServer
24090>>>>>>>>>>>>>>>>>>>        If (hoServer) Begin
24092>>>>>>>>>>>>>>>>>>>            Get Explicit_Server_State to bExplicitServer
24093>>>>>>>>>>>>>>>>>>>            If (bExplicitServer) Begin
24095>>>>>>>>>>>>>>>>>>>                Move Self to hoServerDeo
24096>>>>>>>>>>>>>>>>>>>            End
24096>>>>>>>>>>>>>>>>>>>>
24096>>>>>>>>>>>>>>>>>>>            Else Begin
24097>>>>>>>>>>>>>>>>>>>                Delegate Get ServerDEO to hoServerDeo
24099>>>>>>>>>>>>>>>>>>>            End
24099>>>>>>>>>>>>>>>>>>>>
24099>>>>>>>>>>>>>>>>>>>        End
24099>>>>>>>>>>>>>>>>>>>>
24099>>>>>>>>>>>>>>>>>>>        Function_Return hoServerDeo
24100>>>>>>>>>>>>>>>>>>>    End_Function
24101>>>>>>>>>>>>>>>>>>>    

29913>>>>>>>
29913>>>>>>>
29913>>>>>>>// Class used by cWebApp to handle file streaming requests. Communicates with the resource manager 
29913>>>>>>>// via the ghoWebResourceManager handle.
29913>>>>>>>Class cWebResourceManagerProxy is a cWebHttpMultipartFormdataHandler
29914>>>>>>>    Procedure Construct_Object
29916>>>>>>>        Forward Send Construct_Object
29918>>>>>>>        
29918>>>>>>>        Send Define_cWebResourceManagerProxy_mixin
29919>>>>>>>        
29919>>>>>>>        //  Stores the hash during a file upload
29919>>>>>>>        Property String psHash ""
29920>>>>>>>        //  Stores the output channel during a file upload
29920>>>>>>>        Property Integer piChannel -1
29921>>>>>>>        //  Stores the file path during a file upload
29921>>>>>>>        Property String psUploadPath ""
29922>>>>>>>        //  Used to not send the status twice during file upload
29922>>>>>>>        Property Boolean pbStatusSent False
29923>>>>>>>        
29923>>>>>>>        
29923>>>>>>>        Set psVerbs to "GET,POST"
29924>>>>>>>        Set psPath to "DfResource"
29925>>>>>>>    End_Procedure
29926>>>>>>>    
29926>>>>>>>    Import_Class_Protocol cWebResourceManagerProxy_mixin
29927>>>>>>>    
29927>>>>>>>    //  A get request means we are downloading a file
29927>>>>>>>    Procedure OnHttpGet String sPath String sAcceptType
29929>>>>>>>        String[] aParts
29930>>>>>>>        String sHash sStreamType sFilePath sFileName sContentType sHttpError sAttach
29930>>>>>>>        Integer iPos iChnl iSize iHttpError
29930>>>>>>>        UChar[] aData
29931>>>>>>>        Boolean bOk
29931>>>>>>>        Handle hoResourceManager
29931>>>>>>>        
29931>>>>>>>        Get ResourceManager to hoResourceManager
29932>>>>>>>        
29932>>>>>>>        //  Determine key
29932>>>>>>>        Get UrlParameter "key" to sHash
29933>>>>>>>        If (Trim(sHash) = "") Begin
29935>>>>>>>            Send SetResponseStatus 404 "Invalid resource" 1
29936>>>>>>>            Procedure_Return
29937>>>>>>>        End
29937>>>>>>>>
29937>>>>>>>        
29937>>>>>>>        // Split the file name from the key 
29937>>>>>>>        Move (RightPos("/", sPath)) to iPos
29938>>>>>>>        If (iPos > 0) ;            Move (Right(sPath, Length(sPath) - iPos)) to sFileName
29941>>>>>>>        Else ;            Move sPath to sFileName
29943>>>>>>>        
29943>>>>>>>        //  Determine stream type
29943>>>>>>>        Get UrlParameter "attach" to sAttach
29944>>>>>>>        If (Lowercase(Trim(sAttach)) = "true") ;            Move "attachment" to sStreamType
29947>>>>>>>        Else ;            Move "inline" to sStreamType
29949>>>>>>>            
29949>>>>>>>        //  Let resource manager parse the path
29949>>>>>>>        Get FileDownload of hoResourceManager sHash (&sFilePath) (&iHttpError) (&sHttpError) to bOk
29950>>>>>>>        
29950>>>>>>>        If (not(bOk)) Begin
29952>>>>>>>            Send SetResponseStatus iHttpError sHttpError
29953>>>>>>>            Procedure_Return
29954>>>>>>>        End
29954>>>>>>>>
29954>>>>>>>                
29954>>>>>>>        //  Determine contenttype based on extension
29954>>>>>>>        Move (RightPos(".", sFileName)) to iPos
29955>>>>>>>        If (iPos >= 0) ;            Get ContentType of hoResourceManager (Right(sFileName, Length(sFileName) - iPos)) to sContentType
29958>>>>>>>        Else ;            Get ContentType of hoResourceManager "" to sContentType
29960>>>>>>>                
29960>>>>>>>        //  Open the file
29960>>>>>>>        Move (Seq_New_Channel()) to iChnl
29961>>>>>>>        If (iChnl >= 0) Begin
29963>>>>>>>            Direct_Input channel iChnl ("binary:" + sFilePath)
29965>>>>>>>            Get_Channel_Size iChnl to iSize
29966>>>>>>>            
29966>>>>>>>            //  Send the response headers
29966>>>>>>>            Send AddHttpResponseHeader "Content-Type" sContentType
29967>>>>>>>            Send AddHttpResponseHeader "Content-Disposition" (sStreamType +';filename="' + sFileName + '"')
29968>>>>>>>            Send AddHttpResponseHeader "Content-Length" iSize
29969>>>>>>>            
29969>>>>>>>            //  Send the file
29969>>>>>>>            While (not(SeqEof))
29973>>>>>>>                Read_Block channel iChnl aData HTTP_DEFAULT_CHUNK_SIZE
29975>>>>>>>                
29975>>>>>>>                Send OutputUChar aData
29976>>>>>>>            Loop
29977>>>>>>>>
29977>>>>>>>            
29977>>>>>>>            Close_Input channel iChnl
29979>>>>>>>            Send Seq_Release_Channel iChnl
29980>>>>>>>            
29980>>>>>>>            //  Trigger filedownloadfinished
29980>>>>>>>            Send FileDownloadFinished of hoResourceManager sFilePath
29981>>>>>>>        End
29981>>>>>>>>
29981>>>>>>>        Else If (iChnl = -1) Begin
29984>>>>>>>            Send SetResponseStatus 500 "I/O Channel Error" 1
29985>>>>>>>            Procedure_Return
29986>>>>>>>        End
29986>>>>>>>>
29986>>>>>>>        Else If (iChnl = -2) Begin
29989>>>>>>>            Send SetResponseStatus 500 "No I/O Channel Available" 2
29990>>>>>>>            Procedure_Return
29991>>>>>>>        End
29991>>>>>>>>
29991>>>>>>>    End_Procedure
29992>>>>>>>
29992>>>>>>>    //  In case of a post this is a file upload. The cWebHttpMultipartFormDataHandler base class 
29992>>>>>>>    //  will tear the request apart and trigger OnField and OnFile.. events. 
29992>>>>>>>    Procedure OnHttpPost String sPath String sContentType String sAcceptType DWord iSize
29994>>>>>>>        Send HandleFileUpload
29995>>>>>>>    End_Procedure
29996>>>>>>>    
29996>>>>>>>    // Main entry point for parsing the file upload
29996>>>>>>>    Procedure HandleFileUpload 
29998>>>>>>>        Boolean bSuccess bExists
29998>>>>>>>        String sFilePath
29998>>>>>>>        
29998>>>>>>>        Set psHash to ""
29999>>>>>>>        Set piChannel to -1
30000>>>>>>>        Set psUploadPath to ""
30001>>>>>>>        Set pbStatusSent to False
30002>>>>>>>
30002>>>>>>>        Get ParseMultipartFormData to bSuccess
30003>>>>>>>        //Send SetResponseStatus 500 "Invalid request format: test" 8
30003>>>>>>>        If (not(bSuccess)) Begin
30005>>>>>>>            Get psUploadPath to sFilePath    
30006>>>>>>>            If (sFilePath <> "") Begin
30008>>>>>>>                File_Exist sFilePath bExists
30009>>>>>>>                If (bExists) Begin
30011>>>>>>>                    EraseFile sFilePath 
30012>>>>>>>>
30012>>>>>>>                End
30012>>>>>>>>
30012>>>>>>>            End
30012>>>>>>>>
30012>>>>>>>            
30012>>>>>>>            If (not(pbstatussent(Self))) ;                Send SetResponseStatus 500 (psParseError(Self)) (piParseErrorCode(Self))             
30015>>>>>>>        End
30015>>>>>>>>
30015>>>>>>>        Set psHash to ""
30016>>>>>>>        Set piChannel to -1
30017>>>>>>>        Set psUploadPath to ""
30018>>>>>>>        Set pbStatusSent to False
30019>>>>>>>    End_Procedure
30020>>>>>>>    
30020>>>>>>>    //  The hash is sent as a field before the file is sent.
30020>>>>>>>    Procedure OnField String sName UChar[] ucData
30022>>>>>>>        Forward Send OnField sName ucData
30024>>>>>>>        
30024>>>>>>>        If (sName = "hash") Begin
30026>>>>>>>            Set psHash to (UCharArrayToString(ucData))
30027>>>>>>>        End
30027>>>>>>>>
30027>>>>>>>    End_Procedure
30028>>>>>>>    
30028>>>>>>>    //  When the file comes in we decrypt the hash and open the file. We store the channel so that
30028>>>>>>>    //  OnFileChunk can actually write the data.
30028>>>>>>>    Procedure OnFileStart String sFieldName String sFileName String sContentType Boolean ByRef bAbort
30030>>>>>>>        String sHash sPath sError
30030>>>>>>>        Integer iChnl iHttpErr
30030>>>>>>>        Boolean bExists bOk
30030>>>>>>>        
30030>>>>>>>        If (sFieldName = "file") Begin
30032>>>>>>>            Get psHash to sHash
30033>>>>>>>            
30033>>>>>>>            If (sHash = "") Begin
30035>>>>>>>                Send SetResponseStatus 500 "Invalid request format: expected hash before file." 4
30036>>>>>>>                Move True to bAbort
30037>>>>>>>                Set pbStatusSent to True
30038>>>>>>>                Procedure_Return
30039>>>>>>>            End
30039>>>>>>>>
30039>>>>>>>            
30039>>>>>>>            Get FileUpload of (ResourceManager(Self)) sFileName sHash (&sPath) (&iHttpErr) (&sError) to bOk
30040>>>>>>>            If (not(bOk)) Begin
30042>>>>>>>                Send SetResponseStatus iHttpErr sError
30043>>>>>>>                Set pbStatusSent to True
30044>>>>>>>                Move True to bAbort
30045>>>>>>>                Procedure_Return
30046>>>>>>>            End
30046>>>>>>>>
30046>>>>>>>            
30046>>>>>>>            File_Exist sPath bExists
30047>>>>>>>            
30047>>>>>>>            If (not(bExists)) Begin
30049>>>>>>>                Move (Seq_New_Channel()) to iChnl
30050>>>>>>>                If (iChnl >= 0) Begin
30052>>>>>>>                    Direct_Output channel iChnl ("binary:" + sPath)
30054>>>>>>>                    Set piChannel to iChnl
30055>>>>>>>                    Set psUploadPath to sPath
30056>>>>>>>                End
30056>>>>>>>>
30056>>>>>>>                Else If (iChnl = -1) Begin
30059>>>>>>>                    Send SetResponseStatus 500 "I/O Channel Error" 1
30060>>>>>>>                    Set pbStatusSent to True
30061>>>>>>>                    Move True to bAbort
30062>>>>>>>                End
30062>>>>>>>>
30062>>>>>>>                Else If (iChnl = -2) Begin
30065>>>>>>>                    Send SetResponseStatus 500 "No I/O Channel Available" 2
30066>>>>>>>                    Set pbStatusSent to True
30067>>>>>>>                    Move True to bAbort
30068>>>>>>>                End
30068>>>>>>>>
30068>>>>>>>            End
30068>>>>>>>>
30068>>>>>>>            Else Begin
30069>>>>>>>                Send SetResponseStatus 500 "File already exists" 6
30070>>>>>>>                Set pbStatusSent to True
30071>>>>>>>                Move True to bAbort
30072>>>>>>>            End
30072>>>>>>>>
30072>>>>>>>        End
30072>>>>>>>>
30072>>>>>>>    End_Procedure
30073>>>>>>>    
30073>>>>>>>    //  Called for each chunk of data that comes in for a file, we simply write it out to the 
30073>>>>>>>    //  already opened file channel.
30073>>>>>>>    Procedure OnFileChunk String sFieldName UChar[] ByRef ucData
30075>>>>>>>        Integer iChnl
30075>>>>>>>        
30075>>>>>>>        If (sFieldName = "file") Begin
30077>>>>>>>            Get piChannel to iChnl
30078>>>>>>>            If (iChnl >= 0) Begin
30080>>>>>>>                Write channel iChnl ucData
30082>>>>>>>            End
30082>>>>>>>>
30082>>>>>>>        End
30082>>>>>>>>
30082>>>>>>>    End_Procedure
30083>>>>>>>    
30083>>>>>>>    //  The upload is done, we send back a positive response.
30083>>>>>>>    Procedure OnFileFinished String sFieldName
30085>>>>>>>        Integer iChnl
30085>>>>>>>        String sFilePath
30085>>>>>>>        
30085>>>>>>>        If (sFieldName = "file") Begin
30087>>>>>>>            Get piChannel to iChnl
30088>>>>>>>            If (iChnl >= 0) Begin
30090>>>>>>>                Close_Output channel iChnl
30092>>>>>>>                Send Seq_Release_Channel iChnl
30093>>>>>>>                
30093>>>>>>>                Get psUploadPath to sFilePath
30094>>>>>>>                                
30094>>>>>>>                Set piChannel to -1
30095>>>>>>>                Set psUploadPath to ""
30096>>>>>>>                
30096>>>>>>>                Send SetResponseStatus 201 "Upload succesfull" 0
30097>>>>>>>                Set pbStatusSent to True
30098>>>>>>>                Send FileUploadFinished of (ResourceManager(Self)) sFilePath
30099>>>>>>>            End
30099>>>>>>>>
30099>>>>>>>            Else If (iChnl = -1) Begin
30102>>>>>>>                Send SetResponseStatus 500 "I/O Channel Error" 1
30103>>>>>>>                Set pbStatusSent to True
30104>>>>>>>            End
30104>>>>>>>>
30104>>>>>>>            Else If (iChnl = -2) Begin
30107>>>>>>>                Send SetResponseStatus 500 "No I/O Channel Available" 2
30108>>>>>>>                Set pbStatusSent to True
30109>>>>>>>            End
30109>>>>>>>>
30109>>>>>>>        End
30109>>>>>>>>
30109>>>>>>>    End_Procedure

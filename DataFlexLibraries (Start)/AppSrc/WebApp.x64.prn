31009>>>>>>>
31009>>>>>>>//  Struct format in which the properties are stored.
31009>>>>>>>Struct tWebStoredProps
31009>>>>>>>    tWebSyncProps[] aProps
31009>>>>>>>    tWebSyncProps[] aProps
31009>>>>>>>    tWebAdvProp[] aAdvProps
31009>>>>>>>    tWebAdvProp[] aAdvProps
31009>>>>>>>End_Struct
31009>>>>>>>
31009>>>>>>>// Handler for server-side web properties (WebProperty=Server and WebProperty=ServerSession). The
31009>>>>>>>// base class contains the logic for storing these in memory. At first access they are loaded from 
31009>>>>>>>// a store (cWebServerPropStore, usually the database) and at the end of a request they are written
31009>>>>>>>// to the store. This class handles the logic for determining the key and serializing to / from a 
31009>>>>>>>// JSON string passed along as UChar array.
31009>>>>>>>//
31009>>>>>>>
31009>>>>>>>Class cWebServerPropHandler is a cWebBasePropHandler
31010>>>>>>>    
31010>>>>>>>    Procedure Construct_Object
31012>>>>>>>        Forward Send Construct_Object
31014>>>>>>>        
31014>>>>>>>        Property Boolean pbSessionScope False
31015>>>>>>>        
31015>>>>>>>        Property Boolean pbLoaded False
31016>>>>>>>        Property Boolean pbChanged False
31017>>>>>>>        
31017>>>>>>>        Property Integer piGenKeyLength 64
31018>>>>>>>        
31018>>>>>>>        Property Handle phoRandomizer -1
31019>>>>>>>        Property Handle phoJsonParser -1
31020>>>>>>>        
31020>>>>>>>        Set pbErrorObjNotFound to False
31021>>>>>>>        
31021>>>>>>>        Object oRandomGen is a cCryptographerEx
31023>>>>>>>            Set phoRandomizer to Self
31024>>>>>>>        End_Object
31025>>>>>>>        
31025>>>>>>>        Object oJsonParser is a cJsonObject
31027>>>>>>>            Set phoJsonParser to Self
31028>>>>>>>            Set pbUseVariantMetaData to True
31029>>>>>>>            Set pbRequireAllMembers to False
31030>>>>>>>        End_Object
31031>>>>>>>    End_Procedure
31032>>>>>>>    
31032>>>>>>>    //
31032>>>>>>>    // Makes sure the properties are loaded before letting the base class perform the WebGet.
31032>>>>>>>    //
31032>>>>>>>    Function GetAdvSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns Variant
31034>>>>>>>        Boolean bLoaded
31034>>>>>>>        Variant vResult
31034>>>>>>>        
31034>>>>>>>        Get pbLoaded to bLoaded
31035>>>>>>>        If (not(bLoaded) and pbActive(Self)) Begin
31037>>>>>>>            Send LoadProps
31038>>>>>>>        End
31038>>>>>>>>
31038>>>>>>>        
31038>>>>>>>        Forward Get GetAdvSyncProp hoObject (&pubProp) to vResult
31040>>>>>>>        
31040>>>>>>>        Function_Return vResult
31041>>>>>>>    End_Function
31042>>>>>>>    
31042>>>>>>>    
31042>>>>>>>    //
31042>>>>>>>    // Makes sure the properties are loaded before letting the base class perform the WebGet.
31042>>>>>>>    //
31042>>>>>>>    Function GetScalarSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns String
31044>>>>>>>        Boolean bLoaded
31044>>>>>>>        String sResult
31044>>>>>>>        
31044>>>>>>>        Get pbLoaded to bLoaded
31045>>>>>>>        If (not(bLoaded) and pbActive(Self)) Begin
31047>>>>>>>            Send LoadProps
31048>>>>>>>        End
31048>>>>>>>>
31048>>>>>>>        
31048>>>>>>>        Forward Get GetScalarSyncProp hoObject (&pubProp) to sResult
31050>>>>>>>        
31050>>>>>>>        Function_Return sResult
31051>>>>>>>    End_Function
31052>>>>>>>    
31052>>>>>>>    
31052>>>>>>>    
31052>>>>>>>    
31052>>>>>>>    //
31052>>>>>>>    // Makes sure the properties are loaded before letting the base class perform the WebSet.
31052>>>>>>>    //
31052>>>>>>>    Procedure SetSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Variant vPropValue
31054>>>>>>>        Boolean bLoaded
31054>>>>>>>        
31054>>>>>>>        Get pbLoaded to bLoaded
31055>>>>>>>        If (not(bLoaded)) Begin
31057>>>>>>>            Send LoadProps
31058>>>>>>>        End
31058>>>>>>>>
31058>>>>>>>        
31058>>>>>>>        Forward Send SetSyncProp hoObject (&pubProp) vPropValue
31060>>>>>>>        
31060>>>>>>>        Set pbChanged to True
31061>>>>>>>    End_Procedure
31062>>>>>>>    
31062>>>>>>>    
31062>>>>>>>    //
31062>>>>>>>    // Server-side web properties are always in scope.
31062>>>>>>>    //
31062>>>>>>>    Function IsObjectInCallActionScope Handle hoObject Returns Boolean
31064>>>>>>>        Function_Return True
31065>>>>>>>    End_Function
31066>>>>>>>    
31066>>>>>>>    
31066>>>>>>>    //
31066>>>>>>>    // Loads the web properties from the property store and deserializes them.
31066>>>>>>>    //
31066>>>>>>>    Procedure LoadProps
31068>>>>>>>        String sKey
31068>>>>>>>        Boolean bResult
31068>>>>>>>        UChar[] ucPropData
31069>>>>>>>        tWebStoredProps props
31069>>>>>>>        tWebStoredProps props
31069>>>>>>>        Handle hoJsonParser hoServerPropStore
31069>>>>>>>        
31069>>>>>>>        Get ServerPropStore to hoServerPropStore
31070>>>>>>>        
31070>>>>>>>        If (hoServerPropStore = C_WebUnresolvedObject) Begin
31072>>>>>>>            Error DFERR_PROGRAM "Unable to WebGet / WebSet the server property. The phoWebServerPropStore is not initialized. The most likely cause is the WebAppServerProp table not being available."
31073>>>>>>>>
31073>>>>>>>            Procedure_Return
31074>>>>>>>        End
31074>>>>>>>>
31074>>>>>>>        
31074>>>>>>>        Get phoJsonParser to hoJsonParser
31075>>>>>>>        Get StoreKey to sKey
31076>>>>>>>        Get LoadPropValues of hoServerPropStore sKey (&ucPropData) to bResult
31077>>>>>>>        
31077>>>>>>>        If (bResult) Begin
31079>>>>>>>            Get ParseUtf8 of hoJsonParser ucPropData to bResult
31080>>>>>>>            If (bResult) Begin
31082>>>>>>>                Get JsonToDataType of hoJsonParser to props
31083>>>>>>>                
31083>>>>>>>                //  We do this to release the JSON structure in memory without destroying the object
31083>>>>>>>                Send InitializeJsonType of hoJsonParser jsonTypeNull
31084>>>>>>>            End
31084>>>>>>>>
31084>>>>>>>        End
31084>>>>>>>>
31084>>>>>>>        
31084>>>>>>>        Send InitializeSyncProps props.aProps props.aAdvProps
31085>>>>>>>        
31085>>>>>>>        Set pbChanged to False
31086>>>>>>>        Set pbLoaded to True
31087>>>>>>>    End_Procedure
31088>>>>>>>    
31088>>>>>>>    
31088>>>>>>>    //
31088>>>>>>>    // Called when the webapp finished handlign a request. If the web properties where loaded and 
31088>>>>>>>    // changed it stores them. If they were loaded but not changed it gives the store a chance to
31088>>>>>>>    // unlock them.
31088>>>>>>>    //
31088>>>>>>>    Procedure FinishedCall tWebSyncProps[] ByRef aChangedSyncProps tWebAdvSyncProp[] ByRef aChangedAdvSyncProps
31090>>>>>>>        Boolean bLoaded bChanged
31090>>>>>>>        Integer iStoreIndex iSize iProp icProp
31090>>>>>>>        UChar[] ucPropData
31091>>>>>>>        String sKey
31091>>>>>>>        tWebStoredProps props
31091>>>>>>>        tWebStoredProps props
31091>>>>>>>        Handle hoJsonParser
31091>>>>>>>        
31091>>>>>>>        Get pbLoaded to bLoaded
31092>>>>>>>        
31092>>>>>>>        If (bLoaded) Begin
31094>>>>>>>            Get pbChanged to bChanged
31095>>>>>>>            Get piStoreIndex to iStoreIndex
31096>>>>>>>            Get phoJsonParser to hoJsonParser
31097>>>>>>>            Get StoreKey to sKey
31098>>>>>>>            If (bChanged) Begin
31100>>>>>>>                //  Get regular props (reduce size of array to actual size)
31100>>>>>>>                Get piSize to iSize
31101>>>>>>>                Move (ResizeArray(gaSyncProps[iStoreIndex], iSize)) to props.aProps
31102>>>>>>>                
31102>>>>>>>                //  Gather advanced sync props
31102>>>>>>>                Move (SizeOfArray(gaAdvSyncProps[iStoreIndex])) to icProp
31103>>>>>>>                Move (ResizeArray(props.aAdvProps, icProp)) to props.aAdvProps
31104>>>>>>>                For iProp from 0 to (icProp - 1)
31110>>>>>>>>
31110>>>>>>>                    Move gaAdvSyncProps[iStoreIndex][iProp].tSvrProp to props.aAdvProps[iProp]
31111>>>>>>>                Loop
31112>>>>>>>>
31112>>>>>>>                
31112>>>>>>>                Send DataTypeToJson of hoJsonParser props
31113>>>>>>>                Get StringifyUtf8 of hoJsonParser to ucPropData
31114>>>>>>>                
31114>>>>>>>                Send StorePropValues of (ServerPropStore(Self)) sKey (&ucPropData)
31115>>>>>>>            End
31115>>>>>>>>
31115>>>>>>>            Else Begin
31116>>>>>>>                Send ReleasePropValues of (ServerPropStore(Self)) sKey
31117>>>>>>>            End
31117>>>>>>>>
31117>>>>>>>            
31117>>>>>>>            Set pbLoaded to False
31118>>>>>>>        End
31118>>>>>>>>
31118>>>>>>>        
31118>>>>>>>        Forward Send FinishedCall (&aChangedSyncProps) (&aChangedAdvSyncProps)
31120>>>>>>>    End_Procedure
31121>>>>>>>    
31121>>>>>>>    
31121>>>>>>>    //
31121>>>>>>>    // Augments the InitializeSyncProps with logic to initialize the advanced properties. For
31121>>>>>>>    // server web properties these are not serialized to a value tree so this is different as for
31121>>>>>>>    // client web properties.
31121>>>>>>>    //
31121>>>>>>>    Procedure InitializeSyncProps tWebSyncProps[] aSyncProps tWebAdvProp[] aAdvProps
31123>>>>>>>        Integer iSize iProp iStoreIndex
31123>>>>>>>        Handle hoLocator
31123>>>>>>>        
31123>>>>>>>        Get phoWebControlLocator to hoLocator
31124>>>>>>>        Get piStoreIndex to iStoreIndex
31125>>>>>>>        
31125>>>>>>>        //  Initialize the advanced property cache
31125>>>>>>>        Move (SizeOfArray(aAdvProps)) to iSize
31126>>>>>>>        Move (ResizeArray(gaAdvSyncProps[iStoreIndex], iSize)) to gaAdvSyncProps[iStoreIndex]
31127>>>>>>>        
31127>>>>>>>        For iProp from 0 to (iSize - 1)
31133>>>>>>>>
31133>>>>>>>            Get FindWebObject of hoLocator aAdvProps[iProp].sO to gaAdvSyncProps[iStoreIndex][iProp].hoObj
31134>>>>>>>            Move False                  to gaAdvSyncProps[iStoreIndex][iProp].bChanged
31135>>>>>>>            Move True                   to gaAdvSyncProps[iStoreIndex][iProp].bDeserialized
31136>>>>>>>            Move aAdvProps[iProp]       to gaAdvSyncProps[iStoreIndex][iProp].tSvrProp
31137>>>>>>>        Loop
31138>>>>>>>>
31138>>>>>>>        
31138>>>>>>>        Forward Send InitializeSyncProps aSyncProps
31140>>>>>>>    End_Procedure
31141>>>>>>>    
31141>>>>>>>    
31141>>>>>>>    //
31141>>>>>>>    //  Search for an advanced web property in the advanced web properties array.
31141>>>>>>>    //
31141>>>>>>>    Function FindAdvPropCache Handle hoObj String sPropName Returns Integer
31143>>>>>>>        Integer iTo iCur iStoreIndex
31143>>>>>>>        
31143>>>>>>>        Get piStoreIndex to iStoreIndex
31144>>>>>>>        
31144>>>>>>>        Move (Uppercase(sPropName)) to sPropName
31145>>>>>>>        Move (SizeOfArray(gaAdvSyncProps[iStoreIndex]) - 1) to iTo
31146>>>>>>>        For iCur from 0 to iTo
31152>>>>>>>>
31152>>>>>>>            If (gaAdvSyncProps[iStoreIndex][iCur].hoObj = hoObj and Uppercase(gaAdvSyncProps[iStoreIndex][iCur].tSvrProp.sP) = sPropName) Begin
31154>>>>>>>                Function_Return iCur
31155>>>>>>>            End
31155>>>>>>>>
31155>>>>>>>        Loop
31156>>>>>>>>
31156>>>>>>>        
31156>>>>>>>        Function_Return -1
31157>>>>>>>    End_Function
31158>>>>>>>    
31158>>>>>>>    //
31158>>>>>>>    // Determines the key under which the server properties are stored. For serversession 
31158>>>>>>>    // properties this is the session key where for regular server properties this is a unique key
31158>>>>>>>    // generated and saved in a client web property.
31158>>>>>>>    //
31158>>>>>>>    Function StoreKey Returns String
31160>>>>>>>        Integer eLifetime
31160>>>>>>>        String sKey
31160>>>>>>>        Handle hoCryptRandom
31160>>>>>>>        Boolean bSessionScope
31160>>>>>>>        
31160>>>>>>>        Get pbSessionScope to bSessionScope
31161>>>>>>>        
31161>>>>>>>        If (bSessionScope) Begin
31163>>>>>>>            Get psSessionKey of (SessionManager(Self)) to sKey
31164>>>>>>>        End
31164>>>>>>>>
31164>>>>>>>        Else Begin
31165>>>>>>>            WebGet psSPKey of (phowebhost(Self)) to sKey
31166>>>>>>>            
31166>>>>>>>            If (sKey = "") Begin
31168>>>>>>>                Get phoRandomizer to hoCryptRandom
31169>>>>>>>                Get GenerateRandomString of hoCryptRandom (piGenKeyLength(Self)) to sKey
31170>>>>>>>                

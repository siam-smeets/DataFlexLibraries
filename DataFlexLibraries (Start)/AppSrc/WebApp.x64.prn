308>>>>>>>>>>>>>>>External_Function GetFullPathNameW "GetFullPathNameW" Kernel32.dll ;    WString sFileName ;    DWord   nBufferLength ;    Pointer lpBuffer ;    Pointer lpFilePart ;    Returns Integer
309>>>>>>>>>>>>>>>
309>>>>>>>>>>>>>>>// Compatibility Wrapper Function GetFullPathName
309>>>>>>>>>>>>>>>Function GetFullPathName Global ;    String  sFileName ;    DWord   nBufferLength ;    Pointer lpBuffer ;    Pointer lpFilePart ;    // Address of a pointer to a string    Returns Integer
311>>>>>>>>>>>>>>>    
311>>>>>>>>>>>>>>>    Integer iResult iVoid
311>>>>>>>>>>>>>>>    Pointer lplpFP
311>>>>>>>>>>>>>>>    String  sFilePart
311>>>>>>>>>>>>>>>    UWide   uwBuffer
311>>>>>>>>>>>>>>>    UWide   uwBuffer
311>>>>>>>>>>>>>>>    
311>>>>>>>>>>>>>>>    Send WideSetBuffer lpBuffer (AddressOf(nBufferLength)) (&uwBuffer)
312>>>>>>>>>>>>>>>                    
312>>>>>>>>>>>>>>>    Move (GetFullPathNameW (sFileName, nBufferLength, uwBuffer.lpUText, lpFilePart)) to iResult 
313>>>>>>>>>>>>>>>    
313>>>>>>>>>>>>>>>    Send WideToString (&uwBuffer) lpBuffer
314>>>>>>>>>>>>>>>    
314>>>>>>>>>>>>>>>    // lpFilePart is a pointer to a buffer that receives the address (within lpBuffer) of the final file name 
314>>>>>>>>>>>>>>>    // component in the path. But it is pointing to the UWide struct. Convert it to UTF8 and copy it to lpFilePart.
314>>>>>>>>>>>>>>>    Move (DeRefPtr(lpFilePart, 0)) to lplpFP       // Get the Address of the string
315>>>>>>>>>>>>>>>    Move (PointerToWString(lplpFP)) to sFilePart
316>>>>>>>>>>>>>>>    Move (MemCopy(lplpFP, AddressOf(sFilePart), SizeOfString(sFilePart) + 1)) to iVoid
317>>>>>>>>>>>>>>>    
317>>>>>>>>>>>>>>>    Function_Return iResult
318>>>>>>>>>>>>>>>End_Function

35370>>>>>>>        Handle hoServer hoDD
35370>>>>>>>        Integer iFile iField
35370>>>>>>>        String sRowId
35370>>>>>>>        RowID riRowId
35370>>>>>>>        Boolean bAllowFind
35370>>>>>>>        
35370>>>>>>>        If (not(AppSynching(Host(Self)))) Begin
35372>>>>>>>            Get Server to hoServer
35373>>>>>>>            Get Data_File to iFile

10515>>>>>>>>>    Function SQLPrivateColAttribute Integer iCol Integer iAttribId Integer ihdbc String sDrvrId Integer ihstmt Returns String
10517>>>>>>>>>        String  sResult
10517>>>>>>>>>        String  sEmpty
10517>>>>>>>>>        Integer bIsStringAttribute
10517>>>>>>>>>        Integer iLen
10517>>>>>>>>>        Integer iVoid
10517>>>>>>>>>        Integer bLegalAttrib
10517>>>>>>>>>        Integer bLegalColumn
10517>>>>>>>>>        
10517>>>>>>>>>        // Initialize
10517>>>>>>>>>        Move "" to sResult
10518>>>>>>>>>        Move "" to sEmpty
10519>>>>>>>>>        Move 0  to iLen
10520>>>>>>>>>        
10520>>>>>>>>>        // Get the attribute
10520>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10522>>>>>>>>>            Get SQLPrivateColumnIsLegal ihdbc sDrvrId ihstmt iCol to bLegalColumn
10523>>>>>>>>>            If (bLegalColumn) Begin
10525>>>>>>>>>                // Determine the atributes type
10525>>>>>>>>>                Case Begin
10525>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_SIZE)
10527>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_LENGTH)
10530>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_PRECISION)
10533>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_SQLTYPE)
10536>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_NULLABLE)
10539>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_DFTYPE)
10542>>>>>>>>>                        Move DFFALSE to bIsStringAttribute
10543>>>>>>>>>                        Move DFTRUE to bLegalAttrib
10544>>>>>>>>>                        Break
10545>>>>>>>>>                        
10545>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_LABEL)
10548>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_BASECOLUMNNAME)
10551>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_BASETABLENAME)
10554>>>>>>>>>                        Move DFTRUE to bIsStringAttribute
10555>>>>>>>>>                        Move DFTRUE to bLegalAttrib
10556>>>>>>>>>                        Break
10557>>>>>>>>>                        
10557>>>>>>>>>                    Case Else
10557>>>>>>>>>                        Move DFFALSE to bLegalAttrib
10558>>>>>>>>>                        Send SQLIllegalAttribute ("Attribute is = " + String(iAttribId) + ")") "SQLPrivateColAttribute"
10559>>>>>>>>>                Case End
10559>>>>>>>>>                
10559>>>>>>>>>                If (bLegalAttrib) Begin
10561>>>>>>>>>                    // Setup function arguments
10561>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                        Callback Self ;                        Passing ihdbc iCol ihstmt ;                        Result iVoid
10566>>>>>>>>>                    
10566>>>>>>>>>                    If (bIsStringAttribute) Begin
10568>>>>>>>>>                        // Call the driver function to get the data length
10568>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLCOLSTRINGATTRIBLEN ;                            Callback Self ;                            Passing sEmpty sEmpty iAttribId ;                            Result iLen
10573>>>>>>>>>                        
10573>>>>>>>>>                        If (iLen) Begin
10575>>>>>>>>>                            // Allocate
10575>>>>>>>>>                            Move (Repeat(' ', iLen)) to sResult
10576>>>>>>>>>                            
10576>>>>>>>>>                            // Call the driver function to get the name
10576>>>>>>>>>                            Call_Driver 0 sDrvrId Function FUNC_SQLCOLSTRINGATTRIB ;                                Callback Self ;                                Passing sResult sEmpty iAttribId ;                                Result iVoid
10581>>>>>>>>>                        End
10581>>>>>>>>>>
10581>>>>>>>>>                    End
10581>>>>>>>>>>
10581>>>>>>>>>                    Else Begin
10582>>>>>>>>>                        // get the attribute
10582>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLCOLINTATTRIB ;                            Callback Self ;                            Passing sEmpty sEmpty iAttribId ;                            Result sResult
10587>>>>>>>>>                    End
10587>>>>>>>>>>
10587>>>>>>>>>                End
10587>>>>>>>>>>
10587>>>>>>>>>            End
10587>>>>>>>>>>
10587>>>>>>>>>            Else ;                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLPrivateColAttribute"
10589>>>>>>>>>        End
10589>>>>>>>>>>
10589>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrivateColAttribute"
10591>>>>>>>>>        
10591>>>>>>>>>        Function_Return sResult
10592>>>>>>>>>    End_Function

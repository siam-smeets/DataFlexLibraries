26199>>>>>>>>>>>            If (hoFilterDD = hoDD) Begin
26201>>>>>>>>>>>                Procedure_Return
26202>>>>>>>>>>>            End
26202>>>>>>>>>>>>
26202>>>>>>>>>>>            Else Begin
26203>>>>>>>>>>>                Move True to FilterState.bDisregardFilter
26204>>>>>>>>>>>                Move FilterState to vFilterState
26205>>>>>>>>>>>                Send DisregardFilter vFilterState
26206>>>>>>>>>>>                Move False to FilterState.bDisregardFilter
26207>>>>>>>>>>>                Move FilterState to vFilterState
26208>>>>>>>>>>>            End
26208>>>>>>>>>>>>
26208>>>>>>>>>>>        End
26208>>>>>>>>>>>>
26208>>>>>>>>>>>
26208>>>>>>>>>>>        Get pbUseDDSqlFilters of hoDD to bOrigActive
26209>>>>>>>>>>>        Get psSQLFilter of hoDD to sOrigFilter
26210>>>>>>>>>>>
26210>>>>>>>>>>>        If (not(bOrigActive)) Begin

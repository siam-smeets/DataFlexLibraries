10280>>>>>>>>>                    // in the next FUNC_SQLCOLUMNVALUE call.
10280>>>>>>>>>                    // If hdbc and hstmt have not changed since the last call we don't have to set it.
10280>>>>>>>>>                    If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
10282>>>>>>>>>                        // Setup function arguments
10282>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                            Callback 0 ;                            Passing ihdbc iCol ihstmt ;                            Result iVoid
10287>>>>>>>>>                        Move ihstmt to giLastSQLhstmt
10288>>>>>>>>>                        Move ihdbc to giLastSQLhdbc
10289>>>>>>>>>                    End
10289>>>>>>>>>>
10289>>>>>>>>>                    
10289>>>>>>>>>                    Move False to Err
10290>>>>>>>>>                    // Call the driver function to get the data
10290>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLGETDATA ;                        Callback Self ;                        Passing iCol iLen (AddressOf(wResult)) ;                        Result iResult
10295>>>>>>>>>                    
10295>>>>>>>>>                    // If something went wrong, adjust the result
10295>>>>>>>>>                    If (Err) Begin
10297>>>>>>>>>                        Move 0 to iResult
10298>>>>>>>>>                    End
10298>>>>>>>>>>
10298>>>>>>>>>                    
10298>>>>>>>>>                    // SQL_NO_TOTAL (-4) Not all data retrieved. Unknown how much is left. 
10298>>>>>>>>>                    If (iResult = -4) Begin
10300>>>>>>>>>                        Move (SizeOfWString(wResult)) to iResult
10301>>>>>>>>>                    End
10301>>>>>>>>>>
10301>>>>>>>>>                End
10301>>>>>>>>>>
10301>>>>>>>>>            End
10301>>>>>>>>>>
10301>>>>>>>>>            Else Begin
10302>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLGetData"
10303>>>>>>>>>            End
10303>>>>>>>>>>
10303>>>>>>>>>        End
10303>>>>>>>>>>
10303>>>>>>>>>        Else Begin
10304>>>>>>>>>            Send HandleError ihstmt ihdbc sDrvrId "SQLGetData"
10305>>>>>>>>>        End
10305>>>>>>>>>>
10305>>>>>>>>>        
10305>>>>>>>>>        // Fill global result
10305>>>>>>>>>        If (iResult > 0) Begin
10307>>>>>>>>>            Move 1 to SQLResult // SQLResult == 1 : Something was found
10308>>>>>>>>>        End
10308>>>>>>>>>>
10308>>>>>>>>>        Else Begin
10309>>>>>>>>>           Move 0 to SQLResult // SQLResult == 0 : no (more) data found
10310>>>>>>>>>        End
10310>>>>>>>>>>
10310>>>>>>>>>        
10310>>>>>>>>>        Function_Return (CString(wResult))
10311>>>>>>>>>    End_Function
10312>>>>>>>>>
10312>>>>>>>>>    // SQLGetDataToUChar (SQLGetData returning uchar array)
10312>>>>>>>>>    // Use for binary data and for character data containing Unicode non-bmp characters
10312>>>>>>>>>    Function SQLGetDataToUChar Integer iCol Integer iLen Returns UChar[]
10314>>>>>>>>>        Integer ihdbc
10314>>>>>>>>>        Integer ihstmt
10314>>>>>>>>>        Integer iVoid
10314>>>>>>>>>        Integer iColSize
10314>>>>>>>>>        Integer iResult
10314>>>>>>>>>        String  sDrvrId
10314>>>>>>>>>        UChar[] uaResult
10315>>>>>>>>>        
10315>>>>>>>>>        Integer iSQLType
10315>>>>>>>>>        Integer iBinaryType
10315>>>>>>>>>        Integer iLenArray
10315>>>>>>>>>        Integer iResizeSize
10315>>>>>>>>>        
10315>>>>>>>>>        Move 0 to iResult
10316>>>>>>>>>        
10316>>>>>>>>>        // Get the cli handles
10316>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10317>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10318>>>>>>>>>        Get psDriverId            to sDrvrId
10319>>>>>>>>>        
10319>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10321>>>>>>>>>            // Check if the column exists
10321>>>>>>>>>            If (iCol >= 1 and iCol <= piColumnCount(Self)) Begin
10323>>>>>>>>>                            
10323>>>>>>>>>                Get SQLColumnType iCol to iSQLType
10324>>>>>>>>>                If ( (iSQLType = SQL_BINARY) or (iSQLType = SQL_VARBINARY) or (iSQLType = SQL_LONGVARBINARY) ) Begin
10326>>>>>>>>>                    Move 1 to iBinaryType
10327>>>>>>>>>                End
10327>>>>>>>>>>
10327>>>>>>>>>                Else Begin
10328>>>>>>>>>                    Move 0 to iBinaryType 
10329>>>>>>>>>                End
10329>>>>>>>>>>
10329>>>>>>>>>    
10329>>>>>>>>>                If (iBinaryType) Begin
10331>>>>>>>>>                    Move (ResizeArray(uaResult,iLen)) to uaResult
10332>>>>>>>>>                End
10332>>>>>>>>>>
10332>>>>>>>>>                Else Begin
10333>>>>>>>>>                    // Character type
10333>>>>>>>>>                    // returned as wstring (2 bytes per character)
10333>>>>>>>>>                    // Add 1 for string terminator
10333>>>>>>>>>                    Move (iLen + 1) to iLen
10334>>>>>>>>>                    Move (iLen * 2) to iLenArray // wstring 2 bytes per char
10335>>>>>>>>>                    Move (ResizeArray(uaResult,iLenArray)) to uaResult
10336>>>>>>>>>                End
10336>>>>>>>>>>
10336>>>>>>>>>
10336>>>>>>>>>                // FUNC_SQLCOLUMNINFO will tell the driver which hdbc and hstmt to use
10336>>>>>>>>>                // in the next FUNC_SQLCOLUMNVALUE call.
10336>>>>>>>>>                If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
10338>>>>>>>>>                    // Setup function arguments
10338>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                        Callback 0 ;                        Passing ihdbc iCol ihstmt ;                        Result iVoid
10343>>>>>>>>>                    Move ihstmt to giLastSQLhstmt
10344>>>>>>>>>                    Move ihdbc to giLastSQLhdbc
10345>>>>>>>>>                End
10345>>>>>>>>>>
10345>>>>>>>>>                
10345>>>>>>>>>                Move False to Err
10346>>>>>>>>>                
10346>>>>>>>>>                // Call the driver function to get the data
10346>>>>>>>>>                // iResult will be the length of the data in bytes 
10346>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLGETDATA ;                    Callback Self ;                    Passing iCol iLen (AddressOf(uaResult[0])) ;                    Result iResult
10351>>>>>>>>>                
10351>>>>>>>>>                // If something went wrong, adjust the result
10351>>>>>>>>>                If (Err) Begin
10353>>>>>>>>>                    Move 0 to iResult
10354>>>>>>>>>                End
10354>>>>>>>>>>
10354>>>>>>>>>                
10354>>>>>>>>>                // SQL_NO_TOTAL (-4) Not all data retrieved. Unknown how much is left. 
10354>>>>>>>>>                If (iResult = -4) Begin
10356>>>>>>>>>                    Move (SizeOfArray(uaResult)) to iResult
10357>>>>>>>>>                End
10357>>>>>>>>>>
10357>>>>>>>>>                
10357>>>>>>>>>                If (iBinaryType) Begin
10359>>>>>>>>>                    If (iResult < iLen) Begin
10361>>>>>>>>>                        Move (ResizeArray(uaResult,iResult)) to uaResult
10362>>>>>>>>>                    End
10362>>>>>>>>>>
10362>>>>>>>>>                End
10362>>>>>>>>>>
10362>>>>>>>>>                Else Begin
10363>>>>>>>>>                    // Character data
10363>>>>>>>>>                    //   iResult has length of data in bytes (without zero terminator)
10363>>>>>>>>>                    //   uaResult will have data + zero terminator
10363>>>>>>>>>                    If (iResult < (iLenArray - 2) ) Begin
10365>>>>>>>>>                        // Received less than requested, strip off trailing zeroes.
10365>>>>>>>>>                        Move iResult to iResizeSize
10366>>>>>>>>>                    End
10366>>>>>>>>>>
10366>>>>>>>>>                    Else Begin
10367>>>>>>>>>                        // Strip off zero terminator
10367>>>>>>>>>                        Move (iLenArray - 2) to iResizeSize
10368>>>>>>>>>                    End
10368>>>>>>>>>>
10368>>>>>>>>>                    
10368>>>>>>>>>                    Move (ResizeArray(uaResult,iResizeSize)) to uaResult
10369>>>>>>>>>                    
10369>>>>>>>>>                End
10369>>>>>>>>>>
10369>>>>>>>>>            End
10369>>>>>>>>>>
10369>>>>>>>>>            Else Begin
10370>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLGetData"
10371>>>>>>>>>            End
10371>>>>>>>>>>
10371>>>>>>>>>        End
10371>>>>>>>>>>
10371>>>>>>>>>        Else Begin
10372>>>>>>>>>            Send HandleError ihstmt ihdbc sDrvrId "SQLGetData"
10373>>>>>>>>>        End
10373>>>>>>>>>>
10373>>>>>>>>>        
10373>>>>>>>>>        // Fill global result
10373>>>>>>>>>        If (iResult > 0) Begin
10375>>>>>>>>>            Move 1 to SQLResult // SQLResult == 1 : Something was found
10376>>>>>>>>>        End
10376>>>>>>>>>>
10376>>>>>>>>>        Else Begin
10377>>>>>>>>>           Move 0 to SQLResult // SQLResult == 0 : no (more) data found
10378>>>>>>>>>        End
10378>>>>>>>>>>
10378>>>>>>>>>        
10378>>>>>>>>>        Function_Return uaResult
10379>>>>>>>>>
10379>>>>>>>>>    End_Function
10380>>>>>>>>>    
10380>>>>>>>>>    
10380>>>>>>>>>    // Map a column name to a number, if the name id not found no
10380>>>>>>>>>    // error is generated the returned number will be 0 (zero) in
10380>>>>>>>>>    // that case
10380>>>>>>>>>    Function SQLColumnMap String sColname Returns Integer
10382>>>>>>>>>        Integer ihdbc
10382>>>>>>>>>        Integer ihstmt
10382>>>>>>>>>        Integer iNumColumns
10382>>>>>>>>>        Integer iColCount
10382>>>>>>>>>        Integer iColNum
10382>>>>>>>>>        String  sDrvrId
10382>>>>>>>>>        String  sCurColName
10382>>>>>>>>>        
10382>>>>>>>>>        // Get the cli handles
10382>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10383>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10384>>>>>>>>>        Get psDriverId            to sDrvrId
10385>>>>>>>>>        
10385>>>>>>>>>        // Get the number by looping through the column names
10385>>>>>>>>>        Move 0 to iColNum
10386>>>>>>>>>        Get SQLPrivateStmtAttribute SQLSTMTATTRIB_COLUMNCOUNT ihdbc sDrvrId ihstmt to iNumColumns
10387>>>>>>>>>        For iColCount from 1 to iNumColumns
10393>>>>>>>>>>
10393>>>>>>>>>            Get SQLPrivateColAttribute iColCount SQLCOLATTRIB_LABEL ihdbc sDrvrId ihstmt to sCurColName
10394>>>>>>>>>            If (Uppercase(Trim(sColName)) = Uppercase(Trim(sCurColName))) ;                Move iColCount to iColNum
10397>>>>>>>>>            
10397>>>>>>>>>            If (iColNum) ;                Break
10400>>>>>>>>>        Loop
10401>>>>>>>>>>
10401>>>>>>>>>        
10401>>>>>>>>>        Function_Return iColNum
10402>>>>>>>>>    End_Function

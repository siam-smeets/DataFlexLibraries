34759>>>>>>>    
34759>>>>>>>    // Send this to trigger OnFill event to populate the combo list.
34759>>>>>>>    // Note: we wanted to call this method "Fill" but this symbol is already used in FMAC
34759>>>>>>>    //       which means we cannot register it using WebPublishMethod
34759>>>>>>>    Procedure RefillLabels
34761>>>>>>>        String[] aParams
34762>>>>>>>        tWebNameValue[] aEmpty aData
34762>>>>>>>        tWebNameValue[] aEmpty aData
34764>>>>>>>        tWebValueTree tData
34764>>>>>>>        tWebValueTree tData
34764>>>>>>>        
34764>>>>>>>        

430>>>>>>>>>>>>>Function FormatWinError Global Integer iError Returns String
432>>>>>>>>>>>>>    Integer iFlags iBytes iResult
432>>>>>>>>>>>>>    Pointer pAddress
432>>>>>>>>>>>>>    WString sBuffer
432>>>>>>>>>>>>>    
432>>>>>>>>>>>>>    // Initialize pAddress, just to make sure AddressOf() works
432>>>>>>>>>>>>>    Move 0 to pAddress
433>>>>>>>>>>>>>    
433>>>>>>>>>>>>>    // Set the flags...
433>>>>>>>>>>>>>    Move (FORMAT_MESSAGE_ALLOCATE_BUFFER ior FORMAT_MESSAGE_FROM_SYSTEM ior FORMAT_MESSAGE_IGNORE_INSERTS) to iFlags
434>>>>>>>>>>>>>    
434>>>>>>>>>>>>>    // If FormatMessage fails iBytes will be 0, therefore no bytes will be copied and the error will only
434>>>>>>>>>>>>>    // display the error code returned from GetLastError...
434>>>>>>>>>>>>>    Move (FormatMessageW(iFlags,0,iError,0,AddressOf(pAddress),0,0)) to iBytes
435>>>>>>>>>>>>>    
435>>>>>>>>>>>>>    // Allocate the buffer...
435>>>>>>>>>>>>>    Move (Repeat(Character(0),iBytes)) to sBuffer
436>>>>>>>>>>>>>    If (iBytes > 0) ;        Move (CopyMemory(AddressOf(sBuffer),pAddress,iBytes * 2)) to iResult
439>>>>>>>>>>>>>    
439>>>>>>>>>>>>>    // Display the error code and message, if no message is available use 'No error text available'.
439>>>>>>>>>>>>>    If (Trim(sBuffer) = "") ;        Move C_$NoErrorTextAvailable to sBuffer
442>>>>>>>>>>>>>    
442>>>>>>>>>>>>>    // Free memory used by the buffer...
442>>>>>>>>>>>>>    Move (Free(pAddress)) to iResult
443>>>>>>>>>>>>>    Function_Return (sBuffer +" (" +C_$ErrorCode +"=" +String(iError) +")")
444>>>>>>>>>>>>>End_Function

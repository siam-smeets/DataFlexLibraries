10>>>>>>>>>>>Function UCharToString Global UChar uByte Returns String
12>>>>>>>>>>>    // Construct string value via UChar array
12>>>>>>>>>>>    UChar[] ucResult
13>>>>>>>>>>>    Move uByte to ucResult[0]
14>>>>>>>>>>>    Function_Return (UCharArrayToString(ucResult,1))
15>>>>>>>>>>>End_Function

18106>>>>>>>>>>>>>>>>>>>        Property String psDateSeparator ""        // The date separator string to use on the client. (see DF_DATE_SEPARATOR)
18109>>>>>>>>>>>>>>>>>>>        Property String psDateTimeFormat ""       // The datetime format used by the client for editing and displaying datetime values.
18112>>>>>>>>>>>>>>>>>>>        Property String psTimeFormat "hh:mm:ss"   // The time format used by the client for editing and displaying time values.
18115>>>>>>>>>>>>>>>>>>>        Property String psTimeSeparator ":"       // The time separator used on the client when editing and displaying datetime values.
18118>>>>>>>>>>>>>>>>>>>        Property String psDecimalSeparator "."    // The decimal separator character to us on the client when formating numeric masks. (see DF_DECIMAL_SEPARATOR)
18121>>>>>>>>>>>>>>>>>>>        Property String psThousandsSeparator ","  // The thousands separator character to us on the client when formating numeric masks. (see DF_THOUSANDS_SEPARATOR)
18124>>>>>>>>>>>>>>>>>>>        Property String psTheme "Df_Material"    // The theme being used (actually determines from which folder theme.css is included)
18127>>>>>>>>>>>>>>>>>>>        Property String psBodyCSSClass ""        // The CSS class being applied to the document.body in html
18130>>>>>>>>>>>>>>>>>>>        
18130>>>>>>>>>>>>>>>>>>>        Property Integer piScreenWidth 0
18133>>>>>>>>>>>>>>>>>>>        Property Integer piScreenHeight 0
18136>>>>>>>>>>>>>>>>>>>        Property Integer piWindowWidth 0
18139>>>>>>>>>>>>>>>>>>>        Property Integer piWindowHeight 0
18142>>>>>>>>>>>>>>>>>>>        Property String psLocationHash ""               // The current hash part of the url (read-only)
18145>>>>>>>>>>>>>>>>>>>        
18145>>>>>>>>>>>>>>>>>>>        Property Integer peMode -1              //  The responsive mode in which the client is running (see WebSetResponsive). This property is readonly.
18148>>>>>>>>>>>>>>>>>>>        Property Boolean pbResponsive True      //  This property can be used to disable the responsive system (WebSetResponsive values will not be applied if false)
18151>>>>>>>>>>>>>>>>>>>        Property Boolean pbIsMobile             //  This property indicates wether or not the client is detected as a mobile device (tablet / phone running android or IOS). This property is readonly.
18154>>>>>>>>>>>>>>>>>>>        
18154>>>>>>>>>>>>>>>>>>>        Property Integer peSystemThemePreference spLightMode      //  This property indicates if the currently active theme should render in dark mode.

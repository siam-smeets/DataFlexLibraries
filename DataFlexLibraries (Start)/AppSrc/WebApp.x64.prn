10219>>>>>>>>>    // Add a file to the files used to place the statement result in.
10219>>>>>>>>>    Procedure SQLBindFile Integer iFileNum
10221>>>>>>>>>        Integer ihdbc
10221>>>>>>>>>        Integer ihstmt
10221>>>>>>>>>        Integer iVoid
10221>>>>>>>>>        String  sDrvrId
10221>>>>>>>>>        String  sFileType
10221>>>>>>>>>        Integer bIsOpen
10221>>>>>>>>>        
10221>>>>>>>>>        // Get the cli handles
10221>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10222>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10223>>>>>>>>>        Get psDriverId            to sDrvrId
10224>>>>>>>>>        
10224>>>>>>>>>        // If a file number is not passed see if we can use the statement's
10224>>>>>>>>>        // default file number which is usually set with SetFileConnection
10224>>>>>>>>>        If (iFileNum = 0) Begin
10226>>>>>>>>>            Get piBindFile to iFileNum
10227>>>>>>>>>            If (iFileNum = 0) Begin
10229>>>>>>>>>                // Logic error, if 0 is passed as filenumber, piBindFile should be set.
10229>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_BIND_FILE "piBindFile should be set" "SQLBindFile"
10230>>>>>>>>>                
10230>>>>>>>>>                Move 0 to SQLResult
10231>>>>>>>>>                Procedure_Return
10232>>>>>>>>>            End
10232>>>>>>>>>>
10232>>>>>>>>>        End
10232>>>>>>>>>>
10232>>>>>>>>>        
10232>>>>>>>>>        // Bind the file
10232>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10234>>>>>>>>>            // Chek if the file is open
10234>>>>>>>>>            Get_Attribute DF_FILE_OPENED of iFileNum to bIsOpen
10237>>>>>>>>>            If (bIsOpen) Begin
10239>>>>>>>>>                // Check if the file has the correct type
10239>>>>>>>>>                Get_Attribute DF_FILE_DRIVER of iFileNum to sFileType
10242>>>>>>>>>                If (sFileType = sDrvrId) Begin
10244>>>>>>>>>                    // Call the driver function to add a file to a statement
10244>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLBINDFILE ;                        Callback Self ;                        Passing ihdbc iFileNum ihstmt ;                        Result iVoid
10249>>>>>>>>>                End
10249>>>>>>>>>>
10249>>>>>>>>>                Else ;                    Send StmtError CLIERR_SQLINVALID_BIND_FILE ("File" * String(iFileNum) * "type incompatible with statement ("  + sFileType + ")") "SQLBindFile"
10251>>>>>>>>>            End
10251>>>>>>>>>>
10251>>>>>>>>>            Else ;                Send StmtError CLIERR_SQLINVALID_BIND_FILE ("File not open (number =" * String(iFileNum) + ")") "SQLBindFile"
10253>>>>>>>>>        End
10253>>>>>>>>>>
10253>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLBindFile"
10255>>>>>>>>>    End_Procedure

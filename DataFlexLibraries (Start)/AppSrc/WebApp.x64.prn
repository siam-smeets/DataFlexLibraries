35431>>>>>>>                    
35431>>>>>>>                    If (not(IsSameRowID(CurrentRowId(hoDD), riNewRow))) Begin
35433>>>>>>>                        If (not(IsNullRowID(riNewRow))) Begin
35435>>>>>>>                            Send FindByRowId of hoDD (Main_File(hoDD)) riNewRow
35436>>>>>>>                        End
35436>>>>>>>>
35436>>>>>>>                        Else Begin

27599>>>>>>>
27599>>>>>>>// Models a data entry view panel. This is a container for...
27599>>>>>>>// - A DDO structure
27599>>>>>>>// - Panel layout
27599>>>>>>>// - Child DEO and non-DEO controls.
27599>>>>>>>//
27599>>>>>>>// Adds support for...
27599>>>>>>>// - DDO Container,
27599>>>>>>>// - DDO request interface
27599>>>>>>>Class cWebView is a cWebWindow
27600>>>>>>>    
27600>>>>>>>    Procedure Construct_Object
27602>>>>>>>        Integer eStyle 
27602>>>>>>>        String sName
27602>>>>>>>        
27602>>>>>>>        Forward Send Construct_Object
27604>>>>>>>        
27604>>>>>>>        
27604>>>>>>>        
27604>>>>>>>        // this determines if request_save should validate all items or stop at the first error. The default
27604>>>>>>>        // for web applicaitions is to validate all.
27604>>>>>>>        // For now this is private, as this may never be needed.  
27604>>>>>>>        Property Boolean pbRequesteValidateAll True
27605>>>>>>>
27605>>>>>>>        // This is set to true during SyncDDOs, specifically while trying to re-establish the DDO's Field_Defaults.
27605>>>>>>>        // Typically the flag is used to protect DEO's during this process so that the Field_Default is re-established
27605>>>>>>>        // only in the actual DDO (where it is needed) and not in the DEO (where the value may have changed already).        
27605>>>>>>>        Property Boolean pbSynchingFieldDefaults False
27606>>>>>>>        
27606>>>>>>>        Property Boolean pbFindKeys True
27607>>>>>>>        Property Boolean pbClearKeys True
27608>>>>>>>        Property Boolean pbDeleteKeys True
27609>>>>>>>        Property Boolean pbSaveKeys True
27610>>>>>>>        
27610>>>>>>>        // set true if constrain_file change in data dictionaries for each client instance
27610>>>>>>>        // This is only applied with drilldown style views
27610>>>>>>>        Property Boolean pbDrillDownDynamicConstraints True 
27611>>>>>>>        
27611>>>>>>>        
27611>>>>>>>        
27611>>>>>>>        // Published Properties
27611>>>>>>>        Property Boolean pbServerOnSubmit False    // Set to true to trigger server OnSubmit event
27614>>>>>>>        Property String psClientOnSubmit ""        // Name of client side OnSubmit event handler
27617>>>>>>>        
27617>>>>>>>        Property Boolean pbServerOnResizeWindow False
27620>>>>>>>        Property String psClientOnResizeWindow ""
27623>>>>>>>         
27623>>>>>>>        Property Boolean pbFillHeight False
27626>>>>>>>        
27626>>>>>>>        // this gets set during object construction by looking at the cWebApp's application type.  
27626>>>>>>>        Property Integer peWebViewStyle wvsDesktop
27627>>>>>>>
27627>>>>>>>        Property Integer peViewType vtUndefined   // General purpose of this view: i.e. vtZoom or vtSelect
27628>>>>>>>        
27628>>>>>>>        // if drillDown should Request_Save attempt to save a new unchanged record?
27628>>>>>>>        // with drill down this makes the most sense. With Desktop style this is ignored.
27628>>>>>>>        // Currently marked private. Might be exposed if it turns out to be needed
27628>>>>>>>        Property Boolean pbAlwaysSaveWhenNewDrillDown True
27629>>>>>>>
27629>>>>>>>        // what to do when closing a changed view. This is called by
27629>>>>>>>        // GetChangedViewExitAction, which can be augmented to handle more dynamic actions
27629>>>>>>>        Property Integer peChangedViewExitAction cveConfirmSaveClearCancel
27630>>>>>>>        
27630>>>>>>>        Property Handle Verify_SaveClearCancel_msg (RefProc(SaveClearCancelConfirmation))
27631>>>>>>>
27631>>>>>>>        Property String psNavigateDataCallbackObj ""   // Private: Used by NavigateClose_Callback. Stores the callback object to populate the navigate data when navigating back. This is usually the object that invoked NavigateBack
27634>>>>>>>        
27634>>>>>>>        Property tWebNavigateData pNavigateData
27637>>>>>>>
27637>>>>>>>        Property String psNavigateBackView
27640>>>>>>>
27640>>>>>>>        Property String psInvokingObject ""        
27643>>>>>>>        
27643>>>>>>>        Property String psInvokingStateHash ""          //  Used to store the state hash of the invoking view for drill-down
27646>>>>>>>        Property Boolean pbNavReinitError False         //  Used to communicate issues back to NavigateInitialize
27647>>>>>>>        Property Boolean pbNavigating False           //  True while inside navigation messages
27648>>>>>>>        Property Boolean pbInitForShow False         //  True while inside initforshow
27649>>>>>>>        
27649>>>>>>>        Property Boolean pbStateRestoreRecord True      //  If true record ids will be part of the state hash for desktop-style
27650>>>>>>>        Property Boolean pbStateReplace False           //  If true the current view will not add a new history item but replace the current item in history
27651>>>>>>>        Property Integer peStateMode vsmDefault         //  Configures how the state hash for this view built
27652>>>>>>>        Property String psStateNewRecordId ""           //  Configures how new records will be represented in the state hash
27653>>>>>>>
27653>>>>>>>        
27653>>>>>>>        /*        A view is preloaded using delayloadview, this basically puts the view 'in sync' but it         loads the view details later. This is an optimization added for history management where it         has to rebuild the entire view stack for drill down applications. It now only fully loads         the visible view and the others are loaded in the background using delayloadview, but it         does need to refind records so InitForShow is already executed and should not be executed         again. pbPreLoaded indicates that it should skip InitForShow.                */
27653>>>>>>>        Property Boolean pbPreLoaded False
27656>>>>>>>                
27656>>>>>>>        Get Object_Label to sName
27657>>>>>>>        Property String psStateViewName sName
27658>>>>>>>               
27658>>>>>>>        // the constructor will set the style based on the application setting of this.
27658>>>>>>>        // this can be changed during object construction but most not be changed
27658>>>>>>>        // after the object is created (i.e., after end_construct_object)
27658>>>>>>>        Get peApplicationStyle of (Host(Self)) to eStyle
27659>>>>>>>        Set peWebViewStyle to eStyle
27660>>>>>>>        Set pbScroll to True
27661>>>>>>>
27661>>>>>>>        Set psJSClass to "df.WebView"
27662>>>>>>>        
27662>>>>>>>        Send Define_cWebNavPathHelper_mixin
27663>>>>>>>        Send Define_cWebOnCallEndHandler_mixin
27664>>>>>>>        Send Define_cWebDDOSync_mixin
27665>>>>>>>    End_Procedure

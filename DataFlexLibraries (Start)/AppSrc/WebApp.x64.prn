3055>>>>>>>Class DataDictionary is a DataSet
3056>>>>>>>
3056>>>>>>>    Procedure Construct_Object
3058>>>>>>>        Forward Send Construct_Object
3060>>>>>>>
3060>>>>>>>        Property String  Existing_Key_Value                           ""
3061>>>>>>>        Property Integer Protect_Key_State                            True
3062>>>>>>>
3062>>>>>>>        Property String  Key_Fields                                   ""
3063>>>>>>>
3063>>>>>>>        // These are added to support the checking of DSO connections
3063>>>>>>>        // during deletes and saves. Only the first two properties are Public
3063>>>>>>>        Property Integer Validate_Save_Structure_Mode   DD_Validate_Structure_Once
3064>>>>>>>        Property Integer Validate_Delete_Structure_Mode DD_Validate_Structure_Once
3065>>>>>>>        Property Integer Save_Structure_Validated_State              False
3066>>>>>>>        Property Integer Cascade_Delete_Structure_Validated_State    False
3067>>>>>>>        Property Integer No_Cascade_Delete_Structure_Validated_State False
3068>>>>>>>
3068>>>>>>>        Property Integer Last_Mark_Sequence_Id                       0
3069>>>>>>>
3069>>>>>>>        // These are added for optimized traversal of
3069>>>>>>>        // entry-update and validation and maybe more
3069>>>>>>>        Property String  Visited_Fields          ""
3070>>>>>>>        Property Integer Visited_State           False
3071>>>>>>>        // means will be part of a downward delete (cascade deletable). This only has meaning
3071>>>>>>>        // when cascade_delete_state is True
3071>>>>>>>        Property Boolean DownDelete_State        False
3072>>>>>>>
3072>>>>>>>        // these are set by the define_auto_increment, which is obsolete and has been replaced
3072>>>>>>>        // the Set Field_auto_increment method.
3072>>>>>>>        Property Integer Auto_Increment_Source_File  0
3073>>>>>>>        Property Integer Auto_Increment_Source_Field 0
3074>>>>>>>        Property Integer Auto_Increment_Dest_Field   0
3075>>>>>>>
3075>>>>>>>        // used by the set Field_auto_increment method
3075>>>>>>>        // these are split into two arrays to make searching for the field easier
3075>>>>>>>        // the arrays should always be synched.
3075>>>>>>>        Property Integer[] pAutoIncrementFields
3076>>>>>>>        Property tDDFileField[] pAutoIncrementSysFileFields
3077>>>>>>>
3077>>>>>>>        // Error Reporting Related
3077>>>>>>>        // If DD_Error_No_Report errors would be supressed (only ERR gets set)
3077>>>>>>>        Property Integer Error_Report_Mode           DD_Error_Report
3078>>>>>>>
3078>>>>>>>        // During validation, this is the field being validated.
3078>>>>>>>        Property Integer Current_Validate_Field      0
3079>>>>>>>
3079>>>>>>>        // when errors are redirected locally this maintains the original handler.
3079>>>>>>>        Property Integer Old_Error_Object_Id         0
3080>>>>>>>
3080>>>>>>>        // Must be provided if local error handler is to be created
3080>>>>>>>        Property Integer Error_Processing_State      0
3081>>>>>>>
3081>>>>>>>        // These should be changed most carefully and possible only and the
3081>>>>>>>        // DSO level. These allow you to defeat full field validation which
3081>>>>>>>        // makes it easier to corrupt data! Validate_DEO_Only_State limits
3081>>>>>>>        // save validation to DEOs (which is what data-sets have always done).
3081>>>>>>>        // Validate_foreign_File_State will skip validation under the following
3081>>>>>>>        // conditions: 1) DSO if for a parent (it did not originate the save).
3081>>>>>>>        //
3081>>>>>>>        Property Integer Validate_DEOs_Only_State    False
3082>>>>>>>        Property Integer Validate_Foreign_File_State True
3083>>>>>>>        // if set true, a field validation requested started with this
3083>>>>>>>        // DD will check all fields, even in an error is encountered
3083>>>>>>>        Property Integer Validate_All_Fields_State   False
3084>>>>>>>
3084>>>>>>>        // If true, all entry updates will occur through the DD. Else
3084>>>>>>>        // saves occur through the DD and find occur through the DEOs
3084>>>>>>>        Property Integer EntryUpdateLocalState True // changed from false to true in 17.0
3085>>>>>>>
3085>>>>>>>        // can be used by Refind_records method (remote refind of recs). Obsolete. Use prFindRowId
3085>>>>>>>        Property Integer Find_Record_Id 0
3086>>>>>>>
3086>>>>>>>        // can be used by Refind_records method (remote refind of recs)
3086>>>>>>>        Property RowID prFindRowId (NullRowId())
3087>>>>>>>        // can be used by Refind_records method (remote refind of recs)
3087>>>>>>>        Property tDDChangedInfo pDDChangedInfo
3088>>>>>>>
3088>>>>>>>        // Private: Id of field_objects container. This is not created until needed
3088>>>>>>>        Property Integer Field_Objects 0
3089>>>>>>>
3089>>>>>>>        // Public: If set the DDO will never be foreign, allowing
3089>>>>>>>        // you to create new parents when a child is saved. This would
3089>>>>>>>        // normally only be set within the DDO and not the class. This would be
3089>>>>>>>        // used where a child table wants to save the parent (header) when the
3089>>>>>>>        // first child is saved. It would disable the foreign key and index
3089>>>>>>>        // find_Req and required settings (as well as any displayonly).
3089>>>>>>>        Property Integer Allow_Foreign_New_Save_State False
3090>>>>>>>
3090>>>>>>>        Set pbDDAttach to True // set false to get (very) old attach_main_file_behavior
3091>>>>>>>        Set pbSmartRelate to True // Only relate if parent is attached via a DDO
3092>>>>>>>
3092>>>>>>>        // If this is an alias file, this is the master file it is based on
3092>>>>>>>        Property Handle piMasterTable 0
3093>>>>>>>
3093>>>>>>>        Property tDDServerInformation[] pServerInformation
3094>>>>>>>
3094>>>>>>>        Property tDDRemembered[] pDDDefaults
3095>>>>>>>
3095>>>>>>>        Property Boolean pbInSuperFind False
3096>>>>>>>
3096>>>>>>>        // Create the local buffer.
3096>>>>>>>        Object Record_Buffer is a cRecordBuffer
3098>>>>>>>        End_Object
3099>>>>>>>
3099>>>>>>>        // Create the extended field attributes array.
3099>>>>>>>        Object Field_Attributes is a Field_Attributes
3101>>>>>>>        End_Object
3102>>>>>>>
3102>>>>>>>        // Create an array to maintain Status help values for each field
3102>>>>>>>        Object Statushelp_Array is an array
3104>>>>>>>        End_Object
3105>>>>>>>
3105>>>>>>>        Object FieldMask_Array is an Field_Mask_array
3107>>>>>>>        End_Object
3108>>>>>>>
3108>>>>>>>
3108>>>>>>>        // keep track of all system/unknown files that must be set to
3108>>>>>>>        // default for smart file mode to work right.
3108>>>>>>>        Object System_File_obj is an Array
3110>>>>>>>        End_Object
3111>>>>>>>
3111>>>>>>>        // used during Request_Validate
3111>>>>>>>        Property Handle[] pDDsWithFindReqErrors
3112>>>>>>>
3112>>>>>>>        // Apply SQL filters in constrained finds
3112>>>>>>>        Property Boolean pbUseDDSQLFilters False
3113>>>>>>>        // If pbUseDDSQLFilters is true, this determines if the table global filter should be applied as well
3113>>>>>>>        Property Boolean pbApplyGlobalSQLFilters False
3114>>>>>>>        // Filter which will get applied before each DDO constrained find. If "", no filter is applied
3114>>>>>>>        Property String psSQLFilter ""
3115>>>>>>>
3115>>>>>>>        // Old values for SQL Filters which are pushed and popped by StoreSQLDefaultFilters and RestoreSQLDefaultFilters
3115>>>>>>>        Property String psOldFilter ""
3116>>>>>>>        Property Boolean pbOldFilterActive
3117>>>>>>>        Property Boolean pbOldFilterEq
3118>>>>>>>
3118>>>>>>>        // used to point to the composite child object that provides the SQL
3118>>>>>>>        // interfaces for a driver. This can be used with DAW drivers. Other drivers may require
3118>>>>>>>        // that you sub-class your DD and create a different object based on a custom class
3118>>>>>>>        Property Handle phoSQLHelper (Create(Self,RefClass(cDAWSQLDriverHelper)))
3119>>>>>>>
3119>>>>>>>
3119>>>>>>>        Property Handle pbInResync False
3120>>>>>>>
3120>>>>>>>        Property Integer piPrimaryIndex -1      // Indicates the unique index used by the webapp view state system (-1 defaults to the primary key or recnum for embedded).
3121>>>>>>>
3121>>>>>>>        Set Smart_FileMode_State to True  // extended DSOs should default to true
3122>>>>>>>
3122>>>>>>>        Send Define_Fields // Developer Hook - define all field rules
3123>>>>>>>    End_Procedure
3124>>>>>>>
3124>>>>>>>    // Returns 1 to indicate that this is a DD class.
3124>>>>>>>    Function Extended_DSO_State Returns Integer
3126>>>>>>>        Function_Return 1
3127>>>>>>>    End_Function
3128>>>>>>>
3128>>>>>>>
3128>>>>>>>    // Used to set up all XDS functions and rules. Called by construct_object
3128>>>>>>>    // and considered a bit more user friendly.
3128>>>>>>>    Procedure Define_Fields
3130>>>>>>>    End_Procedure
3131>>>>>>>
3131>>>>>>>
3131>>>>>>>
3131>>>>>>>    // This message has been augmented to create a local recordbuffer for a
3131>>>>>>>    // file. We cannot do this earlier because we need the file to count the
3131>>>>>>>    // number of necessary fields.
3131>>>>>>>    Procedure Set Main_File Integer iFile
3133>>>>>>>        Integer iCurrent_File iMaster
3133>>>>>>>        Get piMasterTable to iMaster
3134>>>>>>>        If iMaster Begin
3136>>>>>>>            // is an alias condition
3136>>>>>>>            Forward Set Main_File to iFile
3138>>>>>>>            Send ReDefineAliasItems to (Record_Buffer(Self)) iFile
3139>>>>>>>        End
3139>>>>>>>>
3139>>>>>>>        Else If iFile Begin
3142>>>>>>>            Get Main_File to iCurrent_File
3143>>>>>>>            If (iCurrent_File and iCurrent_File <> iFile) Begin
3145>>>>>>>                Send Data_Set_Error -1 DFERR_PROGRAM DD_CANNOT_CHANGE_MAIN_FILE
3146>>>>>>>                Procedure_Return
3147>>>>>>>            End
3147>>>>>>>>
3147>>>>>>>            Forward Set Main_File to iFile
3149>>>>>>>            Send Create_Items to (Record_Buffer(Self)) iFile
3150>>>>>>>            Send Create_Items to (Field_Attributes(Self))
3151>>>>>>>        End
3151>>>>>>>>
3151>>>>>>>    End_Procedure
3152>>>>>>>
3152>>>>>>>    // This procedure will update the Key_Fields property to include or
3152>>>>>>>    // excluded the fieldnumber passed in the list of fieldnumbers which make
3152>>>>>>>    // up an keyvalue.
3152>>>>>>>    Procedure Set Key_Field_State Integer iField Integer iState
3154>>>>>>>        String  sKeys
3154>>>>>>>        Set Key_Field_State of Record_Buffer iField to iState
3155>>>>>>>        Get Key_Fields to sKeys
3156>>>>>>>        Set Key_Fields to (Overstrike(If(iState, "X", " "), sKeys, iField))
3157>>>>>>>    End_Procedure
3158>>>>>>>
3158>>>>>>>    // Will return TRUE if the field passed has been defined as a key.
3158>>>>>>>    Function Key_Field_State Integer iField Returns Integer
3160>>>>>>>        Integer iState
3160>>>>>>>        Get Key_Field_State of Record_Buffer iField to iState
3161>>>>>>>        Function_Return iState
3162>>>>>>>    End_Function
3163>>>>>>>
3163>>>>>>>    // Returns complete key value.
3163>>>>>>>    Function Key_Value Returns String
3165>>>>>>>        String  sKeys
3165>>>>>>>        String  sKey_Value
3165>>>>>>>        String  sValue
3165>>>>>>>        Integer iField
3165>>>>>>>        Get Key_Fields to sKeys
3166>>>>>>>        Move "" to sKey_Value
3167>>>>>>>        Repeat
3167>>>>>>>>
3167>>>>>>>            Move (Pos( "X",sKeys)) to iField
3168>>>>>>>            If iField Begin
3170>>>>>>>                Get Field_Current_Value iField to sValue
3171>>>>>>>                Append sKey_Value sValue
3172>>>>>>>                Move (Overstrike(" ", sKeys, iField)) to sKeys
3173>>>>>>>            End
3173>>>>>>>>
3173>>>>>>>        Until not iField
3175>>>>>>>        Function_Return sKey_Value
3176>>>>>>>    End_Function
3177>>>>>>>
3177>>>>>>>    // This procedure will be called whenever the Data_Set changes its
3177>>>>>>>    // Current_Record property, or after a Save, Delete or Clear operation.
3177>>>>>>>    // We send this message to the Record_Buffer object to update its values.
3177>>>>>>>    Procedure New_Current_Record Integer iOld Integer iNew
3179>>>>>>>        // does nothing, but exists if developer is using this for some purpose. Is called after
3179>>>>>>>        // OnNewCurrentRecord (if recnum based table)
3179>>>>>>>    End_Procedure
3180>>>>>>>
3180>>>>>>>    Procedure OnNewCurrentRecord RowID riOld RowID riNew
3182>>>>>>>        Integer iObj
3182>>>>>>>        Integer iOldst
3182>>>>>>>        Integer iFoc
3182>>>>>>>        Integer iIsExt
3182>>>>>>>        Forward Send OnNewCurrentRecord riOld riNew
3184>>>>>>>        Move (Record_Buffer(Self)) to iObj
3185>>>>>>>        If iObj Begin
3187>>>>>>>            Send OnNewCurrentRecord of iObj riOld riNew
3188>>>>>>>            // must also refresh all defined extended fields
3188>>>>>>>            Send ExtendedFieldsRefresh (IsNullRowId(riNew)) // pass bCleared (true if a clear)
3189>>>>>>>            Get Focus of Desktop to iFoc
3190>>>>>>>            Get Extended_DEO_State of iFoc to iIsExt     // if focus is deo item
3191>>>>>>>            If iIsExt Begin                               // disable the state so
3193>>>>>>>                Get Entry_Refresh_State of iFoc to iOldSt // value will come
3194>>>>>>>                Set Entry_Refresh_State of iFoc to True   // from Local buffer.
3195>>>>>>>            End
3195>>>>>>>>
3195>>>>>>>            Set Existing_Key_Value to (Key_Value(Self))
3196>>>>>>>            If iIsExt ;                Set Entry_Refresh_State of iFoc to iOldSt
3199>>>>>>>            // Only set defaults when the record is new
3199>>>>>>>            If (IsNullRowId(riNew)) ;                Send Prepare_Default_Values
3202>>>>>>>        End
3202>>>>>>>>
3202>>>>>>>    End_Procedure
3203>>>>>>>
3203>>>>>>>    // Shuts off change mode and sends initialize_default_values which is
3203>>>>>>>    // a user hook routine.
3203>>>>>>>    Procedure Prepare_Default_Values
3205>>>>>>>        Integer iOldState
3205>>>>>>>        Get Change_disabled_State to iOldState
3206>>>>>>>        Set Change_disabled_State to True
3207>>>>>>>        Send Private_Field_Defaults
3208>>>>>>>        // set defaults if this is the main DDO or the DDO is
3208>>>>>>>        // flagged as supporting saving new records when foreign (a parent)
3208>>>>>>>        If (Operation_Origin=Self or ;            Allow_Foreign_New_Save_State(Self)) ;            Send Field_Defaults
3211>>>>>>>        Send AssignDynamicDefaults
3212>>>>>>>        Set Change_disabled_State to iOldState
3213>>>>>>>    End_Procedure
3214>>>>>>>
3214>>>>>>>    // Set all checkbox fields to default to False data value.
3214>>>>>>>    Procedure Private_Field_Defaults
3216>>>>>>>        Integer iField
3216>>>>>>>        Repeat
3216>>>>>>>>
3216>>>>>>>            Get Next_Validation_Type of (Field_Attributes(Self)) ;                FA_VALIDATION_TYPE_CHECKBOX iField to iField
3217>>>>>>>            If (iField = 0) ;                Procedure_Return
3220>>>>>>>            Set Field_Select_State  iField to False
3221>>>>>>>            Set Field_Changed_State iField to True
3222>>>>>>>        Loop
3223>>>>>>>>
3223>>>>>>>    End_Procedure
3224>>>>>>>
3224>>>>>>>    // Will be called after a clear operation to let the application
3224>>>>>>>    // programmer set the default values for the record. This should be done
3224>>>>>>>    // by sending SET Field_Current_Value.
3224>>>>>>>    Procedure Field_Defaults
3226>>>>>>>    End_Procedure
3227>>>>>>>
3227>>>>>>>    // Pass type and string value and see if this is valid data for this
3227>>>>>>>    // type. Currently we check for numbers and dates. Return non-zero
3227>>>>>>>    // if invalid.
3227>>>>>>>    Function IsDataInvalid Integer iType String sValue Returns Integer
3229>>>>>>>        Date    dVal
3229>>>>>>>        DateTime dtVal
3229>>>>>>>        Number  nVal
3229>>>>>>>        Integer bOK
3229>>>>>>>        Boolean bInvalid
3229>>>>>>>
3229>>>>>>>        Move False to bInvalid
3230>>>>>>>        If (iType=DF_BCD or iType=DF_DATE or iType=DF_DATETIME) Begin
3232>>>>>>>            If (iType=DF_DATE) Begin
3234>>>>>>>                MoveTrapErr sValue to dVal
3235>>>>>>>                Move (Err) to bInvalid
3236>>>>>>>            End
3236>>>>>>>>
3236>>>>>>>            Else If (iType=DF_DATETIME) Begin
3239>>>>>>>                MoveTrapErr sValue to dtVal
3240>>>>>>>                Move (Err) to bInvalid
3241>>>>>>>//          Move (not(IsDateValid(dtVal))) to bInvalid //jjt-uncomment when working
3241>>>>>>>            End
3241>>>>>>>>
3241>>>>>>>            Else Begin
3242>>>>>>>                MoveTrapErr sValue to nVal // this may gen an error.
3243>>>>>>>                Move (Err) to bInvalid
3244>>>>>>>            End
3244>>>>>>>>
3244>>>>>>>            Move False to Err
3245>>>>>>>        End
3245>>>>>>>>
3245>>>>>>>        Function_Return bInvalid
3246>>>>>>>    End_Function
3247>>>>>>>
3247>>>>>>>    // Return 1 if the passed DEO is part of the DDs list of connected DEOs
3247>>>>>>>    // First check if server of DEO is this DD. If so, we are owned. If not
3247>>>>>>>    // we must check the DD's UI DEO list.
3247>>>>>>>    // The passed object MUST be a valid DEO or an error will occur.
3247>>>>>>>    Function IsDEOOwned Integer iDEO Returns Integer
3249>>>>>>>        Integer iMax iCount
3249>>>>>>>        // if DEOs server is same as current DD it is owned. This is the
3249>>>>>>>        // fast check
3249>>>>>>>        If (Server(iDEO)=Self) ;            Function_Return 1
3252>>>>>>>        // else see if the DEO is in the DD's DEO list
3252>>>>>>>        Get Data_Set_User_Interface_Count to iMax
3253>>>>>>>        Decrement iMax
3254>>>>>>>        For iCount from 0 to iMax
3260>>>>>>>>
3260>>>>>>>            If (Data_Set_User_Interface(Self,iCount)=iDEO) ;                Function_Return 1
3263>>>>>>>        Loop
3264>>>>>>>>
3264>>>>>>>        Function_Return 0
3265>>>>>>>    End_Function
3266>>>>>>>
3266>>>>>>>    // This procedure changes the field value of the given field in the
3266>>>>>>>    // record-buffer object.
3266>>>>>>>    // It also sends Field_Value_Changed to notify every the attached DEOs.
3266>>>>>>>    // This has been optimized so this message is only sent when data is
3266>>>>>>>    // actually changed.
3266>>>>>>>    Procedure Set Field_Current_Value Integer iField String sValue
3268>>>>>>>        Integer iObj
3268>>>>>>>        String sOldVal
3268>>>>>>>        Integer iChanged
3268>>>>>>>        Integer iType
3268>>>>>>>        Integer iFile
3268>>>>>>>        Integer iFocObj
3268>>>>>>>        Integer iCrnt
3268>>>>>>>        Integer bInvalid
3268>>>>>>>        Integer iIdentity
3268>>>>>>>        Address pData
3268>>>>>>>        Integer iLen
3268>>>>>>>
3268>>>>>>>        Get Main_File to iFile
3269>>>>>>>        Get_Attribute DF_FIELD_TYPE of iFile iField to iType
3272>>>>>>>
3272>>>>>>>        // Overlap fields are not supported directly in DDs. It is expected
3272>>>>>>>        // that you will use the underlying fields instead
3272>>>>>>>        If (iType = DF_OVERLAP) Begin
3274>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_OVERLAP_ERROR
3275>>>>>>>            Procedure_Return
3276>>>>>>>        End
3276>>>>>>>>
3276>>>>>>>
3276>>>>>>>        If (iType=DF_TEXT or iType=DF_BINARY) Begin // if text or binary direct to pointer
3278>>>>>>>            Move sValue to sValue // intentional code: make sure passed sValue is a really string
3279>>>>>>>            Move (SizeOfString(sValue)) to iLen // length to copy
3280>>>>>>>            Move (AddressOf(sValue)) to pData   // first byte of string
3281>>>>>>>            // will gen error if ext. field does not exist
3281>>>>>>>            Set Field_Current_Pointer_Value iField iLen to pData
3282>>>>>>>            Procedure_Return
3283>>>>>>>        End
3283>>>>>>>>
3283>>>>>>>
3283>>>>>>>
3283>>>>>>>        // If date or number, force conversion so any error is detected before
3283>>>>>>>        // the buffer is updated. We don't want the record buffer to contain
3283>>>>>>>        // invalid data
3283>>>>>>>        Get IsDataInvalid iType sValue to bInvalid
3284>>>>>>>        If bInvalid ;         // If an error occurred we have            Procedure_Return  // a bad number or a bad date. Do no more!
3287>>>>>>>
3287>>>>>>>        Move (Record_Buffer(Self)) to iObj
3288>>>>>>>        Get Value of iObj iField to sOldVal
3289>>>>>>>
3289>>>>>>>        Set Value of iObj iField to sValue
3290>>>>>>>
3290>>>>>>>        // Augmented to handle non DF databases JJT
3290>>>>>>>        // Some tables may use some field other then recnum for their record identity.
3290>>>>>>>        // This will be dfrecnum or some other numeric field. When this happens the DD have
3290>>>>>>>        // to field buffers for the same value. When an update occurs from the DD to the DB buffer
3290>>>>>>>        // an update can occur twice. If the values are the same, this does not matter. Else the highest
3290>>>>>>>        // field value will get the update (not recnum). So if someone changes recnum but not its real field
3290>>>>>>>        // finding may not work right. The DD is updated when a record is found and the API keeps the two values
3290>>>>>>>        // the same. If the user changes recnum, the real field does not get changed. That is what we are fixing
3290>>>>>>>        // here. Note that: 1) this has no effect on Dataflex databases (or any DB that has a 0 field recnum).
3290>>>>>>>        // 2) this type of update is rarely seen anyway (you have to change just the recnum and perform an entry_update).
3290>>>>>>>        //
3290>>>>>>>        // if field is recnum and record identity is not 0, we must also update the other field.
3290>>>>>>>        If (iField=0) Begin
3292>>>>>>>            Get_Attribute DF_FILE_RECORD_IDENTITY of iFile to iIdentity
3295>>>>>>>            If (iIdentity>0) ;                Set Value of iObj iIdentity to sValue
3298>>>>>>>        End
3298>>>>>>>>
3298>>>>>>>
3298>>>>>>>        // When data-sets are working they should not update the
3298>>>>>>>        // DEOs.
3298>>>>>>>
3298>>>>>>>        // prior to vdf7, we stopped all operation modes of non-zero. We now allow
3298>>>>>>>        // validates to pass through and we have a new operation mode for this. This
3298>>>>>>>        // should be ok, since we already allowed navigation validation through - we just
3298>>>>>>>        // stopped request_validate validations.
3298>>>>>>>        If (Operation_Mode=0 or Operation_Mode=MODE_VALIDATING) Begin
3300>>>>>>>            If (iType=DF_BCD) ;                Move (Number(sValue)<>Number(sOldVal)) to iChanged
3303>>>>>>>            Else If (iType=DF_DATE) ;                Move (Date(sValue)<>Date(sOldVal)) to iChanged
3307>>>>>>>            Else If (iType=DF_DATETIME) ;                Move (Cast(sValue,DateTime)<>Cast(sOldVal,DateTime)) to iChanged
3311>>>>>>>            Else ;                Move (sValue<>sOldVal) to iChanged
3313>>>>>>>            // if changed, notify all DEOs of this change
3313>>>>>>>            If iChanged ;                Send Field_Value_Changed iField sValue
3316>>>>>>>            Else Begin
3317>>>>>>>                // If here the set value did not change the contents of the DD.
3317>>>>>>>                // However, it is possible that the current focus DEO may contain
3317>>>>>>>                // a different value than the one we are setting. In such a case
3317>>>>>>>                // we must re-synchronize the DEO. Only the one DEO can be affected
3317>>>>>>>                // because it is the current focus deo/item that can contain a value
3317>>>>>>>                // that is not yet updated in the DD. This fixes a bug where the
3317>>>>>>>                // iexit was setting a value which was different from what was in
3317>>>>>>>                // the DEO but was the same as the old DD value (iExit is called
3317>>>>>>>                // before the DD is re-synched with the DEO). This could happen
3317>>>>>>>                // also by sending this message directly with a different value in
3317>>>>>>>                // the DEO focus item.
3317>>>>>>>                Get Focus of Desktop to iFocObj
3318>>>>>>>                // similar logic to Get Field_Current_Value. We check that the DEO
3318>>>>>>>                // is extended, that entry_refresh is not disabled and that the
3318>>>>>>>                // DEO's server is this DD.
3318>>>>>>>                If ( Extended_DEO_State(iFocObj) and ;                    (Entry_Refresh_State(iFocObj)=0)) Begin
3320>>>>>>>                    Get Current_item of iFocObj to iCrnt
3321>>>>>>>                    // If Focus DEO has same file and field and it is not checkbox
3321>>>>>>>                    // we must set its value. Set local value directly sets the value
3321>>>>>>>                    // in the DEO item. If we used value we'd get recursion!
3321>>>>>>>                    If ( Data_File(iFocObj,iCrnt)=iFile and ;                        Data_Field(iFocObj,iCrnt)=iField and ;                        IsDEOOwned(Self,iFocObj) and ;                        Checkbox_item_State(iFocObj,iCrnt)=0 ) ;                        Send File_Field_Value_Changed to iFocObj iFile iField sValue True
3324>>>>>>>                    //Set Local_Value of iFocObj iCrnt to sValue
3324>>>>>>>                End
3324>>>>>>>>
3324>>>>>>>            End
3324>>>>>>>>
3324>>>>>>>        End
3324>>>>>>>>
3324>>>>>>>    End_Procedure
3325>>>>>>>
3325>>>>>>>    // Sets Field_Current_Value and Sets Field_Changed_State for passed field.
3325>>>>>>>    Procedure Set Field_Changed_Value Integer iField String sValue
3327>>>>>>>        Set Field_Changed_State iField to True
3328>>>>>>>        Set Field_Current_Value iField to sValue
3329>>>>>>>    End_Procedure
3330>>>>>>>
3330>>>>>>>
3330>>>>>>>    // This should only be set by a DEO that is changing a NoPut value. This should only happen when NoEnter=F
3330>>>>>>>    // for indexed findable noput deos. With foreign-field noputs we may store the value and update them
3330>>>>>>>    // for finds but we don't want them for saves. The cDDBuffer class handles this but it needs to
3330>>>>>>>    // know if this was a DEO NoPut update. DDOs have always allowed you to directly update foreign NoPut
3330>>>>>>>    // fields when the change did not come from a DEO.
3330>>>>>>>    Procedure Set Field_NoPutValueChangedByDeo Integer iField Boolean bChange
3332>>>>>>>        Set Item_ChangedByDeo of Record_Buffer iField to bChange
3333>>>>>>>    End_Procedure
3334>>>>>>>
3334>>>>>>>    Procedure Set File_Field_NoPutValueChangedByDeo Integer iFile Integer iField Boolean bChange
3336>>>>>>>        Integer iDSO
3336>>>>>>>        Get Data_set iFile to iDSO
3337>>>>>>>        If iDSO Begin
3339>>>>>>>            Set Field_NoPutValueChangedByDeo of iDSO iField to bChange
3340>>>>>>>        End
3340>>>>>>>>

718>>>>>>>>>>>External_Function MessageBox "MessageBoxW" User32.dll ;    Handle  hWndParent ;    WString lpText ;    WString lpCaption ;    DWord   wType ;    Returns Integer
719>>>>>>>>>>>
719>>>>>>>>>>>
719>>>>>>>>>>>Function Message_Box Global String sMessage String sCaption ;        Integer Btns Integer Icon Returns Integer
721>>>>>>>>>>>    Boolean bEnabled
721>>>>>>>>>>>    Handle hWnd hwPrnt hwTest hwOwner
721>>>>>>>>>>>    String IncorrectNewline
721>>>>>>>>>>>    String szMessage szCaption
721>>>>>>>>>>>    Integer rval iVoid Obj
721>>>>>>>>>>>    
721>>>>>>>>>>>    Move (Replaces("\n",sMessage,Character(13))) to sMessage
722>>>>>>>>>>>    Move (sMessage +character(0)) to szMessage
723>>>>>>>>>>>    
723>>>>>>>>>>>    Move "" to IncorrectNewline
724>>>>>>>>>>>    Append IncorrectNewline "\" (Character(13))
726>>>>>>>>>>>    Move (Replaces(IncorrectNewline, szMessage, "\n")) to szMessage
727>>>>>>>>>>>       
727>>>>>>>>>>>    Move (sCaption +character(0)) to szCaption
728>>>>>>>>>>>    
728>>>>>>>>>>>    // 8.3 change. Global methods should not be using self. We will have message boxes use
728>>>>>>>>>>>    // the focus as a starting point for looking for a container handle. (this was changed for 12.0 - see below)    
728>>>>>>>>>>>    
728>>>>>>>>>>>    Get Focus of desktop to Obj // start with the focus
729>>>>>>>>>>>    Move (gOwnerWindowHandle(Obj)) to hWnd // global function finds the right handle for us
730>>>>>>>>>>>    // If no main-window, use container_handle of focus. If no window handle, use MB_TASKMODAL. We don't always use this
730>>>>>>>>>>>    // because it adds the message box to the caption bar.
730>>>>>>>>>>>    Move (MessageBox (hWnd, szMessage, szCaption, Btns ior Icon ior If(hWnd=0,MB_TASKMODAL,0))) to rval
731>>>>>>>>>>>    Function_Return rVal
732>>>>>>>>>>>End_Function

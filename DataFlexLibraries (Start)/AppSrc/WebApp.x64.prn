30649>>>>>>>    // Synchronizes the current records with the passed row id's for each DDO in the
30649>>>>>>>    // passed collection of DDO structures. Each Structure in the collection belongs
30649>>>>>>>    // to a different view. The aDDOViews parameter is populated with the object handle
30649>>>>>>>    // of each view referenced in the aDDODefs collection
30649>>>>>>>    //
30649>>>>>>>    // During this process the view is tested for AllowViewAccess. If access is denied to
30649>>>>>>>    // any view in the stack then SynchronizeDDOs is aborted and the function returns False.
30649>>>>>>>    Procedure Call_PreSync tWebCallContext ByRef cctx
30651>>>>>>>        Boolean bAllowAccess
30651>>>>>>>        Integer i icDDODef
30651>>>>>>>        String sViewName
30651>>>>>>>        Handle[] aDDOViews
30652>>>>>>>        Handle hoInvokingObject
30652>>>>>>>         
30652>>>>>>>        Set pbSynchronizing to True
30653>>>>>>>        
30653>>>>>>>        Send NotifySyncWebApp
30654>>>>>>>         
30654>>>>>>>        // Iterate the DDODefs array and synchronize the DDOs for each view....
30654>>>>>>>        Move True to bAllowAccess
30655>>>>>>>        Move (SizeOfArray(cctx.request.Header.aDDOViews)) to icDDODef
30656>>>>>>>        
30656>>>>>>>        //  First get all the object references
30656>>>>>>>        For i from 0 to (icDDODef - 1)
30662>>>>>>>>
30662>>>>>>>            // Get the array of object handles to the views referenced in the request header's aDDODefs collection....
30662>>>>>>>            Get GetAjaxWebAppView of (phoWebControlLocator(Self)) cctx.request.Header.aDDOViews[i] to aDDOViews[i]
30663>>>>>>>        Loop
30664>>>>>>>>
30664>>>>>>>        Set paDDOViews to aDDOViews
30665>>>>>>>        
30665>>>>>>>        //  Now we can do the rest of the work
30665>>>>>>>        For i from 0 to (icDDODef - 1)
30671>>>>>>>>
30671>>>>>>>            If (aDDOViews[i] <> C_WebUnresolvedObject) Begin
30673>>>>>>>                // Test if access is allowed to the view...
30673>>>>>>>                Get Object_Label of aDDOViews[i] to sViewName
30674>>>>>>>                Get AllowViewAccess of (SessionManager(Self)) aDDOViews[i] sViewName to bAllowAccess
30675>>>>>>>
30675>>>>>>>                If (not(bAllowAccess)) Begin
30677>>>>>>>                    Error DFERR_WEBAPP_ACCESS_DENIED
30678>>>>>>>>
30678>>>>>>>                    Move True to cctx.bCancel
30679>>>>>>>                    Function_Return False
30680>>>>>>>                End
30680>>>>>>>>
30680>>>>>>>                
30680>>>>>>>                // Synchronize the view's DDOs with the DDOs in the request header
30680>>>>>>>                Get SyncDDOs of aDDOViews[i] to bAllowAccess
30681>>>>>>>                If (not(bAllowAccess)) Begin
30683>>>>>>>                    Move True to cctx.bCancel
30684>>>>>>>                    Function_Return False
30685>>>>>>>                End
30685>>>>>>>>
30685>>>>>>>                                
30685>>>>>>>                // Process the synchronized psValue and pbChanged properties for each control that has a data binding
30685>>>>>>>                Broadcast Recursive Send UpdateDataBinding to aDDOViews[i]
30687>>>>>>>                
30687>>>>>>>                // Send the Rights & Roles event hook to the view....
30687>>>>>>>                Send NotifySyncWebApp to aDDOViews[i]
30688>>>>>>>                
30688>>>>>>>                // Get the invoking object, as this might create dynamic objects which could sync their DDO's and we don't want that to happen later
30688>>>>>>>                Get GetInvokingObject of aDDOViews[i] to hoInvokingObject
30689>>>>>>>            End
30689>>>>>>>>
30689>>>>>>>        Loop 
30690>>>>>>>>
30690>>>>>>>        
30690>>>>>>>        Set pbSynchronizing to False
30691>>>>>>>    End_Procedure
30692>>>>>>>    
30692>>>>>>>    Procedure Call_PostSync tWebCallContext ByRef cctx
30694>>>>>>>        Integer i icDDODef
30694>>>>>>>        Handle[] aDDOViews
30695>>>>>>>        
30695>>>>>>>        // Iterate all the DDODefs in the Request and return the DDODefs for each one in the response
30695>>>>>>>        Get paDDOViews to aDDOViews
30696>>>>>>>        Move (SizeOfArray(aDDOViews)) to icDDODef
30697>>>>>>>        
30697>>>>>>>        For i from 0 to (icDDODef - 1)
30703>>>>>>>>
30703>>>>>>>            Send StoreDDOStates of aDDOViews[i]
30704>>>>>>>        Loop
30705>>>>>>>>
30705>>>>>>>    End_Procedure
30706>>>>>>>
30706>>>>>>>End_Class

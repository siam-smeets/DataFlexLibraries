15992>>>>>>>>>>>>>>>    //  Make sure data is valid
15992>>>>>>>>>>>>>>>    Procedure Call_ValidateData tWebCallContext ByRef cctx
15994>>>>>>>>>>>>>>>        If (not(IsOfJsonType(cctx.hoJsonRequest, jsonTypeObject))) Begin
15996>>>>>>>>>>>>>>>            Move True to cctx.bCancel
15997>>>>>>>>>>>>>>>            Move "Invalid request data. Expected JSON object." to cctx.sFatalError
15998>>>>>>>>>>>>>>>            Move 400 to cctx.iFatalErrorCode
15999>>>>>>>>>>>>>>>            If (pbLogInvalidRequests(Self)) Begin
16001>>>>>>>>>>>>>>>                Error DFERR_WEBAPP_BAD_REQUEST cctx.sFatalError
16002>>>>>>>>>>>>>>>>
16002>>>>>>>>>>>>>>>            End
16002>>>>>>>>>>>>>>>>
16002>>>>>>>>>>>>>>>            Procedure_Return
16003>>>>>>>>>>>>>>>        End
16003>>>>>>>>>>>>>>>>
16003>>>>>>>>>>>>>>>        If (not(HasMember(cctx.hoJsonRequest, "v") and HasMember(cctx.hoJsonRequest, "r") and HasMember(cctx.hoJsonRequest, "a"))) Begin
16005>>>>>>>>>>>>>>>            Move True to cctx.bCancel
16006>>>>>>>>>>>>>>>            If (HasMember(cctx.hoJsonRequest, "ActionRequest")) Begin
16008>>>>>>>>>>>>>>>                //  Use http status 500 because older js engines only respond to that error code
16008>>>>>>>>>>>>>>>                Move "Invalid request data. This request is likely sent by an older DataFlex JavaScript Engine (19.1 or older). This could be caused by browser caching." to cctx.sFatalError
16009>>>>>>>>>>>>>>>                Move 500 to cctx.iFatalErrorCode
16010>>>>>>>>>>>>>>>                If (pbLogInvalidRequests(Self)) Begin
16012>>>>>>>>>>>>>>>                    Error DFERR_WEBAPP_BAD_REQUEST cctx.sFatalError
16013>>>>>>>>>>>>>>>>
16013>>>>>>>>>>>>>>>                End
16013>>>>>>>>>>>>>>>>
16013>>>>>>>>>>>>>>>            End
16013>>>>>>>>>>>>>>>>
16013>>>>>>>>>>>>>>>            Else Begin
16014>>>>>>>>>>>>>>>                Move "Invalid request data. Required JSON members not found." to cctx.sFatalError
16015>>>>>>>>>>>>>>>                Move 400 to cctx.iFatalErrorCode
16016>>>>>>>>>>>>>>>                If (pbLogInvalidRequests(Self)) Begin
16018>>>>>>>>>>>>>>>                    Error DFERR_WEBAPP_BAD_REQUEST cctx.sFatalError
16019>>>>>>>>>>>>>>>>
16019>>>>>>>>>>>>>>>                End
16019>>>>>>>>>>>>>>>>
16019>>>>>>>>>>>>>>>            End
16019>>>>>>>>>>>>>>>>
16019>>>>>>>>>>>>>>>        End
16019>>>>>>>>>>>>>>>>
16019>>>>>>>>>>>>>>>    End_Procedure

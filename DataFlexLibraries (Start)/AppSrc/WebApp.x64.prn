33339>>>>>>>    Function MimeType String sFile Returns String
33341>>>>>>>        String sExt
33341>>>>>>>        
33341>>>>>>>        Move (Lowercase(Trim(Right(sFile, Length(sFile) - RightPos(".", sFile))))) to sExt
33342>>>>>>>        
33342>>>>>>>        Case Begin
33342>>>>>>>            Case (sExt = "jpg")
33344>>>>>>>            Case (sExt = "jpeg")
33347>>>>>>>                Function_Return "image/jpeg"
33348>>>>>>>            Case (sExt = "gif")
33351>>>>>>>                Function_Return "image/gif"
33352>>>>>>>            Case (sExt = "png")
33355>>>>>>>                Function_Return "image/png"
33356>>>>>>>            Case (sExt = "svg")
33359>>>>>>>                Function_Return "image/svg"
33360>>>>>>>            Case (sExt = "tiff")
33363>>>>>>>                Function_Return "image/tiff"
33364>>>>>>>            Case (sExt = "bmp")
33367>>>>>>>                Function_Return "image/bmp"
33368>>>>>>>            Case (sExt = "ico")
33371>>>>>>>                Function_Return "image/x-icon"
33372>>>>>>>            Case Else 
33372>>>>>>>                Function_Return ("image/" + sExt)
33373>>>>>>>        Case End
33373>>>>>>>        
33373>>>>>>>    End_Function

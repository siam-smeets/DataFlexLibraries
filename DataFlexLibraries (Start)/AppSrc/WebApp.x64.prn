12761>>>>>>>        If hoNewElement ;            Send Destroy to hoNewElement
12764>>>>>>>        Else ;            Error DFERR_XML_INTERNAL_ERROR (SFormat(C_$XmlMethodFailure, "msg_AddElementNS"))

22267>>>>>>>>>>>>>>>    //
22267>>>>>>>>>>>>>>>    // Returns the value for scalar web properties. It looks for a synchronized value in the
22267>>>>>>>>>>>>>>>    // global gaSycnProps store.
22267>>>>>>>>>>>>>>>    //
22267>>>>>>>>>>>>>>>    // Params:
22267>>>>>>>>>>>>>>>    //      hoObject  - Is handle to the object which ownes the property.
22267>>>>>>>>>>>>>>>    //      hmGetter  - Is a handle to the property's getter message.
22267>>>>>>>>>>>>>>>    //      sPropName - Is the (case sensitive) property name.
22267>>>>>>>>>>>>>>>    // Returns:
22267>>>>>>>>>>>>>>>    //      The property value as a variant.
22267>>>>>>>>>>>>>>>    //
22267>>>>>>>>>>>>>>>    // Use the WebGet command instead of sending this message directly. hoObject must belong to the
22267>>>>>>>>>>>>>>>    // set of 'scoped views' in the CallAction otherwise the web property value is considered
22267>>>>>>>>>>>>>>>    // to be "out of scope".
22267>>>>>>>>>>>>>>>    Function GetScalarSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns String
22269>>>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSize iStoreIndex
22269>>>>>>>>>>>>>>>        String sUC_PropName sReturnValue
22269>>>>>>>>>>>>>>>        Boolean bFoundProp bIsObjectInScope
22269>>>>>>>>>>>>>>>            
22269>>>>>>>>>>>>>>>        // Test if we are active....
22269>>>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
22271>>>>>>>>>>>>>>>            // If not active then we just return the design time value of the property. This is
22271>>>>>>>>>>>>>>>            // safe because we can only get here when the WebApp is being initialized, before any
22271>>>>>>>>>>>>>>>            // clients have loaded the webapp....
22271>>>>>>>>>>>>>>>            Get pubProp.hmGetter of hoObject to sReturnValue
22272>>>>>>>>>>>>>>>            Function_Return sReturnValue
22273>>>>>>>>>>>>>>>        End
22273>>>>>>>>>>>>>>>>
22273>>>>>>>>>>>>>>>        
22273>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22274>>>>>>>>>>>>>>>        
22274>>>>>>>>>>>>>>>        // get the sync props index for the passed object handle...
22274>>>>>>>>>>>>>>>        Move (Uppercase(pubProp.sName)) to sUC_PropName
22275>>>>>>>>>>>>>>>        Get piSize to iSize
22276>>>>>>>>>>>>>>>//            Get piSyncObjectIndex of hoObject to iObjectIndex
22276>>>>>>>>>>>>>>>        Get FindObjectIndex hoObject to iObjectIndex
22277>>>>>>>>>>>>>>>        
22277>>>>>>>>>>>>>>>        If (iObjectIndex = -1 or iObjectIndex >= iSize) Begin
22279>>>>>>>>>>>>>>>            // If iObjectIndex = -1 it means that this object does not currently have any web properties.
22279>>>>>>>>>>>>>>>            // It might also mean that this object is out of scope during this CallAction. An object is only in-scope
22279>>>>>>>>>>>>>>>            // if it is a global object cWebApp or its child objects, or the object is part of the stack of views\
22279>>>>>>>>>>>>>>>            // dialog that are passed in the cWebObject's paDDOViews property.
22279>>>>>>>>>>>>>>>            Get IsObjectInCallActionScope hoObject to bIsObjectInScope
22280>>>>>>>>>>>>>>>            
22280>>>>>>>>>>>>>>>            If (bIsObjectInScope) Begin
22282>>>>>>>>>>>>>>>                //  Use the raw property
22282>>>>>>>>>>>>>>>                Get pubprop.hmGetter of hoObject to sReturnValue
22283>>>>>>>>>>>>>>>            End
22283>>>>>>>>>>>>>>>>
22283>>>>>>>>>>>>>>>            Else Begin
22284>>>>>>>>>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$WebAppObjectOutOfScope, If(hoObject > 0, Name(hoObject), ""), "WebGet " + pubProp.sName, C_NewLine))
22285>>>>>>>>>>>>>>>>
22285>>>>>>>>>>>>>>>            End
22285>>>>>>>>>>>>>>>>
22285>>>>>>>>>>>>>>>        End
22285>>>>>>>>>>>>>>>>
22285>>>>>>>>>>>>>>>        Else Begin
22286>>>>>>>>>>>>>>>            // Search for the property name....
22286>>>>>>>>>>>>>>>            Move (SizeOfArray(gaSyncProps[iStoreIndex][iObjectIndex].aP)) to icProp
22287>>>>>>>>>>>>>>>            Move False to bFoundProp
22288>>>>>>>>>>>>>>>            
22288>>>>>>>>>>>>>>>            For iProp from 0 to (icProp - 1)
22294>>>>>>>>>>>>>>>>
22294>>>>>>>>>>>>>>>                If (Uppercase(gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sN) = sUC_PropName) Begin
22296>>>>>>>>>>>>>>>                    Move gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sV to sReturnValue
22297>>>>>>>>>>>>>>>                    
22297>>>>>>>>>>>>>>>                    // Send Hook for converting the value from format for transport.
22297>>>>>>>>>>>>>>>                    Get ConvertFromTransport of hoObject pubProp.hmGetter sReturnValue pubProp.eType to sReturnValue
22298>>>>>>>>>>>>>>>
22298>>>>>>>>>>>>>>>                    Move True to bFoundProp
22299>>>>>>>>>>>>>>>                End
22299>>>>>>>>>>>>>>>>
22299>>>>>>>>>>>>>>>                If (bFoundProp) ;                    Break
22302>>>>>>>>>>>>>>>            Loop
22303>>>>>>>>>>>>>>>>
22303>>>>>>>>>>>>>>>            
22303>>>>>>>>>>>>>>>            If (not(bFoundProp)) Begin
22305>>>>>>>>>>>>>>>                //  Use the raw property
22305>>>>>>>>>>>>>>>                Get pubprop.hmGetter of hoObject to sReturnValue
22306>>>>>>>>>>>>>>>            End
22306>>>>>>>>>>>>>>>>
22306>>>>>>>>>>>>>>>        End
22306>>>>>>>>>>>>>>>>
22306>>>>>>>>>>>>>>>        
22306>>>>>>>>>>>>>>>        Function_Return sReturnValue
22307>>>>>>>>>>>>>>>    End_Function

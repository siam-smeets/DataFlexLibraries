22554>>>>>>>>>>>>>    //
22554>>>>>>>>>>>>>    //  Central WebGet handler for non-scalar (advanced) web properties.
22554>>>>>>>>>>>>>    //  Forwards the request to the handler for the specific web property type (Client, Server, ServerSession).
22554>>>>>>>>>>>>>    //
22554>>>>>>>>>>>>>    Function OwnerGetAdvSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns Variant
22556>>>>>>>>>>>>>        Handle hoHandler
22556>>>>>>>>>>>>>        Boolean bIsAjaxWebObject
22556>>>>>>>>>>>>>        String sObject 
22556>>>>>>>>>>>>>        Variant vReturn
22556>>>>>>>>>>>>>        
22556>>>>>>>>>>>>>        // Test that the target object is a cWebObject....
22556>>>>>>>>>>>>>        Get IsAjaxWebObject of hoObject to bIsAjaxWebObject
22557>>>>>>>>>>>>>        
22557>>>>>>>>>>>>>        If (not(bIsAjaxWebObject)) Begin
22559>>>>>>>>>>>>>            Get Object_Label of hoObject to sObject
22560>>>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppNotWebObject, sObject, "WebGet " + pubProp.sName, C_NewLine+C_NewLine))
22561>>>>>>>>>>>>>>
22561>>>>>>>>>>>>>            Function_Return
22562>>>>>>>>>>>>>        End
22562>>>>>>>>>>>>>>
22562>>>>>>>>>>>>>        
22562>>>>>>>>>>>>>        //  Get and call handler
22562>>>>>>>>>>>>>        Get PropertyHandler hoObject pubProp.eMode to hoHandler
22563>>>>>>>>>>>>>        If (hoHandler = -1) Begin
22565>>>>>>>>>>>>>            Get Object_Label of hoObject to sObject
22566>>>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat("Property '%2' of object '%1' is not a valid web property for %3.%4Check the web property meta value.", pubProp.sName, sObject, "WebGet", C_NewLine+C_NewLine))        
22567>>>>>>>>>>>>>>
22567>>>>>>>>>>>>>            Function_Return
22568>>>>>>>>>>>>>        End
22568>>>>>>>>>>>>>>
22568>>>>>>>>>>>>>        
22568>>>>>>>>>>>>>        Get GetAdvSyncProp of hoHandler hoObject (&pubProp) to vReturn  
22569>>>>>>>>>>>>>        Function_Return vReturn  
22570>>>>>>>>>>>>>    End_Function
22571>>>>>>>>>>>>>    
22571>>>>>>>>>>>>>    

22200>>>>>>>>>>>>>>>// Sync Props Arrays
22200>>>>>>>>>>>>>>>
22200>>>>>>>>>>>>>>>Global_Variable tWebSyncProps[][] gaSyncProps   // This is the main web properties buffer.
22200>>>>>>>>>>>>>>>
22200>>>>>>>>>>>>>>>// gaSyncChangedProps: Changed properties. There is an array member for each object in 
22200>>>>>>>>>>>>>>>// gaSyncProps. If an Object has changed properties then the pbChanged flag is Set to True.
22200>>>>>>>>>>>>>>>Global_Variable tWebChangedProps[][] gaSyncChangedProps
22200>>>>>>>>>>>>>>>
22200>>>>>>>>>>>>>>>// gaSyncObjectHandles: This stores the object handle for each member of gaSyncProps. Used as an index
22200>>>>>>>>>>>>>>>// to gaSyncProps (and gaSyncChangedProps). C_WebUnresolvedObject is stored for an unresolved object handle.
22200>>>>>>>>>>>>>>>Global_Variable Handle[][] gaSyncObjectHandles
22200>>>>>>>>>>>>>>>
22200>>>>>>>>>>>>>>>// gaAdvSyncProps: This is the buffer for advanced web properties.
22200>>>>>>>>>>>>>>>Global_Variable tWebCacheAdvProp[][] gaAdvSyncProps
22200>>>>>>>>>>>>>>>
22200>>>>>>>>>>>>>>>
22200>>>>>>>>>>>>>>>// The basic web property handler implementation that has logic for storing and maintaining web 
22200>>>>>>>>>>>>>>>// properties in set of global variables. The global variables are used as an optimization as 
22200>>>>>>>>>>>>>>>// storing structs in web properties is inefficient in memory management. The subclasses 
22200>>>>>>>>>>>>>>>// (cWebServerPropHandler and cWebClientPropHandler) will actually store and load the web properties.
22200>>>>>>>>>>>>>>>
22200>>>>>>>>>>>>>>>Class cWebBasePropHandler is a cObject
22201>>>>>>>>>>>>>>>    
22201>>>>>>>>>>>>>>>    Procedure Construct_Object
22203>>>>>>>>>>>>>>>        Integer iIndex
22203>>>>>>>>>>>>>>>        
22203>>>>>>>>>>>>>>>        Forward Send Construct_Object
22205>>>>>>>>>>>>>>>        
22205>>>>>>>>>>>>>>>        //  Reserve index in global stores
22205>>>>>>>>>>>>>>>        Move (SizeOfArray(gaSyncProps)) to iIndex
22206>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncProps, iIndex + 1)) to gaSyncProps
22207>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps, iIndex + 1)) to gaSyncChangedProps
22208>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncObjectHandles, iIndex + 1)) to gaSyncObjectHandles
22209>>>>>>>>>>>>>>>        Move (ResizeArray(gaAdvSyncProps, iIndex + 1)) to gaAdvSyncProps
22210>>>>>>>>>>>>>>>        Property Integer piStoreIndex iIndex
22211>>>>>>>>>>>>>>>        
22211>>>>>>>>>>>>>>>        Property Boolean pbErrorObjNotFound True
22212>>>>>>>>>>>>>>>        
22212>>>>>>>>>>>>>>>        // Sync Props Arrays - Allocation Optimization Properties
22212>>>>>>>>>>>>>>>        // In order to optimize web properties we allocate in advance empty array 
22212>>>>>>>>>>>>>>>        // slots in gaSyncProps, gaSyncChangedProps and gaSyncObjectHandles.
22212>>>>>>>>>>>>>>>        
22212>>>>>>>>>>>>>>>        // piSize: This is a pointer to the last object in the gaSyncObjectHandles, gaSyncProps
22212>>>>>>>>>>>>>>>        // and gaSyncChangedProps arrays. When this value equals the size of the arrays then more space
22212>>>>>>>>>>>>>>>        // is allocated in these arrays.
22212>>>>>>>>>>>>>>>        Property Integer piSize 0
22213>>>>>>>>>>>>>>>        
22213>>>>>>>>>>>>>>>        // piCapacity: This is the actual size of the gaSyncObjectHandles, gaSyncProps and gaSyncChangedProps
22213>>>>>>>>>>>>>>>        // arrays. When piObjectCount equals this value, more space is allocated in these arrays.
22213>>>>>>>>>>>>>>>        Property Integer piCapacity 0
22214>>>>>>>>>>>>>>>        
22214>>>>>>>>>>>>>>>        // piGrowthFactor: This is the size of the next jump in size of the gaSyncObjectHandles, gaSyncProps
22214>>>>>>>>>>>>>>>        // and gaSyncChangedProps arrays. This value is used to double the size increase each time more space
22214>>>>>>>>>>>>>>>        // is allocated in the arrays.
22214>>>>>>>>>>>>>>>        Property Integer piGrowthFactor 0
22215>>>>>>>>>>>>>>>        
22215>>>>>>>>>>>>>>>        // pbActive: When False, all calls to get or set a web property are ignored.
22215>>>>>>>>>>>>>>>        // This ensures that web properties are only accessed during an AJAX call.
22215>>>>>>>>>>>>>>>        // Otherwise, attempting to access web properties outside an AJAX call can 
22215>>>>>>>>>>>>>>>        // corrupt the web properties system.
22215>>>>>>>>>>>>>>>        Property Boolean pbActive False
22216>>>>>>>>>>>>>>>        
22216>>>>>>>>>>>>>>>        Property Handle phoWebControlLocator 0
22217>>>>>>>>>>>>>>>        Property Handle phoWebHost C_WebUnresolvedObject
22218>>>>>>>>>>>>>>>    End_Procedure

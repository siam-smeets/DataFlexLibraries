22219>>>>>>>>>>>>>>>    
22219>>>>>>>>>>>>>>>    //
22219>>>>>>>>>>>>>>>    // Adds the passed object to the global web properties arrays. It is assumed that the object is a cWebObject.
22219>>>>>>>>>>>>>>>    //
22219>>>>>>>>>>>>>>>    // Returns:
22219>>>>>>>>>>>>>>>    //      The object's index to the global sync props array.
22219>>>>>>>>>>>>>>>    Function AddObjectToSyncProps Handle hoObject Returns Integer
22221>>>>>>>>>>>>>>>        String sObjectName
22221>>>>>>>>>>>>>>>        Integer iStoreIndex iSize iCapacity iGrowthFactor iObjectIndex
22221>>>>>>>>>>>>>>>        
22221>>>>>>>>>>>>>>>        Move -1 to iObjectIndex
22222>>>>>>>>>>>>>>>        
22222>>>>>>>>>>>>>>>        If (hoObject > 0) Begin
22224>>>>>>>>>>>>>>>            Get piStoreIndex to iStoreIndex
22225>>>>>>>>>>>>>>>            Get piSize to iSize
22226>>>>>>>>>>>>>>>            Get piCapacity to iCapacity
22227>>>>>>>>>>>>>>>            Get piGrowthFactor to iGrowthFactor
22228>>>>>>>>>>>>>>>            Get WebObjectName of hoObject to sObjectName
22229>>>>>>>>>>>>>>>            
22229>>>>>>>>>>>>>>>            // Determine if we need to increase the array sizes....
22229>>>>>>>>>>>>>>>            If (iSize = iCapacity) Begin
22231>>>>>>>>>>>>>>>                Move (iGrowthFactor + iGrowthFactor) to iGrowthFactor    // double the growth factor
22232>>>>>>>>>>>>>>>                Move (iCapacity + iGrowthFactor) to iCapacity            // increase the capacity
22233>>>>>>>>>>>>>>>    
22233>>>>>>>>>>>>>>>                Set piCapacity to iCapacity
22234>>>>>>>>>>>>>>>                Set piGrowthFactor to iGrowthFactor
22235>>>>>>>>>>>>>>>                
22235>>>>>>>>>>>>>>>                Move (ResizeArray(gaSyncProps[iStoreIndex], iCapacity)) to gaSyncProps[iStoreIndex]
22236>>>>>>>>>>>>>>>                Move (ResizeArray(gaSyncObjectHandles[iStoreIndex], iCapacity)) to gaSyncObjectHandles[iStoreIndex]
22237>>>>>>>>>>>>>>>                Move (ResizeArray(gaSyncChangedProps[iStoreIndex], iCapacity)) to gaSyncChangedProps[iStoreIndex]
22238>>>>>>>>>>>>>>>            End
22238>>>>>>>>>>>>>>>>
22238>>>>>>>>>>>>>>>            
22238>>>>>>>>>>>>>>>            // Add the passed object to gaSyncObjectHandles....
22238>>>>>>>>>>>>>>>            Set piSize       to (iSize + 1)
22239>>>>>>>>>>>>>>>            Move iSize       to iObjectIndex
22240>>>>>>>>>>>>>>>            Move hoObject    to gaSyncObjectHandles[iStoreIndex][iObjectIndex]
22241>>>>>>>>>>>>>>>            Move False       to gaSyncChangedProps[iStoreIndex][iObjectIndex].bContainsChanges    // False so far because we did not find the property yet
22242>>>>>>>>>>>>>>>            Move sObjectName to gaSyncProps[iStoreIndex][iObjectIndex].sO
22243>>>>>>>>>>>>>>>        End
22243>>>>>>>>>>>>>>>>
22243>>>>>>>>>>>>>>>        
22243>>>>>>>>>>>>>>>        Function_Return iObjectIndex
22244>>>>>>>>>>>>>>>    End_Function

446>>>>>>>>>>>Define ifReload                for |CI$80000000  // retrieve the original item
446>>>>>>>>>>>Define ifNoCacheWrite          for |CI$04000000  // don't write this item to the cache
446>>>>>>>>>>>Define ifMakePersistent        for |CI$02000000  // make this item persistent in cache
446>>>>>>>>>>>Define ifFromCache             for |CI$01000000  // use offline semantics
446>>>>>>>>>>>Define ifSecure                for |CI$00800000  // use PCT/SSL if applicable (HTTP)
446>>>>>>>>>>>Define ifKeepConnection        for |CI$00400000  // use keep-alive semantics
446>>>>>>>>>>>Define ifNoAutoRedirect        for |CI$00200000  // don't handle redirections automatically
446>>>>>>>>>>>Define ifReadPrefetch          for |CI$00100000  // do background read prefetch
446>>>>>>>>>>>Define ifNoCookies             for |CI$00080000  // no automatic cookie handling
446>>>>>>>>>>>Define ifNoAuth                for |CI$00040000  // no automatic authentication handling
446>>>>>>>>>>>Define ifCacheIfNetFail        for |CI$00010000  // return cache file if net request fails
446>>>>>>>>>>>Define ifIgnoreRedirectToHttp  for |CI$00008000 // ex: https:// to http://
446>>>>>>>>>>>Define IfIgnoreRedirectToHttps for |CI$00004000 // ex: http:// to https://
446>>>>>>>>>>>Define IfIgnoreCertDateInvalid for |CI$00002000 // expired X509 Cert.
446>>>>>>>>>>>Define IfIgnoreCertCnInvalid   for |CI$00001000 // bad common name in X509 Cert.
446>>>>>>>>>>>Define ifResynchronize         for |CI$00000800  // asking wininet to update an item if it is newer
446>>>>>>>>>>>Define ifHyperlink             for |CI$00000400  // asking wininet to do hyperlinking semantic which works right for scripts
446>>>>>>>>>>>Define ifNoUi                  for |CI$00000200  // no cookie popup
446>>>>>>>>>>>Define ifPragmaNocache         for |CI$00000100  // asking wininet to add "pragma: no-cache"
446>>>>>>>>>>>Define ifCacheAsync            for |CI$00000080  // ok to perform lazy cache-write
446>>>>>>>>>>>Define ifFormsSubmit           for |CI$00000040  // this is a forms submit
446>>>>>>>>>>>Define ifNeedFile              for |CI$00000010  // need a file for this request

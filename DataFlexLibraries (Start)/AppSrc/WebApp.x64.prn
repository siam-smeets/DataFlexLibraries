30383>>>>>>>>>>>    //  Generates random data and does a base64 encoding to properly present it as a string.
30383>>>>>>>>>>>    Function GenerateRandomString Integer iLength Returns String
30385>>>>>>>>>>>        String sResult
30385>>>>>>>>>>>        UChar[] ucData
30386>>>>>>>>>>>        Pointer pBase64
30386>>>>>>>>>>>        Integer iVoid
30386>>>>>>>>>>>        
30386>>>>>>>>>>>        Get GenerateRandom iLength to ucData
30387>>>>>>>>>>>        
30387>>>>>>>>>>>        Move (Base64Encode(AddressOf(ucData), iLength)) to pBase64
30388>>>>>>>>>>>        Move (PointerToString(pBase64)) to sResult
30389>>>>>>>>>>>        Move (Free(pBase64)) to iVoid
30390>>>>>>>>>>>        
30390>>>>>>>>>>>        Function_Return (Left(sResult, iLength))
30391>>>>>>>>>>>    End_Function

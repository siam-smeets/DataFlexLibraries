8825>>>>>>>    
8825>>>>>>>    Procedure DoOpenWorkspace String sWorkspace
8827>>>>>>>        // Tries to open in this order:
8827>>>>>>>        // 1) if absolute path, use that; otherwise
8827>>>>>>>        // 2) try to open in the path of the EXE; otherwise
8827>>>>>>>        // 3) load it via the Registered list
8827>>>>>>>        
8827>>>>>>>        Integer eOpened
8827>>>>>>>        String sError sWSFile
8827>>>>>>>        Handle hoWorkspace
8827>>>>>>>        Boolean bChangingWorkspace
8827>>>>>>>        
8827>>>>>>>        // As soon as an open is attempted, the application's object psAutoOpenWorkspace property
8827>>>>>>>        // is cleared. This way any attempt to manually open a workspace during its construction,
8827>>>>>>>        // which includes OnCreate, will stop the object from attempting to automatically open the
8827>>>>>>>        // workspace. This was added to make psAutoOpenWorkspace compatible with older applications.
8827>>>>>>>        // Typically these application will open a workspace in OnCreate. If this happens we assume
8827>>>>>>>        // that there should be no automatic opening of a worskpace.
8827>>>>>>>        Set psAutoOpenWorkspace to ""
8828>>>>>>>        
8828>>>>>>>        Get phoWorkspace to hoWorkspace
8829>>>>>>>        
8829>>>>>>>        Get pbWorkspaceOpened of hoWorkspace to bChangingWorkspace
8830>>>>>>>        If (bChangingWorkspace and ghoConnection) Begin
8832>>>>>>>            Send AutoDisconnect
8833>>>>>>>        End
8833>>>>>>>>
8833>>>>>>>        
8833>>>>>>>        Get OpenWorkspaceFile of hoWorkspace sWorkspace to eOpened
8834>>>>>>>        If (eOpened = wsWorkspaceFileNotFound) Begin
8836>>>>>>>            If (IsRegistered(hoWorkspace, sWorkspace) =True) Begin
8838>>>>>>>                Get OpenWorkspace of hoWorkspace sWorkspace to eOpened
8839>>>>>>>            End
8839>>>>>>>>
8839>>>>>>>        End
8839>>>>>>>>
8839>>>>>>>        If (eOpened <> wsWorkspaceOpened) Begin
8841>>>>>>>            Get OpenWorkspaceErrorMessage of hoWorkspace eOpened to sError
8842>>>>>>>            Get psWorkspaceWSFile of hoWorkspace to sWSFile
8843>>>>>>>            Error DFERR_CAPPLICATION (SFormat(C_$TheProgramCannotRun, sWorkspace) + ":\n\n" + If(sWSFile<>"",sWSfile+"\n\n","") +sError)
8844>>>>>>>>
8844>>>>>>>            Abort
8845>>>>>>>>
8845>>>>>>>        End
8845>>>>>>>>
8845>>>>>>>        Else Begin
8846>>>>>>>            Send AutoConnect
8847>>>>>>>            Send OnWorkspaceOpened
8848>>>>>>>        End
8848>>>>>>>>
8848>>>>>>>    End_Procedure
8849>>>>>>>    
8849>>>>>>>    Procedure AutoConnect
8851>>>>>>>        If (ghoConnection) Begin
8853>>>>>>>            Send AutoConnect of ghoConnection
8854>>>>>>>        End
8854>>>>>>>>
8854>>>>>>>    End_Procedure
8855>>>>>>>    
8855>>>>>>>    Procedure AutoDisconnect
8857>>>>>>>        If (ghoConnection) Begin
8859>>>>>>>            Send AutoDisconnect of ghoConnection
8860>>>>>>>        End
8860>>>>>>>>
8860>>>>>>>    End_Procedure
8861>>>>>>>    
8861>>>>>>>    // send after a workspace is successfully opened and connected
8861>>>>>>>    Procedure OnWorkspaceOpened
8863>>>>>>>    End_Procedure
8864>>>>>>>    
8864>>>>>>>    Procedure OnCreate
8866>>>>>>>        // Event called when the Application object is ready to be used
8866>>>>>>>        // to open a Workspace, etc.
8866>>>>>>>    End_Procedure
8867>>>>>>>    
8867>>>>>>>    Procedure End_Construct_Object
8869>>>>>>>        String sName
8869>>>>>>>        Forward Send End_Construct_Object
8871>>>>>>>        Send OnCreate
8872>>>>>>>        // note that psAutoOpenWorkspace will get cleared of OnCreate attempts to open a workspace
8872>>>>>>>        Get psAutoOpenWorkspace to sName
8873>>>>>>>        If (sName<>"") Begin
8875>>>>>>>            Send DoOpenWorkspace sName
8876>>>>>>>        End
8876>>>>>>>>
8876>>>>>>>    End_Procedure
8877>>>>>>>    
8877>>>>>>>    Function GetApplicationFileName Returns String
8879>>>>>>>        // Returns the filename from Windows
8879>>>>>>>        Integer iNumChars
8879>>>>>>>        WString wFilename
8879>>>>>>>                
8879>>>>>>>        Move (Repeat(Character(0), 1024)) to wFilename
8880>>>>>>>        Move (GetModuleFileNameW(0, AddressOf(wFilename), 1024)) to iNumChars
8881>>>>>>>        
8881>>>>>>>        Function_Return (CString(wFilename))
8882>>>>>>>    End_Function
8883>>>>>>>    
8883>>>>>>>    Function GetApplicationPath Returns String
8885>>>>>>>        // Returns the path of the Application (no trailing "\")
8885>>>>>>>        WString wApplicationFileName 
8885>>>>>>>        String sPath
8885>>>>>>>        Boolean bRemoved
8885>>>>>>>        
8885>>>>>>>        Get GetApplicationFileName  to wApplicationFileName
8886>>>>>>>        Move (PathRemoveFileSpecW(AddressOf(wApplicationFileName))) to bRemoved
8887>>>>>>>        Move (CString(wApplicationFileName)) to sPath
8888>>>>>>>        
8888>>>>>>>        If (Right(sPath, 1) ="\") ;            Move (Left(sPath, Length(sPath) -1)) to sPath
8891>>>>>>>        Function_Return sPath
8892>>>>>>>    End_Function
8893>>>>>>>    
8893>>>>>>>    Function GetApplicationName Returns String
8895>>>>>>>        // Returns the name of the Application (without its Path or Extension)
8895>>>>>>>        String sApplicationFileName 
8895>>>>>>>        WString wApplicationName
8895>>>>>>>        Boolean bRemoved
8895>>>>>>>        Integer iVoid
8895>>>>>>>        
8895>>>>>>>        Get GetApplicationFileName to sApplicationFileName
8896>>>>>>>        Move (ExtractFileName(sApplicationFileName)) to wApplicationName
8897>>>>>>>        Move (PathRemoveExtensionW(AddressOf(wApplicationName))) to iVoid
8898>>>>>>>        Function_Return (CString(wApplicationName))
8899>>>>>>>    End_Function
8900>>>>>>>    
8900>>>>>>>    Function DFRootPath Returns String
8902>>>>>>>        String sRoot
8902>>>>>>>        Get_Profile_String "Defaults" "VDFRootDir" to sRoot
8905>>>>>>>        // Ensure it does not contain a trailing "\"
8905>>>>>>>        If (Right(sRoot,1) = "\") Begin
8907>>>>>>>            Move (Left(sRoot, Length(sRoot)-1)) to sRoot
8908>>>>>>>        End
8908>>>>>>>>
8908>>>>>>>        Function_Return sRoot
8909>>>>>>>    End_Function
8910>>>>>>>    
8910>>>>>>>    Function DFBinPath Returns String
8912>>>>>>>        String sRoot
8912>>>>>>>        Get DFRootPath to sRoot
8913>>>>>>>        If (sRoot<>"") Begin
8915>>>>>>>                Move (sRoot+"\bin64") to sRoot 
8916>>>>>>>        End
8916>>>>>>>>
8916>>>>>>>        Else Begin
8917>>>>>>>            // if the root from the registry (vdfrootdir) is empty, we will assume that the
8917>>>>>>>            // bin path must be the same as the application path.
8917>>>>>>>            Get GetApplicationPath to sRoot
8918>>>>>>>        End
8918>>>>>>>>
8918>>>>>>>        Function_Return sRoot
8919>>>>>>>    End_Function

30558>>>>>>>    // This procedure is called whenever a session key is stored by the framework. By default the 
30558>>>>>>>    // session key is stored in a cookie and the settings (cookie name,  timeout, path) are read 
30558>>>>>>>    // from the SessionManager. Overriding this procedure allows the developer to customize
30558>>>>>>>    // this behavior.
30558>>>>>>>    //
30558>>>>>>>    // Params:
30558>>>>>>>    //   sSessionKey   The new session key. "" if the session is cleared.
30558>>>>>>>    Procedure StoreSessionKey String sSessionKey
30560>>>>>>>        String sPath
30560>>>>>>>        Integer iPos
30560>>>>>>>        Handle hoSessionManager
30560>>>>>>>        
30560>>>>>>>        Get SessionManager to hoSessionManager
30561>>>>>>>        Get psSessionCookiePath of hoSessionManager to sPath
30562>>>>>>>        
30562>>>>>>>        //  If the path is empty we determine the current path where the cookie should be set, we can't leave it blank as the client interprets /CallAction/JSON in the URL as part of the path
30562>>>>>>>        If (Trim(sPath) = "") Begin
30564>>>>>>>            Get ServerVariable of (ServiceDispatcher(Self)) "SCRIPT_NAME" to sPath
30565>>>>>>>            
30565>>>>>>>            Move (Pos("WebServiceDispatcher.wso", sPath)) to iPos
30566>>>>>>>            If (iPos > 0) Begin
30568>>>>>>>                Move (Left(sPath, iPos - 1)) to sPath
30569>>>>>>>            End
30569>>>>>>>>
30569>>>>>>>            
30569>>>>>>>            Move (RightPos("/", sPath)) to iPos    
30570>>>>>>>            If (iPos > 0) Begin
30572>>>>>>>                Move (Left(sPath, iPos)) to sPath
30573>>>>>>>            End
30573>>>>>>>>
30573>>>>>>>        End
30573>>>>>>>>
30573>>>>>>>        
30573>>>>>>>        Send SetCookie (psSessionCookieName(hoSessionManager)) sSessionKey (piSessionCookieTimeout(hoSessionManager)) sPath (psSessionCookieDomain(hoSessionManager)) (pbSessionCookieSecure(hoSessionManager)) (pbSessionCookieHttpOnly(hoSessionManager)) (psSessionCookieSameSite(hoSessionManager))
30574>>>>>>>    End_Procedure    

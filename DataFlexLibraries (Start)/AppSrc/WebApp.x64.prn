353>>>>>>>>>>>>>>>External_Function FindResource "FindResourceA" Kernel32.dll ;    Handle  hModule ;       // A handle to the target module GetModuleHandle(0)    String sName ;        // Name of the icon resource e.g. 'Save.ico'    String sType ;        // The resource type. e.g. RT_GROUP_ICON    Returns Handle          // handle to the specified resource's information block. To obtain a handle to the resource, pass this handle to the LoadResource function.
354>>>>>>>>>>>>>>>
354>>>>>>>>>>>>>>>// Retrieves a handle that can be used to obtain a pointer to the first byte of the specified resource in memory.
354>>>>>>>>>>>>>>>External_Function LoadResource "LoadResource" Kernel32.dll ;    Handle hModule ;      // A handle to the target module GetModuleHandle(0)    Handle hResInfo ;     // A handle to the resource to be loaded. This handle is returned by the FindResource    Returns Handle        // Handle to the data associated with the resource. To obtain a pointer to the first byte of the resource data, call the LockResource function
355>>>>>>>>>>>>>>>
355>>>>>>>>>>>>>>>
355>>>>>>>>>>>>>>>// Retrieves a pointer to the specified resource in memory.
355>>>>>>>>>>>>>>>External_Function LockResource "LockResource" Kernel32.dll ;    Handle hResData ;     // handle to the resource to be accessed. The LoadResource function returns this handle.    Returns Pointer       // pointer to the first byte of the resource.

39484>>>
39484>>>        // if this view is being used in multiple contexts, you may need a block of code
39484>>>        // like this to handle customizations. This would include hiding rows and buttons
39484>>>        // (WebSet pbRender) and changing the values of various captions.
39484>>>        Case Begin
39484>>>            Case (NavigateData.eNavigateType=nfFromParent)
39486>>>                // If from parent, this is a constrained drill down.
39486>>>                // If needed you could check NavigateData.iTable to determine the constraining parent.
39486>>>                Case Break
39487>>>                
39487>>>            Case (NavigateData.eNavigateType=nfFromChild)
39490>>>                // If from child, this is a probably a parent lookup from a Zoom
39490>>>                Case Break
39491>>>                
39491>>>            Case (NavigateData.eNavigateType=nfFromMain)
39494>>>                // If from main, this is a propbably a main file lookup from a Zoom.
39494>>>                // This is not used often with the drilldown style
39494>>>                Case Break
39495>>>                
39495>>>            Case Else // must be nfUndefined
39495>>>                // This may be the start of a drilldown query or some kind ofcustom query.
39495>>>                // You may want to check NavigateData.NamedValues.
39495>>>                  
39495>>>        Case End
39495>>>        

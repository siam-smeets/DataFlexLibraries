31776>>>>>    // Gets the value of a URL parameter based on its name. It parses the URL to determine the 
31776>>>>>    // parameters that are sent and returns the value of the requested parameter ("" if not found).
31776>>>>>    Function UrlParameter String sName Returns String
31778>>>>>        Integer iPos iPos2 iVoid
31778>>>>>        String sUrl
31778>>>>>        WString wsUnescape
31778>>>>>        
31778>>>>>        //  Get the URL from the HTTP header
31778>>>>>        Get ServerVariable of (ServiceDispatcher(Self)) "HTTP_REFERER" to sUrl
31779>>>>>        
31779>>>>>        If (Trim(sUrl) <> "") Begin
31781>>>>>            //  Find ? indicating GET parameters
31781>>>>>            Move (Pos("?", sUrl)) to iPos
31782>>>>>            If (iPos > 0) Begin
31784>>>>>                
31784>>>>>                Move (Uppercase(sName)) to sName
31785>>>>>
31785>>>>>                //  Loop over GET parameters
31785>>>>>                Repeat
31785>>>>>>
31785>>>>>                    //  Determine position of the name
31785>>>>>                    Increment iPos  //  Step over the ? or &
31786>>>>>                    Move (Pos("=", sUrl, iPos)) to iPos2
31787>>>>>                    
31787>>>>>                    //  Check the name
31787>>>>>                    Move (Mid(sURl, iPos2 - iPos, iPos)) to wsUnescape
31788>>>>>                    If (SizeOfWString(wsUnescape) > 0) Begin
31790>>>>>                        Move (UrlUnescapeW(AddressOf(wsUnescape), 0, 0, URL_UNESCAPE_INPLACE ior URL_UNESCAPE_AS_UTF8)) to iVoid
31791>>>>>                    End
31791>>>>>>
31791>>>>>                    If (Uppercase(CString(wsUnescape)) = sName) Begin
31793>>>>>                        
31793>>>>>                        //  Determine position of the value
31793>>>>>                        Increment iPos2 //  Step over the =
31794>>>>>                        Move (Pos("&", sUrl, iPos2)) to iPos
31795>>>>>                        
31795>>>>>                        If (iPos > 0) Begin
31797>>>>>                            Move (Mid(sUrl, iPos - iPos2, iPos2)) to wsUnescape
31798>>>>>                        End
31798>>>>>>
31798>>>>>                        Else Begin
31799>>>>>                            Move ((Mid(sUrl, (Length(sUrl) - iPos2 + 1), iPos2))) to wsUnescape
31800>>>>>                        End
31800>>>>>>
31800>>>>>                        If (SizeOfWString(wsUnescape) > 0) Begin
31802>>>>>                            Move (UrlUnescapeW(AddressOf(wsUnescape), 0, 0, URL_UNESCAPE_INPLACE ior URL_UNESCAPE_AS_UTF8)) to iVoid
31803>>>>>                        End
31803>>>>>>
31803>>>>>                        Function_Return (CString(wsUnescape))
31804>>>>>                    End
31804>>>>>>
31804>>>>>                    
31804>>>>>                    Move (Pos("&", sUrl, iPos2)) to iPos
31805>>>>>                Until (not(iPos > 0)) 
31807>>>>>                
31807>>>>>            End
31807>>>>>>
31807>>>>>        End
31807>>>>>>
31807>>>>>        
31807>>>>>        Function_Return ""
31808>>>>>    End_Function
31809>>>>>    

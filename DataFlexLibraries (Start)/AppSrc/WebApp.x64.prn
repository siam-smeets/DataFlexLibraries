24935>>>>>>>>>>>>>>>
24935>>>>>>>>>>>>>>>Class cWebBaseSelectionForm is a cWebForm
24936>>>>>>>>>>>>>>>    
24936>>>>>>>>>>>>>>>    Procedure Construct_Object
24938>>>>>>>>>>>>>>>        Forward Send Construct_Object
24940>>>>>>>>>>>>>>>        
24940>>>>>>>>>>>>>>>        Property Boolean pbFullText                 False
24943>>>>>>>>>>>>>>>        Property Boolean pbCaseSensitive            False
24946>>>>>>>>>>>>>>>        Property Boolean pbAllData                  False
24949>>>>>>>>>>>>>>>        Property Boolean pbSuggestions              False
24952>>>>>>>>>>>>>>>        Property Boolean pbPaged                    False
24955>>>>>>>>>>>>>>>        Property Boolean pbSourceIsValidationTable  False
24958>>>>>>>>>>>>>>>        
24958>>>>>>>>>>>>>>>        Property Integer piPageSize                 10
24961>>>>>>>>>>>>>>>        Property Integer piStartAtChar              0
24964>>>>>>>>>>>>>>>        Property Integer piPopupWidth               0
24967>>>>>>>>>>>>>>>        Property Integer piTypeTimeout              20
24970>>>>>>>>>>>>>>>        Property String psShowMoreText              C_$ShowMore
24973>>>>>>>>>>>>>>>        Property String psCreateNewItemText         C_$CreateNew
24976>>>>>>>>>>>>>>>        Property Boolean pbAllowCreate              False
24979>>>>>>>>>>>>>>>        Property Integer piMinimumItemLength        2
24982>>>>>>>>>>>>>>>        
24982>>>>>>>>>>>>>>>        Property Boolean pbAutoCreate               False // This property exists to solve the recursive include.
24983>>>>>>>>>>>>>>>        
24983>>>>>>>>>>>>>>>        Property Handle phoSelectionSource          0
24984>>>>>>>>>>>>>>>        
24984>>>>>>>>>>>>>>>        Property String psAdvancedSearchText        C_$AdvancedSearch        
24987>>>>>>>>>>>>>>>
24987>>>>>>>>>>>>>>>        Property Boolean pbShowSuggestionsOnFocus
24990>>>>>>>>>>>>>>>
24990>>>>>>>>>>>>>>>        Set pbAllowCreate to False
24991>>>>>>>>>>>>>>>
24991>>>>>>>>>>>>>>>        Set psJSClass to "df.WebBaseSelectionForm"
24992>>>>>>>>>>>>>>>    End_Procedure
24993>>>>>>>>>>>>>>>    
24993>>>>>>>>>>>>>>>    Procedure PreSerializeObject
24995>>>>>>>>>>>>>>>        Boolean bFullText bIsValidationTable bCaseSensetive bAllData bSuggestions bPaged
24995>>>>>>>>>>>>>>>        Handle hoSelectionSource
24995>>>>>>>>>>>>>>>        
24995>>>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
24996>>>>>>>>>>>>>>>        
24996>>>>>>>>>>>>>>>        If (hoSelectionSource > 0) Begin
24998>>>>>>>>>>>>>>>            Get pbCaseSensitive of hoSelectionSource to bCaseSensetive            
24999>>>>>>>>>>>>>>>            Get pbFullText of hoSelectionSource to bFullText
25000>>>>>>>>>>>>>>>            Get pbAllData of hoSelectionSource to bAllData
25001>>>>>>>>>>>>>>>            Get pbSuggestions of hoSelectionSource to bSuggestions
25002>>>>>>>>>>>>>>>            Get pbPaged of hoSelectionSource to bPaged
25003>>>>>>>>>>>>>>>            
25003>>>>>>>>>>>>>>>            Set pbFullText to bFullText
25004>>>>>>>>>>>>>>>            Get pbUseValidationTable of hoSelectionSource to bIsValidationTable
25005>>>>>>>>>>>>>>>            Set pbSourceIsValidationTable to bIsValidationTable
25006>>>>>>>>>>>>>>>            
25006>>>>>>>>>>>>>>>            If (bAllData and bSuggestions) ;                Error DFERR_PROGRAM "Invalid suggestion mode."
25009>>>>>>>>>>>>>>>            If (bAllData and bPaged) ;                Error DFERR_PROGRAM "Invalid suggestion mode."
25012>>>>>>>>>>>>>>>            If (bSuggestions and bPaged) ;                Error DFERR_PROGRAM "Invalid suggestion mode."
25015>>>>>>>>>>>>>>>            If (not(bAllData) and not(bSuggestions) and not(bPaged)) ;                Error DFERR_PROGRAM "Invalid suggestion mode."
25018>>>>>>>>>>>>>>>            
25018>>>>>>>>>>>>>>>            Set pbAllData to bAllData
25019>>>>>>>>>>>>>>>            Set pbSuggestions to bSuggestions
25020>>>>>>>>>>>>>>>            Set pbPaged to bPaged
25021>>>>>>>>>>>>>>>            Set pbCaseSensitive to bCaseSensetive
25022>>>>>>>>>>>>>>>        End
25022>>>>>>>>>>>>>>>>
25022>>>>>>>>>>>>>>>    End_Procedure
25023>>>>>>>>>>>>>>>    
25023>>>>>>>>>>>>>>>    Procedure Set SelectionSource Handle hoSelectionSource
25025>>>>>>>>>>>>>>>        Set phoSelectionSource to hoSelectionSource
25026>>>>>>>>>>>>>>>    End_Procedure

21355>>>>>>>>>    Procedure Define_cWebDDOSync_mixin
21357>>>>>>>>>        Property Handle Main_DD 0
21358>>>>>>>>>
21358>>>>>>>>>        /*        This array is used to cache the DDO structure of the view. It is initialized during         End_Construct_Object and is sorted alphabetically. The name is generated using the         DDIdentity which makes it unique within the view. Used for fast searches of DDO object name         to DDO handle.        */
21358>>>>>>>>>        Property tNameHandlePair[] paDDOIndex
21359>>>>>>>>>        
21359>>>>>>>>>        // This array is used for traversing the DDO structure in order of Main DD, then the child DDO structure followed by the parent DDO structure.
21359>>>>>>>>>        Property Handle[] paDDOHandlesTree  // Handle to each DDO in the DDO Structure - sorted by: Main DD, Child DD tree, Parent DD tree
21360>>>>>>>>>        
21360>>>>>>>>>        // This array stores the Main_DD of one or more alternative DDO structures. This is used to
21360>>>>>>>>>        // append multiple DDO structures to the set of DDO structures that are synchronized at the client.
21360>>>>>>>>>        // Note: you do not need to add the View's Main_DD to this array. Its DDO structure is automatically
21360>>>>>>>>>        // added to the synchronized list.
21360>>>>>>>>>        Property Handle[] paAdditionalDDOStructures
21361>>>>>>>>>        
21361>>>>>>>>>        Property tWebDDODef ptDDOStates
21364>>>>>>>>>    End_Procedure
21365>>>>>>>>>    
21365>>>>>>>>>    Procedure AddDDOStructure Handle hoMain_DD
21367>>>>>>>>>        // If your view has two or more independant DDO Structures then send this message to add
21367>>>>>>>>>        // each additional DDO structure to the set of DDO structures that are synchronized with
21367>>>>>>>>>        // the client. Do not Send this to add the view's main DDO structure, that will be added
21367>>>>>>>>>        // automatically. Pass the Main_DD of the DDO structure as the parameter.
21367>>>>>>>>>        Handle[] aAdditionalDDOStructures
21368>>>>>>>>>        
21368>>>>>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
21369>>>>>>>>>        Move hoMain_DD to aAdditionalDDOStructures[SizeOfArray(aAdditionalDDOStructures)]
21370>>>>>>>>>        Set paAdditionalDDOStructures to aAdditionalDDOStructures
21371>>>>>>>>>    End_Procedure
21372>>>>>>>>>    
21372>>>>>>>>>    
21372>>>>>>>>>     Procedure FindDataDictionaries Handle hoCurrentDD Handle[] ByRef aDDOHandles
21374>>>>>>>>>        // Recursive function to iterate the structure of data dictionary objects in this view
21374>>>>>>>>>        // returning an array of DD object handles in the ByRef parameter.
21374>>>>>>>>>        //
21374>>>>>>>>>        // To start the search call this method with hoCurrentDD set to the view's Main DD
21374>>>>>>>>>        // and hDataDictionaries passed as an empty array.
21374>>>>>>>>>        //
21374>>>>>>>>>        // Returns an array of DDO object handles: first the Main DD, followed by the child DD tree, then the parent DD tree
21374>>>>>>>>>        Handle hoNextDD
21374>>>>>>>>>        Integer iCounter iCount
21374>>>>>>>>>        
21374>>>>>>>>>        // Append the passed data dictionary to the array.....
21374>>>>>>>>>        Move hoCurrentDD to aDDOHandles[(SizeOfArray(aDDOHandles))]
21375>>>>>>>>>    
21375>>>>>>>>>        // Add the client ddo's....
21375>>>>>>>>>        Get Data_Set_Client_Count of hoCurrentDD to iCount
21376>>>>>>>>>        
21376>>>>>>>>>        For iCounter from 0 to (iCount - 1)
21382>>>>>>>>>>
21382>>>>>>>>>            Get Data_Set_Client of hoCurrentDD iCounter to hoNextDD
21383>>>>>>>>>            
21383>>>>>>>>>            If (SearchArray(hoNextDD, aDDOHandles) < 0) Begin
21385>>>>>>>>>               Send FindDataDictionaries hoNextDD (&aDDOHandles)
21386>>>>>>>>>            End
21386>>>>>>>>>>
21386>>>>>>>>>        Loop
21387>>>>>>>>>>
21387>>>>>>>>>        
21387>>>>>>>>>        // Add the server ddo's....
21387>>>>>>>>>        Get Data_Set_Server_Count of hoCurrentDD to iCount
21388>>>>>>>>>        
21388>>>>>>>>>        For iCounter from 0 to (iCount-1)
21394>>>>>>>>>>
21394>>>>>>>>>            Get Data_Set_Server of hoCurrentDD iCounter to hoNextDD
21395>>>>>>>>>    
21395>>>>>>>>>            If (SearchArray(hoNextDD, aDDOHandles) < 0) Begin
21397>>>>>>>>>               Send FindDataDictionaries hoNextDD (&aDDOHandles)
21398>>>>>>>>>            End
21398>>>>>>>>>>
21398>>>>>>>>>        Loop
21399>>>>>>>>>>
21399>>>>>>>>>    End_Procedure
21400>>>>>>>>>    
21400>>>>>>>>>    /*    Returns unique name for DDO object within this view, which is basically the long object name     not including the view name. This allows duplicate DD object names (as long as they are not     siblings!). This name is used in the synchronization logic.    */
21400>>>>>>>>>    Function DDIdentity Handle hoDD Returns String
21402>>>>>>>>>        Function_Return (Right(Name(hoDD), Length(Name(hoDD)) - Length(Name(Self)) - 1))
21403>>>>>>>>>    End_Function
21404>>>>>>>>>    

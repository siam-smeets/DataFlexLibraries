17616>>>>>>>// Singleton object that implements a library of methods that can be used for 
17616>>>>>>>// returning target cWebView, cWebControl or cWebApp handles from an object name
17616>>>>>>>// string.
17616>>>>>>>//
17616>>>>>>>// Only controls that implement the cWebControl_mixin interface can be located
17616>>>>>>>// with this object
17616>>>>>>>Class cWebControlLocator is a cObject
17617>>>>>>>    Procedure Construct_Object
17619>>>>>>>        Forward Send Construct_Object
17621>>>>>>>        
17621>>>>>>>        // Object Reference Arrays
17621>>>>>>>        
17621>>>>>>>        // These two arrays have synchronized members. This means that paWebControlNames
17621>>>>>>>        // can be searched to lookup the corresponding object handle.
17621>>>>>>>        Property tWebControlMapItem[] paWebControls
17622>>>>>>>        
17622>>>>>>>        Property Handle phoWebHost C_WebUnresolvedObject //    Handle to the host (cWebApp / cLocalWebControlHost)
17623>>>>>>>    End_Procedure
17624>>>>>>>
17624>>>>>>>    
17624>>>>>>>    // Analyses a partial object name of a cWebObject and returns the corresponding object handle.
17624>>>>>>>    // - The object name must be in the long name format, e.g. oCustomerView.oSaveButton
17624>>>>>>>    // - The object name must be a child of the global cWebApp object (note, this might also
17624>>>>>>>    //   be a child of a cWebView that is itself a child of the cWebApp).
17624>>>>>>>    // - The name of the cWebApp object is ommitted from the passed object name,
17624>>>>>>>    //   e.g. a reference "oCustomerView.oSaveButton" indicates a reference to oSaveButton
17624>>>>>>>    //   that is a child of oCustomerView that is a child of the object referenced by ghoWebApp.
17624>>>>>>>    // - If an empty string is passed as the object name, then that is considered a reference
17624>>>>>>>    //   to ghoWebApp.
17624>>>>>>>    // - Only objects that understand the cWebControl_mixin interface can be found.
17624>>>>>>>    // - If the object name cannot be resolved then this function returns C_WebUnresolvedObject.
17624>>>>>>>    Function FindWebObject String sObjectLongName Boolean bOptErr Returns Handle
17626>>>>>>>        String sContainer sDynamicObjectId
17626>>>>>>>        Integer iIndex
17626>>>>>>>        Handle hoControl hoContainer
17626>>>>>>>        tWebControlMapItem[] aItems
17626>>>>>>>        tWebControlMapItem[] aItems
17627>>>>>>>        tWebControlMapItem searchItem
17627>>>>>>>        tWebControlMapItem searchItem
17627>>>>>>>        
17627>>>>>>>        // First test for the global cWebApp object
17627>>>>>>>        If (sObjectLongName = "") Begin
17629>>>>>>>            Function_Return (phoWebHost(Self))
17630>>>>>>>        End
17630>>>>>>>>
17630>>>>>>>        
17630>>>>>>>        // Dynamic objects use a $ character to display the separation
17630>>>>>>>        // between the "static" container and its dynamic content.
17630>>>>>>>        If (sObjectLongName contains "$") Begin
17632>>>>>>>            Move (Pos("$", sObjectLongName)) to iIndex
17633>>>>>>>            Move (Left(sObjectLongName, iIndex - 1)) to sContainer
17634>>>>>>>            Move (Right(sObjectLongName, (Length(sObjectLongName) - iIndex))) to sDynamicObjectId
17635>>>>>>>            
17635>>>>>>>            // Find the container of the dynamic object
17635>>>>>>>            If (num_arguments > 1) ;                Get FindWebObject sContainer bOptErr to hoContainer
17638>>>>>>>            Else ;                Get FindWebObject sContainer to hoContainer
17640>>>>>>>            
17640>>>>>>>            // Redirect query to container      
17640>>>>>>>            Get OwnerFindWebObject of hoContainer sDynamicObjectId to hoControl
17641>>>>>>>
17641>>>>>>>            Function_Return hoControl
17642>>>>>>>        End
17642>>>>>>>>
17642>>>>>>>        
17642>>>>>>>        Get paWebControls to aItems
17643>>>>>>>        Move sObjectLongName to searchItem.sName
17644>>>>>>>        Move (BinarySearchArray(searchItem, aItems, False)) to iIndex
17645>>>>>>>        
17645>>>>>>>        If (iIndex = -1) Begin
17647>>>>>>>            Function_Return C_WebUnresolvedObject
17648>>>>>>>        End
17648>>>>>>>>
17648>>>>>>>        Else Begin
17649>>>>>>>            Function_Return (aItems[iIndex].hoObj)
17650>>>>>>>        End
17650>>>>>>>>
17650>>>>>>>    End_Function
17651>>>>>>>    
17651>>>>>>>    
17651>>>>>>>    //  Searches the requested webobject and checks if it is a valid webapp View.
17651>>>>>>>    //  Note: Self is also considered a valid target.
17651>>>>>>>    //
17651>>>>>>>    //  Returns:
17651>>>>>>>    //      Handle to the webapp view (C_WebUnresolvedObject if not a valid Ajax view)
17651>>>>>>>    //
17651>>>>>>>    Function GetAjaxWebAppView String sView Returns Handle
17653>>>>>>>        Function_Return (FindWebObject(Self, sView))
17654>>>>>>>    End_Function

29685>>>>>>>>>        
29685>>>>>>>>>        Get paDownloadFolders to aFolders
29686>>>>>>>>>        
29686>>>>>>>>>        //  Convert relative paths into a full path and lowercase for comparison
29686>>>>>>>>>        Get FullPathName sPath to sPath
29687>>>>>>>>>        Move (Lowercase(sPath)) to sPath
29688>>>>>>>>>        
29688>>>>>>>>>        //  Add trailing "\" to prevent "Picture" sharing also "Pictures" mistake
29688>>>>>>>>>        If (Right(sPath, 1) <> "\") Begin
29690>>>>>>>>>            Move (sPath + "\") to sPath
29691>>>>>>>>>        End
29691>>>>>>>>>>
29691>>>>>>>>>        
29691>>>>>>>>>        //  Prevent duplicates
29691>>>>>>>>>        If (SearchArray(sPath, aFolders) >= 0) Begin
29693>>>>>>>>>            Procedure_Return 
29694>>>>>>>>>        End
29694>>>>>>>>>>
29694>>>>>>>>>        
29694>>>>>>>>>        //  Add path
29694>>>>>>>>>        Move sPath to aFolders[SizeOfArray(aFolders)]
29695>>>>>>>>>        Set paDownloadFolders to aFolders
29696>>>>>>>>>    End_Procedure

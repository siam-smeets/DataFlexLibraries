32151>>>>>>>>>
32151>>>>>>>>>// Models a client-side combo control with label support
32151>>>>>>>>>
32151>>>>>>>>>Class cWebCombo is a cWebBaseDEO
32152>>>>>>>>>    
32152>>>>>>>>>    Procedure Construct_Object
32154>>>>>>>>>        Forward Send Construct_Object
32156>>>>>>>>>        
32156>>>>>>>>>        Property Integer peSortItems csUnsorted     // Determines the sort order of the combo items. Note that changes to this property value at runtime only apply when refilling the combo.
32159>>>>>>>>>
32159>>>>>>>>>        Property RowID[] private_paRowIDs
32160>>>>>>>>>        Property tWebComboItem[] paComboItems
32161>>>>>>>>>        
32161>>>>>>>>>        Property Boolean pbAddEmptyItem True
32162>>>>>>>>>        Property String psEmptyItemDescription ""
32163>>>>>>>>>        
32163>>>>>>>>>        Set psJSClass to "df.WebCombo"
32164>>>>>>>>>    End_Procedure
32165>>>>>>>>>    
32165>>>>>>>>>    
32165>>>>>>>>>    // Adds a new combo item to the combo list. Use this in the OnFill event.
32165>>>>>>>>>    //
32165>>>>>>>>>    // Note: If you are adding many combo items then it is more efficient/faster to
32165>>>>>>>>>    // manually populate the combo items array directly in OnFill.
32165>>>>>>>>>    Procedure AddComboItem String sValue String sDescription
32167>>>>>>>>>        Integer iCount
32167>>>>>>>>>        tWebComboItem[] aComboItems
32167>>>>>>>>>        tWebComboItem[] aComboItems
32168>>>>>>>>>        
32168>>>>>>>>>        Get paComboItems to aComboItems
32169>>>>>>>>>        Move (SizeOfArray(aComboItems)) to iCount
32170>>>>>>>>>        Move sValue to aComboItems[iCount].sValue
32171>>>>>>>>>        Move sDescription to aComboItems[iCount].sDescription
32172>>>>>>>>>        Set paComboItems to aComboItems
32173>>>>>>>>>    End_Procedure
32174>>>>>>>>>
32174>>>>>>>>>
32174>>>>>>>>>    // Private: Sent by DDO when populating the combo list.
32174>>>>>>>>>    Procedure ComboFillItem Integer iItem String sValue String sDescription Integer iFile RowID riId
32176>>>>>>>>>        Integer iCount
32176>>>>>>>>>        RowID[] aRowIDs
32177>>>>>>>>>        // Review: This technique is called for every member of the combo list. This causes an array resize for two array properties for each combo item added! It would be better to add all of the combo items in a single loop
32177>>>>>>>>>        If (sDescription = '') Begin
32179>>>>>>>>>            Move sValue to sDescription
32180>>>>>>>>>        End
32180>>>>>>>>>>
32180>>>>>>>>>        Send AddComboItem sValue sDescription
32181>>>>>>>>>        
32181>>>>>>>>>        // Add the row IDs....
32181>>>>>>>>>        Get private_paRowIDs to aRowIDs
32182>>>>>>>>>        Move (SizeOfArray(aRowIDs)) to iCount
32183>>>>>>>>>        Move riId to aRowIDs[iCount]
32184>>>>>>>>>        Set private_paRowIDs to aRowIDs
32185>>>>>>>>>    End_Procedure
32186>>>>>>>>>    
32186>>>>>>>>>    Procedure FillFromDDO
32188>>>>>>>>>        // Fills the combo list according to the data dictionary settings of the data binding. Normally sent during Attach_To_DDO
32188>>>>>>>>>        // but can be sent at other times
32188>>>>>>>>>        Integer iFile iField
32188>>>>>>>>>        Handle hoServer
32188>>>>>>>>>        Boolean bAddEmptyItem
32188>>>>>>>>>        tWebComboItem[] atEmpty
32188>>>>>>>>>        tWebComboItem[] atEmpty
32189>>>>>>>>>        String sEmptyItemDescription
32189>>>>>>>>>        
32189>>>>>>>>>        Get pbAddEmptyItem to bAddEmptyItem
32190>>>>>>>>>
32190>>>>>>>>>        Set paComboItems to atEmpty
32191>>>>>>>>>        Set private_paRowIDs to (ResizeArray(private_paRowIDs(Self),0))    // zero the row IDs array
32192>>>>>>>>>
32192>>>>>>>>>        Get Server to hoServer
32193>>>>>>>>>        Get Data_File  to iFile
32194>>>>>>>>>        Get Data_Field to iField
32195>>>>>>>>>
32195>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
32197>>>>>>>>>            //  Do security check
32197>>>>>>>>>            If (not(FillDEOAllowed(Self))) Begin
32199>>>>>>>>>                Procedure_Return
32200>>>>>>>>>            End
32200>>>>>>>>>>
32200>>>>>>>>>            
32200>>>>>>>>>            // if your DD does not have a default value you need to include an empty value. Even if you have a default
32200>>>>>>>>>            // it is fine to allow a blank line, which will probably fail upon validation (unless the DD allows blanks)
32200>>>>>>>>>            If (bAddEmptyItem) Begin
32202>>>>>>>>>                Get psEmptyItemDescription to sEmptyItemDescription
32203>>>>>>>>>                Send ComboFillItem 0 "" sEmptyItemDescription 0 (NullRowID()) 
32204>>>>>>>>>            End
32204>>>>>>>>>>
32204>>>>>>>>>            
32204>>>>>>>>>            Send File_Field_Fill_List to hoServer iFile iField Self msg_ComboFillItem
32205>>>>>>>>>        End
32205>>>>>>>>>>
32205>>>>>>>>>    End_Procedure
32206>>>>>>>>>    
32206>>>>>>>>>    
32206>>>>>>>>>    Procedure OnFill
32208>>>>>>>>>        // OnFill event stub. Fired whenever the combo list is to be filled.
32208>>>>>>>>>    End_Procedure
32209>>>>>>>>>    
32209>>>>>>>>>    
32209>>>>>>>>>    // Send this to trigger OnFill event to populate the combo list.
32209>>>>>>>>>    // Note: we wanted to call this method "Fill" but this symbol is already used in FMAC
32209>>>>>>>>>    //       which means we cannot register it using WebPublishMethod
32209>>>>>>>>>    Procedure Refill
32211>>>>>>>>>        String[] aParams
32212>>>>>>>>>        tWebComboItem[] aEmptyItems aItems
32212>>>>>>>>>        tWebComboItem[] aEmptyItems aItems
32214>>>>>>>>>        
32214>>>>>>>>>        Send FillFromDDO
32215>>>>>>>>>        Send OnFill                // trigger user event to populate paComboItems
32216>>>>>>>>>        
32216>>>>>>>>>        // Send paComboItems to the client....
32216>>>>>>>>>        Get ComboData to aItems
32217>>>>>>>>>        Send ClientAction "fill" aParams aItems       
32218>>>>>>>>>    End_Procedure
32219>>>>>>>>>    
32219>>>>>>>>>    
32219>>>>>>>>>    // Returns the combo list as an array of tWebRow structs where the first value is the value and 
32219>>>>>>>>>    // the second is the description.
32219>>>>>>>>>    Function ComboData Returns tWebComboItem[]
32221>>>>>>>>>        tWebComboItem[] aComboItems
32221>>>>>>>>>        tWebComboItem[] aComboItems
32222>>>>>>>>>        
32222>>>>>>>>>        // Iterate the combo items....
32222>>>>>>>>>        Get paComboItems to aComboItems
32223>>>>>>>>>        
32223>>>>>>>>>        Function_Return aComboItems
32224>>>>>>>>>    End_Function
32225>>>>>>>>>    
32225>>>>>>>>>    //  Augmented to fixate psMask
32225>>>>>>>>>    Procedure AfterAttachDDO
32227>>>>>>>>>        Forward Send AfterAttachDDO
32229>>>>>>>>>        
32229>>>>>>>>>        //  No masking should be done on a cWebCombo
32229>>>>>>>>>        Set psMask to ""
32230>>>>>>>>>    End_Procedure
32231>>>>>>>>>
32231>>>>>>>>>    // Augmented to trigger a Refill of the combo list.
32231>>>>>>>>>    Procedure PreSerializeObject
32233>>>>>>>>>        Send Refill
32234>>>>>>>>>    End_Procedure

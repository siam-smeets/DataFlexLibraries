31395>>>>>>>>>        // text for our error message. This capability is a standard part
31395>>>>>>>>>        // of VDF5
31395>>>>>>>>>        If ghoErrorSource Begin
31397>>>>>>>>>            // These messages were just added to the DD.
31397>>>>>>>>>            Get Extended_Error_file   of ghoErrorSource to iErrFile
31398>>>>>>>>>            Get Extended_Error_Field  of ghoErrorSource to iErrField
31399>>>>>>>>>            // we are making the assumption that ghoErrorSource is a DD object
31399>>>>>>>>>            // If it is not, we will have problems.....but it will be!
31399>>>>>>>>>            If (iErrFile>0) Begin
31401>>>>>>>>>                Get_Attribute DF_FILE_DISPLAY_NAME of iErrFile to sFile
31404>>>>>>>>>                If (iErrField>0) Begin
31406>>>>>>>>>                    Get File_Field_Label of ghoErrorSource iErrFile iErrField DD_LABEL_LONG to sLabel
31407>>>>>>>>>                    Move (SFormat(C_$FieldInDataFile,sLabel, sFile)) to sMess
31408>>>>>>>>>                End
31408>>>>>>>>>>
31408>>>>>>>>>                Else Begin
31409>>>>>>>>>                    Move (SFormat(C_$InDataFile,sFile)) to sMess
31410>>>>>>>>>                End
31410>>>>>>>>>>
31410>>>>>>>>>                Append sSystemErr "\n" sMess
31412>>>>>>>>>            End
31412>>>>>>>>>>
31412>>>>>>>>>        End
31412>>>>>>>>>>
31412>>>>>>>>>        
31412>>>>>>>>>        Move (SFormat(C_$VDFErrorInLine, iError, iLine)) to sDtl
31413>>>>>>>>>        If (iErrFile  > 0) ;            Move (sDtl * DD_FILE_TEXT  * String(iErrFile))  to sDtl
31416>>>>>>>>>        If (iErrField > 0) ;            Move (sDtl * DD_FIELD_TEXT * String(iErrField)) to sDtl
31419>>>>>>>>>        // full error is systemError + Error and line numbers
31419>>>>>>>>>        Move (sSystemErr + "\n" + sDtl) to sFullError
31420>>>>>>>>>        
31420>>>>>>>>>        // If 0, the COM object is not yet ready to be used. If an error occurs in this
31420>>>>>>>>>        // condition, we consider this error to always be fatal and will notify WebApp
31420>>>>>>>>>        // Server of this error via WebAppFatalError command
31420>>>>>>>>>        If (hoInetSession=0) Begin
31422>>>>>>>>>            
31422>>>>>>>>>            If bDebugging Begin
31424>>>>>>>>>                Send UnhandledErrorDisplay iLine sFullError
31425>>>>>>>>>            End
31425>>>>>>>>>>
31425>>>>>>>>>            Else Begin
31426>>>>>>>>>                CallStackDump sStack
31427>>>>>>>>>                WebAppFatalError (Replaces("\n", (sFullError + "\n\n" + sStack) , character(13)+character(10)))

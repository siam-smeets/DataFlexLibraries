12739>>>>>>>        Else ;            Error DFERR_XML_INTERNAL_ERROR (SFormat(C_$XmlMethodFailure, "msg_AddElement"))
12741>>>>>>>    End_Procedure
12742>>>>>>>    
12742>>>>>>>    // this returns the object, This is often needed
12742>>>>>>>    Function CreateElementNodeNS String sNameSpace String sTagName String sValue Returns Handle
12744>>>>>>>        Handle hoNewElement

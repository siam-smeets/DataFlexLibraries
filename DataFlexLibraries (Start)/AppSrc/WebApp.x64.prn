22245>>>>>>>>>>>>>>>    //
22245>>>>>>>>>>>>>>>    // Returns the value for non-scalar (advanced) web properties. These are stored separate from
22245>>>>>>>>>>>>>>>    // the scalar web properties. It looks for the 'synchronized' value in the gaAdvSyncProps store.
22245>>>>>>>>>>>>>>>    //
22245>>>>>>>>>>>>>>>    // Params:
22245>>>>>>>>>>>>>>>    //      hoObject  - Is handle to the object which ownes the property.
22245>>>>>>>>>>>>>>>    //      hmGetter  - Is a handle to the property's getter message.
22245>>>>>>>>>>>>>>>    //      sPropName - Is the (case sensitive) property name.
22245>>>>>>>>>>>>>>>    // Returns:
22245>>>>>>>>>>>>>>>    //      The property value as a variant.
22245>>>>>>>>>>>>>>>    //
22245>>>>>>>>>>>>>>>    // Use the WebGet command instead of sending this message directly. hoObject must belong to the
22245>>>>>>>>>>>>>>>    // set of 'scoped views' in the CallAction otherwise the web property value is considered
22245>>>>>>>>>>>>>>>    // to be "out of scope".
22245>>>>>>>>>>>>>>>    Function GetAdvSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns Variant
22247>>>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSize iStoreIndex
22247>>>>>>>>>>>>>>>        String sUC_PropName sReturnValue
22247>>>>>>>>>>>>>>>        Variant vReturnValue
22247>>>>>>>>>>>>>>>        Boolean bFoundProp bIsAjaxWebObject bIsObjectInScope
22247>>>>>>>>>>>>>>>            
22247>>>>>>>>>>>>>>>        // Test if we are active....
22247>>>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
22249>>>>>>>>>>>>>>>            // If not active then we just return the design time value of the property. This is
22249>>>>>>>>>>>>>>>            // safe because we can only get here when the WebApp is being initialized, before any
22249>>>>>>>>>>>>>>>            // clients have loaded the webapp....
22249>>>>>>>>>>>>>>>            Get pubProp.hmGetter of hoObject to vReturnValue
22250>>>>>>>>>>>>>>>            Function_Return vReturnValue
22251>>>>>>>>>>>>>>>        End
22251>>>>>>>>>>>>>>>>
22251>>>>>>>>>>>>>>>        
22251>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22252>>>>>>>>>>>>>>>    
22252>>>>>>>>>>>>>>>        Get FindAdvPropCache hoObject pubProp.sName to iProp
22253>>>>>>>>>>>>>>>        If (iProp = -1) Begin
22255>>>>>>>>>>>>>>>            //  Use the raw property
22255>>>>>>>>>>>>>>>            Get pubprop.hmGetter of hoObject to vReturnValue
22256>>>>>>>>>>>>>>>        End
22256>>>>>>>>>>>>>>>>
22256>>>>>>>>>>>>>>>        Else Begin
22257>>>>>>>>>>>>>>>            If (not(gaAdvSyncProps[iStoreIndex][iProp].bDeserialized)) Begin
22259>>>>>>>>>>>>>>>                //  Initialize our variant with an advanced value of the right type to make valuetreedeserialize work (!IMPORTANT)
22259>>>>>>>>>>>>>>>                Get pubProp.hmGetter of hoObject to vReturnValue
22260>>>>>>>>>>>>>>>                ValueTreeDeserializeParameter gaAdvSyncProps[iStoreIndex][iProp].tSyncProp.tV to vReturnValue
22261>>>>>>>>>>>>>>>                
22261>>>>>>>>>>>>>>>                Move vReturnValue to gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV
22262>>>>>>>>>>>>>>>                Move True to gaAdvSyncProps[iStoreIndex][iProp].bDeserialized
22263>>>>>>>>>>>>>>>            End
22263>>>>>>>>>>>>>>>>
22263>>>>>>>>>>>>>>>            Else Begin
22264>>>>>>>>>>>>>>>                Move gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV to vReturnValue
22265>>>>>>>>>>>>>>>            End
22265>>>>>>>>>>>>>>>>
22265>>>>>>>>>>>>>>>        End

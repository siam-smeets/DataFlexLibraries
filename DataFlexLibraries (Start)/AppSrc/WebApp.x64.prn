5456>>>>>>>
5456>>>>>>>    Procedure Set Add_System_File Integer iFile Integer iLock_Mode
5458>>>>>>>        // allow no arguments because the old message allowed this
5458>>>>>>>        If (Num_arguments=1) Begin
5460>>>>>>>            Send Add_System_File iFile
5461>>>>>>>        End
5461>>>>>>>>

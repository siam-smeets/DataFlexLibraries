19156>>>>>>>>>>>>>        Property String psColumnWidths ""     // String used column width, space separated Format should be "#COLNUM/#COLWIDTH(or "#fr")" e.g. "1/70 3/1fr 4/21 6/3fr"
19159>>>>>>>>>>>>>        Property String psDefaultColumnWidth "1fr" // Used to override the default column width when using gridlayout. Default is 1fr for an equal split of columns.
19162>>>>>>>>>>>>>        Property Integer piHeight 0           // height, in pixels, of the panel (0 = calculate height by size of content)
19165>>>>>>>>>>>>>        Property Integer piMinHeight 0        // Minimum control height (ignored unless pbFillHeight is True)

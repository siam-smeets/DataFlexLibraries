35753>>>>>>>    // Compares both the object name and the property name of advanced sync props
35753>>>>>>>    Function CompareAdvProp tWebAdvSyncProp tSyncProp1 tWebAdvSyncProp tSyncProp2 Returns Integer
35755>>>>>>>        If (Uppercase(tSyncProp1.sO) > Uppercase(tSyncProp2.sO)) ;            Function_Return (GT)
35758>>>>>>>        If (Uppercase(tSyncProp1.sO) < Uppercase(tSyncProp2.sO)) ;            Function_Return (LT)
35761>>>>>>>        
35761>>>>>>>        If (Uppercase(tSyncProp1.sP) > Uppercase(tSyncProp2.sP)) ;            Function_Return (GT)
35764>>>>>>>        If (Uppercase(tSyncProp1.sP) < Uppercase(tSyncProp2.sP)) ;            Function_Return (LT)
35767>>>>>>>        
35767>>>>>>>        Function_Return (EQ)
35768>>>>>>>    End_Function
35769>>>>>>>    
35769>>>>>>>    // Compares the property names of two advanced syncprops
35769>>>>>>>    Function CompareAdvPropNames tWebAdvSyncProp tSyncProp1 tWebAdvSyncProp tSyncProp2 Returns Integer
35771>>>>>>>        If (Uppercase(tSyncProp1.sP) > Uppercase(tSyncProp2.sP)) ;            Function_Return (GT)
35774>>>>>>>        If (Uppercase(tSyncProp1.sP) < Uppercase(tSyncProp2.sP)) ;            Function_Return (LT)
35777>>>>>>>        
35777>>>>>>>        Function_Return (EQ)
35778>>>>>>>    End_Function
35779>>>>>>>    
35779>>>>>>>    // Compares object name and property name of a queued syncprop
35779>>>>>>>    Function CompareQueuedSyncProps tQueuedSyncProp tProp1 tQueuedSyncProp tProp2 Returns Integer
35781>>>>>>>        If (Uppercase(tProp1.sO) = Uppercase(tProp2.sO)) Begin
35783>>>>>>>            If (Uppercase(tProp1.sP) = Uppercase(tProp2.sP)) Begin
35785>>>>>>>                Function_Return (EQ)
35786>>>>>>>            End
35786>>>>>>>>
35786>>>>>>>        End
35786>>>>>>>>
35786>>>>>>>    End_Function
35787>>>>>>>    
35787>>>>>>>    // Completely clears and resets the container.
35787>>>>>>>    Procedure ResetContainer
35789>>>>>>>        String[]                aEmptyStringArray
35790>>>>>>>        tWebDynamicRadioGroup[] aEmptyRadioGroupArray
35790>>>>>>>        tWebDynamicRadioGroup[] aEmptyRadioGroupArray
35791>>>>>>>        tWebDynamicObject[]     aEmptyDynamicObjects
35791>>>>>>>        tWebDynamicObject[]     aEmptyDynamicObjects
35792>>>>>>>        tQueuedSyncProp[]       aEmptyQueuedSyncPropsArray
35792>>>>>>>        tQueuedSyncProp[]       aEmptyQueuedSyncPropsArray
35793>>>>>>>        tWebSyncPropsWrapper    tSyncPropsWrapper
35793>>>>>>>        tWebSyncPropsWrapper    tSyncPropsWrapper
35793>>>>>>>        tWebAdvSyncPropsWrapper tAdvSyncPropsWrapper 
35793>>>>>>>        tWebAdvSyncPropsWrapper tAdvSyncPropsWrapper 
35793>>>>>>>        
35793>>>>>>>        Send DestroyLocalObjects
35794>>>>>>>        
35794>>>>>>>        WebSet paDynamicObjects    to aEmptyDynamicObjects
35795>>>>>>>        WebSet paSyncPropsQueue    to aEmptyQueuedSyncPropsArray
35796>>>>>>>        WebSet paRadioGroupNames   to aEmptyStringArray
35797>>>>>>>        WebSet paRadioGroups       to aEmptyRadioGroupArray
35798>>>>>>>        WebSet paRadioConnectQueue to aEmptyStringArray
35799>>>>>>>        WebSet pbActivated         to False
35800>>>>>>>          
35800>>>>>>>        Move True to tSyncPropsWrapper.bReset
35801>>>>>>>        WebSet ptSyncPropsWrapper to tSyncPropsWrapper
35802>>>>>>>        WebSet ptSyncServerPropsWrapper to tSyncPropsWrapper
35803>>>>>>>        WebSet ptSyncServerSessionPropsWrapper to tSyncPropsWrapper
35804>>>>>>>        
35804>>>>>>>        Move True to tAdvSyncPropsWrapper.bReset
35805>>>>>>>        WebSet ptAdvSyncPropsWrapper to tAdvSyncPropsWrapper
35806>>>>>>>        WebSet ptAdvServerSyncPropsWrapper to tAdvSyncPropsWrapper
35807>>>>>>>        WebSet ptAdvServerSessionSyncPropsWrapper to tAdvSyncPropsWrapper
35808>>>>>>>        
35808>>>>>>>        Send ClientAction "resetContainer"
35809>>>>>>>    End_Procedure
35810>>>>>>>      
35810>>>>>>>    
35810>>>>>>>    // ====================
35810>>>>>>>    // CLIENT COMMUNICATION
35810>>>>>>>    // ====================
35810>>>>>>>    
35810>>>>>>>    // Adds a client action to the queue of client actions. Used to keep track
35810>>>>>>>    // of client actions that are executed before the objects actually 
35810>>>>>>>    // exist on the client.
35810>>>>>>>    Procedure AddClientAction tWebClientAction tClientAction
35812>>>>>>>        String sName
35812>>>>>>>        Integer iIndex
35812>>>>>>>        tWebDynamicObject tDynamicObject
35812>>>>>>>        tWebDynamicObject tDynamicObject
35812>>>>>>>        tWebDynamicObject[] aDynamicObjects
35812>>>>>>>        tWebDynamicObject[] aDynamicObjects
35813>>>>>>>        tWebClientAction[] aClientActionsQueue 
35813>>>>>>>        tWebClientAction[] aClientActionsQueue 
35814>>>>>>>        
35814>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35815>>>>>>>        
35815>>>>>>>        // This simply removes parentage from the name of the object
35815>>>>>>>        Get TruncateName tClientAction.sTarget to tDynamicObject.sId
35816>>>>>>>        
35816>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35817>>>>>>>        If (iIndex <> -1) Begin
35819>>>>>>>            If (aDynamicObjects[iIndex].bRendered) Begin
35821>>>>>>>                Send AddClientAction of (Owner(Self)) tClientAction
35822>>>>>>>            End 
35822>>>>>>>>
35822>>>>>>>            Else Begin
35823>>>>>>>                Get paClientActionsQueue to aClientActionsQueue 
35824>>>>>>>                Move tClientAction to aClientActionsQueue[SizeOfArray(aClientActionsQueue)]
35825>>>>>>>                Set paClientActionsQueue to aClientActionsQueue
35826>>>>>>>            End
35826>>>>>>>>
35826>>>>>>>        End
35826>>>>>>>>
35826>>>>>>>        Else Begin
35827>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, tDynamicObject.sId))
35828>>>>>>>>
35828>>>>>>>        End
35828>>>>>>>>
35828>>>>>>>    End_Procedure
35829>>>>>>>    
35829>>>>>>>    // Cancels a client action that was scheduled.
35829>>>>>>>    // tClientAction    - Is the action to be executed
35829>>>>>>>    Procedure OwnerCancelClientAction Handle hoWO String sName
35831>>>>>>>        Integer iIndex
35831>>>>>>>        Boolean bRendered
35831>>>>>>>        tWebDynamicObject tDynamicObject
35831>>>>>>>        tWebDynamicObject tDynamicObject
35831>>>>>>>        tWebDynamicObject[] aDynamicObjects
35831>>>>>>>        tWebDynamicObject[] aDynamicObjects
35832>>>>>>>        tWebClientAction[] aClientActionsQueue
35832>>>>>>>        tWebClientAction[] aClientActionsQueue
35833>>>>>>>        String sFullName
35833>>>>>>>        
35833>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35834>>>>>>>        
35834>>>>>>>        // This simply removes parentage from the name of the object
35834>>>>>>>        Get WebObjectName of hoWO to sFullName
35835>>>>>>>        Get TruncateName sFullName to tDynamicObject.sId
35836>>>>>>>        
35836>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35837>>>>>>>        If (iIndex <> -1) Begin
35839>>>>>>>            Move aDynamicObjects[iIndex].bRendered to bRendered
35840>>>>>>>            
35840>>>>>>>            If (bRendered) Begin
35842>>>>>>>                Send OwnerCancelClientAction of (Owner(Self)) hoWO sName
35843>>>>>>>            End 
35843>>>>>>>>
35843>>>>>>>            Else Begin
35844>>>>>>>                Get paClientActionsQueue to aClientActionsQueue 
35845>>>>>>>                For iIndex from 0 to (SizeOfArray(aClientActionsQueue) - 1)
35851>>>>>>>>
35851>>>>>>>                    If (aClientActionsQueue[iIndex].sTarget = sFullName and aClientActionsQueue[iIndex].sName = sName) Begin
35853>>>>>>>                        Move (RemoveFromArray(aClientActionsQueue, iIndex)) to aClientActionsQueue
35854>>>>>>>                        Decrement iIndex
35855>>>>>>>                    End
35855>>>>>>>>
35855>>>>>>>                Loop
35856>>>>>>>>
35856>>>>>>>                Set paClientActionsQueue to aClientActionsQueue
35857>>>>>>>                
35857>>>>>>>                
35857>>>>>>>            End
35857>>>>>>>>
35857>>>>>>>        End
35857>>>>>>>>
35857>>>>>>>    End_Procedure
35858>>>>>>>    
35858>>>>>>>    
35858>>>>>>>    // Signals that the dynamic objects of this container have been loaded.
35858>>>>>>>    // Sends all queued client actions to the client to be executed ands
35858>>>>>>>    // marks all dynamic objects as being rendered.
35858>>>>>>>    Procedure FinishRendering String[] aObjects
35860>>>>>>>        Integer icObjects iObject iObjectIndex
35860>>>>>>>        tWebDynamicObject tDynamicObject
35860>>>>>>>        tWebDynamicObject tDynamicObject
35860>>>>>>>        tWebDynamicObject[] aDynamicObjects
35860>>>>>>>        tWebDynamicObject[] aDynamicObjects
35861>>>>>>>        tWebClientAction[] aClientActions aClientActionsQueue
35861>>>>>>>        tWebClientAction[] aClientActions aClientActionsQueue
35863>>>>>>>        
35863>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35864>>>>>>>        
35864>>>>>>>        Get paClientActions of (Host(Self)) to aClientActions
35865>>>>>>>        Get paClientActionsQueue to aClientActionsQueue
35866>>>>>>>        Move (AppendArray(aClientActions, aClientActionsQueue)) to aClientActions
35867>>>>>>>        Set paClientActions of (Host(Self)) to aClientActions
35868>>>>>>>        
35868>>>>>>>        Move (ResizeArray(aClientActionsQueue, 0)) to aClientActionsQueue
35869>>>>>>>        Set paClientActionsQueue to aClientActionsQueue
35870>>>>>>>        
35870>>>>>>>        Move (SizeOfArray(aObjects)) to icObjects
35871>>>>>>>        For iObject from 0 to (icObjects - 1)
35877>>>>>>>>
35877>>>>>>>            Send SetRendered aObjects[iObject] True (&aDynamicObjects) True
35878>>>>>>>        Loop
35879>>>>>>>>
35879>>>>>>>        
35879>>>>>>>        WebSet paDynamicObjects to aDynamicObjects
35880>>>>>>>        WebSet pbActivated to True
35881>>>>>>>    End_Procedure
35882>>>>>>>    
35882>>>>>>>    
35882>>>>>>>    // =====================================
35882>>>>>>>    // DYNAMIC OBJECT CREATION & DESTRUCTION
35882>>>>>>>    // =====================================
35882>>>>>>>    
35882>>>>>>>    // Registers a dynamic object
35882>>>>>>>    Function CreateDynamicObject Integer iClassId String sDynamicObjectId String sParentId Returns Handle
35884>>>>>>>        Integer iIndex
35884>>>>>>>        Handle hoObj
35884>>>>>>>        tWebDynamicObject tDynamicObject
35884>>>>>>>        tWebDynamicObject tDynamicObject
35884>>>>>>>        tWebDynamicObject[] aDynamicObjects  
35884>>>>>>>        tWebDynamicObject[] aDynamicObjects  
35885>>>>>>>        
35885>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35886>>>>>>>
35886>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
35887>>>>>>>
35887>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35888>>>>>>>        If (iIndex = -1) Begin                 
35890>>>>>>>            // Dynamic object has not been registered before, so append it  
35890>>>>>>>            Move (BinarySearchInsertPos()) to iIndex 
35891>>>>>>>            
35891>>>>>>>            //  Check for illegal characters in the id
35891>>>>>>>            If (Pos("#", sDynamicObjectId) > 0 or Pos("$", sDynamicObjectId) > 0) Begin
35893>>>>>>>                Error DFERR_PROGRAM (SFormat("# and $ characters are not allowed in sDynamicObjectId ('%1').", sDynamicObjectId))
35894>>>>>>>>
35894>>>>>>>                Function_Return C_WebUnresolvedObject 
35895>>>>>>>            End
35895>>>>>>>>
35895>>>>>>>            
35895>>>>>>>            Move sParentId to tDynamicObject.sParentId
35896>>>>>>>            Move iClassId to tDynamicObject.iClassId
35897>>>>>>>            Move False to tDynamicObject.bRendered
35898>>>>>>>            
35898>>>>>>>            Move (InsertInArray(aDynamicObjects, iIndex, tDynamicObject)) to aDynamicObjects
35899>>>>>>>            
35899>>>>>>>            WebSet paDynamicObjects to aDynamicObjects
35900>>>>>>>            
35900>>>>>>>            // Create the object
35900>>>>>>>            Set pbIsCreating to True
35901>>>>>>>            Get CreateLocal sDynamicObjectId to hoObj
35902>>>>>>>            Set pbIsCreating to False
35903>>>>>>>            
35903>>>>>>>            // Insert object at end of parent's child structure
35903>>>>>>>            Send AppendToSiblings sDynamicObjectId
35904>>>>>>>        End        
35904>>>>>>>>
35904>>>>>>>        Else Begin
35905>>>>>>>            // Object has been registered before, so throw an error
35905>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectAlreadyExists, sDynamicObjectId))
35906>>>>>>>>
35906>>>>>>>        End
35906>>>>>>>>
35906>>>>>>>        
35906>>>>>>>        Function_Return hoObj
35907>>>>>>>    End_Function
35908>>>>>>>    
35908>>>>>>>    
35908>>>>>>>    // Moves a dynamic object to a different location, after another specified dynamic object.
35908>>>>>>>    Procedure MoveDynamicObject String sDynamicObjectId String sInsertAfter
35910>>>>>>>        String sParentId sName
35910>>>>>>>        String[] aParams aChildren
35912>>>>>>>        Integer iIndex iRemoveIndex iInsertIndex
35912>>>>>>>        Boolean bSendCommand
35912>>>>>>>        Handle hoObj
35912>>>>>>>        tWebDynamicObject tDynamicObject
35912>>>>>>>        tWebDynamicObject tDynamicObject
35912>>>>>>>        tWebDynamicObject[] aDynamicObjects
35912>>>>>>>        tWebDynamicObject[] aDynamicObjects
35913>>>>>>>        
35913>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35914>>>>>>>        
35914>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
35915>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35916>>>>>>>        If (iIndex <> -1) Begin
35918>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
35919>>>>>>>            Move sParentId to tDynamicObject.sId
35920>>>>>>>            
35920>>>>>>>            // Remove child from old location
35920>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35921>>>>>>>            If (iIndex <> -1) Begin
35923>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
35924>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
35925>>>>>>>            End  
35925>>>>>>>>
35925>>>>>>>            
35925>>>>>>>            // Insert child at new location
35925>>>>>>>            Move sInsertAfter to tDynamicObject.sId
35926>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35927>>>>>>>            If (iIndex <> -1) Begin
35929>>>>>>>                Move aDynamicObjects[iIndex].sParentId to sParentId
35930>>>>>>>                
35930>>>>>>>                // Find new parent
35930>>>>>>>                Move sParentId to tDynamicObject.sId
35931>>>>>>>                Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35932>>>>>>>                If (iIndex <> -1) Begin
35934>>>>>>>                    Move (SearchArray(sInsertAfter, aDynamicObjects[iIndex].aChildren)) to iInsertIndex
35935>>>>>>>                    If (iInsertIndex <> -1) Begin
35937>>>>>>>                        Move aDynamicObjects[iIndex].aChildren to aChildren
35938>>>>>>>                        
35938>>>>>>>                        // Insert object afer sInsertAfter
35938>>>>>>>                        Move (InsertInArray(aChildren, iInsertIndex + 1, sDynamicObjectId)) to aChildren
35939>>>>>>>                        Move aChildren to aDynamicObjects[iIndex].aChildren
35940>>>>>>>                        WebSet paDynamicObjects to aDynamicObjects
35941>>>>>>>                        
35941>>>>>>>                        Move True to bSendCommand
35942>>>>>>>                    End
35942>>>>>>>>
35942>>>>>>>                End
35942>>>>>>>>
35942>>>>>>>            End
35942>>>>>>>>
35942>>>>>>>        End
35942>>>>>>>>
35942>>>>>>>        
35942>>>>>>>        If (bSendCommand) Begin
35944>>>>>>>            Send ConnectRadioButtons
35945>>>>>>>            
35945>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
35946>>>>>>>            Get WebObjectName of hoObj to sName
35947>>>>>>>            
35947>>>>>>>            Move sName to aParams[0]
35948>>>>>>>            
35948>>>>>>>            Get DynamicObject sInsertAfter to hoObj
35949>>>>>>>            Get WebObjectName of hoObj to sName
35950>>>>>>>            
35950>>>>>>>            Move sName to aParams[1]
35951>>>>>>>            
35951>>>>>>>            Send ClientAction "moveDynamicObject" aParams
35952>>>>>>>        End
35952>>>>>>>>
35952>>>>>>>    End_Procedure
35953>>>>>>>    
35953>>>>>>>    
35953>>>>>>>    // Moves a dynamic object to a specific index in a new parent's list of children.
35953>>>>>>>    Procedure MoveDynamicObjectToIndex String sDynamicObjectId String sParentId Integer iInsertIndex
35955>>>>>>>        String sName
35955>>>>>>>        String[] aParams aChildren
35957>>>>>>>        Integer iIndex iRemoveIndex
35957>>>>>>>        Boolean bSendCommand
35957>>>>>>>        Handle hoObj
35957>>>>>>>        tWebDynamicObject tDynamicObject
35957>>>>>>>        tWebDynamicObject tDynamicObject
35957>>>>>>>        tWebDynamicObject[] aDynamicObjects
35957>>>>>>>        tWebDynamicObject[] aDynamicObjects
35958>>>>>>>        
35958>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35959>>>>>>>        
35959>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
35960>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35961>>>>>>>        If (iIndex <> -1) Begin
35963>>>>>>>            Move aDynamicObjects[iIndex].sParentId to tDynamicObject.sId
35964>>>>>>>            
35964>>>>>>>            // Remove child from old location
35964>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35965>>>>>>>            If (iIndex <> -1) Begin
35967>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
35968>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
35969>>>>>>>            End  
35969>>>>>>>>
35969>>>>>>>                
35969>>>>>>>            // Find new parent
35969>>>>>>>            Move sParentId to tDynamicObject.sId
35970>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35971>>>>>>>            If (iIndex <> -1) Begin
35973>>>>>>>                Move aDynamicObjects[iIndex].aChildren to aChildren
35974>>>>>>>                
35974>>>>>>>                // Insert object afer sInsertAfter
35974>>>>>>>                Move (InsertInArray(aChildren, iInsertIndex, sDynamicObjectId)) to aChildren
35975>>>>>>>                Move aChildren to aDynamicObjects[iIndex].aChildren
35976>>>>>>>                WebSet paDynamicObjects to aDynamicObjects
35977>>>>>>>                
35977>>>>>>>                Move True to bSendCommand
35978>>>>>>>            End
35978>>>>>>>>
35978>>>>>>>        End
35978>>>>>>>>
35978>>>>>>>        
35978>>>>>>>        If (bSendCommand) Begin
35980>>>>>>>            Send ConnectRadioButtons
35981>>>>>>>            
35981>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
35982>>>>>>>            Get WebObjectName of hoObj to sName
35983>>>>>>>            Move sName to aParams[0] 
35984>>>>>>>            
35984>>>>>>>            Get DynamicObject sParentId to hoObj
35985>>>>>>>            Get WebObjectName of hoObj to sName
35986>>>>>>>            Move sName to aParams[1] 
35987>>>>>>>
35987>>>>>>>            Move iInsertIndex to aParams[2]
35988>>>>>>>            
35988>>>>>>>            Send ClientAction "moveDynamicObjectToIndex" aParams
35989>>>>>>>        End 
35989>>>>>>>>
35989>>>>>>>    End_Procedure
35990>>>>>>>    
35990>>>>>>>    
35990>>>>>>>    // Inserts a dynamic object after the given object. The inserted 
35990>>>>>>>    // object inherits the parent of the object it is inserted after.
35990>>>>>>>    Procedure InsertDynamicObject String sDynamicObjectId String sInsertAfter
35992>>>>>>>        String sParentId
35992>>>>>>>        String[] aParams aChildren aEmptyArray aObjects
35996>>>>>>>        Integer iIndex iInsertIndex iRemoveIndex
35996>>>>>>>        Boolean bSendCommand
35996>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
35996>>>>>>>        tWebDynamicObject tDynamicObject
35996>>>>>>>        tWebDynamicObject tDynamicObject
35996>>>>>>>        tWebDynamicObject[] aDynamicObjects
35996>>>>>>>        tWebDynamicObject[] aDynamicObjects
35997>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
35997>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
35998>>>>>>>        
35998>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35999>>>>>>>        
35999>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36000>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36001>>>>>>>        If (iIndex <> -1) Begin
36003>>>>>>>            // Retrieve parent
36003>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36004>>>>>>>            
36004>>>>>>>            // Find parent object
36004>>>>>>>            Move sParentId to tDynamicObject.sId
36005>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36006>>>>>>>            If (iIndex <> -1) Begin
36008>>>>>>>                
36008>>>>>>>                // Remove previously appended object (in CreateDynamicObject)
36008>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36009>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
36010>>>>>>>                
36010>>>>>>>                Move (SearchArray(sInsertAfter, aDynamicObjects[iIndex].aChildren)) to iInsertIndex
36011>>>>>>>                If (iInsertIndex <> -1) Begin
36013>>>>>>>                    Move aDynamicObjects[iIndex].aChildren to aChildren
36014>>>>>>>                    
36014>>>>>>>                    // Insert object afer sInsertAfter
36014>>>>>>>                    Move (InsertInArray(aChildren, iInsertIndex + 1, sDynamicObjectId)) to aChildren
36015>>>>>>>                    Move aChildren to aDynamicObjects[iIndex].aChildren
36016>>>>>>>                    WebSet paDynamicObjects to aDynamicObjects
36017>>>>>>>                    
36017>>>>>>>                    Move True to bSendCommand
36018>>>>>>>                End
36018>>>>>>>>
36018>>>>>>>            End
36018>>>>>>>>
36018>>>>>>>            Else Begin
36019>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$DynamicParentNotFound, sParentId))
36020>>>>>>>>
36020>>>>>>>            End
36020>>>>>>>>
36020>>>>>>>        End
36020>>>>>>>>
36020>>>>>>>        Else Begin
36021>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$CannotInsertDynamic, sInsertAfter))
36022>>>>>>>>
36022>>>>>>>        End
36022>>>>>>>>
36022>>>>>>>        
36022>>>>>>>        // Finally, send an insert command to the client
36022>>>>>>>        If (bSendCommand) Begin
36024>>>>>>>            Send ConnectRadioButtons
36025>>>>>>>            
36025>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36026>>>>>>>            Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36027>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36028>>>>>>>            
36028>>>>>>>            Get DynamicObject sParentId to hoObj
36029>>>>>>>            Get WebObjectName of hoObj to sParentId
36030>>>>>>>            
36030>>>>>>>            // Convert queued sync props to JSON
36030>>>>>>>            Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36031>>>>>>>            Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36032>>>>>>>
36032>>>>>>>            Move sParentId to aParams[0]
36033>>>>>>>            Move sInsertAfter to aParams[1]
36034>>>>>>>            
36034>>>>>>>            // Send actions to the client
36034>>>>>>>            Send ClientActionEx "loadQueuedSyncProps" aEmptyArray hoQueuedSyncPropsJson
36035>>>>>>>            Send ClientActionEx "insertDynamicObject" aParams hoObjectJson
36036>>>>>>>            
36036>>>>>>>            Send Destroy of hoObjectJson
36037>>>>>>>            Send Destroy of hoQueuedSyncPropsJson
36038>>>>>>>
36038>>>>>>>            Move sDynamicObjectId to aObjects[0]
36039>>>>>>>            Send FinishRendering aObjects
36040>>>>>>>        End
36040>>>>>>>>
36040>>>>>>>    End_Procedure
36041>>>>>>>    
36041>>>>>>>    
36041>>>>>>>    // Inserts a dynamic object at a certain index in its parent's list of childen.
36041>>>>>>>    Procedure InsertDynamicObjectAtIndex String sDynamicObjectId String sParentId Integer iInsertIndex
36043>>>>>>>        String[] aParams aChildren aEmptyArray aObjects
36047>>>>>>>        Integer iIndex iRemoveIndex
36047>>>>>>>        Boolean bSendCommand
36047>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
36047>>>>>>>        tWebDynamicObject tDynamicObject
36047>>>>>>>        tWebDynamicObject tDynamicObject
36047>>>>>>>        tWebDynamicObject[] aDynamicObjects
36047>>>>>>>        tWebDynamicObject[] aDynamicObjects
36048>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36048>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36049>>>>>>>        
36049>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36050>>>>>>>        
36050>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36051>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36052>>>>>>>        If (iIndex <> -1) Begin
36054>>>>>>>            // Retrieve parent
36054>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36055>>>>>>>            
36055>>>>>>>            // Find parent object
36055>>>>>>>            Move sParentId to tDynamicObject.sId
36056>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36057>>>>>>>            If (iIndex <> -1) Begin
36059>>>>>>>                
36059>>>>>>>                // Remove previously appended object (in CreateDynamicObject)
36059>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36060>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
36061>>>>>>>            End
36061>>>>>>>>
36061>>>>>>>                
36061>>>>>>>            // Find new parent
36061>>>>>>>            Move sParentId to tDynamicObject.sId
36062>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36063>>>>>>>            If (iIndex <> -1) Begin
36065>>>>>>>                Move aDynamicObjects[iIndex].aChildren to aChildren
36066>>>>>>>                
36066>>>>>>>                // Insert object at specified index
36066>>>>>>>                Move (InsertInArray(aChildren, iInsertIndex, sDynamicObjectId)) to aChildren
36067>>>>>>>                Move aChildren to aDynamicObjects[iIndex].aChildren
36068>>>>>>>                WebSet paDynamicObjects to aDynamicObjects
36069>>>>>>>                
36069>>>>>>>                Move True to bSendCommand
36070>>>>>>>            End
36070>>>>>>>>
36070>>>>>>>        End
36070>>>>>>>>
36070>>>>>>>        
36070>>>>>>>        If (bSendCommand) Begin
36072>>>>>>>            Send ConnectRadioButtons
36073>>>>>>>            
36073>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36074>>>>>>>            Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36075>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36076>>>>>>>            
36076>>>>>>>            Get DynamicObject sParentId to hoObj
36077>>>>>>>            Get WebObjectName of hoObj to sParentId
36078>>>>>>>            
36078>>>>>>>            // Convert queued sync props to JSON
36078>>>>>>>            Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36079>>>>>>>            Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36080>>>>>>>            
36080>>>>>>>            // Convert object definition to JSON
36080>>>>>>>
36080>>>>>>>            
36080>>>>>>>            Move sParentId to aParams[0]
36081>>>>>>>            Move iInsertIndex to aParams[1]
36082>>>>>>>            
36082>>>>>>>            // Send actions to the client
36082>>>>>>>            Send ClientActionEx "loadQueuedSyncProps" aEmptyArray hoQueuedSyncPropsJson
36083>>>>>>>            Send ClientActionEx "insertDynamicObjectAtIndex" aParams hoObjectJson
36084>>>>>>>            
36084>>>>>>>            Send Destroy of hoObjectJson
36085>>>>>>>            Send Destroy of hoQueuedSyncPropsJson
36086>>>>>>>
36086>>>>>>>            Move sDynamicObjectId to aObjects[0]
36087>>>>>>>            Send FinishRendering aObjects
36088>>>>>>>        End 
36088>>>>>>>>
36088>>>>>>>    End_Procedure
36089>>>>>>>    
36089>>>>>>>    
36089>>>>>>>    // Appends a dynamic object at the end of its parent's list of children.
36089>>>>>>>    Procedure AppendDynamicObject String sDynamicObjectId
36091>>>>>>>        String[] aParams aEmptyParams aObjects
36094>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
36094>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36094>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36095>>>>>>>        tWebDynamicObject[] aDynamicObjects
36095>>>>>>>        tWebDynamicObject[] aDynamicObjects
36096>>>>>>>        
36096>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36097>>>>>>>        
36097>>>>>>>        Send ConnectRadioButtons
36098>>>>>>>            
36098>>>>>>>        Get DynamicObject sDynamicObjectId to hoObj
36099>>>>>>>        Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36100>>>>>>>        WebGet paSyncPropsQueue to aSyncPropsQueue
36101>>>>>>>        
36101>>>>>>>        // Convert queued sync props to JSON
36101>>>>>>>        Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36102>>>>>>>        Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36103>>>>>>>        
36103>>>>>>>        // Convert object definition to JSON
36103>>>>>>>        Get DynamicParent sDynamicObjectId to hoObj
36104>>>>>>>        Get WebObjectName of hoObj to aParams[0]
36105>>>>>>>        
36105>>>>>>>        // Send actions to the client
36105>>>>>>>        Send ClientActionEx "loadQueuedSyncProps" aEmptyParams hoQueuedSyncPropsJson
36106>>>>>>>        Send ClientActionEx "appendDynamicObject" aParams hoObjectJson
36107>>>>>>>        
36107>>>>>>>        Send Destroy of hoObjectJson
36108>>>>>>>        Send Destroy of hoQueuedSyncPropsJson
36109>>>>>>>
36109>>>>>>>        Move sDynamicObjectId to aObjects[0]
36110>>>>>>>        Send FinishRendering aObjects
36111>>>>>>>    End_Procedure
36112>>>>>>>    
36112>>>>>>>    
36112>>>>>>>    // Prepends a dynamic object at the beginning of its parent's list of children.
36112>>>>>>>    Procedure PrependDynamicObject String sDynamicObjectId
36114>>>>>>>        String sParentId
36114>>>>>>>        String[] aParams aChildren aEmptyParams aObjects
36118>>>>>>>        Integer iIndex iRemoveIndex
36118>>>>>>>        Boolean bSendCommand
36118>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
36118>>>>>>>        tWebDynamicObject tDynamicObject
36118>>>>>>>        tWebDynamicObject tDynamicObject
36118>>>>>>>        tWebDynamicObject[] aDynamicObjects
36118>>>>>>>        tWebDynamicObject[] aDynamicObjects
36119>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36119>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36120>>>>>>>        
36120>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36121>>>>>>>        
36121>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36122>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36123>>>>>>>        If (iIndex <> -1) Begin
36125>>>>>>>            // Retrieve parent
36125>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36126>>>>>>>            
36126>>>>>>>            // Find parent object
36126>>>>>>>            Move sParentId to tDynamicObject.sId
36127>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects)) to iIndex
36128>>>>>>>            If (iIndex <> -1) Begin
36130>>>>>>>                
36130>>>>>>>                // Remove previously appended object (in CreateDynamicObject)
36130>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36131>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aChildren
36132>>>>>>>                
36132>>>>>>>                // Insert object at beginning of the array
36132>>>>>>>                Move (InsertInArray(aChildren, 0, sDynamicObjectId)) to aChildren
36133>>>>>>>                Move aChildren to aDynamicObjects[iIndex].aChildren
36134>>>>>>>                
36134>>>>>>>                WebSet paDynamicObjects to aDynamicObjects 
36135>>>>>>>                Move True to bSendCommand
36136>>>>>>>            End
36136>>>>>>>>
36136>>>>>>>            Else Begin
36137>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$DynamicParentNotFound, sParentId))
36138>>>>>>>>
36138>>>>>>>            End
36138>>>>>>>>
36138>>>>>>>        End
36138>>>>>>>>
36138>>>>>>>        
36138>>>>>>>        // Finally, send an insert command to the client
36138>>>>>>>        If (bSendCommand) Begin
36140>>>>>>>            Send ConnectRadioButtons
36141>>>>>>>            
36141>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36142>>>>>>>            Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36143>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36144>>>>>>>            
36144>>>>>>>            // Convert queued sync props to JSON
36144>>>>>>>            Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36145>>>>>>>            Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36146>>>>>>>            
36146>>>>>>>            // Convert object definition to JSON
36146>>>>>>>            Get DynamicParent sDynamicObjectId to hoObj
36147>>>>>>>            Get WebObjectName of hoObj to aParams[0]
36148>>>>>>>            
36148>>>>>>>            // Send actions to the client
36148>>>>>>>            Send ClientActionEx "loadQueuedSyncProps" aEmptyParams hoQueuedSyncPropsJson
36149>>>>>>>            Send ClientActionEx "prependDynamicObject" aParams hoObjectJson
36150>>>>>>>        
36150>>>>>>>            Send Destroy of hoObjectJson
36151>>>>>>>            Send Destroy of hoQueuedSyncPropsJson
36152>>>>>>>    
36152>>>>>>>            Move sDynamicObjectId to aObjects[0]
36153>>>>>>>            Send FinishRendering aObjects
36154>>>>>>>        End
36154>>>>>>>>
36154>>>>>>>    End_Procedure
36155>>>>>>>
36155>>>>>>>  
36155>>>>>>>    // Destroys the given dynamic object and removes it from the container.
36155>>>>>>>    Procedure DestroyDynamicObject String sDynamicObjectId
36157>>>>>>>        String sParentId sName sRadioGroup
36157>>>>>>>        String[] aParams aChildren
36159>>>>>>>        Handle hoObj
36159>>>>>>>        Integer iIndex iChildIndex iTotal iNum icObjects iObject
36159>>>>>>>        Variant vResult
36159>>>>>>>        tWebDynamicObject tDynamicObject
36159>>>>>>>        tWebDynamicObject tDynamicObject
36159>>>>>>>        tWebDynamicObject[] aDynamicObjects
36159>>>>>>>        tWebDynamicObject[] aDynamicObjects
36160>>>>>>>        tWebSyncProps tSyncProp
36160>>>>>>>        tWebSyncProps tSyncProp
36160>>>>>>>        tWebSyncPropsWrapper tSyncPropsWrapper
36160>>>>>>>        tWebSyncPropsWrapper tSyncPropsWrapper
36160>>>>>>>        tWebAdvSyncProp tAdvSyncProp
36160>>>>>>>        tWebAdvSyncProp tAdvSyncProp
36160>>>>>>>        tWebAdvSyncPropsWrapper tAdvSyncPropsWrapper
36160>>>>>>>        tWebAdvSyncPropsWrapper tAdvSyncPropsWrapper
36160>>>>>>>        tQueuedSyncProp tTest
36160>>>>>>>        tQueuedSyncProp tTest
36160>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36160>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36161>>>>>>>        tWebClientAction[] aClientActionsQueue
36161>>>>>>>        tWebClientAction[] aClientActionsQueue
36162>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
36162>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
36163>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36163>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36164>>>>>>>        tObjectInMemory tObjectInMemory
36164>>>>>>>        tObjectInMemory tObjectInMemory
36164>>>>>>>        
36164>>>>>>>        Get DynamicObject sDynamicObjectId to hoObj
36165>>>>>>>        Get WebObjectName of hoObj to sName
36166>>>>>>>        
36166>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36167>>>>>>>           
36167>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36168>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36169>>>>>>>        If (iIndex <> -1) Begin
36171>>>>>>>            Move aDynamicObjects[iIndex] to tDynamicObject
36172>>>>>>>            
36172>>>>>>>            // Destroy the object's children
36172>>>>>>>            Move tDynamicObject.aChildren to aChildren
36173>>>>>>>            Move (SizeOfArray(aChildren)) to icObjects
36174>>>>>>>            For iObject from 0 to (icObjects - 1)
36180>>>>>>>>
36180>>>>>>>                Send DestroyDynamicObject aChildren[iObject]
36181>>>>>>>            Loop
36182>>>>>>>>
36182>>>>>>>            
36182>>>>>>>            // We need to do a WebGet again, because the array might have changed while children were being destroyed
36182>>>>>>>            WebGet paDynamicObjects to aDynamicObjects
36183>>>>>>>            
36183>>>>>>>            // The index also needs to be updated
36183>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36184>>>>>>>            
36184>>>>>>>            // Destroy the dynamic object itself
36184>>>>>>>            Move tDynamicObject.sParentId to sParentId
36185>>>>>>>            Move (RemoveFromArray(aDynamicObjects, iIndex)) to aDynamicObjects
36186>>>>>>>            
36186>>>>>>>            // Remove it from its parent's list of children
36186>>>>>>>            Move sParentId to tDynamicObject.sId
36187>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36188>>>>>>>            If (iIndex <> -1) Begin
36190>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iChildIndex
36191>>>>>>>                If (iChildIndex <> -1) Begin
36193>>>>>>>                    Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iChildIndex)) to aDynamicObjects[iIndex].aChildren
36194>>>>>>>                End
36194>>>>>>>>
36194>>>>>>>            End
36194>>>>>>>>
36194>>>>>>>            
36194>>>>>>>            WebSet paDynamicObjects to aDynamicObjects
36195>>>>>>>            
36195>>>>>>>            // Optional: remove radio button from its group
36195>>>>>>>            If (IsObjectOfClass(hoObj, (RefClass(cWebRadio)))) Begin
36197>>>>>>>                WebGet paRadioGroups to aRadioGroups
36198>>>>>>>                
36198>>>>>>>                Move (SizeOfArray(aRadioGroups)) to iTotal
36199>>>>>>>                For iNum from 0 to (iTotal - 1)
36205>>>>>>>>
36205>>>>>>>                    Move (SearchArray(sDynamicObjectId, aRadioGroups[iNum].aRadioButtons)) to iIndex
36206>>>>>>>                    If (iIndex <> -1) Begin
36208>>>>>>>                        Move (RemoveFromArray(aRadioGroups[iNum].aRadioButtons, iIndex)) to aRadioGroups[iNum].aRadioButtons
36209>>>>>>>                    End
36209>>>>>>>>
36209>>>>>>>                Loop
36210>>>>>>>>
36210>>>>>>>                
36210>>>>>>>                WebSet paRadioGroups to aRadioGroups
36211>>>>>>>            End  
36211>>>>>>>>
36211>>>>>>>            
36211>>>>>>>            // Destroy the local object in memory (we can't leave this untill OnCallEnd as destructors and SyncDDO could change props)
36211>>>>>>>            Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36212>>>>>>>            Move sDynamicObjectId to tObjectInMemory.sDynamicObjectId
36213>>>>>>>            
36213>>>>>>>            Move (BinarySearchArray(tObjectInMemory, aDynamicObjectsInMemory, False)) to iIndex
36214>>>>>>>            If (iIndex <> -1) Begin
36216>>>>>>>                Send Destroy of aDynamicObjectsInMemory[iIndex].hoObj
36217>>>>>>>                Move (RemoveFromArray(aDynamicObjectsInMemory, iIndex)) to aDynamicObjectsInMemory
36218>>>>>>>                Set paDynamicObjectsInMemory to aDynamicObjectsInMemory
36219>>>>>>>            End
36219>>>>>>>>
36219>>>>>>>            Move 0 to hoObj
36220>>>>>>>            // Remove client properties
36220>>>>>>>            WebGet ptSyncPropsWrapper to tSyncPropsWrapper
36221>>>>>>>            Move (SortArray(tSyncPropsWrapper.aSyncProps, False)) to tSyncPropsWrapper.aSyncProps
36222>>>>>>>            
36222>>>>>>>            Move sName to tSyncProp.sO
36223>>>>>>>            Move (BinarySearchArray(tSyncProp, tSyncPropsWrapper.aSyncProps, False)) to iIndex
36224>>>>>>>            If (iIndex <> -1) Begin
36226>>>>>>>                Move (RemoveFromArray(tSyncPropsWrapper.aSyncProps, iIndex)) to tSyncPropsWrapper.aSyncProps
36227>>>>>>>                WebSet ptSyncPropsWrapper to tSyncPropsWrapper
36228>>>>>>>            End
36228>>>>>>>>
36228>>>>>>>            // Remove server properties
36228>>>>>>>            WebGet ptSyncServerPropsWrapper to tSyncPropsWrapper
36229>>>>>>>            Move (BinarySearchArray(tSyncProp, tSyncPropsWrapper.aSyncProps, False)) to iIndex
36230>>>>>>>            If (iIndex <> -1) Begin
36232>>>>>>>                Move (RemoveFromArray(tSyncPropsWrapper.aSyncProps, iIndex)) to tSyncPropsWrapper.aSyncProps
36233>>>>>>>                WebSet ptSyncServerPropsWrapper to tSyncPropsWrapper
36234>>>>>>>            End
36234>>>>>>>>
36234>>>>>>>            
36234>>>>>>>            
36234>>>>>>>            
36234>>>>>>>            // Remove advanced properties
36234>>>>>>>            WebGet ptAdvSyncPropsWrapper to tAdvSyncPropsWrapper
36235>>>>>>>            Move sName to tAdvSyncProp.sO
36236>>>>>>>            Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36237>>>>>>>            If (iIndex <> -1) Begin
36239>>>>>>>                While (iIndex <> -1)
36243>>>>>>>                    Move (RemoveFromArray(tAdvSyncPropsWrapper.aAdvSyncProps, iIndex)) to tAdvSyncPropsWrapper.aAdvSyncProps
36244>>>>>>>                    Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36245>>>>>>>                Loop
36246>>>>>>>>
36246>>>>>>>                WebSet ptAdvSyncPropsWrapper to tAdvSyncPropsWrapper
36247>>>>>>>            End
36247>>>>>>>>
36247>>>>>>>            
36247>>>>>>>            // Remove advanced server properties
36247>>>>>>>            WebGet ptAdvServerSyncPropsWrapper to tAdvSyncPropsWrapper
36248>>>>>>>            Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36249>>>>>>>            If (iIndex <> -1) Begin
36251>>>>>>>                While (iIndex <> -1)
36255>>>>>>>                    Move (RemoveFromArray(tAdvSyncPropsWrapper.aAdvSyncProps, iIndex)) to tAdvSyncPropsWrapper.aAdvSyncProps
36256>>>>>>>                    Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36257>>>>>>>                Loop
36258>>>>>>>>
36258>>>>>>>                WebSet ptAdvServerSyncPropsWrapper to tAdvSyncPropsWrapper      
36259>>>>>>>            End
36259>>>>>>>>
36259>>>>>>>            
36259>>>>>>>            // Remove advanced server session properties
36259>>>>>>>            WebGet ptAdvServerSessionSyncPropsWrapper to tAdvSyncPropsWrapper
36260>>>>>>>            Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36261>>>>>>>            If (iIndex <> -1) Begin
36263>>>>>>>                While (iIndex <> -1)
36267>>>>>>>                    Move (RemoveFromArray(tAdvSyncPropsWrapper.aAdvSyncProps, iIndex)) to tAdvSyncPropsWrapper.aAdvSyncProps
36268>>>>>>>                    Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36269>>>>>>>                Loop
36270>>>>>>>>
36270>>>>>>>                WebSet ptAdvServerSessionSyncPropsWrapper to tAdvSyncPropsWrapper
36271>>>>>>>            End
36271>>>>>>>>
36271>>>>>>>            
36271>>>>>>>            // Remove queued sync props for this object
36271>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue            
36272>>>>>>>            Move (SizeOfArray(aSyncPropsQueue)) to iTotal
36273>>>>>>>            For iNum from 0 to (iTotal - 1)
36279>>>>>>>>
36279>>>>>>>                If (aSyncPropsQueue[iNum].sO = sName) Begin
36281>>>>>>>                    Move (RemoveFromArray(aSyncPropsQueue, iNum)) to aSyncPropsQueue
36282>>>>>>>                    
36282>>>>>>>                    // This is necessary to keep the loop running correctly
36282>>>>>>>                    Decrement iNum
36283>>>>>>>                    Decrement iTotal
36284>>>>>>>                End
36284>>>>>>>>
36284>>>>>>>            Loop
36285>>>>>>>>
36285>>>>>>>            WebSet paSyncPropsQueue to aSyncPropsQueue
36286>>>>>>>            
36286>>>>>>>            // Remove queued client actions for this object
36286>>>>>>>            Get paClientActionsQueue to aClientActionsQueue
36287>>>>>>>            Move (SizeOfArray(aClientActionsQueue)) to iTotal
36288>>>>>>>            For iNum from 0 to (iTotal - 1)
36294>>>>>>>>
36294>>>>>>>                If (aClientActionsQueue[iNum].sName = sName) Begin
36296>>>>>>>                    Move (RemoveFromArray(aClientActionsQueue, iNum)) to aClientActionsQueue
36297>>>>>>>                    
36297>>>>>>>                    // This is necessary to keep the loop running correctly
36297>>>>>>>                    Decrement iNum
36298>>>>>>>                    Decrement iTotal
36299>>>>>>>                End
36299>>>>>>>>
36299>>>>>>>            Loop
36300>>>>>>>>
36300>>>>>>>            
36300>>>>>>>            // Update client
36300>>>>>>>            Move sName to aParams[0]
36301>>>>>>>            Send ClientAction "destroyDynamicObject" aParams
36302>>>>>>>        End
36302>>>>>>>>
36302>>>>>>>    End_Procedure
36303>>>>>>>                
36303>>>>>>>    // Appends a child object to the end of the parent's list of children.
36303>>>>>>>    Procedure AppendToSiblings String sDynamicObjectId
36305>>>>>>>        String sParentId
36305>>>>>>>        Integer iIndex iSize
36305>>>>>>>        Handle hoObj
36305>>>>>>>        tWebDynamicObject tDynamicObject
36305>>>>>>>        tWebDynamicObject tDynamicObject
36305>>>>>>>        tWebDynamicObject[] aDynamicObjects
36305>>>>>>>        tWebDynamicObject[] aDynamicObjects
36306>>>>>>>        
36306>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36307>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36308>>>>>>>        
36308>>>>>>>        // First get parent of the object
36308>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36309>>>>>>>        If (iIndex <> -1) Begin
36311>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36312>>>>>>>            Move sParentId to tDynamicObject.sId
36313>>>>>>>            
36313>>>>>>>            // Search for parent object
36313>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36314>>>>>>>            If (iIndex = -1) Begin
36316>>>>>>>                // Root object is not yet in the list of objects, so add it now
36316>>>>>>>                Move (BinarySearchInsertPos()) to iIndex 
36317>>>>>>>                Move (InsertInArray(aDynamicObjects, iIndex, tDynamicObject)) to aDynamicObjects
36318>>>>>>>            End
36318>>>>>>>>
36318>>>>>>>           
36318>>>>>>>            Move (SizeOfArray(aDynamicObjects[iIndex].aChildren)) to iSize
36319>>>>>>>            Move sDynamicObjectId to aDynamicObjects[iIndex].aChildren[iSize]
36320>>>>>>>            WebSet paDynamicObjects to aDynamicObjects
36321>>>>>>>        End
36321>>>>>>>>
36321>>>>>>>    End_Procedure
36322>>>>>>>    
36322>>>>>>>       
36322>>>>>>>    // =======================
36322>>>>>>>    // DYNAMIC OBJECT QUERYING
36322>>>>>>>    // =======================
36322>>>>>>>
36322>>>>>>>    // Checks whether the given object should always create its children when it is being created.
36322>>>>>>>    // Currently, this is true if the object is a subclass of:
36322>>>>>>>    //      - cWebList
36322>>>>>>>    //      - cWebCardContainer
36322>>>>>>>     Function RequiresChildren Handle hoObj Returns Boolean
36324>>>>>>>        Integer iClass icClasses
36324>>>>>>>        Integer[] aClassIds
36325>>>>>>>        Boolean bResult
36325>>>>>>>        
36325>>>>>>>        Move False to bResult
36326>>>>>>>        
36326>>>>>>>        Move (RefClass(cWebList)) to aClassIds[SizeOfArray(aClassIds)]
36327>>>>>>>        Move (RefClass(cWebCardContainer)) to aClassIds[SizeOfArray(aClassIds)]
36328>>>>>>>        
36328>>>>>>>        Move (SizeOfArray(aClassIds)) to icClasses
36329>>>>>>>        For iClass from 0 to (icClasses - 1)
36335>>>>>>>>
36335>>>>>>>            If (IsObjectOfClass(hoObj, aClassIds[iClass])) Begin
36337>>>>>>>                Move True to bResult
36338>>>>>>>            End
36338>>>>>>>>
36338>>>>>>>            
36338>>>>>>>            If bResult ;                Break
36341>>>>>>>        Loop
36342>>>>>>>>
36342>>>>>>>        
36342>>>>>>>        Function_Return bResult
36343>>>>>>>    End_Function
36344>>>>>>>    
36344>>>>>>>    
36344>>>>>>>    // Creates all child objects for the given dynamic object in memory
36344>>>>>>>    Procedure CreateChildren String sDynamicObjectId
36346>>>>>>>        Integer iIndex
36346>>>>>>>        Handle hoObj
36346>>>>>>>        tWebDynamicObject tDynamicObject
36346>>>>>>>        tWebDynamicObject tDynamicObject
36346>>>>>>>        tWebDynamicObject[] aDynamicObjects
36346>>>>>>>        tWebDynamicObject[] aDynamicObjects
36347>>>>>>>        String[] aChildren
36348>>>>>>>        
36348>>>>>>>        //  Find the dynamic object        
36348>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36349>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36350>>>>>>>
36350>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36351>>>>>>>        If (iIndex >= 0) Begin
36353>>>>>>>            //  Loop over its children
36353>>>>>>>            Move aDynamicObjects[iIndex].aChildren to aChildren
36354>>>>>>>            For iIndex from 0 to (SizeOfArray(aChildren) - 1)
36360>>>>>>>>
36360>>>>>>>                Get CreateLocal aChildren[iIndex] to hoObj
36361>>>>>>>            Loop
36362>>>>>>>>
36362>>>>>>>        End
36362>>>>>>>>
36362>>>>>>>    End_Procedure
36363>>>>>>>    
36363>>>>>>>    
36363>>>>>>>    //  This function searches the object handle of a dynamic object using its public name.
36363>>>>>>>    //      sObjectName - Name of the web object.
36363>>>>>>>    Function FindWebObject String sObjectName Boolean bOptErr Returns Handle
36365>>>>>>>        Integer iIndex
36365>>>>>>>        String sDynamicObjectId
36365>>>>>>>        Handle hoObj
36365>>>>>>>        
36365>>>>>>>        // Only the actual name of the object (without parentage) is saved.
36365>>>>>>>        // Therefore, we first need to remove the parentage from the name
36365>>>>>>>        // of the object.
36365>>>>>>>        Get TruncateName sObjectName to sDynamicObjectId
36366>>>>>>>        
36366>>>>>>>        Get DynamicObject sDynamicObjectId to hoObj
36367>>>>>>>        Function_Return hoObj
36368>>>>>>>    End_Function
36369>>>>>>>    
36369>>>>>>>    
36369>>>>>>>    /*    Converts a name received from the client into the identifier used in the dynamic object id     its registration. Dynamic objects their names are prefixed with a # when they are created, so     when a name comes from the client it will include the #.        So a full object name for a dynamic object will be:    oDynamicContainer@#dynamicobjectid  => dynamicobjectid        But a static child will be:    oDynamicContainer@#dynamicobjectid.oStaticChild  => dynamicobjectid.oStaticChild        But it can also be nested dynamic obects:    oDynamicContainer@#dynamicobjectid.#nesteddynamicobject  => #nesteddynamicobject    oDynamicContainer@#dynamicobjectid.#nesteddynamicobject.oStaticChild  => #nesteddynamicobject.oStaticChild        Note that usually oDynamicContainer@ is already stripped off when this function is called, but     for compatibility we still check for that if we do not find a #.        */
36369>>>>>>>    Function TruncateName String sObjectName Returns String
36371>>>>>>>        Integer iPos
36371>>>>>>>        
36371>>>>>>>        Move (RightPos("#", sObjectName)) to iPos
36372>>>>>>>        
36372>>>>>>>        If (iPos = 0) ;            Move (RightPos("$", sObjectName)) to iPos
36375>>>>>>>        
36375>>>>>>>        If (iPos > 0) ;            Function_Return (Right(sObjectName, (Length(sObjectName) - iPos)))
36378>>>>>>>        
36378>>>>>>>        Function_Return sObjectName
36379>>>>>>>    End_Function
36380>>>>>>>    
36380>>>>>>>    
36380>>>>>>>    // Returns the dynamic object with the given ID. Creates the object
36380>>>>>>>    // in memory if it doesn't exist yet.
36380>>>>>>>    Function DynamicObject String sDynamicObjectId Returns Handle
36382>>>>>>>        Handle hoObj
36382>>>>>>>        
36382>>>>>>>        Get DynamicObjectEx sDynamicObjectId to hoObj
36383>>>>>>>        
36383>>>>>>>        If (hoObj = C_WebUnresolvedObject) ;            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sDynamicObjectId))
36386>>>>>>>            
36386>>>>>>>        Function_Return hoObj
36387>>>>>>>    End_Function
36388>>>>>>>    
36388>>>>>>>    // Static children of dynamic objects are registered as "<dynamicparentid>.oChild.oChild". 
36388>>>>>>>    // Dynamic children are registered under their ID which is also set as their name, so then this 
36388>>>>>>>    // function is called with "<dynamicparentid>.<dynamicchildid>" while we should search for
36388>>>>>>>    // "<dynamicchildid>". So this function just tries to find them both ways.
36388>>>>>>>    //
36388>>>>>>>    // Worst case scenario is that we get collisions when people use the "." in dynamic object id's.
36388>>>>>>>    //
36388>>>>>>>    // This function is called by the cWebControlLocator.
36388>>>>>>>    Function OwnerFindWebObject String sObjectName Returns Handle
36390>>>>>>>        Handle hoObj
36390>>>>>>>        String sDynamicObjectId
36390>>>>>>>        
36390>>>>>>>        // If this is a root object or static child
36390>>>>>>>        Get TruncateName sObjectName to sDynamicObjectId
36391>>>>>>>        
36391>>>>>>>        Get DynamicObjectEx sDynamicObjectId to hoObj
36392>>>>>>>        
36392>>>>>>>        If (hoObj <> C_WebUnresolvedObject) ;            Function_Return hoObj
36395>>>>>>>        
36395>>>>>>>        Function_Return hoObj
36396>>>>>>>    End_Function
36397>>>>>>>    
36397>>>>>>>    // DynamicObject function that does not give an error.
36397>>>>>>>    Function DynamicObjectEx String sDynamicObjectId Returns Handle
36399>>>>>>>        Integer iObjectIndex
36399>>>>>>>        Handle hoObj
36399>>>>>>>        tWebDynamicObject tDynamicObject
36399>>>>>>>        tWebDynamicObject tDynamicObject
36399>>>>>>>        tWebDynamicObject[] aDynamicObjects
36399>>>>>>>        tWebDynamicObject[] aDynamicObjects
36400>>>>>>>        
36400>>>>>>>        // Check if the object we are looking for is the top-parent object:
36400>>>>>>>        // the container itself.
36400>>>>>>>        If (sDynamicObjectId = "") Begin
36402>>>>>>>            Function_Return Self
36403>>>>>>>        End
36403>>>>>>>>
36403>>>>>>>        
36403>>>>>>>        WebGet paDynamicObjects to aDynamicObjects  
36404>>>>>>>           
36404>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36405>>>>>>>     
36405>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
36406>>>>>>>        If (iObjectIndex <> -1) Begin
36408>>>>>>>            Get StoredHandle sDynamicObjectId to hoObj
36409>>>>>>>            
36409>>>>>>>            If (hoObj = 0) Begin
36411>>>>>>>                // This means the object is not yet loaded, so load it now.
36411>>>>>>>                Get CreateLocal sDynamicObjectId to hoObj
36412>>>>>>>            End
36412>>>>>>>>
36412>>>>>>>        End
36412>>>>>>>>
36412>>>>>>>        Else Begin
36413>>>>>>>            Move C_WebUnresolvedObject to hoObj 
36414>>>>>>>        End
36414>>>>>>>>
36414>>>>>>>        
36414>>>>>>>        Function_Return hoObj
36415>>>>>>>    End_Function
36416>>>>>>>    
36416>>>>>>>    
36416>>>>>>>    // Returns the dynamic parent of a dynamic object. 
36416>>>>>>>    Function DynamicParent String sDynamicObjectId Returns Handle
36418>>>>>>>        String sParentId
36418>>>>>>>        Integer iObjectIndex iParentIndex
36418>>>>>>>        Handle hoParent
36418>>>>>>>        tWebDynamicObject tDynamicObject
36418>>>>>>>        tWebDynamicObject tDynamicObject
36418>>>>>>>        tWebDynamicObject[] aDynamicObjects
36418>>>>>>>        tWebDynamicObject[] aDynamicObjects
36419>>>>>>>        
36419>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36420>>>>>>>        
36420>>>>>>>        Get TruncateName sDynamicObjectId to sDynamicObjectId
36421>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36422>>>>>>>        
36422>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
36423>>>>>>>        If (iObjectIndex <> -1) Begin
36425>>>>>>>            Move aDynamicObjects[iObjectIndex].sParentId to sParentId
36426>>>>>>>            
36426>>>>>>>            If (sParentId = "") ;                Function_Return (Self)
36429>>>>>>>                
36429>>>>>>>            Move sParentId to tDynamicObject.sId
36430>>>>>>>                
36430>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iParentIndex
36431>>>>>>>            If (iParentIndex <> -1) Begin
36433>>>>>>>                Get DynamicObject sParentId to hoParent
36434>>>>>>>            End
36434>>>>>>>>
36434>>>>>>>            Else ;                Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sParentId))
36436>>>>>>>        End
36436>>>>>>>>
36436>>>>>>>        Else ;            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sDynamicObjectId))
36438>>>>>>>            
36438>>>>>>>        Function_Return hoParent
36439>>>>>>>    End_Function
36440>>>>>>>    
36440>>>>>>>    
36440>>>>>>>        
36440>>>>>>>    // Returns the list of children for an object.
36440>>>>>>>    Function DynamicChildren String sDynamicObjectId Returns String[]
36442>>>>>>>        String[] aResult
36443>>>>>>>        Integer iIndex
36443>>>>>>>        tWebDynamicObject tDynamicObject
36443>>>>>>>        tWebDynamicObject tDynamicObject
36443>>>>>>>        tWebDynamicObject[] aDynamicObjects
36443>>>>>>>        tWebDynamicObject[] aDynamicObjects
36444>>>>>>>        
36444>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36445>>>>>>>        
36445>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36446>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36447>>>>>>>        If (iIndex <> -1) Begin
36449>>>>>>>            Function_Return aDynamicObjects[iIndex].aChildren
36450>>>>>>>        End
36450>>>>>>>>
36450>>>>>>>        Else Begin
36451>>>>>>>            If (sDynamicObjectId <> "") ;                Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sDynamicObjectId)) 
36454>>>>>>>        End
36454>>>>>>>>
36454>>>>>>>        Function_Return aResult
36455>>>>>>>    End_Function
36456>>>>>>>

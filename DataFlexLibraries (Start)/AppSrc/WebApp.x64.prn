3727>>>>>>>    // Create an extended field object for the passed field. .
3727>>>>>>>    // If field already exists, do nothing. This should only be used with
3727>>>>>>>    // text and binary fields.
3727>>>>>>>    Procedure DefineExtendedField Integer iField
3729>>>>>>>        Integer hFlds
3729>>>>>>>        Get Field_Objects to hFlds // this may not be created yet.
3730>>>>>>>        If not hFlds Begin         // if not created, create extended-fields wrapper
3732>>>>>>>            Object ExtendedFieldObjects is a FieldObjects
3734>>>>>>>                Move Self to hFlds
3735>>>>>>>            End_Object
3736>>>>>>>            Set Field_Objects to hFlds
3737>>>>>>>        End
3737>>>>>>>>
3737>>>>>>>        Send DefineFieldObject to hFlds iField
3738>>>>>>>    End_Procedure
3739>>>>>>>
3739>>>>>>>    // create extended DD fields for all text and binary files
3739>>>>>>>    Procedure DefineAllExtendedFields
3741>>>>>>>        Integer iCount iType iField iFile
3741>>>>>>>        Get Main_file to iFile
3742>>>>>>>        Get_Attribute DF_FILE_NUMBER_FIELDS of iFile to iCount
3745>>>>>>>        For iField from 1 to iCount
3751>>>>>>>>
3751>>>>>>>            Get_Attribute DF_FIELD_TYPE of iFile iField to iType
3754>>>>>>>            If (iType=DF_TEXT or iType=DF_BINARY) ; // if text or binary                Send DefineExtendedField iField
3757>>>>>>>        Loop
3758>>>>>>>>
3758>>>>>>>    End_Procedure

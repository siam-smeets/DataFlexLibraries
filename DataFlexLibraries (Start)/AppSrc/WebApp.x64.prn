22596>>>>>>>>>>>>>        Get PropertyHandler hoObject pubProp.eMode to hoHandler
22597>>>>>>>>>>>>>        If (hoHandler = -1) Begin
22599>>>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat("Property '%2' of object '%1' is not a valid web property for %3.%4Check the web property meta value.", pubProp.sName, sObject, "WebSet", C_NewLine+C_NewLine))        
22600>>>>>>>>>>>>>>
22600>>>>>>>>>>>>>            Procedure_Return

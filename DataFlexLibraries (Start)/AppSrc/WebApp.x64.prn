16>>>>>>>>>>>Function DWORDtoBytes Global Integer aDWORD Returns String
18>>>>>>>>>>>    // Construct string value via UChar array
18>>>>>>>>>>>    UChar[] ucResult
19>>>>>>>>>>>    Move (low(aDWORD) iand 255) to ucResult[0]
20>>>>>>>>>>>    Move (low(aDWORD) / 256)    to ucResult[1]
21>>>>>>>>>>>    Move (hi(aDWORD) iand 255)  to ucResult[2]
22>>>>>>>>>>>    Move (hi(aDWORD) / 256)     to ucResult[3]
23>>>>>>>>>>>    Function_Return (UCharArrayToString(ucResult,4))
24>>>>>>>>>>>End_Function

33927>>>>>>>            If (bEnabled <> bAllowAccess) Begin
33929>>>>>>>                WebSet pbEnabled to bAllowAccess
33930>>>>>>>            End
33930>>>>>>>>
33930>>>>>>>        End
33930>>>>>>>>
33930>>>>>>>    End_Procedure

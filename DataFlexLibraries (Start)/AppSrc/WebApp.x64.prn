16023>>>>>>>>>>>>>>>    Procedure Call_ParseRequestBody tWebCallContext ByRef cctx
16025>>>>>>>>>>>>>>>        Handle hoRequest
16025>>>>>>>>>>>>>>>        
16025>>>>>>>>>>>>>>>        Move False to Err
16026>>>>>>>>>>>>>>>        
16026>>>>>>>>>>>>>>>        //  Parse message
16026>>>>>>>>>>>>>>>        Get Member of cctx.hoJsonRequest "r" to hoRequest
16027>>>>>>>>>>>>>>>        //  Ideally we'd leave pbRequireAllMembers on as it provides more strict validation, lets see if we get away with that
16027>>>>>>>>>>>>>>>        // Set pbRequireAllMembers of hoRequest to False  
16027>>>>>>>>>>>>>>>        Get JsonToDataType of hoRequest to cctx.request
16028>>>>>>>>>>>>>>>        Send Destroy of hoRequest
16029>>>>>>>>>>>>>>>        
16029>>>>>>>>>>>>>>>        If (Err) Begin
16031>>>>>>>>>>>>>>>            //  Response will be HTTP 200 but with WAF error instruction
16031>>>>>>>>>>>>>>>            Move False to cctx.bSuccess
16032>>>>>>>>>>>>>>>            
16032>>>>>>>>>>>>>>>            If (pbLogInvalidRequests(Self)) Begin
16034>>>>>>>>>>>>>>>                Error DFERR_WEBAPP_BAD_REQUEST "Invalid request data. Error while parsing request body."
16035>>>>>>>>>>>>>>>>
16035>>>>>>>>>>>>>>>            End
16035>>>>>>>>>>>>>>>>
16035>>>>>>>>>>>>>>>        End
16035>>>>>>>>>>>>>>>>
16035>>>>>>>>>>>>>>>        
16035>>>>>>>>>>>>>>>    End_Procedure
16036>>>>>>>>>>>>>>>
16036>>>>>>>>>>>>>>>    //  Perform version checking logic
16036>>>>>>>>>>>>>>>    Procedure Call_VersionCheck tWebCallContext ByRef cctx
16038>>>>>>>>>>>>>>>        String sClientVersion sServerVersion sReason
16038>>>>>>>>>>>>>>>        String[] aServer aClient
16040>>>>>>>>>>>>>>>        Integer iVersionBlock iClientV iServerV
16040>>>>>>>>>>>>>>>        Boolean bRes bTrapped
16040>>>>>>>>>>>>>>>        
16040>>>>>>>>>>>>>>>        Move True to bRes
16041>>>>>>>>>>>>>>>        Get psVersionID to sServerVersion
16042>>>>>>>>>>>>>>>        Get MemberValue of cctx.hoJsonRequest "v" to sClientVersion
16043>>>>>>>>>>>>>>>        
16043>>>>>>>>>>>>>>>        Move True to cctx.bSuccess
16044>>>>>>>>>>>>>>>        
16044>>>>>>>>>>>>>>>        If (sServerVersion <> sClientVersion) Begin
16046>>>>>>>>>>>>>>>            //  Parse into components
16046>>>>>>>>>>>>>>>            Get StrSplitToArray sClientVersion "." to aClient
16047>>>>>>>>>>>>>>>            If (SizeOfArray(aClient) <> 4) Begin
16049>>>>>>>>>>>>>>>                Move "Version check: Invalid client version string." to sReason
16050>>>>>>>>>>>>>>>                Move False to bRes
16051>>>>>>>>>>>>>>>            End
16051>>>>>>>>>>>>>>>>
16051>>>>>>>>>>>>>>>            
16051>>>>>>>>>>>>>>>            If (bRes) Begin
16053>>>>>>>>>>>>>>>                Get StrSplitToArray sServerVersion "." to aServer
16054>>>>>>>>>>>>>>>                If (SizeOfArray(aServer) <> 4) Begin
16056>>>>>>>>>>>>>>>                    Move "Version check: Invalid server version string." to sReason
16057>>>>>>>>>>>>>>>                    Move False to bRes
16058>>>>>>>>>>>>>>>                End
16058>>>>>>>>>>>>>>>>
16058>>>>>>>>>>>>>>>            End
16058>>>>>>>>>>>>>>>>
16058>>>>>>>>>>>>>>>            
16058>>>>>>>>>>>>>>>            If (bRes) Begin
16060>>>>>>>>>>>>>>>                //  Check individual pieces
16060>>>>>>>>>>>>>>>                Get IsTrapped of ghoWebErrorHandler 56 to bTrapped
16061>>>>>>>>>>>>>>>                If (bTrapped) ;                    Send IgnoreError of ghoWebErrorHandler 56 
16064>>>>>>>>>>>>>>>                
16064>>>>>>>>>>>>>>>                Move 0 to iVersionBlock
16065>>>>>>>>>>>>>>>                While (bRes and (iVersionBlock <= 3))
16069>>>>>>>>>>>>>>>                    Move (Convert(aClient[iVersionBlock], Integer)) to iClientV
16070>>>>>>>>>>>>>>>                    Move (Convert(aServer[iVersionBlock], Integer)) to iServerV
16071>>>>>>>>>>>>>>>                    If (iServerV > iClientV) Begin
16073>>>>>>>>>>>>>>>                        Move "The version check failed because the server is newer than the client. This could be a caching issue, try using CTRL-F5 to refresh the page." to sReason
16074>>>>>>>>>>>>>>>                        Move False to bRes
16075>>>>>>>>>>>>>>>                    End
16075>>>>>>>>>>>>>>>>
16075>>>>>>>>>>>>>>>                    Else If (iServerV < iClientV) Begin
16078>>>>>>>>>>>>>>>                        Move "The version check failed because the client is newer than the server." to sReason
16079>>>>>>>>>>>>>>>                        Move False to bRes
16080>>>>>>>>>>>>>>>                    End
16080>>>>>>>>>>>>>>>>
16080>>>>>>>>>>>>>>>                    Increment iVersionBlock
16081>>>>>>>>>>>>>>>                Loop
16082>>>>>>>>>>>>>>>>
16082>>>>>>>>>>>>>>>                
16082>>>>>>>>>>>>>>>                If (bTrapped) ;                    Send TrapError of ghoWebErrorHandler 56
16085>>>>>>>>>>>>>>>            End
16085>>>>>>>>>>>>>>>>
16085>>>>>>>>>>>>>>>            
16085>>>>>>>>>>>>>>>            //  Extend error message
16085>>>>>>>>>>>>>>>            If (not(bRes)) Begin
16087>>>>>>>>>>>>>>>                Move (sReason + C_NewLine + C_NewLine + SFormat("Client version: %1 %3Server version: %2", HtmlEncode(sClientVersion), sServerVersion, C_NewLine)) to sReason
16088>>>>>>>>>>>>>>>                Move True to cctx.bCancel
16089>>>>>>>>>>>>>>>                Move False to cctx.bSuccess
16090>>>>>>>>>>>>>>>                Move sReason to cctx.sFatalError
16091>>>>>>>>>>>>>>>                Move 500 to cctx.iFatalErrorCode
16092>>>>>>>>>>>>>>>                If (pbLogInvalidRequests(Self)) Begin
16094>>>>>>>>>>>>>>>                    Error DFERR_WEBAPP_BAD_REQUEST sReason //  Put the error in the log
16095>>>>>>>>>>>>>>>>
16095>>>>>>>>>>>>>>>                End
16095>>>>>>>>>>>>>>>>
16095>>>>>>>>>>>>>>>            End
16095>>>>>>>>>>>>>>>>
16095>>>>>>>>>>>>>>>        End
16095>>>>>>>>>>>>>>>>
16095>>>>>>>>>>>>>>>    End_Procedure

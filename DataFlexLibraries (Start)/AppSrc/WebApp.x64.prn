30135>>>>>>>>>>>Class cCryptographerEx is a cObject
30136>>>>>>>>>>>    
30136>>>>>>>>>>>    Procedure Construct_Object
30138>>>>>>>>>>>        Forward Send Construct_Object
30140>>>>>>>>>>>        
30140>>>>>>>>>>>        Property String     psProvider  MS_ENHANCED_PROV
30141>>>>>>>>>>>        Property Integer    piProvider  PROV_RSA_FULL
30142>>>>>>>>>>>        Property Integer    piCipher    CALG_RC4
30143>>>>>>>>>>>        Property Integer    piHash      CALG_MD5
30144>>>>>>>>>>>        
30144>>>>>>>>>>>        // Private properties
30144>>>>>>>>>>>        Property Handle     Private_phProv
30145>>>>>>>>>>>        
30145>>>>>>>>>>>        // Block cipher properties
30145>>>>>>>>>>>        Property UChar[]    paKey
30146>>>>>>>>>>>        Property UChar[]    paIV
30147>>>>>>>>>>>        Property Integer    piKeyAlg        PLAINTEXTKEYBLOB
30148>>>>>>>>>>>        Property Integer    piKeyType       CALG_AES_256
30149>>>>>>>>>>>        Property Integer    piKeyPadding    PKCS5_PADDING
30150>>>>>>>>>>>        Property Integer    piKeyMode       CRYPT_MODE_CBC
30151>>>>>>>>>>>        Property Integer    piBlockSize     16
30152>>>>>>>>>>>    End_Procedure
30153>>>>>>>>>>>    
30153>>>>>>>>>>>    
30153>>>>>>>>>>>    // Acquire key container handle
30153>>>>>>>>>>>    Function AcquireContext Returns Handle
30155>>>>>>>>>>>        Integer iProvider
30155>>>>>>>>>>>        WString wProvider
30155>>>>>>>>>>>        Handle hProv
30155>>>>>>>>>>>        Boolean bOk
30155>>>>>>>>>>>        Pointer pProv
30155>>>>>>>>>>>        
30155>>>>>>>>>>>        Move 0 to hProv
30156>>>>>>>>>>>        Get piProvider to iProvider
30157>>>>>>>>>>>        Get psProvider to wProvider
30158>>>>>>>>>>>        
30158>>>>>>>>>>>        //  Determine address to be passed as provider
30158>>>>>>>>>>>        If (Trim(wProvider) <> "") Begin
30160>>>>>>>>>>>            Move (AddressOf(wProvider)) to pProv
30161>>>>>>>>>>>        End
30161>>>>>>>>>>>>
30161>>>>>>>>>>>        Else Begin
30162>>>>>>>>>>>            Move 0 to pProv
30163>>>>>>>>>>>        End
30163>>>>>>>>>>>>
30163>>>>>>>>>>>        
30163>>>>>>>>>>>        //  Acquire Crypto Context. Note: pProv is pointer to UTF16 string.
30163>>>>>>>>>>>        Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_VERIFYCONTEXT)) to bOk
30164>>>>>>>>>>>        If (not(bOk) or hProv = 0) Begin
30166>>>>>>>>>>>            Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_NEWKEYSET ior CRYPT_VERIFYCONTEXT)) to bOk
30167>>>>>>>>>>>        End
30167>>>>>>>>>>>>
30167>>>>>>>>>>>        
30167>>>>>>>>>>>        If (not(bOk) or hProv = 0) Begin
30169>>>>>>>>>>>            // Fallback to original
30169>>>>>>>>>>>            Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,0)) to bOk
30170>>>>>>>>>>>            
30170>>>>>>>>>>>            If (not(bOk) or hProv = 0) Begin
30172>>>>>>>>>>>                Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_NEWKEYSET)) to bOk
30173>>>>>>>>>>>            End
30173>>>>>>>>>>>>
30173>>>>>>>>>>>        End
30173>>>>>>>>>>>>
30173>>>>>>>>>>>        Set Private_phProv to hProv
30174>>>>>>>>>>>        
30174>>>>>>>>>>>        Function_Return hProv
30175>>>>>>>>>>>    End_Function
30176>>>>>>>>>>>    
30176>>>>>>>>>>>    // Releases key container handle
30176>>>>>>>>>>>    Function ReleaseContext Handle hProv Returns Boolean
30178>>>>>>>>>>>        Function_Return (CryptReleaseContext(hProv,0))
30179>>>>>>>>>>>    End_Function
30180>>>>>>>>>>>    
30180>>>>>>>>>>>    // Creates hash object
30180>>>>>>>>>>>    Function CreateHash Handle hProv Returns Handle
30182>>>>>>>>>>>        Integer iAlgorithm
30182>>>>>>>>>>>        Handle hHash
30182>>>>>>>>>>>        Boolean bOk
30182>>>>>>>>>>>        
30182>>>>>>>>>>>        Move 0 to hHash
30183>>>>>>>>>>>        Get piHash to iAlgorithm
30184>>>>>>>>>>>        Move (CryptCreateHash(hProv,iAlgorithm,0,0,AddressOf(hHash))) to bOk
30185>>>>>>>>>>>        
30185>>>>>>>>>>>        Function_Return hHash
30186>>>>>>>>>>>    End_Function
30187>>>>>>>>>>>    
30187>>>>>>>>>>>    // Destroys the hash object
30187>>>>>>>>>>>    Function DestroyHash Handle hHash Returns Boolean
30189>>>>>>>>>>>        Function_Return (CryptDestroyHash(hHash))
30190>>>>>>>>>>>    End_Function
30191>>>>>>>>>>>    
30191>>>>>>>>>>>    // Adds data to hash object
30191>>>>>>>>>>>    Function HashData Handle hHash UChar[] ucData Returns Boolean
30193>>>>>>>>>>>        Function_Return (CryptHashData(hHash,AddressOf(ucData), SizeOfArray(ucData),0))
30194>>>>>>>>>>>    End_Function
30195>>>>>>>>>>>    
30195>>>>>>>>>>>    // Generates session key
30195>>>>>>>>>>>    Function DeriveKey Handle hProv Handle hHash Returns Handle
30197>>>>>>>>>>>        Integer iAlgorithm
30197>>>>>>>>>>>        Handle hKey
30197>>>>>>>>>>>        Boolean bOk
30197>>>>>>>>>>>        
30197>>>>>>>>>>>        Move 0 to hKey
30198>>>>>>>>>>>        Get piCipher to iAlgorithm
30199>>>>>>>>>>>        Move (CryptDeriveKey(hProv,iAlgorithm,hHash,CRYPT_EXPORTABLE,AddressOf(hKey))) to bOk
30200>>>>>>>>>>>        
30200>>>>>>>>>>>        Function_Return hKey
30201>>>>>>>>>>>    End_Function
30202>>>>>>>>>>>    
30202>>>>>>>>>>>    // Imports a plain text key
30202>>>>>>>>>>>    Function ImportPlainTextKey Handle hProv UChar[] ucaKey Returns Handle
30204>>>>>>>>>>>        tPLAINTEXTKEYBLOB blobhead
30204>>>>>>>>>>>        tPLAINTEXTKEYBLOB blobhead
30204>>>>>>>>>>>        Boolean   bSuccess
30204>>>>>>>>>>>        Handle    hKey
30204>>>>>>>>>>>        Integer   iHeadSize iKeySize
30204>>>>>>>>>>>        UChar[]   ucaKeyblob
30205>>>>>>>>>>>        Integer iVoid
30205>>>>>>>>>>>        
30205>>>>>>>>>>>        Move (SizeOfType(tPLAINTEXTKEYBLOB)) to iHeadSize
30206>>>>>>>>>>>        Move (SizeOfArray(ucaKey)) to iKeySize
30207>>>>>>>>>>>        
30207>>>>>>>>>>>        Move PLAINTEXTKEYBLOB to blobhead.hdr.bType
30208>>>>>>>>>>>        Move CUR_BLOB_VERSION   to blobhead.hdr.bVersion
30209>>>>>>>>>>>        Get piCipher            to blobhead.hdr.aiKeyAlg
30210>>>>>>>>>>>        Move iKeySize           to blobhead.dwKeySize
30211>>>>>>>>>>>        
30211>>>>>>>>>>>        Move (ResizeArray(ucaKeyblob, iHeadSize)) to ucaKeyblob
30212>>>>>>>>>>>        Move (CopyMemory(AddressOf(ucaKeyblob), AddressOf(blobhead), iHeadSize)) to iVoid
30213>>>>>>>>>>>        Move (AppendArray(ucaKeyblob, ucaKey)) to ucaKeyblob
30214>>>>>>>>>>>        
30214>>>>>>>>>>>        Move 0 to hKey
30215>>>>>>>>>>>        Move (CryptImportKey(hProv, AddressOf(ucaKeyblob), SizeOfArray(ucaKeyblob), 0, 0, AddressOf(hKey))) to bSuccess
30216>>>>>>>>>>>        If (not(bSuccess)) Begin
30218>>>>>>>>>>>            Move (ShowLastError()) to iVoid
30219>>>>>>>>>>>        End
30219>>>>>>>>>>>>
30219>>>>>>>>>>>        
30219>>>>>>>>>>>        Function_Return hKey
30220>>>>>>>>>>>    End_Function
30221>>>>>>>>>>>    

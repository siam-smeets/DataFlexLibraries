10263>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10265>>>>>>>>>            // Check if the column exists
10265>>>>>>>>>            If (iCol >= 1 and iCol <= piColumnCount(Self)) Begin
10267>>>>>>>>>                If (iLen = 0) Begin
10269>>>>>>>>>                    Get SQLColumnValue iCol to wResult
10270>>>>>>>>>                End
10270>>>>>>>>>>
10270>>>>>>>>>                Else Begin
10271>>>>>>>>>                    // Add 1 for string terminator
10271>>>>>>>>>                    Move (iLen + 1) to iLen
10272>>>>>>>>>                    

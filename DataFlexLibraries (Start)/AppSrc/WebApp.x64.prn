27213>>>>>>>>>    // Scrolls a column into the view by scrolling horizontally. Can only be used when 
27213>>>>>>>>>    // pbAutoColumnSizing is false and pbScroll is true.
27213>>>>>>>>>    Procedure ScrollToColumnObject Handle hoColumn
27215>>>>>>>>>        Handle[] aColumnObjects
27216>>>>>>>>>        Integer iColumnIndex
27216>>>>>>>>>        String[] aParams
27217>>>>>>>>>        
27217>>>>>>>>>        Get phoColumnObjects to aColumnObjects
27218>>>>>>>>>        
27218>>>>>>>>>        Move (SearchArray(hoColumn, aColumnObjects)) to iColumnIndex
27219>>>>>>>>>        
27219>>>>>>>>>        If (iColumnIndex >= 0) Begin
27221>>>>>>>>>            Move iColumnIndex to aParams[0]    
27222>>>>>>>>>        
27222>>>>>>>>>            Send ClientAction "scrollToCol" aParams
27223>>>>>>>>>        End
27223>>>>>>>>>>
27223>>>>>>>>>        Else Begin
27224>>>>>>>>>            Error DFERR_PROGRAM "Invalid column handle!"
27225>>>>>>>>>>
27225>>>>>>>>>        End
27225>>>>>>>>>>
27225>>>>>>>>>    End_Procedure

37303>>>>>>>    // published using WebPublishProcedure and is expected to have the following signature:
37303>>>>>>>    //  Procedure GeoQuery_Callback Integer iErr Number nLatitude Number nLongitude Number nAccuracy Number nSpeed Number nHeading
37303>>>>>>>    //
37303>>>>>>>    // Example usage:
37303>>>>>>>    //  Procedure GeoQuery_Callback Integer iErr Number nLatitude Number nLongitude Number nAccuracy Number nSpeed Number nHeading
37303>>>>>>>    //      If (not(iErr)) Begin
37303>>>>>>>    //          Send ShowInfoBox (SFormat("Lat: %1 Long: %2 Acc: %3 Speed: %4 Head: %5", nLatitude, nLongitude, nAccuracy, nSpeed, nHeading))
37303>>>>>>>    //      End
37303>>>>>>>    //  End_Procedure
37303>>>>>>>    //  
37303>>>>>>>    //  WebPublishProcedure GeoQuery_Callback
37303>>>>>>>    //  
37303>>>>>>>    //  Procedure OnClick
37303>>>>>>>    //      Send QueryLocation of oWebGeoLocation1 (RefProc(GeoQuery_Callback)) Self
37303>>>>>>>    //  End_Procedure
37303>>>>>>>    Procedure QueryLocation Handle hmCallbackMsg Handle hoCallbackObject
37305>>>>>>>        String[] aParams

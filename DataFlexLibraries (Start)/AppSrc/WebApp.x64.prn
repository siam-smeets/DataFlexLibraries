32375>>>>>>>>>    Procedure SuggestionsFindIncremental String sSearch tSuggestion[] ByRef aSuggestions
32377>>>>>>>>>        Integer iFile iField iIndex iLen iRow iMax eType iLength iDec
32377>>>>>>>>>        Handle hoServer
32377>>>>>>>>>        Boolean bContinue bCase bOldRelate bNeedsRelate
32377>>>>>>>>>        String sVal sLowSearch
32377>>>>>>>>>        RowID riTest
32377>>>>>>>>>        
32377>>>>>>>>>        Get Server to hoServer
32378>>>>>>>>>        Get Data_File  to iFile
32379>>>>>>>>>        Get Data_Field to iField       
32380>>>>>>>>>        
32380>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
32382>>>>>>>>>            Get piFindIndex to iIndex
32383>>>>>>>>>            WebGet piMaxResults to iMax
32384>>>>>>>>>            WebGet pbCaseSensitive to bCase
32385>>>>>>>>>            
32385>>>>>>>>>            Get_Attribute DF_FIELD_TYPE of iFile iField to eType
32388>>>>>>>>>            Get_Attribute DF_FIELD_LENGTH of iFile iField to iLength
32391>>>>>>>>>            Get_Attribute DF_FIELD_PRECISION of iFile iField to iDec
32394>>>>>>>>>            
32394>>>>>>>>>            Move (iLength - iDec) to iLength
32395>>>>>>>>>            
32395>>>>>>>>>            If (iIndex <= 0) Begin
32397>>>>>>>>>                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
32400>>>>>>>>>            End
32400>>>>>>>>>>
32400>>>>>>>>>            
32400>>>>>>>>>            If (iIndex > 0) Begin
32402>>>>>>>>>                Get No_Relate_State of hoServer to bOldRelate
32403>>>>>>>>>                Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
32404>>>>>>>>>                Set No_Relate_State of hoServer to (not(bNeedsRelate))
32405>>>>>>>>>                                
32405>>>>>>>>>                Move True to bContinue
32406>>>>>>>>>                Move (Length(sSearch)) to iLen
32407>>>>>>>>>                Move (Lowercase(sSearch)) to sLowSearch
32408>>>>>>>>>                Move 0 to iRow
32409>>>>>>>>>                
32409>>>>>>>>>                //  Find first record
32409>>>>>>>>>                Send Request_Read of hoServer FIRST_RECORD iFile iIndex
32410>>>>>>>>>                Set_Field_Value iFile iField to sSearch
32413>>>>>>>>>                Send Request_Read of hoServer GE iFile iIndex
32414>>>>>>>>>                
32414>>>>>>>>>                While (Found and bContinue)
32418>>>>>>>>>                    Get_Field_Value iFile iField to sVal
32421>>>>>>>>>                    
32421>>>>>>>>>                    If ((not(bCase) and Lowercase(Left(sVal, iLen)) = sLowSearch) or (bCase and Left(sVal, iLen) = sSearch)) Begin
32423>>>>>>>>>
32423>>>>>>>>>                        Move (SerializeRowID(GetRowID(iFile)))  to aSuggestions[iRow].sRowId
32424>>>>>>>>>                        Move (Trim(sVal))                       to aSuggestions[iRow].aValues[0]
32425>>>>>>>>>                        Increment iRow
32426>>>>>>>>>                        
32426>>>>>>>>>                        Move (iRow < iMax) to bContinue
32427>>>>>>>>>                       
32427>>>>>>>>>                        Send Request_Read of hoServer GT iFile iIndex  
32428>>>>>>>>>                    End
32428>>>>>>>>>>
32428>>>>>>>>>                    Else Begin
32429>>>>>>>>>
32429>>>>>>>>>                        Move False to bContinue
32430>>>>>>>>>                        If (eType = DF_BCD and Length(sSearch) < iLength) Begin
32432>>>>>>>>>                            Move (GetRowID(iFile)) to riTest
32433>>>>>>>>>                            
32433>>>>>>>>>                            Repeat
32433>>>>>>>>>>
32433>>>>>>>>>                                Move (sSearch + "0") to sSearch
32434>>>>>>>>>                                If (Length(sSearch) >= iLength) ;                                    Break
32437>>>>>>>>>                                
32437>>>>>>>>>                                Set_Field_Value iFile iField to sSearch
32440>>>>>>>>>                                Send Request_Read of hoServer GE iFile iIndex
32441>>>>>>>>>                                Move (not(IsSameRowID(riTest, GetRowID(iFile)))) to bcontinue
32442>>>>>>>>>                            Until (bcontinue)
32444>>>>>>>>>                        End
32444>>>>>>>>>>
32444>>>>>>>>>                    End
32444>>>>>>>>>>
32444>>>>>>>>>                Loop
32445>>>>>>>>>>
32445>>>>>>>>>                Set No_Relate_State of hoServer to bOldRelate
32446>>>>>>>>>            End
32446>>>>>>>>>>
32446>>>>>>>>>        End
32446>>>>>>>>>>
32446>>>>>>>>>    End_Procedure
32447>>>>>>>>>
32447>>>>>>>>>    Procedure SuggestionsFindFullText String sSearch tSuggestion[] ByRef aSuggestions
32449>>>>>>>>>        Integer iFile iField iIndex iRow iMax
32449>>>>>>>>>        Handle hoServer
32449>>>>>>>>>        Boolean bContinue bCase  bOldRelate bNeedsRelate
32449>>>>>>>>>        String sVal sLowSearch
32449>>>>>>>>>        
32449>>>>>>>>>        Get Server to hoServer
32450>>>>>>>>>        Get Data_File  to iFile
32451>>>>>>>>>        Get Data_Field to iField       
32452>>>>>>>>>        
32452>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
32454>>>>>>>>>            WebGet piMaxResults to iMax
32455>>>>>>>>>            WebGet pbCaseSensitive to bCase
32456>>>>>>>>>            
32456>>>>>>>>>            Get piFindIndex to iIndex
32457>>>>>>>>>            If (iIndex <= 0) Begin
32459>>>>>>>>>                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
32462>>>>>>>>>            End
32462>>>>>>>>>>
32462>>>>>>>>>            
32462>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
32463>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
32464>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
32465>>>>>>>>>            
32465>>>>>>>>>            
32465>>>>>>>>>            Move (Lowercase(sSearch)) to sLowSearch
32466>>>>>>>>>            Move True to bContinue
32467>>>>>>>>>            Move 0 to iRow
32468>>>>>>>>>                
32468>>>>>>>>>            //  Find first record
32468>>>>>>>>>            Send Request_Read of hoServer FIRST_RECORD iFile iIndex
32469>>>>>>>>>            
32469>>>>>>>>>            While (Found and (iRow < iMax))
32473>>>>>>>>>                Get_Field_Value iFile iField to sVal
32476>>>>>>>>>                
32476>>>>>>>>>                If ((bCase and sVal contains sSearch) or (not(bCase) and Lowercase(sVal) contains sLowSearch) or sSearch = "") Begin
32478>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile)))  to aSuggestions[iRow].sRowId
32479>>>>>>>>>                    Move (Trim(sVal))                       to aSuggestions[iRow].aValues[0]
32480>>>>>>>>>                    Increment iRow
32481>>>>>>>>>                End
32481>>>>>>>>>>
32481>>>>>>>>>                
32481>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex 
32482>>>>>>>>>            Loop
32483>>>>>>>>>>
32483>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
32484>>>>>>>>>        End
32484>>>>>>>>>>
32484>>>>>>>>>    End_Procedure
32485>>>>>>>>>    
32485>>>>>>>>>    Procedure SuggestionsSQLFullText String sSearch tSuggestion[] ByRef aSuggestions
32487>>>>>>>>>        Integer iFile iField iIndex iRow iMax
32487>>>>>>>>>        Handle hoServer
32487>>>>>>>>>        Boolean bContinue bOrigActive  bOldRelate bNeedsRelate
32487>>>>>>>>>        String sVal sOrigFilter sFilter sFile sField
32487>>>>>>>>>        
32487>>>>>>>>>        Get Server to hoServer
32488>>>>>>>>>        Get Data_File  to iFile
32489>>>>>>>>>        Get Data_Field to iField       
32490>>>>>>>>>        
32490>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
32492>>>>>>>>>            
32492>>>>>>>>>            // make sure we send DD messages to owner DDO
32492>>>>>>>>>            Get Which_Data_Set of hoServer iFile to hoServer
32493>>>>>>>>>            If (hoServer=0) Begin
32495>>>>>>>>>                Procedure_Return
32496>>>>>>>>>            End
32496>>>>>>>>>>
32496>>>>>>>>>            
32496>>>>>>>>>            WebGet piMaxResults to iMax
32497>>>>>>>>>            Get piFindIndex to iIndex
32498>>>>>>>>>            If (iIndex <= 0) Begin
32500>>>>>>>>>                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
32503>>>>>>>>>            End
32503>>>>>>>>>>
32503>>>>>>>>>            
32503>>>>>>>>>            //  Determine current filter settings
32503>>>>>>>>>            Get psSQLFilter of hoServer to sOrigFilter
32504>>>>>>>>>            Get pbUseDDSqlFilters of hoServer to bOrigActive
32505>>>>>>>>>            
32505>>>>>>>>>            // generate the Like filter string
32505>>>>>>>>>            Get SQLStrLike of hoServer iField sSearch to sFilter
32506>>>>>>>>>            // If filtering was active append this to what's there
32506>>>>>>>>>            If (bOrigActive) Begin
32508>>>>>>>>>                Get SQLStrAppend of hoServer sOrigFilter sFilter to sFilter
32509>>>>>>>>>            End
32509>>>>>>>>>>
32509>>>>>>>>>            
32509>>>>>>>>>            //  Set filter
32509>>>>>>>>>            Set psSQLFilter of hoServer to sFilter
32510>>>>>>>>>            Set pbUseDDSqlFilters of hoServer to True
32511>>>>>>>>>            
32511>>>>>>>>>            
32511>>>>>>>>>            // this will optimize No_relate. If your DF constraint does not
32511>>>>>>>>>            // need a post-relate test, we will disabled relates for this
32511>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
32512>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
32513>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
32514>>>>>>>>>
32514>>>>>>>>>            //  Find records
32514>>>>>>>>>            Move True to bContinue
32515>>>>>>>>>            Move 0 to iRow
32516>>>>>>>>>            
32516>>>>>>>>>            Send Request_Read of hoServer FIRST_RECORD iFile iIndex
32517>>>>>>>>>            
32517>>>>>>>>>            While (bContinue)
32521>>>>>>>>>                Get_Field_Value iFile iField to sVal
32524>>>>>>>>>                
32524>>>>>>>>>                If (Found) Begin // and ((bCase and sVal contains sSearch) or (not(bCase) and Lowercase(sVal) contains sLowSearch))) Begin
32526>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile)))  to aSuggestions[iRow].sRowId
32527>>>>>>>>>                    Move (Trim(sVal))                       to aSuggestions[iRow].aValues[0]
32528>>>>>>>>>                    Increment iRow
32529>>>>>>>>>                    
32529>>>>>>>>>                    Move (iRow < iMax) to bContinue
32530>>>>>>>>>                   
32530>>>>>>>>>                    Send Request_Read of hoServer GT iFile iIndex 
32531>>>>>>>>>                End
32531>>>>>>>>>>
32531>>>>>>>>>                Else Begin
32532>>>>>>>>>                    Move False to bContinue
32533>>>>>>>>>                End
32533>>>>>>>>>>
32533>>>>>>>>>                
32533>>>>>>>>>            Loop
32534>>>>>>>>>>
32534>>>>>>>>>            
32534>>>>>>>>>            //  Restore filters
32534>>>>>>>>>            Set psSQLFilter of hoServer to sOrigFilter
32535>>>>>>>>>            Set pbUseDDSqlFilters of hoServer to bOrigActive
32536>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
32537>>>>>>>>>        End
32537>>>>>>>>>>
32537>>>>>>>>>    End_Procedure
32538>>>>>>>>>    
32538>>>>>>>>>    Procedure SuggestionsValidation String sSearch tSuggestion[] ByRef aSuggestions Boolean bFullText
32540>>>>>>>>>        Handle hoServer hoTable
32540>>>>>>>>>        Integer iFile iField iRow iCount iFound iMax iLen
32540>>>>>>>>>        Variant[][] aData
32541>>>>>>>>>        Boolean bCaseSensitive bContinue
32541>>>>>>>>>        String sDescr sVal
32541>>>>>>>>>        
32541>>>>>>>>>        Get Server to hoServer
32542>>>>>>>>>        Get Data_File  to iFile
32543>>>>>>>>>        Get Data_Field to iField       
32544>>>>>>>>>        
32544>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
32546>>>>>>>>>            Get File_Field_Table_Object of hoServer iFile iField to hoTable
32547>>>>>>>>>            If (hoTable <> 0) Begin
32549>>>>>>>>>                Get tabledata of hoTable to aData
32550>>>>>>>>>        
32550>>>>>>>>>                WebGet piMaxResults to iMax
32551>>>>>>>>>                WebGet pbCaseSensitive to bCaseSensitive  
32552>>>>>>>>>            
32552>>>>>>>>>                If (not(bCaseSensitive)) Begin
32554>>>>>>>>>                    Move (Lowercase(sSearch)) to sSearch
32555>>>>>>>>>                End
32555>>>>>>>>>>
32555>>>>>>>>>                
32555>>>>>>>>>                
32555>>>>>>>>>                Move (SizeOfArray(aData)) to iCount
32556>>>>>>>>>                Move 0 to iRow
32557>>>>>>>>>                Move (Length(sSearch)) to iLen
32558>>>>>>>>>                Move True to bContinue
32559>>>>>>>>>                
32559>>>>>>>>>            
32559>>>>>>>>>                While (iFound < iMax and iRow < iCount and bContinue)
32563>>>>>>>>>                    If (not(bCaseSensitive)) Begin
32565>>>>>>>>>                        Move (Lowercase(aData[iRow][0])) to sVal
32566>>>>>>>>>                        Move (Lowercase(aData[iRow][1])) to sDescr
32567>>>>>>>>>                    End
32567>>>>>>>>>>
32567>>>>>>>>>                    Else Begin
32568>>>>>>>>>                        Move aData[iRow][0] to sVal
32569>>>>>>>>>                        Move aData[iRow][1] to sDescr
32570>>>>>>>>>                    End
32570>>>>>>>>>>
32570>>>>>>>>>                    
32570>>>>>>>>>                    If ((bFullText and (sVal contains sSearch)) or (not(bFullText) and (Left(sVal, iLen) = sSearch))) Begin
32572>>>>>>>>>                        Move aData[iRow][0] to aSuggestions[iFound].sRowId
32573>>>>>>>>>                        Move aData[iRow][0] to aSuggestions[iFound].aValues[0]
32574>>>>>>>>>                        Move aData[iRow][1] to aSuggestions[iFound].aValues[1]
32575>>>>>>>>>                        Increment iFound
32576>>>>>>>>>                    End
32576>>>>>>>>>>
32576>>>>>>>>>                    Else Begin
32577>>>>>>>>>                        Move (bFullText or iFound = 0) to bContinue
32578>>>>>>>>>                    End
32578>>>>>>>>>>
32578>>>>>>>>>                    
32578>>>>>>>>>                    Increment iRow
32579>>>>>>>>>                Loop
32580>>>>>>>>>>
32580>>>>>>>>>            End
32580>>>>>>>>>>
32580>>>>>>>>>        End
32580>>>>>>>>>>
32580>>>>>>>>>         
32580>>>>>>>>>    End_Procedure
32581>>>>>>>>>    

35585>>>>>>>        Send AddClient to (ViewStack(Self)) Self    // add this to the set of web view stack listners
35586>>>>>>>    End_Procedure
35587>>>>>>>
35587>>>>>>>       
35587>>>>>>>    // Send this method to fire a client action to refresh the breadcrumb items.
35587>>>>>>>    Procedure FullRefresh
35589>>>>>>>        Integer i iCount
35589>>>>>>>        tWebViewInfo[] aViewStack
35589>>>>>>>        tWebViewInfo[] aViewStack
35590>>>>>>>        tWebBreadcrumbItem[] aItems
35590>>>>>>>        tWebBreadcrumbItem[] aItems
35591>>>>>>>        String[] aParams
35592>>>>>>>        
35592>>>>>>>        //  Load the items
35592>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
35593>>>>>>>        Move (SizeOfArray(aViewStack)) to iCount
35594>>>>>>>        
35594>>>>>>>        For i from 0 to (iCount-1)
35600>>>>>>>>
35600>>>>>>>            Move aViewStack[i].sViewName      to aItems[i].sViewName
35601>>>>>>>            Move aViewStack[i].sCaption       to aItems[i].sCrumbCaption
35602>>>>>>>            Move aViewStack[i].sHeaderCaption to aItems[i].sHeadCaption
35603>>>>>>>        Loop
35604>>>>>>>>
35604>>>>>>>        
35604>>>>>>>        Send CancelClientAction "refresh"
35605>>>>>>>        Send CancelClientAction "clear"
35606>>>>>>>
35606>>>>>>>        //  Add client message
35606>>>>>>>        If (iCount > 0) Begin
35608>>>>>>>            Move "" to aParams[0]        
35609>>>>>>>            Send ClientAction "refresh" aParams aItems
35610>>>>>>>        End
35610>>>>>>>>
35610>>>>>>>        Else Begin
35611>>>>>>>            Send ClientAction "clear"
35612>>>>>>>        End        
35612>>>>>>>>
35612>>>>>>>    End_Procedure
35613>>>>>>>
35613>>>>>>>    

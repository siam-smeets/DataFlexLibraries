39068>>>>>
39068>>>>>/*The resource manager facilitates file streaming for files outside of the AppHtml folder. It can generate URLs that allow downloading of files that are not server directly by IIS. These URLs can be bound to a specific session (so they will only work for that specific browser session). Note that folders need to be registered before download URLs or upload keys can be generated.*/
39068>>>>>Class cWebResourceManager is a cWebComponent
39069>>>>>    
39069>>>>>    Procedure Construct_Object
39071>>>>>        Forward Send Construct_Object
39073>>>>>        
39073>>>>>        Send Define_cWebResourceManager_mixin
39074>>>>>        
39074>>>>>        Move Self to ghoWebResourceManager
39075>>>>>        Delegate Set phoResourceManager to Self
39077>>>>>        
39077>>>>>        //  Used for encryption of the keys by EncryptKey & DecryptKey
39077>>>>>        Object oDataCrypter is a cCryptographerEx
39079>>>>>            Set piHash to CALG_SHA_256
39080>>>>>            Set piCipher to CALG_AES_256
39081>>>>>            Set psProvider to ""    //  Not providing a specific provider gives the default provider for the provider type
39082>>>>>            Set piProvider to PROV_RSA_AES
39083>>>>>        End_Object
39084>>>>>        
39084>>>>>        Property Integer piDownloadTimeout 0                //  The number of hours that the download URL stays valid (0 = infinite)
39085>>>>>        Property Boolean pbDownloadBindSession True         //  If true the download URL will only work for this session
39086>>>>>        
39086>>>>>        Property Boolean pbAllowNonSessionDownloads False   //  If true non session bound download URLs are allowed
39087>>>>>    End_Procedure
39088>>>>>    
39088>>>>>    Import_Class_Protocol cWebResourceManager_mixin
39089>>>>>    
39089>>>>>    // Generates a download URL for a local file. This URL will point to a handler that will 
39089>>>>>    // stream the file to the client.
39089>>>>>    //
39089>>>>>    // Params:
39089>>>>>    //      sPath   The absolute local file path.
39089>>>>>    Function DownloadURL String sPath Returns String
39091>>>>>        String sUrl
39091>>>>>        Integer iTimout
39091>>>>>        Boolean bBindSession
39091>>>>>        
39091>>>>>        Get piDownloadTimeout to iTimout
39092>>>>>        Get pbDownloadBindSession to bBindSession
39093>>>>>        
39093>>>>>        Get CustomDownloadURL sPath False "" bBindSession iTimout to sUrl
39094>>>>>        
39094>>>>>        Function_Return sUrl
39095>>>>>    End_Function
39096>>>>>    
39096>>>>>    // Advanced method for generating a download URL for a local file. This URL will point to a 
39096>>>>>    // handler that will stream the file to the client.
39096>>>>>    //
39096>>>>>    // {psResourceUrl}/{sDownloadFileName}?attach={bAttachment}&key={hash}  
39096>>>>>    //
39096>>>>>    // Params:
39096>>>>>    //      sPath               The absolute local file path.
39096>>>>>    //      bAttachment         Determines if the file will be streamed as attachment or inline. 
39096>>>>>    //                          Streaming as attachment will show the 'save as' dialog.
39096>>>>>    //      sDownloadFileName   Allows to send the file with a custom name instead of a default 
39096>>>>>    //                          file name.
39096>>>>>    //      bBindSession        If true the download URL will only work for the current session.
39096>>>>>    //      iTimeout            Number of hours that the URL stays valid.
39096>>>>>    //
39096>>>>>    Function CustomDownloadURL String sPath Boolean bAttachment String sDownloadFileName Boolean bBindSession Integer iTimeout Returns String
39098>>>>>        String sVal sCode sKey sResource sUrl
39098>>>>>        DateTime dtTimeout
39098>>>>>        Date dChanged
39098>>>>>        TimeSpan tsDiff
39098>>>>>        Boolean bExists bValid
39098>>>>>        Integer iH iM iSec iTime iPos
39098>>>>>        
39098>>>>>        //  Check if exists
39098>>>>>        File_Exist sPath bExists
39099>>>>>        If (not(pbAllowInvalidDownloadUrl(Self))) Begin
39101>>>>>            If (not(bExists)) Begin
39103>>>>>                Error DFERR_PROGRAM "Generating url for file that does not exist"
39104>>>>>>
39104>>>>>                Function_Return ""
39105>>>>>            End
39105>>>>>>
39105>>>>>            
39105>>>>>            //  Check if valid download folder
39105>>>>>            Get IsAllowedDownloadFolder sPath to bValid
39106>>>>>            If (not(bValid)) Begin
39108>>>>>                Error DFERR_PROGRAM "Generating url for unregistered download folder"
39109>>>>>>
39109>>>>>                Function_Return ""
39110>>>>>            End
39110>>>>>>
39110>>>>>        End
39110>>>>>>
39110>>>>>        
39110>>>>>        //  If the resource is session bound we add the session key to the hash for verificiation
39110>>>>>        If (bBindSession) Begin
39112>>>>>            Move "1" to sCode
39113>>>>>            Get psSessionKey of (SessionManager(Self)) to sVal
39114>>>>>                         
39114>>>>>            Move (sVal + "||") to sKey
39115>>>>>        End
39115>>>>>>
39115>>>>>        Else Begin
39116>>>>>            Move "0" to sCode
39117>>>>>        End
39117>>>>>>
39117>>>>>        
39117>>>>>        //  If the resource is only temporary available we add the expiration date & time
39117>>>>>        If (iTimeout > 0) Begin
39119>>>>>            Move (sCode + "1") to sCode    
39120>>>>>            Move (DateSetDay(tsDiff, iTimeout / 24)) to tsDiff
39121>>>>>            Move (DateSetHour(tsDiff, Mod(iTimeout, 24))) to tsDiff
39122>>>>>            Move (CurrentDateTime() + tsDiff) to dtTimeout
39123>>>>>            Move (sKey + String(dtTimeout) + "||") to sKey
39124>>>>>        End
39124>>>>>>
39124>>>>>        Else Begin
39125>>>>>            Move (sCode + "0") to sCode
39126>>>>>        End
39126>>>>>>
39126>>>>>        
39126>>>>>        
39126>>>>>        //  Add code to the key
39126>>>>>        Move (sCode + "||" + sKey + sPath) to sKey
39127>>>>>        
39127>>>>>        
39127>>>>>        //  Add file changed date-time to the key to prevent caching issues
39127>>>>>        If (bExists) Begin
39129>>>>>            Get_File_Mod_Time sPath to dChanged iH iM iSec
39133>>>>>            Move ((iH * 3600) + (iM * 60) + iSec) to iTime
39134>>>>>        End
39134>>>>>>
39134>>>>>        Move (sKey + "||" + String(Integer(dChanged)) + "-" + String(iTime)) to sKey
39135>>>>>                
39135>>>>>        //  Encrypt the key
39135>>>>>        Get EncryptKey sKey to sResource
39136>>>>>        
39136>>>>>        //  If no download name is given we use actual name
39136>>>>>        If (sDownloadFileName = "") Begin
39138>>>>>            Move (RightPos("\", sPath)) to iPos
39139>>>>>            Move (Right(sPath, Length(sPath) - iPos)) to sDownloadFileName
39140>>>>>        End
39140>>>>>>
39140>>>>>        
39140>>>>>        //  Assemble URL
39140>>>>>        Get psResourceUrl to sUrl
39141>>>>>        If (Right(sUrl, 1) <> "/") Begin
39143>>>>>            Move (sUrl + "/") to sUrl
39144>>>>>        End
39144>>>>>>
39144>>>>>        
39144>>>>>        Function_Return (sUrl + sDownloadFileName + "?" + If(bAttachment, "attach=true&", "") + "key=" + sResource)
39145>>>>>    End_Function
39146>>>>>    
39146>>>>>    
39146>>>>>    //  This function is called by the cWebResourceManagerProxy to parse the resource string and retrieve the local file path.
39146>>>>>    Function FileDownload String sResource String ByRef sPath Integer ByRef iHttpErr String ByRef sHttpError Returns Boolean
39148>>>>>        Boolean bRes
39148>>>>>        String sKey sSessionKey
39148>>>>>        String[] aKey
39149>>>>>        Integer iSegment
39149>>>>>        DateTime dtTimeout
39149>>>>>        
39149>>>>>        Move 1 to iSegment
39150>>>>>        
39150>>>>>        //  Decript the resource key
39150>>>>>        Get DecryptKey sResource to sKey
39151>>>>>        Get StrSplit sKey "||" to aKey
39152>>>>>        If (SizeOfArray(aKey) >= 2) Begin
39154>>>>>            //  Validate session            
39154>>>>>            If (Left(aKey[0], 1) = "1") Begin
39156>>>>>                Get ReadSessionKey of (Host(Self)) to sSessionKey
39157>>>>>                
39157>>>>>                //  Validate the session key from the cookie
39157>>>>>                Get ValidateSession of (SessionManager(Self)) sSessionKey to bRes    
39158>>>>>                
39158>>>>>                If (aKey[iSegment] <> sSessionKey) Begin
39160>>>>>                    Move False to bRes
39161>>>>>                End
39161>>>>>>
39161>>>>>                
39161>>>>>                Increment iSegment
39162>>>>>            End
39162>>>>>>
39162>>>>>            Else Begin
39163>>>>>                Get pbAllowNonSessionDownloads to bRes
39164>>>>>            End
39164>>>>>>
39164>>>>>            
39164>>>>>            If (bRes) Begin            
39166>>>>>                If (SizeOfArray(aKey) > iSegment) Begin
39168>>>>>                    
39168>>>>>                    //  Validate expiration date & time
39168>>>>>                    If (Right(aKey[0], 1) = "1") Begin
39170>>>>>                        Move (aKey[iSegment]) to dtTimeout
39171>>>>>                        
39171>>>>>                        If (not(IsDateValid(dtTimeout)) or dtTimeout < CurrentDateTime()) Begin
39173>>>>>                            Move 410 to iHttpErr
39174>>>>>                            Move "URL Expired" to sHttpError
39175>>>>>                
39175>>>>>                            Function_Return False
39176>>>>>                        End
39176>>>>>>
39176>>>>>                        
39176>>>>>                        Increment iSegment
39177>>>>>                    End
39177>>>>>>
39177>>>>>                    
39177>>>>>                    //  Return the file path if succesfull
39177>>>>>                    If (SizeOfArray(aKey) > iSegment) Begin
39179>>>>>                        Get IsAllowedDownloadFolder aKey[iSegment] to bRes
39180>>>>>                        
39180>>>>>                        If (bRes) Begin
39182>>>>>                            File_Exist aKey[iSegment] bRes
39183>>>>>                            If (not(bRes)) Begin
39185>>>>>                                Move 404 to iHttpErr
39186>>>>>                                Move "File not found" to sHttpError
39187>>>>>                                
39187>>>>>                                Function_Return False
39188>>>>>                            End
39188>>>>>>
39188>>>>>                            
39188>>>>>                            Move aKey[iSegment] to sPath
39189>>>>>                            Function_Return True
39190>>>>>                        End
39190>>>>>>
39190>>>>>                        Else Begin
39191>>>>>                            //  Report error directly to the error log as the file streaming script will give an HTTP error (that would be disturbed if the error system would write html)
39191>>>>>                            Send ReportErrorEvent to ghInetSession DFERR_PROGRAM (SFormat("Attempt to download from unregistered download folder ('%1')", aKey[iSegment])) 0 0 0
39192>>>>>                            Move 403 to iHttpErr
39193>>>>>                            Move "Invalid download folder" to sHttpError
39194>>>>>                            Function_Return False
39195>>>>>                        End
39195>>>>>>
39195>>>>>                    End
39195>>>>>>
39195>>>>>                End    
39195>>>>>>
39195>>>>>            End
39195>>>>>>
39195>>>>>            Else Begin
39196>>>>>                Move 401 to iHttpErr
39197>>>>>                Move "Invalid session" to sHttpError
39198>>>>>                Function_Return False
39199>>>>>            End
39199>>>>>>
39199>>>>>        End
39199>>>>>>
39199>>>>>        
39199>>>>>        Move 400 to iHttpErr
39200>>>>>        Move "Invalid key" to sHttpError
39201>>>>>        Function_Return False
39202>>>>>    End_Function

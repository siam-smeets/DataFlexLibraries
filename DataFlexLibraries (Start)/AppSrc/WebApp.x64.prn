29610>>>>>>>>>>>                        End
29610>>>>>>>>>>>>
29610>>>>>>>>>>>                        Else If (SizeOfArray(parsedata.ucCurrentChunk) > 0) Begin
29613>>>>>>>>>>>                            Send OnFileChunk sFieldname (&parsedata.ucCurrentChunk)
29614>>>>>>>>>>>                        End
29614>>>>>>>>>>>>
29614>>>>>>>>>>>                    End
29614>>>>>>>>>>>>
29614>>>>>>>>>>>                    

7282>>>>>>>>>>>/*Class for processing ini files. It parses an ini into memory and can serialize it. Use ParseString or ReadFromFile to load ini data, use Stringify or WriteToFile to generate / save the data. Use functions like SetValue and GetValue to read / manipulate valeus.*/
7282>>>>>>>>>>>Class cIniProcessor is a cObject
7283>>>>>>>>>>>    
7283>>>>>>>>>>>    Procedure Construct_Object
7285>>>>>>>>>>>        Forward Send Construct_Object
7287>>>>>>>>>>>        
7287>>>>>>>>>>>        Property String psAssignChar "="
7288>>>>>>>>>>>        
7288>>>>>>>>>>>        /*        Determines if key and section names are treated as case sensitive or not. Note that this         property should not be changed at runtime during usage of the class. Set before calling         ReadFromFile / ParseString / ClearData.        */
7288>>>>>>>>>>>        Property Boolean pbCaseSensitive False
7289>>>>>>>>>>>        
7289>>>>>>>>>>>        /*        Determines if errors should be thrown if the ini file does not exist. Overriden by the         cIniFile compatibility class.        */
7289>>>>>>>>>>>        Property Boolean pbReportReadErrors True 
7290>>>>>>>>>>>        
7290>>>>>>>>>>>        /*        Determines if quotes surrounding the values need to be auto stripped.        */
7290>>>>>>>>>>>        Property Boolean pbRemoveQuotes True 
7291>>>>>>>>>>>        
7291>>>>>>>>>>>        Property String private_psFileName ""
7292>>>>>>>>>>>        
7292>>>>>>>>>>>        Property tIniSection[] paIniData
7293>>>>>>>>>>>    End_Procedure
7294>>>>>>>>>>>    
7294>>>>>>>>>>>    Procedure Set psFileName String sValue
7296>>>>>>>>>>>        Set private_psFileName to sValue
7297>>>>>>>>>>>        Send ClearData
7298>>>>>>>>>>>    End_Procedure
7299>>>>>>>>>>>    
7299>>>>>>>>>>>    Function psFileName String sValue Returns String
7301>>>>>>>>>>>        Function_Return (private_psFileName(Self))
7302>>>>>>>>>>>    End_Function
7303>>>>>>>>>>>    
7303>>>>>>>>>>>    /*    Clears the data in memory, use this to start creation of a new ini file.    */
7303>>>>>>>>>>>    Procedure ClearData
7305>>>>>>>>>>>        tIniSection[] aEmpty
7305>>>>>>>>>>>        tIniSection[] aEmpty
7306>>>>>>>>>>>        Set paIniData to aEmpty
7307>>>>>>>>>>>    End_Procedure
7308>>>>>>>>>>>    
7308>>>>>>>>>>>    /*    Reads an ini file from disk. If no file name is passed the psFileName property will be used, if     a filename is passed the psFileName will be updated. Returns true if the file is succesfully     read and parsed.         */
7308>>>>>>>>>>>    Function ReadFromFile String sOptFileName Returns Boolean
7310>>>>>>>>>>>        Integer iChnl
7310>>>>>>>>>>>        String sFileName sBOMCheck
7310>>>>>>>>>>>        Boolean bExists
7310>>>>>>>>>>>        String[] aLines
7311>>>>>>>>>>>        
7311>>>>>>>>>>>        //  Update filename if parameter is passed
7311>>>>>>>>>>>        If (num_arguments > 0) ;            Set private_psFileName to sOptFileName
7314>>>>>>>>>>>        
7314>>>>>>>>>>>        Send ClearData
7315>>>>>>>>>>>        Get private_psFileName to sFileName
7316>>>>>>>>>>>        
7316>>>>>>>>>>>        //  Checks
7316>>>>>>>>>>>        If (Trim(sFileName)="") Begin
7318>>>>>>>>>>>            Error DFERR_INI_FILE "Ini file name not defined"
7319>>>>>>>>>>>>
7319>>>>>>>>>>>            Function_Return False
7320>>>>>>>>>>>        End
7320>>>>>>>>>>>>
7320>>>>>>>>>>>        
7320>>>>>>>>>>>        File_Exist sFileName bExists
7321>>>>>>>>>>>        If (not(bExists)) Begin
7323>>>>>>>>>>>            If (pbReportReadErrors(Self)) ;                Error DFERR_INI_FILE "Could not open file for reading, file does not exist."
7326>>>>>>>>>>>            Function_Return False
7327>>>>>>>>>>>        End
7327>>>>>>>>>>>>
7327>>>>>>>>>>>        
7327>>>>>>>>>>>        //  Read the file
7327>>>>>>>>>>>        Get Seq_New_Channel to iChnl
7328>>>>>>>>>>>        If (iChnl = DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
7330>>>>>>>>>>>            If (pbReportReadErrors(Self)) ;                Error DFERR_INI_FILE "Could not open file, no channel available."
7333>>>>>>>>>>>            Function_Return False
7334>>>>>>>>>>>        End
7334>>>>>>>>>>>>
7334>>>>>>>>>>>                
7334>>>>>>>>>>>        Direct_Input channel iChnl sFileName
7336>>>>>>>>>>>        
7336>>>>>>>>>>>        //  Skip BOM if there
7336>>>>>>>>>>>        Read_Block sBOMCheck (SizeOfString(C_BOM_UTF8))
7337>>>>>>>>>>>        If (sBOMCheck <> C_BOM_UTF8) Begin
7339>>>>>>>>>>>            Set_Channel_Position iChnl to 0 
7340>>>>>>>>>>>>
7340>>>>>>>>>>>        End
7340>>>>>>>>>>>>
7340>>>>>>>>>>>        
7340>>>>>>>>>>>        Repeat
7340>>>>>>>>>>>>
7340>>>>>>>>>>>            Readln aLines[-1]
7341>>>>>>>>>>>        Until (SeqEof)
7343>>>>>>>>>>>        
7343>>>>>>>>>>>        If (SizeOfArray(aLines) > 0 and aLines[SizeOfArray(aLines) - 1] = "") ;            Move (RemoveFromArray(aLines, SizeOfArray(aLines) - 1)) to aLines
7346>>>>>>>>>>>        
7346>>>>>>>>>>>        Close_Input channel iChnl
7348>>>>>>>>>>>        
7348>>>>>>>>>>>        Send Seq_Release_Channel iChnl
7349>>>>>>>>>>>        
7349>>>>>>>>>>>        //  Parse the data
7349>>>>>>>>>>>        Send Parse (&aLines)
7350>>>>>>>>>>>        
7350>>>>>>>>>>>        Function_Return True
7351>>>>>>>>>>>    End_Function
7352>>>>>>>>>>>    
7352>>>>>>>>>>>    /*    Parses the passed ini data into memory.    */
7352>>>>>>>>>>>    Procedure ParseString String sIniData
7354>>>>>>>>>>>        String[] aLines
7355>>>>>>>>>>>        
7355>>>>>>>>>>>        Send ClearData
7356>>>>>>>>>>>        
7356>>>>>>>>>>>        // Normalize line endings to single LF
7356>>>>>>>>>>>        Move (Replaces(Character(13) + Character(10), sIniData, Character(10))) to sIniData
7357>>>>>>>>>>>        
7357>>>>>>>>>>>        // Split into array
7357>>>>>>>>>>>        Move (StrSplitToArray(sIniData, Character(10))) to aLines
7358>>>>>>>>>>>        
7358>>>>>>>>>>>        Send Parse (&aLines)
7359>>>>>>>>>>>    End_Procedure
7360>>>>>>>>>>>    
7360>>>>>>>>>>>    Procedure Parse String[] ByRef aLines 
7362>>>>>>>>>>>        Boolean bSuccess bSkip
7362>>>>>>>>>>>        String sLine sChar
7362>>>>>>>>>>>        Integer iLine iLineTo iPos iSection iValue
7362>>>>>>>>>>>        tIniSection[] aIniData
7362>>>>>>>>>>>        tIniSection[] aIniData
7363>>>>>>>>>>>        tIniSection newSec
7363>>>>>>>>>>>        tIniSection newSec
7363>>>>>>>>>>>        tIniValue newVal emptyVal
7363>>>>>>>>>>>        tIniValue newVal emptyVal
7363>>>>>>>>>>>        
7363>>>>>>>>>>>        Move (SizeOfArray(aLines) - 1) to iLineTo
7364>>>>>>>>>>>        For iLine from 0 to iLineTo
7370>>>>>>>>>>>>
7370>>>>>>>>>>>            Move emptyVal to newVal
7371>>>>>>>>>>>            Move False to bSkip
7372>>>>>>>>>>>            Move (Ltrim(aLines[iLine])) to sLine
7373>>>>>>>>>>>            Move (Left(sLine, 1)) to sChar
7374>>>>>>>>>>>            
7374>>>>>>>>>>>            If (sChar = "[") Begin
7376>>>>>>>>>>>                Move (Pos("]", sLine)) to iPos
7377>>>>>>>>>>>                If (iPos > 0) Begin
7379>>>>>>>>>>>                    Move (Trim(Mid(sLine, iPos - 2, 2))) to newSec.sName
7380>>>>>>>>>>>                    If (not(pbCaseSensitive(Self))) Begin
7382>>>>>>>>>>>                        Move newSec.sName to newSec.sCaseName
7383>>>>>>>>>>>                        Move (Uppercase(newSec.sName)) to newSec.sName
7384>>>>>>>>>>>                    End
7384>>>>>>>>>>>>
7384>>>>>>>>>>>                    
7384>>>>>>>>>>>                    Move (SearchArray(newSec, aIniData, False)) to iSection
7385>>>>>>>>>>>                    If (iSection = -1) Begin
7387>>>>>>>>>>>                        Move (SizeOfArray(aIniData)) to iSection
7388>>>>>>>>>>>                        Move newSec to aIniData[iSection]
7389>>>>>>>>>>>                    End
7389>>>>>>>>>>>>
7389>>>>>>>>>>>                                                            
7389>>>>>>>>>>>                    Move True to bSkip
7390>>>>>>>>>>>                End
7390>>>>>>>>>>>>
7390>>>>>>>>>>>            End
7390>>>>>>>>>>>>
7390>>>>>>>>>>>            
7390>>>>>>>>>>>            If (not(bSkip)) Begin
7392>>>>>>>>>>>                If (sChar  = ";" or sChar = "#") ; // Skip comment lines                    Move True to newVal.bComment
7395>>>>>>>>>>>                Else ;                    Move (Pos(psAssignChar(Self), sLine)) to iPos
7397>>>>>>>>>>>                
7397>>>>>>>>>>>                Move -1 to iValue
7398>>>>>>>>>>>                If (not(newVal.bComment) and iPos > 0) Begin
7400>>>>>>>>>>>                    Move (Trim(Left(sLine, iPos - 1))) to newVal.sName
7401>>>>>>>>>>>                    Move (LTrim(Right(sLine, Length(sLine) - iPos))) to newVal.sValue
7402>>>>>>>>>>>                    
7402>>>>>>>>>>>                    If (not(pbCaseSensitive(Self))) Begin
7404>>>>>>>>>>>                         Move newVal.sName to newVal.sCaseName
7405>>>>>>>>>>>                         Move (Uppercase(newVal.sName)) to newVal.sName
7406>>>>>>>>>>>                    End
7406>>>>>>>>>>>>
7406>>>>>>>>>>>                    
7406>>>>>>>>>>>                    If (SizeOfArray(aIniData) > iSection) ;                        Move (SearchArray(newVal, aIniData[iSection].aValues)) to iValue
7409>>>>>>>>>>>                End
7409>>>>>>>>>>>>
7409>>>>>>>>>>>                Else Begin
7410>>>>>>>>>>>                    // Probably whitespace or garbage, just preserve it
7410>>>>>>>>>>>                    Move sLine to newVal.sValue
7411>>>>>>>>>>>                    Move True to newVal.bComment
7412>>>>>>>>>>>                End
7412>>>>>>>>>>>>
7412>>>>>>>>>>>                
7412>>>>>>>>>>>                Move newVal to aIniData[iSection].aValues[iValue]
7413>>>>>>>>>>>            End
7413>>>>>>>>>>>>
7413>>>>>>>>>>>        Loop
7414>>>>>>>>>>>>
7414>>>>>>>>>>>        
7414>>>>>>>>>>>        Set paIniData to aIniData
7415>>>>>>>>>>>    End_Procedure
7416>>>>>>>>>>>    
7416>>>>>>>>>>>    /*    Returns the ini file in memory as a string.    */
7416>>>>>>>>>>>    Function Stringify Returns String
7418>>>>>>>>>>>        String[] aLines
7419>>>>>>>>>>>        
7419>>>>>>>>>>>        Get Serialize to aLines
7420>>>>>>>>>>>        
7420>>>>>>>>>>>        Function_Return (StrJoinFromArray(aLines, C_NewLine))
7421>>>>>>>>>>>    End_Function
7422>>>>>>>>>>>    
7422>>>>>>>>>>>    Function Serialize Returns String[]
7424>>>>>>>>>>>        Integer iSection iSectionTo iValue iValueTo
7424>>>>>>>>>>>        String[] aLines
7425>>>>>>>>>>>        tIniSection[] aIniData
7425>>>>>>>>>>>        tIniSection[] aIniData
7426>>>>>>>>>>>        
7426>>>>>>>>>>>        Get paIniData to aIniData
7427>>>>>>>>>>>        
7427>>>>>>>>>>>        Move (SizeOfArray(aIniData) - 1) to iSectionTo
7428>>>>>>>>>>>        For iSection from 0 to iSectionTo
7434>>>>>>>>>>>>
7434>>>>>>>>>>>            If (SizeOfArray(aIniData[iSection].aValues) > 0) Begin
7436>>>>>>>>>>>                If (Length(aIniData[iSection].sName) > 0) Begin
7438>>>>>>>>>>>                    If (pbCaseSensitive(Self)) ;                        Move ("[" + aIniData[iSection].sName + "]") to aLines[-1]
7441>>>>>>>>>>>                    Else ;                        Move ("[" + aIniData[iSection].sCaseName + "]") to aLines[-1]
7443>>>>>>>>>>>                End
7443>>>>>>>>>>>>
7443>>>>>>>>>>>                
7443>>>>>>>>>>>                Move (SizeOfArray(aIniData[iSection].aValues) - 1) to iValueTo
7444>>>>>>>>>>>                For iValue from 0 to iValueTo
7450>>>>>>>>>>>>
7450>>>>>>>>>>>                    If (aIniData[iSection].aValues[iValue].bComment) ;                        Move aIniData[iSection].aValues[iValue].sValue to aLines[-1]
7453>>>>>>>>>>>                    Else If (pbCaseSensitive(Self)) ;                        Move (aIniData[iSection].aValues[iValue].sName + psAssignChar(Self) + aIniData[iSection].aValues[iValue].sValue) to aLines[-1]
7457>>>>>>>>>>>                    Else ;                        Move (aIniData[iSection].aValues[iValue].sCaseName + psAssignChar(Self) + aIniData[iSection].aValues[iValue].sValue) to aLines[-1]
7459>>>>>>>>>>>                Loop
7460>>>>>>>>>>>>
7460>>>>>>>>>>>            
7460>>>>>>>>>>>            End
7460>>>>>>>>>>>>
7460>>>>>>>>>>>        Loop
7461>>>>>>>>>>>>
7461>>>>>>>>>>>        
7461>>>>>>>>>>>        Function_Return aLines
7462>>>>>>>>>>>    End_Function
7463>>>>>>>>>>>    
7463>>>>>>>>>>>    /*    Writes the ini data in memory out to a file. If no filename is passed the psFileName is used.    */
7463>>>>>>>>>>>    Procedure WriteToFile String sOptFileName
7465>>>>>>>>>>>        String[] aLines
7466>>>>>>>>>>>        String sFileName
7466>>>>>>>>>>>        Integer iChnl iLine iLinesTo
7466>>>>>>>>>>>        
7466>>>>>>>>>>>        If (num_arguments > 0) ;            Set private_psFileName to sOptFileName
7469>>>>>>>>>>>        
7469>>>>>>>>>>>        Get psFileName to sFileName
7470>>>>>>>>>>>        If (Trim(sFileName)="") Begin
7472>>>>>>>>>>>            Error DFERR_INI_FILE "Ini file name not defined"
7473>>>>>>>>>>>>
7473>>>>>>>>>>>            Procedure_Return
7474>>>>>>>>>>>        End
7474>>>>>>>>>>>>
7474>>>>>>>>>>>        
7474>>>>>>>>>>>        Get Seq_New_Channel to iChnl
7475>>>>>>>>>>>        Get Serialize to aLines
7476>>>>>>>>>>>        
7476>>>>>>>>>>>        If (iChnl = DF_SEQ_CHANNEL_NOT_AVAILABLE) Begin
7478>>>>>>>>>>>            Error DFERR_INI_FILE "Could not open file for writing, no channel available."
7479>>>>>>>>>>>>
7479>>>>>>>>>>>            Procedure_Return
7480>>>>>>>>>>>        End
7480>>>>>>>>>>>>
7480>>>>>>>>>>>        
7480>>>>>>>>>>>        Move False to Err
7481>>>>>>>>>>>        Direct_Output channel iChnl sFileName
7483>>>>>>>>>>>        
7483>>>>>>>>>>>        If (Err) Begin
7485>>>>>>>>>>>            Send Seq_Release_Channel iChnl
7486>>>>>>>>>>>            Procedure_Return
7487>>>>>>>>>>>        End
7487>>>>>>>>>>>>
7487>>>>>>>>>>>        
7487>>>>>>>>>>>        Move (SizeOfArray(aLines) - 1) to iLinesTo
7488>>>>>>>>>>>        For iLine from 0 to iLinesTo
7494>>>>>>>>>>>>
7494>>>>>>>>>>>            Writeln aLines[iLine]
7496>>>>>>>>>>>        Loop
7497>>>>>>>>>>>>
7497>>>>>>>>>>>        
7497>>>>>>>>>>>        Close_Output channel iChnl
7499>>>>>>>>>>>        Send Seq_Release_Channel iChnl
7500>>>>>>>>>>>        
7500>>>>>>>>>>>    End_Procedure
7501>>>>>>>>>>>    
7501>>>>>>>>>>>    Function FindSection String sName Returns Integer
7503>>>>>>>>>>>        tIniSection[] aIniData
7503>>>>>>>>>>>        tIniSection[] aIniData
7504>>>>>>>>>>>        tIniSection secSearch
7504>>>>>>>>>>>        tIniSection secSearch
7504>>>>>>>>>>>        
7504>>>>>>>>>>>        Get paIniData to aIniData
7505>>>>>>>>>>>        
7505>>>>>>>>>>>        If (pbCaseSensitive(Self)) ;            Move sName to secSearch.sName
7508>>>>>>>>>>>        Else ;            Move (Uppercase(sName)) to secSearch.sName
7510>>>>>>>>>>>        
7510>>>>>>>>>>>        Function_Return (SearchArray(secSearch, aIniData))        
7511>>>>>>>>>>>    End_Function
7512>>>>>>>>>>>    
7512>>>>>>>>>>>    Function FindKey tIniSection ByRef section String sName Returns Integer
7514>>>>>>>>>>>        tIniValue searchVal
7514>>>>>>>>>>>        tIniValue searchVal
7514>>>>>>>>>>>        Integer iKey
7514>>>>>>>>>>>        
7514>>>>>>>>>>>        If (pbCaseSensitive(Self)) ;            Move sName to searchVal.sName
7517>>>>>>>>>>>        Else ;            Move (Uppercase(sName)) to searchVal.sName
7519>>>>>>>>>>>        
7519>>>>>>>>>>>        Move (SearchArray(searchVal, section.aValues)) to iKey
7520>>>>>>>>>>>        
7520>>>>>>>>>>>        If (iKey = -1 or section.aValues[iKey].bComment) ;            Function_Return -1
7523>>>>>>>>>>>            
7523>>>>>>>>>>>        Function_Return iKey
7524>>>>>>>>>>>    End_Function
7525>>>>>>>>>>>    
7525>>>>>>>>>>>    /*    Sets a value on the ini data. If a key with the provided section and name already exists it     will be updated, else it will be added. If the section does not exist it will be created. Note     that this procedure works on the ini data in memory, call ReadFromFile to load an ini file from     disk and WriteToFile to apply the change.    */
7525>>>>>>>>>>>    Procedure SetValue String sSection String sKey String sValue
7527>>>>>>>>>>>        tIniSection[] aIniData
7527>>>>>>>>>>>        tIniSection[] aIniData
7528>>>>>>>>>>>        tIniSection secSearch
7528>>>>>>>>>>>        tIniSection secSearch
7528>>>>>>>>>>>        tIniValue searchVal
7528>>>>>>>>>>>        tIniValue searchVal
7528>>>>>>>>>>>        Integer iSection iKey
7528>>>>>>>>>>>        
7528>>>>>>>>>>>        Get paIniData to aIniData
7529>>>>>>>>>>>        
7529>>>>>>>>>>>        //  Search section
7529>>>>>>>>>>>        If (pbCaseSensitive(Self)) ;            Move sSection to secSearch.sName
7532>>>>>>>>>>>        Else Begin
7533>>>>>>>>>>>            Move (Uppercase(sSection)) to secSearch.sName
7534>>>>>>>>>>>            Move sSection to secSearch.sCaseName
7535>>>>>>>>>>>        End
7535>>>>>>>>>>>>
7535>>>>>>>>>>>        
7535>>>>>>>>>>>        Move (SearchArray(secSearch, aIniData)) to iSection
7536>>>>>>>>>>>        
7536>>>>>>>>>>>        //  Create section if not found
7536>>>>>>>>>>>        If (iSection = -1) Begin
7538>>>>>>>>>>>            Move (SizeOfArray(aIniData)) to iSection
7539>>>>>>>>>>>            
7539>>>>>>>>>>>            Move secSearch to aIniData[iSection]
7540>>>>>>>>>>>        End
7540>>>>>>>>>>>>
7540>>>>>>>>>>>        
7540>>>>>>>>>>>        //  Search value if not blank
7540>>>>>>>>>>>        If (sKey <> "") Begin
7542>>>>>>>>>>>           If (pbCaseSensitive(Self)) ;               Move sKey to searchVal.sName
7545>>>>>>>>>>>           Else Begin
7546>>>>>>>>>>>               Move (Uppercase(sKey)) to searchVal.sName
7547>>>>>>>>>>>               Move sKey to searchVal.sCaseName
7548>>>>>>>>>>>           End
7548>>>>>>>>>>>>
7548>>>>>>>>>>>           Move sValue to searchVal.sValue
7549>>>>>>>>>>>           
7549>>>>>>>>>>>           Move (SearchArray(searchVal, aIniData[iSection].aValues)) to iKey
7550>>>>>>>>>>>           
7550>>>>>>>>>>>           //  Insert of set value
7550>>>>>>>>>>>           If (iKey = -1) ;               Move (SizeOfArray(aIniData[iSection].aValues)) to iKey
7553>>>>>>>>>>>           
7553>>>>>>>>>>>           Move searchVal to aIniData[iSection].aValues[iKey]
7554>>>>>>>>>>>        End
7554>>>>>>>>>>>>
7554>>>>>>>>>>>        
7554>>>>>>>>>>>        Set paIniData to aIniData
7555>>>>>>>>>>>    End_Procedure
7556>>>>>>>>>>>    
7556>>>>>>>>>>>    /*    Reads a value from the ini file. The provided default value is retruned if the key and/or     section does not exist. Note that this works on the data in memory, call ReadFromFile to load an     ini file from disk.    */
7556>>>>>>>>>>>    Function GetValue String sSection String sKey String sDefault Returns String
7558>>>>>>>>>>>        tIniSection[] aIniData
7558>>>>>>>>>>>        tIniSection[] aIniData
7559>>>>>>>>>>>        Integer iSection iKey
7559>>>>>>>>>>>        
7559>>>>>>>>>>>        Get FindSection sSection to iSection
7560>>>>>>>>>>>        If (iSection = -1) ;            Function_Return sDefault
7563>>>>>>>>>>>      
7563>>>>>>>>>>>        Get paIniData to aIniData
7564>>>>>>>>>>>        Get FindKey (&aIniData[iSection]) sKey to iKey
7565>>>>>>>>>>>        If (iKey = -1) ;            Function_Return sDefault
7568>>>>>>>>>>>                
7568>>>>>>>>>>>        // Remove quotes as per Windows behavior.
7568>>>>>>>>>>>        If (pbRemoveQuotes(Self) and Left(aIniData[iSection].aValues[iKey].sValue, 1) = '"' and Right(aIniData[iSection].aValues[iKey].sValue, 1) = '"') Begin
7570>>>>>>>>>>>            Function_Return (Mid(aIniData[iSection].aValues[iKey].sValue, Length(aIniData[iSection].aValues[iKey].sValue) - 2, 2))
7571>>>>>>>>>>>        End
7571>>>>>>>>>>>>
7571>>>>>>>>>>>        
7571>>>>>>>>>>>        Function_Return aIniData[iSection].aValues[iKey].sValue
7572>>>>>>>>>>>    End_Function
7573>>>>>>>>>>>    
7573>>>>>>>>>>>    /*    Returns true if a section exists on the ini data.  Note that this works on the data in     memory, call ReadFromFile to load an ini file from disk.    */
7573>>>>>>>>>>>    Function HasSection String sSection Returns Boolean
7575>>>>>>>>>>>        Integer iSection 
7575>>>>>>>>>>>        
7575>>>>>>>>>>>        Get FindSection sSection to iSection
7576>>>>>>>>>>>        Function_Return (iSection <> -1)
7577>>>>>>>>>>>    End_Function
7578>>>>>>>>>>>    
7578>>>>>>>>>>>    /*    Checks if a key exists in the ini data.  Note that this works on the data in     memory, call ReadFromFile to load an ini file from disk.    */
7578>>>>>>>>>>>    Function HasKey String sSection String sKey Returns Boolean
7580>>>>>>>>>>>        tIniSection[] aIniData
7580>>>>>>>>>>>        tIniSection[] aIniData
7581>>>>>>>>>>>        Integer iSection iKey
7581>>>>>>>>>>>        
7581>>>>>>>>>>>        Get FindSection sSection to iSection
7582>>>>>>>>>>>        If (iSection = -1) ;            Function_Return False
7585>>>>>>>>>>>      
7585>>>>>>>>>>>        Get paIniData to aIniData
7586>>>>>>>>>>>        Get FindKey (&aIniData[iSection]) sKey to iKey
7587>>>>>>>>>>>        Function_Return (iKey <> -1)
7588>>>>>>>>>>>    End_Function
7589>>>>>>>>>>>    
7589>>>>>>>>>>>    /*    Deletes a section and all of its keys from the ini data. To apply the changes to disk call     WriteToFile.    */
7589>>>>>>>>>>>    Procedure RemoveSection String sSection
7591>>>>>>>>>>>        tIniSection[] aIniData
7591>>>>>>>>>>>        tIniSection[] aIniData
7592>>>>>>>>>>>        Integer iSection iKey
7592>>>>>>>>>>>        
7592>>>>>>>>>>>        Get FindSection sSection to iSection
7593>>>>>>>>>>>        If (iSection <> -1) Begin
7595>>>>>>>>>>>            Get paIniData to aIniData
7596>>>>>>>>>>>       
7596>>>>>>>>>>>            Move (RemoveFromArray(aIniData, iSection)) to aIniData
7597>>>>>>>>>>>            Set paIniData to aIniData
7598>>>>>>>>>>>        End
7598>>>>>>>>>>>>
7598>>>>>>>>>>>    End_Procedure
7599>>>>>>>>>>>    
7599>>>>>>>>>>>    /*    Deletes a key from the ini data, an error will occur if the key did not exist. To apply the     changes to disk call WriteToFile.    */
7599>>>>>>>>>>>    Procedure RemoveKey String sSection String sKey
7601>>>>>>>>>>>        tIniSection[] aIniData
7601>>>>>>>>>>>        tIniSection[] aIniData
7602>>>>>>>>>>>        Integer iSection iKey
7602>>>>>>>>>>>        
7602>>>>>>>>>>>        Get FindSection sSection to iSection
7603>>>>>>>>>>>        If (iSection <> -1) Begin
7605>>>>>>>>>>>            Get paIniData to aIniData
7606>>>>>>>>>>>            Get FindKey (&aIniData[iSection]) sKey to iKey
7607>>>>>>>>>>>            If (iKey <> -1) Begin
7609>>>>>>>>>>>                Move (RemoveFromArray(aIniData[iSection].aValues, iKey)) to aIniData[iSection].aValues
7610>>>>>>>>>>>                
7610>>>>>>>>>>>                //  Remove empty section
7610>>>>>>>>>>>                If (SizeOfArray(aIniData[iSection].aValues) = 0) ;                    Move (RemoveFromArray(aIniData, iSection)) to aIniData
7613>>>>>>>>>>>                
7613>>>>>>>>>>>                Set paIniData to aIniData
7614>>>>>>>>>>>            End
7614>>>>>>>>>>>>
7614>>>>>>>>>>>        End
7614>>>>>>>>>>>>
7614>>>>>>>>>>>    End_Procedure
7615>>>>>>>>>>>    
7615>>>>>>>>>>>    /*    Returns all sections that are defined in the ini data. Note that this works on the data in     memory, call ReadFromFile to load an ini file from disk.    */
7615>>>>>>>>>>>    Function Sections Returns String[]
7617>>>>>>>>>>>        tIniSection[] aIniData
7617>>>>>>>>>>>        tIniSection[] aIniData
7618>>>>>>>>>>>        Integer iSection iSectionTo
7618>>>>>>>>>>>        String[] aSections
7619>>>>>>>>>>>        
7619>>>>>>>>>>>        Get paIniData to aIniData
7620>>>>>>>>>>>        
7620>>>>>>>>>>>        Move (SizeOfArray(aIniData) - 1) to iSectionTo
7621>>>>>>>>>>>        For iSection from 0 to iSectionTo
7627>>>>>>>>>>>>
7627>>>>>>>>>>>            If (pbCaseSensitive(Self)) ;                Move aIniData[iSection].sName to aSections[iSection]
7630>>>>>>>>>>>            Else ;                Move aIniData[iSection].sCaseName to aSections[iSection]
7632>>>>>>>>>>>        Loop
7633>>>>>>>>>>>>
7633>>>>>>>>>>>        
7633>>>>>>>>>>>        Function_Return aSections
7634>>>>>>>>>>>    End_Function
7635>>>>>>>>>>>    
7635>>>>>>>>>>>    /*    Returns all keys available within the provided section. Note that this works on the data in     memory, call ReadFromFile to load an ini file from disk.    */
7635>>>>>>>>>>>    Function Keys String sSection Returns String[]
7637>>>>>>>>>>>        String[] aKeys
7638>>>>>>>>>>>        tIniSection[] aIniData
7638>>>>>>>>>>>        tIniSection[] aIniData
7639>>>>>>>>>>>        Integer iVal iValTo iSection
7639>>>>>>>>>>>        
7639>>>>>>>>>>>        Get FindSection sSection to iSection
7640>>>>>>>>>>>        If (iSection = -1) Begin
7642>>>>>>>>>>>            If (pbReportReadErrors(Self)) ;                Error DFERR_INI_FILE "Ini file section does not exist."
7645>>>>>>>>>>>        End
7645>>>>>>>>>>>>
7645>>>>>>>>>>>        Else Begin
7646>>>>>>>>>>>            Get paIniData to aIniData
7647>>>>>>>>>>>            Move (SizeOfArray(aIniData[iSection].aValues) - 1) to iValTo
7648>>>>>>>>>>>            
7648>>>>>>>>>>>            For iVal from 0 to iValTo
7654>>>>>>>>>>>>
7654>>>>>>>>>>>                If (not(aIniData[iSection].aValues[iVal].bComment)) Begin
7656>>>>>>>>>>>                    If (pbCaseSensitive(Self)) ;                        Move aIniData[iSection].aValues[iVal].sName to aKeys[iVal]
7659>>>>>>>>>>>                    Else ;                        Move aIniData[iSection].aValues[iVal].sCaseName to aKeys[iVal]
7661>>>>>>>>>>>                End
7661>>>>>>>>>>>>
7661>>>>>>>>>>>            Loop
7662>>>>>>>>>>>>
7662>>>>>>>>>>>        End
7662>>>>>>>>>>>>
7662>>>>>>>>>>>        
7662>>>>>>>>>>>        Function_Return aKeys
7663>>>>>>>>>>>    End_Function
7664>>>>>>>>>>>    
7664>>>>>>>>>>>End_Class
7665>>>>>>>>>>>
7665>>>>>>>>>>>
7665>>>>>>>>>>>/*Reads and writes ini files directly. Is compatible with the classic cIniFile.*/
7665>>>>>>>>>>>Class cIniFile is a cIniProcessor
7666>>>>>>>>>>>    Procedure Construct_Object
7668>>>>>>>>>>>        Forward Send Construct_Object
7670>>>>>>>>>>>        
7670>>>>>>>>>>>        Set pbReportReadErrors to False
7671>>>>>>>>>>>    End_Procedure
7672>>>>>>>>>>>    
7672>>>>>>>>>>>    Function OpenForWrite Returns Boolean
7674>>>>>>>>>>>        Boolean bSuccess bExists
7674>>>>>>>>>>>        
7674>>>>>>>>>>>        File_Exist (psFileName(Self)) bExists
7675>>>>>>>>>>>        
7675>>>>>>>>>>>        If (bExists) Begin
7677>>>>>>>>>>>            Get ReadFromFile to bSuccess
7678>>>>>>>>>>>            If (not(bSuccess)) ;                Function_Return False
7681>>>>>>>>>>>        End
7681>>>>>>>>>>>>
7681>>>>>>>>>>>        Else Begin
7682>>>>>>>>>>>            If (trim(psFileName(Self))="") Begin
7684>>>>>>>>>>>                Error DFERR_INI_FILE "Ini file name not defined"
7685>>>>>>>>>>>>
7685>>>>>>>>>>>                Function_Return False
7686>>>>>>>>>>>            End
7686>>>>>>>>>>>>
7686>>>>>>>>>>>        End
7686>>>>>>>>>>>>
7686>>>>>>>>>>>        
7686>>>>>>>>>>>        Function_Return True
7687>>>>>>>>>>>    End_Function
7688>>>>>>>>>>>    
7688>>>>>>>>>>>    /*    Writes a string directly to an ini file. Note that when setting multiple values it is more     efficient to use ReadFromFile, SetValue and WriteToFile separately.    */
7688>>>>>>>>>>>    Procedure WriteString String sSection String sKey String sValue
7690>>>>>>>>>>>        If (OpenForWrite(Self)) Begin
7692>>>>>>>>>>>            Send SetValue sSection sKey sValue
7693>>>>>>>>>>>        
7693>>>>>>>>>>>            Send WriteToFile
7694>>>>>>>>>>>        End
7694>>>>>>>>>>>>
7694>>>>>>>>>>>    End_Procedure
7695>>>>>>>>>>>    
7695>>>>>>>>>>>    /*    Reads a string directly to an ini file. Note that when reading multiple values it is more     efficient to call ReadFromFile and GetValue separately.    */
7695>>>>>>>>>>>    Function ReadString String sSection String sKey String sDefault Returns String
7697>>>>>>>>>>>        Boolean bSuccess
7697>>>>>>>>>>>        String sResult
7697>>>>>>>>>>>        
7697>>>>>>>>>>>        Move sDefault to sResult
7698>>>>>>>>>>>        
7698>>>>>>>>>>>        If (ReadFromFile(Self)) ;            Get GetValue sSection sKey sDefault to sResult
7701>>>>>>>>>>>            
7701>>>>>>>>>>>        Function_Return sResult    
7702>>>>>>>>>>>    End_Function
7703>>>>>>>>>>>    
7703>>>>>>>>>>>    /*    Deletes a section from an ini file. Note that to perform multiple manipulations calling     ReadFromFile, RemoveSection and WriteToFile separately is more efficient.    */
7703>>>>>>>>>>>    Procedure DeleteSection String sSection
7705>>>>>>>>>>>        If (OpenForWrite(Self)) Begin
7707>>>>>>>>>>>            Send RemoveSection sSection
7708>>>>>>>>>>>        
7708>>>>>>>>>>>            Send WriteToFile
7709>>>>>>>>>>>        End
7709>>>>>>>>>>>>
7709>>>>>>>>>>>    End_Procedure
7710>>>>>>>>>>>    
7710>>>>>>>>>>>    /*    Deletes a key from an ini file. Note that to perform multiple manipulations calling     ReadFromFile, RemoveKey and WriteToFile separately is more efficient.    */
7710>>>>>>>>>>>    Procedure DeleteKey String sSection String sKey
7712>>>>>>>>>>>        If (OpenForWrite(Self)) Begin
7714>>>>>>>>>>>            Send RemoveKey sSection sKey
7715>>>>>>>>>>>        
7715>>>>>>>>>>>            Send WriteToFile
7716>>>>>>>>>>>        End
7716>>>>>>>>>>>>
7716>>>>>>>>>>>    End_Procedure
7717>>>>>>>>>>>    
7717>>>>>>>>>>>    /*    Checks if a key exists in an ini file. When checking for multiple keys it is more     efficient to call ReadFromFile and HasKey separately.    */
7717>>>>>>>>>>>    Function KeyExists String sSection String sKey Returns Boolean
7719>>>>>>>>>>>        If (ReadFromFile(Self)) ;            Function_Return (HasKey(Self, sSection, sKey))
7722>>>>>>>>>>>            
7722>>>>>>>>>>>        Function_Return False
7723>>>>>>>>>>>    End_Function
7724>>>>>>>>>>>    
7724>>>>>>>>>>>    /*    Checks if a section exists in an ini file. When checking for multiple keys it is more     efficient to call ReadFromFile and HasSection separately.    */
7724>>>>>>>>>>>    Function SectionExists String sSection Returns Boolean
7726>>>>>>>>>>>        If (ReadFromFile(Self)) ;            Function_Return (HasSection(Self, sSection))
7729>>>>>>>>>>>            
7729>>>>>>>>>>>        Function_Return False
7730>>>>>>>>>>>    End_Function
7731>>>>>>>>>>>    
7731>>>>>>>>>>>    /*    Reads the sections into the provided array object. Here for compatibility only, please use the     Sections function that returns an array.    */
7731>>>>>>>>>>>    Procedure ReadSections Handle hoArray
7733>>>>>>>>>>>        String[] aSections
7734>>>>>>>>>>>        Integer iSection iSectionTo
7734>>>>>>>>>>>        
7734>>>>>>>>>>>        If (not(ReadFromFile(Self))) ;            Procedure_Return
7737>>>>>>>>>>>            
7737>>>>>>>>>>>        Get Sections to aSections
7738>>>>>>>>>>>        
7738>>>>>>>>>>>        Move (SizeOfArray(aSections) - 1) to iSectionTo
7739>>>>>>>>>>>        For iSection from 0 to iSectionTo
7745>>>>>>>>>>>>
7745>>>>>>>>>>>            Set Value of hoArray iSection to aSections[iSection]
7746>>>>>>>>>>>        Loop
7747>>>>>>>>>>>>
7747>>>>>>>>>>>    End_Procedure
7748>>>>>>>>>>>    
7748>>>>>>>>>>>    /*    Reads the keys of a section into the provided array object. Here for compatibility only,     please use the Keys function that retuns an array.    */
7748>>>>>>>>>>>    Procedure ReadSection String sSection Handle hoArray
7750>>>>>>>>>>>        String[] aKeys
7751>>>>>>>>>>>        Integer iKey iKeyTo
7751>>>>>>>>>>>        
7751>>>>>>>>>>>        If (not(ReadFromFile(Self))) ;            Procedure_Return
7754>>>>>>>>>>>        
7754>>>>>>>>>>>        Get Keys sSection to aKeys
7755>>>>>>>>>>>        
7755>>>>>>>>>>>        Move (SizeOfArray(aKeys) - 1) to iKeyTo
7756>>>>>>>>>>>        For iKey from 0 to iKeyTo
7762>>>>>>>>>>>>
7762>>>>>>>>>>>            Set Value of hoArray iKey to aKeys[iKey]
7763>>>>>>>>>>>        Loop
7764>>>>>>>>>>>>
7764>>>>>>>>>>>    End_Procedure
7765>>>>>>>>>>>End_Class
7766>>>>>>>>>
7766>>>>>>>>>Class cWorkspace is a cObject
7767>>>>>>>>>    
7767>>>>>>>>>    Procedure Construct_Object
7769>>>>>>>>>        Forward Send Construct_Object
7771>>>>>>>>>        
7771>>>>>>>>>        
7771>>>>>>>>>        Property String psAppSrcPath
7772>>>>>>>>>        Property String psBitmapPath
7773>>>>>>>>>        Property String psDataPath
7774>>>>>>>>>        Property String psDdSrcPath
7775>>>>>>>>>        Property String psDescription
7776>>>>>>>>>        Property String psFileList
7777>>>>>>>>>        Property String psHelpPath
7778>>>>>>>>>        Property String psHome
7779>>>>>>>>>        Property String psIdeSrcPath
7780>>>>>>>>>        Property String psProgramPath
7781>>>>>>>>>        Property String psAppHtmlPath
7782>>>>>>>>>        Property String psWorkspaceName
7783>>>>>>>>>        Property String psWorkspaceWSFile
7784>>>>>>>>>        Property String psConnectionIni
7785>>>>>>>>>        
7785>>>>>>>>>        Property String psSystemDfPath // took from the Registry!
7786>>>>>>>>>        Property String psSystemMakePath // took from the Registry!
7787>>>>>>>>>        Property String psDfPath        // Calculated
7788>>>>>>>>>        
7788>>>>>>>>>        Property Boolean pbWorkspaceOpened False // used internally to tell if we are switching workspaces
7789>>>>>>>>>        
7789>>>>>>>>>    End_Procedure
7790>>>>>>>>>    
7790>>>>>>>>>    Function FullPathNames String sShortPathNames Returns String
7792>>>>>>>>>        String sFileName
7792>>>>>>>>>        String sFullPathNames 
7792>>>>>>>>>        WString sFullPathName sShortPathName
7792>>>>>>>>>        Pointer lpsFilePart
7792>>>>>>>>>        Integer icChar // the number of characters returned
7792>>>>>>>>>        Integer iPos
7792>>>>>>>>>        
7792>>>>>>>>>        Move (Pos(";", sShortPathNames)) to iPos
7793>>>>>>>>>        While (length(sShortPathNames) >0)
7797>>>>>>>>>            If (iPos =0) Begin
7799>>>>>>>>>                Move sShortPathNames to sShortPathName
7800>>>>>>>>>                Move "" to sShortPathNames
7801>>>>>>>>>            End
7801>>>>>>>>>>
7801>>>>>>>>>            Else Begin // multiple paths
7802>>>>>>>>>                Move (Left(sShortPathNames, iPos -1)) to sShortPathName
7803>>>>>>>>>                Move (Right(sShortPathNames, length(sShortPathNames) -iPos)) to sShortPathNames // remove this path from the paths
7804>>>>>>>>>            End
7804>>>>>>>>>>
7804>>>>>>>>>            Move (Repeat(character(0), 4096)) to sFullPathName
7805>>>>>>>>>            Move -1 to lpsFilePart
7806>>>>>>>>>            Move (GetFullPathNameW(sShortPathName, 4096, AddressOf(sFullPathName), AddressOf(lpsFilePart))) to icChar
7807>>>>>>>>>            Append sFullPathNames (CString(sFullPathName))
7808>>>>>>>>>            If (sShortPathNames <>"") ;                Append sFullPathNames ";"
7811>>>>>>>>>            Move (Pos(";", sShortPathNames)) to iPos
7812>>>>>>>>>        Loop
7813>>>>>>>>>>
7813>>>>>>>>>        
7813>>>>>>>>>        Function_Return sFullPathNames
7814>>>>>>>>>    End_Function
7815>>>>>>>>>    
7815>>>>>>>>>    Function GetApplicationPath Returns String
7817>>>>>>>>>        // Returns the path of the Application (no trailing "\")
7817>>>>>>>>>        WString wApplicationFileName 
7817>>>>>>>>>        Boolean bRemoved
7817>>>>>>>>>        Integer iNumChars
7817>>>>>>>>>        String sFilename sPath
7817>>>>>>>>>        
7817>>>>>>>>>        Move (Repeat(Character(0), 1024)) to wApplicationFileName
7818>>>>>>>>>        Move (GetModuleFileNameW(0, AddressOf(wApplicationFileName), 1024)) to iNumChars
7819>>>>>>>>>        Move (CString(wApplicationFileName)) to wApplicationFileName
7820>>>>>>>>>        
7820>>>>>>>>>        Move (PathRemoveFileSpecW(AddressOf(wApplicationFileName))) to bRemoved
7821>>>>>>>>>        Move (CString(wApplicationFileName)) to sPath
7822>>>>>>>>>        
7822>>>>>>>>>        If (Right(sPath, 1) ="\") ;            Move (Left(sPath, Length(sPath) -1)) to sPath
7825>>>>>>>>>        Function_Return sPath
7826>>>>>>>>>    End_Function
7827>>>>>>>>>    
7827>>>>>>>>>    Procedure DoClearPaths
7829>>>>>>>>>        // Call this prior to changing from one WorkspAce to another
7829>>>>>>>>>        // if you don't, OpenWorkspaceFile will ignore the new paths.
7829>>>>>>>>>        Set psHome           to ""
7830>>>>>>>>>        Set psAppSrcPath     to ""
7831>>>>>>>>>        Set psBitmapPath     to ""
7832>>>>>>>>>        Set psDataPath       to ""
7833>>>>>>>>>        Set psDdSrcPath      to ""
7834>>>>>>>>>        Set psDescription    to ""
7835>>>>>>>>>        Set psFileList       to ""
7836>>>>>>>>>        Set psHelpPath       to ""
7837>>>>>>>>>        Set psIdeSrcPath     to ""
7838>>>>>>>>>        Set psAppHtmlPath    to ""
7839>>>>>>>>>        Set psProgramPath    to ""
7840>>>>>>>>>        Set psWorkspaceName  to ""
7841>>>>>>>>>        Set psSystemDfPath   to ""
7842>>>>>>>>>        Set psSystemMakePath to ""
7843>>>>>>>>>        Set psWorkspaceWSFile to ""
7844>>>>>>>>>        Set psConnectionIni to ""
7845>>>>>>>>>    End_Procedure
7846>>>>>>>>>    
7846>>>>>>>>>    Function OpenWorkspaceFile String sWorkspaceFile Returns Integer
7848>>>>>>>>>        WString wApplicationStartPath
7848>>>>>>>>>        String sWsName // name of Workspace is inferred from the Workspacefile name
7848>>>>>>>>>        Boolean bRemoved
7848>>>>>>>>>        Handle hoIniFile
7848>>>>>>>>>        Boolean bSuccess // call succeeded?
7848>>>>>>>>>        String sOldDirectory
7848>>>>>>>>>        String sSystemDfPath sSystemMakePath
7848>>>>>>>>>        Boolean bExist // does the WS file exist?
7848>>>>>>>>>        Boolean bChangingWorkspace
7848>>>>>>>>>        
7848>>>>>>>>>        String sHome sAppSrcPath sBitmapPath sDataPath sDdSrcPath sDescription sAppHtmlPath
7848>>>>>>>>>        String sFileList sHelpPath sIdeSrcPath sProgramPath sWorkspaceName sConnectionIni
7848>>>>>>>>>        
7848>>>>>>>>>        Set psWorkspaceWSFile to ""
7849>>>>>>>>>        If (sWorkspaceFile ="") ;            Function_Return wsWorkspaceFileNotFound
7852>>>>>>>>>        
7852>>>>>>>>>        // Append extension if not supplied...
7852>>>>>>>>>        If (Uppercase(Right(Trim(sWorkspaceFile),3)) <> ".WS") Begin
7854>>>>>>>>>            Move (sWorkspaceFile-".ws") to sWorkspaceFile
7855>>>>>>>>>        End
7855>>>>>>>>>>
7855>>>>>>>>>        
7855>>>>>>>>>        Get pbWorkspaceOpened to bChangingWorkspace // if we had an existing workspace. We are changing
7856>>>>>>>>>        
7856>>>>>>>>>        If (IsFilenameQualified(sWorkspaceFile) = False) Begin
7858>>>>>>>>>            // Set the properties to the paths of the Workspace
7858>>>>>>>>>            // Find the WS file (with program)...
7858>>>>>>>>>            Get GetApplicationPath to wApplicationStartPath
7859>>>>>>>>>            
7859>>>>>>>>>            Move sWorkspaceFile to sWsName
7860>>>>>>>>>            Move (wApplicationStartPath +"\" +sWorkspaceFile) to sWorkspaceFile
7861>>>>>>>>>        End
7861>>>>>>>>>>
7861>>>>>>>>>        Else Begin
7862>>>>>>>>>            Move (ExtractFileName(sWorkspaceFile)) to sWsName
7863>>>>>>>>>            
7863>>>>>>>>>            Move sWorkspaceFile to wApplicationStartPath
7864>>>>>>>>>            Move (PathRemoveFileSpecW(AddressOf(wApplicationStartPath))) to bRemoved
7865>>>>>>>>>        End
7865>>>>>>>>>>
7865>>>>>>>>>        
7865>>>>>>>>>        // Ensure that the file can be found...
7865>>>>>>>>>        //File_Exist (ToAnsi(sWorkspaceFile)) bExist        // [JVH] 8.3.8.0 Convert filename to Ansi
7865>>>>>>>>>        // [JVH] Turn off support for
7865>>>>>>>>>        // Ansi extended characters in workspace until we can
7865>>>>>>>>>        // resolve all open issues
7865>>>>>>>>>        Set psWorkspaceWSFile to sWorkspaceFile
7866>>>>>>>>>        File_Exist sWorkspaceFile bExist
7867>>>>>>>>>        If (bExist = False) ;            Function_Return wsWorkspaceFileNotFound
7870>>>>>>>>>        
7870>>>>>>>>>        Get psHome           to sHome
7871>>>>>>>>>        Get psAppSrcPath     to sAppSrcPath
7872>>>>>>>>>        Get psAppHtmlPath    to sAppHtmlPath
7873>>>>>>>>>        Get psBitmapPath     to sBitmapPath
7874>>>>>>>>>        Get psDataPath       to sDataPath
7875>>>>>>>>>        Get psDdSrcPath      to sDdSrcPath
7876>>>>>>>>>        Get psDescription    to sDescription
7877>>>>>>>>>        Get psFileList       to sFileList
7878>>>>>>>>>        Get psHelpPath       to sHelpPath
7879>>>>>>>>>        Get psIdeSrcPath     to sIdeSrcPath
7880>>>>>>>>>        Get psProgramPath    to sProgramPath
7881>>>>>>>>>        Get psSystemDfPath   to sSystemDfPath
7882>>>>>>>>>        Get psSystemMakePath to sSystemMakePath
7883>>>>>>>>>        Get psWorkspaceName  to sWorkspaceName
7884>>>>>>>>>        Get psConnectionIni to sConnectionIni
7885>>>>>>>>>        
7885>>>>>>>>>        Get_Current_Directory to sOldDirectory
7886>>>>>>>>>        // Note- this conversion is temporarily rolled back
7886>>>>>>>>>        //Move (SetCurrentDirectory(ToAnsi(CString(wApplicationStartPath)))) To bSuccess    // [JVH] 8.3.8.0 Convert AppStartPath to ANSI
7886>>>>>>>>>        Move (SetCurrentDirectory(CString(wApplicationStartPath))) to bSuccess
7887>>>>>>>>>        
7887>>>>>>>>>        Get Create U_cIniFile to hoIniFile
7888>>>>>>>>>        Set psFilename of hoIniFile to sWorkspaceFile
7889>>>>>>>>>        
7889>>>>>>>>>        If (sHome ="") ;            Get ReadString of hoIniFile "Workspace" "Home" ""          to sHome
7892>>>>>>>>>        If (sAppSrcPath ="") ;            Get ReadString of hoIniFile "Workspace" "AppSrcPath" ""    to sAppSrcPath
7895>>>>>>>>>        If (sAppHtmlPath ="") ;            Get ReadString of hoIniFile "Workspace" "AppHtmlPath" ""   to sAppHtmlPath
7898>>>>>>>>>        If (sBitmapPath ="") ;            Get ReadString of hoIniFile "Workspace" "BitmapPath" ""    to sBitmapPath
7901>>>>>>>>>        If (sDataPath ="") ;            Get ReadString of hoIniFile "Workspace" "DataPath" ""      to sDataPath
7904>>>>>>>>>        If (sDdSrcPath ="") ;            Get ReadString of hoIniFile "Workspace" "DdSrcPath" ""     to sDdSrcPath
7907>>>>>>>>>        If (sDescription ="") ;            Get ReadString of hoIniFile "Workspace" "Description" ""   to sDescription
7910>>>>>>>>>        If (sFileList ="") ;            Get ReadString of hoIniFile "Workspace" "FileList" ""      to sFileList
7913>>>>>>>>>        If (sHelpPath ="") ;            Get ReadString of hoIniFile "Workspace" "HelpPath" ""      to sHelpPath
7916>>>>>>>>>        If (sIdeSrcPath ="") ;            Get ReadString of hoIniFile "Workspace" "IdeSrcPath" ""    to sIdeSrcPath
7919>>>>>>>>>        If (sProgramPath ="") ;            Get ReadString of hoIniFile "Workspace" "ProgramPath" ""   to sProgramPath
7922>>>>>>>>>        If (sWorkspaceName ="") ;            Move (Left(sWsName, Length(sWsName) -3))                   to sWorkspaceName
7925>>>>>>>>>        If (sConnectionIni ="") ;            Get ReadString of hoIniFile "Workspace" "ConnectionIni" ""   to sConnectionIni
7928>>>>>>>>>        
7928>>>>>>>>>        If (sSystemDfPath ="") ;            Set psSystemDfPath   to (VdfSystemDfPath(Self))
7931>>>>>>>>>        If (sSystemMakePath ="") ;            Set psSystemMakePath to (VdfSystemMakePath(Self))
7934>>>>>>>>>        
7934>>>>>>>>>        Set psHome          to (FullPathNames(Self, sHome))
7935>>>>>>>>>        
7935>>>>>>>>>        // Set CWD to Home...
7935>>>>>>>>>        Move (SetCurrentDirectory(sHome)) to bSuccess
7936>>>>>>>>>        Set psAppSrcPath    to (FullPathNames(Self, sAppSrcPath))
7937>>>>>>>>>        Set psAppHtmlPath   to (FullPathNames(Self, sAppHtmlPath))
7938>>>>>>>>>        Set psBitmapPath    to (FullPathNames(Self, sBitmapPath))
7939>>>>>>>>>        Set psDataPath      to (FullPathNames(Self, sDataPath))
7940>>>>>>>>>        Set psDdSrcPath     to (FullPathNames(Self, sDdSrcPath))
7941>>>>>>>>>        Set psFileList      to (FullPathNames(Self, sFileList))
7942>>>>>>>>>        Set psHelpPath      to (FullPathNames(Self, sHelpPath))
7943>>>>>>>>>        Set psIdeSrcPath    to (FullPathNames(Self, sIdeSrcPath))
7944>>>>>>>>>        Set psProgramPath   to (FullPathNames(Self, sProgramPath))
7945>>>>>>>>>        Set psConnectionIni to (FullPathNames(Self, sConnectionIni))
7946>>>>>>>>>        
7946>>>>>>>>>        Set psWorkspaceName to sWorkspaceName
7947>>>>>>>>>        Set psDescription   to sDescription
7948>>>>>>>>>        
7948>>>>>>>>>        Send Destroy of hoIniFile // destroy dynaically created inifile object
7949>>>>>>>>>        
7949>>>>>>>>>        // Restore CWD...
7949>>>>>>>>>        Move (SetCurrentDirectory(sOldDirectory)) to sOldDirectory
7950>>>>>>>>>        
7950>>>>>>>>>        // Check for error conditions:
7950>>>>>>>>>        // DataPath and FileList must be defined; the FileList entry must point to a valid FileList.cfg
7950>>>>>>>>>        If (psDataPath(Self) = "") ;            Function_Return wsDataPathEmpty
7953>>>>>>>>>        If (psFileList(Self) = "") ;            Function_Return wsFileListEmpty
7956>>>>>>>>>        
7956>>>>>>>>>        Move (DoesFileExist(psFileList(Self))) to bExist
7957>>>>>>>>>        If (bExist = False) ;            Function_Return wsFileListNotExist
7960>>>>>>>>>        
7960>>>>>>>>>        If bChangingWorkspace ;            Close DF_ALL // if there is a WS open, we must close all the files
7963>>>>>>>>>        
7963>>>>>>>>>        Send DoAssignPaths // set psDfPath
7964>>>>>>>>>        Send DoSetPaths    // Set the application's Attributes of Filelist_Name and Open_Path
7965>>>>>>>>>        Set pbWorkspaceOpened to True
7966>>>>>>>>>        
7966>>>>>>>>>        Function_Return wsWorkspaceOpened
7967>>>>>>>>>    End_Function
7968>>>>>>>>>    
7968>>>>>>>>>    Function OpenWorkspace String sWorkspace Returns Integer
7970>>>>>>>>>        // Look in the Workspaces.ini file for the name, then open it by path
7970>>>>>>>>>        
7970>>>>>>>>>        Handle hoSections hoIniFile
7970>>>>>>>>>        Integer iWorkspace eOpened
7970>>>>>>>>>        String sWorkspaceName sPath
7970>>>>>>>>>        String sVdfRootDir
7970>>>>>>>>>        
7970>>>>>>>>>        Get Create U_Array    to hoSections
7971>>>>>>>>>        Get Create U_cIniFile to hoIniFile
7972>>>>>>>>>        
7972>>>>>>>>>        Get_Profile_String "Defaults" "VdfRootDir" to sVdfRootDir
7975>>>>>>>>>        If (Right(sVdfRootDir,1) <>"\") ;            Move (sVdfRootDir +"\") to sVdfRootDir
7978>>>>>>>>>        
7978>>>>>>>>>        Set psFilename of hoIniFile to (sVdfRootDir +"bin\Workspaces.ini")
7979>>>>>>>>>        
7979>>>>>>>>>        Send ReadSections of hoIniFile hoSections
7980>>>>>>>>>        
7980>>>>>>>>>        For iWorkspace from 0 to (Item_Count(hoSections) -1)
7986>>>>>>>>>>
7986>>>>>>>>>            Get Value of hoSections iWorkspace to sWorkspaceName
7987>>>>>>>>>            If (Uppercase(sWorkspaceName) = Uppercase(sWorkspace)) Begin
7989>>>>>>>>>                Get ReadString of hoIniFile sWorkspace "Path" "" to sPath
7990>>>>>>>>>                If (Right(sPath,1) <>"\") ;                    Move (sPath +"\") to sPath
7993>>>>>>>>>                
7993>>>>>>>>>                Get OpenWorkspaceFile (sPath + sWorkspace) to eOpened
7994>>>>>>>>>                Send Destroy of hoSections
7995>>>>>>>>>                Send Destroy of hoIniFile
7996>>>>>>>>>                Function_Return eOpened
7997>>>>>>>>>            End
7997>>>>>>>>>>
7997>>>>>>>>>        Loop
7998>>>>>>>>>>
7998>>>>>>>>>        
7998>>>>>>>>>        Send Destroy of hoSections
7999>>>>>>>>>        Send Destroy of hoIniFile
8000>>>>>>>>>        Function_Return wsWorkspaceNotFound
8001>>>>>>>>>    End_Function
8002>>>>>>>>>    
8002>>>>>>>>>    Function IsRegistered String sWorkspace Returns Boolean
8004>>>>>>>>>        Boolean bRegistered
8004>>>>>>>>>        Handle hoIniFile
8004>>>>>>>>>        String sVdfRootDir
8004>>>>>>>>>        
8004>>>>>>>>>        Get Create U_cIniFile to hoIniFile
8005>>>>>>>>>        
8005>>>>>>>>>        Get_Profile_String "Defaults" "VdfRootDir" to sVdfRootDir
8008>>>>>>>>>        If (Right(sVdfRootDir,1) <>"\") ;            Move (sVdfRootDir +"\") to sVdfRootDir
8011>>>>>>>>>        Set psFilename of hoIniFile to (sVdfRootDir +"bin\Workspaces.ini")
8012>>>>>>>>>        Move (SectionExists(hoIniFile, sWorkspace)) to bRegistered
8013>>>>>>>>>        
8013>>>>>>>>>        Send Destroy of hoIniFile
8014>>>>>>>>>        
8014>>>>>>>>>        Function_Return bRegistered
8015>>>>>>>>>    End_Function
8016>>>>>>>>>    
8016>>>>>>>>>    Function VdfSystemDfPath Returns String
8018>>>>>>>>>        String sSystemDfPath
8018>>>>>>>>>        Get_Profile_String "Workspaces" "SystemDfPath" to sSystemDfPath
8021>>>>>>>>>        
8021>>>>>>>>>        Function_Return sSystemDfPath
8022>>>>>>>>>    End_Function
8023>>>>>>>>>    
8023>>>>>>>>>    Function VdfSystemMakePath Returns String
8025>>>>>>>>>        String sSystemMakePath
8025>>>>>>>>>        Get_Profile_String "Workspaces" "SystemMakePath" to sSystemMakePath
8028>>>>>>>>>        
8028>>>>>>>>>        Function_Return sSystemMakePath
8029>>>>>>>>>    End_Function
8030>>>>>>>>>    
8030>>>>>>>>>    Procedure DoAssignPaths
8032>>>>>>>>>        String sDataPath sBitmapPath sHelpPath sProgramPath sSystemDfPath
8032>>>>>>>>>        
8032>>>>>>>>>        Get psDataPath     to sDataPath
8033>>>>>>>>>        Get psBitmapPath   to sBitmapPath
8034>>>>>>>>>        Get psHelpPath     to sHelpPath
8035>>>>>>>>>        Get psProgramPath  to sProgramPath
8036>>>>>>>>>        Get psSystemDfPath to sSystemDfPath
8037>>>>>>>>>        
8037>>>>>>>>>        Set psDfPath to (sDataPath +';' + sBitmapPath +';' + sHelpPath +';' + sProgramPath +';' + sSystemDfPath)
8038>>>>>>>>>        
8038>>>>>>>>>    End_Procedure
8039>>>>>>>>>    
8039>>>>>>>>>    Procedure DoSetPaths
8041>>>>>>>>>        // [JVH] must convert paths to Ansi before setting these values
8041>>>>>>>>>        // Note- this conversion is temporarily rolled back
8041>>>>>>>>>        //Set_Attribute DF_FILELIST_NAME To (ToAnsi(psFileList(self)))
8041>>>>>>>>>        //Set_Attribute DF_OPEN_PATH     To (ToAnsi(psDfPath(self)))
8041>>>>>>>>>        Set_Attribute DF_FILELIST_NAME to (psFileList(Self))
8044>>>>>>>>>        Set_Attribute DF_OPEN_PATH     to (psDfPath(Self))
8047>>>>>>>>>    End_Procedure
8048>>>>>>>>>    
8048>>>>>>>>>    Procedure EnumerateWorkspaceData Handle hoCallBack Handle hmGeneric
8050>>>>>>>>>        String sPath
8050>>>>>>>>>        
8050>>>>>>>>>        If (psWorkspaceName(Self)="") ;            Send hmGeneric to hoCallBack C_$WorkspaceNotUsed
8053>>>>>>>>>        Else Begin
8054>>>>>>>>>            Send hmGeneric to hoCallBack (SFormat(C_$WorkspaceDesc, psDescription(Self)))
8055>>>>>>>>>            Send hmGeneric to hoCallBack (SFormat(C_$WorkspaceName, psWorkspaceName(Self)))
8056>>>>>>>>>            Send hmGeneric to hoCallBack ""
8057>>>>>>>>>            Send hmGeneric to hoCallBack (SFormat(C_$Filelist, psFileList(Self)))
8058>>>>>>>>>            Send hmGeneric to hoCallBack (SFormat(C_$DataPath, psDataPath(Self)))
8059>>>>>>>>>            Send hmGeneric to hoCallBack (SFormat(C_$ProgramPath, psProgramPath(Self)))
8060>>>>>>>>>            Send hmGeneric to hoCallBack (SFormat(C_$HelpPath, psHelpPath(Self)))
8061>>>>>>>>>            Send hmGeneric to hoCallBack (SFormat(C_$BitmapsPath, psBitmapPath(Self)))
8062>>>>>>>>>            Send hmGeneric to hoCallBack (SFormat(C_$SystemPaths, psSystemDfPath(Self)))
8063>>>>>>>>>            Send hmGeneric to hoCallBack (SFormat(C_$FullDFPath, psDfPath(Self)))
8064>>>>>>>>>        End
8064>>>>>>>>>>
8064>>>>>>>>>    End_Procedure
8065>>>>>>>>>    
8065>>>>>>>>>    Function OpenWorkspaceErrorMessage Integer eErrorCode Returns String
8067>>>>>>>>>        // Decodes the enumerated integer returned by OpenWorkspace and
8067>>>>>>>>>        // returns a corresponding message string.
8067>>>>>>>>>        String sError
8067>>>>>>>>>        
8067>>>>>>>>>        Case Begin
8067>>>>>>>>>            Case (eErrorCode = wsWorkspaceOpened)
8069>>>>>>>>>                Move C_$NoErrors to sError
8070>>>>>>>>>                Case Break
8071>>>>>>>>>            Case (eErrorCode = wsWorkspaceNotFound)
8074>>>>>>>>>                Move C_$NoWsName to sError
8075>>>>>>>>>                Case Break
8076>>>>>>>>>            Case (eErrorCode = wsWorkspaceFileNotFound)
8079>>>>>>>>>                Move C_$NoWsFileFound to sError
8080>>>>>>>>>                Case Break
8081>>>>>>>>>            Case (eErrorCode = wsDataPathEmpty)
8084>>>>>>>>>                Move C_$NoWsDataPath to sError
8085>>>>>>>>>                Case Break
8086>>>>>>>>>            Case (eErrorCode = wsFileListEmpty)
8089>>>>>>>>>                Move C_$NoWsFileList to sError
8090>>>>>>>>>                Case Break
8091>>>>>>>>>            Case (eErrorCode = wsFileListNotExist)
8094>>>>>>>>>                Move C_$NoFileListCfg to sError
8095>>>>>>>>>                Case Break
8096>>>>>>>>>            Case Else
8096>>>>>>>>>                Move C_$UnknownError to sError
8097>>>>>>>>>                Case Break
8098>>>>>>>>>        Case End
8098>>>>>>>>>        
8098>>>>>>>>>        Function_Return (sError-".")
8099>>>>>>>>>    End_Function
8100>>>>>>>>>    
8100>>>>>>>>>    Function GetWorkspaceFileName String sWorkspace Returns String
8102>>>>>>>>>        // Returns the name of the physical Workspace file for the passed Workspace name.
8102>>>>>>>>>        String sVdfRootDir
8102>>>>>>>>>        Handle hoIniFile
8102>>>>>>>>>        String sPath

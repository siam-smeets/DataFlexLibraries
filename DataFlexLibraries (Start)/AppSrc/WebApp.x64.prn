35316>>>>>>>    //  Override the FillFromDDO and add an entry item for each parent record.
35316>>>>>>>    Procedure FillFromDDO
35318>>>>>>>        Handle hoServer hoDD
35318>>>>>>>        Integer iFile iField iIndex
35318>>>>>>>        String sRowId sDescription sEmptyItemDescription
35318>>>>>>>        Boolean bOldRelate bNeedsRelate
35318>>>>>>>        tWebComboItem[] atEmpty
35318>>>>>>>        tWebComboItem[] atEmpty
35319>>>>>>>        Boolean bAddEmptyItem
35319>>>>>>>        
35319>>>>>>>        Get Server to hoServer
35320>>>>>>>        Get Data_Field to iField
35321>>>>>>>        Get Data_File to iFile
35322>>>>>>>        Get piIndex to iIndex
35323>>>>>>>        
35323>>>>>>>        Set paComboItems to atEmpty
35324>>>>>>>        
35324>>>>>>>        If (hoServer > 0 and iFile > 0) Begin
35326>>>>>>>            //  Do security check
35326>>>>>>>            If (not(FillDEOAllowed(Self))) Begin
35328>>>>>>>                Procedure_Return
35329>>>>>>>            End
35329>>>>>>>>
35329>>>>>>>            
35329>>>>>>>            Get Data_Set of hoServer iFile to hoDD
35330>>>>>>>            
35330>>>>>>>            If (hoDD > 0) Begin
35332>>>>>>>                Get pbAddEmptyItem to bAddEmptyItem
35333>>>>>>>                If (bAddEmptyItem) Begin
35335>>>>>>>                    Get psEmptyItemDescription to sEmptyItemDescription
35336>>>>>>>                    Send AddComboItem (SerializeRowID(NullRowID())) sEmptyItemDescription
35337>>>>>>>                End
35337>>>>>>>>
35337>>>>>>>                
35337>>>>>>>                //  Use the field its prefered index
35337>>>>>>>                If (iIndex <= 0) Begin
35339>>>>>>>                    Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
35342>>>>>>>                End
35342>>>>>>>>
35342>>>>>>>                
35342>>>>>>>                //  If the field is not indexed we use the table its primary index
35342>>>>>>>                If (iIndex <= 0) Begin
35344>>>>>>>                    Get_Attribute DF_FILE_PRIMARY_INDEX of iFile to iIndex
35347>>>>>>>                End
35347>>>>>>>>
35347>>>>>>>                                 
35347>>>>>>>                // optimize relates. Only do it if needed
35347>>>>>>>                Get No_Relate_State of hoDD to bOldRelate
35348>>>>>>>                Get DDOConstraintNeedsRelate of hoDD iIndex to bNeedsRelate
35349>>>>>>>                Set No_Relate_State of hoDD to (not(bNeedsRelate))
35350>>>>>>>                Send Request_Read of hoDD FIRST_RECORD iFile iIndex
35351>>>>>>>                
35351>>>>>>>                While (Found)
35355>>>>>>>                    Get_Field_Value iFile iField to sDescription
35358>>>>>>>                    Send OnDefineDescription (&sDescription)
35359>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to sRowId
35360>>>>>>>                    Send AddComboItem sRowId (Trim(sDescription))
35361>>>>>>>                    
35361>>>>>>>                    Send Locate_Next of hoDD
35362>>>>>>>                Loop
35363>>>>>>>>
35363>>>>>>>                Set No_Relate_State of hoDD to bOldRelate
35364>>>>>>>           End
35364>>>>>>>>
35364>>>>>>>        End
35364>>>>>>>>
35364>>>>>>>    End_Procedure
35365>>>>>>>    
35365>>>>>>>    // Hook to customize a combo item's description.
35365>>>>>>>    Procedure OnDefineDescription String ByRef sDescription
35367>>>>>>>    End_Procedure

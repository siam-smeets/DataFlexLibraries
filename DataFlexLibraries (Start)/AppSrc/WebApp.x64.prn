15014>>>>>>>>>    // Create variant from buffer of utf16 data
15014>>>>>>>>>    Function VariantStrFromUTF16 Pointer pSource Returns Variant
15016>>>>>>>>>        Variant vValue
15016>>>>>>>>>        Pointer pvValue
15016>>>>>>>>>        Boolean bOk
15016>>>>>>>>>        Move "" to vValue
15017>>>>>>>>>        If (pSource) Begin
15019>>>>>>>>>            //Initialize pWstr variable so it has the correct type and AddressOf will return a proper pointer
15019>>>>>>>>>            //Initialize vValue variable so it has the correct type and AddressOf will return a proper pointer
15019>>>>>>>>>            Move 0 to vValue
15020>>>>>>>>>            Move (AddressOf(vValue)) to pvValue
15021>>>>>>>>>            //Change the Variant type to VT_BSTR
15021>>>>>>>>>            Move (StoreDw(pvValue,0,OLE_VT_Bstr)) to bOk

9759>>>>>>>>>    
9759>>>>>>>>>    // Handle an error that has occurred while checking properties.
9759>>>>>>>>>    Procedure HandleError Integer ihstmt Integer ihdbc String sDrvrId String sOriginMsg
9761>>>>>>>>>        Integer iErrHandle
9761>>>>>>>>>        Integer iErrNum
9761>>>>>>>>>        String  sLocationInfo
9761>>>>>>>>>        
9761>>>>>>>>>        // Get the DataFlex statement identifier
9761>>>>>>>>>        Move Self to iErrHandle
9762>>>>>>>>>        
9762>>>>>>>>>        // Determine error number
9762>>>>>>>>>        If (ihstmt = 0) ;            Move CLIERR_SQLINVALID_CLI_STMT_HANDLE to iErrNum
9765>>>>>>>>>        Else If (ihdbc = 0) ;            Move CLIERR_SQLINVALID_CLI_CONN_HANDLE to iErrNum
9769>>>>>>>>>        Else If (sDrvrId = "") ;            Move CLIERR_SQLINVALID_DRIVER_ID to iErrNum
9773>>>>>>>>>        Else ;            Move CLIERR_SQL_ERROR to iErrNum
9775>>>>>>>>>        
9775>>>>>>>>>        // Create location ifnormation
9775>>>>>>>>>        Move "[" to sLocationInfo
9776>>>>>>>>>        If (sOriginMsg <> "") Begin
9778>>>>>>>>>            Move (Append(sLocationInfo, sOriginMsg)) to sLocationInfo
9779>>>>>>>>>            Move (Append(sLocationInfo, ", "))       to sLocationInfo
9780>>>>>>>>>        End
9780>>>>>>>>>>
9780>>>>>>>>>        Move (Append(sLocationInfo, "DataFlex hstmt = ")) to sLocationInfo
9781>>>>>>>>>        Move (Append(sLocationInfo, iErrHandle))          to sLocationInfo
9782>>>>>>>>>        Move (Append(sLocationInfo, "]"))                 to sLocationInfo
9783>>>>>>>>>        
9783>>>>>>>>>        // Generate the error
9783>>>>>>>>>        Error iErrNum sLocationInfo
9784>>>>>>>>>>
9784>>>>>>>>>    End_Procedure
9785>>>>>>>>>    
9785>>>>>>>>>    // Handle general error not related to the properties
9785>>>>>>>>>    Procedure StmtError Integer iErrNum String sErrText String sOriginMsg
9787>>>>>>>>>        Integer iErrHandle
9787>>>>>>>>>        String  sLocationInfo
9787>>>>>>>>>        
9787>>>>>>>>>        // Get the DataFlex statement identifier
9787>>>>>>>>>        Move Self to iErrHandle
9788>>>>>>>>>        
9788>>>>>>>>>        // Create location information
9788>>>>>>>>>        Move "[" to sLocationInfo
9789>>>>>>>>>        If (sOriginMsg <> "") Begin
9791>>>>>>>>>            Move (Append(sLocationInfo, sOriginMsg)) to sLocationInfo
9792>>>>>>>>>            Move (Append(sLocationInfo, ", "))       to sLocationInfo
9793>>>>>>>>>        End
9793>>>>>>>>>>
9793>>>>>>>>>        If (sErrtext <> "") Begin
9795>>>>>>>>>            Move (Append(sLocationInfo, sErrtext)) to sLocationInfo
9796>>>>>>>>>            Move (Append(sLocationInfo, ", "))     to sLocationInfo
9797>>>>>>>>>        End
9797>>>>>>>>>>
9797>>>>>>>>>        Move (Append(sLocationInfo, "DataFlex hstmt = ")) to sLocationInfo
9798>>>>>>>>>        Move (Append(sLocationInfo, iErrHandle))          to sLocationInfo
9799>>>>>>>>>        Move (Append(sLocationInfo, "]"))                 to sLocationInfo
9800>>>>>>>>>        
9800>>>>>>>>>        // Generate the error
9800>>>>>>>>>        Error iErrNum sLocationInfo
9801>>>>>>>>>>
9801>>>>>>>>>    End_Procedure
9802>>>>>>>>>    
9802>>>>>>>>>    // Handle an illegal attribute error
9802>>>>>>>>>    Procedure SQLIllegalAttribute String sErrText String sOriginMsg
9804>>>>>>>>>        Integer bReport
9804>>>>>>>>>        
9804>>>>>>>>>        Get_Attribute DF_REPORT_UNSUPPORTED_ATTRIBUTES to bReport
9807>>>>>>>>>        If (bReport) ;            Send StmtError CLIERR_SQLINVALID_ATTRIBUTE sErrtext sOriginMsg
9810>>>>>>>>>    End_Procedure
9811>>>>>>>>>    
9811>>>>>>>>>    // Check if a column number is legal
9811>>>>>>>>>    Function SQLPrivateColumnIsLegal Integer ihdbc String sDrvrId Integer ihstmt Integer iCol Returns Integer
9813>>>>>>>>>        Integer bLegal
9813>>>>>>>>>        Integer iNumColumns
9813>>>>>>>>>        
9813>>>>>>>>>        Get SQLPrivateStmtAttribute SQLSTMTATTRIB_COLUMNCOUNT ihdbc sDrvrId ihstmt to iNumColumns
9814>>>>>>>>>        If (iCol > 0 and iCol <= iNumColumns) ;            Move DFTRUE to bLegal
9817>>>>>>>>>        Else ;            Move DFFALSE to bLegal
9819>>>>>>>>>        
9819>>>>>>>>>        Function_Return bLegal
9820>>>>>>>>>    End_Function
9821>>>>>>>>>    
9821>>>>>>>>>    
9821>>>>>>>>>    
9821>>>>>>>>>    // Close a statement and free all alllocated resources
9821>>>>>>>>>    Procedure SQLClose
9823>>>>>>>>>        Integer ihdbc
9823>>>>>>>>>        Integer ihstmt
9823>>>>>>>>>        Integer iVoid
9823>>>>>>>>>        String  sDrvrId
9823>>>>>>>>>        String  sEmpty
9823>>>>>>>>>        
9823>>>>>>>>>        // Initialize
9823>>>>>>>>>        Move "" to sEmpty
9824>>>>>>>>>        
9824>>>>>>>>>        // Get the cli handles
9824>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
9825>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
9826>>>>>>>>>        Get psDriverId            to sDrvrId
9827>>>>>>>>>        
9827>>>>>>>>>        // Free the CLI handle
9827>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
9829>>>>>>>>>            // Call the driver function to close
9829>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCLOSE ;                Callback Self ;                Passing ihdbc sEmpty ihstmt ;                Result iVoid
9834>>>>>>>>>            
9834>>>>>>>>>            Move -1 to giLastSQLhstmt
9835>>>>>>>>>            // Free the DataFlex handle
9835>>>>>>>>>            Send DestroySQLStatement
9836>>>>>>>>>        End
9836>>>>>>>>>>
9836>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLClose"
9838>>>>>>>>>    End_Procedure
9839>>>>>>>>>    
9839>>>>>>>>>    // Prepare a statement for execution
9839>>>>>>>>>    Procedure SQLPrepare String sStatement
9841>>>>>>>>>        Integer ihdbc
9841>>>>>>>>>        Integer ihstmt
9841>>>>>>>>>        Integer iVoid
9841>>>>>>>>>        String  sDrvrId
9841>>>>>>>>>        
9841>>>>>>>>>        // Get the cli handles
9841>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
9842>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
9843>>>>>>>>>        Get psDriverId            to sDrvrId
9844>>>>>>>>>        
9844>>>>>>>>>        // Prepare
9844>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
9846>>>>>>>>>            // Call the driver function to prepare
9846>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLPREPARE ;                Callback Self ;                Passing ihdbc sStatement ihstmt ;                Result iVoid
9851>>>>>>>>>            Set piLastArgument to 0
9852>>>>>>>>>
9852>>>>>>>>>        End
9852>>>>>>>>>>
9852>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrepare"
9854>>>>>>>>>    End_Procedure
9855>>>>>>>>>    
9855>>>>>>>>>    Procedure SQLGetStatementAttributes
9857>>>>>>>>>        Integer ihdbc ihstmt iNumColumns iCol iMaxSize
9857>>>>>>>>>        String sMaxValue
9857>>>>>>>>>        tSQLColumn[] aSQLColumns
9857>>>>>>>>>        tSQLColumn[] aSQLColumns
9858>>>>>>>>>        
9858>>>>>>>>>        Integer iSqlType
9858>>>>>>>>>        Integer iSQLSize
9858>>>>>>>>>        Integer iSQLprecision
9858>>>>>>>>>        Integer iVariableDataType
9858>>>>>>>>>        
9858>>>>>>>>>        String  sDrvrId
9858>>>>>>>>>        
9858>>>>>>>>>        Integer iHasVariableDataType
9858>>>>>>>>>        
9858>>>>>>>>>        Move 0 to iHasVariableDataType
9859>>>>>>>>>        
9859>>>>>>>>>        
9859>>>>>>>>>        // Get the cli handles
9859>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
9860>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
9861>>>>>>>>>        Get psDriverId            to sDrvrId
9862>>>>>>>>>        
9862>>>>>>>>>        Get SQLPrivateStmtAttribute SQLSTMTATTRIB_COLUMNCOUNT ihdbc sDrvrId ihstmt to iNumColumns
9863>>>>>>>>>        
9863>>>>>>>>>        Set piColumnCount to iNumColumns
9864>>>>>>>>>        
9864>>>>>>>>>        // Fill columns array
9864>>>>>>>>>        For iCol from 1 to iNumColumns
9870>>>>>>>>>>
9870>>>>>>>>>            Move 0 to iVariableDataType
9871>>>>>>>>>            
9871>>>>>>>>>            Get SQLPrivateColAttribute iCol SQLCOLATTRIB_SQLTYPE ihdbc sDrvrId ihstmt to iSQLType
9872>>>>>>>>>            Get SQLPrivateColAttribute iCol SQLCOLATTRIB_SIZE ihdbc sDrvrId ihstmt to iSQLSize
9873>>>>>>>>>            Get SQLPrivateColAttribute iCol SQLCOLATTRIB_PRECISION ihdbc sDrvrId ihstmt to iSQLPrecision
9874>>>>>>>>>            
9874>>>>>>>>>            If ( (iSQLType = SQL_LONGVARCHAR) or (iSQLType = SQL_WLONGVARCHAR) ) Begin
9876>>>>>>>>>                // text type
9876>>>>>>>>>                Move 1 to iVariableDataType
9877>>>>>>>>>            End
9877>>>>>>>>>>
9877>>>>>>>>>            Else Begin
9878>>>>>>>>>                If (sDrvrId = "MSSQLDRV") Begin
9880>>>>>>>>>                    // SQL Server varchar(max) and nvarchar(max) types return Size = 0
9880>>>>>>>>>                    If ( ((iSQLType = SQL_VARCHAR) and (iSQLSize = 0) ) or ;                        ((iSQLType = SQL_WVARCHAR) and (iSQLSize = 0) ) ) Begin
9882>>>>>>>>>                        
9882>>>>>>>>>                        Move 1 to iVariableDataType
9883>>>>>>>>>                    End
9883>>>>>>>>>>
9883>>>>>>>>>                End
9883>>>>>>>>>>
9883>>>>>>>>>            End
9883>>>>>>>>>>
9883>>>>>>>>>            
9883>>>>>>>>>            Move iSqlType           to aSQLColumns[iCol].iSQLType
9884>>>>>>>>>            Move iSQLSize           to aSQLColumns[iCol].iSQLSize
9885>>>>>>>>>            Move iSQLPrecision      to aSQLColumns[iCol].iSQLPrecision
9886>>>>>>>>>            Move iVariableDataType  to aSQLColumns[iCol].iVariableDataType
9887>>>>>>>>>            
9887>>>>>>>>>            If (not(iVariableDataType)) Begin
9889>>>>>>>>>                If (iSQLSize > iMaxSize) Begin
9891>>>>>>>>>                    Move iSQLSize to iMaxSize
9892>>>>>>>>>                End
9892>>>>>>>>>>
9892>>>>>>>>>            End
9892>>>>>>>>>>
9892>>>>>>>>>            Else Begin
9893>>>>>>>>>                Move 1 to iHasVariableDataType
9894>>>>>>>>>            End
9894>>>>>>>>>>
9894>>>>>>>>>            
9894>>>>>>>>>        Loop
9895>>>>>>>>>>
9895>>>>>>>>>        
9895>>>>>>>>>        Set paSQLColumns   to aSQLColumns
9896>>>>>>>>>        Set piHasVariableDataType to iHasVariableDataType
9897>>>>>>>>>        
9897>>>>>>>>>    End_Procedure
9898>>>>>>>>>    
9898>>>>>>>>>    // Execute a prepared statement
9898>>>>>>>>>    Procedure SQLExecute
9900>>>>>>>>>        Integer ihdbc
9900>>>>>>>>>        Integer ihstmt
9900>>>>>>>>>        Integer iVoid
9900>>>>>>>>>        String  sDrvrId
9900>>>>>>>>>        String  sEmpty
9900>>>>>>>>>        

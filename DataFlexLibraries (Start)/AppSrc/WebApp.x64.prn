10421>>>>>>>>>    Procedure SQLSetStmtAttribute Integer iAttribId String sAttribValue 
10423>>>>>>>>>
10423>>>>>>>>>        Integer ihdbc
10423>>>>>>>>>        Integer ihstmt
10423>>>>>>>>>        String  sDrvrId
10423>>>>>>>>>        
10423>>>>>>>>>        Integer iLen
10423>>>>>>>>>        Integer bLegalAttrib
10423>>>>>>>>>        Integer iVoid
10423>>>>>>>>>        Integer iAttribValue
10423>>>>>>>>>
10423>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10424>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10425>>>>>>>>>        Get psDriverId            to sDrvrId
10426>>>>>>>>>        
10426>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10428>>>>>>>>>            Case Begin
10428>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_CURSOR_TYPE)
10430>>>>>>>>>                    Move DFTRUE to bLegalAttrib
10431>>>>>>>>>                    Break
10432>>>>>>>>>                    
10432>>>>>>>>>                Case Else
10432>>>>>>>>>                    Move DFFALSE to bLegalAttrib
10433>>>>>>>>>                    Send SQLIllegalAttribute ("Attribute is = " + String(iAttribId) + ")") "SQLSetStmtAttribute"
10434>>>>>>>>>            Case End
10434>>>>>>>>>
10434>>>>>>>>>            If (bLegalAttrib) Begin
10436>>>>>>>>>                If (iAttribId = SQLSTMTATTRIB_CURSOR_TYPE) Begin
10438>>>>>>>>>                    
10438>>>>>>>>>                    Move sAttribValue to iAttribValue // Check numeric?
10439>>>>>>>>>                    Case Begin
10439>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_FORWARD_ONLY)
10441>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_DYNAMIC)
10444>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_KEYSET_DRIVEN)
10447>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_STATIC)
10450>>>>>>>>>                            Break
10451>>>>>>>>>                            
10451>>>>>>>>>                        Case Else
10451>>>>>>>>>                            Move DFFALSE to bLegalAttrib
10452>>>>>>>>>                            Send StmtError CLIERR_SQLINVALID_ATTRIBUTE (SFormat("Invalid value for SQLSTMTATTRIB_CURSOR_TYPE: %1", iAttribValue)) "SQLSetStmtAttribute"
10453>>>>>>>>>
10453>>>>>>>>>                    Case End
10453>>>>>>>>>                End
10453>>>>>>>>>>
10453>>>>>>>>>            End
10453>>>>>>>>>>
10453>>>>>>>>>
10453>>>>>>>>>            
10453>>>>>>>>>            If (bLegalAttrib) Begin
10455>>>>>>>>>                
10455>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                    Callback Self ;                    Passing ihdbc iVoid ihstmt ;                    Result iVoid
10460>>>>>>>>>                
10460>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLSETSTMTINTATTRIB ;                    Callback Self ;                    Passing iAttribId iAttribValue 0 ;                    Result iVoid
10465>>>>>>>>>            End
10465>>>>>>>>>>
10465>>>>>>>>>        End
10465>>>>>>>>>>
10465>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrivateStmtAttribute"
10467>>>>>>>>>        
10467>>>>>>>>>        
10467>>>>>>>>>        
10467>>>>>>>>>    End_Procedure

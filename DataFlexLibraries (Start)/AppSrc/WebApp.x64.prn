10593>>>>>>>>>    // Preapre for calling a stored procedure, pass the procedure name.
10593>>>>>>>>>    Procedure SQLSetProcedureName String sProcName String sSchemaArg
10595>>>>>>>>>        Integer ihdbc
10595>>>>>>>>>        Integer ihstmt
10595>>>>>>>>>        String  sDrvrId
10595>>>>>>>>>        Integer iVoid
10595>>>>>>>>>        String  sSchema
10595>>>>>>>>>        String  sEmpty
10595>>>>>>>>>        
10595>>>>>>>>>        // Initialize
10595>>>>>>>>>        Move "" to sEmpty
10596>>>>>>>>>        
10596>>>>>>>>>        // Get the cli handles
10596>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
10597>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
10598>>>>>>>>>        Get psDriverId            to sDrvrId
10599>>>>>>>>>        
10599>>>>>>>>>        // Call the procedure
10599>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
10601>>>>>>>>>            If (Num_Arguments >= 2) ;                Move sSchemaArg to sSchema
10604>>>>>>>>>            Else ;                Move "" to sSchema
10606>>>>>>>>>            
10606>>>>>>>>>            If (sSchema <> "") Begin
10608>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLSETPROCSCHEMA ;                    Callback Self ;                    Passing ihdbc sSchema ihstmt ;                    Result iVoid
10613>>>>>>>>>            End
10613>>>>>>>>>>
10613>>>>>>>>>            
10613>>>>>>>>>            // Call the procedure
10613>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLSETPROCNAME ;                Callback Self ;                Passing ihdbc sProcName ihstmt ;                Result iVoid
10618>>>>>>>>>            
10618>>>>>>>>>            Set piLastArgument to 0
10619>>>>>>>>>        End
10619>>>>>>>>>>
10619>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLSetProcedurename"
10621>>>>>>>>>    End_Procedure

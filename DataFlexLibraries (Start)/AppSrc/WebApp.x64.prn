9728>>>>>>>>>// Statement object for embedded sql                           
9728>>>>>>>>>//   An object is created for each statement. These will be children    
9728>>>>>>>>>//   of cSQLConnection objects which manage the create and destruction  
9728>>>>>>>>>//   of these.                                                          
9728>>>>>>>>>
9728>>>>>>>>>Class cSQLStatement is a cObject
9729>>>>>>>>>    
9729>>>>>>>>>    Procedure Construct_object
9731>>>>>>>>>        Forward Send Construct_object
9733>>>>>>>>>        
9733>>>>>>>>>        Property Handle  phCLIStatementHandle   0
9734>>>>>>>>>        Property Handle  phCLIConnectionHandle  0
9735>>>>>>>>>        Property String  psDriverID             ""
9736>>>>>>>>>        
9736>>>>>>>>>        Property Integer piLastColumn      0
9737>>>>>>>>>        Property Integer piLastArgument    0
9738>>>>>>>>>        Property Integer piBindFile        0
9739>>>>>>>>>        
9739>>>>>>>>>        Property Integer piColumnCount     0
9740>>>>>>>>>        
9740>>>>>>>>>        // True if there is at least 1 column with a variable length data type
9740>>>>>>>>>        Property Integer piHasVariableDataType  0
9741>>>>>>>>>        
9741>>>>>>>>>        // Max size of buffer for variable length data. Default 16000
9741>>>>>>>>>        Property Integer piMaxVariableBufferLength 16000
9742>>>>>>>>>        
9742>>>>>>>>>        // Allocated buffer for SQLGetData.
9742>>>>>>>>>        Property WString psVariableBuffer  ""
9743>>>>>>>>>        
9743>>>>>>>>>        // Allocated size of psVariableBuffer
9743>>>>>>>>>        Property Integer piVariableBufferLength 0
9744>>>>>>>>>        
9744>>>>>>>>>        // Stores column properties of a result set.
9744>>>>>>>>>        Property tSQLColumn[] paSQLColumns
9745>>>>>>>>>        
9745>>>>>>>>>        // piFetchResult is set by SQLFetchRowValues and SQLFetchResultSetValues
9745>>>>>>>>>        //   0    = Fetch returned no data.
9745>>>>>>>>>        //   <> 0 = Row fetched
9745>>>>>>>>>        Property Integer piFetchResult     0
9746>>>>>>>>>        
9746>>>>>>>>>        
9746>>>>>>>>>        Property String psDummyZeroDate              '0001-01-01'
9747>>>>>>>>>        Property String psDummyZeroDateMssqlDatetime '1753-01-01'
9748>>>>>>>>>        
9748>>>>>>>>>    End_Procedure
9749>>>>>>>>>    

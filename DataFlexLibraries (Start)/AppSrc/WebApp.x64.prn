12632>>>>>>>    
12632>>>>>>>    // The CreatexxxxxNode messages creates an node object for the type specified. Both
12632>>>>>>>    // the interface and the object or of the correct type (i.e. element, comment)
12632>>>>>>>    // These all return an object handle which can be used to place the object via
12632>>>>>>>    // appendNode or InsertBeforeNode
12632>>>>>>>    
12632>>>>>>>    // This function creates a child element, returning a dataflex object.
12632>>>>>>>    // The interface of the object returned can be used in AppendChild to add
12632>>>>>>>    // the element to the XML Document.
12632>>>>>>>    
12632>>>>>>>    Function CreateElementNode String sTagName String sValue Returns Handle
12634>>>>>>>        Handle hoNewElement
12634>>>>>>>        Handle hoDocumentObject
12634>>>>>>>        Handle infcNewElement
12634>>>>>>>        Integer iClassId
12634>>>>>>>        // The DataFlex objects are created inside the nodes (elements).
12634>>>>>>>        // Create an element in the document and assign its interface to the new DF object.
12634>>>>>>>        Get DocumentObject to hoDocumentObject
12635>>>>>>>        Get createElement of hoDocumentObject sTagName to infcNewElement
12636>>>>>>>        If infcNewElement Begin // if there was an error, no infc handle would be returned
12638>>>>>>>            Get NodeClassId of hoDocumentObject NODE_ELEMENT to iClassId
12639>>>>>>>            Get CreateXMLObject iClassId infcNewElement to hoNewElement
12640>>>>>>>            If hoNewElement ; // very unlikely this will be zero                Set psText of hoNewElement to sValue
12643>>>>>>>        End
12643>>>>>>>>
12643>>>>>>>        Function_Return hoNewElement
12644>>>>>>>    End_Function
12645>>>>>>>    
12645>>>>>>>    // This function creates an attribute in a document. Attributes are _NOT_ children of an element.
12645>>>>>>>    // A DataFlex object is returned. An attribute can be added to an xml document using
12645>>>>>>>    // get AddAttributeNode.
12645>>>>>>>    
12645>>>>>>>    Function CreateAttributeNode String sName String sValue Returns Handle
12647>>>>>>>        Handle hoNewAttribute
12647>>>>>>>        Handle hoDocumentObject
12647>>>>>>>        Handle infcNewAttribute
12647>>>>>>>        Integer iClassId
12647>>>>>>>        Get DocumentObject to hoDocumentObject
12648>>>>>>>        // Create an Attribute in the document and assign its interface to the new DF object.
12648>>>>>>>        Get createAttribute of hoDocumentObject sName to infcNewAttribute
12649>>>>>>>        If infcNewAttribute Begin // if there was an error, no infc handle would be returned
12651>>>>>>>            Get NodeClassId of hoDocumentObject NODE_ATTRIBUTE to iClassId
12652>>>>>>>            Get CreateXMLObject iClassId infcNewAttribute to hoNewAttribute
12653>>>>>>>            // Set the value of the attribute.
12653>>>>>>>            If hoNewAttribute ; // very unlikely this will be 0                Set psText of hoNewAttribute to sValue
12656>>>>>>>        End
12656>>>>>>>>
12656>>>>>>>        Function_Return hoNewAttribute
12657>>>>>>>    End_Function
12658>>>>>>>    
12658>>>>>>>    // This function creates a child comment, returning a dataflex object.
12658>>>>>>>    // The interface of the object returned can be used in AppendChild to add
12658>>>>>>>    // the comment to the XML Document.
12658>>>>>>>    
12658>>>>>>>    Function CreateChildComment String sValue Returns Handle
12660>>>>>>>        Handle hoNewComment
12660>>>>>>>        Handle hoDocumentObject
12660>>>>>>>        Handle infcNewComment
12660>>>>>>>        Integer iClassID
12660>>>>>>>        Get DocumentObject to hoDocumentObject
12661>>>>>>>        // Create an Comment in the document and assign its interface to the new DF object.
12661>>>>>>>        Get createComment of hoDocumentObject sValue to infcNewComment
12662>>>>>>>        If infcNewComment Begin // if there was an error, no infc handle would be returned
12664>>>>>>>            Get NodeClassId of hoDocumentObject NODE_COMMENT to iClassId
12665>>>>>>>            Get CreateXMLObject iClassId infcNewComment to hoNewComment
12666>>>>>>>            If hoNewComment ; // very unlikely this will be 0                Set psText of hoNewComment to sValue
12669>>>>>>>        End
12669>>>>>>>>
12669>>>>>>>        Function_Return hoNewComment
12670>>>>>>>    End_Function
12671>>>>>>>    
12671>>>>>>>    // This function creates a child processing instruction, returning a dataflex object.
12671>>>>>>>    // The interface of the object returned can be used in AppendChild to add
12671>>>>>>>    // the processing instruction to the XML Document.
12671>>>>>>>    
12671>>>>>>>    Function CreateChildProcessingInstruction String sTarget String sValue Returns Handle
12673>>>>>>>        Handle hoNewProcessingInstruction
12673>>>>>>>        Handle hoDocumentObject
12673>>>>>>>        Handle infcNewProcessingInstruction
12673>>>>>>>        Integer iClassID
12673>>>>>>>        Get DocumentObject to hoDocumentObject
12674>>>>>>>        // Create an ProcessingInstruction in the document and assign its interface to the new DF object.
12674>>>>>>>        Get createProcessingInstruction of hoDocumentObject sTarget sValue to infcNewProcessingInstruction
12675>>>>>>>        If infcNewProcessingInstruction  Begin // if there was an error, no infc handle would be returned
12677>>>>>>>            Get NodeClassId of hoDocumentObject NODE_PROCESSING_INSTRUCTION to iClassId
12678>>>>>>>            Get CreateXMLObject iClassID infcNewProcessingInstruction to hoNewProcessingInstruction
12679>>>>>>>        End
12679>>>>>>>>
12679>>>>>>>        Function_Return hoNewProcessingInstruction
12680>>>>>>>    End_Function
12681>>>>>>>    
12681>>>>>>>    // This function creates a child text node, returning a dataflex object.
12681>>>>>>>    // The interface of the object returned can be used in AppendChild to add
12681>>>>>>>    // the text node to the XML Document.
12681>>>>>>>    
12681>>>>>>>    Function CreateChildTextNode String sValue Returns Handle

38077>>>>>>>    Procedure OnSelectSuggestion tSuggestion Suggestion
38079>>>>>>>        Handle hoServer
38079>>>>>>>        Integer iFile iField iMode
38079>>>>>>>        Boolean bFind bSuccess
38079>>>>>>>        RowID rRowId
38079>>>>>>>        
38079>>>>>>>        Get Server to hoServer
38080>>>>>>>        Get Data_File  to iFile
38081>>>>>>>        Get Data_Field to iField       
38082>>>>>>>        
38082>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
38084>>>>>>>            If (pbSuggestions(Self)) Begin
38086>>>>>>>                Move (DeserializeRowID(Suggestion.sRowId)) to rRowId    
38087>>>>>>>                If (not(IsNullRowID(rRowId))) Begin
38089>>>>>>>                    Get FindByRowIdEx of hoServer iFile rRowId to bSuccess
38090>>>>>>>                    // this is very unlikely
38090>>>>>>>                    If not bSuccess Begin
38092>>>>>>>                        Error DFERR_CANT_REFIND_RECORD
38093>>>>>>>>
38093>>>>>>>                    End
38093>>>>>>>>
38093>>>>>>>                End
38093>>>>>>>>
38093>>>>>>>            End
38093>>>>>>>>
38093>>>>>>>            Else Begin
38094>>>>>>>                WebSet psValue to Suggestion.aValues[0]
38095>>>>>>>                WebSet pbChanged to True
38096>>>>>>>            End 
38096>>>>>>>>
38096>>>>>>>        End
38096>>>>>>>>
38096>>>>>>>    End_Procedure
38097>>>>>>>    
38097>>>>>>>    Procedure SelectSuggestion String sSearch
38099>>>>>>>        tSuggestion[] aData
38099>>>>>>>        tSuggestion[] aData
38100>>>>>>>        Handle hoJson hoAdvancedSearchView
38100>>>>>>>        
38100>>>>>>>        //  Deserialize the sent row
38100>>>>>>>        Get phoActionJsonData to hoJson
38101>>>>>>>        Get JsonToDataType of hoJson to aData
38102>>>>>>>        
38102>>>>>>>        If (SizeOfArray(aData) = 1) Begin
38104>>>>>>>            Send OnSelectSuggestion aData[0]
38105>>>>>>>        End
38105>>>>>>>>
38105>>>>>>>    End_Procedure
38106>>>>>>>        
38106>>>>>>>    Procedure End_Construct_Object
38108>>>>>>>        Forward Send End_Construct_Object
38110>>>>>>>        
38110>>>>>>>        WebPublishProcedure SelectSuggestion
38111>>>>>>>    End_Procedure

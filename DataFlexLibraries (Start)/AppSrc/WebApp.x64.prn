33686>>>>>>>    End_Procedure
33687>>>>>>>    
33687>>>>>>>    // Delete Logic to delete the current row pointed to by psCurrentRowId.
33687>>>>>>>    // returns True if the delete was successful.
33687>>>>>>>    Function DeleteSelectedRow Returns Integer
33689>>>>>>>        Handle hmVerify
33689>>>>>>>        Boolean bContinue
33689>>>>>>>        
33689>>>>>>>        Get pbAllowDeleteRow to bContinue
33690>>>>>>>        If (not(bContinue)) Begin
33692>>>>>>>            Error DFERR_OPERATION_NOT_ALLOWED
33693>>>>>>>>
33693>>>>>>>            Procedure_Return
33694>>>>>>>        End
33694>>>>>>>>
33694>>>>>>>        
33694>>>>>>>        Get Verify_Delete_msg to hmVerify
33695>>>>>>>        If (hmVerify) Begin
33697>>>>>>>            WebSet pbDeleteCallbackActive to True
33698>>>>>>>            Send VerifyRequest (RefProc(RequestDeleteCallBack)) (RefFunc(Verify_Delete_Msg))
33699>>>>>>>            Function_Return sroPending
33700>>>>>>>        End
33700>>>>>>>>
33700>>>>>>>        Else Begin
33701>>>>>>>            Send RequestDeleteExec
33702>>>>>>>            // we actually don't know if this will work or not, since this finds another row. For now, we say success
33702>>>>>>>        End
33702>>>>>>>>
33702>>>>>>>        Function_Return sroSucceed
33703>>>>>>>    End_Function
33704>>>>>>>    
33704>>>>>>>    Procedure RequestDeleteExec
33706>>>>>>>        Handle hoDD
33706>>>>>>>        RowID riSelectedRow
33706>>>>>>>        String[] aSelection
33707>>>>>>>        Integer iIndex iMainFile iOrdering
33707>>>>>>>        Boolean bDataAware bContinue bReverseOrdering
33707>>>>>>>        
33707>>>>>>>        WebGet paSelectedRowIds to aSelection
33708>>>>>>>        If (SizeOfArray(aSelection) = 0) Begin
33710>>>>>>>            Procedure_Return
33711>>>>>>>        End
33711>>>>>>>>
33711>>>>>>>        
33711>>>>>>>        Get pbAllowDeleteRow to bContinue
33712>>>>>>>        If (not(bContinue)) Begin
33714>>>>>>>            Error DFERR_OPERATION_NOT_ALLOWED
33715>>>>>>>>
33715>>>>>>>            Procedure_Return
33716>>>>>>>        End
33716>>>>>>>>
33716>>>>>>>        
33716>>>>>>>        Get pbDataAware to bDataAware
33717>>>>>>>        
33717>>>>>>>        If (bDataAware) Begin
33719>>>>>>>            // Perform the db-aware delete
33719>>>>>>>            Get Server to hoDD
33720>>>>>>>            Get Main_File of hoDD to iMainFile
33721>>>>>>>                
33721>>>>>>>            While (iIndex < SizeOfArray(aSelection))
33725>>>>>>>                Move (DeserializeRowID(aSelection[iIndex])) to riSelectedRow
33726>>>>>>>                
33726>>>>>>>                Get FindByRowIdEx of hoDD iMainFile riSelectedRow to bContinue
33727>>>>>>>                If (bContinue) Begin
33729>>>>>>>                    Get OnDeleteRow aSelection[iIndex] to bContinue
33730>>>>>>>                    If (bContinue) Begin
33732>>>>>>>                        Send Request_Delete to hoDD       // Perform the delete
33733>>>>>>>                        If (not(Err)) Begin
33735>>>>>>>                            Send RemoveRow aSelection[iIndex]      // Tell the client to remove the deleted row.
33736>>>>>>>                            Move (RemoveFromArray(aSelection, 0)) to aSelection
33737>>>>>>>                        End
33737>>>>>>>>
33737>>>>>>>                        Else Begin
33738>>>>>>>                            Increment iIndex
33739>>>>>>>                        End
33739>>>>>>>>
33739>>>>>>>                    End
33739>>>>>>>>
33739>>>>>>>                    Else Begin
33740>>>>>>>                        Increment iIndex
33741>>>>>>>                    End
33741>>>>>>>>
33741>>>>>>>                End
33741>>>>>>>>
33741>>>>>>>                Else Begin
33742>>>>>>>                    Increment iIndex
33743>>>>>>>                End
33743>>>>>>>>
33743>>>>>>>            Loop
33744>>>>>>>>
33744>>>>>>>            
33744>>>>>>>            // Select the next logical row
33744>>>>>>>            Get IndexOrder to iOrdering
33745>>>>>>>            WebGet pbReverseOrdering to bReverseOrdering
33746>>>>>>>    
33746>>>>>>>            If (bReverseOrdering) Begin
33748>>>>>>>                Send Establish_Find_Direction of hoDD LT iMainFile iOrdering 
33749>>>>>>>            End
33749>>>>>>>>
33749>>>>>>>            Else Begin
33750>>>>>>>                Send Establish_Find_Direction of hoDD GT iMainFile iOrdering 
33751>>>>>>>            End
33751>>>>>>>>
33751>>>>>>>            
33751>>>>>>>            Send Locate_Next of hoDD    // Try to find the row below the deleted row.
33752>>>>>>>            
33752>>>>>>>            If (not(Found)) Begin
33754>>>>>>>                // If the row below the deleted row was not found then it means we deleted the
33754>>>>>>>                // last row. Now we will try to load the new last row. If there are no remaining
33754>>>>>>>                // rows in the dataset then the buffer will be automatically cleared (which is 
33754>>>>>>>                // what we want)
33754>>>>>>>                If (bReverseOrdering) Begin
33756>>>>>>>                    Send Request_Read of hoDD FIRST_RECORD iMainFile iOrdering
33757>>>>>>>                End
33757>>>>>>>>
33757>>>>>>>                Else Begin
33758>>>>>>>                    Send Request_Read of hoDD LAST_RECORD iMainFile iOrdering
33759>>>>>>>                End
33759>>>>>>>>
33759>>>>>>>            End
33759>>>>>>>>
33759>>>>>>>            
33759>>>>>>>            If (Found) Begin
33761>>>>>>>                Send Request_Assign of hoDD iMainFile
33762>>>>>>>            End
33762>>>>>>>>
33762>>>>>>>            Else Begin
33763>>>>>>>                Send ClearGrid
33764>>>>>>>            End
33764>>>>>>>>
33764>>>>>>>            
33764>>>>>>>            Send UpdateCurrentRowID
33765>>>>>>>        End
33765>>>>>>>>
33765>>>>>>>        Else Begin
33766>>>>>>>            While (iIndex < SizeOfArray(aSelection))
33770>>>>>>>                Get OnDeleteRow aSelection[iIndex] to bContinue
33771>>>>>>>                If (bContinue) Begin
33773>>>>>>>                    Send RemoveRow aSelection[iIndex]      // Tell the client to remove the deleted row.
33774>>>>>>>                    Move (RemoveFromArray(aSelection, 0)) to aSelection
33775>>>>>>>                End
33775>>>>>>>>
33775>>>>>>>                Else Begin
33776>>>>>>>                    Increment iIndex
33777>>>>>>>                End
33777>>>>>>>>
33777>>>>>>>            Loop
33778>>>>>>>>
33778>>>>>>>        End
33778>>>>>>>>
33778>>>>>>>            
33778>>>>>>>        If (iIndex) Begin
33780>>>>>>>            Send OnMultipleRowsDeletionError aSelection
33781>>>>>>>        End
33781>>>>>>>>
33781>>>>>>>        
33781>>>>>>>        Set ListSelection to aSelection
33782>>>>>>>    End_Procedure
33783>>>>>>>    
33783>>>>>>>    Procedure OnMultipleRowsDeletionError String[] aNonDeletedSelection
33785>>>>>>>        If (pbThrowErrorIfDeleteFails(Self)) Begin
33787>>>>>>>            Error DFERR_CANT_DELETE_RECORD (SFormat(C_$FailedToDeleteNrRecords, SizeOfArray(aNonDeletedSelection)))
33788>>>>>>>>
33788>>>>>>>        End
33788>>>>>>>>
33788>>>>>>>    End_Procedure
33789>>>>>>>
33789>>>>>>>End_Class

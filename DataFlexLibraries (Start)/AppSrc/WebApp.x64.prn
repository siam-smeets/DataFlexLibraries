6836>>>>>>>>>    Procedure Construct_object
6838>>>>>>>>>        Integer iCh
6838>>>>>>>>>        Forward Send construct_object
6840>>>>>>>>>        Property String  psCurrencySymbol
6841>>>>>>>>>        Set psCurrencySymbol to (Default_Currency_Symbol())
6842>>>>>>>>>        
6842>>>>>>>>>        Property String  psLeft
6843>>>>>>>>>        Property String  psright
6844>>>>>>>>>        Property Integer pbThousandsSep
6845>>>>>>>>>        Property Integer piPoints
6846>>>>>>>>>        
6846>>>>>>>>>        Property String  psCurPosLeft
6847>>>>>>>>>        Property String  psCurPosright
6848>>>>>>>>>        Property Integer pbCurPosThousandsSep
6849>>>>>>>>>        Property Integer piCurPosPoints
6850>>>>>>>>>        
6850>>>>>>>>>        Property String  psCurNegLeft
6851>>>>>>>>>        Property String  psCurNegright
6852>>>>>>>>>        Property Integer pbCurNegThousandsSep
6853>>>>>>>>>        Property Integer piCurNegPoints
6854>>>>>>>>>        
6854>>>>>>>>>        Property String  psNumPosLeft
6855>>>>>>>>>        Property String  psNumPosright
6856>>>>>>>>>        Property Integer pbNumPosThousandsSep
6857>>>>>>>>>        Property Integer piNumPosPoints
6858>>>>>>>>>        
6858>>>>>>>>>        Property String  psNumNegLeft
6859>>>>>>>>>        Property String  psNumNegright
6860>>>>>>>>>        Property Integer pbNumNegThousandsSep
6861>>>>>>>>>        Property Integer piNumNegPoints
6862>>>>>>>>>        
6862>>>>>>>>>        Send SetFormat "$,#.##;($,#.##)" True  // currency
6863>>>>>>>>>        Send SetFormat  ",#.*"           False // numeric
6864>>>>>>>>>        
6864>>>>>>>>>    End_Procedure
6865>>>>>>>>>    
6865>>>>>>>>>    // internal
6865>>>>>>>>>    // parse passed format string and set temporary properties with result
6865>>>>>>>>>    Procedure ParseFormat String sFmt
6867>>>>>>>>>        
6867>>>>>>>>>        String sLeft sRight sDigit
6867>>>>>>>>>        Integer bSep iPos i iDigits
6867>>>>>>>>>        
6867>>>>>>>>>        // replace any literals. A "/" followed by anything.
6867>>>>>>>>>        // some literals are special. $ . , / #
6867>>>>>>>>>        Move (Replaces("/$",sFmt,Character(1)))    to sFmt
6868>>>>>>>>>        Move (Replaces("/.",sFmt,Character(2)))    to sFmt
6869>>>>>>>>>        Move (Replaces("/,",sFmt,Character(3)))    to sFmt
6870>>>>>>>>>        Move (Replaces("/"+"/",sFmt,Character(4))) to sFmt
6871>>>>>>>>>        Move (Replaces("/#",sFmt,Character(5)))    to sFmt
6872>>>>>>>>>        Move (Character(9)) to sDigit
6873>>>>>>>>>        Move (Replaces("#",sFmt,sDigit))           to sFmt
6874>>>>>>>>>        Move (Replaces("/",sFmt,""))               to sFmt // replace all others
6875>>>>>>>>>        
6875>>>>>>>>>        Move (Pos(",",sFmt))                 to bSep // if we have any , we use thousand seps
6876>>>>>>>>>        If bSep ;            Move (Replaces(",",sFmt,"")) to sFmt // remove all ,
6879>>>>>>>>>        
6879>>>>>>>>>        Move (Replaces("$",sFmt,psCurrencySymbol(Self))) to sFmt // replace any $ with currency symbol
6880>>>>>>>>>        
6880>>>>>>>>>        Move (Pos(".",sFmt)) to iPos                 // position of decimal
6881>>>>>>>>>        
6881>>>>>>>>>        // Move all the special literals back into place before parsing
6881>>>>>>>>>        Move (Replaces(Character(1),sFmt,"$")) to sFmt
6882>>>>>>>>>        Move (Replaces(Character(2),sFmt,".")) to sFmt
6883>>>>>>>>>        Move (Replaces(Character(3),sFmt,",")) to sFmt
6884>>>>>>>>>        Move (Replaces(Character(4),sFmt,"/")) to sFmt
6885>>>>>>>>>        Move (Replaces(Character(5),sFmt,"#")) to sFmt
6886>>>>>>>>>        
6886>>>>>>>>>        If (iPos>0) Begin                      // if we have a decimanl point
6888>>>>>>>>>            Move 1 to i                        // look for first non # to right and count the #s
6889>>>>>>>>>            If (mid(sFmt,1,iPos+i)="*") Begin  // the "*" is special. It means as many as you want
6891>>>>>>>>>                Move -2 to iDigits
6892>>>>>>>>>                Increment i
6893>>>>>>>>>            End
6893>>>>>>>>>>
6893>>>>>>>>>            While (mid(sFmt,1,iPos+i)=sDigit)
6897>>>>>>>>>                Increment i
6898>>>>>>>>>            Loop
6899>>>>>>>>>>
6899>>>>>>>>>            Move (Mid(sFmt,255,iPos+i)) to sRight // everything to the right of the last # is format stuff
6900>>>>>>>>>            If (iDigits=0) ;                Move (i-1) to iDigits
6903>>>>>>>>>            //
6903>>>>>>>>>            Move 1 to i                           // find the first non-# to the left of the point
6904>>>>>>>>>            While (mid(sFmt,1,iPos-i)=sDigit)     // everything to the left is format stuff
6908>>>>>>>>>                Increment i
6909>>>>>>>>>            Loop
6910>>>>>>>>>>
6910>>>>>>>>>            Move (left(sFmt,iPos-i)) to sLeft
6911>>>>>>>>>        End
6911>>>>>>>>>>
6911>>>>>>>>>        Else Begin                             // we have no decinal
6912>>>>>>>>>            Move 0 to iDigits                  // so points is none
6913>>>>>>>>>            Move (Pos(sDigit,sFmt)) to iPos    // find first #.
6914>>>>>>>>>            If (iPos=0) Begin                  // if none, entire string is left format stuff..wierd!
6916>>>>>>>>>                Move sFmt to sLeft
6917>>>>>>>>>                Move ""   to sRight
6918>>>>>>>>>            End
6918>>>>>>>>>>
6918>>>>>>>>>            Else Begin
6919>>>>>>>>>                Move (left(sFmt,iPos-1)) to sLeft // all char to left of first # is left format stuff
6920>>>>>>>>>                Move 1 to i
6921>>>>>>>>>                While (mid(sFmt,1,iPos+i)=sDigit) // find last #, all char to right is right format
6925>>>>>>>>>                    Increment i
6926>>>>>>>>>                Loop
6927>>>>>>>>>>
6927>>>>>>>>>                Move (Mid(sFmt,255,i+iPos)) to sRight
6928>>>>>>>>>            End
6928>>>>>>>>>>
6928>>>>>>>>>        End
6928>>>>>>>>>>
6928>>>>>>>>>        // set temporary format properties and exit
6928>>>>>>>>>        Set pbThousandsSep to bSep
6929>>>>>>>>>        Set psLeft         to sLeft
6930>>>>>>>>>        Set psRight        to sRight
6931>>>>>>>>>        Set piPoints       to iDigits
6932>>>>>>>>>    End_Procedure
6933>>>>>>>>>    
6933>>>>>>>>>    // Public: Sets a format string. Pass full format for Positve and negative in sFmt. Pass
6933>>>>>>>>>    //         bCurrency true is this is a currency format, false if a numeric format
6933>>>>>>>>>    //
6933>>>>>>>>>    //  e.g. Send SetFormat "$,#.##;($,#.##)" True
6933>>>>>>>>>    Procedure SetFormat String sFmt Integer bCurrency
6935>>>>>>>>>        String sPos sNeg
6935>>>>>>>>>        Integer iPos
6935>>>>>>>>>        
6935>>>>>>>>>        Move (Pos(";",sFmt)) to iPos
6936>>>>>>>>>        If iPos Begin
6938>>>>>>>>>            Move (left(sFmt,iPos-1))    to sPos
6939>>>>>>>>>            Move (mid(sFmt,255,iPos+1)) to sNeg
6940>>>>>>>>>        End
6940>>>>>>>>>>
6940>>>>>>>>>        Else Begin
6941>>>>>>>>>            Move sFmt         to sPos
6942>>>>>>>>>            Move ("-" + sFmt) to sNeg
6943>>>>>>>>>        End
6943>>>>>>>>>>
6943>>>>>>>>>        Send ParseFormat sPos
6944>>>>>>>>>        If bCurrency Begin
6946>>>>>>>>>            Set pbCurPosThousandsSep to (pbThousandsSep(Self))
6947>>>>>>>>>            Set psCurPosLeft         to (psLeft(Self))
6948>>>>>>>>>            Set psCurPosRight        to (psRight(Self))
6949>>>>>>>>>            Set piCurPosPoints       to (piPoints(Self))
6950>>>>>>>>>        End
6950>>>>>>>>>>
6950>>>>>>>>>        Else Begin
6951>>>>>>>>>            Set pbNumPosThousandsSep to (pbThousandsSep(Self))
6952>>>>>>>>>            Set psNumPosLeft         to (psLeft(Self))
6953>>>>>>>>>            Set psNumPosRight        to (psRight(Self))
6954>>>>>>>>>            Set piNumPosPoints       to (piPoints(Self))
6955>>>>>>>>>        End
6955>>>>>>>>>>
6955>>>>>>>>>        
6955>>>>>>>>>        Send ParseFormat sNeg
6956>>>>>>>>>        If bCurrency Begin
6958>>>>>>>>>            Set pbCurNegThousandsSep to (pbThousandsSep(Self))
6959>>>>>>>>>            Set psCurNegLeft         to (psLeft(Self))
6960>>>>>>>>>            Set psCurNegRight        to (psRight(Self))
6961>>>>>>>>>            Set piCurNegPoints       to (piPoints(Self))
6962>>>>>>>>>        End
6962>>>>>>>>>>
6962>>>>>>>>>        Else Begin
6963>>>>>>>>>            Set pbNumNegThousandsSep to (pbThousandsSep(Self))
6964>>>>>>>>>            Set psNumNegLeft         to (psLeft(Self))
6965>>>>>>>>>            Set psNumNegRight        to (psRight(Self))
6966>>>>>>>>>            Set piNumNegPoints       to (piPoints(Self))
6967>>>>>>>>>        End
6967>>>>>>>>>>
6967>>>>>>>>>    End_Procedure
6968>>>>>>>>>    
6968>>>>>>>>>    // low level formatting. Pass parameters
6968>>>>>>>>>    Function Format_Num Number nNumber Integer iPoints Integer bSep ;            String sPrefix String sSuffix Returns String
6970>>>>>>>>>        String  sLeft sRight sNumber sSep sDec
6970>>>>>>>>>        Integer iDec iLen iCh
6970>>>>>>>>>        
6970>>>>>>>>>        Get_Attribute DF_DECIMAL_SEPARATOR to iCh
6973>>>>>>>>>        Move (Character(iCh)) to sDec
6974>>>>>>>>>        
6974>>>>>>>>>        Move (abs(nNumber)) to sNumber
6975>>>>>>>>>        Move (Pos(sDec,sNumber)) to iDec
6976>>>>>>>>>        Move (If(iDec=0, sNumber, left(sNumber,iDec-1))) to sLeft
6977>>>>>>>>>        Move (If(iDec=0, "", mid(sNumber,255,iDec+1)))   to sRight
6978>>>>>>>>>        // format for decimal separator
6978>>>>>>>>>        If (iPoints>=0) ; // if -2, leave it alone, it should not be -1            Move (left(sRight+Repeat("0",iPoints),iPoints)) to sRight
6981>>>>>>>>>        
6981>>>>>>>>>        // format for thousand sep.
6981>>>>>>>>>        If bSep Begin
6983>>>>>>>>>            Get_Attribute DF_THOUSANDS_SEPARATOR to iCh
6986>>>>>>>>>            Move (Character(iCh)) to sSep
6987>>>>>>>>>            Move (Length(sLeft)) to iLen
6988>>>>>>>>>            While (iLen>3)
6992>>>>>>>>>                Move (insert(sSep,sLeft,iLen-2)) to sLeft
6993>>>>>>>>>                Move (iLen-3) to iLen
6994>>>>>>>>>            Loop
6995>>>>>>>>>>
6995>>>>>>>>>        End
6995>>>>>>>>>>
6995>>>>>>>>>        // if decimal points or -2 (allow anything) and there are points to show
6995>>>>>>>>>        If (iPoints>0 or (iPoints=-2 and sRight<>"")) ;            Move (sLeft + sDec + sright) to sLeft
6998>>>>>>>>>        Function_Return (sPrefix + sLeft+ sSuffix)
6999>>>>>>>>>    End_Function
7000>>>>>>>>>    
7000>>>>>>>>>    // Public: Format for currency
7000>>>>>>>>>    Function FormatCur Number nNumber Integer iPoints Returns String
7002>>>>>>>>>        String  sLeft sRight
7002>>>>>>>>>        Integer bSep
7002>>>>>>>>>        If (nNumber<0) Begin
7004>>>>>>>>>            Get pbCurNegThousandsSep to bSep
7005>>>>>>>>>            Get psCurNegLeft         to sLeft
7006>>>>>>>>>            Get psCurNegRight        to sRight
7007>>>>>>>>>            If (iPoints=-1) ;                Get piCurNegPoints       to iPoints
7010>>>>>>>>>        End
7010>>>>>>>>>>
7010>>>>>>>>>        Else Begin
7011>>>>>>>>>            Get pbCurPosThousandsSep to bSep
7012>>>>>>>>>            Get psCurPosLeft         to sLeft
7013>>>>>>>>>            Get psCurPosRight        to sRight
7014>>>>>>>>>            If (iPoints=-1) ;                Get piCurPosPoints       to iPoints
7017>>>>>>>>>        End
7017>>>>>>>>>>
7017>>>>>>>>>        Function_Return (Format_Num(Self, nNumber,iPoints,bSep,sLeft,sRight))
7018>>>>>>>>>    End_Function
7019>>>>>>>>>    
7019>>>>>>>>>    // Public: Format for numeric
7019>>>>>>>>>    Function FormatNum Number nNumber Integer iPoints Returns String
7021>>>>>>>>>        String  sLeft sRight
7021>>>>>>>>>        Integer bSep
7021>>>>>>>>>        If (nNumber<0) Begin
7023>>>>>>>>>            Get pbNumNegThousandsSep to bSep

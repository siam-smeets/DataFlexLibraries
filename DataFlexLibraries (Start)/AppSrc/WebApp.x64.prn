5245>>>>>>>
5245>>>>>>>    Function SmartCase String sName Returns String
5247>>>>>>>        Integer iPos iNewPos
5247>>>>>>>        String sRight
5247>>>>>>>        Move (Replaces("_",lowercase(sName)," ")) to sName
5248>>>>>>>        Move (Trim (Replaces(".",sName," "))) to sName
5249>>>>>>>        Move 1 to iPos
5250>>>>>>>        Repeat
5250>>>>>>>>
5250>>>>>>>            Move (mid(sName,255,iPos+1)) to sRight
5251>>>>>>>            Move (left(sName,iPos-1) + Uppercase(mid(sName,1,iPos)) + sRight) to sName
5252>>>>>>>            Move (Pos( " ", sRight)) to iNewPos
5253>>>>>>>            If (iNewPos = 0) ;                Break
5256>>>>>>>            Add (iNewPos+1) to iPos
5257>>>>>>>        Loop
5258>>>>>>>>
5258>>>>>>>        Function_Return sName
5259>>>>>>>    End_Function
5260>>>>>>>
5260>>>>>>>    Enumeration_List
5260>>>>>>>        Define DD_LABEL_SHORT
5260>>>>>>>        Define DD_LABEL_LONG
5260>>>>>>>        Define DD_LABEL_TAG
5260>>>>>>>    End_Enumeration_List
5260>>>>>>>
5260>>>>>>>    // Handy function to get the label for a field. Three "types" are
5260>>>>>>>    // supported:
5260>>>>>>>    // DD_LABEL_SHORT  use short, if none use long, if none use smart tag
5260>>>>>>>    // DD_LABEL_LONG   use long, if none use smart tag
5260>>>>>>>    // DD_LABEL_TAG    use smart tag
5260>>>>>>>    // If you want an explicit field name use oneof the other messages.
5260>>>>>>>    Function Field_Label Integer iField Integer iType Returns String
5262>>>>>>>        Integer iServer
5262>>>>>>>        String sValue
5262>>>>>>>        If (iType = DD_LABEL_SHORT) ;  // 0 = Short            Get Field_Label_Short iField to sValue
5265>>>>>>>        If (iType = DD_LABEL_LONG or (iType=DD_LABEL_SHORT and sValue='')) ;            Get Field_Label_Long iField to sValue
5268>>>>>>>        If (iType = DD_LABEL_TAG or sValue="") Begin
5270>>>>>>>            Get Field_Label_Tag iField to sValue
5271>>>>>>>            Get SmartCase sValue to sValue
5272>>>>>>>        End
5272>>>>>>>>
5272>>>>>>>        Function_Return sValue
5273>>>>>>>    End_Function
5274>>>>>>>
5274>>>>>>>    Function File_Field_Label Integer iFile Integer iField Integer iType Returns String
5276>>>>>>>        Integer iDSO
5276>>>>>>>        String sValue
5276>>>>>>>        Get Data_set iFile to iDSO
5277>>>>>>>        If iDSO ;            Get Field_Label of iDSO iField iType to sValue
5280>>>>>>>        Function_Return sValue
5281>>>>>>>    End_Function

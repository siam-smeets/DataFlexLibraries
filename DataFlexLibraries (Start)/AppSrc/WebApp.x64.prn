20834>>>>>>>>>    // actions specified in the request.
20834>>>>>>>>>    Procedure Call_Action tWebCallContext ByRef cctx
20836>>>>>>>>>        Integer i icAction
20836>>>>>>>>>        Handle hoAttachment hoTarget
20836>>>>>>>>>        
20836>>>>>>>>>        Set private_psFocus to cctx.request.Header.sFocus
20837>>>>>>>>>        
20837>>>>>>>>>        Move (SizeOfArray(cctx.request.aActions)) to icAction
20838>>>>>>>>>        
20838>>>>>>>>>        For i from 0 to (icAction - 1)
20844>>>>>>>>>>
20844>>>>>>>>>            Get WebObjectByName cctx.request.aActions[i].sTarget to hoTarget
20845>>>>>>>>>            
20845>>>>>>>>>            If (hoTarget <> C_WebUnresolvedObject) Begin
20847>>>>>>>>>                // Make the method call....
20847>>>>>>>>>                Move C_WebUnresolvedObject to hoAttachment
20848>>>>>>>>>                If (cctx.request.aActions[i].iAttached > 0) Begin
20850>>>>>>>>>                    Get RequestAttachment cctx.request.aActions[i].iAttached to hoAttachment
20851>>>>>>>>>                End
20851>>>>>>>>>>
20851>>>>>>>>>                Get HandleAction of hoTarget cctx.request.aActions[i].sAction cctx.request.aActions[i].aParams hoAttachment to cctx.response.asReturnValues[i]
20852>>>>>>>>>                
20852>>>>>>>>>                If (hoAttachment <> C_WebUnresolvedObject) Begin
20854>>>>>>>>>                    Send Destroy of hoAttachment
20855>>>>>>>>>                End
20855>>>>>>>>>>
20855>>>>>>>>>            End
20855>>>>>>>>>>
20855>>>>>>>>>            Else Begin
20856>>>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, cctx.request.aActions[i].sTarget))
20857>>>>>>>>>>
20857>>>>>>>>>            End
20857>>>>>>>>>>
20857>>>>>>>>>        Loop
20858>>>>>>>>>>
20858>>>>>>>>>    End_Procedure
20859>>>>>>>>>
20859>>>>>>>>>    // Send by cWebCallHandler_mixin as part of the call handling proces to gather response
20859>>>>>>>>>    // attachments that might have been sent with client actions.
20859>>>>>>>>>    Procedure Call_PostAttachments tWebCallContext ByRef cctx
20861>>>>>>>>>        Handle hoResponseAttachments hoRequestAttachments
20861>>>>>>>>>        
20861>>>>>>>>>        //  Add attachments to response
20861>>>>>>>>>        Get phoResponseAttachments to hoResponseAttachments
20862>>>>>>>>>        If (hoResponseAttachments <> C_WebUnresolvedObject) Begin
20864>>>>>>>>>            Send SetMember of cctx.hoJsonResponse "a" hoResponseAttachments
20865>>>>>>>>>            
20865>>>>>>>>>            //  Cleanup handles
20865>>>>>>>>>            Send Destroy of hoResponseAttachments
20866>>>>>>>>>            Set phoResponseAttachments to C_WebUnresolvedObject
20867>>>>>>>>>        End
20867>>>>>>>>>>
20867>>>>>>>>>        
20867>>>>>>>>>        Get phoRequestAttachments to hoRequestAttachments
20868>>>>>>>>>        If (hoRequestAttachments <> C_WebUnresolvedObject) Begin
20870>>>>>>>>>            Send Destroy of (phoRequestAttachments(Self))
20871>>>>>>>>>            Set phoRequestAttachments to C_WebUnresolvedObject
20872>>>>>>>>>        End
20872>>>>>>>>>>
20872>>>>>>>>>    End_Procedure
20873>>>>>>>>>    
20873>>>>>>>>>    // Send by cWebCallHandler_mixin as part of the call handling proces to gather client actions.
20873>>>>>>>>>    Procedure Call_PostClientAction tWebCallContext ByRef cctx
20875>>>>>>>>>        tWebClientAction[] aEmpty
20875>>>>>>>>>        tWebClientAction[] aEmpty
20876>>>>>>>>>        
20876>>>>>>>>>        Get paClientActions to cctx.response.Header.aActions
20877>>>>>>>>>        Set paClientActions to aEmpty
20878>>>>>>>>>    End_Procedure
20879>>>>>>>>>    
20879>>>>>>>>>    // Send by the cWebCallHandler_mixin when request processing is cancelled. In this case we 
20879>>>>>>>>>    // only want to send error client actions back to the client.
20879>>>>>>>>>    Procedure Call_PostErrorOnlyClientActions tWebCallContext ByRef cctx
20881>>>>>>>>>        tWebClientAction[] aEmpty aActions
20881>>>>>>>>>        tWebClientAction[] aEmpty aActions
20883>>>>>>>>>        Integer iAction iActionTo
20883>>>>>>>>>        
20883>>>>>>>>>        Get paClientActions to aActions
20884>>>>>>>>>        Move (SizeOfArray(aActions) - 1) to iActionTo
20885>>>>>>>>>        For iAction from 0 to iActionTo
20891>>>>>>>>>>
20891>>>>>>>>>            If (aActions[iAction].sName = "showError") ;                Move aActions[iAction] to cctx.response.Header.aActions[iAction]
20894>>>>>>>>>        Loop
20895>>>>>>>>>>
20895>>>>>>>>>        
20895>>>>>>>>>        Set paClientActions to aEmpty
20896>>>>>>>>>    End_Procedure
20897>>>>>>>>>    
20897>>>>>>>>>    // Retrieves an attachment from the request based on its index.
20897>>>>>>>>>    //
20897>>>>>>>>>    // Params:
20897>>>>>>>>>    //  iIndex  Attachment index (1 based).
20897>>>>>>>>>    // Returns:
20897>>>>>>>>>    //  JSON Object handle.
20897>>>>>>>>>    Function RequestAttachment Integer iIndex Returns Handle
20899>>>>>>>>>        Handle hoAttachments
20899>>>>>>>>>        
20899>>>>>>>>>        Get phoRequestAttachments to hoAttachments
20900>>>>>>>>>        If (hoAttachments <> C_WebUnresolvedObject) Begin
20902>>>>>>>>>            If (IsOfJsonType(hoAttachments, jsonTypeArray)) Begin
20904>>>>>>>>>                If (MemberCount(hoAttachments) > (iIndex - 1)) Begin
20906>>>>>>>>>                    Function_Return (MemberByIndex(hoAttachments, (iIndex - 1)))
20907>>>>>>>>>                End
20907>>>>>>>>>>
20907>>>>>>>>>                Else Begin
20908>>>>>>>>>                    Error DFERR_PROGRAM "Request attachment index out of bounds."
20909>>>>>>>>>>
20909>>>>>>>>>                End
20909>>>>>>>>>>
20909>>>>>>>>>            End
20909>>>>>>>>>>
20909>>>>>>>>>            Else Begin
20910>>>>>>>>>                Error DFERR_PROGRAM "No request attachments available."
20911>>>>>>>>>>
20911>>>>>>>>>            End 
20911>>>>>>>>>>
20911>>>>>>>>>        End
20911>>>>>>>>>>
20911>>>>>>>>>        Else Begin
20912>>>>>>>>>            Error DFERR_PROGRAM "No request attachments available."
20913>>>>>>>>>>
20913>>>>>>>>>        End
20913>>>>>>>>>>
20913>>>>>>>>>        
20913>>>>>>>>>        Function_Return C_WebUnresolvedObject
20914>>>>>>>>>    End_Function
20915>>>>>>>>>    
20915>>>>>>>>>    
20915>>>>>>>>>    // Adds an attachment to the response and returns the integer id.
20915>>>>>>>>>    //
20915>>>>>>>>>    // Params:
20915>>>>>>>>>    //  hoJsonObject    cJsonObject handle representing the attachment.
20915>>>>>>>>>    // Returns:
20915>>>>>>>>>    //  The attachment index (1 based).
20915>>>>>>>>>    Function AddResponseAttachment Handle hoJsonObject Returns Integer
20917>>>>>>>>>        Handle hoAttachments
20917>>>>>>>>>        Integer iIndex
20917>>>>>>>>>        Move -1 to iIndex
20918>>>>>>>>>        
20918>>>>>>>>>        Get phoResponseAttachments to hoAttachments
20919>>>>>>>>>        If (hoAttachments = C_WebUnresolvedObject) Begin
20921>>>>>>>>>            Get Create (RefClass(cJsonObject)) to hoAttachments
20922>>>>>>>>>            Send InitializeJsonType of hoAttachments jsonTypeArray
20923>>>>>>>>>            Set phoResponseAttachments to hoAttachments
20924>>>>>>>>>        End
20924>>>>>>>>>>
20924>>>>>>>>>        Get MemberCount of hoAttachments to iIndex
20925>>>>>>>>>        Increment iIndex
20926>>>>>>>>>        Send AddMember of hoAttachments hoJsonObject
20927>>>>>>>>>        
20927>>>>>>>>>        Function_Return iIndex
20928>>>>>>>>>    End_Function
20929>>>>>>>>>    
20929>>>>>>>>>    // Determines the current action state for client actions.
20929>>>>>>>>>    Function OwnerActionState Handle hoWO Returns Integer
20931>>>>>>>>>        Function_Return ctExecDefault
20932>>>>>>>>>    End_Function
20933>>>>>>>>>    
20933>>>>>>>>>    // Adds a ClientAction to be executed during the next response.
20933>>>>>>>>>    // tClientAction    - Is the action to be executed
20933>>>>>>>>>    Procedure AddClientAction tWebClientAction tClientAction
20935>>>>>>>>>        tWebClientAction[] aClientActions
20935>>>>>>>>>        tWebClientAction[] aClientActions
20936>>>>>>>>>        
20936>>>>>>>>>        Get paClientActions to aClientActions
20937>>>>>>>>>        Move tClientAction to aClientActions[SizeOfArray(aClientActions)]
20938>>>>>>>>>        Set paClientActions to aClientActions
20939>>>>>>>>>    End_Procedure    
20940>>>>>>>>>    
20940>>>>>>>>>    
20940>>>>>>>>>    // Cancels a client action that was scheduled.
20940>>>>>>>>>    // tClientAction    - Is the action to be executed
20940>>>>>>>>>    Procedure OwnerCancelClientAction Handle hoWO String sName
20942>>>>>>>>>        tWebClientAction[] aClientActions
20942>>>>>>>>>        tWebClientAction[] aClientActions
20943>>>>>>>>>        Integer iCur
20943>>>>>>>>>        String sTarget
20943>>>>>>>>>        Handle hoAttachments
20943>>>>>>>>>        
20943>>>>>>>>>        Get WebObjectName of hoWO to sTarget
20944>>>>>>>>>        Get paClientActions to aClientActions
20945>>>>>>>>>        
20945>>>>>>>>>        For iCur from 0 to (SizeOfArray(aClientActions) - 1)
20951>>>>>>>>>>
20951>>>>>>>>>            If (aClientActions[iCur].sTarget = sTarget and aClientActions[iCur].sName = sName) Begin
20953>>>>>>>>>                //  Clear attachment
20953>>>>>>>>>                If (aClientActions[iCur].iAttached <> 0) Begin
20955>>>>>>>>>                    Get phoResponseAttachments to hoAttachments
20956>>>>>>>>>                    Send SetMemberValue of hoAttachments (aClientActions[iCur].iAttached - 1) jsonTypeNull 0        
20957>>>>>>>>>                End
20957>>>>>>>>>>
20957>>>>>>>>>                
20957>>>>>>>>>                Move (RemoveFromArray(aClientActions, iCur)) to aClientActions
20958>>>>>>>>>                
20958>>>>>>>>>                Decrement iCur
20959>>>>>>>>>            End
20959>>>>>>>>>>
20959>>>>>>>>>        Loop
20960>>>>>>>>>>
20960>>>>>>>>>        
20960>>>>>>>>>        Set paClientActions to aClientActions
20961>>>>>>>>>    End_Procedure
20962>>>>>>>>>    
20962>>>>>>>>>
20962>>>>>>>>>    //  This function searches the object handle of a web object using its public name. The object 
20962>>>>>>>>>    //  name can be obtained by calling the WebObjectName Function on a web Object. If it can't 
20962>>>>>>>>>    //  find the Object it will cause an Error and return C_WebUnresolvedObject (0).
20962>>>>>>>>>    //      sObjectName - Name of the web object.
20962>>>>>>>>>    Function FindWebObject String sObjectName Boolean bOptErr Returns Handle
20964>>>>>>>>>        Handle hoObj
20964>>>>>>>>>        Boolean bErr
20964>>>>>>>>>        
20964>>>>>>>>>        Move True to bErr
20965>>>>>>>>>        If (num_arguments > 1) ;            Move bOptErr to bErr
20968>>>>>>>>>        
20968>>>>>>>>>        Get FindWebObject of (phoWebControlLocator(Self)) sObjectName bErr to hoObj
20969>>>>>>>>>        
20969>>>>>>>>>        If (hoObj = C_WebUnresolvedObject and bErr) Begin
20971>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, sObjectName))
20972>>>>>>>>>>
20972>>>>>>>>>        End
20972>>>>>>>>>>
20972>>>>>>>>>        
20972>>>>>>>>>        Function_Return hoObj
20973>>>>>>>>>    End_Function
20974>>>>>>>>>    
20974>>>>>>>>>    //  This function searches the object handle of a web object using its public name. The object 
20974>>>>>>>>>    //  name can be obtained by calling the WebObjectName Function on a web Object. If it can't 
20974>>>>>>>>>    //  find the Object it will return C_WebUnresolvedObject (0).
20974>>>>>>>>>    //      sObjectName - Name of the web object.
20974>>>>>>>>>    Function FindWebObjectSilent String sObjectName Returns Handle
20976>>>>>>>>>        Handle hoObj
20976>>>>>>>>>        
20976>>>>>>>>>        Get FindWebObject of (phoWebControlLocator(Self)) sObjectName False to hoObj
20977>>>>>>>>>        
20977>>>>>>>>>        Function_Return hoObj
20978>>>>>>>>>    End_Function
20979>>>>>>>>>

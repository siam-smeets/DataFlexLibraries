9903>>>>>>>>>        Get psDriverId            to sDrvrId
9904>>>>>>>>>        
9904>>>>>>>>>        // Execute
9904>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
9906>>>>>>>>>            // Call the driver function to execute
9906>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLEXECUTE ;                Callback Self ;                Passing ihdbc sEmpty ihstmt ;                Result iVoid
9911>>>>>>>>>            Send SQLGetStatementAttributes
9912>>>>>>>>>            Set piLastArgument to 0
9913>>>>>>>>>        End
9913>>>>>>>>>>
9913>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLExecute"
9915>>>>>>>>>    End_Procedure
9916>>>>>>>>>    
9916>>>>>>>>>    
9916>>>>>>>>>    
9916>>>>>>>>>    // Prepare and execute a statement
9916>>>>>>>>>    Procedure SQLExecDirect String sStatement
9918>>>>>>>>>        Integer ihdbc
9918>>>>>>>>>        Integer ihstmt
9918>>>>>>>>>        Integer iVoid
9918>>>>>>>>>        String  sDrvrId
9918>>>>>>>>>        
9918>>>>>>>>>        // Get the cli handles
9918>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
9919>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
9920>>>>>>>>>        Get psDriverId            to sDrvrId
9921>>>>>>>>>        
9921>>>>>>>>>        // ExecDirect
9921>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
9923>>>>>>>>>            // Call the driver function to execdirect
9923>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLEXECDIRECT ;                Callback Self ;                Passing ihdbc sStatement ihstmt ;                Result iVoid
9928>>>>>>>>>            Send SQLGetStatementAttributes
9929>>>>>>>>>        End
9929>>>>>>>>>>
9929>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLExecDirect"

14967>>>>>>>>>        Move (VariantStringLength( vValue)) to iLen
14968>>>>>>>>>        If (iLen) Begin
14970>>>>>>>>>            Move (DeRefPtr(AddressOf(vValue),8)) to pBSTR
14971>>>>>>>>>            Move (WideToMultiBuffer(eCharType,pBSTR,iLen,AddressOf(pRetStr))) to iBufLen
14972>>>>>>>>>        End
14972>>>>>>>>>>
14972>>>>>>>>>        Function_Return pRetStr

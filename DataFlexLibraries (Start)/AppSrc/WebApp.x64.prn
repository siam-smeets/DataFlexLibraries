29404>>>>>>>>>>>// This class is capable of parsing multipart/form-data requests. These requests are used to post
29404>>>>>>>>>>>// binary data and usually files. The WAF file upload uses this class. Because it works in chunks
29404>>>>>>>>>>>// are used this class is capable of handling large files.
29404>>>>>>>>>>>
29404>>>>>>>>>>>// Data used while parsing the request. Passed arround by reference for performance reasons (properties would be copied in memory).
29404>>>>>>>>>>>Struct tMultipartParsingData
29404>>>>>>>>>>>    UChar[] ucBoundary      //  Multipart boundary string (received from the client)
29404>>>>>>>>>>>    UChar[] ucCurrentChunk  //  Current chunk being handled
29404>>>>>>>>>>>    UChar[] ucNextChunk     //  Next chunk (already loaded for peeking ahead)
29404>>>>>>>>>>>    Integer iChunkOffset    //  Offset in bytes of the current chunk from the beginning of the request
29404>>>>>>>>>>>    Integer iChunkRead      //  Parsing position within the current chunk
29404>>>>>>>>>>>    DWord iSize             //  Size of the full request known so far (only if bEndOfReq is true it is complete)
29404>>>>>>>>>>>    Integer iBoundPos       //  Position of the next boundary in the current chunk (if available)
29404>>>>>>>>>>>    Boolean bEndOfReq       //  End of request reached
29404>>>>>>>>>>>    Boolean bAbort          //  If true something is wrong and we should abot
29404>>>>>>>>>>>End_Struct
29404>>>>>>>>>>>
29404>>>>>>>>>>>//  These functions are defined in the class using this mixin or one of its base classes
29404>>>>>>>>>>>Register_Function RequestDataUChar Integer iSize Returns UChar[]
29404>>>>>>>>>>>Register_Function GetContentType Returns String
29404>>>>>>>>>>>Register_Function ConvertRequestDataToString UChar[] ucData Returns String
29404>>>>>>>>>>>

34368>>>>>>>
34368>>>>>>>    // Seeds data and finds a record. Returns true if a seed/find succeeded.
34368>>>>>>>    Function SeedData Handle hoUpdateColumn Handle hoInitialColumn Returns Boolean
34370>>>>>>>        Handle hoInvokingObject hoInvokingServer hoServer
34370>>>>>>>        Handle hmSeedBuffer
34370>>>>>>>        Integer iField iFile eUpdateMode iStat iOrdering
34370>>>>>>>        Boolean bAutoSeed bReadRecord bChanged bSeeded bReverseOrdering bAutoServer
34370>>>>>>>        String sValue
34370>>>>>>>
34370>>>>>>>        WebGet peUpdateMode to eUpdateMode
34371>>>>>>>        Get GetInvokingObject to hoInvokingObject
34372>>>>>>>        WebGet pbAutoSeed to bAutoSeed
34373>>>>>>>        Get phmPromptSeedBufferCallback to hmSeedBuffer
34374>>>>>>>        Get pbAutoServer to bAutoServer
34375>>>>>>>        
34375>>>>>>>        Get ReadingServer to hoServer
34376>>>>>>>        Get Main_File of hoServer to iFile
34377>>>>>>>        Get Server of hoInvokingObject to hoInvokingServer
34378>>>>>>>        
34378>>>>>>>        // if autoserver, we need to make sure the file buffers are set for
34378>>>>>>>        // the invoking DDOs. This may be needed for relates-to constraints
34378>>>>>>>        If (bAutoServer) Begin
34380>>>>>>>            Send Refind_Records of hoInvokingServer
34381>>>>>>>        End
34381>>>>>>>>
34381>>>>>>>        // if a seed message is created, we assume that this should override anything else and that
34381>>>>>>>        // you will use this and only this for seeding
34381>>>>>>>        If (eUpdateMode<>umPromptNonInvoking and hmSeedBuffer) Begin
34383>>>>>>>            Clear iFile    // First clear the main_file buffer
34384>>>>>>>            Send hmSeedBuffer of hoInvokingObject Self
34385>>>>>>>            // if we come back with a non-edited, record we assume the seed did a find
34385>>>>>>>            // and we will use that record. Otherwise we want to do a find
34385>>>>>>>            Get_Attribute DF_FILE_STATUS of iFile to iStat
34388>>>>>>>            If (iStat=DF_FILE_ACTIVE) Begin
34390>>>>>>>                Move True to bSeeded
34391>>>>>>>            End
34391>>>>>>>>
34391>>>>>>>            Else Begin             
34392>>>>>>>                Move True to bReadRecord
34393>>>>>>>            End
34393>>>>>>>>
34393>>>>>>>        End
34393>>>>>>>>
34393>>>>>>>        // if relational we will seed if autoseed and if it really is relational
34393>>>>>>>        Else If (eUpdateMode=umPromptRelational and bAutoSeed) Begin
34396>>>>>>>            Clear iFile    // First clear the main_file buffer
34397>>>>>>>            // Default action is to perform an entry update just like a find
34397>>>>>>>            // key would do. If we have a server allow the server to control this.
34397>>>>>>>            Send Request_Entry_Update to hoInvokingServer iFile 1
34398>>>>>>>            Move True to bReadRecord
34399>>>>>>>        End
34399>>>>>>>>
34399>>>>>>>        // if value or custom, we seed if auto seed and we have an update column
34399>>>>>>>        Else If (bAutoSeed and hoUpdateColumn) Begin
34402>>>>>>>            WebGet psSeedValue to sValue
34403>>>>>>>            Get Data_File of hoUpdateColumn to iFile
34404>>>>>>>            Get Data_Field of hoUpdateColumn to iField
34405>>>>>>>            Clear iFile    // First clear the main_file buffer
34406>>>>>>>            Set_Field_Value iFile iField to sValue 
34409>>>>>>>            Move True to bReadRecord
34410>>>>>>>        End
34410>>>>>>>>
34410>>>>>>>        
34410>>>>>>>        // only find a record if there is a change. If the buffer is unchanged we leave
34410>>>>>>>        // it as is. This uncleared always start at the top of the list and if a custom
34410>>>>>>>        // seed was used to find the record, we will use that id
34410>>>>>>>        If bReadRecord Begin
34412>>>>>>>            Get_Attribute DF_FILE_CHANGED of iFile to bChanged
34415>>>>>>>            If bChanged Begin
34417>>>>>>>                WebGet pbReverseOrdering to bReverseOrdering
34418>>>>>>>                Get IndexOrder to iOrdering
34419>>>>>>>                Get ReadDDRecordInBuffer hoServer iOrdering bReverseOrdering to bSeeded
34420>>>>>>>            End
34420>>>>>>>>
34420>>>>>>>        End
34420>>>>>>>>
34420>>>>>>>        
34420>>>>>>>        Function_Return bSeeded
34421>>>>>>>    End_Function
34422>>>>>>>    
34422>>>>>>>    Procedure RestoreDefaults
34424>>>>>>>        Integer iVal
34424>>>>>>>        String sVal
34424>>>>>>>        
34424>>>>>>>        Get piSortColumn to iVal
34425>>>>>>>        WebSet piSortColumn to iVal
34426>>>>>>>
34426>>>>>>>        Get peUpdateMode to iVal
34427>>>>>>>        WebSet peUpdateMode to iVal
34428>>>>>>>        
34428>>>>>>>        Get piInitialColumn to iVal
34429>>>>>>>        WebSet piInitialColumn to iVal
34430>>>>>>>        
34430>>>>>>>        Get piUpdateColumn to iVal
34431>>>>>>>        WebSet piUpdateColumn to iVal
34432>>>>>>>        
34432>>>>>>>        Get psSeedValue to sVal
34433>>>>>>>        WebSet psSeedValue to sVal
34434>>>>>>>
34434>>>>>>>        Get pbAutoSeed to iVal
34435>>>>>>>        WebSet pbAutoSeed to iVal
34436>>>>>>>
34436>>>>>>>        Get psPromptUpdateCallback to sVal
34437>>>>>>>        WebSet psPromptUpdateCallback to sVal
34438>>>>>>>    End_Procedure
34439>>>>>>>
34439>>>>>>>    // called before the list is activated. 
34439>>>>>>>    Procedure InitializePromptList
34441>>>>>>>        Handle hoServer hoReadingDD hoInvokingObject hoInvokingServer hoInitialColumn hoUpdateColumn
34441>>>>>>>        Boolean bSeeded bReverseOrdering bDataAware
34441>>>>>>>        Integer iFile iField iOldMode iMainFile eUpdateMode iOrdering
34441>>>>>>>        Integer iUpdateColumn iInitialColumn 
34441>>>>>>>        String sValue sName
34441>>>>>>>        RowID riRowid
34441>>>>>>>        
34441>>>>>>>        Send RestoreDefaults // set back to default state
34442>>>>>>>        
34442>>>>>>>        WebGet peUpdateMode to eUpdateMode
34443>>>>>>>        
34443>>>>>>>        If (eUpdateMode<>umPromptNonInvoking) Begin
34445>>>>>>>            // get and webset the full name of the invoking object
34445>>>>>>>            Get ReturnObject to hoInvokingObject
34446>>>>>>>            Get WebObjectName of hoInvokingObject to sName
34447>>>>>>>            WebSet psInvokingObject to sName  
34448>>>>>>>                      
34448>>>>>>>            If (hoInvokingObject<=Desktop) Begin
34450>>>>>>>                Error DFERR_PROGRAM C_$PromptListHasNoInvokingObject
34451>>>>>>>>
34451>>>>>>>                Procedure_Return
34452>>>>>>>            End
34452>>>>>>>>
34452>>>>>>>
34452>>>>>>>            Send Prompt_Callback to hoInvokingObject Self
34453>>>>>>>            WebGet peUpdateMode to eUpdateMode // this may have changed
34454>>>>>>>        End
34454>>>>>>>>
34454>>>>>>>        Get pbDataAware to bDataAware
34455>>>>>>>        If not bDataAware Begin
34457>>>>>>>            Send InitializePromptListNDA
34458>>>>>>>            Procedure_Return
34459>>>>>>>        End
34459>>>>>>>>
34459>>>>>>>
34459>>>>>>>        Get Server to hoServer
34460>>>>>>>        If (hoServer=0) Begin
34462>>>>>>>            Error DFERR_PROGRAM C_$PromptListHasNoServer
34463>>>>>>>>
34463>>>>>>>            Procedure_Return
34464>>>>>>>        End
34464>>>>>>>>
34464>>>>>>>        
34464>>>>>>>        WebGet piInitialColumn to iInitialColumn
34465>>>>>>>
34465>>>>>>>        If (eUpdateMode=umPromptRelational) Begin
34467>>>>>>>            Get Delegation_Mode of hoInvokingObject to iOldMode
34468>>>>>>>            Set Delegation_Mode of hoInvokingObject to NO_DELEGATE_OR_ERROR
34469>>>>>>>            Get Data_File  of hoInvokingObject Current to iFile
34470>>>>>>>            Get Data_Field of hoInvokingObject Current to iField
34471>>>>>>>            Set Delegation_Mode of hoInvokingObject to iOldMode
34472>>>>>>>            If (iFile) Begin
34474>>>>>>>                Get Server of hoInvokingObject to hoInvokingServer
34475>>>>>>>            End
34475>>>>>>>>
34475>>>>>>>            
34475>>>>>>>            Get Main_File of hoServer to iMainFile
34476>>>>>>>            
34476>>>>>>>            If (not (iFile<>0 and iMainFile=iFile and hoInvokingObject<>0)) Begin
34478>>>>>>>                Send OnRelationalPromptListError
34479>>>>>>>                // get the update mode in case the RelationalPromptListError changes the mode to try another mode
34479>>>>>>>                WebGet peUpdateMode to eUpdateMode
34480>>>>>>>            End
34480>>>>>>>>
34480>>>>>>>        End
34480>>>>>>>>
34480>>>>>>>        
34480>>>>>>>        If (eUpdateMode=umPromptValue) Begin // else not used here intentionally
34482>>>>>>>            WebGet psValue of hoInvokingObject to sValue
34483>>>>>>>            WebSet psSeedValue to sValue
34484>>>>>>>        End
34484>>>>>>>>
34484>>>>>>>        
34484>>>>>>>        // if relational, update column is the "best" else you must specify it
34484>>>>>>>        If (eUpdateMode=umPromptRelational) Begin
34486>>>>>>>            Get SelectBestColumn iFile iField to iUpdateColumn
34487>>>>>>>        End
34487>>>>>>>>
34487>>>>>>>        Else Begin
34488>>>>>>>            WebGet piUpdateColumn to iUpdateColumn
34489>>>>>>>        End
34489>>>>>>>>
34489>>>>>>>        If (iUpdateColumn>=0) Begin
34491>>>>>>>            Get GetColumnObject iUpdateColumn to hoUpdateColumn
34492>>>>>>>        End
34492>>>>>>>>
34492>>>>>>>        
34492>>>>>>>        // We need an initial column. if you specified an initial column that will get used for the start column
34492>>>>>>>        // and the initial sort order. If you did not, which is typical, it will use the update column
34492>>>>>>>        If (iInitialColumn=-1) Begin
34494>>>>>>>            Move iUpdateColumn to iInitialColumn
34495>>>>>>>        End
34495>>>>>>>>
34495>>>>>>>        If (iInitialColumn>=0) Begin
34497>>>>>>>            Get GetColumnObject iInitialColumn to hoInitialColumn
34498>>>>>>>        End
34498>>>>>>>>
34498>>>>>>>        
34498>>>>>>>        // this assigns an ordering and a sort order
34498>>>>>>>        If (hoInitialColumn) Begin
34500>>>>>>>            WebSet piSortColumn to iUpdateColumn
34501>>>>>>>        End
34501>>>>>>>>
34501>>>>>>>        
34501>>>>>>>        // this function seeds the data and a boolean indicating if the buffer was seeded and read
34501>>>>>>>        If (eUpdateMode<>umPromptNonInvoking) Begin 
34503>>>>>>>            Get SeedData hoUpdateColumn hoInitialColumn to bSeeded
34504>>>>>>>        End 
34504>>>>>>>>
34504>>>>>>>
34504>>>>>>>        // if initial and update columns are different we must now reset the ordering
34504>>>>>>>        // to the initial order.
34504>>>>>>>        If (hoInitialColumn and (hoInitialColumn<>hoUpdateColumn)) Begin
34506>>>>>>>            WebSet piSortColumn to iInitialColumn
34507>>>>>>>        End
34507>>>>>>>>
34507>>>>>>>            
34507>>>>>>>        If (not(bSeeded)) Begin
34509>>>>>>>            WebGet pbReverseOrdering to bReverseOrdering
34510>>>>>>>            Get IndexOrder to iOrdering
34511>>>>>>>            Get ReadingServer to hoReadingDD
34512>>>>>>>            Get ReadDDFirstRecord hoReadingDD iOrdering bReverseOrdering to riRowid
34513>>>>>>>            Move (not(IsNullRowID(riRowid))) to bSeeded
34514>>>>>>>        End
34514>>>>>>>>
34514>>>>>>>        
34514>>>>>>>        If (peDbGridType(Self)<>gtManual) Begin
34516>>>>>>>            If bSeeded Begin
34518>>>>>>>                Send Request_Assign of hoServer
34519>>>>>>>            End
34519>>>>>>>>
34519>>>>>>>            Else Begin
34520>>>>>>>                Send ClearGrid
34521>>>>>>>            End
34521>>>>>>>>
34521>>>>>>>        End
34521>>>>>>>>
34521>>>>>>>        Else Begin
34522>>>>>>>            // with a manual loaded list, we will refresh the grid by sending GridRefresh
34522>>>>>>>            Move (GetRowID(Main_File(hoServer))) to riRowid
34523>>>>>>>            Send GridRefresh // this will do a manual load
34524>>>>>>>            String sRowId
34524>>>>>>>            Get psCurrentRowID to sRowId
34525>>>>>>>            If (bSeeded and IsNullRowID(DeserializeRowID(sRowId))) Begin
34527>>>>>>>                WebSet psCurrentRowID to (SerializeRowID(riRowid))
34528>>>>>>>            End
34528>>>>>>>>
34528>>>>>>>        End            
34528>>>>>>>>
34528>>>>>>>    End_Procedure
34529>>>>>>>
34529>>>>>>>    // initialize prompt list for a non-data aware grid (pbDataAware=F)
34529>>>>>>>    Procedure InitializePromptListNDA
34531>>>>>>>        Handle hoInvokingObject hoInitialColumn hoUpdateColumn
34531>>>>>>>        Boolean  bDataAware
34531>>>>>>>        Integer  eUpdateMode
34531>>>>>>>        Integer iUpdateColumn iInitialColumn 
34531>>>>>>>        String sValue sName
34531>>>>>>>        
34531>>>>>>>        Get FocusObject to hoInvokingObject
34532>>>>>>>
34532>>>>>>>        WebGet peUpdateMode to eUpdateMode
34533>>>>>>>        If (eUpdateMode=umPromptRelational) Begin
34535>>>>>>>            Move umPromptValue to eUpdateMode
34536>>>>>>>            WebSet peUpdateMode to eUpdateMode
34537>>>>>>>        End
34537>>>>>>>>
34537>>>>>>>        
34537>>>>>>>        WebGet piInitialColumn to iInitialColumn
34538>>>>>>>        
34538>>>>>>>        If (eUpdateMode=umPromptValue) Begin
34540>>>>>>>            WebGet psValue of hoInvokingObject to sValue
34541>>>>>>>            WebSet psSeedValue to sValue
34542>>>>>>>        End
34542>>>>>>>>
34542>>>>>>>        
34542>>>>>>>        WebGet piUpdateColumn to iUpdateColumn
34543>>>>>>>        If (iUpdateColumn>=0) Begin
34545>>>>>>>            Get GetColumnObject iUpdateColumn to hoUpdateColumn
34546>>>>>>>        End
34546>>>>>>>>
34546>>>>>>>        
34546>>>>>>>        // We need an initial column. if you specified an initial column that will get used for the start column
34546>>>>>>>        // and the initial sort order. If you did not, which is typical, it will use the update column
34546>>>>>>>        If (iInitialColumn=-1) Begin
34548>>>>>>>            Move iUpdateColumn to iInitialColumn
34549>>>>>>>        End
34549>>>>>>>>
34549>>>>>>>        If (iInitialColumn>=0) Begin
34551>>>>>>>            Get GetColumnObject iInitialColumn to hoInitialColumn
34552>>>>>>>        End
34552>>>>>>>>
34552>>>>>>>        
34552>>>>>>>        // this assigns an ordering and a sort order
34552>>>>>>>        If (hoInitialColumn) Begin
34554>>>>>>>            WebSet piSortColumn to iInitialColumn
34555>>>>>>>        End
34555>>>>>>>>
34555>>>>>>>        
34555>>>>>>>        Send GridRefresh // this will call OnLoadManualData which will fill and seed the list
34556>>>>>>>    End_Procedure
34557>>>>>>>    
34557>>>>>>>    // by default this raises an error. If you want a failed relational list to not raise an
34557>>>>>>>    // error but to default to a different mode such as umPromptValue, just remove the error and
34557>>>>>>>    // set peUpdateMode.
34557>>>>>>>    Procedure OnRelationalPromptListError
34559>>>>>>>        Error DFERR_PROGRAM C_$PromptListCannotbeRelational
34560>>>>>>>>
34560>>>>>>>    End_Procedure
34561>>>>>>>    
34561>>>>>>>    // called for relational update. DD should contain selected record
34561>>>>>>>    Procedure OnMoveValueOutByRelational Handle hoInvokingObject
34563>>>>>>>        RowID rRowId
34563>>>>>>>        Handle hoInvokingServer hoServer
34563>>>>>>>        Integer iFile 
34563>>>>>>>        Boolean bDataAware bSuccess
34563>>>>>>>
34563>>>>>>>        Get pbDataAware to bDataAware
34564>>>>>>>        If not bDataAware Begin
34566>>>>>>>            // this should have already been tested and should not be possible
34566>>>>>>>            Error DFERR_PROGRAM "Assert: OnMoveValueOutByRelational called by non data aware grid list can not be used as a relational prompt list for this object"
34567>>>>>>>>
34567>>>>>>>            Procedure_Return
34568>>>>>>>        End
34568>>>>>>>>
34568>>>>>>>
34568>>>>>>>        Get Server to hoServer
34569>>>>>>>        Get Main_File of hoServer to iFile
34570>>>>>>>        Get CurrentRowId of hoServer to rRowId
34571>>>>>>>        If (not(IsNullRowID(rRowId))) Begin
34573>>>>>>>            Get Server of hoInvokingObject to hoInvokingServer
34574>>>>>>>            Get FindByRowIdEx of hoInvokingServer iFile rRowId to bSuccess
34575>>>>>>>            // this is very unlikely
34575>>>>>>>            If not bSuccess Begin
34577>>>>>>>                Error DFERR_CANT_REFIND_RECORD
34578>>>>>>>>
34578>>>>>>>            End
34578>>>>>>>>
34578>>>>>>>        End
34578>>>>>>>>
34578>>>>>>>    End_Procedure
34579>>>>>>>
34579>>>>>>>    // called for move value out update. DD and web column objects should contain selected record
34579>>>>>>>    Procedure OnMoveValueOutByValue Handle hoInvokingObject
34581>>>>>>>        String sValue
34581>>>>>>>        Handle hoCol
34581>>>>>>>        Integer iCol
34581>>>>>>>
34581>>>>>>>        WebGet piUpdateColumn to iCol
34582>>>>>>>        Get GetColumnObject iCol to hoCol
34583>>>>>>>        
34583>>>>>>>        WebGet psValue of hoCol to sValue
34584>>>>>>>        WebSet psValue of hoInvokingObject to sValue
34585>>>>>>>        WebSet pbChanged of hoInvokingObject to True
34586>>>>>>>    End_Procedure
34587>>>>>>>
34587>>>>>>>    Procedure OnMoveValueOutByCustom Handle hoInvokingObject
34589>>>>>>>    End_Procedure
34590>>>>>>>
34590>>>>>>>    // This is only called in a successful close
34590>>>>>>>    Procedure ClosePromptList
34592>>>>>>>        Handle hoInvokingObject hoServer
34592>>>>>>>        Handle hmCallBack
34592>>>>>>>        Integer iFile eUpdateMode
34592>>>>>>>        RowID rRowId
34592>>>>>>>        String sRowId sCallBack
34592>>>>>>>        Boolean bOldExt bDataAware bSuccess
34592>>>>>>>        
34592>>>>>>>        Get pbDataAware to bDataAware
34593>>>>>>>        If bDataAware Begin
34595>>>>>>>            // update DD with the current selected record
34595>>>>>>>            WebGet psCurrentRowID to sRowId
34596>>>>>>>            Move (DeserializeRowID(sRowId)) to rRowId            
34597>>>>>>>            Get Server to hoServer
34598>>>>>>>            Get Main_File of hoServer to iFile
34599>>>>>>>            If (not(IsNullRowID(rRowId))) Begin
34601>>>>>>>                Get pbNotifyingExternalDD to bOldExt
34602>>>>>>>                Set pbNotifyingExternalDD to True // refresh will not try to fill the grid
34603>>>>>>>                Get FindByRowIdEx of hoServer iFile rRowId to bSuccess
34604>>>>>>>                // this is very unlikely
34604>>>>>>>                If not bSuccess Begin
34606>>>>>>>                    Error DFERR_CANT_REFIND_RECORD
34607>>>>>>>>
34607>>>>>>>                End
34607>>>>>>>>
34607>>>>>>>                Set pbNotifyingExternalDD to bOldExt
34608>>>>>>>            End
34608>>>>>>>>
34608>>>>>>>        End
34608>>>>>>>>
34608>>>>>>>        
34608>>>>>>>        WebGet peUpdateMode to eUpdateMode
34609>>>>>>>        // If non-invoking there is by definition, no Move value out
34609>>>>>>>        If (eUpdateMode<>umPromptNonInvoking) Begin
34611>>>>>>>            Get GetInvokingObject to hoInvokingObject            
34612>>>>>>>            
34612>>>>>>>            If not hoInvokingObject Begin
34614>>>>>>>                Error DFERR_PROGRAM "Assert: hoInvokingObject is 0"
34615>>>>>>>>
34615>>>>>>>                Procedure_Return
34616>>>>>>>            End
34616>>>>>>>>
34616>>>>>>>            
34616>>>>>>>            If (eUpdateMode=umPromptRelational) Begin
34618>>>>>>>                Send OnMoveValueOutByRelational hoInvokingObject
34619>>>>>>>            End
34619>>>>>>>>
34619>>>>>>>            Else If (eUpdateMode=umPromptValue) Begin
34622>>>>>>>                Send OnMoveValueOutByValue hoInvokingObject
34623>>>>>>>            End
34623>>>>>>>>
34623>>>>>>>            Else If (eUpdateMode=umPromptCustom) Begin
34626>>>>>>>                Send OnMoveValueOutByCustom hoInvokingObject
34627>>>>>>>            End
34627>>>>>>>>
34627>>>>>>>            WebGet psPromptUpdateCallback to sCallBack
34628>>>>>>>            If sCallBack Begin
34630>>>>>>>                Get WebMethodByName of hoInvokingObject sCallBack to hmCallBack
34631>>>>>>>                If hmCallBack Begin
34633>>>>>>>                    Send hmCallBack of hoInvokingObject Self
34634>>>>>>>                End
34634>>>>>>>>
34634>>>>>>>            End
34634>>>>>>>>
34634>>>>>>>        End
34634>>>>>>>>
34634>>>>>>>    End_Procedure
34635>>>>>>>
34635>>>>>>>    Procedure Cancel
34637>>>>>>>        Integer eViewStyle
34637>>>>>>>        Get peWebViewStyle to eViewStyle
34638>>>>>>>        
34638>>>>>>>        // if drilldown we do a NavigateCancel instead of a Hide.
34638>>>>>>>        // We use NavigateCancel instead of NavigateClose because the prompt
34638>>>>>>>        // list has already updated the invoking object.
34638>>>>>>>        // If it is a dialog we call CloseDialog and let the dialog decide how it needs to be closed
34638>>>>>>>        If (eViewStyle=wvsDrillDown) Begin
34640>>>>>>>            Send NavigateCancel
34641>>>>>>>        End
34641>>>>>>>>
34641>>>>>>>        Else If (eViewStyle=wvsDialog) Begin
34644>>>>>>>            Send CloseDialog
34645>>>>>>>        End
34645>>>>>>>>
34645>>>>>>>        Else Begin
34646>>>>>>>            Send Hide
34647>>>>>>>        End
34647>>>>>>>>
34647>>>>>>>    End_Procedure
34648>>>>>>>
34648>>>>>>>    Procedure Ok
34650>>>>>>>        Send ClosePromptList
34651>>>>>>>        Send Cancel
34652>>>>>>>        Send NotifyCloseModalDialog
34653>>>>>>>    End_Procedure
34654>>>>>>>    
34654>>>>>>>    // Returns server to use for reading and constraints.
34654>>>>>>>    // If pbAutoServer is set, return the matching DD from the invoking DEO's view.
34654>>>>>>>    // if not set, the server is also the reading server.
34654>>>>>>>    Function ReadingServer Returns Handle
34656>>>>>>>        Handle hoDD hoInvokingDEO hoInvokingDD
34656>>>>>>>        Integer iMain
34656>>>>>>>        Boolean bAutoServer
34656>>>>>>>
34656>>>>>>>        Get Server to hoDD
34657>>>>>>>
34657>>>>>>>        Get pbAutoServer to bAutoServer
34658>>>>>>>        If bAutoServer Begin           
34660>>>>>>>            Get GetInvokingObject to hoInvokingDEO
34661>>>>>>>            If hoInvokingDEO Begin
34663>>>>>>>                Get Main_File of hoDD to iMain
34664>>>>>>>                Get Server of hoInvokingDEO to hoInvokingDD
34665>>>>>>>                Get Which_Data_Set of hoInvokingDD iMain to hoInvokingDD
34666>>>>>>>                If hoInvokingDD Begin
34668>>>>>>>                    Move hoInvokingDD to hoDD
34669>>>>>>>                End
34669>>>>>>>>
34669>>>>>>>            End
34669>>>>>>>>
34669>>>>>>>        End
34669>>>>>>>>
34669>>>>>>>        Function_Return hoDD
34670>>>>>>>    End_Function
34671>>>>>>>
34671>>>>>>>    // this must be augmented to handle auto-server searches
34671>>>>>>>    Procedure OnSearch String sSearchText
34673>>>>>>>        Integer iCol 
34673>>>>>>>        Boolean bReverseOrdering bFound bAutoServer
34673>>>>>>>        Integer iOrdering iFile
34673>>>>>>>        Handle hoCol hoServer hoReadingServer
34673>>>>>>>        
34673>>>>>>>        Get pbAutoServer to bAutoServer
34674>>>>>>>        If not bAutoServer Begin
34676>>>>>>>            Forward Send OnSearch sSearchText
34678>>>>>>>        End
34678>>>>>>>>
34678>>>>>>>        Else Begin
34679>>>>>>>            WebGet piSortColumn to iCol
34680>>>>>>>            
34680>>>>>>>            If (iCol>=0) Begin
34682>>>>>>>                Get GetColumnObject iCol to hoCol
34683>>>>>>>                Get Server to hoServer               // the prompt lists server
34684>>>>>>>                Get ReadingServer to hoReadingServer // invoking server used for constained reads
34685>>>>>>>                If (hoServer=0) Begin
34687>>>>>>>                    Procedure_Return
34688>>>>>>>                End
34688>>>>>>>>
34688>>>>>>>                            
34688>>>>>>>                Send DDSetChangedValue of hoCol sSearchText
34689>>>>>>>                WebGet pbReverseOrdering to bReverseOrdering
34690>>>>>>>                Get IndexOrder to iOrdering
34691>>>>>>>                Get Main_File of hoServer to iFile
34692>>>>>>>                
34692>>>>>>>                // entry update based on the prompt list server (that's where the search value is)
34692>>>>>>>                Send Request_Entry_Update of hoServer iFile 1
34693>>>>>>>                
34693>>>>>>>                // read record for reading server (the invoking server)
34693>>>>>>>                Get ReadDDRecordInBuffer hoReadingServer iOrdering bReverseOrdering to bFound
34694>>>>>>>                
34694>>>>>>>                If bFound Begin
34696>>>>>>>                    // tell prompt list server about this record. This will update the list
34696>>>>>>>                    Send Request_Assign of hoServer
34697>>>>>>>                End
34697>>>>>>>>
34697>>>>>>>            End
34697>>>>>>>>
34697>>>>>>>        End
34697>>>>>>>>
34697>>>>>>>    End_Procedure
34698>>>>>>>End_Class

35390>>>>>>>    
35390>>>>>>>    
35390>>>>>>>    //  The default implementation of the OnChange will perform the find operation so if 
35390>>>>>>>    //  pbServerOnChange is enabled changing the combo will immediately update other fields from 
35390>>>>>>>    //  the parent that might be displayed.
35390>>>>>>>    Procedure OnChange String sNewValue String sOldValue
35392>>>>>>>        Integer iFile
35392>>>>>>>        RowID riNewRow
35392>>>>>>>        Handle hoDD hoServer
35392>>>>>>>        Boolean bAllowFind
35392>>>>>>>        
35392>>>>>>>        Forward Send OnChange sNewValue sOldValue
35394>>>>>>>        
35394>>>>>>>        Get Server to hoServer
35395>>>>>>>        Get Data_File to iFile
35396>>>>>>>        
35396>>>>>>>        If (hoServer > 0 and iFile > 0) Begin
35398>>>>>>>            //  Do security check
35398>>>>>>>            If (not(FillDEOAllowed(Self))) Begin
35400>>>>>>>                Procedure_Return
35401>>>>>>>            End
35401>>>>>>>>
35401>>>>>>>            
35401>>>>>>>            Get Data_Set of hoServer iFile to hoDD
35402>>>>>>>            
35402>>>>>>>            If (hoDD > 0) Begin
35404>>>>>>>                Get AllowParentFind of hoDD to bAllowFind
35405>>>>>>>                
35405>>>>>>>                If (bAllowFind) Begin
35407>>>>>>>                    Move (DeserializeRowID(sNewValue)) to riNewRow
35408>>>>>>>                    
35408>>>>>>>                    If (not(IsNullRowID(riNewRow))) Begin
35410>>>>>>>                        Send FindByRowId of hoDD (Main_File(hoDD)) riNewRow
35411>>>>>>>                    End
35411>>>>>>>>
35411>>>>>>>                    Else Begin
35412>>>>>>>                        Send Clear of hoDD  
35413>>>>>>>                    End
35413>>>>>>>>
35413>>>>>>>                End
35413>>>>>>>>
35413>>>>>>>            End
35413>>>>>>>>
35413>>>>>>>        End
35413>>>>>>>>
35413>>>>>>>    End_Procedure
35414>>>>>>>    
35414>>>>>>>    //  Override the UpdateDataBinding and instead of setting the field its changed-value it 
35414>>>>>>>    //  performs a find to select the right parent.
35414>>>>>>>    Procedure UpdateDataBinding
35416>>>>>>>        Integer iFile
35416>>>>>>>        String sRowId
35416>>>>>>>        RowID riNewRow
35416>>>>>>>        Handle hoDD hoServer
35416>>>>>>>        Boolean bAllowFind

3341>>>>>>>
3341>>>>>>>    // Returns the value from the record buffer for the field of which the
3341>>>>>>>    // fieldnumber has been passed.
3341>>>>>>>    // If the file/field requested is the focus file/field the use the DEO's
3341>>>>>>>    // value.
3341>>>>>>>    Function Field_Current_Value Integer iField Returns String
3343>>>>>>>        Integer iType
3343>>>>>>>        Integer iFile
3343>>>>>>>        String  sValue
3343>>>>>>>        Integer iFoc
3343>>>>>>>        Integer iCrnt
3343>>>>>>>        Integer iFldSize iVoid
3343>>>>>>>        UChar[] UCData
3344>>>>>>>
3344>>>>>>>        Get Focus of desktop to iFoc
3345>>>>>>>        Get Main_File to iFile
3346>>>>>>>        Get_Attribute DF_FIELD_TYPE of iFile iField to iType
3349>>>>>>>
3349>>>>>>>        // Overlap fields are not supported directly in DDs. It is expected
3349>>>>>>>        // that you will use the underlying fields instead
3349>>>>>>>        If (iType=DF_OVERLAP) Begin
3351>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_OVERLAP_ERROR
3352>>>>>>>            Function_Return ''
3353>>>>>>>        End
3353>>>>>>>>
3353>>>>>>>
3353>>>>>>>        If (iType=DF_TEXT or iType=DF_BINARY) Begin // if overlap, text or binary direct to pointer
3355>>>>>>>            Get Field_Current_UCAValue iField to UCData
3356>>>>>>>
3356>>>>>>>            // we assume a string is passed here. If we return to a string the
3356>>>>>>>            // pointer message will convert this to a string. Check that max string
3356>>>>>>>            // length is not larger than Max_Argument_Size has been removed.
3356>>>>>>>            Move (SizeOfArray(UCData)) to iFldSize
3357>>>>>>>            Move (UCharArrayToString(UCData)) to sValue
3358>>>>>>>            // This function has always returned the value as a 0 delimited string.
3358>>>>>>>            // Therefore trim at first zero. This means that you should not use this method
3358>>>>>>>            // with Binary types as embedded zeros will cause a truncation.
3358>>>>>>>            Move (CString(sValue)) to sValue
3359>>>>>>>            Function_Return sValue
3360>>>>>>>        End
3360>>>>>>>>
3360>>>>>>>
3360>>>>>>>        // This was extended to also make sure that the focus's server
3360>>>>>>>        // is this DD. This prevent the (very unlikely) case of a focus
3360>>>>>>>        // file/field being the right file/field but for a different view.
3360>>>>>>>        // 12.1: Also check operation mode, if within an operation assume that the
3360>>>>>>>        // ddos have the information they need from the deos. During a refresh we don't
3360>>>>>>>        // the data to be taken from a DEO - the DD buffer has the information you want. Note that
3360>>>>>>>        // we also changed all methods that set operation_mode to update the DD with the current
3360>>>>>>>        // DEO field, so the buffer is always correct.
3360>>>>>>>        If ( (OPERATION_MODE=MODE_WAITING) and ;            Extended_DEO_State(iFoc) and (Entry_Refresh_State(iFoc)=0) ) Begin
3362>>>>>>>            Get Current_item of iFoc to iCrnt
3363>>>>>>>            If ( Data_File(iFoc,iCrnt)=iFile and Data_Field(iFoc,iCrnt)=iField and ;                IsDEOOwned(Self,iFoc) and ;                (Checkbox_item_State(iFoc,iCrnt)=0) ) Begin
3365>>>>>>>                Get Data_Value of iFoc iCrnt to sValue
3366>>>>>>>            End
3366>>>>>>>>
3366>>>>>>>            Else Begin
3367>>>>>>>                Get Value of (Record_Buffer(Self)) iField to sValue
3368>>>>>>>            End
3368>>>>>>>>
3368>>>>>>>        End
3368>>>>>>>>
3368>>>>>>>        Else Begin
3369>>>>>>>            Get Value of (Record_Buffer(Self)) iField to sValue
3370>>>>>>>        End
3370>>>>>>>>
3370>>>>>>>
3370>>>>>>>        // cast value to the proper datatype
3370>>>>>>>        If (iType=DF_BCD) Begin
3372>>>>>>>            Function_Return (Number(sValue))
3373>>>>>>>        End
3373>>>>>>>>
3373>>>>>>>        Else If (iType=DF_DATE) Begin
3376>>>>>>>            Function_Return (Date(sValue))
3377>>>>>>>        End
3377>>>>>>>>
3377>>>>>>>        Else If (iType=DF_DATETIME) Begin
3380>>>>>>>            Function_Return (Cast(sValue,DateTime))
3381>>>>>>>        End
3381>>>>>>>>
3381>>>>>>>        // else return as string
3381>>>>>>>        Function_Return sValue
3382>>>>>>>    End_Function

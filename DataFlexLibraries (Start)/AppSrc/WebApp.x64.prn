20388>>>>>>>>>// Basic window container object. Window containers, and their subclasses, encapsulate a basic
20388>>>>>>>>>// unit of a web application, such as a Customer Entry view, etc.
20388>>>>>>>>>//
20388>>>>>>>>>// Adds support for...
20388>>>>>>>>>// - Show & Hide interface,
20388>>>>>>>>>// - Title,
20388>>>>>>>>>// - WBO registration in the global internet session object.
20388>>>>>>>>>Class cWebWindow is a cWebBaseContainer
20389>>>>>>>>>    
20389>>>>>>>>>    Procedure Construct_Object
20391>>>>>>>>>        Forward Send Construct_Object
20393>>>>>>>>>        
20393>>>>>>>>>        // Normally AllowAccess does a login check. You can override this
20393>>>>>>>>>        // by setting this false (e.g. needed for a login dialog)
20393>>>>>>>>>        Property Boolean pbLoginModeEnforced True
20394>>>>>>>>>        
20394>>>>>>>>>        Property Handle phoCommandBar 0           // Handle to child cWebCommandbar object
20395>>>>>>>>>        
20395>>>>>>>>>        // Published properties
20395>>>>>>>>>        Property Boolean pbServerOnHide False     // Set to true to trigger server OnHide event
20398>>>>>>>>>        Property Boolean pbServerOnShow False     // Set to true to trigger server OnShow event
20401>>>>>>>>>        
20401>>>>>>>>>        
20401>>>>>>>>>        Property String psClientOnHide ""         // Name of client side OnHide event handler
20404>>>>>>>>>        Property String psClientOnShow ""         // Name of client side OnShow event handler
20407>>>>>>>>>        Property String psInvokingView ""         // Name of the view object that invoked (activated) this window. Usually this is only set for popup modal windows. (see cWebModalDialog)
20410>>>>>>>>>        Property String psCaption ""              // Is the control's label (see pbShowLabel)
20413>>>>>>>>>        Property Integer pbShowCaption True  //  Allows to hide the captions
20416>>>>>>>>>        
20416>>>>>>>>>        Property Boolean pbFocusFirstOnShow True  // Determines if the view / dialog will take the focus when it is shown
20419>>>>>>>>>        
20419>>>>>>>>>        Property Integer piMaxWidth 0             // Determines the maximum width of a view / panel. Only works if piWidth is 0.
20422>>>>>>>>>        
20422>>>>>>>>>        Property Integer pbOverrideStateOnShow C_WebDefault    //  If set to true a window will become immediately in sync as soon as it is shown and the new state (DDO & Sync Props) will override the eventually existing state on the client
20423>>>>>>>>>        
20423>>>>>>>>>        Set psJSClass to "df.WebWindow"
20424>>>>>>>>>        Set peNeighborhood to nhPublic

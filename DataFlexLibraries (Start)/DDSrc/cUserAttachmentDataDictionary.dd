Use DataDict.pkg

Open UserAttachment
Open DFLastID
Open UserFeedback

Class cUserAttachmentDataDictionary is a DataDictionary
    
    Procedure Construct_Object
        Forward Send Construct_Object
        Set Main_File to UserAttachment.File_Number

        Set Add_Server_File to UserFeedback.File_Number

        Set Add_System_File to DFLastID.File_Number DD_Lock_On_All

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

        Set Field_Auto_Increment Field UserAttachment.UserAttachmentId to File_Field DFLastID.UserAttachmentId
        Set Field_Option Field UserAttachment.UserAttachmentId DD_NOPUT to True
        Set Key_Field_State Field UserAttachment.UserAttachmentId to True

    End_Procedure

End_Class
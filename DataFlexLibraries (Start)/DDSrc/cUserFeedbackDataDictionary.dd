Use DataDict.pkg

Open UserFeedback
Open DFLastID
Open UserAttachment

Class cUserFeedbackDataDictionary is a DataDictionary
    
    Procedure Construct_Object
        Forward Send Construct_Object
        Set Main_File to UserFeedback.File_Number

        Set Add_Client_File to UserAttachment.File_Number

        Set Add_System_File to DFLastID.File_Number DD_Lock_On_All

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

        Set Field_Auto_Increment Field UserFeedback.UserFeedbackId to File_Field DFLastID.UserFeedbackId
        Set Field_Option Field UserFeedback.UserFeedbackId DD_NOPUT to True
        Set Key_Field_State Field UserFeedback.UserFeedbackId to True

    End_Procedure

    Procedure Field_Defaults
        Forward Send Field_Defaults
        
        Set Field_Changed_Value Field UserFeedback.Created to (CurrentDateTime())
    End_Procedure

End_Class